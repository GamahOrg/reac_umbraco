{
  "$schema": "./appsettings-schema.json",
  "variabels": {
    "isServer": "false",
    "SendMessagesApi": "https://intggw.rega.gov.sa:232/api/API/SendMessages",
    "TokenCode": "Bearer XXXX",
    "RegaApiEndpoint": "https://api.rega.gov.sa",
    "RegaClientId": "XXXX",
    "RegaClientSecret": "XXXX",
    "RegaInternalApiEndpoint": "https://api-dev.rega.gov.sa",
    "RegaInternalClientId": "XXXX",
    "RegaInternalClientSecret": "XXXX",
    "Environment": "dev"
  },
  "InspectionActivityId": "XXXX",
  "InspectionEventTypeId": "1",
  "NewsletterStudio": {
    "Debug": {
      "LogCampaignLinks": false
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "app",
              "value": "REGA-App"
            }
          ],
          "propertiesAsLabels": [
            "app"
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "MacroErrors": "Inline"
      },
      "Runtime": {
        "Mode" : "Development"
      },
      "ModelsBuilder":{
        "ModelsMode": "SourceCodeAuto"
      },
      "Hosting": {
        "LocalTempStorageLocation": "Default",
        "Debug": false
      },
      "Global": {
        "Id": "XXXX",
        "SanitizeTinyMce": true
      }
    },
    "Forms": {
      "Options": {
        "ScheduledRecordDeletion": {
          "Enabled": false
        }
      },
      "FieldTypes": {
        "Recaptcha3": {
          "SiteKey": "XXXX",
          "PrivateKey": "XXXX"
        }
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=XXXX;Database=XXXX;User ID=XXXX;Password=XXXX;Trusted_Connection=False;Encrypt=False;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  }
}
