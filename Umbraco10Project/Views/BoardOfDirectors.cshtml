@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BoardOfDirectors>
@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = true,
        title = Model.Value("pageTitle")?.ToString() ?? ""
    };
}
<div class="board-of-directors">
    @await Html.PartialAsync("BreadCrumb", ancestors)


    <div class="container mt-5">


        <div class="row justify-content-center text-center">
            <div class="col-12">
                <h3 class="">@Model.Value("pageTitle")</h3>
            </div>
            <div class="col-12">
                @Model.Value("shortBrief")
            </div>
        </div>

        <div class="row justify-content-center">
            @foreach (IPublishedContent director in Model.Children())
            {
                var item = (Director)director;
                string personalImageUrl = item.PersonalImage != null ? item.PersonalImage.Url() : "";
                <div class="col-lg-4 col-12 text-center">
                    <div class="m-3">
                        <div class="img">
                            <img src="@personalImageUrl" alt="Board Avatar" class="img-fluid" style="max-height: 200px; border-radius: 50%;"/>
                        </div>
                        <div class="bord-details mt-3">
                            <div class="title fw-bold">
                                @item.DirectorName
                            </div>
                            <div class="">
                                @item.Position
                            </div>
                        </div>
                        <div class="content">
                            @item.ShortBrief
                        </div>
                    </div>
                </div>
            }

        </div>


    </div>


</div>