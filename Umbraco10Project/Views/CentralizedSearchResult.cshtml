@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<CentralizedSearchResult>
@using Newtonsoft.Json
@using Umbraco.Forms.Core.Services
@inject IFormService FormService
@inject IRecordStorage RecordStorage
@using Umbraco.Forms.Core.Data.Storage;
@using Umbraco.Forms.Core.Persistence.Dtos;
@using Umbraco10Project.Models
@using Form = Umbraco.Forms.Core.Models.Form
@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = false,
        title = Model.Value("pageTitle")?.ToString() ?? ""
    };
    Guid? formId = null;
    Form? form = null;
    Guid? recordId = null;
    Record? record = null;
    Dictionary<string, string> recordValues = new Dictionary<string, string>();
    var tabActive = Context.Request.Query["tabActive"];

    // Look for the submitted form Id and record Id in the TempData.
    if (TempData["UmbracoFormSubmitted"] != null)
    {
        formId = Guid.Parse(TempData["UmbracoFormSubmitted"]?.ToString() ?? "");

        FormService.Get(formId.Value);
        form = FormService.Get(formId.Value);

        if (TempData["Forms_Current_Record_id"] != null && form != null)
        {
            recordId = Guid.Parse(TempData["Forms_Current_Record_id"]?.ToString() ?? "");
            record = RecordStorage.GetRecordByUniqueId(recordId.Value, form);
            foreach (var field in record.RecordFields.Values)
            {
                recordValues.Add(field.Alias, field.ValuesAsString());
            }
        }
    }

    string GetRecordValue(string recordKey, string? queryKey = null, string defaultValue = "")
    {
        if (queryKey != null)
        {
            return recordValues.TryGetValue(recordKey, out var recordValue) ? recordValue : !string.IsNullOrWhiteSpace(Context.Request.Query[queryKey]) ? Context.Request.Query[queryKey]! : defaultValue;
        }

        return recordValues.TryGetValue(recordKey, out var value) ? value : defaultValue;
    }

    string GetQueryValue(string queryKey = null, string defaultValue = "")
    {
        return !string.IsNullOrWhiteSpace(Context.Request.Query[queryKey]) ? Context.Request.Query[queryKey]! : defaultValue;
    }
}

<div class="centralized-search-result-page">
    @await Html.PartialAsync("BreadCrumb", ancestors)

    <div class="container mt-4">

        @if (formId.HasValue || !string.IsNullOrWhiteSpace(tabActive))
        {
            if ((recordId.HasValue && record != null) || !string.IsNullOrWhiteSpace(tabActive))
            {
                if ((recordValues.ContainsKey("RERQueryPropertyVia") && recordValues["RERQueryPropertyVia"] == "SearchForRERPropertyByPropertyID")  || tabActive == "RER Title Inquiry")
                {
                    @await Component.InvokeAsync("RerTitleInquiry", new
                    {
                        queryParms = new RerTitleInquiryQueryParms()
                        {
                            ModelUrl = Model.Url(),
                            RealEstateNumber = GetRecordValue("proportyID","proportyID"),
                            FirstRegistrationDate = GetRecordValue("RerHijriDate","RerHijriDate")
                        },
                        modelTitle = "",
                        showController = false,
                        showAlert = true
                    })
                }
                else if ((recordValues.ContainsKey("RERQueryPropertyVia") && recordValues["RERQueryPropertyVia"] == "SearchForRERPropertyByID") || tabActive == "RER Title Inquiry")
                {
                    @await Component.InvokeAsync("RerTitleInquiry", new
                    {
                        queryParms = new RerTitleInquiryQueryParms()
                        {
                            ModelUrl = Model.Url(),
                            IdNumber = GetRecordValue("idNumber","idNumber"),
                            RealEstateNumber = GetRecordValue("proportyID","proportyID"),
                        },
                        modelTitle = "",
                        showController = false,
                        showAlert = true
                    })
                }
                else if ((recordValues.ContainsKey("RERQueryRegistrarVia") && recordValues["RERQueryRegistrarVia"] == "SearchForRERRegistrarByLicenseNumber") || tabActive == "Rer Registrar")
                {
                    @await Component.InvokeAsync("RerRegistrar", new
                    {
                        queryParms = new RerRegistrarQueryParms()
                        {
                            ModelUrl = Model.Url(),
                            CurrentPage = int.Parse(GetQueryValue("currentPage", "1")),
                            LicenseNumber = GetRecordValue("licenseNumber", "licenseNumber")
                        },
                        modelTitle = "المسجلين العقاريين",
                        showController = false,
                        showAlert = true
                    })
                }
                else if ((recordValues.ContainsKey("WAFIQueryAbout") && recordValues["WAFIQueryAbout"] == "SearchForWafiDeveloperList") || tabActive == "Wafi Developers")
                {
                    @await Component.InvokeAsync("WafiDevelopers", new
                    {
                        queryParms = new WafiDeveloperQueryParms()
                        {
                            ModelUrl = Model.Url(),
                            CurrentDeveloperPage = int.Parse(GetQueryValue("currentDeveloperPage", "1")),
                            FacilityName = GetRecordValue("facilityName", "facilityName"),
                            QualificationTypeId = GetRecordValue("qualificationType", "qualificationType")
                        },
                        modelTitle = Umbraco.GetDictionaryValueOrDefault("Certified Facilities","الشركات المؤهلة"),
                        showController = false,
                        showAlert = true
                    })
                }
                else if ((recordValues.ContainsKey("WAFIQueryAbout") && recordValues["WAFIQueryAbout"] == "SearchForWafiProjectList") || tabActive == "Wafi Projects")
                {
                    @await Component.InvokeAsync("WafiProjects", new
                    {
                        queryParms = new WafiProjectQueryParms()
                        {
                            ModelUrl = Model.Url(),
                            CityId = GetRecordValue("wafiCityId", "wafiCityId"),
                            LicenseRequestTypeId = GetRecordValue("licenseRequestTypeId", "licenseRequestTypeId"),
                            CurrentPage = int.Parse(GetQueryValue("currentPage", "1"))
                        },
                        modelTitle = "المشاريع المرخصة",
                        linkedToPageUrl = Model.WafiProjectResultPage?.Url(),
                        showController = false,
                        showAlert = true
                    })
                }
                else if ((recordValues.ContainsKey("FALQueryAbout") && recordValues["FALQueryAbout"] == "SearchForFalBrokerLicenses") || tabActive == "Fal Broker")
                {
                    var brokerType = "Individual";
                    var idNumber = GetRecordValue("idNumber","idNumber");

                    if ((recordValues.ContainsKey("FALQueryBrokerVia") && recordValues["FALQueryBrokerVia"] == "SearchForFalBrokerLicensesByEstablishment"))
                    {
                        brokerType = "Establishment";
                        idNumber = GetRecordValue("establishmentNumber","establishmentNumber");
                    }
                    @await Component.InvokeAsync("FalBroker", new
                    {
                        queryParms = new FalBrokerQueryParms()
                        {
                            ModelUrl = Model.Url(),
                            IdNumber = idNumber,
                            BrokerType = brokerType,
                        },
                        modelTitle = "رخص فال",
                        showController = false,
                        showAlert = true
                    })
                }
                else if ((recordValues.ContainsKey("EJARQueryAbout") && recordValues["EJARQueryAbout"] == "SearchForEjarContract") || tabActive == "Ejar Contract")
                {
                    @await Component.InvokeAsync("EjarInquiry", new
                    {
                        queryParms = new EjarQueryParms()
                        {
                            ModelUrl = Model.Url(),
                            IdNumber = GetRecordValue("idNumber","idNumber"),
                            BirthDateHijri = GetRecordValue("dateOfBirthHijri","dateOfBirthHijri").Replace("\\/","-")
                        },
                        modelTitle = "",
                        linkedToPageUrl = Model.EjarDetailsReusltPage?.Url(),
                        showController = false,
                        showAlert = true
                    })
                }

                else
                {
                    <div class="alert alert-warning mt-4 text-center" role="alert">
                        <h4 class="alert-heading">@Umbraco.GetDictionaryValueOrDefault("Not Exist","غير موجود")</h4>
                        <p>
                            @Umbraco.GetDictionaryValueOrDefault("inquiry not exist","الاستعلام الذي تبحث عنه غير موجود")

                        </p>
                    </div>
                }
            }
        }
        else
        {
            <div class="alert alert-warning mt-4 text-center" role="alert">
                <h4 class="alert-heading">@Umbraco.GetDictionaryValueOrDefault("Not Exist","غير موجود")</h4>
                <p>
                    @Umbraco.GetDictionaryValueOrDefault("inquiry not exist","الاستعلام الذي تبحث عنه غير موجود")

                </p>
            </div>
        }
    </div>
</div>