@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Umbraco10Project.Models
@using uSync.Core
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Complaint>
<link
    href="https://api.mapbox.com/mapbox-gl-js/v1.10.1/mapbox-gl.css"
    rel="stylesheet"/>
@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    bool ar = Umbraco.CultureDictionary.Culture.ToString() == "ar-JO";

    if (ancestorsList.Count > 1)
    {
        ancestorsList.RemoveAt(1); // Remove the first parent
    }

    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = true,
        title = Model.Value("pageTitle")?.ToString() ?? "",
        ActionPushToEnd = true,
        action =
        [
            new AncestorsActionModel
            {
                Text = Umbraco.GetDictionaryValueOrDefault("Back to homepage", "العودة للقائمة الرئيسية"),
                PushToEnd = true,
                Outline = true,
                Url = ar ? "/media-center/complaints/" : "/en/media-center/complaints/"
            },

            new AncestorsActionModel
            {
                Text = Umbraco.GetDictionaryValueOrDefault("Logout", "تسجيل الخروج"),
                PushToEnd = true,
                Url = "/umbraco/surface/services/LogOut"
            }

        ]
    };
}


<div class="complaint-page">
    @await Html.PartialAsync("BreadCrumb", ancestors)
    <div class="container mt-4 p-2">

        <div class="">
            @switch (Model.PageType)
            {
                case "ELM_CRM":
                    @await Component.InvokeAsync("InspectionCreate")
                    break;
                case "UMBRACO_FORMS":
                    @await Component.InvokeAsync("ComplaintForm", new FormModel()
                    {
                        ModelId = Model?.Id.ToString() ?? "",
                        FormID = (Guid)(Model?.Value("formRef") ?? ""),
                        Title = Model?.Value("formTitle")?.ToString() ?? "",
                        Description = Model?.Value("formDescription")?.ToString() ?? "",
                        ProtectedByNafath = (bool)(Model?.Value("protectedByNafath") ?? false),
                    })
                    break;
                default:
                    @await Component.InvokeAsync("Form", new FormModel()
                    {
                        ModelId = Model?.Id.ToString() ?? "",
                        FormID = (Guid)(Model?.Value("formRef") ?? ""),
                        Title = Model?.Value("formTitle")?.ToString() ?? "",
                        Description = Model?.Value("formDescription")?.ToString() ?? "",
                        ProtectedByNafath = (bool)(Model?.Value("protectedByNafath") ?? false),
                    })
                    break;
            }
        </div>
    </div>
</div>