@using uSync.Core
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    string fromMethod = "";
    string id = "";

    if (TempData["fromMethod"] != null)
    {
        fromMethod = @TempData["fromMethod"].ToString();

    }
    if (TempData["id"] != null)
    {
        id = @TempData["id"].ToString();

    }
}
<div class="apply-for-job-page rega-page">


	<div class="site-wrapper inside-wrapper">
        <div class="bread-crumbs">
            <span class="bread-crumbs-item font-bold"> @Model?.Parent?.Name ></span>
            <a class="bread-crumbs-item font-bold" href=""> @Model.Value("pageTitle")</a>
        </div>

        <div class="section-container display-flexbox padding-top-15">
            <div class="section-top-side margin-0 flex-start">
                <div class="section-title font-bold text-start">
                    @Model.Value("pageTitle")
                </div>
            </div>
            <div class="section-bottom-side with-gap display-flexbox">
                <div class="apply-for-job-section">
                    
                    <div class="apply-for-job-form">
                        @if (!fromMethod.IsNullOrWhiteSpace())
                        {
                            if (fromMethod.ToString() == "Questionnaire")
                            {
                                <form id="passwordForm" asp-controller="Csv" asp-action="CsvQuestionnaire">
                                    <div class="form-section-1">
                                        <div class="form-section-title">

                                            @Umbraco.GetDictionaryValue("password")

                                        </div>

                                        <div class="job-fields">
                                            <input class="job-field-input display-none" type="text" name="id" value="@id" required />

                                            <div class="job-field display-flexbox">
                                                <div class="job-field-title">
                                                    <label>@Umbraco.GetDictionaryValue("password") <span class="requierd-star">*</span></label>
                                                </div>
                                                <div class="job-field-value">
                                                    <input class="job-field-input" type="password" name="password" required />
                                                </div>
                                            </div>

                                            <div class="job-field display-flexbox apply-job-submit">
                                                <a class="site-btn">
                                                    <div class="hover-btn-shape1"></div>
                                                    <div class="hover-btn-shape2"></div>
                                                    <input class="site-btn-input" type="submit" value="@Umbraco.GetDictionaryValue("Submit")" />
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                </form>

                            }
                            else if (fromMethod.ToString() == "Job")
                            {
                                <form asp-controller="Csv" asp-action="CsvJob">
                                    <div class="form-section-1">
                                        <div class="form-section-title">

                                            @Umbraco.GetDictionaryValue("password")

                                        </div>

                                        <div class="job-fields">

                                            <div class="job-field display-flexbox">
                                                <div class="job-field-title">
                                                    <label>@Umbraco.GetDictionaryValue("password") <span class="requierd-star">*</span></label>
                                                </div>
                                                <div class="job-field-value">
                                                    <input class="job-field-input" type="password" name="password" required />
                                                </div>
                                            </div>

                                            <div class="job-field display-flexbox apply-job-submit">
                                                <a class="site-btn">
                                                    <div class="hover-btn-shape1"></div>
                                                    <div class="hover-btn-shape2"></div>
                                                    <input class="site-btn-input" type="submit" value="@Umbraco.GetDictionaryValue("Submit")" />
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                </form>
                            }

                        }

                        
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>