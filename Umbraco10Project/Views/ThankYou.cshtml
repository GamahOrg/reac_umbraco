
@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ThankYou>
@{
    Layout = "Master.cshtml";

    var ancestors = new AncestorsModel()
    {
        ancestors = Model.Ancestors().Reverse().ToList(),
        content = Model,
        title = Model?.Value("pageTitle")?.ToString() ?? ""
    };
}

<div class="thank-you-page">

    @await Html.PartialAsync("BreadCrumb", ancestors)

    <div class="container mt-4 justify-content-center align-content-center">

        <div class="card mt-5">
            <div class="card-body">


                <div class="row text-center">

                    <p class="title text-primary">
                        <img src="~/images/icons/tick-double-04-duotone-rounded.svg" alt="Ok icon"/>

                        @Model?.Value("pageTitle")

                    </p>
                    <div class="col-12 ">
                        <p >
                            @Model?.Value("shortBrief")
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>


</div>