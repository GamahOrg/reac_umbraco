@using Umbraco10Project.Controllers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

<div class="container-fluid p-5">

    <div class="container">

        <div class="card p-5">
            <div class="card-body">
                <div class="row text-center justify-content-center">
                    <div class="col-lg-12 col-md-12 col-12 text-center">
                        <img src="~/images/icons/mail-at-sign.svg" alt="News letter icon" style="width: 40px; height: auto" width="40" height="40"/>
                        <span class="title text-primary ms-2 me-2">@(Model.Value<string>("newsLetterTitle"))</span>
                    </div>
                    <div class="col-lg-12  text-center">

                        <p>
                            @(Model.Value<string>("newsLetterBreif"))
                        </p>


                    </div>

                    <div class="col-lg-6 text-center">
                        @using (Html.BeginUmbracoForm<SubscribeController>(nameof(SubscribeController.Subscribe), FormMethod.Post))
                        {
                            <div class="input-group">
                                <input type="text" class="form-control" required name="Email" id="email" placeholder="@Umbraco.GetDictionaryValue("Email")">

                                <button class="btn btn-primary"
                                        aria-label="Subscribe to mail list"
                                        type="submit">
                                    @Umbraco.GetDictionaryValue("Confirm", "Confirm")
                                    <img src="~/images/icons/sent-duotone-rounded.svg" alt="Start service" class="icon-local-flip small-icon"/>
                                </button>
                            </div>
                        }

                    </div>

                </div>
            </div>
        </div>

    </div>
</div>