@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco10Project.Helpers;
@{
    bool ar = Umbraco.CultureDictionary.Culture.ToString() == "ar-JO";
    var newsSection = Umbraco.Content(1273);
}
<div class="container-fluid p-lg-5">
    <div class="container pt-4">
        <div class="row ">
            <div class="col">
                <h2 class="h4">@newsSection.Value("pageTitle")</h2>
            </div>
            <div class="col justify-content-end text-end">
                <button class="btn btn-primary text-end onclick" data-action="redirect" data-value="@newsSection.Url()">
                    @Umbraco.GetDictionaryValue("View More")
                </button>
            </div>
        </div>
        <div class="row mt-5">
            <!-- Slider main container -->
            @{
                var newsDetailsItems = newsSection.Children().OrderByDescending(item => item.Value("newsDate")).Take(9);
            }
            <div class="owl-one owl-carousel owl-theme">
                @foreach (var newsItem in newsDetailsItems)
                {
                    var news = (NewsDetails)newsItem;

                    <div class="card" style="min-height: 250px;">
                        <div class="card-body">

                            <a class="title text-decoration-none" href="@news?.Url()">@news.NewsTitle</a>
                            <div class="content">
                                @(Html.Raw(Utils.TruncateAtWord(Utils.StripHTML(news.NewsText?.ToString()?.Replace("&quot;", "\"").Replace("&nbsp;", "") ?? ""), 200)))
                            </div>

                        </div>
                        <div class="card-footer">
                            <button class="btn btn-outline-primary onclick" data-action="redirect"
                                    data-value="@news.Url()">@Umbraco.GetDictionaryValue("Read More News")</button>
                        </div>
                    </div>
                }
            </div>
        </div>


    </div>
</div>

<script csp-manager-add-nonce="true">
    $(document).ready(function () {
        var isArabic = "@ar" === "True";
        $('.owl-one').owlCarousel({
            loop: true,
            margin: 10,
            lazyLoad: true,
            autoHeight: true,
            rtl: isArabic,
            autoplay: false,
            autoplayTimeout: 5000,
            autoplayHoverPause: true,
            nav: false,
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 3
                },
                1000: {
                    items: 3
                }
            }
        })
    });
</script>