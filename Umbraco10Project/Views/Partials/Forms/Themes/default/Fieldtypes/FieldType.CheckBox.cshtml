@using Umbraco.Cms.Web.Common
@using uSync.Core
@model Umbraco.Forms.Web.Models.FieldViewModel

@inject UmbracoHelper umbracoHelper

@{
    var caption = string.Empty;
    Model.AdditionalSettings.TryGetValue("Caption", out caption);
}

<input type="checkbox" name="@Model.Name" id="@Model.Id" value="true"  data-umb="@Model.Id"
       @if(Model.Mandatory) { <text>  data-val="true" data-val-requiredcb="@Model.RequiredErrorMessage" aria-required="true"</text> }
       @if (Model.ContainsValue(true) || Model.ContainsValue("true") || Model.ContainsValue("on")) { <text>checked="checked"</text> }
       @if (!Model.ToolTip.IsNullOrWhiteSpace()) { <text> aria-describedby="@(Model.Id)_description" </text> }                                                                                                                                                                 
/>
<input type="hidden" name="@Model.Name" value="false" />
@if (!caption.IsNullOrWhiteSpace())
{
    <label for="@Model.Id">@umbracoHelper.GetDictionaryValueOrDefault(caption, caption)</label>
}
