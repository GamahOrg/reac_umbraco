@model Umbraco.Forms.Web.Models.FieldViewModel

@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Umbraco.Cms.Web.Common
@using Umbraco.Forms.Web
@using uSync.Core

@inject UmbracoHelper umbracoHelper

@{
    var settings = Model.AdditionalSettings;
    var autocompleteAttribute = Model.GetSettingValue<string>("AutocompleteAttribute", string.Empty);
    var allowMultiple = settings.ContainsKey("AllowMultipleSelections") && settings["AllowMultipleSelections"].ToLower() == "true";
    var selectPrompt = Model.GetSettingValue<string>("SelectPrompt", string.Empty);
}
<div class="row">
    @foreach (var pv in Model.PreValues)
    {
        <div class="col-auto mt-4">
            <div
                class="card with-hover umbraco-img-drop-down-div @(Model.ContainsValue(pv.Value) ? "selected" : string.Empty)" data-value="@pv.Value">
                <div class="card-body text-center align-self-center align-items-center align-content-center">
                    <img class="img-fluid " height="80" width="180" src="@pv.Caption" alt="Service Logo">
                </div>
            </div>
        </div>
    }
</div>

<select class="@Html.GetFormFieldClass(Model.FieldTypeName) form-select umbraco-img-drop-down-select"
        name="@Model.Name"
        id="@Model.Id"
        data-umb="@Model.Id"
        hidden
        style=""
        @if ((autocompleteAttribute.IsNullOrWhiteSpace()) == false)
        {
            <text>autocomplete="@autocompleteAttribute"</text>
        }
        @if (allowMultiple)
        {
            <text> multiple </text>
        }
        @if (Model.Mandatory)
        {
            <text> data-val="true" data-val-required="@Model.RequiredErrorMessage" aria-required="true" </text>
        }
        @if (!(Model.ToolTip.IsNullOrWhiteSpace()))
        {
            <text> aria-describedby="@(Model.Id)_description" </text>
        }>
    @if (!allowMultiple)
    {
        <option value="">@selectPrompt</option>
    }
    @foreach (var pv in Model.PreValues)
    {
        @: <option value="@pv.Value" @(Model.ContainsValue(pv.Value) ? "selected" : string.Empty)>@pv.Value</option>
    }
</select>

<script csp-manager-add-nonce="true">
    var selectId = '@Model.Id';
    $(document).ready(function () {
        document.querySelectorAll('.umbraco-img-drop-down-div').forEach(function(div) {
            div.addEventListener("click", function() {
              // Get the value from the data attribute
              var valueToSet = div.getAttribute("data-value");

              // Get the select element
              var selectElement = document.getElementById(selectId);

              // Set the select element's value to the clicked div's data-value
              selectElement.value = valueToSet;

              // Optional: trigger a change event if needed
              selectElement.dispatchEvent(new Event('change'));


                document.querySelectorAll('.umbraco-img-drop-down-div').forEach(function(div) {
                    div.classList.remove('selected');
                });
                div.classList.add('selected');
          });
        });
    });

</script>