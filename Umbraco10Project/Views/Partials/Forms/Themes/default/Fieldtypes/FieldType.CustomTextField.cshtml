@using Umbraco.Forms.Web
@using uSync.Core
@model Umbraco.Forms.Web.Models.FieldViewModel
@{
    var maxLength = Model.GetSettingValue<int>("MaximumLength", 255);
    var fieldType = Model.GetSettingValue<string>("FieldType", "text");
    var disable = Model.GetSettingValue<bool>("Disable", false);
    var customCssClass = Model.GetSettingValue<string>("CustomCssClass", "");
    var autocompleteAttribute = Model.GetSettingValue<string>("AutocompleteAttribute", string.Empty);
}


<input style="min-width:100%" type="@fieldType" name="@Model.Name" id="@Model.Id" data-umb="@Model.Id" class="text form-control flex-fill @customCssClass @Html.GetFormFieldClass(Model.FieldTypeName)" maxlength="@maxLength"
       @{
           if (disable)
           {
               <text> disabled </text>
           }
       }
       @{
           if ((Model.PlaceholderText).IsNullOrWhiteSpace() == false)
           {
               <text> placeholder="@Model.PlaceholderText" </text>
           }
       }
       @{
           if ((autocompleteAttribute).IsNullOrWhiteSpace() == false)
           {
               <text> autocomplete="@autocompleteAttribute" </text>
           }
       }
       @{
           if (Model.Mandatory || Model.Validate)
           {
               <text> data-val="true" </text>
           }
       }
       @{
           if (Model.Mandatory)
           {
               <text> data-val-required="@Model.RequiredErrorMessage" aria-required="true" </text>
           }
       }
       @{
           if (Model.Validate)
           {
               <text> data-val-regex="@Model.InvalidErrorMessage" data-val-regex-pattern="@Html.Raw(Model.Regex)" </text>
           }
       }
       @{
           if (!(Model.ToolTip).IsNullOrWhiteSpace())
           {
               <text> aria-describedby="@(Model.Id)_description" </text>
           }
       }/>