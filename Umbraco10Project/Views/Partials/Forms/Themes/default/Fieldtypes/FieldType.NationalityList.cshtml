<select class="@Html.GetFormFieldClass(Model.FieldTypeName) form-select"
        name="@Model.Name"
        id="@Model.Id"
        data-umb="@Model.Id"
        style="min-width:50%"
        @if ((autocompleteAttribute.IsNullOrWhiteSpace()) == false) { <text>autocomplete="@autocompleteAttribute"</text> }
        @if (Model.Mandatory) { <text> data-val="true" data-val-required="@Model.RequiredErrorMessage" aria-required="true" </text> }
        @if (!(Model.ToolTip.IsNullOrWhiteSpace())) { <text> aria-describedby="@(Model.Id)_description" </text> }>
    @foreach (var pv in x)
    {
        @: <option value="@pv.Value" @(Model.ContainsValue(pv.Value) ? "selected" : string.Empty)>@pv.Text</option>
    }
</select>
