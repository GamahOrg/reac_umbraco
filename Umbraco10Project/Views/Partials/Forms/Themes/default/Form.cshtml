@using Umbraco.Cms.Web.Common
@using Umbraco.Forms.Core.Enums
@using Umbraco.Forms.Web
@using Umbraco.Forms.Web.Models
@using Umbraco.Forms.Web.Services
@using uSync.Core

@model Umbraco.Forms.Web.Models.FormViewModel

@inject IFormThemeResolver FormThemeResolver
@inject UmbracoHelper umbracoHelper


@{
    // here we load in the needed default assets for the form
    // this means that 3rd party themes can override these by implementing their own form.cshtml file
    //it will simply hook into standard way forms load assets
    if (Model.DisableDefaultStylesheet == false)
    {
        Html.SetFormThemeCssFile("~/App_Plugins/UmbracoForms/Assets/themes/default/style.min.css");
    }
}

<div class="umbraco-forms-page" id="@Model.CurrentPage.Id">

    @if ((Model.CurrentPage.Caption).IsNullOrWhiteSpace() == false)
    {
        <h4 class="umbraco-forms-caption">@umbracoHelper.GetDictionaryValueOrDefault(Model.CurrentPage.Caption, Model.CurrentPage.Caption)</h4>
    }

    @if (Model.ShowValidationSummary)
    {
        @Html.ValidationSummary(false)
    }


    @foreach (FieldsetViewModel fs in Model.CurrentPage.Fieldsets)
    {
        bool hideFieldSetWhenRendering = fs.HasCondition && fs.ConditionActionType == FieldConditionActionType.Show;

        <fieldset class="umbraco-forms-fieldset@{if (hideFieldSetWhenRendering) { <text> umbraco-forms-hidden</text> }}" id="@fs.Id">

            @if ((fs.Caption).IsNullOrWhiteSpace() == false)
            {
                <legend class="">@umbracoHelper.GetDictionaryValueOrDefault(fs.Caption, fs.Caption)</legend>
            }

            <div class="row">

                @foreach (var c in fs.Containers)
                {
                    
                    <div class="umbraco-forms-container col-lg-6 col-12 ">
                        @*  @("col-md-" + c.Width) *@

                        @foreach (FieldViewModel f in c.Fields)
                        {
                            bool hideFieldWhenRendering = f.HasCondition && f.ConditionActionType == FieldConditionActionType.Show;

                            switch (f.FieldType?.RenderInputType ?? RenderInputType.Single)
                            {
                                case RenderInputType.Single:
                                    <div class="@Html.GetFormFieldWrapperClass(f.FieldTypeName) @f.CssClass @{if (hideFieldWhenRendering) { <text> umbraco-forms-hidden </text> }}">

                                        @if (!f.HideLabel)
                                        {
                                            <label for="@f.Id" class="form-label">
                                                @{
                                                    RenderCaption(f);
                                                }
                                            </label>
                                        }

                                        @{
                                            await RenderField(f);
                                        }

                                    </div>
                                    break;

                                case RenderInputType.Multiple:
                                    <div class="mt-2 mb-2 @Html.GetFormFieldWrapperClass(f.FieldTypeName) @f.CssClass @{if (hideFieldWhenRendering) { <text> umbraco-forms-hidden</text> }}">

                                        @if (!f.HideLabel)
                                        {
                                            <label class="form-label">
                                                @{
                                                    RenderCaption(f);
                                                }
                                            </label>
                                        }

                                        @{
                                            await RenderField(f);
                                        }

                                    </div>
                                    break;

                                case RenderInputType.Custom:
                                    @await Html.PartialAsync(FormThemeResolver.GetFieldView(Model, f), f)
                                    break;
                            }
                        }

                    </div>
                }
            </div>

        </fieldset>
    }

    <div class="umbraco-forms-hidden" aria-hidden="true">
        <input type="text" name="@Model.FormId.ToString().Replace("-", "")"/>
    </div>

    <div class="umbraco-forms-navigation row-fluid">

        <div class="row justify-content-start ms-2">
            @if (Model.IsMultiPage)
            {
                if (!Model.IsFirstPage)
                {
                    <div class="col-lg-2 col-6 text-end">
                        <button style="width: 100%" type="submit" class="btn btn-primary" data-umb="prev-forms-form" data-form-navigate="prev" name="__prev" value="@(umbracoHelper.GetDictionaryValueOrDefault(Model.PreviousCaption, Model.PreviousCaption))">
                            @(umbracoHelper.GetDictionaryValueOrDefault(Model.PreviousCaption, Model.PreviousCaption))
                        </button>
                    </div>
                }

                if (!Model.IsLastPage)
                {
                    <div class="col-lg-2 col-6 text-start">
                        <button style="width: 100%" type="submit" class="btn btn-primary" data-umb="next-forms-form" data-form-navigate="next" name="__next" value="@(umbracoHelper.GetDictionaryValueOrDefault(Model.NextCaption, Model.NextCaption))">
                            @(umbracoHelper.GetDictionaryValueOrDefault(Model.NextCaption, Model.NextCaption))
                        </button>
                    </div>
                }

                if (Model.IsLastPage)
                {
                    <div class="col-lg-2 col-12 text-start">
                        <button style="width: 100%" type="submit" class="btn btn-primary" data-umb="submit-forms-form" data-form-navigate="next" name="__next" value="@(umbracoHelper.GetDictionaryValueOrDefault(Model.SubmitCaption, Model.SubmitCaption))">
                            @(umbracoHelper.GetDictionaryValueOrDefault(Model.SubmitCaption, Model.SubmitCaption))
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="col-lg-2 col-12 text-start">
                    <button style="width: 100%" type="submit" class="btn btn-primary" data-umb="submit-forms-form" data-form-navigate="next" name="__next" value="@(umbracoHelper.GetDictionaryValueOrDefault(Model.SubmitCaption, Model.SubmitCaption))">
                        @(umbracoHelper.GetDictionaryValueOrDefault(Model.SubmitCaption, Model.SubmitCaption))
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("Forms/Themes/default/ScrollToFormScript")

@functions
{
    void RenderCaption(FieldViewModel field)
    {
        <text>@umbracoHelper.GetDictionaryValueOrDefault(field.Caption, field.Caption)</text>

        if (field.Mandatory)
        {
            <span style="color:red" class="umbraco-forms-indicator">@Model.Indicator</span>
        }
    }

    async Task RenderField(FieldViewModel field)
    {
        if (!(field.ToolTip).IsNullOrWhiteSpace())
        {
            <div>
            <span id="@(field.Id)_description" class="umbraco-forms-tooltip help-block small text-black-50">@field.ToolTip</span>
            </div>
        }

        <div class="umbraco-forms-field-wrapper">

            @await Html.PartialAsync(FormThemeResolver.GetFieldView(Model, field), field)

            @if (Model.ShowFieldValidaton)
            {
                @Html.ValidationMessage(field.Name, new { role = "alert" })
            }

        </div>
    }
}

<script csp-manager-add-nonce="true">
    //complaint form page get the city
    $(document).ready(function () {
        const url = new URL(window.location.href);
        const host = url.origin;

        $.getJSON(host + '/JsonFile/cities.json', function (jsonData) {
            populateCities($("#regionSelect").val());

            $("#regionSelect").change(function () {
                var selectedRegion = $(this).val();

                populateCities(selectedRegion);
            });

            function populateCities(region) {
                var filteredData = jsonData.filter(function (item) {
                    return item.region_en === region;
                });

                $("#citySelect").empty();
                filteredData.forEach(function (item) {
                    var cityOption = $("<option>").val(item.city_ar).text(item.city_ar);
                    $("#citySelect").append(cityOption);
                });
            }


            populateUmbracoFormsCities($(".umbraco-forms-region-dropdown").val());

            $(".umbraco-forms-region-dropdown").change(function () {
                var selectedRegion = $(this).val();

                populateUmbracoFormsCities(selectedRegion);
            });

            function populateUmbracoFormsCities(region) {
                var filteredData = jsonData.filter(function (item) {
                    return item.region_en === region;
                });

                $(".umbraco-forms-city-dropdown").empty();
                filteredData.forEach(function (item) {
                    var cityOption = $("<option>").val(item.city_ar).text(item.city_ar);
                    $(".umbraco-forms-city-dropdown").append(cityOption);
                });
            }
        });
    });
</script>