@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco10Project.Models.WafiProjectDetailsModel>

@using Umbraco10Project.Models
@using Umbraco10Project.Helpers
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "Master.cshtml";
    bool ar = Umbraco.CultureDictionary.Culture.ToString() == "ar-JO";

    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = true,
        title = Model?.response?.Data.ProjectName ?? ""
    };
}
<div class="wafi-project-details-page">
    @await Html.PartialAsync("BreadCrumb", ancestors)


    <div class="container mt-4">

        <div class="card">
            <div class="card-body">
                <div class="row">
                    <h5 class="text-primary title">@Model?.response?.Data?.ProjectName</h5>
                    <p class="">@Model?.response?.Data?.ProjectDescription</p>

                    <hr/>
                    <h5 class="text-primary title">@Model?.response?.Data?.FacilityName</h5>
                    <p class="">
                        <img src="~/images/icons/license-third-party.svg" alt="License Request Type icon"
                             class="small-icon ms-1 me-1" width="20" height="20">
                        <span
                            class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("License Type", "نوع الترخيص"): </span>@Model?.response?.Data?.LicenseRequestTypeName
                    </p>
                    <p class="">
                        <img src="~/images/icons/policy.svg" alt="License Request Type icon"
                             class="small-icon ms-1 me-1" width="20" height="20">
                        <span
                            class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("License number", "رقم الرخصة"): </span>@Model?.response?.Data?.CertificateNumber
                    </p>
                    <p class="">
                        <img src="~/images/icons/calender.svg" alt="License Request Type icon"
                             class="small-icon ms-1 me-1" width="20" height="20">
                        <span
                            class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("License Start Date", "تاريخ سريان الرخصة"): </span>@Calendar.TheSmallDate(Model?.response?.Data?.LicenseStartDate, !ar)
                    </p>
                    <p class="">
                        <img src="~/images/icons/calender.svg" alt="License Request Type icon"
                             class="small-icon ms-1 me-1" width="20" height="20">
                        <span
                            class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("License End Date", "ناريخ نهاية الرخصة"): </span>@Calendar.TheSmallDate(Model?.response?.Data?.LicenseEndDate, !ar)
                    </p>
                    @{
                        if (Model?.response?.Data?.BankName != null)
                        {
                            <p class="">
                                <img src="~/images/icons/bank.svg" alt="License Request Type icon"
                                     class="small-icon ms-1 me-1" width="20" height="20">
                                <span
                                    class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Bank Name", "اسم البنك"): </span>@Model.response?.Data?.BankName
                            </p>
                        }
                    }
                    @{
                        if (Model?.response?.Data?.AccountNumber != null)
                        {
                            <p class="">
                                <img src="~/images/icons/iban.svg" alt="License Request Type icon"
                                     class="small-icon ms-1 me-1" width="20" height="20">
                                <span
                                    class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Account Number", "رقم الحساب"): </span><span>@Model.response?.Data?.AccountNumber</span>
                            </p>
                        }
                    }
                    @{
                        if (Model?.response?.Data?.ChartedAccountantName != null)
                        {
                            <p class="">
                                <img src="~/images/icons/money.svg" alt="License Request Type icon"
                                     class="small-icon ms-1 me-1" width="20" height="20">
                                <span
                                    class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Accountant Name", "المحاسب القانوني"): </span><span>@Model.response?.Data?.ChartedAccountantName</span>
                            </p>
                        }
                    }
                    @{
                        if (Model?.response?.Data?.ChartedProjectConsultantName != null)
                        {
                            <p class="">
                                <img src="~/images/icons/mentoring.svg" alt="License Request Type icon"
                                     class="small-icon ms-1 me-1" width="20" height="20">
                                <span
                                    class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Consultant Name", "المستشار الهندسي"): </span><span>@Model.response?.Data?.ChartedProjectConsultantName</span>
                            </p>
                        }
                    }
                    <hr/>
                    <h5 class="text-primary title">@Umbraco.GetDictionaryValueOrDefault("Extra Information", "معلومات إضافية")</h5>
                    <p class=""><img src="~/images/icons/location.svg" alt="License Request Type icon"
                                     class="small-icon ms-1 me-1" width="20" height="20"><span
                            class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Location", "الموقع"): </span>@Model?.response?.Data?.AreaName - @Model?.response?.Data?.CityName - @Model?.response?.Data?.NeighborhoodName
                    </p>
                    <p class="">
                        <img src="~/images/icons/timer.svg" class="small-icon ms-1 me-1" alt="Project status icon"
                             width="20" height="20">
                        <span
                            class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Project Status", "حالة المشروع"): </span>@Model?.response?.Data?.LicenseProjectStatusName
                    </p>
                    @if (Model?.response?.Data?.ProjectStartDate != null)
                    {
                        <p class="">
                            <img src="~/images/icons/calender.svg" alt="License Project Type icon"
                                 class="small-icon ms-1 me-1" width="20" height="20">
                            <span
                                class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Project Start Date", "تاريخ بداية المشروع"): </span>@Calendar.TheSmallDate(Model?.response?.Data?.ProjectStartDate, !ar)
                        </p>
                    }
                    @if (Model?.response?.Data?.ProjectEndDate != null)
                    {
                        <p class="">
                            <img src="~/images/icons/calender.svg" alt="License Project Type icon"
                                 class="small-icon ms-1 me-1" width="20" height="20">
                            <span
                                class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Project End Date", "تاريخ نهاية المشروع"): </span>@Calendar.TheSmallDate(Model?.response?.Data?.ProjectEndDate, !ar)
                        </p>
                    }

                    <p class=""><img src="~/images/icons/cells.svg" alt="cells icon" class="small-icon ms-1 me-1"
                                     width="20" height="20">

                        <span class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Unit Types", "نوع الوحدات"): </span>
                        @{
                            if (Model?.response?.Data?.LicenseProjectSubUnitType != null)
                            {
                                foreach (var item in Model?.response?.Data?.LicenseProjectSubUnitType)
                                {
                                    <span class="bg-green-50 text-green-900 p-tag p-component">
                                            @item<span class="p-tag-value"></span>
                                        </span>
                                }
                            }
                        }

                        @if (Model?.response?.Data?.TotalAreaSizeForProject != null)
                        {
                        <p class="">
                            <img src="~/images/icons/bounding-box.svg" alt="License Project Type icon"
                                 class="small-icon ms-1 me-1" width="20" height="20">
                            <span
                                class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Land Total Space", "المساحة الإجمالية"): </span>@Model?.response?.Data?.TotalAreaSizeForProject
                            <span>م2</span>
                        </p>
                    }

                    @if (Model?.response?.Data?.AchievementRate != null && Model?.response?.Data?.LicenseRequestTypeName?.Contains("استلام مبالغ") == false)
                    {
                        <p class="">
                            <img src="~/images/icons/percent.svg" alt="License Project Type icon"
                                 class="small-icon ms-1 me-1" width="20" height="20">
                            <span
                                class="fw-bold">@Umbraco.GetDictionaryValueOrDefault("Achievement Rate", "نسبة الإنجاز"): </span>@Model?.response?.Data?.AchievementRate
                            <span>%</span>
                        </p>
                    }

                </div>
            </div>
        </div>


    </div>

</div>