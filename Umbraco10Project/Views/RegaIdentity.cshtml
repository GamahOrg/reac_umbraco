@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<MediaFile>

@using Umbraco.Cms.Core.Models;
@using Umbraco10Project.Models

@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = true,
        title = Model.Value("pageTitle")?.ToString() ?? ""
    };
}
<div class="rega-identity">
    @await Html.PartialAsync("BreadCrumb", ancestors)

    <div class="container mt-3">

        <div class="card p-2">

            <div class="card-body">
                <div class="content">@Model.ShortBrief</div>

                <div class="row justify-content-center text-center align-content-center show-files">

                        <div style="cursor: pointer">
                            <input class="form-check-input " type="checkbox" value="" id="agree">
                            <label class="form-check-label text-primary-dark" for="agree">
                                @Umbraco.GetDictionaryValue("Agree on identity policy")
                            </label>
                        </div>

                        <div class="mt-2"  id="files-section">

                                @{
                                    var imageitems = Model.Value<IEnumerable<IPublishedElement>>("images");

                                    if (imageitems != null)
                                    {
                                        Link itemImage;
                                        foreach (var item in imageitems)
                                        {
                                            Console.Out.WriteLine("item: " + item);
                                            itemImage = item.Value<Link>("Url");
                                            string itemImageUrl = itemImage != null ? itemImage.Url : "";
                                            // if image ends with .pdf
                                            <button class="btn btn-primary onclick"
                                                    id="download-btn"
                                                    disabled
                                                    style="cursor: pointer"
                                                    data-action="redirect-new-tab" data-value="@itemImageUrl">
                                                @Umbraco.GetDictionaryValue("Download Files")<img src="~/images/icons/download.svg" alt="Download Icon" class="small-icon me-2 ms-2"/>
                                            </button>
                                        }
                                    }
                                }
                        </div>
                </div>
            </div>
        </div>


    </div>


</div>

<script csp-manager-add-nonce="true">

    document.addEventListener('click', function (event) {
        // Check if the clicked element has the class 'dynamic-button'
        if (event.target.closest('.show-files')) {
            showFiles();

        }
    });
    function showFiles() {
        const agree = document.getElementById('agree');
        const downloadBtn = document.getElementById('download-btn');
        if (!agree.checked) {
            agree.checked=true;
            downloadBtn.disabled = false;
        } else {
            agree.checked = false;
            downloadBtn.disabled = true;
        }
    }

</script>