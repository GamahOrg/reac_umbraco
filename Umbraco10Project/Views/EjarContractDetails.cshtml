@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco10Project.Models.EjarContractDetailsModel>

@using Umbraco10Project.Models
@using Umbraco10Project.Helpers
@{
    Layout = "Master.cshtml";
    bool ar = Umbraco.CultureDictionary.Culture.ToString() == "ar-JO";

    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = true,
        title =  ""
    };
}
<div class="wafi-project-details-page">
    @await Html.PartialAsync("BreadCrumb", ancestors)


    <div class="container mt-4">

        <div class="card">
            <div class="card-body">
                <div class="row">
                    <p class="title text-primary">معلومات العقد</p>

                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("رقم العقد","رقم العقد"): </span><span>@Model?.response?.Body?.contract_no</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("حالة العقد","حالة العقد"): </span><span>@Umbraco.GetDictionaryValueOrDefault(Model?.response?.Body?.contract_status,Model?.response?.Body?.contract_status)</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("نوع العقد","نوع العقد"): </span><span>@Umbraco.GetDictionaryValueOrDefault(Model?.response?.Body?.contract_type,Model?.response?.Body?.contract_type)</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("تاريخ العقد","تاريخ العقد"): </span><span>@Model?.response?.Body?.contract_date</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("تاريخ بداية العقد","تاريخ بداية العقد"): </span><span>@Model?.response?.Body?.contract_start_date</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("تاريخ نهاية العقد","تاريخ نهاية العقد"): </span><span>@Model?.response?.Body?.contract_end_date</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("مدة العقد","مدة العقد"): </span><span>@Model?.response?.Body?.contract_duration</span></p>
                </div>
                <hr/>
                <div class="row">
                    <p class="title text-primary">موقع العقار</p>

                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("المنطقة","المنطقة"): </span><span>@Model?.response?.Body?.contract_building_location?.Region?.name_ar</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("المدينة","المدينة"): </span><span>@Model?.response?.Body?.contract_building_location?.City?.name_ar</span></p>
                    <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("الحي","الحي"): </span><span>@Model?.response?.Body?.contract_building_location?.District?.name_ar</span></p>
                </div>
                <hr/>
                <div class="row">
                    <p class="title text-primary">المستأجر</p>
  
                        <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("اسم المؤجر","اسم المستأجر"): </span><span>@Utils.MaskNameExceptFirstWord(@Model?.response?.Body?.Tenant?.tenant_name ?? "")</span></p>
                        <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("صفة المؤجر","صفة المستأجر"): </span><span>@Model?.response?.Body?.Tenant?.party_type</span></p>
                </div>
                <hr/>
                <div class="row">
                    <p class="title text-primary">المؤجرين</p>
                    @foreach (var lessor in Model?.response?.Body?.Lessors ?? [])
                    {
                        <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("اسم المؤجر","اسم المؤجر"): </span><span>@Utils.MaskNameExceptFirstWord(lessor.lessor_name ?? "")</span></p>
                        <p class="small"><span class="title">@Umbraco.GetDictionaryValueOrDefault("صفة المؤجر","صفة المؤجر"): </span><span>@lessor.party_type</span></p>
                    }
                </div>
                
            </div>
            </div>


    </div>

</div>