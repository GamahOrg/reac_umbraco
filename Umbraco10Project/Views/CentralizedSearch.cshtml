@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.CentralizedSearch>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco10Project.Models
@{
Layout = "Master.cshtml";
SearchInput searchInput = new SearchInput();
var ancestorsList = Model.Ancestors().Reverse().ToList();
var ancestors = new AncestorsModel()
{
ancestors = ancestorsList,
content = Model,
disableRoot = true,
title = Model.Value("pageTitle")?.ToString() ?? ""
};
}

<div class="centralized-search-page">
    @await Html.PartialAsync("BreadCrumb", ancestors)

    <div class="container mt-4">
        <div class="row">
            <div class="col-12">
                <p>@Model.ShortBrief</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                @await Component.InvokeAsync("RenderForm", new { formId = Model.FormRef, theme = "centralized-search", includeScripts = true })

            </div>
        </div>

    </div>

</div>

