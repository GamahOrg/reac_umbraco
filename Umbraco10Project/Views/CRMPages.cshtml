@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Umbraco10Project.Models
@using uSync.Core
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<CRmpages>
@{
	Layout = "Master.cshtml";
	var ancestorsList = Model.Ancestors().Reverse().ToList();
	bool ar = Umbraco.CultureDictionary.Culture.ToString() == "ar-JO";

	if (ancestorsList.Count > 1)
	{
		ancestorsList.RemoveAt(1); // Remove the first parent
	}

	var ancestors = new AncestorsModel()
	{
		ancestors = ancestorsList,
		content = Model,
		disableRoot = true,
		title = Model.Value("pageTitle")?.ToString() ?? "",
		ActionPushToEnd = true,
		action =
		[
			new AncestorsActionModel
			{
				Text = Umbraco.GetDictionaryValueOrDefault("Back to homepage", "العودة للقائمة الرئيسية"),
				PushToEnd = true,
				Outline = true,
				Url = ar ? "/media-center/الدعم-والمساعدة/" : "/en/media-center/الدعم-والمساعدة/"
			},

			new AncestorsActionModel
			{
				Text = Umbraco.GetDictionaryValueOrDefault("Logout", "تسجيل الخروج"),
				PushToEnd = true,
				Url = "/umbraco/surface/services/LogOut"
			}
		]
	};
}

<div class="crm-page">
	@await Html.PartialAsync("BreadCrumb", ancestors)
	<div class="container mt-4 p-2">
		@await Component.InvokeAsync("CRMCreate",Model?.Id.ToString() ?? "")

	</div>
</div>
