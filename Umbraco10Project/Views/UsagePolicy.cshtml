@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<UsagePolicy>
@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = true,
        title = Model.Value("pageTitle")?.ToString() ?? ""
    };
}
<div class="usage-policy-page ">
    @await Html.PartialAsync("BreadCrumb", ancestors)

    <div class="container mt-4">


            <div class="card">
                <div class="card-body">
                    
                    <h3 class="text-">@Model.BoxesTitle</h3>
                    <p class="content">@Model.PageDescription</p>
                    @{
                        if (Model.UsagePolicyBoxes != null)
                        {
                            @foreach (var box in Model.UsagePolicyBoxes)
                            {
                                    <div class="row">
                                        <div class="col-auto justify-content-center text-center pe-0">
                                            @{
                                                if (box.ItemImage != null)
                                                {
                                                    <img src="@box.ItemImage?.Url()" alt="Usage policy image" class="img-fluid small-icon ms-1 me-1"/>
                                                }
                                            }
                                        </div>
                                        <div class="col ps-2">
                                            <p class="">@box.Title</p>
                                            <div class="content mt-3">
                                                @box.ItemBreif
                                            </div>

                                        </div>

                                    </div>
                            }
                        }
                    }
                </div>
        </div>

            <div class="card mt-4">
                <div class="card-body">


                        <h3 class="">@Model.BottomSectionTitle</h3>
                        <p class="content">@Model.BoxesDescription</p>
                        @{
                            if (Model.BottomSectionBoxes != null)
                            {
                                @foreach (var box in Model.BottomSectionBoxes)
                                {
                                    <div class="row">
                                        <div class="col-auto justify-content-center text-center pe-0">
                                            @{
                                                if (box.ItemImage != null)
                                                {
                                                    <img src="@box.ItemImage?.Url()" alt="Usage policy image" class="img-fluid small-icon ms-1 me-1"/>
                                                }
                                            }
                                        </div>
                                        <div class="col ps-2">
                                            <p class="text-">@box.Title</p>
                                            <div class="content mt-3">
                                                @box.ItemBreif
                                            </div>

                                        </div>

                                    </div>
                                }
                            }
                        }
                </div>
        </div>

    </div>

</div>