@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<PageNotFound>
@{
    Layout = "Master.cshtml";
    var homePage = Umbraco.Content(1058);
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = [],
        content = Model,
        disableRoot = true,
        title = Model.Value("pageTitle")?.ToString() ?? ""
    };
}
<div class="not-found-page">
    @await Html.PartialAsync("BreadCrumb", ancestors)

    <div class="container mt-4">


        <div class="row">
            @Model?.Name

        </div>


    </div>


</div>