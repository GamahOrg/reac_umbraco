@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Forms.Web
@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HelpAndSupport>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "Master.cshtml";
	var ancestorsList = Model.Ancestors().Reverse().ToList();
	var ancestors = new AncestorsModel()
	{
		ancestors = ancestorsList,
		content = Model,
		disableRoot = true,
		title = Model.Value("pageTitle")?.ToString() ?? ""
	};
}
@Html.RenderUmbracoFormDependencies(Url)

<div class="reach-us-page">
	@await Html.PartialAsync("BreadCrumb", ancestors)

	<div class="container mt-5">

		@if (Model.Pages != null)
		{
			<div class="row">
				@foreach (var page in Model.Pages)
				{
					var item = (HelpAndSupportPages)page.Content;
					<div class="col-lg-6 col-12 mb-4">
						<div class="card">
							<div class="card-body">
								<div class="row">
									<div class="col-auto justify-content-center text-center pe-0">
										@{
											if (item.Icon != null)
											{
												<img src="@item.Icon?.Url()" alt="Reach Us icon"
												     class="ms-1 me-1"/>
											}
										}
									</div>
									<div class="col ps-2">
										<span class="title">@item.Title</span>
										<div class="content">
											@item.Description
										</div>

									</div>

								</div>
							</div>
							<div class="card-footer">
								<button class="btn btn-outline-primary onclick"   data-action="redirect" data-value="@item.Page?.Url()" >@Umbraco.GetDictionaryValue("Lunch the service")</button>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>


</div>