@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContactUs>
@using Umbraco10Project.Helpers
@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();

    var actionButtons = new List<AncestorsActionModel>();
    if (Model.ServiceButtonPage != null)
    {
        actionButtons.Add(new AncestorsActionModel {
            Text = Model.ServiceButtonText ?? "",
            Url = Model.ServiceButtonPage?.Url()
        });
    }
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        disableRoot = true,
        title = Model.Value("pageTitle")?.ToString() ?? "",
        action = actionButtons
    };
}

<div class="contact-us-page">
    @await Html.PartialAsync("BreadCrumb", ancestors)
    <div class="container mt-4">


        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-8">
                <div class="row">

                    <div class="col-12">
                        <p class="title">@Model.BranchesTitle</p>
                    </div>

                    <div class="accordion accordion-flush" id="accordionFAQ">


                        @{
                            var counter = 1;
                            foreach (var item in Model.Branches)
                            {
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button @(counter == 1 ? "" : "collapsed")"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                aria-label="collapse"
                                                data-bs-target="#@item.Key"
                                                aria-expanded="@(counter == 1)"
                                                aria-controls="@item.Key">
                                            @item.BranchName
                                        </button>
                                    </h2>
                                    <div id="@item.Key"
                                         class="accordion-collapse collapse @(counter == 1 ? "show" : "")"
                                         data-bs-parent="#accordionFAQ">
                                        <div class="accordion-body">
                                            @{
                                                foreach (var subItem in item.ContactItems)
                                                {
                                                    var iconURl = subItem.Icon != null ? subItem.Icon.Url() : "";
                                                    <img src="@iconURl" alt="Contact Icon" width="20" height="20"
                                                         class="small-icon"/>
                                                    <span>
                                                        <span class="title">
                                                            @subItem.Title
                                                        </span>
                                                        <span
                                                            class="content ms-2 me-2"> @Utils.StripHTML(subItem.Text?.Replace("&quot;", "\"").Replace("&nbsp;", "") ?? "")</span>
                                                    </span>
                                                }
                                            }
                                            <div class="rounded-radius map mt-2" style="height: 100%"
                                                 id="mapDiv">@item.Map</div>

                                        </div>
                                    </div>
                                </div>
                                counter += 1;
                            }
                        }
                    </div>

                </div>

            </div>
            <div class="col-12 col-sm-12 col-md-12 col-lg-4 mb-2">
                <div>
                    @await Html.PartialAsync("Contact", Model)
                </div>
            </div>
        </div>


    </div>
</div>