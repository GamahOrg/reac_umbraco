@using Umbraco10Project.Helpers
@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<WhoWeAre>
@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        title = Model.Value("pageTitle")?.ToString() ?? "",
        disableRoot = true,

    };
}

<div class="about-us-page bg-white">
    @await Html.PartialAsync("BreadCrumb", ancestors)


    <div class=" mt-4">
        <div class="container">
            <div class="row">
                <div class="row">
                    <div class="col-12">
                        @Utils.StripHTML(Model.RightBrief?.ToString()?.Replace("&quot;", "\"").Replace("&nbsp;", "") ?? "")
                    </div>
                    <div class="col-12 ">
                        @Utils.StripHTML(@Model.RightFactsTitle?.Replace("&quot;", "\"").Replace("&nbsp;", "") ?? "")
                    </div>
                </div>
            </div>


            <div class="row">
                @foreach (var rightFact in Model.RightFacts)
                {
                    <div class="col-md-12 col-lg-6 col-12 mt-4">
                        <div class="card">
                            <div class="card-body align-content-center">
                            <div>
                                <img src="@rightFact?.Icon?.Url()" alt="right icon" class="small-icon" style="width: 30px"/>
                                <span class="title">@Utils.StripHTML(rightFact?.Title?.Replace("&quot;", "\"").Replace("&nbsp;", "") ?? "")</span>
                            </div>
                            <p class="">@rightFact?.ShortBrief</p>
                            </div>
                        </div>
                    </div>
                }
            </div>


        </div>
    </div>


</div>