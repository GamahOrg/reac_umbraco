@using Umbraco10Project.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<AboutOpenData>
@{
    Layout = "Master.cshtml";
    var ancestorsList = Model.Ancestors().Reverse().ToList();
    var ancestors = new AncestorsModel()
    {
        ancestors = ancestorsList,
        content = Model,
        title = Model.Value("pageTitle")?.ToString() ?? "",
        disableRoot = true,
        action = new List<AncestorsActionModel>()
        {
            new(){
                Text = @Umbraco.GetDictionaryValue("request-open-data"),
                Url = @Umbraco.Content(2777).Url(),
                PushToEnd = true
            }
        }
    };
}

<div class="about-open-data">
    @await Html.PartialAsync("BreadCrumb", ancestors)

    <div class="container mt-5">


        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <p class="text-primary h5">@Model.OpenDataTitle</p>
                        <ul>
                            @{
                                foreach (var step in @Model.RequestOpenDataSteps)
                                {
                                    var item = (AboutOpenDataSteps)step.Content;

                                    if (item.IsTree)
                                    {
                                        <ul class="tree">
                                            @{
                                                foreach (var subTreeElement in item.TreeElements)
                                                {
                                                    var subItem = (AboutOpenDataSteps)subTreeElement.Content;
                                                    <li class="">
                                                        <p class="ms-2 mb-0 text-primary fw-bold">@subItem.Title</p>
                                                        <p class="ms-2 mb-0">
                                                           @subItem.Content
                                                        </p>
                                                    </li>
                                                }
                                            }
                                            
                                        </ul>
                                    }
                                    else
                                    {
                                        <li>
                                            <p>@item.Title</p>
                                            <div>@item.Content</div>
                                        </li>
                                    }
                                }
                            }
                        </ul>


                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <p class="text-primary h5">@Model.PolicyTitle</p>
                        <p class="content">
                            @Model.PolicyContent
                        </p>
                        @foreach (var rightFact in Model.PolicyItems)
                        {
                            <div class="row">
                                <div class="col-auto justify-content-center text-center pe-0">
                                    <img src="@rightFact.Icon?.Url()" alt="principles" class="img-fluid small-icon" width="30" height="30"/>

                                </div>
                                <div class="col ps-2">
                                    <p class="title text-primary m-0">@rightFact.Title</p>
                                    <p class="content">
                                        @rightFact.ShortBrief
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12 ">
                <div class="card">
                    <div class="card-body">
                        <p class="h5 text-primary">@Model.KeyPrinciplesTitle</p>

                        @foreach (var principle in Model.KeyPrinciplesItems)
                        {
                            var item = (KeyPrinciples)principle.Content;
                            <div class="row">
                                <div class="col-auto justify-content-center text-center pe-0">
                                    <img src="@item.Icon?.Url()" alt="principles" class="img-fluid small-icon" width="30" height="30"/>

                                </div>
                                <div class="col ps-2">
                                    <p class="title text-primary m-0 ">@item.Title</p>
                                    <p class="content">
                                        @item.Content
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 mt-4">
                <div class="card" style="height: 100%">
                    <div class="card-body">

                        @foreach (var rightFact in Model.BottomFacts)
                        {
                            <p class="text-primary h5">@rightFact.Title</p>
                            <p class="content">
                                @rightFact.ShortBrief
                            </p>
                        }
                    </div>
                </div>
            </div>


        </div>


    </div>


</div>