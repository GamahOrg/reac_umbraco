    <newsText>
      <Value><![CDATA[{
  "markup": "<p style=\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s8\"><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">كشف الرئيس التنفيذي للهيئة العامة للعقار المشرف العام على معرض سيتي سكيب العالمي 2024 المهندس</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">عبد الله</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">بن سعود الحماد</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">خلال اللقاء التعريفي \"بسيتي سكيب\"</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">أنَ المعرض</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الذي يعد</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الحدث العقاري الأكبر والأضخم عالميًا،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وتستضيفه</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">السعودية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">للعام الثاني، برعاية وزارة والبلديات والإسكان وبالشراكة بين الهيئة العامة للعقار، وبرنامج الإسكان أحد برامج رؤية</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">2030.</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">سيقام بنسخته الثانية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">خلال الفترة من 11 إلى 14 نوفمبر المقبل في</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مركز الرياض للمعارض والمؤتمرات</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">\"ملهم\" بالعاصمة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الرياض تحت شعار</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">\"مستقبل الحياة\" ،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وسيشهد تجمع</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">أكثر من</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">400</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">جهة عارضة من أهم وأكبر الشركات العالمية والوطنية في مجال الاستثمار والتطوير العقاري، وأكثر من</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">100</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">من مستثمر مؤسسي، وأكثر من 500 من قادة القطاع الدوليين والمحليين.</span></p>\n<p style=\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s8\"><span class=\"bumpedfont15\">وأضاف</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الرئيس التنفيذي \"لهيئة العقار \"</span><span class=\"bumpedfont15\">&nbsp;أن استضافة المملكة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">العربية السعودية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">لهذا المعرض تعكس النهضة العقارية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الكبرى</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">التي</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">تعيشها في ظل رؤية السعودية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">2030، مما يعزز دور</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">القطاع العقاري باعتباره</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">محركًا</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">رئيسيًا للاقتصاد الوطني،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وأنّ \"</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">معرض سيتي سكيب العالمي</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">2024</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">\" سيساهم في تحقيق أهداف القطاع العقاري من خلال توفير منصات متعددة وتجارب متميزة لعرض الابتكارات، وتبادل التجارب، والتقنيات العقارية ، بما يسهم في زيادة</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">الفرص الاستثمارية المتنوعة في السوق العقاري السعودي، وجذب المزيد من الاستثمارات الأجنبية، لتنويع الاقتصاد، وتعزيز التنمية المستدامة، حيث حققت النسخة الماضية من \"المعرض \" نجاح في</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">حجم والمعاملات والمشاريع الاستثمارية والاتفاقيات</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الاستراتيجية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">بأكثر من</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">110</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مليار ريال، والاستثمارات الخارجية بأكثر من</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">19</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مليار دولار، وفي هذه النسخة نطمح لنحقق ارتفاع بنسبة تتجاوز</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">50%.</span></p>\n<p style=\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s8\"><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">وأشار \"الحماد \" إلى أنّ النجاحات السابقة</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">زادت الفرص هذا العام ومنها توفير أكثر من</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">100</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">ألف وحدة سكنية بعروض حصرية وحلول تمويلية تسهل رحلة التملك</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">للمساكن،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">إضافة إلى</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">استعراض للمشاريع الفريدة والفرص المتنوعة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">التي</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">يقدمها الشركاء، مثل</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الشركة الوطنية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">للإسكان</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">نيوم،و</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">روشن،والمربع</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الجديد و</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مركز الملك عبدالله المالي (كافد)، والدرعية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">، كما ستتيح هذه النسخة من \"المعرض \" العديد من الفرص الاستثمارية العقارية من خلال أكبر مزاد عقاري</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مباشر في الشرق الأوسط بالتعاون مع</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مركز الإسناد والتصفية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">(إنفاذ)، تتجاوز قيمته التقديرية مليار ريال</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وما</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">نشهده اليوم من نهضة في القطاع العقاري يأتي نتاج البنية التحتية القانونية التي أوجدتها التشريعات العقارية مما يعزز من متانة السوق العقاري السعودي والموثوقية به ويجعله جاذب للاستثمارات والمستثمرين .</span></span><span class=\"apple-converted-space\">&nbsp;</span></p>\n<p style=\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s8\"><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">يذكر أن \"</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">معرض سيتي سكيب العالمي 2024</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">\"</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">سيتيح</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">للمستثمرين الشباب وأصحاب الشركات الناشئة،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">فرص</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">التواصل</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">المباشر مع المستثمرين والمطورين العقاريين</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">المحليين والدوليين، وعرض مشاريعهم وأفكارهم، مع فرصة الفوز بجوائز تصل إلى</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">1.5</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مليون ريال في مسابقة \"روشن</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">هاكثون2024\" التي تهدف</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">إلى تشجيع الابتكار والإبداع في إيجاد حلول تكنولوجية مبتكرة لمعالجة التحديات الكبرى في القطاع العقاري باستخدام مختلف التقنيات الحديثة.</span></span></p>",
  "blocks": {
    "contentData": [],
    "settingsData": []
  }
}]]></Value>
    </newsText>
