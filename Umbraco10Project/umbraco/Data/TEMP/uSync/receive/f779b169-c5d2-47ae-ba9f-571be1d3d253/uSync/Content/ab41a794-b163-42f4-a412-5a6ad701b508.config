  <Properties>
    <description>
      <Value Culture="ar-jo"><![CDATA[مؤتمر الاتحاد الدولي للعقار يُعدّ من أكبر التجمعات التي تجمع المتخصصين في القطاع العقاري من جميع أنحاء العالم ويوفر منصة للتواصل وتبادل المعرفة وبناء العلاقات، ويضم خبراء الصناعة الذين يشاركون وجهات نظرهم حول أحدث الاتجاهات والتطورات في قطاع العقارات]]></Value>
    </description>
    <endDate>
      <Value Culture="ar-jo"><![CDATA[2024-05-31T00:00:00]]></Value>
    </endDate>
