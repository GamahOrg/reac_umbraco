t: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\" dir=\"RTL\" class=\"MsoNormal\" align=\"center\"><strong>المواصفات</strong></p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 1; height: 2.05pt;\">\n<td colspan=\"2\" width=\"236\" style=\"width: 177.2pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-top: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; padding: 0in 0in 0in 0in; height: 2.05pt;\">\n<p style=\"mso-para-margin-top: .2gd; mso-para-margin-right: 0in; mso-para-margin-bottom: .2gd; mso-para-margin-left: 0in; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\" dir=\"RTL\" class=\"MsoNormal\" align=\"center\"><span>15 – 50 سنتمتر</span></p>\n</td>\n<td width=\"204\" style=\"width: 152.75pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: solid #BFBFBF 1.0pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-left-alt: solid #BFBFBF .5pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 0in 0in 0in; height: 2.05pt;\">\n<p style=\"mso-para-margin-top: .2gd; mso-para-margin-right: 0in; mso-para-margin-bottom: .2gd; mso-para-margin-left: 0in; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\" dir=\"RTL\" class=\"MsoNormal\" align=\"center\">5 – 15 سنتمتر</p>\n</td>\n<td width=\"174\" style=\"width: 130.75pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: solid #BFBFBF 1.0pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-left-alt: solid #BFBFBF .5pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; background: #E7E6E6; mso-background-themecolor: background2; padding: .75pt 5.4pt 0in 5.4pt; height: 2.05pt;\">\n<p style=\"mso-para-margin-top: .2gd; mso-para-margin-right: 0in; mso-para-margin-bottom: .2gd; mso-para-margin-left: 0in; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\" dir=\"RTL\" class=\"MsoNormal\" align=\"center\"><span style=\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext;\" lang=\"AR-SA\">درجة الوضوح</span><span style=\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext;\" lang=\"AR-SA\"> </span>للصورة</p>\n</td>\n</tr>\n<tr style=\"mso-yfti-irow: 2; height: 12.7pt;\">\n<td colspan=\"2\" width=\"236\" style=\"width: 177.2pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-top: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; padding: 0in 0in 0in 0in; height: 12.7pt;\">\n<p style=\"mso-para-margin-top: .2gd; mso-para-margin-right: 0in; mso-para-margin-bottom: .2gd; mso-para-margin-left: 0in; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\" dir=\"RTL\" class=\"MsoNormal\" align=\"center\"><span>200</span><span style=\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri;\" lang=\"AR-SA\"> </span><span style=\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri;\" lang=\"AR-SA\">&nbsp;سنتمتر</span></p>\n</td>\n<td width=\"204\" style=\"width: 152.75pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: solid #BFBFBF 1.0pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-left-alt: sol