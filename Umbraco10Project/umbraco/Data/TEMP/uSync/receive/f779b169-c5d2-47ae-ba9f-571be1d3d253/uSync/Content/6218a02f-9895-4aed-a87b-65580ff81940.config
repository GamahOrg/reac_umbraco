    <NodeName Default="بيع وتأجير مشروعات عقارية على الخارطة">
      <Name Culture="ar-jo">بيع وتأجير مشروعات عقارية على الخارطة</Name>
      <Name Culture="en-us">Wafi – Off-Plan Sales &amp; Lease</Name>
    </NodeName>
    <SortOrder>4</SortOrder>
    <Published Default="true">
      <Published Culture="ar-jo">true</Published>
      <Published Culture="en-us">true</Published>
    </Published>
    <Schedule />
    <Template Key="1c13c3d5-3008-4d88-a473-f63eb161685d">ServicesDetails</Template>
  </Info>
  <Properties>
    <buttonText>
      <Value Culture="ar-jo"><![CDATA[بدء الخدمة]]></Value>
      <Value Culture="en-us"><![CDATA[Go to Service]]></Value>
    </buttonText>
    <description>
      <Value Culture="ar-jo"><![CDATA[تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه]]></Value>
      <Value Culture="en-us"><![CDATA[Wafi is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.]]></Value>
    </description>
    <headerBackgroundImage>
      <Value><![CDATA[]]></Value>
    </headerBackgroundImage>
