    <newsText>
      <Value><![CDATA[{
  "markup": "<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: center; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s3\" align=\"center\"><span class=\"bumpedfont15\"><span style=\"font-size: 18.0pt; color: black;\" lang=\"AR-SA\">هيئة العقار:</span></span><span class=\"apple-converted-space\"><strong>&nbsp;</strong></span><strong><span style=\"font-size: 18.0pt; color: black;\" lang=\"AR-SA\">ملتقى</span></strong><span class=\"apple-converted-space\"><strong>&nbsp;</strong></span><span class=\"bumpedfont15\"><strong>الوساطة العقارية</strong></span><span class=\"apple-converted-space\"><strong>&nbsp;</strong></span><span class=\"bumpedfont15\"><strong>يجمع الخبراء والممارسين</strong></span><span class=\"apple-converted-space\"><strong>&nbsp;</strong></span></p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s4\">&nbsp;</p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s6\"><span class=\"bumpedfont15\">تنظم</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الهيئة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">العامة للعقار</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">\"ملتقى</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الوساطة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">العقارية\"</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">والمعرض</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">المصاحب&nbsp;له</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الأربعاء القادم</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">17</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">يوليو</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">2024</span><span class=\"apple-converted-space\">&nbsp;في&nbsp;</span><span class=\"bumpedfont15\">مركز</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الرياض الدولي للمؤتمرات</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">والمعارض،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">بمناسبة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مرور عام على نفاذ</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">النظام،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">بمشاركة نخبة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">من الخبراء في القطاع العقاري والمختصين في التقنيات العقارية للحديث عن</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الفرص و</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">مستقبل السوق العقاري.</span><span class=\"apple-converted-space\">&nbsp;</span></p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s6\">&nbsp;</p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s6\"><span class=\"bumpedfont15\">وذكر</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">المتحدث الرسمي \"للهيئة \" أ.تيسير بن محمد المفرج &nbsp;\" أنّ نظام الوساطة العقارية</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">ساهم في استدامة الأصول العقارية،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وحفظ حقوق المتعاملين،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وقد أسهم في تعزيز</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">شفافية السوق العقاري، وأنّ</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">ملتقى الوساطة العقارية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">\"</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">في نسخته الأولى</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">يأتي</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">في إطار الجهود المستمرة لتطوير</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">خدمات النشاط والتعاملات فيه</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وبناء قطاع</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">عقاري</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">متين</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">متقدم</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الاستراتيجية الشاملة للقطاع</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">حيث</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">سيتضمن \" الملتقى “عدد</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">من الجلسات الحوارية التي تناقش</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">التأثير والفرص والتحديات</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وأثر المنصات العقارية على مستقبل السوق العقاري، بالإضافة إلى</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">تسليط الضوء على المنصات العقارية ذات التجارب الناجحة في نشاط الوساطة العقارية،</span></span><span class=\"apple-converted-space\">&nbsp;</span></p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s6\">&nbsp;</p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s6\"><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">وأشار \"المفرج\"</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">إلى أنّ</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">\"</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الملتقى \"</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">سيصاحبه معرض للتعريف بالأنشطة&nbsp;العقارية وأقسام خاصة لخدمة المستفيدين من منصة الوساطة العقارية وخدمات المعهد العقاري وكذلك قسم لاستقبال الأسئلة والاستفسارات وخدمة</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">الشركاء،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">بما يعزز إيصال رسائل القطاع العقاري</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">والتعريف بالأنظمة والتشريعات</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">العقارية التي تأتي وفي&nbsp;التوجهات والاستراتيجيات التي</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">تعمل عليها الهيئة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">بمبدأ الشفافية&nbsp;وزيادة مشاركة</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">المجتمع،</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">لتحقيق</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">تنمية واستدامة القطاع.</span></p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s6\">&nbsp;</p>\n<p style=\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"s4\"><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">يذكر أنّ \" نظام الوساطة العقارية</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">“دخل</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">حيز النفاذ في 25 جمادى الأولى 1444هـ الموافق 18 يناير 2023</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">ويهدف إلى</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">تنظيم</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">الوساطةوالخدمات العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، ودعم أنشطة الوسطاء العقاريين والمستفيدين، إضافةً إلى المساهمة في استدامة الأصول العقارية.</span></span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">وأن \" ملتقى الوساطة العقارية \" موجه</span><span class=\"apple-converted-space\">&nbsp;للعموم</span><span class=\"bumpedfont15\">&nbsp;والمهتمين وأصحاب الاختصاص</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">بالمجال</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\">العقاري ومزاولي أنشطة الوساطة العقارية</span><span class=\"apple-converted-space\">&nbsp;</span><span class=\"bumpedfont15\"><span style=\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\" lang=\"AR-SA\">وتقديم الاستشارات والتحليلات العقارية، للاستفادة&nbsp;من موضوعات الجلسات الحوارية والمعرض المصاحب&nbsp;له، مما يعزز رفع الوعي في التعاملات العقارية</span></span><span class=\"apple-converted-space\">&nbsp;</span></p>",
  "blocks": {
    "contentData": [],
    "settingsData": []
  }
}]]></Value>
    </newsText>
