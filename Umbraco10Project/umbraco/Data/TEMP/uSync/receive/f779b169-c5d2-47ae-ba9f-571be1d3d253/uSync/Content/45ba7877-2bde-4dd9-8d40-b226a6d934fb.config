  <Properties>
    <bottomFacts>
      <Value Culture="ar-jo"><![CDATA[[
  {
    "key": "c93bec4e-ecfe-448e-835f-bfc4abd1df50",
    "name": "Item 1",
    "ncContentTypeAlias": "fact",
    "PropType": null,
    "title": "حقوق الأفراد فيما يتعلق بالوصول الى المعلومات العامة أو الحصول عليها",
    "shortBrief": "{\"markup\":\"<ul style=\\\"list-style-type: disc;\\\">\\n<li>حق الاطلاع والحصول على أي معلومة غير محمية لدى أي جهة عامة.</li>\\n<li>الحق في معرفة سبب رفض الاطلاع أو الحصول على المعلومات المطلوبة.</li>\\n<li>الحق في التظلم على قرار رفض طلب الاطلاع والحصول على المعلومات المطلوبة.</li>\\n</ul>\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}",
    "icon": "[]"
  }
]]]></Value>
      <Value Culture="en-us"><![CDATA[[
  {
    "key": "fd1831f0-f843-4fd3-8364-cc6bdd132e42",
    "name": "Item 1",
    "ncContentTypeAlias": "fact",
    "PropType": null,
    "title": "The Rights of Individuals to Access and Obtain Public Information: ",
    "shortBrief": "{\n  \"markup\": \"<ul style=\\\"list-style-type: disc;\\\">\\n<li>The right to access and obtain any information not protected by any public entity. </li>\\n<li>The right to know the reason for refusing to access or obtain the required information. </li>\\n<li>The right to appeal against the decision to refuse to access or obtain the required information.</li>\\n</ul>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}",
    "icon": "[]"
  }
]]]></Value>
    </bottomFacts>
