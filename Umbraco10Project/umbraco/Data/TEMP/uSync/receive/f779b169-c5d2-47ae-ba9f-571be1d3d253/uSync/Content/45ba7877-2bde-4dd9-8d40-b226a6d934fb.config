    <keyPrinciplesItems>
      <Value Culture="ar-jo"><![CDATA[{
  "layout": {
    "Umbraco.BlockList": [
      {
        "contentUdi": "umb://element/4099e57067e749bdbef4abc83890044f"
      },
      {
        "contentUdi": "umb://element/73939d70beee459c994bcb4dcdf136d8"
      },
      {
        "contentUdi": "umb://element/a5090fb06ccc4846adf9721376469f74"
      },
      {
        "contentUdi": "umb://element/bd2b76cb280e42a3b712d7478862ed13"
      }
    ]
  },
  "contentData": [
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/4099e57067e749bdbef4abc83890044f",
      "title": "الشفافية",
      "content": "للفرد الحق في معرفة المعلومات المتعلقة بأنشطة الهيئة تعزيزاً لمنظومة النزاهة والشفافية والمساءلة.",
      "icon": [
        {
          "key": "232e053c-2113-4264-a59f-2eb4fbd92c48",
          "mediaKey": "f7b3357f-3ca9-4560-be12-49ad590f7540"
        }
      ]
    },
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/73939d70beee459c994bcb4dcdf136d8",
      "title": "الضرورة والتناسب",
      "content": "أي قيود على طلب الاطلاع أو الحصول على المعلومات المحمية التي تتلقاها أو تنتجها أو تتعامل معها الهيئة يجب أن تكون مبررة بطريقة واضحة وصريحة.",
      "icon": [
        {
          "key": "03aa7750-9598-472e-9012-48b6f7d572b6",
          "mediaKey": "e59dc720-73f5-4c85-a769-db1c6aee7c02"
        }
      ]
    },
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/a5090fb06ccc4846adf9721376469f74",
      "title": "الأصل في المعلومات الإفصاح",
      "content": "لكل فرد الحق في الاطلاع على المعلومات العامة -غير المحمية- وليس بالضرورة أن يتمتع مقدم الطلب بحيثية معينة أو باهتمام معين بهذه المعلومات ليتمكن من الحصول عليها، كما لا يتعرض لأي مساءلة قانونية متعلقة بهذا الحق.",
      "icon": [
        {
          "key": "8afc0ca2-888e-4b06-8833-cd174ef5e87b",
          "mediaKey": "529fb8e3-4611-4cb2-862b-77e06de1d76f"
        }
      ]
    },
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/bd2b76cb280e42a3b712d7478862ed13",
      "title": "المساواة",
      "content": "يتم التعامل مع جميع طلبات الاطلاع أو الحصول على المعلومات العامة على أساس المساواة وعدم التمييز بين الأفراد.",
      "icon": [
        {
          "key": "5f4df4e1-b1fd-4ae8-ae87-264201876a23",
          "mediaKey": "93fe67dd-48ba-4258-80d5-80cbf43dd31e"
        }
      ]
    }
  ],
  "settingsData": []
}]]></Value>
      <Value Culture="en-us"><![CDATA[{
  "layout": {
    "Umbraco.BlockList": [
      {
        "contentUdi": "umb://element/d21d9c226312415db9658f4bcf7a3832"
      },
      {
        "contentUdi": "umb://element/5c3a0b4c29124261af0a583e2238696e"
      },
      {
        "contentUdi": "umb://element/8a86fbd070f148e39a58dde9fd25ccec"
      },
      {
        "contentUdi": "umb://element/c2d239bb73444764b602002b9ee3347d"
      }
    ]
  },
  "contentData": [
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/d21d9c226312415db9658f4bcf7a3832",
      "title": "Transparency",
      "content": "The individual has the right to know information related to the Authority’s activities to enhance the ecosystem of integrity, transparency, and accountability. ",
      "icon": [
        {
          "key": "f15bc0b5-0661-4dee-8b5f-0a3583b14e1e",
          "mediaKey": "f7b3357f-3ca9-4560-be12-49ad590f7540"
        }
      ]
    },
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/5c3a0b4c29124261af0a583e2238696e",
      "title": "Necessity and Proportionality",
      "content": "Any restrictions on obtaining or requesting access to protected information received, produced, or handled by the Authority shall be justified clearly and explicitly. ",
      "icon": [
        {
          "key": "54e2d8ad-bc21-4af5-803c-6a4ce188c0b1",
          "mediaKey": "e59dc720-73f5-4c85-a769-db1c6aee7c02"
        }
      ]
    },
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/8a86fbd070f148e39a58dde9fd25ccec",
      "title": "Public Information should be Available",
      "content": "Every applicant has the right to access public – unprotected – information. The applicant does not need to have a particular reason or interest in the information to obtain it, nor be exposed to any legal liability related to this right.",
      "icon": [
        {
          "key": "90c62487-f2a3-4801-be4c-2d560768c3ac",
          "mediaKey": "529fb8e3-4611-4cb2-862b-77e06de1d76f"
        }
      ]
    },
    {
      "contentTypeKey": "7fff1495-08c4-40c0-af8a-0af8f0b9a4a7",
      "udi": "umb://element/c2d239bb73444764b602002b9ee3347d",
      "title": "Equality",
      "content": "All requests made by individuals to access or receive public information shall be dealt with on an equal and non-discriminatory basis. ",
      "icon": [
        {
          "key": "8b209db6-dca0-475c-9ff2-89d2e8527c1e",
          "mediaKey": "93fe67dd-48ba-4258-80d5-80cbf43dd31e"
        }
      ]
    }
  ],
  "settingsData": []
}]]></Value>
    </keyPrinciplesItems>
    <keyPrinciplesTitle>
