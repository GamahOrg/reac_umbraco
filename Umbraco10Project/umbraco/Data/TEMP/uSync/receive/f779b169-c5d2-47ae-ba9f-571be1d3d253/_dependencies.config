der":1000,"level":4,"mode":0,"flags":0},{"name":"تمويل \"وافي\" الثلاثي يخلق التنافسية في قطاع التطوير العقاري","udi":"umb://document/b8143ea79a1341f6a175f06399c49fae","order":1000,"level":4,"mode":0,"flags":0},{"name":"بالتنسيق بين \"الموارد البشرية\" و\" هيئة العقار\" تمكين جمعيات المُلاّك من إصدار الرقم (700)","udi":"umb://document/ee512aaf17854361a0533a695aefee51","order":1000,"level":4,"mode":0,"flags":0},{"name":" 139% نسبة نمو المشاريع الصغيرة والمتوسطة المرخصة من \"وافي\" خلال النصف الأول من 2023","udi":"umb://document/2662f242fb604e9893c4f11bf67886ca","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"هيئة العقار\" تبدأ بتطبيق اللائحة التنظيمية للمزادات العقارية","udi":"umb://document/02867dd8c6924cdbbd08368d18322611","order":1000,"level":4,"mode":0,"flags":0},{"name":" الهيئة العامة للعقار تتيح عقد الوساطة بين الوسيط والمشتري أو المُستأجر","udi":"umb://document/2081e58dbedd45cdb8848926d596d4f2","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للعقار شريك تشريعي لمعرض \"سيتي سكيب\"","udi":"umb://document/12ca5843082b484385c82d962ae24266","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"هيئة العقار\" : 7 ملايين عقد موثّق في \"إيجار\" تعكس زيادة الثقة في القطاع العقاري السعودي","udi":"umb://document/37fd954f7dfb4db4aba4d93810d4b5d7","order":1000,"level":4,"mode":0,"flags":0},{"name":"رئيس \"هيئة العقار \": \r\nما شهده اليوم الأول في سيتي سكيب من إطلاقات لمشاريع عقارية بأكثر من 65 مليار تعكس متانة منظومة التشريعات العقارية وجاذبية السوق العقاري السعودي","udi":"umb://document/f1497395511f4c8cab06a896e981faa9","order":1000,"level":4,"mode":0,"flags":0},{"name":"رئيس \"هيئة العقار\": نظام المساهمات العقارية قناة تمويلية واستثمارية جديدة تُساهم في زيادة المعروض العقاري ","udi":"umb://document/af6088c9c2bc457688d358995b0fc9cf","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"الهيئة العامة للعقار\": غداً الثلاثاء تنتهي المهلة التصحيحية لنظام الوساطة العقارية","udi":"umb://document/2f23fd79b6484c8a9181a8b15b0b8dd9","order":1000,"level":4,"mode":0,"flags":0},{"name":" الهيئة العامة للعقار تعلن بدء تطبيق العمل في أنشطة الوساطة والخدمات العقارية","udi":"umb://document/4855f2dd78ea4f6a9ef9d494e5fab7c5","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"هيئة العقار\" تبدأ بأعمال الرقابة وتدعو الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال وعدم الوقوع في المخالفات","udi":"umb://document/7cb8acb90d134bf1b3a13cf680a4e49e","order":1000,"level":4,"mode":0,"flags":0},{"name":"معرض مسكن العقاري ينطلق بنسخته الثانية في ديسمبر 2023","udi":"umb://document/f4248ae07e554281bf60c2cd496c4e36","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للعقار تصدر رخصة \"فال\" لـ (10) منصات عقارية إلكترونية","udi":"umb://document/f3ed93d8874e4a4a98af96e3fad984b1","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للعقار تطرح مسودة لائحة الاستشارات والتحليلات العقارية عبر منصة \"استطلاع\"","udi":"umb://document/02b55ff5eeaf41ddbb2b6485d9a33291","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"الهيئة العامة للعقار\": ضبط ومعالجة 3500 إعلانًا عقاريًا مخالفًا منذ بدء العمل وفق نظام الوساطة العقارية","udi":"umb://document/68941c84eb8f4c35bb2816cde032038f","order":1000,"level":4,"mode":0,"flags":0},{"name":"\" هيئة العقار \" تُعلن عن نجاح تطبيق السجل العقاري في أول أحياء الرياض وتأسيس الخريطة الرقمية لعقارات السعودية ","udi":"umb://document/fc0da36fac5849bc993338bb6449af9d","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"وافي\" يخالف عدداً من المشاريع العقارية والمطورين وتضبط 244 مشروعًا مخالفًا لنظام البيع على الخارطة خلال النصف الأول من عام 2023","udi":"umb://document/80406a9828784853b88e60476145804b","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للعقار تعقد عددًا من ورش العمل التعريفية للمنصات العقارية لاستكمال متطلبات ترخيص المنصات  برخصة \"فال\" للوساطة والتسويق العقاري","udi":"umb://document/f6dfb2e57db7463ebf988b3c38a21d86","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"إيجار\" يؤكد أهمية إكمال عملية توثيق العقد الإلكتروني قبل إجراء أي عملية دفع للمستحق