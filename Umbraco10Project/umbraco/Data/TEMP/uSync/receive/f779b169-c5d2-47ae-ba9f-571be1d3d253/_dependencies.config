 من 100 مليون متر مربع مفروز حتى أكتوبر الجاري","udi":"umb://document/ecf4e74a4d0846bd9e0b44474abf732f","order":1000,"level":4,"mode":0,"flags":0},{"name":"هيئة العقار: سبعة أحياء في الرياض تستعد غدًا لبدء تسجيل عقاراتها في \" السجل العقاري \" ","udi":"umb://document/f8e4eaf740ea4ab384fd4cbb4c4faae3","order":1000,"level":4,"mode":0,"flags":0},{"name":"\"هيئة العقار\" تدعو ملاَّك العقارات في سبعة أحياء في الرياض تسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ","udi":"umb://document/df67919477ee40c1bc905b73688ef677","order":1000,"level":4,"mode":0,"flags":0},{"name":"الحمَّاد : 36 مليار ريال حجم عمليات القطاع العقاري في المنطقة الشرقية حتى نهاية الربع الثالث 2023م","udi":"umb://document/5eacdb6f2cae4d70952cf586dbd22e8e","order":1000,"level":4,"mode":0,"flags":0},{"name":"هيئة العقار تطلق \"بروبتك السعودية \" الإثنين القادم بمشاركة دولية واسعة  ","udi":"umb://document/02fe7184e8ad4aaf9c6b0d746d0b61eb","order":1000,"level":4,"mode":0,"flags":0},{"name":"هيئة العقار: غدًا انطلاق قمة \"بروبتك السعودية \" لتطوير التقنيات العقارية في السوق السعودي","udi":"umb://document/4876581b974f472f9cce242db8247b0c","order":1000,"level":4,"mode":0,"flags":0},{"name":" الحقيل يكرّم الوسطاء العقاريين المبادرين في الامتثال لنظام الوساطة العقارية","udi":"umb://document/5ba0191844574206a440639587777182","order":1000,"level":4,"mode":0,"flags":0},{"name":"\" هيئة العقار “: 40 ألف عقد وساطة، وإزالة أكثر من 450 ألف إعلان عقاري مخالف منذ بدء الامتثال","udi":"umb://document/c968ad20f8004e519a22be7af31dbf1a","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للعقار تختتم مشاركتها في معرض سيتي سكيب العالمي ","udi":"umb://document/cc95fada98a844ac954483c02909b2cc","order":1000,"level":4,"mode":0,"flags":0},{"name":"الحقيل: يشكر القيادة على موافقة مجلس الوزراء على نظام بيع وتأجير مشروعات عقارية على الخارطة","udi":"umb://document/5887a51e3f51454c895d990a29d64778","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للعقار ووزارة الموارد البشرية والتنمية الاجتماعية تنفذان 