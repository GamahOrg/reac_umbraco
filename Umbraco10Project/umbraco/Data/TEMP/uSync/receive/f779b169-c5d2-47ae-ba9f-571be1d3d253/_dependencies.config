":0,"flags":0},{"name":" \"الهيئة العامة للعقار\" تصدر \"ضوابط الإعلانات العقارية\" ومعايير ترخيص المنصات العقارية الإلكترونية وتصنيفها","udi":"umb://document/03e55abeaf4e434eb6ca0df5e2fc0070","order":1000,"level":4,"mode":0,"flags":0},{"name":"محافظ الهيئة العامة للعقار يستقبل وزير الإسكان والتخطيط العمراني العُماني","udi":"umb://document/119a3d0339f447a6a26e3cc34a226cd3","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للعقار تعقد اجتماعها الخامس عشر لبحث مشروع ضوابط تحليل السوق","udi":"umb://document/8edce7683d154e8695be56e0f9f17268","order":1000,"level":4,"mode":0,"flags":0},{"name":"هيئة العقار تجتمع مع رئاسة أمن الدولة للتأكيد على نزاهة وعدالة التعاملات العقارية والوساطة","udi":"umb://document/f051c35379374a178044561226ed169d","order":1000,"level":4,"mode":0,"flags":0},{"name":"news image 1","udi":"umb://media/91d7a2b4061b4856a9614882734867c4","order":900,"level":2,"mode":0,"flags":32},{"name":"معالي وزير الإسكان يدشن المقر الجديد للمعهد العقاري ومركز خدمة الشركاء بالهيئة العامة للعقار","udi":"umb://document/147c94fbaf5e4a5c9ebf7e8677499585","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة للمساحة والمعلومات الجيومكانية\r\nالهيئة العامة العقار تبحثان التقدم في برنامج الشراكة بينهما\r\n","udi":"umb://document/f88253c682b5451cabda80b496a2b86a","order":1000,"level":4,"mode":0,"flags":0},{"name":"معالي محافظ الهيئة: موافقة مجلس الوزراء على الاستراتيجية الشاملة للقطاع العقاري يؤكد اهتمام القيادة بتنظيم القطاع العقاري وتطويره ورفع كفاءته وتشجيع الاستثمار فيه","udi":"umb://document/cc6663e995774dadb2f5e5011fe24503","order":1000,"level":4,"mode":0,"flags":0},{"name":"الهيئة العامة العقار توقع مذكرة تعاون مع هيئة المساحة والمعلومات الجيومكانية للاستفادة من البيانات والمعلومات والخدمات الجيومكانية","udi":"umb://document/1033196168c14b4487acc72ee3f117a3","order":1000,"level":4,"mode":0,"flags":0},{"name":"الحقيل يرفع الشكر للقيادة بالموافقة على الاستراتيجية الشاملة للقطاع العقاري","udi":"umb://document/50fc0a2b757f41f6a1e8d647aa824232","