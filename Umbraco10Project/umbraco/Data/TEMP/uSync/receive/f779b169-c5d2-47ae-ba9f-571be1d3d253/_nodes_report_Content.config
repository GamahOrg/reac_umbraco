d":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1da162f5-2a4b-45b8-857e-294aa064a5e5","#text":"AboutOpenData"}},"Properties":{"bottomFacts":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"c93bec4e-ecfe-448e-835f-bfc4abd1df50\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"حقوق الأفراد فيما يتعلق بالوصول الى المعلومات العامة أو الحصول عليها\",\n    \"shortBrief\": \"{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>حق الاطلاع والحصول على أي معلومة غير محمية لدى أي جهة عامة.</li>\\\\n<li>الحق في معرفة سبب رفض الاطلاع أو الحصول على المعلومات المطلوبة.</li>\\\\n<li>الحق في التظلم على قرار رفض طلب الاطلاع والحصول على المعلومات المطلوبة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"icon\": \"[]\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"fd1831f0-f843-4fd3-8364-cc6bdd132e42\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"The Rights of Individuals to Access and Obtain Public Information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access and obtain any information not protected by any public entity. </li>\\\\n<li>The right to know the reason for refusing to access or obtain the required information. </li>\\\\n<li>The right to appeal against the decision to refuse to access or obtain the required information.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[]\"\n  }\n]"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عن البيانات المفتوحة"},{"@Culture":"en-us","#cdata-section":"About Open Data"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keyPrinciplesItems":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/4099e57067e749bdbef4abc83890044f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73939d70beee459c994bcb4dcdf136d8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a5090fb06ccc4846adf9721376469f74\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bd2b76cb280e42a3b712d7478862ed13\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/4099e57067e749bdbef4abc83890044f\",\n      \"title\": \"الشفافية\",\n      \"content\": \"للفرد الحق في معرفة المعلومات المتعلقة بأنشطة الهيئة تعزيزاً لمنظومة النزاهة والشفافية والمساءلة.\",\n      \"icon\": [\n        {\n          \"key\": \"232e053c-2113-4264-a59f-2eb4fbd92c48\",\n          \"mediaKey\": \"f7b3357f-3ca9-4560-be12-49ad590f7540\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/73939d70beee459c994bcb4dcdf136d8\",\n      \"title\": \"الضرورة والتناسب\",\n      \"content\": \"أي قيود على طلب الاطلاع أو الحصول على المعلومات المحمية التي تتلقاها أو تنتجها أو تتعامل معها الهيئة يجب أن تكون مبررة بطريقة واضحة وصريحة.\",\n      \"icon\": [\n        {\n          \"key\": \"03aa7750-9598-472e-9012-48b6f7d572b6\",\n          \"mediaKey\": \"e59dc720-73f5-4c85-a769-db1c6aee7c02\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/a5090fb06ccc4846adf9721376469f74\",\n      \"title\": \"الأصل في المعلومات الإفصاح\",\n      \"content\": \"لكل فرد الحق في الاطلاع على المعلومات العامة -غير المحمية- وليس بالضرورة أن يتمتع مقدم الطلب بحيثية معينة أو باهتمام معين بهذه المعلومات ليتمكن من الحصول عليها، كما لا يتعرض لأي مساءلة قانونية متعلقة بهذا الحق.\",\n      \"icon\": [\n        {\n          \"key\": \"8afc0ca2-888e-4b06-8833-cd174ef5e87b\",\n          \"mediaKey\": \"529fb8e3-4611-4cb2-862b-77e06de1d76f\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/bd2b76cb280e42a3b712d7478862ed13\",\n      \"title\": \"المساواة\",\n      \"content\": \"يتم التعامل مع جميع طلبات الاطلاع أو الحصول على المعلومات العامة على أساس المساواة وعدم التمييز بين الأفراد.\",\n      \"icon\": [\n        {\n          \"key\": \"5f4df4e1-b1fd-4ae8-ae87-264201876a23\",\n          \"mediaKey\": \"93fe67dd-48ba-4258-80d5-80cbf43dd31e\"\n        }\n      ]\n    }\n  ],\n  \"settingsData\": []\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/d21d9c226312415db9658f4bcf7a3832\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5c3a0b4c29124261af0a583e2238696e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8a86fbd070f148e39a58dde9fd25ccec\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c2d239bb73444764b602002b9ee3347d\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/d21d9c226312415db9658f4bcf7a3832\",\n      \"title\": \"Transparency\",\n      \"content\": \"The individual has the right to know information related to the Authority’s activities to enhance the ecosystem of integrity, transparency, and accountability. \",\n      \"icon\": [\n        {\n          \"key\": \"f15bc0b5-0661-4dee-8b5f-0a3583b14e1e\",\n          \"mediaKey\": \"f7b3357f-3ca9-4560-be12-49ad590f7540\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/5c3a0b4c29124261af0a583e2238696e\",\n      \"title\": \"Necessity and Proportionality\",\n      \"content\": \"Any restrictions on obtaining or requesting access to protected information received, produced, or handled by the Authority shall be justified clearly and explicitly. \",\n      \"icon\": [\n        {\n          \"key\": \"54e2d8ad-bc21-4af5-803c-6a4ce188c0b1\",\n          \"mediaKey\": \"e59dc720-73f5-4c85-a769-db1c6aee7c02\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/8a86fbd070f148e39a58dde9fd25ccec\",\n      \"title\": \"Public Information should be Available\",\n      \"content\": \"Every applicant has the right to access public – unprotected – information. The applicant does not need to have a particular reason or interest in the information to obtain it, nor be exposed to any legal liability related to this right.\",\n      \"icon\": [\n        {\n          \"key\": \"90c62487-f2a3-4801-be4c-2d560768c3ac\",\n          \"mediaKey\": \"529fb8e3-4611-4cb2-862b-77e06de1d76f\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/c2d239bb73444764b602002b9ee3347d\",\n      \"title\": \"Equality\",\n      \"content\": \"All requests made by individuals to access or receive public information shall be dealt with on an equal and non-discriminatory basis. \",\n      \"icon\": [\n        {\n          \"key\": \"8b209db6-dca0-475c-9ff2-89d2e8527c1e\",\n          \"mediaKey\": \"93fe67dd-48ba-4258-80d5-80cbf43dd31e\"\n        }\n      ]\n    }\n  ],\n  \"settingsData\": []\n}"}]},"keyPrinciplesTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المبادئ الرئيسية لحرية المعلومات"},{"@Culture":"en-us","#cdata-section":"Principle Rights of Freedom of Information: "}]},"keywords":{"Value":{"#cdata-section":"[\n  \"البيانات المفتوحة\",\n  \"البيانات\",\n  \"open\",\n  \"data\",\n  \"open data\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]"}},"openDataContent":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"openDataTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الخطوات الرئيسة للوصول الى المعلومات أو الحصول عليها"},{"@Culture":"en-us","#cdata-section":"The Main Steps to Access or Obtaining Information: "}]},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عن البيانات المفتوحة"},{"@Culture":"en-us","#cdata-section":"About Open Data"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"البيانات المفتوحة"},{"@Culture":"en-us","#cdata-section":"About Open Data"}]},"policyContent":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تنطبق هذه السياسة على جميع طلبات الأفراد للاطلاع أو الوصول الى المعلومات العامة – غير المحمية والتي تنتجها الهيئة العامة للعقار مهما كان مصدرها، أو شكلها أو طبيعتها.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>This policy applies to all requests by individuals to view and access public information – not protected – produced by the Real Estate General Authority regardless of its source, format, or nature.&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"policyItems":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"328a599b-f41c-4dda-8817-17aec6ffed24\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"لا تنطبق أحكام هذه السياسة على المعلومات المحمية:\",\n    \"shortBrief\": \"{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>المعلومات التي يؤدي إفشاؤها إلى الإضرار بالأمن الوطني للدولة أو سياستها أو مصالحها أو حقوقها.</li>\\\\n<li>المعلومات العسكرية والأمنية.</li>\\\\n<li>المعلومات والوثائق التي يتم الحصول عليها بمقتضى اتفاق مع دولة أخرى وتصنف على أنها محمية.</li>\\\\n<li>التحريات والتحقيقات وأعمال الضبط وعمليات التفتيش والمراقبة المتعلقة بجريمة أو مخالفة أو تهديد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>الأبحاث العلمية أو التقنية، أو الحقوق المشتملة على حق من حقوق الملكية الفكرية التي يؤدي الكشف عنها إلى المساس بحق معنوي.</li>\\\\n<li>المعلومات المتعلقة بالمنافسات والعطاءات والمزايدات التي يؤدي الإفصاح عنها إلى الإخلال بعدالة المنافسة.</li>\\\\n<li>المعلومات التي تكون سرية أو شخصية بموجب نظام آخر، أو تتطلب إجراءات نظامية معينة للوصول إليها أو الحصول عليها.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"8213050e-90f6-4900-b250-48eb10be64d6\\\",\\n    \\\"mediaKey\\\": \\\"a2d49abc-ef31-4423-9acb-c3065aae0986\\\"\\n  }\\n]\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"41742057-a80e-40cb-a058-939d170f8a18\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"The provisions of this policy do not apply to protected information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Information that the disclosure of harms the state’s national security, policy, interests, or rights.</li>\\\\n<li>Military and security information.</li>\\\\n<li>Information and documents obtained by an agreement with another country and classified as protected.</li>\\\\n<li>Information that includes investigations, inspections, and surveillance related to a crime, violation, or threat.&nbsp;</li>\\\\n<li>Information that includes recommendations, suggestions, or consultations for the issuance of legislation or government decisions that have not yet been issued.&nbsp;</li>\\\\n<li>Scientific or technical research, or rights that contain an intellectual property that the disclosure of leads to an infringement of moral right.&nbsp;</li>\\\\n<li>Information related to bids and auctions that the disclosure of would lead to biased competition.</li>\\\\n<li>Information that is confidential or personal under another system requires specific legal procedures to access or obtain it.&nbsp;</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"050e9500-9338-4066-8949-2993ed4733f7\\\",\\n    \\\"mediaKey\\\": \\\"a2d49abc-ef31-4423-9acb-c3065aae0986\\\"\\n  }\\n]\"\n  }\n]"}]},"policyTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"سياسة حرية المعلومات"},{"@Culture":"en-us","#cdata-section":"Freedom of Information Policy "}]},"requestOpenDataSteps":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/23b1d5d83f4444abb20b0cd87e97bf30\"\n      },\n      {\n        \"contentUdi\": \"umb://element/898d075ae29a415abc2f2c4011ffa838\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1c6a6268c0ae4bb29a3cb343cdc0c777\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9e0b42130dd144da831595e5b4a50fdd\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/23b1d5d83f4444abb20b0cd87e97bf30\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>يتم تقديم الطلبات عن طريق ملء نموذج إلكتروني وتقديمه للهيئة&nbsp;<a href=\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\" title=\\\"طلب بيانات مفتوحة\\\">بالضغط هنا</a>.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/898d075ae29a415abc2f2c4011ffa838\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"تقوم الهيئة، باستلام طلب الاطلاع أو الحصول على المعلومات العامة واتخاذ أحد القرارات التالية:\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/1c6a6268c0ae4bb29a3cb343cdc0c777\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"isTree\": \"1\",\n      \"treeElements\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/94798691125849809e399293c9db07e6\"\n            },\n            {\n              \"contentUdi\": \"umb://element/8a66f1ceb8c24fb58792a21765a417f8\"\n            },\n            {\n              \"contentUdi\": \"umb://element/2210004827414642841f89ad476774fa\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/94798691125849809e399293c9db07e6\",\n            \"title\": \"الموافقة\",\n            \"content\": {\n              \"markup\": \"في حال تمت موافقة الهيئة على طلب الوصول إلى المعلومات أو الحصول عليها\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/8a66f1ceb8c24fb58792a21765a417f8\",\n            \"title\": \"الرفض\",\n            \"content\": {\n              \"markup\": \"<p>في حال تم رفض طلب الوصول إلى المعلومات أو الحصول عليها، فيجب أن يكون الرفض خطياً أو إلكترونياً على أن يتضمن المعلومات التالية:</p>\\n<ul>\\n<li>تحديد ما إذا كان رفض الطلب كلياً أو جزئياً.</li>\\n<li>أسباب الرفض، إن أمكن.</li>\\n</ul>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/2210004827414642841f89ad476774fa\",\n            \"title\": \"الإشعار\",\n            \"content\": {\n              \"markup\": \"<p>في حال كانت المعلومات المطلوبة متاحه على موقع الهيئة، أو ليست من اختصاصها فيجب إشعار الفرد بذلك خطياً أو إلكترونياً.</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/9e0b42130dd144da831595e5b4a50fdd\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>في حالة رغبة الفرد في التظلّم على رفض الطلب من قبل الهيئة، فيمكنه تقديم إشعار خطي أو إلكتروني بالتظلم إلى مكتب إدارة البيانات في الهيئة خلال فترة زمنية لا تتجاوز (5) أيام عمل من استلامه لقرار الهيئة، ويقوم مكتب إدارة البيانات في الهيئة بمراجعة الطلب واتخاذ القرار المناسب.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/4f7fd3bccd064f4f9e3e66e1c2f56c0f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0d082f2390324bb192282befd7ec25e2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e30ee22884af45819223c8a278d2fd2c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/46aa104b536142848d6b8fa70cf80841\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/4f7fd3bccd064f4f9e3e66e1c2f56c0f\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>Applications must be submitted by filling out an electronic form and submitting it to the Authority by <strong><a href=\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\" title=\\\"Open Data Request\\\">clicking here</a></strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/0d082f2390324bb192282befd7ec25e2\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>The Authority receives the request to access or obtain public information and makes one of the following decisions:</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/e30ee22884af45819223c8a278d2fd2c\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"isTree\": \"1\",\n      \"treeElements\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/2a2aeb6220dc4db7ae4c88ffb0052477\"\n            },\n            {\n              \"contentUdi\": \"umb://element/7de86f07733742fdbc0a8b7d796de463\"\n            },\n            {\n              \"contentUdi\": \"umb://element/1a1839cf0d9c471a94a3ec0c76e2b7d8\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/2a2aeb6220dc4db7ae4c88ffb0052477\",\n            \"title\": \"Approval\",\n            \"content\": {\n              \"markup\": \"<p>If the Authority approves the request to access or obtain public information</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/7de86f07733742fdbc0a8b7d796de463\",\n            \"title\": \"Rejection\",\n            \"content\": {\n              \"markup\": \"<p>If the Authority rejects the request to access or obtain public information, the rejection must be in writing or electronically and include the following information:&nbsp;</p>\\n<ul>\\n<li>Determine whether the application was rejected partially or fully.</li>\\n<li>If possible, state the reasons for the rejection.&nbsp;</li>\\n</ul>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/1a1839cf0d9c471a94a3ec0c76e2b7d8\",\n            \"title\": \"Notification\",\n            \"content\": {\n              \"markup\": \"<p>If the required information is available on the Authority’s website or is not under its jurisdiction, the individual must be notified in writing or electronically</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/46aa104b536142848d6b8fa70cf80841\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>In case the individual wishes to appeal the Authority’s rejection of the application, the appeal can be submitted, in writing or electronically, to the Data Management Office at the Authority within 5 business days of receiving the Authority’s decision. The Data Management Office at the Authority will review the request and make the appropriate decision</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عن البيانات المفتوحة"},{"@Culture":"en-us","#cdata-section":"About Open Data"}]}}}},"IsRoot":true},{"Key":"07e3766a-9374-3287-abae-9d809eb1b3e0","Alias":"حقيبة الممارس التوعوية","Path":"/a9e57c14-8764-46e0-8a44-4097c1f3e37f.config","Level":3002,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a9e57c14-8764-46e0-8a44-4097c1f3e37f.config","Node":{"Content":{"@Key":"a9e57c14-8764-46e0-8a44-4097c1f3e37f","@Alias":"حقيبة الممارس التوعوية","@Level":"3","Info":{"Parent":{"@Key":"20152095-8ca8-4f4a-b577-3a3a2c5d0083","#text":"media-center"},"Path":"//mediaCenter/","Trashed":"false","ContentType":"news","CreateDate":"2024-12-02T14:44:35","NodeName":{"@Default":"حقيبة الممارس التوعوية","Name":{"@Culture":"ar-jo","#text":"حقيبة الممارس التوعوية"}},"SortOrder":"2","Published":{"@Default":"true","Published":{"@Culture":"ar-jo","#text":"true"}},"Schedule":null,"Template":{"@Key":"5f8459fd-a6f5-4f65-8cc6-92c58c5d020c","#text":"News"}},"Properties":{"description":{"Value":{"@Culture":"ar-jo","#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"@Culture":"ar-jo","#cdata-section":""}},"pageTitle":{"Value":{"@Culture":"ar-jo","#cdata-section":"حقيبة الممارس التوعوية"}},"shortBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"@Culture":"ar-jo","#cdata-section":""}}}}},"IsRoot":true},{"Key":"424d77a1-e2b5-3fe0-93bd-61e861bc02ca","Alias":"الأسئلة الشائعة","Path":"/b9cde657-cb4e-453c-99d1-8052b1dfa53c.config","Level":3002,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b9cde657-cb4e-453c-99d1-8052b1dfa53c.config","Node":{"Content":{"@Key":"b9cde657-cb4e-453c-99d1-8052b1dfa53c","@Alias":"الأسئلة الشائعة","@Level":"3","Info":{"Parent":{"@Key":"256de293-04b8-413b-a7de-afdafaf300c4","#text":"المكتبة"},"Path":"///","Trashed":"false","ContentType":"fAQs","CreateDate":"2023-08-14T10:34:05","NodeName":{"@Default":"الأسئلة الشائعة","Name":[{"@Culture":"ar-jo","#text":"الأسئلة الشائعة"},{"@Culture":"en-us","#text":"Frequently Asked Questions"}]},"SortOrder":"2","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"d9016747-9e7e-4329-9548-6b8074039e8f","#text":"FAQs"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأسئلة الشائعة"},{"@Culture":"en-us","#cdata-section":"Frequently Asked Questions"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"الاسئلة\",\n  \"الشائعة\",\n  \"الاسئلة الشائعة\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأسئلة الشائعة"},{"@Culture":"en-us","#cdata-section":"Frequently Asked Questions"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأسئلة الشائعة"},{"@Culture":"en-us","#cdata-section":"Frequently Asked Questions "}]},"questions":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"3545da36-7acd-4e01-84d2-975fad1be94a\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهي الهيئة العامة للعقار؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>تعتبر الهيئة العامة للعقار الجهة المُشرعة للقطاع العقاري والمُشرفة عليه ، والمسؤولة عن &nbsp;تنظيم النشاط العقاري غير الحكومي &nbsp;وتطويره ، وتشجيع الاستثمار إضافة إلى مسؤوليتها عن التسجيل العيني للعقارات في المملكة .&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"2087bd36-ce92-4be4-9acf-ec49e80e208d\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما دور الهيئة في القطاع العقاري؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>تعتبر الهيئة العامة للعقار هي الجهة المُشرعة للقطاع العقاري والمُشرفة عليه ، والمسؤولة عن &nbsp;تنظيم النشاط العقاري غير الحكومي &nbsp;وتطويره ، وتشجيع الاستثمار إضافة إلى مسؤوليتها عن التسجيل العيني للعقارات في المملكة .&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"b16926a9-a2b5-4990-8b40-d432cc5d1566\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما المقصود بنظام التسجيل العيني للعقار؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>نظام صادر بمرسوم ملكي رقم (م/91) وتاريخ 1443/9/19هـ، تشرف عليه الهيئة العامة للعقار، يجعل النظام العقار محورًا أساسيًا في عملية تسجيل الملكيات والتصرفات العقارية الأخرى المترتبة عليه، يتم بالتعاون مع ملاك العقارات بالمملكة أو من ينوب عنهم عبر المنصة الإلكترونية للسجل العقاري، ويهدف لبناء سجل متكامل للقطاع العقاري كأول خطوة تحولية تهدف لتحسين المشهد العقاري بالمملكة.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/92ba0fb329d549c2b99e522a10db9d05}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a> .</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"b49fdd4a-c340-44e1-98fd-77506ae951ad\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما المقصود بنظام الوساطة العقارية و ماهي الخدمات العقارية الخاضعة للنظام ؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>نظام صادر بمرسوم مرسوم ملكي رقم (م/130) وتاريخ 1443/11/30هـ وتشرف عليه الهيئة العامة للعقار، ويهدف إلى تنظيم الوساطة العقارية والخدمات العقارية، وتسعى الهيئة من خلال النظام إلى تحسين السوق العقاري، وحماية المستفيدين، وضمان نزاهة الممارسين، مع تعزيز الثقة في السوق وتحفيز النشاط العقاري. ويشمل الوساطة العقارية نشاط الوساطة والتسويق والإعلانات العقارية، وتتضمن الخدمات الخاضعة للنظام الاستشارات والتحليلات العقارية والأنشطة المتعلقة بالعقار من إدارته وبيعه وبيع منفعته وتأجيره، ومن ذلك: إدارة الأملاك، وإدارة المرافق، والمزادات العقارية.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/92ba0fb329d549c2b99e522a10db9d05}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a> .</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"9a296cad-55b3-4335-9ee1-adaa860a3982\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهي الأنشطة العقارية المتاحة للأفراد؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>وفق نظام الوساطة العقارية يتاح للأفراد ممارسة الأنشطة والخدمات التالية:<br>-الوساطة العقارية.<br>-التسويق العقاري.<br>الإعلان العقاري.<br>الاستشارات والتحليلات العقارية.<br>ويُشترط للترخيص لممارسة الوساطة العقارية أو الخدمات العقارية للأشخاص الطبيعيين (الأفراد) توافر الشروط التالية: <br>1-    بلوغ سن الـ (18) عامًا. <br>2-    أن يكون طالب الترخيص كامل الأهلية، غير محكومٍ عليه في جريمة مُخِلَّة بالشرف أو الأمانة ما لم يكن قد رُد إليه اعتباره.<br>3-    اجتياز البرنامج التأهيلي لكل نشاط.<br>4-    استيفاء المقابل المالي للترخيص باستثناء ترخيص ممارسة التسويق والإعلانات العقارية.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"الوساطة العقارية\\\\\\\">منصة الوساطة</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"af6fccbe-d0a4-48f5-b973-901809b6c4d1\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما هي رخصة فال للوساطة العقارية؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>رخصة فال وثيقة رسمية  تخوّل الأفراد والمنشآت ممارسة النشاط العقاري المحدّد في الرخصة؛ حيث تخوّل رخصة فال للوساطة والتسويق العقاري الأفراد والمنشآت ممارسة أنشطة التوسّط في إتمام صفقة عقارية بين طرفيها مقابل عمولة،  والتسويق للعقار سواء عن طريق الوسائل الإعلانية أو التسويق المباشر في المكاتب والمعارض وغيرها ، أما رخصة فال لإدارة الأملاك فهي رخصة خاصة بالمُنشآت تخوّل المنشأة تولّي إدارة الشؤون المالية والإدارية للعقار نيابةً عن الغير ، وكذلك رخصة فال لإدارة المرافق فهي  رخصة خاصة بالمُنشآت تخوّل المنشأة تولي إدارة الشؤون الفنية للعقار نيابةً عن الغير ، إضافة إلى أنَّ رخصة فال لإدارة وتنظيم المزادات  تختص بالمُنشآت ، وهي رخصة تخوّل المنشأة تولّي مهام عرض العقارات لبيعها بالمزادات العلنية ، ويشمل المزادات العقارية الإلكترونية ، أما رخصة فال للاستشارات والتحليل العقاري فهي رخصة تخوّل المُنشآت والأفراد من تقديم التحليلات والاستشارات العقارية والرأي المتصل بالقطاع العقاري للعموم عبر أي وسيلة إعلامية أو لجهة مستفيدة من الخدمة. وترخيص فال للإعلان العقاري هو ترخيص لنشر الإعلانات المرئية والمسموعة والمقروءة والإلكترونية لغرض التصرف في العقار، سواء عن طريق التلفزيون أو الإذاعة أو الطرق أو الصحف المطبوعة أو في المنصات الإلكترونية أو في وسائل التواصل الاجتماعي وغيرها من الوسائل.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"الوساطة العقارية\\\\\\\">منصة الوساطة</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"fb4abf48-a5ea-4403-82d0-d8052ee1e0e2\",\n    \"name\": \"Item 7\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما المقصود بنظام المساهمات العقارية؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>نظام صادر بمرسوم ملكي رقم (م/203) وتاريخ 1444/12/28هـ تشرف عليه الهيئة العامة للعقار، يهدف النظام إلى تعزيز ثقة المستثمرين في القطاع العقاري في المملكة من خلال ما تضمنَه من قواعد وأحكام تحفظ الحقوق لكافة الأطراف وسيقضي على ممارسة المساهمات العقارية العشوائية وغير النظامية، وحوكمة أعمال الرقابة والامتثال. كما أنَّ النظام سيتيح خلق فرص استثمارية واعدة للمُنشآت الصغيرة أو المتوسطة في السوق العقاري، ويوفر وعاء استثماري عقاري جديد وموثوق.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/0dc279a2be544b2795534e0e9c483617}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"c97e5331-54af-4ea7-a5a2-83cfc93e390e\",\n    \"name\": \"Item 8\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما المقصود بنظام ملكية الوحدات العقارية وإدارتها وفرزها؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>نظام صادر بمرسوم ملكي رقم (440) بتاريخ 1441\\\\\\\\7\\\\\\\\1هـ ، وتشرف عليه الهيئة العامة للعقار، يعمل النظام على تنظيم علاقة الملاك فيما بينهم في إدارة شؤون العقار المشترك.و يهدف النظام إلى تحسين أداء القطاع العقاري وتنظيمه وحوكمة العلاقة بين جميع أطراف العلاقة في المجمعات السكنية والتجارية ذات الملكية المشتركة.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/92ba0fb329d549c2b99e522a10db9d05}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"134d1031-3053-415a-a850-7a636fe1a056\",\n    \"name\": \"Item 9\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهو المعهد العقاري السعودي، و ماذا يقدم؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>المعهد العقاري السعودي أول كيان تعليمي متخصص في مجال العلوم العقارية في المملكة،  يقدم خدمات متخصصة لتدريب العاملين في القطاع العقاري ،  ويمنح الشهادات المُمكّنة من دخول سوق العمل بكفاءة عالية و الحصول على تراخيص الأنشطة العقارية.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/e3b45b857b944ef48f448e49631c0413}\\\\\\\" title=\\\\\\\"المعهد العقاري السعودي\\\\\\\">منصة المعهد العقاري</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"7afb28ec-77de-4a17-8220-0f7f9d91f6b0\",\n    \"name\": \"Item 10\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهو المركز السعودي للتحكيم العقاري، و ماذا يقدم ؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>أول مركز من نوعه في المملكة ودول الخليج يختص بتسوية او فض النزاعات العقارية، يقدم المركز خدمات التحكيم، والتوفيق، والصلح، وإيجاد الحلول السريعة للنزاعات والخلافات العقارية للمساهمة في تخفيف العبء عن المحاكم القضائية، ويُعد مرجع قانوني وجهة تحكيمية موثوقة للقطاع العقاري، و ينظر المركز في الفترة الحالية إلى القضايا الناشئة عن برنامجي ايجار واتحاد الملاك، تقدم جميع الخدمات بشكل إلكتروني.&nbsp;<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/2328a56286c94f49b7f6da063cb17a73}\\\\\\\" title=\\\\\\\"المركز السعودي للتحكيم العقاري\\\\\\\">منصة مركز التحكيم</a>.&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"5ad3e569-f458-413e-a764-4fed1c5ca1fd\",\n    \"name\": \"Item 11\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهو برنامج إيجار، و ماذا يقدم ؟ \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>يقدم البرنامج مجموعة من الحلول الإلكترونية التي تسهم في تطوير قطاع الإيجار العقاري وتنظيمه وتيسير أعماله، بما يحقق التوازن في القطاع وتعزيز الثقة به، ويسهم في تحفيز الاستثمار فيه.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"إيجار\\\\\\\">منصة برنامج إيجار</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"62d54453-1a2f-4efd-a3cc-53deac8a72bb\",\n    \"name\": \"Item 12\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"هل الالتزام ببنود عقد الإيجار  الموحد إلزامي أم اختياري؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>يحتوي العقد بنوداً إلزامية يتوجب الأخذ بها ، أما العمل بالعقد الموحد من قبل الوسطاء ، فهو إلزامي بناء على قرار مجلس الوزراء رقم 405 ، وتاريخ 22-9-1437.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"إيجار\\\\\\\">منصة برنامج إيجار</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"6baf8bcc-9d43-44c1-ba79-6cb2a4538d53\",\n    \"name\": \"Item 13\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما المقصود ببرنامج مُلاَّك ؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"pb-2\\\\\\\"><span><u> مُلاَّك</u> برنامج يُمكّن مُلّاك وشاغلي الوحدات العقارية ذات الملكية المشتركة من تأسيس جمعية مُلّاك؛ لتنظيم خدمات إدارة الممتلكات والمرافق، عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يسهم في حفظ الحقوق وحسن الانتفاع، ويعزز ثقافة التعايش المشترك.</span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"pb-2\\\\\\\"><span> للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة<a href=\\\\\\\"/{localLink:umb://document/d4441d6cab89476688eda77dc61d190b}\\\\\\\" title=\\\\\\\"مُلاَّك\\\\\\\"> منصة مُلاَّك</a> </span><span> .</span></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"937aedb6-e347-4967-aa00-9ba1fa1b1110\",\n    \"name\": \"Item 14\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهو برنامج فرز الوحدات العقارية، و ماذا يقدم؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>برنامج \\\\\\\"فرز الوحدات\\\\\\\" يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديدحقوق وواجبات كل وحدة في المجمعات العقارية لتعزيز العلاقات بين مُلاك الوحدات وتسهيل الإجراءات والخدمات اللازمة، والمحافظة على الأصول العقارية واستدامة القطاع، وتعزيز بيئة سكنية آمنة. <br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/7591a71f51f749cca16b496b8ea0e73e}\\\\\\\" title=\\\\\\\"فرز الوحدات العقارية\\\\\\\">منصة فرز</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"fe04affb-aee2-4dbf-9127-5434e3d172cb\",\n    \"name\": \"Item 15\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهو برنامج البيع أو التأجير على الخارطة \\\"وافي\\\"؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"وافي\\\\\\\" الجهة المخولة نظاماً بإصدار تراخيص مزاولة نشاط بيع الوحدات العقارية على الخارطة في المملكة العربية السعودية، وإصدار شهادات القيد في سجل المطورين العقاريين لشركات التطوير العقاري، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/6218a02f98954aeda87b65580ff81940}\\\\\\\" title=\\\\\\\"البيع أو التأجير على الخارطة &quot;وافي&quot;\\\\\\\">منصة وافي</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"83bedfb5-13c6-46d0-9324-b1b994fb9074\",\n    \"name\": \"Item 16\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ما المقصود بلجنة معالجة أخطاء تسجيل الملكية ؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>مُلكية\\\\\\\"\\\\\\\" لجنة مستقلة عن الجهات الحكومية تعمل بحيادية لمعالجة تعثرات المستفيدين من تسجيل الملكية العقارية لدى الجهات الحكومية. وتقوم اللجنة بأعمالها لدعم القطاع العقاري، ورفع تصنيف المملكة التنافسي في مؤشر تسجيل الملكية، وتستقبل اللجنة الاعتراضات المتعلقة بالملكية العقارية تجاه الجهات الحكومية والتي لم تقم الجهة الحكومية بعمل اللازم تجاهها بعد التقدم بطلب المعالجة، فيمكنك حينئذ تسجيل طلب اعتراض تبين فيه تفاصيل اعتراضك.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/263a8388873844afb16e71f091cf7f25}\\\\\\\" title=\\\\\\\"لجنة معالجة أخطاء تسجيل الملكية\\\\\\\">منصة ملكية</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"6ae2e973-dd83-407c-810d-c54c091d5eca\",\n    \"name\": \"Item 17\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهي بوابة العقار الجيومكانية؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>بوابة العقار الجيومكانية\\\\\\\" هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الإهتمام (التعليمية، الدينية، الصحية، مرافق الضيافة) ومشاريع البيع على الخارطة (وافي) ومكاتب الوساطة والمكاتب الهندسية المعتمدة في فرز الوحدات العقارية والمناطق العقارية المعلنة للتسجيل العيني للعقار، بالإضافة إلى خدمة البحث والإستعلام عن البيانات المكانية.<br>للمزيد من المعلومات يرجى زيارة<a href=\\\\\\\"/{localLink:umb://document/e034c088303641679f55950534fa4164}\\\\\\\" title=\\\\\\\"بوابة العقار الجيومكانية\\\\\\\"> بوابة العقار الجيومكانية</a>.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"4c4b02bc-dd75-452b-8bdf-c0451a54e6a2\",\n    \"name\": \"Item 18\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"ماهي منصة المؤشرات العقارية؟\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">صفحة رقمية مخصصة لعرض أرقام ونسب متعلقة بالسوق العقاري السعودي، تتيح للمستخدم تصور شامل للتوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة العربية السعودية، وتُساعد المهتمين على تحليل السوق واتخاذ قرارات أفضل، تسعى الهيئة العامة للعقار من خلال ذلك إلى تعزيز شفافية القطاع وتوفير معلومات دقيقة وفعّالة للمهتمين بالقطاع العقاري.<br>تتضمن المنصة: مؤشرات عقارية رقمية – خرائط تفاعلية<br>المؤشرات العقارية الرقمية: تحوي بيانات حول المبيعات والإيجارات للعقارات على مستوى المملكة والمناطق، والمدن، وعلى مستوى الأحياء (للمدن الرئيسية). تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة العربية السعودية، مع توفير بيانات محدثة حول المبيعات والإيجارات للعقارات، مع إمكانية مقارنة بين فترات زمنية مختلفة وبين مدن مختلفة؛ لاستخلاص تحليلًا متعمقًا حسب الفترة الزمنية المحددة وتشمل أنواعًا متنوعة من العقارات، مما يمكّن المهتمين من اتخاذ قرارات أفضل وأكثر توجيهًا من خلال توفير معلومات دقيقة وفعّالة للمستخدمين، تسهم في تعزيز شفافية السوق العقاري.<br>الخرائط التفاعلية: تقدم مؤشرات و بيانات إحصائية حول السوق العقاري في المملكة العربية السعودية. وتقدم للمستخدم تصور شامل عن التوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة، بالإضافة إلى توفر بيانات محدثة حول العمليات العقارية ( المؤشر البيعي –المؤشر الإيجاري) للعقارات. كما تتيح الصفحة إمكانية تحليل البيانات حسب فترات زمنية لكافة أنواع العقارات ، مما يوفر تصور شامل للسوق ويمكّن المهتمين والمستثمرين من اتخاذ قرارات أفضل.&nbsp;<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"https://rei.rega.gov.sa/\\\\\\\">منصة المؤشرات العقارية</a></p>\\\\n<p style=\\\\\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"5b62192c-6a60-4c6e-adf9-485dc4bae058\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Real Estate General Authority? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate General Authority (REGA) stands as the legislator and supervisor of the real estate sector; responsible for monitoring, regulating, and developing non-governmental real estate activities, and encouraging real estate investments, in addition to supervising real estate registrations in the Kingdom. &nbsp;&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"1912a10c-ee34-438d-888e-ab4b7122a4f0\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Authority’s role in the real estate sector?  \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate General Authority (REGA) stands as the legislator and supervisor of the real estate sector. They have the important responsibility of monitoring, regulating, and promoting non-governmental real estate activities. Additionally, they play a crucial role in encouraging real estate investments and ensuring proper supervision of real estate registrations in the Kingdom.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"119ddf43-faf4-45e3-814c-48d7f56c1dd1\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Real Estate Registry Act? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate Registry Act is an Act that has been issued by Royal Decree No. (M/91) dated 9/19/1443 AH and supervised by the Real Estate General Authority (REGA). The Act places real estate as the pivotal focus in property registration processes and transactions; in collaboration with the real estate owners or with those acting on their behalf in the Kingdom, and conducted through the Authority’s electronic platform. As a first step into improving and developing the real estate sector’s stance in the Kingdom, the Act aims to build a comprehensive real estate registry. For more information, please visit the “Rules, Regulations, and Guidelines” page. &nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"361b8567-a69a-4f70-8c91-b44d299afd22\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Real Estate Brokerage Act and what are the Act’s real estate services?    \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate Brokerage Act is an Act that has been issued by Royal Decree No. (M/130) dated 11/30/1443 AH and supervised by the Real Estate General Authority; aiming to manage real estate brokerage and services. Through the Act, the Authority strives to improve the real estate market, protect beneficiaries’ rights, and ensure the sector’s parties’ integrity, in parallel to fostering trust in the market, and nurturing real estate activities. Real estate brokerage covers various services, that include brokerage, marketing, and real estate advertising, in addition to real estate consultations and analyses, and conducting certain activities like managing, selling, and leasing real estate, managing properties and facilities, and auctioning real estate. For more information, please visit the “Rules, Regulations, and Guidelines” page.&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"cd0444e5-4054-44f8-b1a3-6f2f47afe2e3\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What real estate activities are available to individuals?    \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>Following the Real Estate Brokerage Act, individuals are allowed to exercise the following activities and receive the following services: <br>- Real Estate Brokerage<br>- Real Estate Marketing<br>- Real Estate Advertising<br>- Real Estate Consultations and Analyses<br>To receive a license to practice real estate brokerage, the individual should meet the following conditions: <br>1-    18+ years old<br>2-    The applicant must be qualified with no previous records of criminal charges or violations of misconduct; unless otherwise stated. <br>3-    Pass the Qualification Program for every activity. <br>4-    Pay the license fees, except for the license to practice real estate marketing and advertising activities. For more information, please visit the “<a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"FAL – Real Estate Brokerage\\\\\\\">Real Estate Brokerage</a>” page. <br><br></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"186c2f68-71d8-40df-bf7a-a05299c2a99c\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the FAL – Real Estate Brokerage License? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The FAL license is an official permit that allows individuals and establishments to conduct real estate activities limited to the capacity of the license. The FAL license for Real Estate Brokerage and Marketing permits individuals and establishments to engage in activities to complete real estate deals between two parties in exchange for a commission and to market the real estate whether through advertising means or direct marketing in offices, exhibitions, and other methods. As for the FAL license to manage properties, it is allocated for establishments; permitting them to manage administrative and financial matters of properties on behalf of others. The FAL license to manage facilities is another license also allocated to establishments; permitting them to manage all the facilities’ technical matters on behalf of others. Additionally, the FAL license for real estate auctioning permits establishments to manage and organize real estate auctions, in addition to selling real estate properties at auctions; including on electronic real estate auctions. As for the FAL license for real estate consultations and analyses, it permits establishments and individuals to provide real estate consultations and analyses and share opinions about the real estate sector to the public through any advertisement channels or to the beneficiaries of the service. The FAL license for real estate advertising permits the license holder to publish visual, audio, print, and electronic real estate advertisements through various media channels, whether on TV, radio, billboards, street signs, printed newspapers, digital platforms, or on social media and other means. For more information, please visit the “<a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"FAL – Real Estate Brokerage\\\\\\\">FAL – Real Estate Brokerage</a>” page. </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"e79fbf4f-c100-4d35-8ccd-bcfb95055243\",\n    \"name\": \"Item 7\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Real Estate Contributions Act? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate Contributions Act is an Act that has been issued by Royal Decree No. (M/230) dated 28/12/1444 AH and supervised by the Real Estate General Authority. The Act aims to enhance investors’ confidence and trust in the Kingdom’s real estate sector by implementing regulations and terms that preserve the rights of all parties and eliminating random and unsystematic real estate contributions. Additionally, the Act is working to create attractive investment opportunities for small or medium-sized enterprises in the real estate market and provide a new and reliable real estate investment structure. For more information, please visit the “<a href=\\\\\\\"/{localLink:umb://document/0dc279a2be544b2795534e0e9c483617}\\\\\\\" title=\\\\\\\"Regulations, Frameworks &amp; Polices\\\\\\\">Rules, Regulations, and Guidelines</a>” page. </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"ed04d081-90bb-4ab0-9ffc-0612932e0a3d\",\n    \"name\": \"Item 8\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Ownership, Management, and Sorting Real Estate Units Act? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Ownership, Management, and Sorting Real Estate Units Act is an Act that has been issued by Royal Decree No. (440) dated 1/7/1441 AH and supervised by the Real Estate General Authority. The Act regulates landlords’ relations in managing the affairs of joint properties. Furthermore, the Act strives to improve the real estate sector’s performance and organization, in addition to maintaining relations between real estate owners of residential and commercial complexes. For more information, please visit the “<a href=\\\\\\\"/{localLink:umb://document/0dc279a2be544b2795534e0e9c483617}\\\\\\\" title=\\\\\\\"Regulations, Frameworks &amp; Polices\\\\\\\">Rules, Regulations, and Guidelines</a>” page. </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"fef74ba7-8ee7-4462-a0a5-1ee143cc53f7\",\n    \"name\": \"Item 9\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Saudi Real Estate Institute and what does it offer? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Saudi Real Estate Institute is the first educational institution, in the Kingdom, specializing in offering courses and training programs in real estate sciences. The institute’s goal is to raise the professional and performance standards of the Saudi real estate sector by training and empowering the sector’s workforce with qualified certifications to perform the real estate sector’s work functions efficiently.&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"492f3f4e-665d-4ca3-bbdd-aac484daa228\",\n    \"name\": \"Item 10\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Saudi Real Estate Arbitration Center and what does it offer? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>As the first arbitration center in the Kingdom and across the Gulf region, the Saudi Real Estate Arbitration Center facilitates arbitration and reconciliation procedures and resolves real estate disputes to reduce the burden on the Kingdom’s judicial courts. The center stands as the legal entity and arbitral representative for the real estate sector. For more information, you can check out the <a href=\\\\\\\"/{localLink:umb://document/2328a56286c94f49b7f6da063cb17a73}\\\\\\\" title=\\\\\\\"Saudi Real Estate Arbitration Center\\\\\\\">Saudi Real Estate Arbitration Center’s platform. </a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"6dbfad17-2ede-4440-9010-14b752784460\",\n    \"name\": \"Item 11\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is “EJAR” and what does it offer? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>“EJAR” is an integrated and comprehensive electronic network that aims to organize the real estate leasing sector in the Kingdom of Saudi Arabia. It focuses on safeguarding the rights of all parties involved in leasing activities and agreements. \\\\\\\"EJAR\\\\\\\" offers electronic solutions to enhance and organize the real estate leasing sector, making it easier to achieve balance, build trust, and encourage investments. If you want more information, you can call 199002 or visit <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"EJAR\\\\\\\">EJAR's platform</a>. </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"1cd7195e-d2d8-4c64-96ba-9ad59be42227\",\n    \"name\": \"Item 12\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"Is it compulsory or optional to abide by the articles in a unified leasing contract?\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The unified leasing contract contains mandatory articles that must be adhered to. The broker must comply with the unified contract following the Cabinet Resolution number 405 dated 22/9/1437 AH. For more information, please call 199002 or visit <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"EJAR\\\\\\\">EJAR’s platform.</a>  </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"03c3ee93-bee3-4ee6-986a-a9a8bb397a37\",\n    \"name\": \"Item 13\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is “Mullak”?\",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>“Mullak” is a program that enables owners and occupants of joint real estate units to establish the Real Estate Owners Association to organize property and facility management services through (the system of ownership, sorting, and management of real estate units) as a method to contribute in preserving ownership rights and fostering a culture of coexistence. For more information, please call 199002 or visit <a href=\\\\\\\"/{localLink:umb://document/d4441d6cab89476688eda77dc61d190b}\\\\\\\" title=\\\\\\\"Mullak\\\\\\\">Mullak’s platform. </a>  </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"cca644e7-58ed-4c48-a944-8b115d5e29a5\",\n    \"name\": \"Item 14\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Sorting Real Estate Units – Subdivision program and what does it offer? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>“Subdivision” is a program that manages the mechanism of sorting real estate units technically and legally through (the system of ownership, sorting, and management of real estate units) which contributes to determining the unit areas and rights of every unit in apartment buildings and real estate compounds, in addition to determining the boundaries of common and public areas to enhance landlords’ relations and facilitate the necessary services and procedures, preserve real estate assets, and foster safe residential environments to sustain the real estate sector. For more information, please call 199002 or visit <a href=\\\\\\\"/{localLink:umb://document/7591a71f51f749cca16b496b8ea0e73e}\\\\\\\" title=\\\\\\\"Sorting Real Estate Units – Subdivision\\\\\\\">Subdivision’s platform.</a>   </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"eb5612bb-3bd6-49f1-80b3-629d45c1b4b6\",\n    \"name\": \"Item 15\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is Wafi – Off-Plan Sales & Lease? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"Wafi\\\\\\\" is the official organization in Saudi Arabia that grants licenses for selling off-plan real estate units. They also issue registration certificates for real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system. If you want more details, you can call 199002 or visit&nbsp;<a href=\\\\\\\"/{localLink:umb://document/6218a02f98954aeda87b65580ff81940}\\\\\\\" title=\\\\\\\"Wafi – Off-Plan Sales &amp; Lease\\\\\\\">Wafi's platform.</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"feb5f7a2-8d00-48ee-8f60-f596d2f07e3a\",\n    \"name\": \"Item 16\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Committee for Addressing Property Registration Errors (Mulkia)? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>“Mulkia” is the Committee for Addressing Property Registration Errors and works independently from governmental parties to objectively resolve beneficiaries’ dispersions in registering their real estate properties with government agencies. The committee conducts these activities to support the real estate sector and boost the Kingdom’s competitive ranking in the Property Registration Index. For more information, please call 199002 or visit <a href=\\\\\\\"/{localLink:umb://document/263a8388873844afb16e71f091cf7f25}\\\\\\\" title=\\\\\\\"Mulkia\\\\\\\">Mulkia’s platform. </a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"3beb472a-701b-4205-99d8-45faa06ee68c\",\n    \"name\": \"Item 17\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Geospatial Real Estate Portal? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Geospatial Real Estate Portal is an electronic portal used to display spatial and descriptive data considered vital to the real estate sector. Displayed through interactive maps, the data provides detailed information about regions, cities, neighborhoods, plots of land, and points of interest (this includes: educational, religious, medical, and hospitality establishments). Wafi – Off-Plan Sales projects, brokerage offices, in addition to engineering offices certified to sort real estate units, and real estate areas announced to register in the Real Estate Registry, are among the establishments displayed on the portal. Additionally, users can search for and inquire about spatial data through this portal. For more information, please call 199002 or visit the <a href=\\\\\\\"/{localLink:umb://document/e034c088303641679f55950534fa4164}\\\\\\\" title=\\\\\\\"Geospatial Real Estate Portal\\\\\\\">Geospatial Real Estate Portal. </a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"e4aff199-e0c2-40da-80db-07e03f92ade0\",\n    \"name\": \"Item 18\",\n    \"ncContentTypeAlias\": \"fAQ\",\n    \"PropType\": null,\n    \"question\": \"What is the Real Estate Indicators platform? \",\n    \"answer\": \"{\\n  \\\"markup\\\": \\\"<p>The Digital Real Estate Indicators page provides data on sales and leases on various levels, which cover the Kingdom, its cities, and neighborhoods (for major cities). The platform also provides users with a comprehensive visualization of the geographical distribution of real estate across the Kingdom, in addition to sharing up-to-date information on real estate sales and leases. Through this page, the user can make comparisons between different periods and cities to extract an in-depth analysis, based on the stated specified period, that covers different types of real estate. This service enables interested users to make sound decisions based on detailed, accurate, and credible information, which results in fostering transparency in the real estate market.</p>\\\\n<p>The platform includes Digital Real Estate Indicators and Interactive Maps.</p>\\\\n<p>Digital Real Estate Indicators: The data covers information on real estate sales and leases in the Kingdom, and its regions, cities, and neighborhoods (of major cities). It provides users with a comprehensive visualization of the geographical distribution of real estate and neighborhoods across the Kingdom of Saudi Arabia. It also provides up-to-date information on real estate sales and leases. Users can conduct comparisons between different time zones, cities, and real estate types to receive an in-depth and accurate analysis of that specific period. Through such detailed data, interested users can reach sound decisions; adding to the transparency and confidence in the real estate sector.&nbsp;</p>\\\\n<p>Interactive Maps: Indicators and statistical data of the Kingdom’s real estate market are provided, in addition to a comprehensive visualization of the geographical distribution of real estate and neighborhoods across the Kingdom of Saudi Arabia. Up-to-date data of real estate indicators (real estate sale and lease indicators) are provided, in addition to conducting comparisons between all real estate types; providing a comprehensive outlook of the real estate market and enabling interested users and investors to reach sound decisions. &nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأسئلة الشائعة"},{"@Culture":"en-us","#cdata-section":"Frequently Asked Questions"}]}}}},"IsRoot":true},{"Key":"99e33c12-2986-3f95-8402-55f31b5985ba","Alias":"المؤشرات العقارية","Path":"/440be0a5-06d1-45bf-b017-3a61d897131b.config","Level":3002,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/440be0a5-06d1-45bf-b017-3a61d897131b.config","Node":{"Content":{"@Key":"440be0a5-06d1-45bf-b017-3a61d897131b","@Alias":"المؤشرات العقارية","@Level":"3","Info":{"Parent":{"@Key":"75795868-cfb0-4021-a108-d26b070a39a4","#text":"الخدمات الإلكترونية"},"Path":"///","Trashed":"false","ContentType":"service","CreateDate":"2023-11-14T10:15:36","NodeName":{"@Default":"المؤشرات العقارية","Name":[{"@Culture":"ar-jo","#text":"المؤشرات العقارية"},{"@Culture":"en-us","#text":"Real Estate Indicators"}]},"SortOrder":"2","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go to Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"تقدم صفحة المؤشرات العقارية الرقمية بيانات حول المبيعات والإيجارات على مستوى المملكة، والمدن، وعلى مستوى المدن والأحياء (للمدن الرئيسية)، كما تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات في أنحاء المملكة،"},{"@Culture":"en-us","#cdata-section":"The digital Real Estate Indicators page gives you data on sales and leases at different levels, like the whole Kingdom, cities, and even neighborhoods in major cities"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"المؤشرات العقارية\",\n  \"المؤشرات\",\n  \"العقارية\",\n  \"الهيئة العامة للعقار\",\n  \"الخدمات الالكترونية\",\n  \"Rega\",\n  \"المبيعات\",\n  \"الايجارات\",\n  \"ايجار\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المؤشرات العقارية"},{"@Culture":"en-us","#cdata-section":"Real Estate Indicators"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المؤشرات العقارية"},{"@Culture":"en-us","#cdata-section":"Real Estate Indicators "}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تقدم صفحة المؤشرات العقارية الرقمية بيانات حول المبيعات والإيجارات على مستوى المملكة، والمدن، وعلى مستوى المدن والأحياء (للمدن الرئيسية)، كما تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات في أنحاء المملكة، مع توفير بيانات محدثة حول المبيعات والإيجارات للعقارات، مع إمكانية إجراء مقارنة بين فترات زمنية مختلفة وبين مدن مختلفة؛ لاستخلاص تحليل متعمق حسب الفترة الزمنية المحددة وتشمل أنواع متنوعة من العقارات، مما يمكّن المهتمين باتخاذ قرارات أفضل وأكثر توجيهًا من خلال توفير معلومات دقيقة وفعّالة للمستخدمين، تسهم في تعزيز شفافية السوق العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The digital Real Estate Indicators page gives you data on sales and leases at different levels, like the whole Kingdom, cities, and even neighborhoods in major cities. You can also see a visual representation of how real estate is distributed across the Kingdom. It provides up-to-date information on sales and leases, allowing you to compare different periods and cities for a detailed analysis. This helps you make informed decisions based on accurate and reliable information, promoting transparency in the real estate market.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"179ad027-8f75-46e7-b85b-a3584e3d2d31\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تقدم صفحة المؤشرات العقارية الرقمية بيانات حول المبيعات والإيجارات على مستوى المملكة، والمدن، وعلى مستوى المدن والأحياء (للمدن الرئيسية)، كما تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات في أنحاء المملكة، مع توفير بيانات محدثة حول المبيعات والإيجارات للعقارات، مع إمكانية إجراء مقارنة بين فترات زمنية مختلفة وبين مدن مختلفة؛ لاستخلاص تحليل متعمق حسب الفترة الزمنية المحددة وتشمل أنواع متنوعة من العقارات، مما يمكّن المهتمين باتخاذ قرارات أفضل وأكثر توجيهًا من خلال توفير معلومات دقيقة وفعّالة للمستخدمين، تسهم في تعزيز شفافية السوق العقاري.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"4d531159-1ccc-4820-8db8-c8eae202dfc2\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The digital Real Estate Indicators page gives you data on sales and leases at different levels, like the whole Kingdom, cities, and even neighborhoods in major cities. You can also see a visual representation of how real estate is distributed across the Kingdom. It provides up-to-date information on sales and leases, allowing you to compare different periods and cities for a detailed analysis. This helps you make informed decisions based on accurate and reliable information, promoting transparency in the real estate market.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"}]},"serviceIcon":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"4906f4c7-d4bf-45ca-b9a3-18d99a689f57\",\n    \"mediaKey\": \"9c600e1e-ca1e-4d73-ad30-364e9943d81d\"\n  }\n]"}},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"support":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/fe271edc160e463f8cf3f604328fd8d8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd1dd85bf9e44283a38c7dc960ffb8fc\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\",\n      \"udi\": \"umb://element/dd1dd85bf9e44283a38c7dc960ffb8fc\",\n      \"title\": \"\",\n      \"items\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/3d868ea35f1443108dc0eb57fc4203a4\"\n            },\n            {\n              \"contentUdi\": \"umb://element/c40da6a7af6a4e72ab4cdab437bd4ae1\"\n            },\n            {\n              \"contentUdi\": \"umb://element/5f15b41d0cd447e6bb9cf8cb577228c8\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/c40da6a7af6a4e72ab4cdab437bd4ae1\",\n            \"type\": [\n              \"Email\"\n            ],\n            \"title\": \"\",\n            \"text\": \"\",\n            \"icon\": \"\",\n            \"link\": \"\",\n            \"items\": \"\",\n            \"titleFirst\": \"1\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/5f15b41d0cd447e6bb9cf8cb577228c8\",\n            \"type\": [\n              \"Phone\"\n            ],\n            \"title\": \"\",\n            \"text\": \"\",\n            \"icon\": \"\",\n            \"link\": \"\",\n            \"items\": \"\",\n            \"titleFirst\": \"1\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/3d868ea35f1443108dc0eb57fc4203a4\",\n            \"type\": [\n              \"Website\"\n            ],\n            \"title\": \"Frequently Asked Questions\",\n            \"text\": \"FAQ's page\",\n            \"link\": \"https://dev-rega.rega.gov.sa/المكتبة/الأسئلة-الشائعة/\",\n            \"icon\": \"\",\n            \"items\": \"\",\n            \"titleFirst\": \"1\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    },\n    {\n      \"contentTypeKey\": \"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\",\n      \"udi\": \"umb://element/fe271edc160e463f8cf3f604328fd8d8\",\n      \"title\": \"\",\n      \"items\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/e66018c7758445999108990da92a5e9d\"\n            },\n            {\n              \"contentUdi\": \"umb://element/147e144908f140da97b26b8788f9b8d4\"\n            },\n            {\n              \"contentUdi\": \"umb://element/1b91c2aef08443b68c9d1b864665ccc5\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/e66018c7758445999108990da92a5e9d\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Target Audience\",\n            \"text\": \"\",\n            \"icon\": \"umb://media/feb8701eeb0f48eb85d8501d4c57976a\",\n            \"items\": [\n              \"Individuals\",\n              \"Property Owner\",\n              \"Public\",\n              \"Real Estate Beneficiary\"\n            ],\n            \"link\": \"\",\n            \"titleFirst\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/147e144908f140da97b26b8788f9b8d4\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Service Type\",\n            \"text\": \"\",\n            \"icon\": \"umb://media/a5c812c6c448431aab14c0fc6699a6b5\",\n            \"items\": [\n              \"Inquiry services\"\n            ],\n            \"link\": \"\",\n            \"titleFirst\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/1b91c2aef08443b68c9d1b864665ccc5\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Beneficiary service\",\n            \"text\": \"Service channels\",\n            \"link\": \"\",\n            \"icon\": \"umb://media/ca2c1ae6f86049dab9448ce572f3663c\",\n            \"items\": \"\",\n            \"titleFirst\": \"0\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    }\n  ],\n  \"settingsData\": []\n}"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المؤشرات العقارية"},{"@Culture":"en-us","#cdata-section":"Real Estate Indicators"}]},"uRL":{"Value":[{"@Culture":"ar-jo","#cdata-section":"https://rei.rega.gov.sa/"},{"@Culture":"en-us","#cdata-section":"https://rei.rega.gov.sa/"}]}}}},"IsRoot":true},{"Key":"c720172b-522d-370e-9010-97df2025d9fa","Alias":"الشروط والأحكام و سياسة الإستخدام","Path":"/cf93d97c-c408-4830-a4b8-c0d0d1a1cdcc.config","Level":3003,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/cf93d97c-c408-4830-a4b8-c0d0d1a1cdcc.config","Node":{"Content":{"@Key":"cf93d97c-c408-4830-a4b8-c0d0d1a1cdcc","@Alias":"الشروط والأحكام و سياسة الإستخدام","@Level":"3","Info":{"Parent":{"@Key":"256de293-04b8-413b-a7de-afdafaf300c4","#text":"المكتبة"},"Path":"///","Trashed":"false","ContentType":"usagePolicy","CreateDate":"2023-10-24T16:44:56","NodeName":{"@Default":"الشروط والأحكام و سياسة الإستخدام","Name":[{"@Culture":"ar-jo","#text":"الشروط والأحكام و سياسة الإستخدام"},{"@Culture":"en-us","#text":"Terms, Conditions, and Usage Policy"}]},"SortOrder":"3","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"f9d2f260-7c7f-4237-9611-4bd4f5d2f8e6","#text":"UsagePolicy"}},"Properties":{"bottomSectionBoxes":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"de966731-3a2d-4e18-b884-92d1b7e1842b\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"تقوم الهيئة بجمع ومعالجة البيانات الشخصية التالية:\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>الاسم.</li>\\\\n<li>معلومات التواصل كرقم الهاتف والبريد الإلكتروني ونحوها.</li>\\\\n<li>البيانات التقنية مثل (عنوان بروتوكولات الإنترنت IP وملفات تعريف الارتباط أو بيانات تقنية مرتبطة بخدمةٍ أو نظام معين).</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"76a9e88c-2cba-44f0-908b-184fd1a0ac8e\\\",\\n    \\\"mediaKey\\\": \\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"eee7972e-7dbe-411e-a162-421829ec387e\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"استخدام البيانات الشخصية\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<p>عند استخدامنا لملفات تعريف الارتباط في موقعنا الإلكتروني نحتفظ أحياناً على حاسوبك أو أجهزتك الأخرى ببعض الملفات الصغيرة التي تُعرف بملفات تعريف الارتباط، فنجمع إحصائيات الإنترنت حول زيارتك لموقعنا بناءً على عنوان برتوكولات الإنترنت IP في جهازك. ونستخدم هذه البيانات لتحسين تجربتك في استخدام موقعنا الإلكتروني.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"97d3a45f-f2d1-40bc-be8d-5ba871983128\\\",\\n    \\\"mediaKey\\\": \\\"4f94001c-b0ef-4439-9310-38c6f1a8c5fe\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"6d950ea1-e350-4f2f-b30f-a0cb472a0a84\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"مشاركة البيانات الشخصية\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<p>يتم مشاركة البيانات الشخصية بعد موافقة صاحب البيانات لأغراض مشروعة أو كانت مطلوبة لأغراض أمنية أو لتنفيذ نظام آخر أو لاستيفاء مُتطلبات قضائية، كما تبذل الهيئة جهدها لحماية المعلومات التي يقدمها المستخدم وفق أفضل الممارسات، وتعمل على تشفير المعلومات والبيانات الحساسة التي يتعين الحفاظ على سريتها بالتوافق مع المتطلبات النظامية وفق الأنظمة السارية في المملكة.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"b5accd36-af51-4e8e-9793-9ec3bf012bde\\\",\\n    \\\"mediaKey\\\": \\\"338b15b4-287a-4c9b-a995-b310048b4c6f\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"58bfae50-ca1e-4aca-bc89-692eb36ff0d0\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"يتم الاستفادة من جمع المعلومات الشخصية للعديد من الأغراض منها: \",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>تمكين وتقديم خدمات الهيئة واستيفاء متطلباتها.</li>\\\\n<li>الاستجابة لاستفسارات المستفيدين من خدمات الهيئة مع تطوير وتحسين تجربة المستفيد وضمان استمرارية تقديم الخدمات بالجودة المطلوبة.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"05e98703-6676-48ef-8f85-6d45f508242a\\\",\\n    \\\"mediaKey\\\": \\\"41177547-ecef-406a-b9db-c339416da5e2\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"ee43b4dd-522c-4161-849f-e4cac8c71d4f\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"الأساس النظامي لجمع ومعالجة البيانات الشخصية وفقاً لسياسة حماية البيانات الشخصية الصادرة من مكتب إدارة البيانات الوطنية، لذا فإن الأساس النظامي الذي نعتمد عليه لمعالجة هذه البيانات هو:\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>موافقتك الصريحة او الضمنية، ويمكنك التراجع عن الموافقة في أي وقت ما عدا بعض الاستثناءات الموضحة أعلاه وللقيام بذلك يمكنك التواصل معنا عبر البريد الإلكتروني الموضح في بيانات التواصل.</li>\\\\n<li>تحقيق المصلحة العامة: من خلال تسهيل وتحسين الإجراءات.</li>\\\\n<li>يتم تخزين بياناتك الشخصية بشكل آمن وذلك في الهيئة العامة للعقار أو من خلال حلول آمنة في خدمات الحوسبة السحابية الالتزام بمتطلبات الهيئة الوطنية للأمن السيبراني في ذلك.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"8927abbe-444e-4173-b5b7-c4781fd1ebe3\\\",\\n    \\\"mediaKey\\\": \\\"41177547-ecef-406a-b9db-c339416da5e2\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"0f99a2c7-97d7-4766-a627-9799cfe0fdd2\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"حقوقك فيما يتعلق بمعالجة البيانات الشخصية:\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>الحق في الوصول إلى بياناتك الشخصية: وذلك بطلب نسخة من بياناتك الشخصية عبر البريد الإلكتروني الموضح في بيانات التواصل.</li>\\\\n<li>الحق في تصحيح بياناتك الشخصية: وذلك بطلب تصحيح بياناتك الشخصية التي ترى أنها غير دقيقة أو غير صحيحة أو غير مكتملة وذلك عبر البريد الإلكتروني الموضح في بيانات التواصل ادناه، وسيتم مراجعتها وتحديثها واشعارك بذلك عن طريق [معلومات التواصل الخاصة بك].</li>\\\\n<li>الحق في إتلاف بياناتك الشخصية: وذلك بطلب مسح بياناتك الشخصية في ظروف معينة بما لا يتعارض مع الأسس النظامية والمصالح المشروعة.</li>\\\\n<li>الحق في تقييد المعالجة: وذلك بطلب تقييد معالجة بياناتك الشخصية في ظروف معينة ولفترة زمنية محددة.</li>\\\\n<li>الحق في الاعتراض على المعالجة: وذلك بالاعتراض على معالجة بياناتك الشخصية.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"441ad508-e30c-428c-a024-fa5d51dc1098\\\",\\n    \\\"mediaKey\\\": \\\"7ea21755-898e-413f-b788-9f3fe717d3d4\\\"\\n  }\\n]\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"ae8c6b94-3745-4891-bed0-1d1268acdb91\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"The Authority collects and processes the following personal data:\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Name</li>\\\\n<li>Contact Information (phone number and email) </li>\\\\n<li>Technical Data (IP address, cookies, and other technical data related to a specific service or system) </li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"70c245e0-232a-41a8-8ec0-5f1d06b9f181\\\",\\n    \\\"mediaKey\\\": \\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"e6ff1e5d-736e-4c85-b5e4-6a964658d4e5\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"Use of Personal Data:  \",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<p>When cookies are used on the Site, small files on your device or other devices known as “cookies” are saved. Internal statistics, regarding your visit to the Site based on your device’s IP address, are collected. This data helps improve your experience when navigating the Site. &nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"0a0bf03f-3f5a-4ce8-8628-2736c56e1ebf\\\",\\n    \\\"mediaKey\\\": \\\"4f94001c-b0ef-4439-9310-38c6f1a8c5fe\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"209b5067-4f91-460f-b7e7-3e8fdf2a7c51\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"Sharing Personal Data: \",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<p>Personal data is shared after the approval of the data owner and for legitimate, security, and judicial purposes, or to implement another system. The Authority makes every effort to protect the information provided by the user based on best practices. The Authority works to encrypt information and sensitive data that should be kept confidential following regulatory requirements that comply with the Kingdom’s current regulations.&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"a6e6a60a-bc6b-4b99-bcb8-4f25676ed6f9\\\",\\n    \\\"mediaKey\\\": \\\"338b15b4-287a-4c9b-a995-b310048b4c6f\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"47953dbe-d38e-44f7-85cc-2fbdef8ab978\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"The collection of Personal Data benefits many purposes, which include: \",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Empower and develop the Authority’s services and fulfill its requirements. </li>\\\\n<li>Respond to beneficiaries’ questions on the Authority’s services, in addition to developing and improving the user experience and maintaining continuity in providing quality services.  </li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"787ed130-6ae5-4039-b0c2-54f9b0e3b34e\\\",\\n    \\\"mediaKey\\\": \\\"41177547-ecef-406a-b9db-c339416da5e2\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"2358e475-7fc9-4225-ad0a-68a8e4923ddb\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"The fundamental system to collect and process Personal Data follows the Personal Data Protection Policy issued by the National Data Management Office. The fundamental system the Authority complies with to process this data is:  \",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Your explicit or implicit approval. You can withdraw your approval anytime except in the abovementioned exceptions. To withdraw your approval, you can contact the Authority via the email listed in the contact information. </li>\\\\n<li>Achieving public interest: Through facilitating and improving procedures.</li>\\\\n<li>Your Personal Data is safely stored at the Real Estate General Authority or through secure solutions in cloud computing services; following the National Cybersecurity Authority’s regulations.  </li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"23870c22-9886-495d-90b4-01e0da85b17c\\\",\\n    \\\"mediaKey\\\": \\\"41177547-ecef-406a-b9db-c339416da5e2\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"b91b0d9f-eef0-4e4c-a93d-2b5726c78570\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"The user’s rights to Personal Data processing: \",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access your Personal Data: By requesting a copy of your Personal Data via the email address listed in the contact information.&nbsp;</li>\\\\n<li>The right to correct your Personal Data: By requesting the correction of your Personal Data whether it is inaccurate, incorrect, or incomplete via the email address listed in the contact information. Your request will be reviewed and you will be contacted and notified via your contact information.&nbsp;</li>\\\\n<li>The right to destroy your Personal Data: By requesting to erase your Personal Data in certain circumstances that do not clash with fundamental systems or legitimate interests.&nbsp;</li>\\\\n<li>The right to restrict the processing: By requesting to restrict the processing of your Personal Data in certain circumstances and for a specific period.&nbsp;</li>\\\\n<li>The right to object to the processing: By objecting to the processing of your Personal Data.&nbsp;</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"674452ad-4b04-4091-b2c8-0b5749b2b949\\\",\\n    \\\"mediaKey\\\": \\\"7ea21755-898e-413f-b788-9f3fe717d3d4\\\"\\n  }\\n]\"\n  }\n]"}]},"bottomSectionTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"سياسة الخصوصية:"},{"@Culture":"en-us","#cdata-section":"Privacy Policy: "}]},"boxesDescription":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تعتبر سياسة الخصوصية الموضحة أدناه جزءًا من شروط استخدام البوابة الالكترونية للهيئة العامة للعقار، وقد تقوم الهيئة بجمع البيانات الشخصية عند زيارة البوابة الإلكترونية، ويعد استخدام البوابة والمنصات التابعة لها موافقة على بنود هذه السياسة وتحتفظ الهيئة بحقها في تعديل/تحديث سياسة الخصوصية عند الضرورة، ويصبح أي تعديل للبنود أو الشروط نافذاً فور ا اعتماده دون أي التزام بالإعلان.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Privacy Policy hereunder is part of the Terms of Use of the Real Estate General Authority’s electronic portal. The Authority may collect personal data when users visit the electronic portal. The Terms of Use are effective when using the portal and other affiliated platforms. The Authority holds the right to amend/update the Privacy Policy when needed and be implemented effective immediately without the obligation to announce the amendments and updates. &nbsp; &nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"boxesTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"سياسة الاستخدام"},{"@Culture":"en-us","#cdata-section":"Usage Policy"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشروط والأحكام و سياسة الإستخدام"},{"@Culture":"en-us","#cdata-section":"Terms, Conditions, and Usage Policy"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"شروط\",\n  \"احكام\",\n  \"الشروط والاحكام\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"terms\",\n  \"condations\",\n  \"policy\",\n  \"Rega\"\n]"}},"pageDescription":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشروط والأحكام و سياسة الإستخدام"},{"@Culture":"en-us","#cdata-section":"Terms, Conditions, and Usage Policy"}]},"pageSubTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشروط والأحكام و سياسة الإستخدام"},{"@Culture":"en-us","#cdata-section":"Terms, Conditions, and Usage Policy"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشروط والأحكام و سياسة الإستخدام"},{"@Culture":"en-us","#cdata-section":"Terms, Conditions, and Usage Policy"}]},"usagePolicyBoxes":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"5981bcf0-76de-439e-a3fe-ca451d3369c5\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"القيود على الاستخدام\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul>\\\\n<li>إن حساب المستخدم يجب أن يستخدم من قبل صاحب الحساب فقط.</li>\\\\n<li>يحكم استخدامك للموقع أنظمة ولوائح الهيئة والأنظمة واللوائح الأخرى المعمول بها في المملكة العربية السعودية.</li>\\\\n<li>يجب المحافظة على سرية هوية المستخدم وكلمة السر ويعتبر المستخدم مسؤولا مسؤولية كاملة عن أي نتائج تؤدي إلى كشفها لأي طرف آخر والآثار المترتبة عليه.</li>\\\\n<li>يجب على المستخدم إخطار الهيئة فوراً إذا تبين له أن كلمه السر للحساب قد أصبحت معلومة للآخرين، أو إذا تبين له أي اختراق أمني أو نشاط غير اعتيادي للحساب.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"5b797933-4cb0-44eb-a450-34cf3a64ef7e\\\",\\n    \\\"mediaKey\\\": \\\"60746ace-c345-4501-b216-231fa3d99bb6\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"8da72f51-75a5-4aa7-a3eb-d617b27e195c\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"باستخدامك لبوابة الهيئة العامة للعقار، تقر بالامتناع عن الآتي:\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>رفع أو تحميل ملفات تحتوي على برمجيات أو مواد أو بيانات أو معلومات أخرى ليست مملوكة لك أو لا تملك ترخيصاً بشأنها.</li>\\\\n<li>رفع أو تحميل ملفات على هذه البوابة تحتوي على فيروسات أو بيانات تالفة أو أي برمجيات خبيثة، أو القيام بكل ما من شأنه التأثير على سلامة المعلومات في البوابة أو موثوقيتها أو استمرار توفرها.</li>\\\\n<li>نشر أو إعلان أو توزيع أو تعميم مواد أو معلومات تحتوي تشويهاً للسمعة أو انتهاكاً للقوانين أو مواد إباحية أو بذيئة أو مخالفة للتعاليم الإسلامية أو للآداب العامة أو أي مواد أو معلومات غير قانونية من خلال بوابة الهيئة.</li>\\\\n<li>الإعلان -على بوابة الهيئة -عن أي منتج أو خدمة تجعل الهيئة في وضع انتهاك لأي نظام مطبق في أي مجال.</li>\\\\n<li>استخدام أية وسيلة أو برنامج أو إجراء لاعتراض أو محاولة اعتراض التشغيل الصحيح لبوابة الهيئة.</li>\\\\n<li>القيام بأي إجراء يفرض حملاً غير معقول أو كبير أو بصورة غير مناسبة على البنية التحتية لبوابة الهيئة.</li>\\\\n<li>كل ما يعد مخالفة لنظام مكافحة الجرائم المعلوماتية أو أي نظام آخر ذو علاقة في المملكة.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"bc9459b3-6556-4f67-84e9-586b775b12fe\\\",\\n    \\\"mediaKey\\\": \\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"\\n  }\\n]\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"3f62df80-3e81-4213-b5ae-ff47f9305ac4\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"Usage Restrictions\",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul>\\\\n<li>The user account should be used only by the account owner.</li>\\\\n<li>Your use of the Site is governed by the Authority’s rules and regulations, and other rules and regulations enforced in the Kingdom of Saudi Arabia.</li>\\\\n<li>The user’s identity and password should remain confidential, and the user is fully responsible for any consequences resulting from the disclosure of this data to any other party. &nbsp;</li>\\\\n<li>The user should directly inform the Authority in the matter that the password has been disclosed to other parties or if there has been a security breach or unusual activity in the account.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"3fd3b80b-3641-495b-8c74-02782f05730c\\\",\\n    \\\"mediaKey\\\": \\\"60746ace-c345-4501-b216-231fa3d99bb6\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"57c54904-fb59-4992-93f6-8816948ef1f3\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"usagePolicyItem\",\n    \"PropType\": null,\n    \"title\": \"By using the Real Estate General Authority’s portal, you agree to abstain from the following: \",\n    \"itemBreif\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Upload or download files containing software, material, data, or other information not owned by you or licensed to you. &nbsp;&nbsp;</li>\\\\n<li>Upload or download files onto this portal that contain viruses, corrupt data, or unsolicited software, or conduct any action that may affect the safety, reliability, or continued availability of the information on the portal. &nbsp;</li>\\\\n<li>Publish, post, distribute, or circulate material and information that are defamatory, unlawful, infringing, obscene, or violate Islamic teachings or public morals, or any illegal material or information through the Authority’s portal.&nbsp;</li>\\\\n<li>Advertise – on the Authority’s portal – any product or service that would cause the Authority to violate any system applied in any field.&nbsp;</li>\\\\n<li>Use any device, program, or procedure to interfere or attempt to interfere with the proper functions of the Authority’s portal.&nbsp;</li>\\\\n<li>Take any action that inflicts an unreasonable or disproportionately large load on the infrastructure of the Authority’s portal.&nbsp;</li>\\\\n<li>Everything that is considered a violation of the Anti-Cyber Crime System or any other relevant system in the Kingdom.&nbsp;</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"itemImage\": \"[\\n  {\\n    \\\"key\\\": \\\"e68db64e-68f1-438a-b3ec-f77e804a3db8\\\",\\n    \\\"mediaKey\\\": \\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"\\n  }\\n]\"\n  }\n]"}]}}}},"IsRoot":true},{"Key":"7688ede8-4a58-33f3-8ebf-7efd81cb00a9","Alias":"طلب بيانات مفتوحة","Path":"/b1fc40d6-1fc0-45bc-adae-c399ee932318.config","Level":3003,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b1fc40d6-1fc0-45bc-adae-c399ee932318.config","Node":{"Content":{"@Key":"b1fc40d6-1fc0-45bc-adae-c399ee932318","@Alias":"طلب بيانات مفتوحة","@Level":"3","Info":{"Parent":{"@Key":"b3852463-2459-457e-b1b4-453647d45cab","#text":"البيانات المفتوحة"},"Path":"///","Trashed":"false","ContentType":"openDataRequest","CreateDate":"2023-11-23T13:26:35","NodeName":{"@Default":"طلب بيانات مفتوحة","Name":[{"@Culture":"ar-jo","#text":"طلب بيانات مفتوحة"},{"@Culture":"en-us","#text":"Request Open Data"}]},"SortOrder":"3","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"9de4762d-7ae2-4281-80d9-4e5a1c2e8c38","#text":"OpenDataRequest"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"طلب بيانات مفتوحة"},{"@Culture":"en-us","#cdata-section":"Request Open Data"}]},"formDescription":{"Value":[{"@Culture":"ar-jo","#cdata-section":"قم بملئ البيانات أدناه للتقدم بطلب للحصول على البيانات المفتوحة."},{"@Culture":"en-us","#cdata-section":"Fill in the information below to apply for open data."}]},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":"22cfb8de-c8e0-47f5-b153-f92fca702c32"}},"formTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"طلب بيانات مفتوحة"},{"@Culture":"en-us","#cdata-section":"Request Open Data"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"open\",\n  \"data\",\n  \"open data\",\n  \"Rega\",\n  \"البيانات\",\n  \"البيانات المفتوحة\",\n  \"المفتوحة\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\"\n]"}},"pageDescription":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<ul style=\\\"list-style-type: disc;\\\">\\n<li>The request must be to access or obtain public information.&nbsp;<br>The main steps to access or obtain public information:&nbsp;<br>\\n<ul style=\\\"list-style-type: disc;\\\">\\n<li><strong>First:</strong> Applications must be submitted by filling out an electronic form and submitting it to the Authority</li>\\n<li><strong>Second:</strong> The Authority receives the request to access or obtain public information and makes one of the following decisions:&nbsp;<br>\\n<ul style=\\\"list-style-type: disc;\\\">\\n<li><strong>Approval:</strong> If the Authority approves the request to access or obtain public information.</li>\\n<li><strong>Rejection:</strong> If the Authority rejects the request to access or obtain public information, the rejection must be in writing or electronically and include the following information:&nbsp;<br>\\n<ul style=\\\"list-style-type: disc;\\\">\\n<li>Determine whether the application was rejected partially or fully.</li>\\n<li>If possible, state the reasons for the rejection.&nbsp;</li>\\n</ul>\\n</li>\\n<li><strong>Notification:</strong> If the required information is available on the Authority’s website or is not under its jurisdiction, the individual must be notified in writing or electronically.&nbsp;&nbsp;</li>\\n</ul>\\n</li>\\n<li><strong>Third:</strong> In case the individual wishes to appeal the Authority’s rejection of the application, the appeal can be submitted, in writing or electronically, to the Data Management Office at the Authority within 5 business days of receiving the Authority’s decision. The Data Management Office at the Authority will review the request and make the appropriate decision.&nbsp;</li>\\n</ul>\\n</li>\\n</ul>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"طلب بيانات مفتوحة"},{"@Culture":"en-us","#cdata-section":"Request Open Data"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"طلب بيانات مفتوحة"},{"@Culture":"en-us","#cdata-section":"Request Open Data"}]},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"طلب بيانات مفتوحة"},{"@Culture":"en-us","#cdata-section":"Request Open Data"}]}}}},"IsRoot":true},{"Key":"848febab-c21b-332f-9ed1-1b46ed54798c","Alias":"إيجار","Path":"/59071c62-4f3a-4e53-9784-68963286266a.config","Level":3003,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/59071c62-4f3a-4e53-9784-68963286266a.config","Node":{"Content":{"@Key":"59071c62-4f3a-4e53-9784-68963286266a","@Alias":"إيجار","@Level":"3","Info":{"Parent":{"@Key":"75795868-cfb0-4021-a108-d26b070a39a4","#text":"الخدمات الإلكترونية"},"Path":"///","Trashed":"false","ContentType":"service","CreateDate":"2023-09-06T17:34:23","NodeName":{"@Default":"إيجار","Name":[{"@Culture":"ar-jo","#text":"إيجار"},{"@Culture":"en-us","#text":"EJAR"}]},"SortOrder":"3","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go to Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"إيجار شبكة إلكترونية متكاملة تهدف إلى تنظيم قطاع الإيجار العقاري في المملكة العربية السعودية وحفظ حقوق أطراف العملية الإيجارية ( المستأجر، المؤجر، الوسيط العقاري )،"},{"@Culture":"en-us","#cdata-section":"EJAR is a complete electronic network that aims to organize the real estate leasing sector in the Kingdom of Saudi Arabia. It's designed to protect the rights of tenants, landlords, and real estate brokers involved in leasing activities."}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":"[\n  \"ايجار\",\n  \"ejar\",\n  \"Rega\",\n  \"الخدمات الالكترونية\",\n  \"الهيئة العامة للعقار\",\n  \"العقار\",\n  \"مستأجر\",\n  \"موجر\",\n  \"وسيط\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"إيجار"},{"@Culture":"en-us","#cdata-section":"EJAR"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"إيجار"},{"@Culture":"en-us","#cdata-section":"EJAR"}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>إيجار شبكة إلكترونية متكاملة تهدف إلى تنظيم قطاع الإيجار العقاري في المملكة العربية السعودية وحفظ حقوق أطراف العملية الإيجارية ( المستأجر، المؤجر، الوسيط العقاري )،</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>\\\"EJAR\\\" is a complete electronic network that aims to organize the real estate leasing sector in the Kingdom of Saudi Arabia. It's designed to protect the rights of tenants, landlords, and real estate brokers involved in leasing activities. \\\"EJAR\\\" offers electronic solutions that help develop and streamline the real estate leasing sector, promoting balance, trust, and investment.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"89e74439-32d7-4704-af88-8a5390a0be58\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"إيجار\\\\\\\" شبكة إلكترونية متكاملة تهدف إلى تنظيم قطاع الإيجار العقاري في المملكة العربية السعودية وحفظ حقوق أطراف العملية الإيجارية ( المستأجر، المؤجر، الوسيط العقاري )، تقدم مجموعة من الحلول الإلكترونية التي تسهم في تطوير قطاع الإيجار العقاري وتنظيمه وتيسير أعماله، بما يحقق التوازن في القطاع وتعزيز الثقة به، ويسهم في تحفيز الاستثمار فيه.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"86073bb7-7ad2-4b94-9967-daddc173583e\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"EJAR\\\\\\\" is a complete electronic network that aims to organize the real estate leasing sector in the Kingdom of Saudi Arabia. It's designed to protect the rights of tenants, landlords, and real estate brokers involved in leasing activities. \\\\\\\"EJAR\\\\\\\" offers electronic solutions that help develop and streamline the real estate leasing sector, promoting balance, trust, and investment.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"}]},"serviceIcon":{"Value":{"#cdata-