986d4f3baf7045e97cfc2aa0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة عن طريق توفير مجموعة شاملة من الخدمات تشمل مساحات العمل المشتركة، والخدمات المتخصصة لتطوير الأعمال، و تتضمن الاستشارات والتوجيه والتدريب، بالإضافة لتيسير الوصول إلى المستثمرين من أجل تسريع تطوّر ونمو الشركات الناشئة والريادية وتوسعها,<span>&nbsp; والعمل على تأسيسها بشكل سليم لتكون داعمة&nbsp; للقطاع العقاري </span>و رفع مساهمته في الناتج المحلي للمملكة العربية السعودية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e64f2e78e0c4443c8ba82f92e2827955\",\n      \"title\": \"اهداف المبادرة:\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>خلق شركات ناشئة<span>&nbsp; على أسس سليمة داعمة للقطاع العقاري </span></li>\\n<li>رفع مساهمة<span>&nbsp; الشركات الناشئة في القطاع العقاري للاقتصاد الوطني </span></li>\\n<li>توسع الشركات في التقنية العقارية محليًا<span>&nbsp; ودوليًا </span></li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\",\n      \"title\": \"النسخة الأولى من برنامج مسرعة التقنية العقارية \",\n      \"content\": {\n        \"markup\": \"<p>تأتي مسرعة التقنية العقارية بنسختها الأولى بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات<span>&nbsp; </span>و نسعد بإعلان فتح<span>&nbsp; التسجيل&nbsp; لبرنامج المسرعة </span>عن طريق مسرعة الأعمال العالمية startup wise guys</p>\\n<p><strong>أخر موعد للتقديم: 15/12/2024</strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"https://startupwiseguys.com/all-programs/proptech-accelerator-program/\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\",\n      \"title\": \"الأسئلة الشائعة \",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul>\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">برامج مكثفة لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة ، و يوفر مجموعة شاملة من الخدمات والموارد، بما في ذلك توفير مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\n<div>\\n<ul>\\n<li>ماذا تقدم المسرعة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">الدعم المعرفي للشركات الناشئة من خلال عدة برامج من ضمنها<span>&nbsp; التدريب&nbsp; </span>و الارشاد و التوجيه بهدف تأسيس شركات على أسس سليمة</p>\\n<div class=\\\"O0\\\">\\n<ul>\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\n</ul>\\n</div>\\n<ul>\\n<li style=\\\"list-style-type: none;\\\">\\n<ul>\\n<li class=\\\"O0\\\">ورش عمل<span>&nbsp; متخصصة في التقنية العقارية&nbsp; .</span></li>\\n<li class=\\\"O0\\\">قصص نجاح من أبرز رواد الاعمال و المؤثرين .</li>\\n<li class=\\\"O0\\\">جلسات استشارية و ارشادية</li>\\n<li class=\\\"O0\\\">الربط مع الجهات التمويلية .</li>\\n</ul>\\n</li>\\n</ul>\\n<div><span></span></div>\\n<div>\\n<ul>\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; مدة البرنامج 6 شهور </span></p>\\n<ul>\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; لا يوجد رسوم</span></p>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مسرعات الأعمال"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"eafb2170-8ced-3c77-9ab4-92ab3a9ec880","Alias":"المهندس عبدالله بن سعود الحماد","Path":"/ff302e1a-ad49