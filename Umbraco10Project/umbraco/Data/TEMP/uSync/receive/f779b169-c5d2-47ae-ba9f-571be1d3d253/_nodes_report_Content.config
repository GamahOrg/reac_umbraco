"ar-jo","#cdata-section":"مُلكية لجنة معالجة أخطاء الملكية، وهي لجنة مستقلة عن الجهات الحكومية تعمل بحيادية لمعالجة تعثرات المستفيدين من تسجيل الملكية العقارية لدى الجهات الحكومية، وتقوم اللجنة بأعمالها لدعم القطاع العقاري، ورفع تصنيف المملكة التنافسي في مؤشر تسجيل الملكية.\n"},{"@Culture":"en-us","#cdata-section":"Mulkia is the Committee for Addressing Property Registration Errors and works independently from governmental parties to objectively resolve beneficiaries’ dispersions in registering their real estate properties with government agencies"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":"[\n  \"معالجة\",\n  \"الاخطاء\",\n  \"تسجيل الملكية\",\n  \"الهيئة العامة للعقار\",\n  \"الخدمات الالكترونية\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"لجنة معالجة أخطاء تسجيل الملكية"},{"@Culture":"en-us","#cdata-section":"Mulkia"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"لجنة معالجة أخطاء تسجيل الملكية"},{"@Culture":"en-us","#cdata-section":"Mulkia"}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>\\\"مُلكية\\\" لجنة معالجة أخطاء الملكية، وهي لجنة مستقلة عن الجهات الحكومية تعمل بحيادية لمعالجة تعثرات المستفيدين من تسجيل الملكية العقارية لدى الجهات الحكومية، وتقوم اللجنة بأعمالها لدعم القطاع العقاري، ورفع تصنيف المملكة التنافسي في مؤشر تسجيل الملكية.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>“Mulkia” is the Committee for Addressing Property Registration Errors and works independently from governmental parties to objectively resolve beneficiaries’ dispersions in registering their real estate properties with government agencies. The committee conducts these activities to support the real estate sector and boost the Kingdom’s competitive ranking in the Property Registration Index.&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"d85cc10c-e772-41c4-9e70-7013c27010db\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"مُلكية\\\\\\\" لجنة معالجة أخطاء الملكية، وهي لجنة مستقلة عن الجهات الحكومية تعمل بحيادية لمعالجة تعثرات المستفيدين من تسجيل الملكية العقارية لدى الجهات الحكومية، وتقوم اللجنة بأعمالها لدعم القطاع العقاري، ورفع تصنيف المملكة التنافسي في مؤشر تسجيل الملكية.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"500fee2a-a2b3-4b08-aef2-09d3d588a26c\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>“Mulkia” is the Committee for Addressing Property Registration Errors and works independently from governmental parties to objectively resolve beneficiaries’ dispersions in registering their real estate properties with government agencies. The committee conducts these activities to support the real estate sector and boost the Kingdom’s competitive ranking in the Property Registration Index.&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"}]},"serviceIcon":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"aef86d70-3f38-4feb-8bf9-05575a5