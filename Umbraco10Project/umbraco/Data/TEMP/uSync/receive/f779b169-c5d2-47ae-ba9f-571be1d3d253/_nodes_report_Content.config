}\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>يهدف المنتدى الى خلق فرصاً مميزة في التواصل ومشاركة المعرفة ومناقشة القضايا وأبرز التقنيات في القطاع العقاري، كما أنه يعطي مساحة للمؤثرين في القطاع سواء محليين او دوليين للتجمع والتفاعل، حيث انه يلعب دوراً مهماً في تعزيز نمو الناتج المحلي الإجمالي وجذب الاستثمار ويوفر فرص عمل للمواطنين في المؤسسات الت تدعم النمو العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - فندق الفيصلية"},{"@Culture":"en-us","#cdata-section":"الرياض - فندق الفيصلية"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2eda8641-fee8-4897-87c9-d806064c6ef9\",\n    \"mediaKey\": \"621ee046-2d2d-426d-b9ce-3809c92ee038\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"منتدى مستقبل العقار"},{"@Culture":"en-us","#cdata-section":"منتدى مستقبل العقار"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"منتدى مستقبل العقار"},{"@Culture":"en-us","#cdata-section":"منتدى مستقبل العقار"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-01-23T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-01-23T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"1b48d408-c577-32eb-ad99-05b99218e1c0","Alias":"الأستاذ عجلان بن عبدالعزيز العجلان","Path":"/0f6e238c-d246-43ad-94c2-a2ef393c65e1.config","Level":4009,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/0f6e238c-d246-43ad-94c2-a2ef393c65e1.config","Node":{"Content":{"@Key":"0f6e238c-d246-43ad-94c2-a2ef393c65e1","@Alias":"الأستاذ عجلان بن عبدالعزيز العجلان","@Level":"4","Info":{"Parent":{"@Key":"1d910e48-371e-4392-8b05-a77b3939da64","#text":"مجلس الإدارة"},"Path":"////","Trashed":"false","ContentType":"director","CreateDate":"2024-03-12T22:47:27","NodeName":{"@Default":"الأستاذ عجلان بن عبدالعزيز العجلان","Name":[{"@Culture":"ar-jo","#text":"الأستاذ عجلان بن عبدالعزيز العجلان"},{"@Culture":"en-us","#text":"الأستاذ عجلان بن عبدالعزيز العجلان"}]},"SortOrder":"9","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":null},"Properties":{"directorName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأستاذ عجلان بن عبدالعزيز العجلان"},{"@Culture":"en-us","#cdata-section":"الأستاذ عجلان بن عبدالعزيز  العجلان "}]},"personalImage":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1eb372a3-f525-4167-b0d9-23f3375a889c\",\n    \"mediaKey\": \"0d8914a6-b779-444e-a14c-305d8107b386\"\n  }\n]"}},"position":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عضو مجلس الإدارة"},{"@Culture":"en-us","#cdata-section":"عضو مجلس إدارة "}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"0ea37436-5c04-3f1e-84f2-d8948b2f021d","Alias":"حصر دفع الإيجار للعقود السكنية من خلال القنوات الرقمية بدءاً من 15 يناير بشكل تدريجي","Path":"/6728b2c6-a8dd-46f7-81de-11018379977d.config","Level":4009,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6728b2c6-a8dd-46f7-81de-11018379977d.config","Node":{"Content":{"@Key":"6728b2c6-a8dd-46f7-81de-11018379977d","@Alias":"حصر دفع الإيجار للعقود السكنية من خلال القنوات الرقمية بدءاً من 15 يناير بشكل تدريجي","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-01-02T15:38:02","NodeName":{"@Default":"حصر دفع الإيجار للعقود السكنية من خلال القنوات الرقمية بدءاً من 15 يناير بشكل تدريجي"},"SortOrder":"9","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-01-02T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0af704c2-ce59-4604-98c2-fdff6f89becd\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: center; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Calibri',sans-serif;\\\" lang=\\\"AR-SA\\\">&nbsp;</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Calibri',sans-serif;\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن بدئها بحصر التعامل المالي المرتبط بعمليات دفع الإيجار من خلال القنوات الرقمية في \\\"إيجار\\\" اعتبارًا من 15 يناير 2024م.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Calibri',sans-serif;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ حصر الدفع عبر القنوات الرقمية في إيجار يشمل جميع عقود الإيجار السكنية الجديدة، حيث لن يُعتد بعد هذا التاريخ بأي إثباتات لعمليات دفع الإيجار خارج إطار القنوات الرقمية في إيجار (مدى، وسداد باستخدام رقم المفوتر 153)، مضيفةً إلى أنّ قرار الحصر لا يشمل العقود الإيجارية التجارية.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Calibri',sans-serif;\\\" lang=\\\"AR-SA\\\">وأضافت هيئة العقار أنها ستبدأ اعتباراً من هذا التاريخ في الإيقاف التدريجي لإصدار سندات القبض الإلكترونية للعقود السكنية الجديدة، حيث سيتم تسوية الدفعة بشكل آلي عند سدادها بأحد القنوات الرقمية، دون الحاجة إلى إصدار سند القبض، وذلك تطبيقًا لقرار مجلس الوزراء رقم (131) بوضع الترتيبات اللازمة لتوفير خدمة السداد الإلكتروني لمدفوعات عقود الإيجار، مبينة أنه يصب في صالح المستفيدين من قطاع الإيجار العقاري مما يسهل على المستأجر سداد التزاماته المالية عبر القنوات الرقمية وإيداعها في الحساب البنكي للمؤجر المسجل في عقد الإيجار.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Calibri',sans-serif;\\\" lang=\\\"AR-SA\\\">وأكّدت هيئة العقار على أنّ هذه الخطوة تبدأ بتوثيق المؤجر والمستأجر للعقد في إيجار عبر وسيط عقاري مرخّص من الهيئة، ثم البدء باستخدام قنوات الدفع الرقمية في إيجار لإجراء عمليات الدفع، حيث تصل الدفعة الإيجارية بعد دفعها عبر القنوات الرقمية في إيجار إلى الحساب البنكي للمؤجر المسجل في عقد الإيجار خلال 5 أيام عمل.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Calibri',sans-serif;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ \\\"إيجار\\\" قد بيّن ميزات الدفع الرقمي وكان أبرزها حفظ حقوق أطراف العملية الإيجارية، وتوثيق الدفعات المالية، وعدم الحاجة إلى إصدار سندات القبض الإلكترونية، بالإضافة إلى تعزيز التعاملات الإلكترونية، ورفع مستوى الشفافية في العمليات العقارية، والحد من عمليات الاحتيال العقاري، وتسهيل عمليات الدفع على المستأجر حيث يمكن الدفع جزئيًا، بحسب الاتفاق بين الطرفين.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"حصر دفع الإيجار للعقود السكنية من خلال القنوات الرقمية بدءاً من 15 يناير بشكل تدريجي"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"f4b6fd89-453f-3c4b-ae22-a028ab72a0d3","Alias":"ملتقى الإستثمار البلدي","Path":"/5a1d76ca-e8e2-4718-b029-807096db489c.config","Level":4009,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/5a1d76ca-e8e2-4718-b029-807096db489c.config","Node":{"Content":{"@Key":"5a1d76ca-e8e2-4718-b029-807096db489c","@Alias":"ملتقى الإستثمار البلدي","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:39:19","NodeName":{"@Default":"ملتقى الإستثمار البلدي","Name":[{"@Culture":"ar-jo","#text":"ملتقى الإستثمار البلدي"},{"@Culture":"en-us","#text":"ملتقى الإستثمار البلدي"}]},"SortOrder":"9","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-01-25T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-01-25T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right;\\\" class=\\\"MsoNormal\\\" align=\\\"right\\\">يهدف الملتقى إلى رفع جاذبية الاستثمار في المدن السعودية وتحفيز الاستثمارات المحلية واستقطاب استثمارات خارجية تنعكس على رفع مساهمة القطاع الخاص في تطوير المدن وتنمية الناتج المحلي، والمساهمة في تمكين الاستراتيجيات القطاعية والمناطقية، والتعريف بآليات الاستثمار البلدي.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right;\\\" class=\\\"MsoNormal\\\" align=\\\"right\\\">يهدف الملتقى إلى رفع جاذبية الاستثمار في المدن السعودية وتحفيز الاستثمارات المحلية واستقطاب استثمارات خارجية تنعكس على رفع مساهمة القطاع الخاص في تطوير المدن وتنمية الناتج المحلي، والمساهمة في تمكين الاستراتيجيات القطاعية والمناطقية، والتعريف بآليات الاستثمار البلدي.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - واجهة الرياض"},{"@Culture":"en-us","#cdata-section":"الرياض - واجهة الرياض"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"5d8fa6f7-eec5-4787-9894-53c1ce83b201\",\n    \"mediaKey\": \"3dae4a5d-cdee-4b9c-be28-fb02232afecf\"\n  },\n  {\n    \"key\": \"25ccf607-5d37-4f37-8ce2-75b8aca98f32\",\n    \"mediaKey\": \"e0223088-7d7d-47b9-8c76-16c5ace9f85b\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"ملتقى الإستثمار البلدي"},{"@Culture":"en-us","#cdata-section":"ملتقى الإستثمار البلدي"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"ملتقى الإستثمار البلدي"},{"@Culture":"en-us","#cdata-section":"ملتقى الإستثمار البلدي"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-01-23T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-01-23T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"cfffead9-70a2-33e6-b5d7-22dec1bf4829","Alias":"الهيئة العامة للعقار تُرخص 28 منصة عقارية إلكترونية","Path":"/dc83c609-635e-4add-85bf-df7527ecdb41.config","Level":4010,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/dc83c609-635e-4add-85bf-df7527ecdb41.config","Node":{"Content":{"@Key":"dc83c609-635e-4add-85bf-df7527ecdb41","@Alias":"الهيئة العامة للعقار تُرخص 28 منصة عقارية إلكترونية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-01-01T07:43:56","NodeName":{"@Default":"الهيئة العامة للعقار تُرخص 28 منصة عقارية إلكترونية"},"SortOrder":"10","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-31T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1fa9f789-986c-4ba0-9b99-f89c281b699a\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">رخصّت الهيئة العامة للعقار 28 منصة عقارية إلكترونية برخصة فال للوساطة والتسويق العقاري للمنصات العقارية، وذلك بعد استيفائهم المتطلبات والشروط للحصول على الرخصة وأعمال الربط التقني مع الهيئة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأوضحت الهيئة أنّ المنصات العقارية الحاصلة على رخصة فال للوساطة والتسويق العقاري للمنصات العقارية حتى الآن هي: (عقار، سندك، سهيل، أماكن، بوابة العقار، وصلت، مفاتيح، مكتمل، دلالي، وتطبيق ديل، عقار ستي، صح، عقارك، ساعي، رايز، صكوك العقارية، أبواب، الدال، تمم، تداولكم العقارية، بيوت السعودية، عمار نون، شبكة عقار، خمسين خمسين، نافذة الرقمية، عقاراتكم العقارية، منون، ذكي التفاعلية).</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>وأكّدت \\\"الهيئة\\\" أنها مستمرة في أعمال الربط التقني لمزيد من المنصات العقارية، حيث إن حصول المنصة على الرخصة والربط التقني معها يضمن امتثالها للاشتراطات، ويرفع من كفاءة وجودة البيانات في قطاع العقار بالمملكة، وموثوقية الإعلانات وذلك لربطها مع بوابة النفاذ الوطني، مؤكدةً أنّ المنصات غير المرخصة سيتم ضبطها ومخالفتها.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأشارت إلى أنّ رخصة فال العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، كما يرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، ويحد من النزاعات العقارية، ويحفظ حقوق المتعاملين، ويرفع شفافية السوق العقاري.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>مما يُذكر أنّ الهيئة مستمرة في التزامها بتطوير التشريعات العقارية التي تضمن استقرار السوق العقاري، والرقابة وضبط المخالفين؛ مشددة على ضرورة الالتزام بالأنظمة، ومشيرةً إلى أنها تستقبل البلاغات التي ترد إليها عن المخالفات العقارية عبر منصة الهيئة أو بالاتصال</span><br><span>على الرقم الموحد&nbsp;(199011).</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُرخص 28 منصة عقارية إلكترونية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُرخص 28 منصة عقارية إلكترونية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5b7835bc-3fa4-352f-922d-85cf8f71e4c9","Alias":"الأستاذ عبدالعزيز بن محمد السبيعي","Path":"/4f611201-1937-4119-8a1b-445c0c1c7fee.config","Level":4010,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4f611201-1937-4119-8a1b-445c0c1c7fee.config","Node":{"Content":{"@Key":"4f611201-1937-4119-8a1b-445c0c1c7fee","@Alias":"الأستاذ عبدالعزيز بن محمد السبيعي","@Level":"4","Info":{"Parent":{"@Key":"1d910e48-371e-4392-8b05-a77b3939da64","#text":"مجلس الإدارة"},"Path":"////","Trashed":"false","ContentType":"director","CreateDate":"2024-03-12T22:49:00","NodeName":{"@Default":"الأستاذ عبدالعزيز بن محمد السبيعي","Name":[{"@Culture":"ar-jo","#text":"الأستاذ عبدالعزيز بن محمد السبيعي"},{"@Culture":"en-us","#text":"الأستاذ عبدالعزيز بن محمد السبيعي"}]},"SortOrder":"10","Published":{"@Defaul