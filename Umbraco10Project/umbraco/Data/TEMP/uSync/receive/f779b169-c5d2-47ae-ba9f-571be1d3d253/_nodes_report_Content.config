":"معرض سيريدو العقاري⁩"}},"shortBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>هيئة العقار تختتم مشاركتها في معرض سيريدو العقاري بجدة، بهدف استعراض أهم التشريعات والممكنات الداعمة لرفع جاذبية الاستثمارات العقارية في المملكة</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/b344c54614b749828fb26b4be8bc3c92"}},"startDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-05-14T00:00:00"}},"targetAudience":{"Value":{"@Culture":"ar-jo","#cdata-section":"العاملين بالقطاع العقاري "}},"title":{"Value":{"@Culture":"ar-jo","#cdata-section":"معرض سيريدو العقاري"}}}}},"IsRoot":true},{"Key":"e2985c67-fbca-3905-a8dc-485aea79925a","Alias":"الهيئة العامة للعقار تُحيل 92 وسيط عقاري للجهات المختصة","Path":"/b65899f7-8777-467a-9420-405360f2abee.config","Level":4026,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b65899f7-8777-467a-9420-405360f2abee.config","Node":{"Content":{"@Key":"b65899f7-8777-467a-9420-405360f2abee","@Alias":"الهيئة العامة للعقار تُحيل 92 وسيط عقاري للجهات المختصة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-21T11:31:00","NodeName":{"@Default":"الهيئة العامة للعقار تُحيل 92 وسيط عقاري للجهات المختصة"},"SortOrder":"26","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-08T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"42233863-7b7b-4f13-8889-48da5d5d63d0\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">باشرت الهيئة العامة للعقار عدد من البلاغات ، بالإضافة لعمليات تم رصدها ومتابعتها، حيث نتج عنها إحالة 92 وسيط عقاري للجهات المختصة وذلك لوجود حالات اشتباه لعمليات \\\"احتيال مالي\\\"، فيما يجري استكمال بقية الإجراءات النظامية على البلاغات المرصودة لإحالتها إلى الجهات المختصة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأكدت \\\"هيئة العقار\\\" أنها تعمل على الرقابة الإلكترونية الذي يستهدف القنوات الإلكترونية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة الرقمية، ومسار الاستجابة للبلاغات المقدمة عبر منصة الهيئة أو الاتصال على الرقم (199011)، بالإضافة إلى مسار فرق الرقابة الميدانية الخاصة بالهيئة التي تتحقق من نظامية عمل المُنشآت أو من نظامية اللوحات الإعلانية لعرض العقارات، وكذلك مسار حملات الرقابة التي تشارك فيها مع الجهات ذات العلاقة على مخالفات التوطين أو التستر أو نظامية مقار العمل.&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">ودعت \\\"هيئة العقار\\\" الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد \\\"نظام الوساطة العقارية\\\" وعدم مخالفته، والاطلاع على المخالفات تجنبًا للعقوبات، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، كما يرفع النظام جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويساهم في استدامة الأصول العقارية، والحد من النزاعات العقارية، وحفظ حقوق المتعاملين، ورفع شفافية السوق العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" الهيئة العامة للعقار تُحيل 92 وسيط عقاري للجهات المختصة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":" الهيئة العامة للعقار تُحيل 92 وسيط عقاري للجهات المختصة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"26263769-fac6-3c6e-ae57-9aba43a04bcf","Alias":"الهيئة العامة للعقار: توثيق 8 مليون عقد في منصة إيجار","Path":"/94a5c68b-f302-4529-babc-bad612f4ec65.config","Level":4027,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/94a5c68b-f302-4529-babc-bad612f4ec65.config","Node":{"Content":{"@Key":"94a5c68b-f302-4529-babc-bad612f4ec65","@Alias":"الهيئة العامة للعقار: توثيق 8 مليون عقد في منصة إيجار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-21T11:30:13","NodeName":{"@Default":"الهيئة العامة للعقار: توثيق 8 مليون عقد في منصة إيجار"},"SortOrder":"27","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-10T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a68ad568-7166-40d8-9dda-296f80cb3563\",\n    \"mediaKey\": \"b36c5d44-c850-40c3-a4bf-c1068c7722d6\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\">أعلنت الهيئة العامة للعقار أن العقود الإيجارية الموثقة في منصة \\\"إيجار\\\" تجاوزت الـ &nbsp;8 مليون عقد إيجاري منذ إطلاق \\\" إيجار\\\" إذ&nbsp; تجاوزت ، العقود السكنية الموثقة فيه الـ &nbsp;&nbsp;6.6<span>&nbsp;</span>&nbsp;مليون عقد إيجاري فيما تجاوزت العقود الإيجارية التجارية الموثقة فيه &nbsp;الـ &nbsp;1.3&nbsp;مليون عقد، ويُعد العام الحالي &nbsp;2023 &nbsp; الأعلى توثيقًا&nbsp; إذ تجاوزت العقود الإيجارية الموثقة فيه&nbsp; الـ 2.8 مليون عقد، فيما بلغ أعلى معدل يومي لتوثيق العقود 18 ألف عقد خلال يوم واحد.</p>\\n<p dir=\\\"RTL\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\">وأكدت \\\"هيئة العقار\\\" &nbsp;بأنَّ هذه الأرقام والتي تشهد تزايد متتابع تعكس ثقة القطاع العقاري في \\\"إيجار\\\" والخدمات ذات القيمة المضافة التي يقدمها، وتساهم في رفع مستوى الموثوقية في التعاملات العقارية في المملكة العربية السعودية، حيث أتاح \\\"إيجار\\\" للمتعاملين في قطاع الإيجار العقاري (المستأجر، والمؤجر، والوسيط العقاري) مستوى عالٍ من الشفافية للتعاملات العقارية منها: التحقق من الوثائق والصكوك، وبيانات أطراف العقد، بالتكامل مع الجهات الحكومية الشريكة، والتعامل مع وسيط عقاري مرخّص من الهيئة العامة للعقار، وتوثيق العقود عبر القنوات الرقمية واعتمادها لدى وزارة العدل، والمؤشر الإيجاري، واستخدام قنوات الدفع الإلكترونية في إيجار \\\"مدى\\\" و\\\"سداد\\\"؛ لتوثيق الدفعات المالية وإثباتها، والتكامل مع المنصات العقارية، مما يسهّل الرحلة الإيجارية، ويحفظ حقوق الأطراف قبل وأثناء العملية الإيجارية.</p>\\n<p dir=\\\"RTL\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\">من جهة أخرى أكدتْ الهيئة &nbsp;بأنَّ \\\"إيجار\\\" مكَّن المتعاملين من الاستفادة من خصائص نوعية تعزز الثقة بين الأطراف، وتحسّن من كفاءة التعاملات منها: المؤشر الإيجاري، الاستلام والتسليم، وحفظ مبلغ الضمان، وتقييم السلوك الإيجاري، وإمكانية سداد الدفعات جزئيًا، بالإضافة إلى فترات السداد المختلفة (سنوية، نصف سنوية، ربع سنوية، شهرية)، ووجود شراكات استراتيجية مع جهات خدمية أخرى، مكّنتهم من نقل الخدمات باسم المستخدم الفعلي للوحدة الإيجارية، مما أسهم في إثراء قطاع الإيجار العقاري، والتحفيز على الاستثمار فيه، وحفظ حقوق أطراف العملية الإيجارية.</p>\\n<p dir=\\\"RTL\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\">يُذكر أن \\\"إيجار\\\" يسعى دوماً لاستيعاب متطلبات قطاع الإيجار بشقيه السكني والتجاري ومواكبة متغيراته، بما يحفظ حقوق الأطراف ويحسن كفاءة التعاملات في قطاع الإيجار العقاري، وييسر الإجراءات، وعقد الشراكات الاستراتيجية والتكاملات الرقمية مع الجهات في القطاعين الحكومي والخاص.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: توثيق 8 مليون عقد في منصة إيجار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: توثيق 8 مليون عقد في منصة إيجار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"f3dc6603-fcea-3dc8-9b72-1ab846f33f81","Alias":"ملتقى القصيم العقاري","Path":"/a3fba18b-bb09-4a85-a828-64e546c06627.config","Level":4027,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a3fba18b-bb09-4a85-a828-64e546c06627.config","Node":{"Content":{"@Key":"a3fba18b-bb09-4a85-a828-64e546c06627","@Alias":"ملتقى القصيم العقاري","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2024-07-15T11:59:06","NodeName":{"@Default":"ملتقى القصيم العقاري","Name":{"@Culture":"ar-jo","#text":"ملتقى القصيم العقاري"}},"SortOrder":"27","Published":{"@Default":"true","Published":{"@Culture":"ar-jo","#text":"true"}},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":{"@Culture":"ar-jo","#cdata-section":"الهيئة العامة للعقار تشارك بجناح تعريفي وورش عمل لاستعراض التشريعات العقارية ودورها في تطوير القطاع ورفع جاذبيته الاستثمارية"}},"endDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-07-05T00:00:00"}},"eventBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>الهيئة العامة للعقار تشارك بجناح تعريفي وورش عمل لاستعراض التشريعات العقارية ودورها في تطوير القطاع ورفع جاذبيته الاستثمارية</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"eventLocation":{"Value":{"@Culture":"ar-jo","#cdata-section":"محافظة عن