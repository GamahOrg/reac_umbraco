ega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e034c088-3036-4167-9f55-950534fa4164.config","Node":{"Content":{"@Key":"e034c088-3036-4167-9f55-950534fa4164","@Alias":"بوابة العقار الجيومكانية","@Level":"3","Info":{"Parent":{"@Key":"75795868-cfb0-4021-a108-d26b070a39a4","#text":"الخدمات الإلكترونية"},"Path":"///","Trashed":"false","ContentType":"service","CreateDate":"2023-11-14T10:15:15","NodeName":{"@Default":"بوابة العقار الجيومكانية","Name":[{"@Culture":"ar-jo","#text":"بوابة العقار الجيومكانية"},{"@Culture":"en-us","#text":"Geospatial Real Estate Portal"}]},"SortOrder":"5","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go to Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بوابة العقار الجيومكانية هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الاهتمام"},{"@Culture":"en-us","#cdata-section":"The Geospatial Real Estate Portal is an electronic portal that shows important data about the real estate sector. It uses interactive maps to provide detailed information about regions, cities, neighborhoods, plots of land, and points of interest like schools, hospitals, and more"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"العقار\",\n  \"الجيومكانية\",\n  \"بوابة\",\n  \"بوابة العقار الجيومكانية\",\n  \"الهيئة العامة للعقار\",\n  \"الخدمات الالكترونية\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بوابة العقار الجيومكانية"},{"@Culture":"en-us","#cdata-section":"Geospatial Real Estate Portal"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بوابة العقار الجيومكانية"},{"@Culture":"en-us","#cdata-section":"Geospatial Real Estate Portal "}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>\\\"بوابة العقار الجيومكانية\\\" هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الاهتمام (التعليمية، الدينية، الصحية، مرافق الضيافة) ومشاريع البيع على الخارطة (وافي) ومكاتب الوساطة والمكاتب الهندسية المعتمدة في فرز الوحدات العقارية والمناطق العقارية المعلنة للتسجيل العيني للعقار، بالإضافة إلى خدمة البحث والاستعلام عن البيانات المكانية.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Geospatial Real Estate Portal is an electronic portal that shows important data about the real estate sector. It uses interactive maps to provide detailed information about regions, cities, neighborhoods, plots of land, and points of interest like schools, hospitals, and more. You can also find information about Wafi - Off-Plan Sales projects, brokerage offices, certified engineering offices, and real estate areas available for registration. Plus, you can search and inquire about spatial data right on the portal.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"985748c3-ac35-44b5-be35-4874eacaac58\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"بوابة العقار الجيومكانية\\\\\\\" هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الاهتمام (التعليمية، الدينية، الصحية، مرافق الضيافة) ومشاريع البيع على الخارطة (وافي) ومكاتب الوساطة والمكاتب الهندسية المعتمدة في فرز الوحدات العقارية والمناطق العقارية المعلنة للتسجيل العيني للعقار، بالإضافة إلى خدمة البحث والاستعلام عن البيانات المكانية.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"9eab370b-0970-4970-bbf9-b270317c653e\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Geospatial Real Estate Portal is an electronic portal that shows important data about the real estate sector. It uses interactive maps to provide detailed information about regions, cities, neighborhoods, plots of land, and points of interest like schools, hospitals, and more. You can also find information about Wafi - Off-Plan Sales projects, brokerage offices, certified engineering offices, and real estate areas available for registration. Plus, you can search and inquire about spatial data right on the portal.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"}]},"serviceIcon":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1c8cc781-eb89-46a2-a4c6-6698b721cab6\",\n    \"mediaKey\": \"6d0f20b0-e683-4151-8541-60953df9f4d3\"\n  }\n]"}},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4