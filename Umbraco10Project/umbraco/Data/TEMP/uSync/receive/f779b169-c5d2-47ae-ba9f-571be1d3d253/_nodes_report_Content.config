reateDate":"2023-11-23T16:58:17","NodeName":{"@Default":"الهيئة العامة للعقار تعقد ورش عمل التسجيل العيني للعقار","Name":[{"@Culture":"ar-jo","#text":"الهيئة العامة للعقار تعقد ورش عمل التسجيل العيني للعقار"},{"@Culture":"en-us","#text":"Event 4 (2)"}]},"SortOrder":"5","Published":{"@Default":"false","Published":[{"@Culture":"ar-jo","#text":"false"},{"@Culture":"en-us","#text":"false"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventsImages":{"Value":{"#cdata-section":""}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"6a8ecde0-6d00-3a98-9d0f-8a76a2f15c15","Alias":"\"هيئة العقار\" تدعو مُلاك العقارات في (7) أحياء بالرياض إلى سرعة تسجيل عقاراتهم في \"السجل العقاري\"","Path":"/4c77cfe9-3b9a-44d9-9795-afac400d6c91.config","Level":4006,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4c77cfe9-3b9a-44d9-9795-afac400d6c91.config","Node":{"Content":{"@Key":"4c77cfe9-3b9a-44d9-9795-afac400d6c91","@Alias":"\"هيئة العقار\" تدعو مُلاك العقارات في (7) أحياء بالرياض إلى سرعة تسجيل عقاراتهم في \"السجل العقاري\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-01-25T10:34:16","NodeName":{"@Default":"\"هيئة العقار\" تدعو مُلاك العقارات في (7) أحياء بالرياض إلى سرعة تسجيل عقاراتهم في \"السجل العقاري\""},"SortOrder":"6","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-01-25T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"00ffa397-102e-4b9f-b046-ff38a8c6f626\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\">دعت الهيئة العامة للعقار ملاك العقارات في أحياء: (الغدير، النفل، الوادي، المروج، المصيف، التعاون، الازدهار) بمدنية الرياض إلى تسجيل سرعة عقاراتهم في \\\"السجل العقاري\\\"، حيث تنتهي مدة التسجيل فيها يوم الاثنين القادم 17 رجب&nbsp; <span class=\\\"apple-converted-space\\\"><u>1445</u></span><u> هـ</u><span class=\\\"apple-converted-space\\\">&nbsp;</span><span> </span></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\"> موافق </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\"><u><span>29</span></u></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\"><u> يناير</u></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\"> 2024م.&nbsp;</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\"><span class=\\\"apple-converted-space\\\">&nbsp;</span><span></span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\"></span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span data-ogsc=\\\"black\\\" data-ogsb=\\\"white\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة العامة للعقار أن التسجيل&nbsp; الأول للعقارات في هذه المرحلة يتم عن طريق <a href=\\\"https://rer.sa/rer-services-ar\\\" title=\\\"https://rer.sa/rer-services-ar\\\">منصة السجل الإلكتروني</a> ويتعين على ملاك العقارات </span></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">العقارية والتجارية وغيرها في الأحياء السبعة&nbsp; تقديم طلب التسجيل العيني الأول، مرفقاً به المستندات المطلوبة المثبتة للعقار ( صك إلكتروني صادر من وزارة العدل مكتمل البيانات مستوفٍ لشروط الملكية&nbsp; وهوبة سارية ووكالة في حال كان مقدم طلب وكيل للمالك ) .</span><span class=\\\"apple-converted-space\\\"><span>&nbsp;</span></span><span style=\\\"font-size: 11.0pt; font-family: 'Calibri',sans-serif; color: black;\\\"><a href=\\\"https://rer.sa/rer-services-ar\\\" data-linkindex=\\\"0\\\"></a></span><span data-ogsc=\\\"black\\\" data-ogsb=\\\"white\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\"></span></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\"></span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span data-ogsc=\\\"black\\\" data-ogsb=\\\"white\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; background: white;\\\" lang=\\\"AR-SA\\\">فيما أكدت الهيئة بأن&nbsp; عمليات التسجيل في السجل العقاري مستمرة في&nbsp;</span></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\"> (54 حي) في مدينة الرياض، وحي واحد في كل من الدمام&nbsp; والمدنية المنورة حتى 18 رمضان 1445هـ موافق&nbsp; <u><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\">28</span></u><u> مارس</u><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\"></span></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">2024م، وتشمل أحياء الرياض التالية : ( حي الملك سلمان، البساتين، التضامن، الزاهر، الرسالة، الراية، العلا، المشرق ، الخير ، العارض، النرجس، القيروان، الياسمين، الملقا، الصحافة، الندى، الربيع، العقيق، حطين، النخيل، المحمدية، الملك فهد، الربيع، الرحمانية، الرائد، جامعة الملك سعود، المرسلات ، المغرزات، </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">النزهة، الملك عبدالله، الروضة، القدس، الحمراء، الشهداء، قرطبة، جامعة الامام محمد بن سعود، الاندلس، الملك فيصل، غرناطة ، النهضة، الخليج ، اشبيلية، اليرموك ، المونسية، المعيزيلة ،القادسية، الحزم، الزهرة، السويدية الغربية، العريجاء ، العريجاء الغربي، العوالي، حقيبة ظهر ، لبن ) ، وحي الشعلة في مدينة الدم ، وحي العاقول في المدينة المنورة .</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\"></span><span class=\\\"apple-converted-space\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\">&nbsp;</span></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\"></span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنه يمكن لملاك العقارات في هذه الأحياء تسجيل عقاراتهم عبر منصة السجل العقاري أو زيارة لـ \\\"مراكز خدمة مستفيدي السجل\\\" في رويال مول بمدينة الرياض وفي \\\"البوابة الاقتصادية\\\" في مدينة الدمام، و\\\"مركز خدمة العملاء لأمانة المدينة المنورة\\\" في المدينة المنورة خلال أيام العمل من الساعة التاسعة صباحًا حتى الخامسة مساءً، حيث تم تجهيز هذه المراكز لتقديم الدعم للمستفيدين في تسجيل عقاراتهم، ومساعدتهم على استخدام الخدمات الإلكترونية من خلال أجهزة الخدمة الذاتية في المركز، إضافة إلى الرقم الموحد للاستفسارات 199002 الذي تم تخصيصه للإجابة على أي استفسار أو متابعة الطلبات، ولتسهيل عملية التسجيل يمكن للمستفيدين من مراكز خدمة العملاء حجزموعد عن طريق الموقع الإلكتروني الرسمي <a href=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex\\\" title=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex\\\">&nbsp;للسجل العقاري </a></span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex%C2%A0%20.#https://bookmyappointment.rer.sa/ar/AppointmentIndex%C2%A0%20.\\\" title=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex .\\\" data-linkindex=\\\"1\\\"><span style=\\\"color: windowtext; text-decoration: none; text-underline: none;\\\" lang=\\\"EN-US\\\"><span data-ogsc=\\\"windowtext\\\">&nbsp;.</span></span></a></span><span>&nbsp;</span><span>&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex%C2%A0%20.#https://bookmyappointment.rer.sa/ar/AppointmentIndex%C2%A0%20.\\\" title=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex .\\\" data-linkindex=\\\"1\\\"><span style=\\\"color: windowtext; text-decoration: none; text-underline: none;\\\" lang=\\\"EN-US\\\"><span data-ogsc=\\\"windowtext\\\"></span></span></a></span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة، بأن السجل العقاري هو نظام لتوثيق العقارات ويعتمد على الوحدة العقارية كأساس لتسجيل الملكية والتصرفات والحقوق العقارية الأخرى المترتبة على العقار، وذلك بإصدار وثيقة تشمل على رقم العقار واسم مالكه واوصافه من حيث نوعه وموقعه الجغرافي كإحداثيات مرتبطه&nbsp; بالبيانات الجيومكانية، ومساحته وحدوده وأبعاده والعقارات المجاورة له،&nbsp; وما له من حقوق وما عليه من التزامات وما يطرأ عليه من تغيير أو تصرفات وما يترتب عليه من حقوق للغير.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تدعو مُلاك العقارات في (7) أحياء بالرياض إلى سرعة تسجيل عقاراتهم في \"السجل العقاري\""}},"pageName":{"Value":{"#cdata-section":"\"هيئة العقار\" تدعو مُلاك العقارات في (7) أحياء بالرياض إلى سرعة تسجيل عقاراتهم في \"السجل العقاري\""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":"\"هيئة العقار\" تدعو مُلاك العقارات في (7) أحياء بالرياض إلى سرعة تسجيل عقاراتهم في \"السجل العقاري\""}}}}},"IsRoot":true},{"Key":"d538fda8-9857-3562-a8d9-0912d9d1f274","Alias":"الأستاذ راكان بن عبدالله آل الشيخ","Path":"/defd296c-af33-45da-9d04-ef03d1f2817c.config","Level":4006,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/defd296c-af33-45da-9d04-ef03d1f2817c.config","Node":{"Content":{"@Key":"defd296c-af33-45da-9d04-ef03d1f2817c","@Alias":"الأستاذ راكان بن عبدالله آل الشيخ","@Level":"4","Info":{"Parent":{"@Key":"1d910e48-371e-4392-8b05-a77b3939da64","#text":"مجلس الإدارة"},"Path":"////","Trashed":"false","ContentType":"director","CreateDate":"2024-03-12T22:40:10","NodeName":{"@Default":"الأستاذ راكان بن عبدالله آل الشيخ","Name":[{"@Culture":"ar-jo","#text":"الأستاذ راكان بن عبدالله آل الشيخ"},{"@Culture":"en-us","#text":"الأستاذ راكان بن عبدالله آل الشيخ"}]},"SortOrder":"6","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":null},"Properties":{"directorName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأستاذ راكان بن عبدالله آل الشيخ"},{"@Culture":"en-us","#cdata-section":"الأستاذ راكان بن عبدالله آل الشيخ"}]},"personalImage":{"Value":{"#cdata