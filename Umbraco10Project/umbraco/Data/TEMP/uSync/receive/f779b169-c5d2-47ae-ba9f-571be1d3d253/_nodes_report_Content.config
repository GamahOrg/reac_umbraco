d549c2b99e522a10db9d05,umb://document/2ce40610a6fb49dd9eb12a576fd33d03"}},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"The Real Estate General Authority (REGA) was created in 2017 with the aim of regulating, overseeing, and promoting non-governmental real estate activities. Its main goal is to attract investments to the real estate sector while aligning with the comprehensive strategy of the sector."}]},"enableNewsLetter":{"Value":{"#cdata-section":"1"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"headerImage":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"fe030622-3b5c-465b-bcf6-345be51f2401\",\n    \"mediaKey\": \"9eb4d92c-16b1-4d8d-ab75-a86d8447f424\"\n  }\n]"}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"Rega\",\n  \"الهيئة العامة للعقار\"\n]"}},"linkButton":{"Value":{"#cdata-section":"umb://document/18ba0e1000a941abbcd98f60a65ef8d8"}},"mailingList":{"Value":{"#cdata-section":"[\n  {\n    \"workspaceKey\": \"00000000-0000-0000-0000-000000000000\",\n    \"mailingListKey\": \"00000000-0000-0000-0000-000000000000\"\n  }\n]"}},"newsLetterBreif":{"Value":[{"@Culture":"ar-jo","#cdata-section":"كن على إستعداد لمتابعة كافة الاخبار عن الهيئة ,والضوابط العقارية المستقبلية. قم بإدخال بريدك الإليكتروني ليصلك كل جديد"},{"@Culture":"en-us","#cdata-section":"Be prepared to follow all the news about REGA and future regulations. Enter your email to keep updated"}]},"newsLetterTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"القائمة البريدية"},{"@Culture":"en-us","#cdata-section":"Mailing List"}]},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"Real Estate General Authority"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"Real Estate General Authority"}]},"realEstateMainTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"Real Estate General Authority"}]},"searchCenterBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"انتقل عبر منصتنا للتأكد من شرعية الإعلانات العقارية، والوصول إلى تفاصيل الترخيص، ودعم الامتثال التنظيمي لبيئة سوق آمنة."},{"@Culture":"en-us","#cdata-section":"Navigate through our platform to verify the legitimacy of real estate listings, access licensing details, and support regulatory compliance for a secure market environment."}]},"searchCenterEnable":{"Value":{"#cdata-section":"1"}},"searchCenterTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"خدمة الاستعلامات العقارية"},{"@Culture":"en-us","#cdata-section":"Real Estate Inquiry Service"}]},"sectionBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تأسست الهيئة العامة للعقار عام 2017 لتنظيم النشاط العقاري غير الحكومي، والإشراف عليه، وتطويره بهدف تعزيز وتشجيع الاستثمار في القطاع العقاري، وتحقيق مستهدفات الاستراتيجية الشاملة للقطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Real Estate General Authority (REGA) was created in 2017 with the aim of regulating, overseeing, and promoting non-governmental real estate activities. Its main goal is to attract investments to the real estate sector while aligning with the comprehensive strategy of the sector.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"statisticsButtonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المزيد عن الإحصائيات"},{"@Culture":"en-us","#cdata-section":"Explore  more  about  open Data"}]},"statisticsImage":{"Value":{"#cdata-section":"[\n  {\n    \"key\