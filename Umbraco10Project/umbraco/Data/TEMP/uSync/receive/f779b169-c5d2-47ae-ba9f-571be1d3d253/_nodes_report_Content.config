Culture":"en-us","#cdata-section":"2023-03-10T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>يهدف المعرض إلى تسليط الضوء على دور القطاع العقاري في التأثير على جهود تنويع مصادر الاستثمار كأحد أهم أهداف رؤية المملكة 2030. كما ينقل التطورات في القطاع العقاري السعودي في المشاريع السكنية والتجارية متعددة الاستخدامات وتوجهاتها.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>يهدف المعرض إلى تسليط الضوء على دور القطاع العقاري في التأثير على جهود تنويع مصادر الاستثمار كأحد أهم أهداف رؤية المملكة 2030. كما ينقل التطورات في القطاع العقاري السعودي في المشاريع السكنية والتجارية متعددة الاستخدامات وتوجهاتها.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - معارض الرياض"},{"@Culture":"en-us","#cdata-section":"الرياض - معارض الرياض"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"416650f1-1cf9-465f-bbad-57e23c2ac06c\",\n    \"mediaKey\": \"f5c82572-3acd-49a2-80a8-5ab2fb3bd587\"\n  },\n  {\n    \"key\": \"a9168809-c5e4-4bc0-a37f-971327b5f88a\",\n    \"mediaKey\": \"a9e9d811-07b5-4de3-bc84-5d579fbcd867\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض ريستاتكس الرياض"},{"@Culture":"en-us","#cdata-section":"معرض ريستاتكس الرياض"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض ريستاتكس الرياض"},{"@Culture":"en-us","#cdata-section":"معرض ريستاتكس الرياض"}]},"shortBrief":{"Value":[{"@