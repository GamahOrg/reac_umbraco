":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":"رئيس هيئة العقار:  نستهدف فتح أسواق جديدة تساهم في تنويع مصادر دخل الاقتصاد الوطني و تدعم الابتكار من خلال التقنيات العقارية"},"SortOrder":"32","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-07T16:05:58"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\">&nbsp;أكد رئيس الهيئة العامة للعقار م. عبد الله بن سعود الحمَّاد بأنَّ إطلاق بروبتك السعودية يمثل نقلة جديدة للقطاع العقاري للاستفادة من التقنيات العقاري في تقديم المنتجات والخدمات وتحسين رحلة المستفيد، وأضاف بأنَّ الهيئة وانطلاقًا من دورها تنظيم القطاع العقاري تستهدف من خلال تنظيم المعارض والمؤتمرات المتخصصة تحفيز الأنشطة العقارية وتشجيع المستثمرين لتطوير السوق العقاري السعودي وإثرائه بالتجارب والممارسات الدولية المتميزة والتي تساعد على تطوير البيئة التنافسية وتعزيز جاذبية السوق. </span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\">وعن أهداف بروبتك السعودية أوضح الحمَّاد بأنّ \"بروبتك\" والتي تعني دمج التقنية بالعقار هي اتجاه حديث في القطاع العقاري على المستويين الدولي والمحلي ، ونسعى من خلال إلقاء الضوء على أحدث ما وصلت له هذه الصناعة إلى تعزيز الاستثمار في التقنيات العقارية ،وتوفير بيئة استثمارية مناسبة للنمو، ودعم الابتكار، والاستفادة من الإمكانات القوية والمحفزات الاستثمارية التي يتمتع بها الاقتصاد الوطني، حيث أنَّ تبني منهجيات التقنية العقارية وتحفيز الشركات لانتهاجها يشكل نقلة في آلية تطوير السوق العقاري والوصول به إلى مستوى متقدم من فهم احتياجات المستفيدين، &nbsp;وبالتالي رفع كفاءته وقدراته للمساهمة في حجم المحتوى المحلي من جهة، ورفع مساهمته في الناتج المحلي غير النفطي من جهة أخرى، وأضاف بأنَّ الهيئة العامة للعقار معنية بتمكين مشاريع التقنية العقارية من خلال التشريعات العقارية والأنظمة في القطاع العقاري وتضمينها بما يدعم التحول الرقمي، ووفق الاستراتيجيات التي تعمل عليها الهيئة نستهدف فتح أسواق جديدة تساهم في تنويع مصادر دخل الاقتصاد الوطني من خلال التقنيات العقارية .</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\">وقال الحمّاد بأنَّ التقنية العقارية بأفقها الواسع وتعدد مشاريعها وازدياد الحاجة لها كجزء من جودة الحياة هي مكمن فرص الاستثمار العقاري في المستقبل القريب، ويدعم نموهها كافة استراتيجيات البحث العلمي والابتكار واستراتيجيات التحول الرقمي وتقنية المعلومات وتطوير التشريعات والأنظمة العقارية، وأنَّ التقنية العقارية أصبحت مكونًا رئيسيًا في كافة المشاريع والاستثمارات العقارية القادمة والتي ستحدث فارقًا ملحوظًا في تنمية الحياة الاجتماعية والاقتصادية بالمملكة.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\">وأكد م. عبد الله الحماد بأنّ الهيئة حرصتْ على أنّ يكون هذا الحدث \" بروبتك السعودية \"حدثًا نوعيًا من خلال استقطاب عدد من المبتكرين و المتحدثين والخبراء الدوليين في هذا المجال واستضافة تجارب دولية مميزة للقطاع الحكومي والقطاع الخاص متمثلة في عرض تجربة الحكومة الأسترالية في التقنيات العقارية وتجربة هونغ كونغ ومنطقة البحر الصيني في رحلة الابتكار التقني العقاري إضافة إلى تجربة توظيف التقنية في العقار في السوق الأوروبي بالإضافة إلى عرض التجارب والممارسات التي قدمتها المنصات العقارية والشركات المحلية والدولية. </span></p>"}},"newsTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار:  نستهدف فتح أسواق جديدة تساهم في تنويع مصادر دخل الاقتصاد الوطني و تدعم الابتكار من خلال التقنيات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار:  نستهدف فتح أسواق جديدة تساهم في تنويع مصادر دخل الاقتصاد الوطني و تدعم الابتكار من خلال التقنيات العقارية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"6cfbc4ee-109a-327e-b4ff-ebdff49ce102","Alias":" الهيئة العامة للعقار تختم فعاليات \"بروبتك السعودية\"","Path":"/b5b87aa2-4986-4b65-bd1e-ce8586dc751b.config","Level":4033,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b5b87aa2-4986-4b65-bd1e-ce8586dc751b.config","Node":{"Content":{"@Key":"b5b87aa2-4986-4b65-bd1e-ce8586dc751b","@Alias":" الهيئة العامة للعقار تختم فعاليات \"بروبتك السعودية\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":" الهيئة العامة للعقار تختم فعاليات \"بروبتك السعودية\""},"SortOrder":"33","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-08T17:09:13"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla';\">اختتمت الهيئة العامة للعقار , مساء أمس , فعاليات مؤتمر \"بروبتك السعودية\"، الذي جرت أعماله في الرياض خلال الفترة 6 - 7 نوفمبر، بمشاركة دولية واسعة من مختلف أنحاء العالم</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\">.<br></span><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla';\">وجرى خلال مؤتمر \"بروبتك السعودية\" الإعلان عن تقرير التقنية العقارية، وإطلاق منصة المؤشرات العقارية، وإطلاق منصة السجل العقاري، وإبرام عدد من الاتفاقيات مع شركات الاستثمار الأجنبي من أوروبا وأمريكا وشرق آسيا، بتواجد أكثر من 20 صندوقاً استثمارياً محلياً ودولياً، إضافة إلى افتتاح المعرض التقني المصاحب الذي ضم أكثر من 50 جناحاً يمثلون 25 دولة، وشارك فيه الجهات الحكومية المُشرِعة والممكنة في القطاع العقاري إضافة إلى شركات عقارية وتقنية، وشركات ناشئة في التطوير العقاري والبناء، وتطبيقات عقارية، وشركات استثمارية</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\"><br></span><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla';\">وجمع مؤتمر \"بروبتك السعودية\" بنسخته الأولى ثلاثة محاور رئيسية؛ تتمثل في المنظومة العقارية التقنية التي تشمل الجهات الحكومية المُشرعة للقطاع العقاري والداعمة للمشاريع الناشئة، والمطورين العقارين، والمنصات العقارية، والشركات الناشئة والتقنية العقارية، وشركات الاستثمارالجريء، ومسرعات الأعمال، مع محور التطبيقات العقارية؛ والتجارية، والسكنية، والسياحية، واللوجستية بالإضافة إلى محور الحلول التقنية المتمثل في إدارةالأملاك، وإدارة المرافق، والذكاء الاصطناعي وتحليل البيانات، والواقع الافتراضي والمعزز، وتقنيات التمويل والرهن العقاري، وإنترنت الأشياء، وتقنيات البناء</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\"><br></span><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla';\">وشارك المتحدثون بالجلسات الحوارية وورش العمل عن مفهوم التقنية العقارية في السعودية، ودور الاستثمار فيها، والتحديات والفرص في الاستثمار الجريء في السعودية، ودور التقنية في تطوير وتفعيل السياسات العامة، وتمكين القطاع العقاري في المستقبل، وابتكارات البيئة الحضرية، وتأثير تطوير المدن الذكية على القطاع العقاري من خلال المعلومات وآلية اتخاذ القرار، وبناء ميزة تنافسية للشركات العقارية، وتطبيق حلول تقنية مبتكرة لجمع وتحليل البيانات، وبناء الشركات الناشئة في قطاع التقنية العقارية، وأحدث تقنيات البناء المعاصرة، بالإضافة إلى استعراض عدة تجارب دولية في هذا المجال منها: تجربة توظيف التقنية في العقار بالسوق الأوروبي، والتجربة التقنية العقارية في هونغ كونغ ومنطقة البحر الصيني</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\">.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":" الهيئة العامة للعقار تختم فعاليات \"بروبتك السعودية\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":" الهيئة العامة للعقار تختم فعاليات \"بروبتك السعودية\""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"4710f8f5-2555-3ea2-b403-cb4c40acc925","Alias":"القمة العالمية للبروبتك","Path":"/0443aeae-a929-4a07-a156-95e938302549.config","Level":4033,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/0443aeae-a929-4a07-a156-95e938302549.config","Node":{"Content":{"@Key":"0443aeae-a929-4a07-a156-95e938302549","@Alias":"القمة العالمية للبروبتك","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2024-12-08T13:40:54","NodeName":{"@Default":"القمة العالمية للبروبتك","Name":{"@Culture":"ar-jo","#text":"القمة العالمية للبروبتك"}},"SortOrder":"33","Published":{"@Default":"true","Published":{"@Culture":"ar-jo","#text":"true"}},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":{"@Culture":"ar-jo","#cdata-section":"القمة العالمية للبروبتك تعزيز التحوُّل الرقمي في القطاع العقاري"}},"endDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-10-28T00:00:00"}},"eventBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>القمة العالمية للبروبتك تعزيز التحوُّل الرقمي في القطاع العقاري</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"eventLocation":{"Value":{"@Culture":"ar-jo","#cdata-section":"موفنبيك الغدير "}},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"d5626139-8ce7-423f-a70b-28bd644c53ac\",\n    \"mediaKey\": \"a69406bc-04a2-468f-8199-f8165a16dfef\"\n  },\n  {\n    \"key\": \"9ac13eb3-a7d4-425a-9430-f28e1ced6f9e\",\n    \"mediaKey\": \"1a6d6b8c-7fdd-49af-b8f5-3be45cb9ef77\"\n  }\n]"}},"eventTitle":{"Value":{"@Culture":"ar-jo","#cdata-section":"القمة العالمية للبروبتك "}},"eventType":{"Value":{"@Culture":"ar-jo","#cdata-section":"حدث محلي "}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"بروبتك\"\n]"}},"pageName":{"Value":{"@Culture":"ar-jo","#cdata-section":"القمة العالمية للبروبتك "}},"pageTitle":{"Value":{"@Culture":"ar-jo","#cdata-section":"القمة العالمية للبروبتك "}},"shortBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>القمة العالمية للبروبتك تعزيز التحوُّل الرقمي في القطاع العقاري</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-10-27T00:00:00"}},"targetAudience":{"Value":{"@Culture":"ar-jo","#cdata-section":"المهتمين بمجال التقنية العقارية "}},"title":{"Value":{"@Culture":"ar-jo","#cdata-section":"القمة العالمية للبروبتك "}}}}},"IsRoot":true},{"Key":"bfde1cad-2abc-3f1b-8cae-3ec17947d7eb","Alias":"الرياض تحتضن معرض مسكن العقاري النسخة الثانية في ديسمبر المقبل","Path":"/2c10bd5b-84c0-4e0b-8a77-76a4815af63c.config","Level":4034,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2c10bd5b-84c0-4e0b-8a77-76a4815af63c.config","Node":{"Content":{"@Key":"2c10bd5b-84c0-4e0b-8a77-76a4815af63c","@Alias":"الرياض تحتضن معرض مسكن العقاري النسخة الثانية في ديسمبر المقبل","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":"الرياض تحتضن معرض مسكن العقاري النسخة الثانية في ديسمبر المقبل"},"SortOrder":"34","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-08T17:10:31"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"MsoNormal\"><span style=\"font-family: 'Sakkal Majalla';\" lang=\"AR-SA\">تحتضن العاصمة الرياض خلال الفترة 7 - 9 ديسمبر المقبل النسخة الثانية من معرض مسكن, الذي يقام برعاية الهيئة العامة للعقار بالتعاون مع وزارة الشؤون البلدية والقروية والإسكان، بمشاركة عدد من الجهات الحكومية وشركات التطوير العقاري والقنوات التمويلية</span><span style=\"font-family: 'Sakkal Majalla';\">.</span></p>\n<p style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"MsoNormal\"><span style=\"font-family: 'Sakkal Majalla';\"><br /></span><span style=\"font-family: 'Sakkal Majalla';\" lang=\"AR-SA\">ويهدف المعرض إلى توفير رحلة متكاملة للمستفيد في تملك الوحدات السكنية المتنوعة وإمكانية اختيار وتملك الوحدة السكنية مباشرةً داخل المعرض، وتوفير عروض سكنية وتمويلية خاصة في معرض مسكن العقاري، وتقديم الاستشارات الهندسية المجانية اللازمة للزوار من قبل الشركات الهندسية المشاركة في المعرض، ومعرفة المستجدات في تقنيات وأساليب البناء الحديثة في مجال البناء والتشييد وآخر ما توصلت له بما يخدم المستفيدين من طالبي المساكن من الأسر السعودية والزوار، بهدف زيادة المعروض العقاري ورفع نسبة التملك السكني</span><span style=\"font-family: 'Sakkal Majalla';\">.<br /></span><span style=\"font-family: 'Sakkal Majalla';\" lang=\"AR-SA\">يُذكر أنّ المعرض وما يصاحبه من فعاليات وإطلاقات جديدة يأتي امتدادًا للجهود التي تعمل عليها القطاعات الحكومية ذات العلاقة بالشراكة مع القطاع الخاص لتحقيق مستهدفات برنامج الإسكان - أحد برامج رؤية المملكة 2030 - لرفع نسبة التملك للمساكن، كما يسهم في تطوير القطاع العقاري وطرح أفضل الحلول السكنية والتمويلية، والإسهام في تحقيق تجربة سكنية متميزة ومتكاملة للأسر السعودية</span><span style=\"font-family: 'Sakkal Majalla';\">.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الرياض تحتضن معرض مسكن العقاري النسخة الثانية في ديسمبر المقبل"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الرياض تحتضن معرض مسكن العقاري النسخة الثانية في ديسمبر المقبل"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ef5268a9-63c0-3cf9-bea0-47e62087d738","Alias":"\"هيئة العقار “: يناير يبدأ استقبال طلبات ترخيص المساهمات العقارية","Path":"/1cd59bbc-a4ed-437c-b9be-65a61c054153.config","Level":4035,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1cd59bbc-a4ed-437c-b9be-65a61c054153.config","Node":{"Content":{"@Key":"1cd59bbc-a4ed-437c-b9be-65a61c054153","@Alias":"\"هيئة العقار “: يناير يبدأ استقبال طلبات ترخيص المساهمات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":"\"هيئة العقار “: يناير يبدأ استقبال طلبات ترخيص المساهمات العقارية"},"SortOrder":"35","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-16T18:47:05"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\">دعت الهيئة العامة للعقار كافة الجهات الحكومية والقطاع الخاص والمهتمين بالشأن العقاري إلى إبداء مرئياتهم وملحوظاتهم على مسودة اللائحة التنفيذية لنظام المساهمات العقارية والمنشورة في منصة &ldquo;استطلاع&rdquo; قبل إقرارها والمتبقي على انتهاء فترة إبداء المرئيات حولها أربعة أيام، حيث ينتهي الاستطلاع بتاريخ 20 نوفمبر 2023م ، مؤكدة بأنَّ الهيئة ستبدأ باستقبال طلبات الترخيص للمساهمات العقارية في يناير القادم ، وسيتم الإعلان عن آلية تقديم الطلبات عبر المنصة الإلكترونية المخصصة لذلك.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\">وأوضحت الهيئة بأنّ مسودة &ldquo;اللائحة التنفيذية لنظام المساهمات العقارية&rdquo; تتضمن ستة وثلاثين مادة اشتملت على : التعريفات ، تصنيف المساهمات العقارية حسب الحجم &nbsp;، تصنيف المطورين العقاريين حسب القدرات &nbsp;، شروط ترخيص المساهمات العقارية ، إجراءات ترخيص المساهمة العقارية ، آلية طرح المساهمة العقارية وفق تعليمات هيئة السوق المالية ، الوثائق اللازمة عند طلب ترخيص للمساهمة العقارية من الهيئة العامة للعقار ، مكونات نموذج اتفاقية المساهمة العقارية بين المطور العقاري والمساهمين ، آلية موافقة الهيئة على طلب الترخيص ، مكونات الترخيص الصادر من هيئة العقار بعد استكمال كافة المتطلبات ، آلية تعديل الترخيص ، أحكام رأس مال المساهمة العقارية ، آلية الاشتراك في المساهمة العقارية ، شروط الاشتراك في المساهمة العقارية بحصة عينية من العقار ، اقتراض المطور العقاري لصالح المساهمة العقارية ، نسبة المطور العقاري في المساهمة العقارية ، ممارسي نشاط المساهمات العقارية واختصاصاتهم والتزاماتهم ، اختصاصات جمعية المساهمين وآلية حضور الاجتماعات &nbsp;، إجراءات الرقابة والتفتيش والضبط من قبل هيئة العقار ، ومكونات محضر ضبط المخالفات .</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\">وأكدت الهيئة العامة للعقار أنّ نظام المساهمات العقارية يعُد أحد التشريعات العقارية التي تساهم في تنظيم نشاط المساهمات العقارية ، ورفع مستوى الشفافية والإفصاح ،وحماية حقوق جميع أطراف المساهمة العقارية ، وحوكمة المساهمات العقارية وتنظيمها وأتمتها، كما سيساهم النظام والعمل به في زيادة المعروض من المنتجات العقارية التجارية والسكنية ، زيادة قنوات التمويل للمطورين العقاريين، والقنوات الاستثمارية للراغبين في الاستثمار ، وتعزيز ثقة المستثمرين في القطاع العقاري في المملكة ، والقضاء على المساهمات العقارية العشوائية وغير النظامية وحوكمة أعمال الرقابة والامتثال ، &nbsp;وخلق فرص استثمارية واعدة للمُنشآت الصغيرة والمتوسطة في السوق العقاري ، واستدامة نشاط التطوير العقاري وفتح فرص عمل في هذا النشاط.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\">يُذكر بأنّ نشر اللائحة التنفيذية للمساهمات العقارية وغيرها من اللوائح والتنظيمات في منصة \" استطلاع \" قبل إقرارها يأتي بهدف تمكين الأفراد والجهات الحكومية والقطاع الخاص وذوي العلاقة من إبداء المرئيات والملحوظات على المشروعات ذات الصلة بالشؤون الاقتصادية والتنموية، مما يسهم في توفير بيئة استثمارية آمنة ومستقرة، وتحسين شفافية وكفاءة البيئة التشريعية، وذلك من خلال مشاركة القطاع العام والقطاع الخاص والعُموم في عملية بناء التشريعات والاستفادة من المرئيات الواردة على المشروعات قبل اعتمادها، ويمكن الاطلاع على مسودة اللائحة التنفيذية للمساهمات العقارية عبر الرابط </span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"mso-fareast-font-family: 'Times New Roman';\"><a href=\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Implementing/Pages/default.aspx\"><span dir=\"LTR\" lang=\"EN-US\">https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Implementing/Pages/default.aspx</span></a></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار “: يناير يبدأ استقبال طلبات ترخيص المساهمات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"هيئة العقار “: يناير يبدأ استقبال طلبات ترخيص المساهمات العقارية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9e885ae4-e02d-30ba-83ca-1e673e3e38eb","Alias":"\"الهيئة العامة للعقار تختم مشاركتها في معرض\"سيتي سكيب البحرين 2023","Path":"/a9666f3f-1017-4eea-929f-f8add29d1236.config","Level":4036,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a9666f3f-1017-4eea-929f-f8add29d1236.config","Node":{"Content":{"@Key":"a9666f3f-1017-4eea-929f-f8add29d1236","@Alias":"\"الهيئة العامة للعقار تختم مشاركتها في معرض\"سيتي سكيب البحرين 2023","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":"\"الهيئة العامة للعقار تختم مشاركتها في معرض\"سيتي سكيب البحرين 2023"},"SortOrder":"36","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-19T13:53:47"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\">اختتمت الهيئة العامة للعقار مشاركتها في معرض \"سيتي سكيب البحرين 2023م\"، الذي أقيم خلال الفترة من 14 - 18 نوفمبر الجاري، برعاية وحضور صاحب السمو الملكي الأمير سلمان بن حمد آل خليفة ولي عهد مملكة البحرين، وبمشاركة نخبة من المتحدثين والخبراء والمهتمين بالقطاع العقاري، والمطورين العقاريين الدوليين، والمهتمين بشراء الوحدات العقارية، تحت شعار \"الاستدامة والتحول الرقمي في قطاع العقارات</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">\".</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">واستعرضت الهيئة خلال مشاركتها بجناح في معرض \"سيتي سكيب البحرين 2023م\" منظومة التشريعات العقارية التي أصدرتها وهي \"نظام الوساطة العقارية\"، ونظام التسجيل العيني للعقار، إضافةً إلى الأنشطة التي تأتي تحت تنظيم الهيئة وتشمل (لجنة البيع على الخارطة \"وافي\")</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وشارك الأمين العام للجنة البيع والتأجير على الخارطة \"وافي\" نايف الشريف بجلسة حوارية بعنوان (تجربة البيع والتأجير على الخارطة بالسعودية)، كما شارك المدير العام للاتصال الاستراتيجي بالهيئة تيسير المفرج بجلسة حوارية بعنوان (أهمية التشريعات العقارية في تطوير القطاع العقاري)</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وجاءت مشاركة الهيئة العامة للعقار في معرض \"سيتي سكيب البحرين 2023م\" ضمن دورها في التسجيل العيني للعقار وتنظيم القطاع العقاري غير الحكومي ونشر الوعي بأنظمة القطاع وأنشطته، لتعزيز حوكمة القطاع، ورفع كفاءة أدائه، والمحافظة على استدامته، وخدمة الشركاء، ورفع مستوى شفافية القطاع تنفيذًا للاستراتيجية الشاملة للقطاع العقاري</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">يُذكر أنّ معرض \"سيتي سكيب البحرين 2023م\" شهد مشاركة أكثر من 40 عارضًا وتقديم 58 مشروعاً، إضافة إلى استعراض أحدث مشاريع الإسكان الفاخرة، بما في ذلك الفلل المطلة على الشاطئ، والشقق الحديثة، والمجتمعات المسورة، والجزر الخاصة وسيتم عرض أكثر من 10,000 مشروع من أشهر المطورين في دول مجلس التعاون الخليجي</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار تختم مشاركتها في معرض\"سيتي سكيب البحرين 2023"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار تختم مشاركتها في معرض\"سيتي سكيب البحرين 2023"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"4bb543d9-1887-3f55-81ba-92017fe800be","Alias":"\"الهيئة العامة للعقار\": اليوم الاثنين 20 نوفمبر انتهاء فترة إبداء المرئيات حول مسودة اللائحة التنفيذية لنظام المساهمات العقارية","Path":"/6492bd60-b94a-4b9d-bb1f-0c3f3fe0048b.config","Level":4037,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6492bd60-b94a-4b9d-bb1f-0c3f3fe0048b.config","Node":{"Content":{"@Key":"6492bd60-b94a-4b9d-bb1f-0c3f3fe0048b","@Alias":"\"الهيئة العامة للعقار\": اليوم الاثنين 20 نوفمبر انتهاء فترة إبداء المرئيات حول مسودة اللائحة التنفيذية لنظام المساهمات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":"\"الهيئة العامة للعقار\": اليوم الاثنين 20 نوفمبر انتهاء فترة إبداء المرئيات حول مسودة اللائحة التنفيذية لنظام المساهمات العقارية"},"SortOrder":"37","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-20T16:09:28"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"MsoNormal\"><span style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\" lang=\"AR-SA\">أوضحت الهيئة العامة للعقار أنّ فترة إبداء المرئيات والملحوظات حول مسودة اللائحة التنفيذية لنظام المساهمات العقارية، المنشورة في منصة “استطلاع”، تنتهي اليوم الاثنين 20 نوفمبر 2023م، مؤكدة بأنَّ استقبال طلبات الترخيص للمساهمات العقارية يبدأ في يناير القادم، وسيتم الإعلان عن آلية تقديم الطلبات عبر المنصة الإلكترونية المخصّصة لذلك.</span></p>\n<p style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"MsoNormal\"><span style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\" lang=\"AR-SA\">وأكّد المتحدث الرسمي للهيئة العامة للعقار \"تيسير المفرج\" بأنّ الهيئة نظمت سلسة من اللقاءات وورش العمل مع الجهات ذات العلاقة من القطاع الحكومي والخاص والمهتمين بالشأن العقاري والخبراء الاقتصاديين لمناقشة مسودة \"اللائحة\" وأخذ مرئياتهم بهدف المشاورة العامة والتحسين والتطوير التنظيمي بكل شفافية بالتشارك مع أطراف العملية العقارية. </span></p>\n<p style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"MsoNormal\"><span style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\" lang=\"AR-SA\">وبين المفرج أنّ اللقاءات والورش جمعت المطورين العقاريين والمكاتب الهندسية بالإضافة للمحاسبين القانونيين والمقيمين، وذلك بصفتهم من ممارسي نشاط المساهمات العقارية، وتقع عليهم مسئوليات والتزامات وفق اختصاص كلاً منهم. </span></p>\n<p style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\" class=\"MsoNormal\"><span style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\" lang=\"AR-SA\">يُذكر أنَ نظام المساهمات العقارية يُعدّ أحد التشريعات العقارية التي تساهم في تنظيم نشاط المساهمات العقارية ، ورفع مستوى الشفافية والإفصاح، وحماية حقوق جميع أطراف المساهمة العقارية، وحوكمة المساهمات العقارية وتنظيمها وأتمتها، كما سيساهم النظام والعمل به في زيادة المعروض من المنتجات العقارية التجارية والسكنية ، زيادة قنوات التمويل للمطورين العقاريين، والقنوات الاستثمارية للراغبين في الاستثمار ، وتعزيز ثقة المستثمرين في القطاع العقاري في المملكة، والقضاء على المساهمات العقارية العشوائية وغير النظامية وحوكمة أعمال الرقابة والامتثال،  وخلق فرص استثمارية واعدة للمُنشآت الصغيرة والمتوسطة في السوق العقاري ، واستدامة نشاط التطوير العقاري وفتح فرص عمل في هذا النشاط.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\": اليوم الاثنين 20 نوفمبر انتهاء فترة إبداء المرئيات حول مسودة اللائحة التنفيذية لنظام المساهمات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\": اليوم الاثنين 20 نوفمبر انتهاء فترة إبداء المرئيات حول مسودة اللائحة التنفيذية لنظام المساهمات العقارية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"4fe723a6-2b39-301a-85c9-9cb012149164","Alias":"القمة العالمية لقادة العقار بالرياض تناقش أحدث المستجدات العقارية محليًا وعالميًا","Path":"/b9efefc4-7574-4395-83d4-9e0c1e93e917.config","Level":4038,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b9efefc4-7574-4395-83d4-9e0c1e93e917.config","Node":{"Content":{"@Key":"b9efefc4-7574-4395-83d4-9e0c1e93e917","@Alias":"القمة العالمية لقادة العقار بالرياض تناقش أحدث المستجدات العقارية محليًا وعالميًا","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"القمة العالمية لقادة العقار بالرياض تناقش أحدث المستجدات العقارية محليًا وعالميًا"},"SortOrder":"38","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-09T14:16:09"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">تشهد القمة العالمية لقادة العقار 42 للاتحاد العالمي للعقارات </span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">(</span><span dir=\"LTR\" style=\"font-size: 16.0pt; line-height: 200%;\">Fiabci Global</span><span style=\"font-size: 16.0pt; line-height: 200%;\"> </span><span dir=\"LTR\" style=\"font-size: 16.0pt; line-height: 200%;\">Leadership Summit</span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">)</span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">، التي تستعد العاصمة الرياض لاستضافتها في ديسمبر2023، مناقشة أحدث المستجدات والتطورات في منظومة العقار، محليًا ودولياً، وذلك وسط مشاركة واسعة من صنّاع وقادة القرار العقاري، على كافة المستويات المحلية، والإقليمية، الدولية</span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-size: 16.0pt; line-height: 200%;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">ويأتي انعقاد القمة بدعم ورعاية من \"الهيئة العامة للعقار\" و بالتزامن مع ما يشهده القطاع العقاري من حِراك واسع على المستويين المحلي والدولي، تمثلت في العديد من التطورات والمستجدات في مختلف مجالاته بصورة عامة، كما تعد هذه القمة فرصة لإبراز دور المملكة الرائد في القطاع العقاري، سيما وأن القمة ستشهد مشاركة نخبة من المطورين العقاريين والمستثمرين وأعضاء الاتحاد العالمي للعقارات، إضافة لمشاركة عدة متحدثين عالميين يمثلون أكثر من مائة وعشر دول سيثرون النقاشات والحوارات، وذلك من خلال تقديمهم لتجاربهم وخبراتهم العقارية</span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">كما تعدّ هذه القمة علامة فارقة لإبراز ما حققته منظومة العقار والإسكان في المملكة من إنجازات وتطورات كبيرة، سواء كان ذلك في مجال تحديث منظومة التشريعات العقارية، أو من حيث التطور التقني والرقمي الكبير الذي تم توظيفه في مختلف مجالات القطاع العقاري بالمملكة، الأمر الذي ساهم بشكل كبير في تنظيم القطاع العقاري، بالإضافة لجذب الاستثمارات العقارية النوعية المحلية والدولية</span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">وأكد سعادة المهندس عبدالله بن سعود الحمّاد الرئيس التنفيذي للهيئة العامة للعقار، أن انعقاد القمة العالمية لقادة العقار بالرياض، تعد مساحة اتصالية هامة لطرح تجربة القطاع العقار في المملكة، وما حققته من إنجازات لافتة، ونقلة كبيرة، خاصة في مجال التشريعات العقارية و ماطرا عليها من تحديث وتطوير يتوافق مع النمو الكبير في هذا القطاع، وذلك تماشيًا مع مستهدفات قطاع العقار في رؤية السعودية 2030، مشيرا إلى أن الهيئة العامة للعقار تشارك بفعالية في أعمال ونقاشات القمة، للتعريف بتجربة المملكة في هذا القطاع الحيوي البالغ الأهمية، وما يحمله من تحديات وفرص واعدة</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">وقال الحمّاد: &ldquo;يأتي الاهتمام بانعقاد القمة العالمية لقادة العقار التي تحتضنها الرياض، في ديسمير2023، نسبة لأهمية قطاع العقار، كمحرك أساسي ورئيسي في تحقيق التنمية وجذب الاستثمارات، بالإضافة لدوره الفاعل في الناتج المحلي الإجمالي، فضلا عن قيامه بتوليد فرص وظيفية كبيرة، لأبناء وبنات الوطن</span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">\".</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">وأشار الحمّاد في ختام تصريحه إلى أنه ووفقا لأحدث التوقعات، فإنه من المتوقع أن ينمو حجم سوق العقارات، في المملكة ما يزيد عن 241 مليار ريال في عام 2023 إلى ما يزيد عن 353 مليار ريال، مع حلول عام 2028، وذلك بمعدل نمو سنوي 7.89٪ خلال الفترة ما بين 2023 و2028م</span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%;\">يُذكر أنّ القمة العالمية لقادة العقار 42 التي تستضيفها الرياض في ديسمبر2023، ستشهد مشاركة كبيرة وعريضة لقادة العقار والمطورين والمستثمرين العقاريين، محليا ودوليا، بجانب مشاركة أعضاء الاتحاد العالمي للعقارات، وعدد كبير من المتحدثين، من مختلف دول العالم، يمثلون أكثر من 110 دول ويتحدثون نحو 55 لغة، وذلك من خلال جلسات نقاش، وحوار، وورش عمل متخصصة، كما سيتم خلال القمة مناقشة جهود تطوير المنظومة العقارية، وتطوير ممكنات صناعة العقار في عدد من الأسواق العالمية، والإقليمية، وستشهد القمة أيضا طرح التجارب، والممارسات المحلية، والعالمية، وبحث تطوير، وتنمية قطاع منظومة العقار في مختلف جوانبها</span><span lang=\"AR\" style=\"font-size: 16.0pt; line-height: 200%; mso-bidi-language: AR;\">.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"القمة العالمية لقادة العقار بالرياض تناقش أحدث المستجدات العقارية محليًا وعالميًا"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"القمة العالمية لقادة العقار بالرياض تناقش أحدث المستجدات العقارية محليًا وعالميًا"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"c4f3874b-9d5b-3268-97ec-4c819f87fb16","Alias":"أكثر من 50 جولة رقابية تُنفّذها \"الهيئة العامة للعقار\" وأمانة منطقة حائل\" للتأكد من الالتزام بنظام الوساطة العقارية","Path":"/5ca8d19d-9333-4587-b507-0d231a1a4869.config","Level":4039,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/5ca8d19d-9333-4587-b507-0d231a1a4869.config","Node":{"Content":{"@Key":"5ca8d19d-9333-4587-b507-0d231a1a4869","@Alias":"أكثر من 50 جولة رقابية تُنفّذها \"الهيئة العامة للعقار\" وأمانة منطقة حائل\" للتأكد من الالتزام بنظام الوساطة العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"أكثر من 50 جولة رقابية تُنفّذها \"الهيئة العامة للعقار\" وأمانة منطقة حائل\" للتأكد من الالتزام بنظام الوساطة العقارية"},"SortOrder":"39","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-10T14:56:12"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\">نفّذت الفرق الميدانية المشتركة بين الهيئة العامة للعقار وأمانة منطقة حائل ما يزيد عن 50 جولة رقابية على المنشآت العقارية للرقابة على الالتزام بتطبيق نظام الوساطة العقارية، ضمن التعاون القائم والمشترك بين وزارة الشؤون البلدية والقروية والإسكان والهيئة العامة للعقار</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وشملت الجولات الرقابية المشتركة رصد عدد من المخالفات تتمثّل في ممارسة نشاط الوساطة العقارية أو الخدمات العقارية دون حيازة ترخيص أو ترخيص ساري المفعول، وتقديم خدمات الوساطة العقارية دون حيازة صور من وثائق ملكية العقارأو ملكية منفعته، وعدم إيداع أو تسجيل عقود الوساطة المبرمة أو الصفقات العقارية التي يتمّها في المنصة الإلكترونية</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">ودعت الهيئة الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد النظام وعدم مخالفته، والاطلاع على المخالفات تجنبًا للعقوبات التي تشمل وفق النظام الإنذارات وتعليق الترخيص أو إلغائه أو الغرامات المالية، مؤكدةً أنه يمكن مُضاعفة الغرامة المحكوم بها في حال تكرار المخالفة خلال ثلاث سنوات من ارتكابها، وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">يُذكر أنّ نظام الوساطة العقارية يهدف إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، كما يرفع النظام جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، والحد من النزاعات العقارية، وحفظ حقوق المتعاملين، ورفع شفافية السوق العقاري</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"أكثر من 50 جولة رقابية تُنفّذها \"الهيئة العامة للعقار\" وأمانة منطقة حائل\" للتأكد من الالتزام بنظام الوساطة العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"أكثر من 50 جولة رقابية تُنفّذها \"الهيئة العامة للعقار\" وأمانة منطقة حائل\" للتأكد من الالتزام بنظام الوساطة العقارية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b36244c8-f6c9-3ad8-ade7-7d169afce62e","Alias":"الهيئة العامة للعقار: إصدار أول تشريع عقاري لإدارة المرافق خلال الربع الأول للعام المقبل 2024م ","Path":"/ea92a887-3545-41fb-9177-6afe3b11a21d.config","Level":4040,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ea92a887-3545-41fb-9177-6afe3b11a21d.config","Node":{"Content":{"@Key":"ea92a887-3545-41fb-9177-6afe3b11a21d","@Alias":"الهيئة العامة للعقار: إصدار أول تشريع عقاري لإدارة المرافق خلال الربع الأول للعام المقبل 2024م ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"الهيئة العامة للعقار: إصدار أول تشريع عقاري لإدارة المرافق خلال الربع الأول للعام المقبل 2024م "},"SortOrder":"40","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-16T08:46:23"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p>&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">أعلن الرئيس التنفيذي للهيئة العامة للعقار المهندس عبدالله بن سعود الحماد، أنَّ الهيئة ستُصدر أول تشريع عقاري لإدارة المرافق في القطاع العقاري السعودي خلال الربع الأول للعام المقبل 2024م، حيث سيتم إصدار اللائحة التنظيمية لإدارة المرافق والتي تُنظم وتحوكم العمل في هذا النشاط كأحد التشريعات العقارية التي تُساهم في حوكمة القطاع العقاري ورفع موثوقيته وجاذبيته الاستثمارية.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">جاء ذلك خلال مشاركته في مؤتمر ومعرض \"ميفما كونفكس\" 2023 الذي تنظمه جمعية الشرق الأوسط لإدارة المرافق (ميفما) تحت شعار إدارة المرافق في العصر الرقمي- نحو تبني مستقبل ذكي\"، وذلك في مدينة الرياض يومي 15-16 أكتوبر 2023.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وأوضح الحمَّاد في كلمته التي ألقاها في افتتاح أعمال المؤتمر إلى أنَّ القطاع العقاري يحظى بدعم غير محدود من لدن القيادة الرشيدة، باعتباره أحد ركائز الاقتصاد الوطني، حيث حرصت الدولة على تنظيمه وتنميته وتحسين آليات الإشراف عليه، ورفع كفاءته وتشجيع الاستثمار فيه، وتمكينه من زيادة مساهمته في الناتج المحلي الإجمالي والتي بلغت وفق إحصاءات الربع الثاني من العام الحالي 6.1 %، وبلغت مساهمة الأنشطة العقارية في الأنشطة غير النفطية منه 12.7%.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وقال الرئيس التنفيذي للهيئة العامة للعقار أن نشاط إدارة المرافق أحد الأنشطة المشمولة بنظام الوساطة العقارية الذي مضى على بدء تطبيقه نحو ثلاثة أشهر، ويعتبر هذا النظام من أبرز الممكنات لتطوير القطاع العقاري وحوكمته، ورقمنة عملياته، وخدمة المستفيدين، ليكون القطاع العقاري في المملكة قطاعًا حيويًا وجاذبًا، ومحفزًا للاستثمار لوجود الموثوقية والشفافية في كافة الأنشطة العقارية.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وأشار إلى أن مشاركة \"الهيئة\" كشريك استراتيجي لأعمال الدورة الحادية عشرة من هذا المؤتمر تأتي إيماناً منها بالدور الاستراتيجي لمثل هذه الفعاليات وما تزخر به من خبرات وتجارب سيكون لها بالغ الأثر في تطوير القطاع العقاري، مضيفًا بأن إدارة المرافق من أكثر الأنشطة العقارية المؤثرة والفاعلة في الاستدامة المعمارية.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">يذكر بأنَّ المؤتمر في نسخته الحالية والمقامة في الرياض استقطب أبرز الخبراء في قطاع إدارة المرافق لطرح أفضل الممارسات والتجارب في دور العصر الرقمي بجعل القطاع أكثر ذكاءً باستخدام التقنيات الحديثة في سبيل زيادة الوعي حول أهمية القطاع ودوره في استدامة وإطالة العمر التشغيلي للمرافق والمشاريع العملاقة التي تشهدها المملكة العربية السعودية ضمن التحول الوطني والرقمي نحو تحقيق رؤية</span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\"> </span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">2030</span><span dir=\"LTR\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وقد اعتمدت جمعية الشرق الأوسط لإدارة المرافق (ميفما) برنامج المؤتمر بمحتوى شمل عقد عدد من ورش العمل المتخصصة، وجلسات حول أحدث التوجهات في القطاع، وإدارة المرافق القائمة على التكنولوجيا والبيانات، رحلة قطاع إدارة المرافق نحو تحقيق الاستدامة، تأثير قطاع إدارة المرافق في مستقبل ورؤية المملكة العربية السعودية.</span></p><p>&nbsp;</p><p>&nbsp;</p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: إصدار أول تشريع عقاري لإدارة المرافق خلال الربع الأول للعام المقبل 2024م "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: إصدار أول تشريع عقاري لإدارة المرافق خلال الربع الأول للعام المقبل 2024م "}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"573c8b5f-4ede-38b8-bd4d-8435ce69553d","Alias":"المؤشر الإيجاري: أكثر من 294 ألف صفقة في سبتمبر ","Path":"/bbd54cd7-0574-430b-8f65-67e77a0aa8bc.config","Level":4041,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/bbd54cd7-0574-430b-8f65-67e77a0aa8bc.config","Node":{"Content":{"@Key":"bbd54cd7-0574-430b-8f65-67e77a0aa8bc","@Alias":"المؤشر الإيجاري: أكثر من 294 ألف صفقة في سبتمبر ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"المؤشر الإيجاري: أكثر من 294 ألف صفقة في سبتمبر "},"SortOrder":"41","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-16T09:40:02"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif;\">سجّل \"المؤشر الإيجاري\" أكثر من 294 ألف صفقة إيجارية سكنية وتجارية خلال شهر سبتمبر الماضي، وذلك ضمن التقارير والبيانات التي تصدرها الشبكة الإلكترونية لخدمات الإيجار \"إيجار\" بالتكامل مع منصة سكني؛ إذ يتضمن المؤشر أكثر من 160 مدينة ومحافظة تشمل معظم مدن ومناطق المملكة بارتفاع يتجاوز 22% مقارنة بسبتمر 2022م، وانخفاض عن أغسطس الماضي بنسبة تتجاوز 15%.</span></p><p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif;\">وشهد تقرير شهر سبتمبر للمؤشر الإيجاري انخفاضا في الصفقات السكنية بنسبة 15% مقارنة بأغسطس الماضي، حيث بلغت الصفقات السكنية في سبتمبر 233 ألف صفقة، فيما سجلت صفقات الإيجار التجارية نحو 61 ألف صفقة، بانخفاض بنسبة 6% مقارنة بأغسطس الماضي.</span></p><p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif;\">وتصدّرت الرياض قائمة المدن بأكثر من 22% من إجمالي الصفقات التي سجّلها المؤشر الإيجاري، مسجلةً مايزيد عن&nbsp; 65 ألف صفقة إيجارية سكنية وتجارية؛ لتستمر كأكثر المدن تسجيلاً للصفقات الإيجارية، تلتها جدة التي تجاوزت صفقاتها 37 ألف صفقة سكنية وتجارية، ثم مكة المكرمة بـ 13 ألف صفقة سكنية وتجارية ثم المدينة المنورة التي سجلت 13 ألف صفقة، ثم الدمام التي بلغت صفقاتها 12.9 ألف صفقة، ويمكن الوصول للمؤشر في منصة سكني عبر الرابط:</span><span lang=\"AR-SA\" style=\"font-size: 13.5pt; line-height: 200%; font-family: 'Arial',sans-serif; color: #333333;\">&nbsp;<a title=\"https://eur05.safelinks.protection.outlook.com/?url=https%3A%2F%2Fsakani.sa%2Freports-and-data&amp;data=05%7C01%7Cs.alkhudairy%40nhc.sa%7C996bf63c205b4ab32a0d08dbb84869ac%7C4f2052cd4ff9478d9e18de5631edebf6%7C1%7C0%7C638306393483419339%7CUnknown%7CTWFpbGZsb3d8\" href=\"https://sakani.sa/reports-and-data\"><span dir=\"LTR\" lang=\"EN-US\" style=\"color: #00a885; text-decoration: none; text-underline: none;\">https://sakani.sa/reports-and-data</span></a></span></p><p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; background: white; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; background: white; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; color: black;\">ويهدف المؤشر الإيجاري إلى تحقيق الشفافية وتحفيز الاستثمار في قطاع العقار الإيجاري في المملكة، عبر وضع مؤشرات إيجارية محددة للمدن والأحياء وأنواع العقار المختلفة بشقيها السكني والتجاري، حيث يمكن التعرّف على النطاقات السعرية للوحدات السكنية، والبحث عن الأحياء التي تضم وحدات سكنية في نطاق سعري يحدده المستفيد، واستعراض عدد الصفقات الإيجارية والوحدات السكنية والتجارية في الحيّ المعين خلال الفترة المحددة، ومتوسط القيم الإيجارية، وتوضيح النطاق السعري للصفقات السكنية، واستعراضها من خلال رسم بياني، وذلك في إطار الجهود المشتركة لرفع كفاءة السوق تماشيًا مع أهداف برنامج الإسكان &ndash; أحد برامج رؤية السعودية 2030 -.</span></p><p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; background: white; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p dir=\"RTL\" style=\"margin-bottom: 7.5pt; text-align: right; line-height: 200%; background: white; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; color: black;\">يذكر أنه أصبح بإمكان المستفيدين من قطاع الإيجار العقاري الاطلاع على نتائج تقييم الوسطاء العقاريين على قائمة الوسطاء في المؤشر، وعدد المقيّمين للوسيط، ويعتمد التقييم في المرحلة الحالية على مدى رضا المؤجر عن أداء وتجاوب الوسيط العقاري أثناء توثيق العقد، وتقييم المستأجر لتجربته مع الوسيط العقاري أثناء إبرام عقد الإيجار وإيضاحه للشروط والأحكام.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"المؤشر الإيجاري: أكثر من 294 ألف صفقة في سبتمبر "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"المؤشر الإيجاري: أكثر من 294 ألف صفقة في سبتمبر "}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"faeb8f13-e750-3475-9feb-9ae8d2af1617","Alias":"\"هيئة العقار\": إصدار أكثر من 27 ألف رخصة عقارية وأكثر من 77 ألف عقد وساطة خلال 3 أشهر","Path":"/3c0a1fbb-0da1-4040-9200-8164621b0f7d.config","Level":4042,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3c0a1fbb-0da1-4040-9200-8164621b0f7d.config","Node":{"Content":{"@Key":"3c0a1fbb-0da1-4040-9200-8164621b0f7d","@Alias":"\"هيئة العقار\": إصدار أكثر من 27 ألف رخصة عقارية وأكثر من 77 ألف عقد وساطة خلال 3 أشهر","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"\"هيئة العقار\": إصدار أكثر من 27 ألف رخصة عقارية وأكثر من 77 ألف عقد وساطة خلال 3 أشهر"},"SortOrder":"42","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-16T14:38:32"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">أوضحت الهيئة العامة للعقار أنها أصدرت أكثر من27 ألف رخصة \"فال\" العقارية للأفراد والمنشآت، وذلك منذ بدء الامتثال لنظام الوساطة العقارية مطلع العام الهجري الحالي</span><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"line-height: 200%;\"><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\"><br></span><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">وأوضح المتحدث الرسمي للهيئة تيسير بن محمد المفرج، أنّ عدد مستخدمي المنصة الالكترونية للهيئة بلغ نحو(363.328) مستخدمًا، فيما بلغت عقود الوساطة (77.902) عقدًا، كما تم إصدار أكثر من(60.205) ترخيصات إعلانية، إضافة إلى ترخيص (21) منصة إلكترونية لأعمال الوساطةوالتسويق العقاري</span><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">.<br></span><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">وبيّن المفرج أن \"رخصة فال العقارية\" هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت ممارسة أنشطةالوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية؛ ويهدف النظام إلىتنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، كمايرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريينوالمستفيدين، ويسهم في استدامة الأصول العقارية، والحد من النزاعات العقارية، وحفظحقوق المتعاملين، ورفع شفافية السوق العقاري</span><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"line-height: 200%;\"><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\"><br></span><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">وأبان المفرج، أنَّ الوساطة العقارية تمارس حصراً على المرخصين من الهيئة العامة للعقار، مُشيرًا إلى أنَّالنظام يشمل أعمال التوسط في إتمام الصفقات العقارية بما في ذلك </span><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">الوساطة الإلكترونية من خلالوسائل التقنية كالمواقع الإلكترونية ومنصات التواصل الاجتماعي، إضافة إلى ممارسة الأنشطة المتعلقة بالعقار، والتسويق له، وإدارته وبيعه، وبيع منفعته، وتأجيره، ومنها: التسويق العقاري، وإدارة الأملاك، وإدارة المرافق، والمزادات العقارية، والإعلانات العقارية، والاستشارات والتحليلات العقارية</span><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"line-height: 200%;\"><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\"><br></span><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">من جهة أخرى, أضاف المتحدث الرسمي أن الهيئة أتاحت خدمة الاستعلام عن الوسطاء العقاريين من خلال موقع الهيئة الرسمي (خدمة الاستعلام عن الوسيط)</span><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"line-height: 200%;\"><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\"><br></span><span lang=\"AR-SA\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">يُذكر أنّ السجلات التجارية للوساطة العقارية شهدت نمواً بلغ 35% بنهاية الربع الثالث من عام 2023م مقارنة بالربع الثالث لعام2022م، وفقاً لبيانات وزارة التجارة في إحصائيات قطاع الأعمال للربع الثالث، مما يعكس أثر نظام الوساطة العقارية كتشريع عقاري يسهم في نمو السوق وحوكمته</span><span dir=\"LTR\" style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; mso-themecolor: text1;\">.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\": إصدار أكثر من 27 ألف رخصة عقارية وأكثر من 77 ألف عقد وساطة خلال 3 أشهر"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"هيئة العقار\": إصدار أكثر من 27 ألف رخصة عقارية وأكثر من 77 ألف عقد وساطة خلال 3 أشهر"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"6ab1919b-4372-309d-a2f4-c9cb7b4f932f","Alias":"\"الهيئة العامة للعقار\" و \"الشركة السعودية لإدارة المرافق\" يُوقعان مذكرة تفاهم","Path":"/2d029ae8-574d-467e-beb4-92d9a82c957a.config","Level":4043,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2d029ae8-574d-467e-beb4-92d9a82c957a.config","Node":{"Content":{"@Key":"2d029ae8-574d-467e-beb4-92d9a82c957a","@Alias":"\"الهيئة العامة للعقار\" و \"الشركة السعودية لإدارة المرافق\" يُوقعان مذكرة تفاهم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"\"الهيئة العامة للعقار\" و \"الشركة السعودية لإدارة المرافق\" يُوقعان مذكرة تفاهم"},"SortOrder":"43","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-17T14:51:42"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\">وقّعت الهيئة العامة للعقار والشركة السعودية لإدارة المرافق, مذكرة تفاهم, بحضور الرئيس التنفيذي للهيئة المهندس عبدالله بن سعود الحمَّاد، والرئيس التنفيذي للشركة السعودية المهندس عادل بن إبراهيم الرويشدي</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وتهدف مذكرة التفاهم إلى تعزيز التعاون في تطوير معايير إدارة المرافق العقارية، ودراسة تأسيس مجلس تنسيقي بين الجهات ذات العلاقة لحوكمة وتنظيم قطاع المرافق العقارية وتطوير المعايير اللازمة لها، وتعزيز التعاون في مجال الدراسات اللازمة حول السوق المحلية ورصد التحديات وفرص الاستثمار لتطوير قطاع المرافق العقارية والارتقاء به، والتعاون لتطوير وتأهيل ممارسي نشاط إدارة المرافق العقارية (أفراد، منشآت)، وفق الممارسات العالمية، وتعزيز التعاون في بناء نموذج مقترح لرحلة ترخيص المنشآت لممارسة نشاط إدارة المرافق وفق أفضل الممارسات في هذا المجال لتعزيز كفاءة الخدمات المقدّمة والارتقاء بالسوق المحلية تحقيقاً لمبدأ استدامة المنشآت و تعزيزاً لجودة الحياة وتطوير حلول رقمية لرفع جودة الخدمات المقدمة في قطاع إدارة المرافق العقارية في المملكة</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وجرى توقيع مذكرة التفاهم خلال مشاركة الهيئة العامة للعقار في مؤتمر ومعرض \"ميفما كونفكس\" 2023م، الذي تنظّمه جمعية الشرق الأوسط لإدارة المرافق (ميفما) تحت شعار إدارة المرافق في العصر الرقمي- نحو تبنّي مستقبل ذكي\"، وذلك في مدينة الرياض</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وتسعى الهيئة العامة للعقار من خلال توقيع هذه المذكرة إلى تنظيم النشاط العقاري ورفع كفايته وتشجيع الاستثمار فيه وتقديم الدعم المساند لشركائها للنهوض بالقطاع العقاري بما يتوافق مع أهداف التنمية الاقتصادية والاجتماعية ومستهدفات الاستراتيجية العقارية ورؤية 2030</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" و \"الشركة السعودية لإدارة المرافق\" يُوقعان مذكرة تفاهم"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" و \"الشركة السعودية لإدارة المرافق\" يُوقعان مذكرة تفاهم"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b1cdfeb2-9514-3622-a714-8993db4fdfc4","Alias":"الهيئة العامة للعقار تعلن بدء أعمال \"السجل العقاري \" في المدينة المنورة","Path":"/707a4861-02f9-4308-a048-bfb3535f0b3f.config","Level":4044,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/707a4861-02f9-4308-a048-bfb3535f0b3f.config","Node":{"Content":{"@Key":"707a4861-02f9-4308-a048-bfb3535f0b3f","@Alias":"الهيئة العامة للعقار تعلن بدء أعمال \"السجل العقاري \" في المدينة المنورة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"الهيئة العامة للعقار تعلن بدء أعمال \"السجل العقاري \" في المدينة المنورة"},"SortOrder":"44","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-19T14:52:41"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\">بحضور صاحب السمو الملكي الأمير فيصل بن سلمان بن عبد العزيز، أمير منطقة المدينة المنورة، ومعالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبدالله الحقيل، أعلنت الهيئة العامة للعقار عن تطبيق التسجيل العيني للعقار \"السجل العقاري\" في منطقة المدينة المنورة، وذلك حسب الخطة التشغيلية المعدة لذلك حيث تم الاتفاق بين الهيئة وأمانة منطقة المدينة المنورة على تقسيم الأحياء إلى مناطق محددة تجمع كل منطقة عدد من الأحياء، وسيتم الإعلان عن الأحياء المستفيدة التي سيبدأ تسجيل عقاراتها بشكل تدريجي خلال الفترة القادمة</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla'; background: white;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وأكدتْ الهيئة أنَّ إعلان تطبيق السجل العقاري في منطقة المدينة يأتي ضمن الخطة التشغيلية التي تعمل عليها الهيئة بالتنسيق مع الجهات الحكومية ذات العلاقة ، وأنّ اختيار المناطق والمدن والأحياء المستفيدة يتم وفق تقييم معايير جهوزية ونضج البيانات المتوفرة للوحدات العقارية فيها، وهي عملية مستمرة وصولًا لجميع الوحدات العقارية في المملكة</span><span dir=\"LTR\" lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\"> </span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla'; background: white;\">.</span></span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وأضافت الهيئة أنَّ نظام التسجيل العيني للعقار الصادر بقرار مجلس الوزراء يهدف إلى زيادة موثوقية التملك، وتعزيز دقة المعلومات عن العقار، وحفظ حقوق المتعاملين في القطاع العقاري وتعزيز الجاذبية الاستثمارية للقطاع، وبموجب النظام سيتم إنشاء سجل عقاري شامل لجميع معلومات وبيانات الوحدات العقارية السكنية، التجارية، الزراعية، الصناعية وغيرها، إضافة إلى العقارات الحكومية على مستوى المملكة، حيث سيصدر لكل وحدة عقارية أيًا كانت \"رقم عقار\" وصك تسجيل ملكية كصحيفة عقارية تتضمن بيانات وأوصاف العقار وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه مرتبطة بالمعلومات الجيومكانية من خلال الرفع المساحي والإحداثيات الجغرافية للعقارات، ليكون أساس تسجيل الملكية والحقوق العقارية المترتبة عليها بما يسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسية له</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla'; background: white;\">. </span></span><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">من جهتها أكدت أمانة منطقة المدنية المنورة جاهزية البيانات والممكنات الرئيسية لبدء تطبيق أعمال السجل العقاري في المنطقة، وأوضحتْ بأنَّها تعمل مع شركة \"السجل العقاري \"على تحقيق التكامل لبيانات الخريطة العقارية وتبادل ومزامنة البيانات بين أمانة منطقة المدينة المنورة و\"السجل العقاري\"، وإتاحة الربط الإلكتروني بمنصة الشركة لتبادل البيانات الجيومكانية والعقارية وعكس التحديثات على البيانات بشكل دوري</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla'; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla';\"> </span><span lang=\"AR-SA\" style=\"font-family: 'Sakkal Majalla'; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">يُذكر أنَّ أمانة منطقة المدينة المنورة قد طورت بيئة نظم المعلومات الجغرافية لديها، وأنهت أعمال التصوير الجوي للمدينة المنورة بدقة وضوح عالية وتم إنجاز 45% من أعمال معالجة الصور الجوية وإنتاج الارتفاعات والصور المصححة، كما تم إنجاز 30٪ من أعمال تحديث خارطة الأساس من الصور الجوية، إلى جانب بدء أعمال مشروع تصحيح المخططات وفقاً لمتطلبات التسجيل العيني للعقار</span><span dir=\"LTR\" style=\"font-family: 'Sakkal Majalla'; background: white;\">.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تعلن بدء أعمال \"السجل العقاري \" في المدينة المنورة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تعلن بدء أعمال \"السجل العقاري \" في المدينة المنورة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ead33aec-f2ab-3a86-87ad-126f2d9ee0cd","Alias":"الهيئة العامة للعقار: أكثر من 100 مليون متر مربع مفروز حتى أكتوبر الجاري","Path":"/ecf4e74a-4d08-46bd-9e0b-44474abf732f.config","Level":4045,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ecf4e74a-4d08-46bd-9e0b-44474abf732f.config","Node":{"Content":{"@Key":"ecf4e74a-4d08-46bd-9e0b-44474abf732f","@Alias":"الهيئة العامة للعقار: أكثر من 100 مليون متر مربع مفروز حتى أكتوبر الجاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"الهيئة العامة للعقار: أكثر من 100 مليون متر مربع مفروز حتى أكتوبر الجاري"},"SortOrder":"45","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-25T15:01:46"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\">أعلنت الهيئة العامة للعقار عن تسجيل برنامج \"فرز الوحدات العقارية\"، أكثر من 100 مليون متر مربع من مساحات العقارات المفروزة مُنذ بداية البرنامج وحتى أكتوبر الجاري والذي يقدّم خدمة (فرز أو إعادة فرز) مبنى أو مجمّع عقاري إلى عدّة وحدات عقارية، ليصبح لكل وحدة عقارية صكّ ملكية مستقل من خلال منصة إلكترونية</span><span dir=\"LTR\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\">وأوضحت \"هيئة العقار\" أنّه مُنذ إطلاق \"منصة فرز الوحدات العقارية\" استقبلت المنصة أكثر من45 ألف طلب، فُرز من خلالها أكثر من 317 ألف وحدة عقارية، منها 312 ألف وحدة عقارية سكنية، وقرابة 4 آلاف وحدة تجارية، وأكثر من 400 مكتب إداري</span><span dir=\"LTR\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\">وأضافت \"هيئة العقار\" أنّ تطوير إجراءات منصة فرز الوحدات العقارية وتسهيل عملياتها، وخدماتها جاءت بإجراءات موحّدة من كافة الشركاء والجهات ذات العلاقة، أسهمت في تسريع مدة إنهاء الطلبات ورفع كفاءتها وجودتها، إضافة إلى إسهامها في توفير خيارات سكنية وتجارية متنوّعة من الوحدات العقارية للراغبين بالتملّك، من خلال تمكين المطوّرين العقاريين من فرز العقارات والمجمعات العقارية إلى عدّة وحدات، لزيادة المعروض العقاري وإتاحته للمستفيدين</span><span dir=\"LTR\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\">وأكّدت الهيئة أنّ هذه الأرقام جاءت نتيجة أتمتة الإجراءات مع الجهات ذات العلاقة، مثل الربط مع وزارة العدل لإصدار الصكوك بعد الانتهاء من عمليات الفرز، ومنصة بلدي للتحقّق من بيانات الرخص الإنشائية؛ وذلك لإتمام عمليات الفرز من خلال المنصة الإلكترونية لفرز الوحدات العقارية، دون الحاجة لمراجعة الجهات، أو زيارة المكتب الهندسي، حيث قلّصت حوكمة هذه العملية وأتمتتها رحلة المستفيد من مدة تصل إلى 60 يوم عمل إلى مدة تتراوح من 5 إلى 10 أيام عمل، تشمل إجراءات معالجة واعتماد محاضر الفرز وإصدار الصكوك</span><span dir=\"LTR\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\">وجاءت محافظة جدة في صدارة المدن الأكثر نشاطاً في عمليات الفرز من حيث عدد الوحدات المفروزة، حيث تجاوز عدد الوحدات المفروزة فيها 86 ألف وحدة، ثم الرياض بأكثر من 77 ألف وحدة، تلتها المنطقة الشرقية بـ 39 ألف وحدة، فمكة المكرمة بـ 29 ألف وحدة، ثم عسير بأكثر من 24 ألف وحدة عقارية</span><span dir=\"LTR\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\">&nbsp;</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\">يُذكر أنّ \"هيئة العقار\" أضافت عدداً من الخدمات والتحسينات على<span style=\"mso-spacerun: yes;\">&nbsp; </span>\"فرز الوحدات العقارية\" مثل خدمة<span style=\"mso-spacerun: yes;\">&nbsp; </span>تقديم طلب فرز إلكتروني، والتي تمكن مالك العقار من التعاقد عبر المنصة الإلكترونية لفرز الوحدات العقارية مع المكاتب الهندسية والحصول على أفضل عروض الأسعار لرفع العقار مساحياً وتقديم طلب الفرز، لتتميز بسرعة وسهولة اختيار مالك العقار للمكتب الهندسي، كما تنظم الحالة التعاقدية بينهم، وتزيد من التنافس بين المكاتب الهندسية في جودة وسرعة إنجاز طلبات الفرز، بالإضافة إلى إمكانية تحديد المدة الزمنية والأسعار للطلبات المقدمة وفق ضوابط محددة، بالإضافة للعمل على تقليص مدة إجراءات إدخال بيانات طلبات الفرز من قبل المكاتب الهندسية بنسبة 70% بشكل آلي بدلاً من إدخالها بشكل يدوي، كما أنّ الربط التقني مع منصة بلدي للتحقق من الرخص الإنشائية لطلبات الفرز أسهم في تسهيل إجراءات الطلبات وضبط جودة البيانات المرفوعة في منصة فرز الوحدات العقارية وتقليص مدتها، وخدمة إعادة الفرز التي تتيح لملاك الوحدات العقارية السكنية والتجارية أو متعددة الاستخدام من إعادة فرز الوحدة، أو العقار المشترك، أو المجمع العقاري، أو أي جزء منها، بالتجزئة والدمج والإضافة وغيرها من الخدمات</span><span dir=\"LTR\">.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: أكثر من 100 مليون متر مربع مفروز حتى أكتوبر الجاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: أكثر من 100 مليون متر مربع مفروز حتى أكتوبر الجاري"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"14878fc3-2e15-3dd3-aeee-9223bf6dcc1e","Alias":"هيئة العقار: سبعة أحياء في الرياض تستعد غدًا لبدء تسجيل عقاراتها في \" السجل العقاري \" ","Path":"/f8e4eaf7-40ea-4ab3-84fd-4cbb4c4faae3.config","Level":4046,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f8e4eaf7-40ea-4ab3-84fd-4cbb4c4faae3.config","Node":{"Content":{"@Key":"f8e4eaf7-40ea-4ab3-84fd-4cbb4c4faae3","@Alias":"هيئة العقار: سبعة أحياء في الرياض تستعد غدًا لبدء تسجيل عقاراتها في \" السجل العقاري \" ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"هيئة العقار: سبعة أحياء في الرياض تستعد غدًا لبدء تسجيل عقاراتها في \" السجل العقاري \" "},"SortOrder":"46","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-28T14:19:16"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">أكملتْ الهيئة العامة للعقار استعداداتها لبدء أعمال المرحلة الثانية من \"السجل العقاري\" غدًا في العاصمة الرياض والتي تشمل سبعة أحياء: (الغدير، النفل، الوادي، المروج، المصيف، التعاون، الازدهار) كثاني المناطق المستفيدة من السجل العقاري في الرياض بعد حي الفلاح. <span style=\"mso-spacerun: yes;\">&nbsp;&nbsp;</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وأوضحتْ الهيئة بأنَّ \" السجل العقاري \" هو نظام لتسجيل العقارات يجعل العقار أساساً لتسجيل الملكية والحقوق العقارية الأخرى المترتبة عليه، وذلك بإعداد صحيفة في السجل العقاري تتضمن رقم العقار واسم مالكه وأوصافه من حيث نوعه وموقعه ومساحته وحدوده وأبعاده وما له من حقوق وما عليه من التزامات وما يطرأ عليه من تصرفات وما يترتب عليه من حقوق للغير، مؤكدةً بأنَّ هذا النظام يمنح الملكيات العقارية أعلى درجات الموثوقية ، وتستفيد منه كافة أنواع العقارات السكنية ، التجارية ، الزراعية ، الصناعية إضافة إلى جميع العقارات الحكومية.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">من جهة أخرى أكملت شركة \" السجل العقاري \" الجهة المنُفذة للتسجيل استعداداتها التقنية ورفع جاهزية المنصة الإلكترونية الموحدة للتسجيل، وجاهزية مركز خدمة العملاء إضافة إلى الانتهاء من تركيب اللوحات التعريفية والإرشادية في الأحياء المستفيدة، إضافة إلى جاهزية المسجلين العقاريين للقيام بأعمال التسجيل من خلال منصة التسجيل العيني.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">يُذكر بأنَّ<span style=\"mso-spacerun: yes;\">&nbsp; </span>أعمال \" السجل العقاري \" قد بدأت بناءً على المرسوم الملكي رقم م/91 وقرار مجلس الوزراء رقم 537 الصادرين بشأن الموافقة على نظام التسجيل العيني للعقار في المملكة ، والذي يوجب<span style=\"mso-spacerun: yes;\">&nbsp; </span>من خلاله على كافة ملاّك العقارات ضرورة الإفصاح عن أي مستندات او بيانات لازمة لصحة وسلامة التسجيل العيني الأول وذلك لاكتساب الملكيات العقارية الحجية المطلقة <span style=\"mso-spacerun: yes;\">&nbsp;</span>بهدف زيادة موثوقية التملك، وتعزيز دقة المعلومات عن العقار، وحفظ حقوق المتعاملين في القطاع بما يحقق مستهدفات برامج رؤية المملكة 2030 في التحول الرقمي، وتنمية الثروة العقارية، وتعزيز الجاذبية الاستثمارية في القطاع العقاري.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار: سبعة أحياء في الرياض تستعد غدًا لبدء تسجيل عقاراتها في \" السجل العقاري \" "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"هيئة العقار: سبعة أحياء في الرياض تستعد غدًا لبدء تسجيل عقاراتها في \" السجل العقاري \" "}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"7997d99b-e9c3-3c6d-8ca8-f2a59e37566f","Alias":"\"هيئة العقار\" تدعو ملاَّك العقارات في سبعة أحياء في الرياض تسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ","Path":"/df679194-77ee-40c1-bc90-5b73688ef677.config","Level":4047,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/df679194-77ee-40c1-bc90-5b73688ef677.config","Node":{"Content":{"@Key":"df679194-77ee-40c1-bc90-5b73688ef677","@Alias":"\"هيئة العقار\" تدعو ملاَّك العقارات في سبعة أحياء في الرياض تسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"\"هيئة العقار\" تدعو ملاَّك العقارات في سبعة أحياء في الرياض تسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم "},"SortOrder":"47","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-29T13:49:23"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\">بدأت أعمال \" السجل العقاري\" في </span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">أحياء: (الغدير، النفل، الوادي، المروج، المصيف، التعاون، الازدهار) بمدنية الرياض اليوم الأحد <span style=\"color: black; background: white;\">14 ربيع الثاني 1445ه الموافق 29</span></span><span dir=\"LTR\" lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\"> </span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\">أكتوبر 2023م كثاني المناطق المستفيدة من السجل العقاري والتي يستمر التسجيل فيها حتى 17 رجب 1445 هـ الموافق 29 يناير 2024م.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\">وأكدتْ الهيئة العامة للعقار أنَّ التسجيل الأول للعقارات يتم بشكل مجاني عن طريق منصة السجل العقاري الإلكترونية</span><span dir=\"LTR\" lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\"> </span><span dir=\"LTR\"><a href=\"https://rer.sa/rer-services-ar\"><span style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">https://rer.sa/rer-services-ar</span></a></span><span style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\"> </span><span dir=\"LTR\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\"><span style=\"mso-spacerun: yes;\">&nbsp;</span></span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\">حيث يتعين </span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">على ملاك العقارات السكنية والتجارية وغيرها في الأحياء السبعة المستفيدة تقديم طلب التسجيل العيني الأول، مرفقاً به المستندات المثبتة للعقار ( صك إلكتروني صادر من وزارة العدل مكتمل البيانات مستوفٍ لشروط الملكية وهوية سارية ووكالة في حال كان مقدم الطلب وكيل عن المالك ).</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\">وبينتْ الهيئة بأنَّ العقارات المستفيدة في هذه الأحياء تزيد عن 22 ألف عقار، وأضافت بأنَّ السجلات العقارية التي بدأت تصدر اليوم في هذه الأحياء قد تضمنت بيانات وأوصاف العقار وحالته وكافة ما يتعلق به من حقوق والتزامات وتصرفات عقارية مرتبطة بالمعلومات الجيومكانية من خلال الرفع المساحي والإحداثيات الجغرافية للعقارات والتي تمت خلال الفترة الماضية.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\">&nbsp;</p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black; background: white;\">وأوضحت الهيئة بأنَّ \"</span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">مركز خدمة مستفيدي السجل العقاري\" في رويال مول\" بمدينة الرياض والذي يتم تشغيله عن طريق شركة \" السجل العقاري &ldquo;يستقبل المستفيدين طوال أيام العمل من الساعة التاسعة صباحاً وحتى الخامسة مساءً، حيث تم تجهيزه لتقديم الدعم للمستفيدين في تسجيل عقاراتهم، ومساعدتهم على استخدام الخدمات الإلكترونية من خلال أجهزة الخدمة الذاتية المتوفرة في المركز، إضافة إلى الرقم الموحد للاستفسارات<span style=\"mso-spacerun: yes;\">&nbsp;&nbsp; </span></span><span dir=\"LTR\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">199002</span><span lang=\"AR-SA\" style=\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\"> والذي تم تخصيصه للإجابة على أية استفسارات أو متابعة الطلبات.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تدعو ملاَّك العقارات في سبعة أحياء في الرياض تسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تدعو ملاَّك العقارات في سبعة أحياء في الرياض تسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم "}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"6efee9de-511e-3892-aa3b-27e6ff40f739","Alias":"الحمَّاد : 36 مليار ريال حجم عمليات القطاع العقاري في المنطقة الشرقية حتى نهاية الربع الثالث 2023م","Path":"/5eacdb6f-2cae-4d70-952c-f586dbd22e8e.config","Level":4048,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/5eacdb6f-2cae-4d70-952c-f586dbd22e8e.config","Node":{"Content":{"@Key":"5eacdb6f-2cae-4d70-952c-f586dbd22e8e","@Alias":"الحمَّاد : 36 مليار ريال حجم عمليات القطاع العقاري في المنطقة الشرقية حتى نهاية الربع الثالث 2023م","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"الحمَّاد : 36 مليار ريال حجم عمليات القطاع العقاري في المنطقة الشرقية حتى نهاية الربع الثالث 2023م"},"SortOrder":"48","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-10-31T17:23:44"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\">أكدَّ الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحمَّاد , أنَّ الدعم غير المحدود من القيادة الرشيدة للقطاع العقاري أسهم في رفع كفاءة السوق وتنظيمه وحوكمته , من خلال التشريعات العقارية , مما عزز فاعلية القطاع ليكون قطاعًا مُساهِمًا في الناتج المحلي الإجمالي، حيث بلغتْ مُساهمة الأنشطة العقارية فيه وفق إحصاءات الربع الثاني من العام الحالي 6.1 %، وبلغتْ مساهمة الأنشطة العقارية في الأنشطة غير النفطية منه 12.7</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">%.</span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وأوضح الحمَّاد خلال مشاركته في معرض ريستاتكس الشرقية العقاري 2023م ، أنَّ المنطقة الشرقية شهدتْ نموًا في مؤشراتها العقارية، حيث بلغ حجم العمليات العقارية في المنطقة منذ بداية العام الحالي وحتى نهاية الربع الثالث ما يقارب الـ36 مليار ريال ، وبلغت الصفقات العقارية ما يقارب 28 ألف صفقة عقارية بارتفاع تجاوز الـ 5% لنفس الفترة من العام الماضي ؛ منها 45% للعقارات التجارية و 39% للعقارات السكنية، فيما سجَّل نشاط الوساطة العقارية ترخيص أكثر من 3.785 وسيطا عقاريا من المُنشآت والأفراد في المنطقة الشرقية، مضيفاً أنَّ عدد المشاريع المُرخصة في نظام البيع والتأجير على الخارطة ( وافي) تجاوزت الـ 120 مشروعًا حتى الآن، بإجمالي وحدات عقاريه بلغ الـ 32 ألف وحدة، وعلى مستوى القطاع الإيجاري في المنطقة</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وأوضح رئيس الهيئة أنَّ عقود الإيجار الموثقة في المنطقة الشرقية قد تجاوز المليون ومائتي ألف عقد إيجار وهو ما يمثل 16% من العقود الإيجارية الموثقة في مدن المملكة ، فيما تم اعتماد أكثر من 1200 كيان عقاري في جمعيات اتحاد الملاك، وفيما يخص العقارات المفروزة جاءت المنطقة الشرقية من بين أعلى ثلاث مدن على مستوى المملكة بنحو 40 ألف وحدة مفروزة، وعزا هذا النمو في الأنشطة العقارية للمنطقة الشرقية إلى جاذبيتها للاستثمارات العقارية وما تحظى به من مقومات سياحية وتجارية وسكنية</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الحمَّاد : 36 مليار ريال حجم عمليات القطاع العقاري في المنطقة الشرقية حتى نهاية الربع الثالث 2023م"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الحمَّاد : 36 مليار ريال حجم عمليات القطاع العقاري في المنطقة الشرقية حتى نهاية الربع الثالث 2023م"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"4d524978-42ee-37ed-80ba-83f4fb257157","Alias":"هيئة العقار تطلق \"بروبتك السعودية \" الإثنين القادم بمشاركة دولية واسعة  ","Path":"/02fe7184-e8ad-4aaf-9c6b-0d746d0b61eb.config","Level":4049,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/02fe7184-e8ad-4aaf-9c6b-0d746d0b61eb.config","Node":{"Content":{"@Key":"02fe7184-e8ad-4aaf-9c6b-0d746d0b61eb","@Alias":"هيئة العقار تطلق \"بروبتك السعودية \" الإثنين القادم بمشاركة دولية واسعة  ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:09","NodeName":{"@Default":"هيئة العقار تطلق \"بروبتك السعودية \" الإثنين القادم بمشاركة دولية واسعة  "},"SortOrder":"49","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-03T15:31:08"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُدشن معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبد الله الحقيل يوم الإثنين القادم 6 نوفمبر 2023 م النسخة الأولى من مؤتمر \\\"بروبتك السعودية\\\" والذي تنظمه الهيئة العامة للعقار على مدى يومين في فندق الفورسيزونز بالعاصمة الرياض، ويستعرض المؤتمر أبرز المستجدات التقنية العقارية وتجارب المستفيدين وجلسات حوارية وورش عمل بمشاركة أكثر من 25 متحدثًا يمثلون 20 دولة من مختلف أنحاء العالم، ويصاحبه معرض تقني عقاري بمشاركة شركات ومنصات عقارية وتقنية محلية ودولية.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكدتْ الهيئة العامة للعقار بأنَّ الهدف الرئيسي من تنظيم \\\" بروبتك السعودية \\\" هو رفع مستوى المعرفة في مجال التقنية العقارية في السوق السعودي، وتعزيز الاستثمار في هذا المجال بالمملكة ، وأضافت ؛ بأنَّ المؤتمر يُعد فرصة لاجتماع المتخصصين والخبراء في التنقية مع المستثمرين ومقدمي الخدمات العقارية حيث يشارك في المؤتمر والمعرض المصاحب له عدد من المستثمرين وشركات التطوير العقاري والشركات التقنية العقارية والشركات الناشئة، كما يساهم <span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span>المؤتمر في استقطاب أحدث الممارسات والتجارب التقنية<span style=\\\"mso-spacerun: yes;\\\">&nbsp; </span>الدولية في المجال العقاري وعرضها في السوق السعودي للاستفادة منها من خلال عقد الشراكات بين المهتمين في هذا المجال .</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ويجمع المؤتمر في نسخته الأولى ثلاثة محاور رئيسية ؛ تتمثل في محور المنظومة العقارية التقنية والتي تشمل الجهات الحكومية المُشرعة للقطاع العقاري والداعمة للمشاريع الناشئة، المطورين</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقارين، المنصات العقارية،<span style=\\\"mso-spacerun: yes;\\\">&nbsp; </span>الشركات</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الناشئة</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">والتقنية العقارية ، </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span></span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">شركات</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الاستثمار</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الجريء، ومسرعات</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الأعمال ، مع محور التطبيقات العقارية ؛ التجارية ، السكنية ، السياحية ، واللوجستية بالإضافة إلى محور الحلول التقنية المتمثل في : إدارة</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الأملاك ، إدارة المرافق ، الذكاء</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الاصطناعي</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتحليل البيانات ، الواقع</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الافتراضي والمعزز ، تقنيات</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">التمويل</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">والرهن العقاري ، إنترنت</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الأشياء ، وتقنيات</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">البناء .</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة بأنَّ المؤتمر سوف يناقش خلال يومين عدة مواضيع من خلال الجلسات العامة وورش العمل أهمها: مفهوم</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">التقنية</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقارية</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">في</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">السعودية ، ودور</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الاستثمار</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">فيه</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">، التحديات والفرص في الاستثمار</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الجريء</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">في</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">السعودية ،<span style=\\\"mso-spacerun: yes;\\\">&nbsp; </span>دور</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">التقنية</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">في</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تطوير</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتفعيل</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">السياسات</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العامة، تمكين</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">القطاع</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقاري</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">في</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">المستقبل ، ابتكارات</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">البيئة</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الحضرية ، تأثير</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تطوير</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">المدن</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الذكية</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">على</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">القطاع</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقاري من</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=