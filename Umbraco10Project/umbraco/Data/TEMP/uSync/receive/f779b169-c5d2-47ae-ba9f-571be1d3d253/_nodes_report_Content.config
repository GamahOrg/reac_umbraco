":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":"نفّذت الهيئة العامة للعقار جولات رقابية في يناير استهدفت 6543 منشأة عقارية بالتعاون مع الوزارات المعنية. تعرف على أحدث الأنظمة العقارية وكيفية تجنب العقوبات"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"هيئة العقار\",\n  \"رقابة عقارية\",\n  \"تشريعات عقارية\",\n  \"وساطة عقارية\",\n  \"امتثال عقاري\",\n  \"بلاغات عقارية\",\n  \"مخالفات عقارية\",\n  \"رخصة وساطة عقارية\",\n  \"جودة التعاملات العقارية\",\n  \"شفافية السوق العقاري\"\n]"}},"newsDate":{"Value":{"#cdata-section":"2024-02-16T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"020e3d42-8527-4e95-ae22-fa3192bc5e04\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 150%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">نفّذت الهيئة العامة للعقار خلال شهر يناير الماضي أكثر من 33 جولة رقابية استهدفت زيارة 6543 منشأة عقارية بمشاركة وزارة الموارد البشرية والتنمية الاجتماعية، ووزارة الشؤون البلدية والقروية والإسكان؛ شملتْ: منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة، بهدف رفع مستوى الامتثال للتشريعات العقارية بشكل عام وبنظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين وتراخيص المُنشآت. </span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 150%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليها بالشراكة مع الجهات المعنية، وفيما يتعلق بمسار البلاغات فإنَّ إجمالي البلاغات التي تلقتها الهيئة 1219 بلاغاً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها، كما بلغ عدد الإعلانات العقارية التي تم مسحها للتحقق من امتثالها للنظام عبر المسار الإلكتروني أكثر من 6000 إعلانًا عقاريًا. وقد بلغ عدد المخالفات المرصودة عبر كافة المسارات أكثر من 6380 مخالفة عقارية شملت: ممارسة نشاط الوساطة العقارية أو الخدمات العقارية دون الحصول على ترخيص ساري المفعول، ممارسة نشاط الوساطة العقارية أو الخدمات العقارية بعد انتهاء الترخيص، إبرام تعاملات عقارية دون توثيقها في منصة الهيئة لإثباتها، إضافة إلى مخالفات تتعلق بأحكام الترخيص أو الإفصاح عن كامل بيانات العقارات المعروضة. </span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 150%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغاءه أو الغرامات المالية، مؤكدةً أنه يمكن مُضاعفة الغرامة المحكوم بها في حال تكرار المخالفة خلال ثلاث سنوات من ارتكابها، وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها</span><span>.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 150%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر بأنَّ رخصة فال العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت من ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة وتوعية المستفيدين، كما يرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، ويحد من النزاعات العقارية، ويحفظ حقوق المتعاملين، ويرفع شفافية السوق العقاري.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُنفذ 33 جولة رقابية الشهر الماضي بمشاركة عددًا من الجهات الحكومية لرفع مستوى الامتثال في السوق العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"181e96ba-c5a3-33d9-9a59-b6d50b8584e5","Alias":"اللوائح","Path":"/c332c79b-387d-428b-9194-0910837a19e6.config","Level":4001,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/c332c79b-387d-428b-9194-0910837a19e6.config","Node":{"Content":{"@Key":"c332c79b-387d-428b-9194-0910837a19e6","@Alias":"اللوائح","@Level":"4","Info":{"Parent":{"@Key":"92ba0fb3-29d5-49c2-b99e-522a10db9d05","#text":"الأنظمة واللوائح والأدلة"},"Path":"////","Trashed":"false","ContentType":"regulationsCategory","CreateDate":"2024-07-30T12:02:32","NodeName":{"@Default":"اللوائح","Name":[{"@Culture":"ar-jo","#text":"اللوائح"},{"@Culture":"en-us","#text":"Regulations"}]},"SortOrder":"1","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"fc15fcb8-18c1-4949-8cc4-f8fa3ee63610","#text":"RegulationsCategory"}},"Properties":{"contentBrief":{"Value":{"#cdata-section":"اللوائح"}},"contentTitle":{"Value":{"#cdata-section":"اللوائح"}},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"اللوائح"},{"@Culture":"en-us","#cdata-section":"Regulations"}]},"headerBa