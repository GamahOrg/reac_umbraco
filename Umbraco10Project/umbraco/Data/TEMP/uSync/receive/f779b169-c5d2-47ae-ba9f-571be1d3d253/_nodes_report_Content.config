},{"@Culture":"en-us","#text":"Event 3"}]},"SortOrder":"2","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"2023-09-09T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est labo o consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est labo</p>"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض"},{"@Culture":"en-us","#cdata-section":"Downtown Amman"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"f92affe8-ddf2-4b89-abdb-d605f55e5a3e\",\n    \"mediaKey\": \"71d271e0-2703-4e56-94c4-05ae9550d480\"\n  },\n  {\n    \"key\": \"4e5f2d3d-5d86-46b6-89b6-d05042576b20\",\n    \"mediaKey\": \"1813367c-bf07-44c2-a493-c101b9f24ce1\"\n  },\n  {\n    \"key\": \"7d255810-4e03-40fb-97d4-3ff85757b03a\",\n    \"mediaKey\": \"6cfe68a0-4150-4bea-aed7-cd971a0d0976\"\n  },\n  {\n    \"key\": \"9f9efb7b-69c7-4a22-beb2-46c27ef4b395\",\n    \"mediaKey\": \"31876fa2-3768-44a2-9b9d-7ad0577b1734\"\n  },\n  {\n    \"key\": \"5507a998-8a6d-4ad5-94f9-a719e79e5e02\",\n    \"mediaKey\": \"545d88f7-a426-4162-b456-b74ab2bf209b\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"مشاركة الهيئة العامة للعقار بمعرض ريستاتكس العقاري بالرياض"},{"@Culture":"en-us","#cdata-section":"Event 3"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"International event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"مشاركة الهيئة العامة للعقار بمعرض ريستاتكس العقاري بالرياض"},{"@Culture":"en-us","#cdata-section":"Event 3"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2019-10-09T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-09-08T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"Businesses"}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"4665499b-46bd-3448-b5b7-880291e5353c","Alias":"الهيئة العامة للعقار تُدشن منصتها الإلكترونية للمساهمات العقارية","Path":"/6903408f-a789-4822-919e-19ca4425971d.config","Level":4002,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6903408f-a789-4822-919e-19ca4425971d.config","Node":{"Content":{"@Key":"6903408f-a789-4822-919e-19ca4425971d","@Alias":"الهيئة العامة للعقار تُدشن منصتها الإلكترونية للمساهمات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-02-14T19:45:39","NodeName":{"@Default":"الهيئة العامة للعقار تُدشن منصتها الإلكترونية للمساهمات العقارية"},"SortOrder":"2","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-02-14T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1ec18084-60eb-4b1e-a8fa-7b9b2d1adc90\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p>دشّنت الهيئة العامة للعقار برعاية وحضور معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة الأستاذ ماجد بن عبد الله الحقيل، ومعالي رئيس مجلس إدارة هيئة السوق المالية الأستاذ محمد بن عبد الله القويز، ا<a href=\\\"https://wafiservices.rega.gov.sa/real-estate-contributions-auth/login\\\">لمنصة الإلكترونية الجديدة لاستقبال طلبات التأهيل والترخيص للمساهمات العقارية</a>.<br>وأوضحت الهيئة أنّ المنصة ستمكن المطورين من استخراج التراخيص اللازمة لبدء أعمال المساهمات العقارية من خلال التقديم الإلكتروني لطلب التأهيل أو الترخيص للمساهمة العقارية، وأن المنصة ستتيح إنشاء ملف موحد للمنشأة يحفظ جميع معلوماتها وبياناتها ويمكنها من الاطلاع على تراخيصها ومتابعة سير طلباتها، كما سيسهل ملف المنشأة استرجاعها للمعلومات والبيانات لتقديم أي طلبات مستقبلية دون الحاجة لإعادة تسجيلها.<br>وأشار الرئيس التنفيذي للهيئة عبدالله بن سعود الحماد، إلى أنّ نظام المساهمات العقارية يأتي لرفع كفاءة الاستثمار في صناعة التطوير العقاري، وتحسين المنتج العقاري الذي من شأنه زيادة المعروض من المنتجات العقارية التجارية والسكنية، وزيادة قنوات التمويل للمطورين العقاريين، والقنوات الاستثمارية للراغبين في الاستثمار، إضافة إلى خلق فرص استثمارية واعدة للمُنشآت العقارية الصغيرة والمتوسطة، واستدامة نشاط التطوير العقاري وفتح فرص عمل في السوق السعودي.<br>وأكّد الحماد أنّ المنصة الإلكترونية للمساهمات العقارية تأتي ضمن جهود الهيئة لتنظيم القطاع العقاري ورقمنة العمليات والإجراءات وتسهيل تقديم الطلبات ومتابعتها، حيث تمت أتمتة جميع العمليات والإجراءات الخاصة بالمساهمات العقارية بما يضمن حوكمتها والرقابة عليها وتعزيز ثقة المستثمرين في القطاع العقاري بالمملكة العربية السعودية.<br>يُذكر أنّ نظام المساهمات العقارية يأتي ضمن الأنظمة والتشريعات التي أطلقتها الهيئة لتنظيم القطاع العقاري بمختلف أنشطته وممارساته مما يسهم في توفير بيئة عقارية استثمارية آمنة ومستقرة، لديها شفافية وكفاءة عالية لمزاولي النشاطات العقارية، كما تسم في تسريع وتيرة الإنشاءات وزيادة المعروض العقاري السكني والتجاري والاستثماري والسياحي وغيرها، وخلق مجتمعات حيوية مرنة ومستدامة وملتزمة بالمعايير البيئية والمجتمعية.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُدشن منصتها الإلكترونية للمساهمات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d8af35c6-0a85-303e-a138-36f5daecbe1a","Alias":"البيئة التنظيمية التجريبية","Path":"/36652cc6-eff7-4f20-be38-16b554f1146c.config","Level":4002,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/36652cc6-eff7-4f20-be38-16b554f1146c.config","Node":{"Content":{"@Key":"36652cc6-eff7-4f20-be38-16b554f1146c","@Alias":"البيئة التنظيمية التجريبية","@Level":"4","Info":{"Parent":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","#text":"مركز بروتيك السعودية"},"Path":"////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-29T13:53:41","NodeName":{"@Default":"البيئة التنظيمية التجريبية"},"SortOrder":"2","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>تتيح هذه المبادرة للشركات والمبتكرين في مجال العقار فرصة تجربة تقنياتهم ومنتجاتهم وتطوير أفكارهم، بالإضافة لتعزيز التفاعل بين القطاعين العام والخاص<span>&nbsp; مما يسهم في تعزيز الابتكار والنمو في القطاع</span> العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\",\n      \"title\": \"أهداف المبادرة \",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز التفاعل والتعاون بين القطاعين العام والخاص.</li>\\n<li class=\\\"O0\\\">تمكين الشركات من اختبار خدماتها وابتكاراتها بشكل عملي.</li>\\n<li class=\\\"O0\\\">تطوير أطر تنظيمية تعكس التقدم التقني وتحقق التوازن بين الابتكار والتنظيم في قطاع العقارات.</li>\\n<li class=\\\"O0\\\">تحقيق توازن فعّال بين الابتكار والامتثال التنظيمي في قطاع العقار.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\",\n      \"title\": \" الفئات المسموح لها بالتقدم\",\n      \"content\": {\n        \"markup\": \"<ul style=\\\"list-style-type: square;\\\">\\n<li>شركات التقنية الناشئة:</li>\\n</ul>\\n<p style=\\\"padding-left: 80px;\\\">شركات مطورة لحلول تقنية جديدة أو خدمات بهدف استخدامها في القطاع العقاري سواءً كانت شركات محلية أو شركات عالمية وصدر أو لم يصدر لها تشريع ينظم عملها.</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>نماذج العمل</li>\\n</ul>\\n<p style=\\\"padding-left: 40px;\\\">نماذج الأعمال التي تتضمن حلول مبتكرة أو تقنيات جديدة وتتعلق بأنشطة العقار صدرت لها لوائح &nbsp;تنظيمية أو تتطلب إصدار لوائح تنظيمية جديدة تتواءم مع طبيعة عملها.</p>\\n<p style=\\\"text-align: center;\\\"><strong>أخر موعد للتقديم: 31/01/2025</strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"umb://document/644430d0b05c4e27babd320927603de8\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي البيئة التنظيمية التجريبية وما الغرض منه؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تمثل بيئة تسمح للشركات والمبتكرين في مجال العقارات بتجربة تقنياتهم ومنتجاتهم بحرية تنظيمية تحت إشراف الهيئة العامة للعقار ، وتهدف إلى تعزيز التفاعل بين القطاعين العام والخاص، مما يتيح للشركات اختبار خدماتها وابتكاراتها بشكل يواءم الأطر القانونية الحالية ، مما يمكن الهيئة العامة للعقار من تقييم الابتكارات وتطوير أطر تنظيمية تعكس التقدم التقني وتحقق توازناً بين الابتكار والتنظيم في قطاع العقارات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لماذا تقدم الهيئة العامة للعقار البيئة التنظيمية التجريبية؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span> </span>توفر البيئة التنظيمية التجريبية للشركات فرصة للتعاون مع الجهات الحكومية لتحديد الإطار التنظيمي الذي من شأنه أن يدعم العمليات التجارية لهذه الشركات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>    رواد الأعمال </span>و أصحاب الشركات الناشئة الصغيرة و المتوسطة<span>  المحلية </span>و الدولية</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل هناك معايير للقبول ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم<span>  ، تقديم عرض </span>و نموذج تفصيلي عن خطة<span>  العمل </span>و يتم دارسته</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>كيف سوف يتم اشعار القبول للبيئة التنظيمية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">عبر البريد الالكتروني</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل تؤدي البيئات التنظيمية التجريبية<span>  إلى تخفيف اللوائح التنظيمية وتقليل </span>و تساهم في خلق أنظمة داعمة؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لمَاذا على الشركات القائمة على الابتكار الالتحاق بالبيئة التنظيمية التجريبية ؟ </li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">لتجربة النموذج المبتكر و هل الأنظمة تساعد على استكمال الإجراءات القانونية و التشريعية من ناحية التراخيص</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي المدة<span>  المستغرقة لاختبار النموذج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">12 شهر</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مفهوم<span>  الاختبار الناجح للخدمات </span>و المنتجات المبتكرة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">يحدد<span>  المتقدمون المعايير الخاصة  بخدماتهم </span>و منتجاتهم المبتكرة وكذلك سيحدد فريق العمل معايير معينة للقبول<span>  </span></p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>في حال نجحت التجارب هل سيتم الحصول على الترخيص بشكل مباشر ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تتم عبر<span>  عدة مراحل وسيتم اخطار المتأهلين حولها</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"البيئة التنظيمية التجريبية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"12bd1fe8-fd34-3d57-b348-a9b72e2a3171","Alias":"القمة العالمية للتقنية العقارية","Path":"/c3395462-6835-42fd-8c13-78dd0fd2a0db.config","Level":4003,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/c3395462-6835-42fd-8c13-78dd0fd2a0db.config","Node":{"Content":{"@Key":"c3395462-6835-42fd-8c13-78dd0fd2a0db","@Alias":"القمة العالمية للتقنية العقارية","@Level":"4","Info":{"Parent":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","#text":"مركز بروتيك السعودية"},"Path":"////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-10-22T05:59:06","NodeName":{"@Default":"القمة العالمية للتقنية العقارية"},"SortOrder":"3","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/1952c746e3554815bbda233b9a5b073c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0837774f0a264d5385407454bc632bf7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c32f8bc8d7c04c8d971d68b3c34606c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2c1ada7384da4ee0b37ee0e883974392\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/1952c746e3554815bbda233b9a5b073c\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p><span>&nbsp;</span>قمة تستضيف أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز ريادة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/0837774f0a264d5385407454bc632bf7\",\n      \"title\": \"أهداف المبادرة\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز مكانة المملكة العربية السعودية كمركز رائد في التقنية العقارية .</li>\\n<li class=\\\"O0\\\">فتح الفرص للشركات العالمية للاستثمار محلياً في التقنية العقارية.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات التقنية<span>&nbsp; من خلال استقطاب الخبرات العالمية.</span></li>\\n<li class=\\\"O0\\\">الارتقاء بريادة الأعمال المحلية.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/c32f8bc8d7c04c8d971d68b3c34606c2\",\n      \"title\": \"تاريخ ومكان إقامة الحدث\",\n      \"content\": {\n        \"markup\": \"<p>المكان : <span>&nbsp;( فندق موفنبيك الرياض</span>)</p>\\n<p>التاريخ : 27 – 28 أكتوبر 2024 م<span>&nbsp; </span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/2c1ada7384da4ee0b37ee0e883974392\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>اين تقام القمة العالمية للبروبتك؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">في مدينة الرياض بتاريخ 27 و28 أكتوبر في فندق الموفينبيك</div>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي<span>&nbsp; قمة&nbsp; البروبتيك؟</span></li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\"><span>&nbsp; قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.</span></div>\\n<div style=\\\"padding-right: 40px;\\\"><span></span></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\"><span>رواد الاعمال&nbsp;</span>و أصحاب الشركات الناشئة و المتوسطة<span>&nbsp; المحلية </span>و الدولية<span>&nbsp; </span>و المهتمين في التقنية العقارية</div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يتطلب التسجيل للحضور الى القمة؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\"><span>نعم&nbsp;</span></div>\\n<div style=\\\"padding-right: 40px;\\\"><span></span></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li><span>هل هناك رسوم للمشاركة ؟</span></li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">اذا<span>&nbsp; زائر لا يوجد رسوم ,&nbsp; الرسوم على العارضين </span>و الرعاة</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد جدول للمتحدثين ؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">نعم</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد جدول لورش العمل ؟&nbsp;</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">نعم</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد رسوم لحضور ورش العمل ؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">لا</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ماهي الجهات المشاركة؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">يمكن مراجعة الموقع الخاص بالحدث <br><a rel=\\\"noopener\\\" href=\\\"https://globalproptechsummit.com\\\" target=\\\"_blank\\\">https://globalproptechsummit.com</a></div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>كيف أحصل على اجندة القمة؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">من خلال الرابط الإلكتروني التالي :</div>\\n<div style=\\\"padding-right: 40px;\\\"><a rel=\\\"noopener\\\" href=\\\"https://globalproptechsummit.com\\\" target=\\\"_blank\\\">https://globalproptechsummit.com</a><br><br></div>\\n<div></div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"القمة العالمية للتقنية العقارية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"40683966-3576-3d0a-9d26-33e60871f780","Alias":"ضوابط","Path":"/3be850ea-467f-4ea1-bf3f-5d6a2657243d.config","Level":4003,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3be850ea-467f-4ea1-bf3f-5d6a2657243d.config","Node":{"Content":{"@Key":"3be850ea-467f-4ea1-bf3f-5d6a2657243d","@Alias":"ضوابط","@Level":"4","Info":{"Parent":{"@Key":"92ba0fb3-29d5-49c2-b99e-522a10db9d05","#text":"الأنظمة واللوائح والأدلة"},"Path":"////","Trashed":"false","ContentType":"regulationsCategory","CreateDate":"2024-08-04T13:09:57","NodeName":{"@Default":"ضوابط","Name":[{"@Culture":"ar-jo","#text":"ضوابط"},{"@Culture":"en-us","#text":"Controls"}]},"SortOrder":"3","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"fc15fcb8-18c1-4949-8cc4-f8fa3ee63610","#text":"RegulationsCategory"}},"Properties":{"contentBrief":{"Value":{"#cdata-section":"ضوابط"}},"contentTitle":{"Value":{"#cdata-section":"ضوابط"}},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"ضوابط"},{"@Culture":"en-us","#cdata-section":"Controls"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"ضوابط"},{"@Culture":"en-us","#cdata-section":"Controls"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"ضوابط"},{"@Culture":"en-us","#cdata-section":""}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cd