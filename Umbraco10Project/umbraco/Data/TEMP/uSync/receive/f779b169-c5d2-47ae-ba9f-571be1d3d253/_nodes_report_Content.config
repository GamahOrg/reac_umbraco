4936-b4f1-f72d6c625714.config","Level":4025,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f487a78a-225b-4936-b4f1-f72d6c625714.config","Node":{"Content":{"@Key":"f487a78a-225b-4936-b4f1-f72d6c625714","@Alias":"رئيس الهيئة العامة للعقار يفتتح النسخة الثانية من معرض مسكن العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-21T11:32:13","NodeName":{"@Default":"رئيس الهيئة العامة للعقار يفتتح النسخة الثانية من معرض مسكن العقاري"},"SortOrder":"25","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-07T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"be830e45-97c8-43f2-9d5a-b133bff3dfcc\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">افتتح الرئيس التنفيذي للهيئة العامة للعقار م. عبدالله بن سعود الحماد النسخة الثانية من معرض مسكن العقاري في العاصمة السعودية الرياض اليوم الخميس 7 ديسمبر 2023م و الذي يستمر لمدة ثلاثة أيام في فندق الفورزسيزون بمشاركة عدد من الجهات الحكومية وشركات التطوير العقاري والقنوات التمويلية.&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">يأتي المعرض امتدادًا للجهود المبذولة لزيادة المعروض العقاري وتسهيل رحلة تملك المواطنين لمساكنهم، حيث يتيح المعرض لزواره فرصة استكشاف التنوع العقاري السكني بمختلف أحجامه وأنواع، وإمكانية التملك المباشر للوحدات السكنية والأراضي المعروضة خلال فترة إقامة المعرض والبالغ عددها الـ 60 &nbsp;&nbsp;ألف وحدة سكنية.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأكدت الأستاذة العنود الحمالي مديرة الشركة المنظمة للمعرض بأنَّ الراغبين في التملك ستتاح لهم الاستفادة من العروض التي تقدمها الشركات العقارية خلال فترة المعرض والذي يصاحبه العديد من الفعاليات والإطلاقات الجديدة للمشاريع العقارية حيث يتوفر في المعرض منطقة خاصة بالتوثيق وأخرى خاصة بعروض التمويل، وأضافت بأنَّ الوحدات السكنية المعروضة في أجنحة المشاركين تتجاوز قيمتها السوقية 7 مليار ريال.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">من جهة أخرى أوضحت الحمالي بأنَّ رحلة الزائر للمعرض تتضمن التعريف بالأنظمة العقارية واشتراطات ممارسة الأنشطة العقارية مؤكدة بأنَّ النسخة الثانية من مسكن العقاري جاءت هذا العام لتكون إضافة في سوق العقارات السعودية والذي يعد من أكبر الأسواق في الشرق الأوسط من خلال إتاحة التملك المباشر من شركات التطوير العقاري المشاركة.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"رئيس الهيئة العامة للعقار يفتتح النسخة الثانية من معرض مسكن العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"رئيس الهيئة العامة للعقار يفتتح النسخة الثانية من معرض مسكن العقاري"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"2046428d-cf25-3120-9fc2-e689d3488f89","Alias":"مؤتمر الاتحاد الدولي للعقار","Path":"/ab41a794-b163-42f4-a412-5a6ad701b508.config","Level":4025,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ab41a794-b163-42f4-a412-5a6ad701b508.config","Node":{"Content":{"@Key":"ab41a794-b163-42f4-a412-5a6ad701b508","@Alias":"مؤتمر الاتحاد الدولي للعقار","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4