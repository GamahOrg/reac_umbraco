f-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2020-11-10T22:45:28"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<div class=\"OutlineElement Ltr  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow: visible; cursor: text; clear: both; position: relative; direction: ltr; font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;\"><p class=\"Paragraph  BCX0 SCXW120901245\" lang=\"EN-US\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext; text-align: right;\" xml:lang=\"EN-US\"><span class=\"TextRun  BCX0 SCXW120901245\" lang=\"EN-US\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: rgb(51, 51, 51); font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">&nbsp;</span></span><span class=\"EOP  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: rgb(51, 51, 51);\" data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p></div><p style=\"text-align: right;\">&nbsp;</p><div class=\"OutlineElement Ltr  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow: visible; cursor: text; clear: both; position: relative; direction: ltr; font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;\"><p class=\"Paragraph  BCX0 SCXW120901245\" lang=\"EN-US\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext; text-align: right;\" xml:lang=\"EN-US\"><span class=\"TextRun  BCX0 SCXW120901245\" lang=\"EN-US\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: rgb(51, 51, 51); font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">وقعت وزارة الموارد البشرية والتنمية الاجتماعية والهيئة العامة للعقار ،مذكرة تفاهم تهدف إلى دعم وتشجيع المسؤولية الاجتماعية وإيجاد شراكة مجتمعية فاعلة تحفز القطاع العام والخاص وغير الربحي للعمل بتكامل لدعم وإنجاح برامج ومبادرات المسؤولية الاجتماعية، وذلك برعاية معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك.</span></span><span class=\"LineBreakBlob BlobObject DragDrop  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: WordVisiCarriageReturn_MSFontService, Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: rgb(51, 51, 51);\"><span class=\"BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; white-space: pre !important;\">&nbsp;</span><br class=\"BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; white-space: pre !important;\"></span><span class=\"TextRun  BCX0 SCXW120901245\" lang=\"EN-US\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: rgb(51, 51, 51); font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">وتتضمن مذكرة التفاهم التي وقعها نائب محافظ الهيئة للتخطيط الإستراتيجي وإدارة المشاريع المهندس عبد العزيز المحيميد، ووكيل وزارة الموارد البشرية لتنمية المجتمع أحمد بن صالح بن ماجد، تقديم ورش عمل تعريفية للشركات والمنشآت العقارية حول مفاهيم المسؤولية الاجتماعية، وكيفية العمل والقيام بمسؤولياتها الاجتماعية، مع تقديم باقة من المزايا والامتيازات لقطاع الشركات العقارية، وذلك بحسب الخدمات المقدمة منها ودورها في توظيف الكوادر الوطنية، واستخدام المحتوى المحلي، والإسهام في دعم الأعمال والمبادرات المجتمعية، والمشاركة في المنصات المتاحة والخاصة بالمسؤولية الاجتماعية.</span></span><span class=\"LineBreakBlob BlobObject DragDrop  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: WordVisiCarriageReturn_MSFontService, Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: rgb(51, 51, 51);\"><span class=\"BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; white-space: pre !important;\">&nbsp;</span><br class=\"BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; white-space: pre !important;\"></span><span class=\"TextRun  BCX0 SCXW120901245\" lang=\"EN-US\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: rgb(51, 51, 51); font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" xml:lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">مما يذكر أن الاتفاقية تأتي استكمالًا للجهود المشتركة بين الوزارة والهيئة لتنفيذ إستراتيجيتهما وتطوير التعاون بينهما في تحقيق برامج ومبادرات المسؤولية الاجتماعية وتعظيم أثرها، وتعزيز مبدأ المشاركة الجماعية الإيجابية وتحمل المسؤوليات، وتحسين كفاءة أداء القطاع العقاري وتحقيق استدامته وتمكينه ورفع مساهماته المجتمعية.</span></span><span class=\"EOP  BCX0 SCXW120901245\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: rgb(51, 51, 51);\" data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\">&nbsp;</span></p></div>"}},"newsTitle":{"Value":{"#cdata-section":"توقيع اتفاقية مع وزارة الموارد البشرية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"توقيع اتفاقية مع وزارة الموارد البشرية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a452403e-90c6-3c29-b7d9-eb977266de1a","Alias":"معالي محافظ هيئة عقارات الدولة\r\n يزور مقر هيئة العقار  ","Path":"/ceff774a-4b3f-4d7f-bbc4-83a308d9022d.config","Level":4198,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ceff774a-4b3f-4d7f-bbc4-83a308d9022d.config","Node":{"Content":{"@Key":"ceff774a-4b3f-4d7f-bbc4-83a308d9022d","@Alias":"معالي محافظ هيئة عقارات الدولة\r\n يزور مقر هيئة العقار  ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:54","NodeName":{"@Default":"معالي محافظ هيئة عقارات الدولة\r\n يزور مقر هيئة العقار  "},"SortOrder":"198","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2020-11-11T07:53:16"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c7a2c773-1bfd-493b-9c1d-a7fcb7e208e0\",\n    \"mediaKey\": \"c4dca644-6957-4d56-8b7a-1d2f07170aa1\"\n  },\n  {\n    \"key\": \"db4bcb43-7564-4a04-9bcf-ad46fe956327\",\n    \"mediaKey\": \"b5fa1344-08c9-45e1-a30a-2b0553dab5a5\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<div class=\"OutlineElement Ltr  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow: visible; cursor: text; clear: both; position: relative; direction: ltr; font-family: 'Segoe UI', 'Segoe UI Web', Arial, Verdana, sans-serif; font-size: 12px;\">\n<p style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext; text-align: right;\" class=\"Paragraph  BCX0 SCXW42267651\"> </p>\n</div>\n<p style=\"text-align: right;\"> </p>\n<div class=\"OutlineElement Ltr  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow: visible; cursor: text; clear: both; position: relative; direction: ltr; font-family: 'Segoe UI', 'Segoe UI Web', Arial, Verdana, sans-serif; font-size: 12px;\">\n<p style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext; text-align: right;\" class=\"Paragraph  BCX0 SCXW42267651\"><span class=\"TextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: #333333; font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" lang=\"AR-SA\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">بحث معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك , أوجه التعاون مع معالي محافظ الهيئة العامة لعقارات الدولة الأستاذ إحسان بن عباس بافقيه لتنظيم النشاط العقاري الحكومي وغير الحكومي والإشراف عليه وتطويره وزيادة كفاءته وتشجيع الاستثمار فيه , وتحقيق التكامل بين الهيئتين لتطبيق فعال لحوكمة القطاع العقاري وزيادة فاعلية السوق العقاري وتمكينه واستدامته، وتعاون الهيئتين في مجال اختصاصهما في حصر العقارات واتخاذ الاجراءات اللازمة للتسجيل العيني لعقارات الدولة ولعقارات الأفراد والقطاع الخاص وتوثيقها وحفظها في قاعدة بيانات جغرافية.</span></span><span class=\"LineBreakBlob BlobObject DragDrop  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: WordVisiCarriageReturn_MSFontService, Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: #333333;\"><span class=\"BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; white-space: pre !important;\"> </span><br class=\"BCX0 SCXW42267651\" /></span><span class=\"TextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: #333333; font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" lang=\"AR-SA\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">كما ناقشا مجالات التعاون في إنشاء خارطة تفاعلية لمعرفة توزيع العقارات على مستوى المملكة وبناء قاعدة بيانات جغرافية مدعمة بكافة البيانات والمعلومات ذات العلاقة والتي تمكن من حماية العقارات وزيادة موثوقيتها وإصدار التقارير التي من شأنها دعم القرار والمساعدة في وضع الخطط التطويرية.</span></span><span class=\"LineBreakBlob BlobObject DragDrop  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: WordVisiCarriageReturn_MSFontService, Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: #333333;\"><span class=\"BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; white-space: pre !important;\"> </span><br class=\"BCX0 SCXW42267651\" /></span><span class=\"TextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: #333333; font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" lang=\"AR-SA\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">جاء ذلك خلال لقاء جمعهما اليوم بمقر الهيئة العامة للعقار , حيث زار بافقيه مركز خدمة الشركاء في الهيئة واطلع على الخدمات التى يقدمها المركز للمستفيدين من منظومة الهيئة والتي تشمل مركز التحكيم العقاري، وأعضاء جمعيات ملاك الوحدات العقارية، وفرز الوحدات، والمنصة الرقمية للمؤشرات العقارية، ولجنة معالجة أخطاء تسجيل الملكية العقارية، والمستفيدين من خدمات تصنيف المنشآت العقارية، وخدمة التدريب والتأهيل للمهنيين العقاريين التي يقدمها المعهد العقاري السعودي.</span></span><span class=\"LineBreakBlob BlobObject DragDrop  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: WordVisiCarriageReturn_MSFontService, Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: #333333;\"><span class=\"BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; white-space: pre !important;\"> </span><br class=\"BCX0 SCXW42267651\" /></span><span class=\"TextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: #333333; font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" lang=\"AR-SA\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">وأكد معالي محافظ الهيئة العامة للعقار أن هذه الزيارة تأتي امتدادا للتعاون وتكامل العمل وتنسيق أداء المهام وتوحيد جهود الهيئتين لخدمة </span></span></p>\n<p style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; overflow-wrap: break-word; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext; text-align: right;\" class=\"Paragraph  BCX0 SCXW42267651\"><span class=\"TextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: #333333; font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" lang=\"AR-SA\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">هدف مشترك هو تنظيم وتحسين كفاءة القطاع العقاري</span></span><span class=\"TextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; color: #333333; font-size: 13.5pt; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; line-height: 23.7417px; font-variant-ligatures: none !important;\" lang=\"EN-US\" data-contrast=\"none\"><span class=\"NormalTextRun  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; background-color: inherit;\">.</span></span><span class=\"EOP  BCX0 SCXW42267651\" style=\"margin: 0px; padding: 0px; user-select: text; -webkit-user-drag: none; -webkit-tap-highlight-color: transparent; font-size: 13.5pt; line-height: 23.7417px; font-family: Calibri, Calibri_EmbeddedFont, Calibri_MSFontService, sans-serif; color: #333333;\" data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\n</div>"}},"newsTitle":{"Value":{"#cdata-section":"معالي محافظ هيئة عقارات الدولة\n يزور مقر هيئة العقار  "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"معالي محافظ هيئة عقارات الدولة\n يزور مقر هيئة العقار  "}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e986e881-a523-3b0d-9019-0d0e236a0d6e","Alias":"الهيئة العامة للعقار تدشن مركز التحكيم العقاري","Path":"/6e087af9-dfd0-4370-a9fc-e972a59a7ad4.config","Level":4199,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6e087af9-dfd0-4370-a9fc-e972a59a7ad4.config","Node":{"Content":{"@Key":"6e087af9-dfd0-4370-a9fc-e972a59a7ad4","@Alias":"الهيئة العامة للعقار تدشن مركز التحكيم العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:53","NodeName":{"@Default":"الهيئة العامة للعقار تدشن مركز التحكيم العقاري"},"SortOrder":"199","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-11-16T16:40:07"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"4538d94f-b76a-4e83-b83d-e2b1e22a40b7\",\n    \"mediaKey\": \"16aae290-6f71-4192-bfde-7fa3f259f3bc\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p> </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">يدشن معالي وزير العدل الدكتور وليد بن محمد الصمعاني ومعالي وزير الإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبدالله الحقيل ومعالي محافظ الهيئة الأستاذ عصام بن حمد المبارك غداً الخميس الثامن عشر من شهر صفر المركز السعودي للتحكيم العقاري، ويهدف المركز  إلى مساندة القضاء من خلال لجوء الراغبين من المتعاملين في القطاع العقاري إلى خيارات الصلح والتحكيم في القضايا العقارية ومعالجتها بإجراءات إلكترونية سريعة، إبتداءً بقضايا الايجار، وقضايا ملاك الوحدات السكنية أو التجارية المشتركة، وسيطلق معالي الوزراء في حفل افتتاح المركز خدمة الربط الالكتروني بين مركز المصالحة بوزارة العدل والمركز ، وكذلك خدمة الربط الالكتروني مع برنامج إيجار وبرنامج اتحاد الملاك، وبما يساعد المركز على تقديم خدماته لكافة المستفيدين الكترونياً. </p>\n<p> </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">كما يعمل المركز على توعية المستفيدين والتعريف بخدماته لنشر  ثقافة الصلح والتحكيم، وأهمية وفائدة خيار التحكيم من خلال المركز السعودي للتحكيم العقاري في عقود الإيجار الموحدة.</p>\n<p> </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> </p>\n<p> </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">ويسعى المركز  إلى تفعيل دوره في تشجيع الوسائل المساندة للقضاء مثل الصلح والتحكيم لتحسين بيئة الأعمال وتنوع الخدمات التي تقدم للمتعاملين في القطاع العقاري</p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تدشن مركز التحكيم العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تدشن مركز التحكيم العقاري"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"4391751e-4d27-32c8-8c15-8ef4a57c800f","Alias":"المعهد العقاري السعودي يعقد الاجتماع الأول لمجلس إدارته ويهدف إلى تدريب 40 ألف متدرب","Path":"/c64c2f6a-4ad7-4989-8abc-d6d45dba07ac.config","Level":4200,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/c64c2f6a-4ad7-4989-8abc-d6d45dba07ac.config","Node":{"Content":{"@Key":"c64c2f6a-4ad7-4989-8abc-d6d45dba07ac","@Alias":"المعهد العقاري السعودي يعقد الاجتماع الأول لمجلس إدارته ويهدف إلى تدريب 40 ألف متدرب","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"المعهد العقاري السعودي يعقد الاجتماع الأول لمجلس إدارته ويهدف إلى تدريب 40 ألف متدرب"},"SortOrder":"200","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:56:29"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"aab5f91b-6750-4d93-b537-ab5c8a0ca4db\",\n    \"mediaKey\": \"49696c5c-0f12-4faa-821a-11af6a15167b\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"margin-top: 0in; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">عقد مجلس إدارة المعهد العقاري السعودي اجتماعه الأول هذا اليوم الأحد 13 شعبان 1439 هــ الموافق 29 أبريل 2018م برئاسة معالي محافظ الهيئة العامة للعقار رئيس مجلس إدارة المعهد العقاري السعودي الأستاذ عصام بن حمد المبارك.</span></p>\n<p style=\"margin-top: 0in; text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; box-sizing: border-box; margin-bottom: 1rem; font-size: 1rem; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">وأكد المبارك على دور المعهد العقاري السعودي في بناء قدرات القطاع العقاري، من خلال تدريب الكوادر البشرية السعودية في مختلف الأنشطة العقارية وتأهيلهم لدخول سوق العمل في المملكة، وثمن مجلس الإدارة مبادرة تأسيس المعهد، والبرامج التدريبية والشهادات الاحترافية التي يمنحها في مجال القطاع العقاري. </span></span></p>\n<p style=\"margin-top: 0in; text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; box-sizing: border-box; margin-bottom: 1rem; font-size: 1rem; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">واستعرض المجلس أبرز الإنجازات التي تم تحقيقها حتى نهاية الربع الأول من العام الحالي 2018 حيث بلغ عدد المتدربين 999 متدرب، من خلال 33 دورة تدريبية نفذت في 9 مدن في المملكة، وشملت عدداً من التخصصات العقارية هدفت إلى بناء قدرات القطاع والمساهمة في توفير فرص عمل في الأنشطة مثل الوساطة العقارية وإدارة اتحادات الملاك وإدارة المرافق وفحص المباني والبيع على الخارطة. كما ناقش المجلس استراتيجية المعهد وخطة التحول المستقبلية ، والتي تهدف  إلى تدريب 40 ألف متدرب، لتأهيلهم للعمل في السوق العقاري السعودي، ووبناء نظام ضمان مراقبة الجودة ووالتميز التعليمي، وأبرام عدد من الشراكات المحلية والدولية، وتأسيس نظام الاعتماد للتراخيص والشهادات.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"المعهد العقاري السعودي يعقد الاجتماع الأول لمجلس إدارته ويهدف إلى تدريب 40 ألف متدرب"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"المعهد العقاري السعودي يعقد الاجتماع الأول لمجلس إدارته ويهدف إلى تدريب 40 ألف متدرب"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"3aa9ff6f-d359-3db0-be4d-0ec39ab3539e","Alias":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة","Path":"/db49e816-f957-4a7f-a27c-467a02a09577.config","Level":4201,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/db49e816-f957-4a7f-a27c-467a02a09577.config","Node":{"Content":{"@Key":"db49e816-f957-4a7f-a27c-467a02a09577","@Alias":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة"},"SortOrder":"201","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:58:51"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"7755698f-6203-41fd-9caa-721993ca8a7b\",\n    \"mediaKey\": \"474d257b-57cf-430b-afac-ceed61b54545\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">نظمت اللجنة العقارية في الغرفة التجارية في محافظة الأحساء لقاءً مفتوحاً أمس الأول (الخميس) مع معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك، الذي تحدث عن دور الهيئة العامة للعقار في تطوير وتنمية القطاع العقاري.</span></p>\n<p style=\"margin-top: 0in; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed; box-sizing: border-box; margin-bottom: 1rem; font-size: 1rem; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">وتحدث معالي المحافظ عن خطة عمل الهيئة ودورها القادم لتحقيق رؤيتها بأن يكون القطاع العقاري السعودي حيوياً وجاذباً ويتميز بالثقة والابتكار، والمشاريع المستقبلية التي ستطلقها الهيئة، من أجل تنظيم القطاع العقاري غير الحكومي، كما استعرض خطتها للخمس أعوام القادمة والتي تعتمد على قاعدتين رئيسيتين هما: التسجيل العيني للعقار والتخطيط والموافقات، وخمسة مسارات هي: توفير شفافية السوق، وبناء القدرات وتحفيز الاستثمار ورعاية الجهات المعنية والتدقيق والتنفيذ.</span></span><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\">  </span></span></p>\n<p style=\"margin-top: 0in; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed; box-sizing: border-box; margin-bottom: 1rem; font-size: 1rem; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">وقال المبارك: \"عملت الهيئة خلال الفترة الماضية على بناء قدراتها البشرية والتقنية واستهداف الأنشطة المحددة في خطة عملها بدءاً من القاعدة الرئيسية لها: التسجيل العيني للعقار\"، مشيراً إلى أن الهيئة نظمت ستة ورش عن التسجيل العيني بمشاركة ممثلين 23 جهة حكومية و15 جهة من القطاع الخاص وخبراء دوليين ومحليين، وعملت على تقييم الوضع الحالي للتسجيل العيني ودراسة أفضل الممارسات الدولية والتجارب السابقة، وإعادة هندسة إجراءات التسجيل العيني لرفع الكفاءة وتقليص المدة وتحسين التنسيق وتبادل الأدوار بين الجهات المنفذة للتسجيل.</span></span></p>\n<p style=\"margin-top: 0in; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed; box-sizing: border-box; margin-bottom: 1rem; font-size: 1rem; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">وذكر أن الهيئة تعمل على تعزيز الشفافية في السوق العقاري، وهو المسار الأول لخطة عملها وبدأت لتحقيق ذلك العمل على عدة مبادرات أهمها بناء المؤشرات العقارية السعرية وغير السعرية، وتم التعاقد مع البنك الدولي للعمل مع مجموعة من خبرائه على تحديد أهم المؤشرات العقارية، وتوصل الفريق المشترك من الهيئة والبنك إلى تعريف قرابة الأربعين مؤشراً قسمت لثمان تصنيفات رئيسة منها مؤشرات البيع والإيجار والاستيعاب والبناء الجديد، لافتاً إلى أن الهيئة عقدت ورشة عمل للمؤشرات العقارية بحضور خبراء دوليين من الولايات المتحدة وكوريا الجنوبية ومشاركة ممثلين من أكثر من 20 جهة من القطاع الحكومي والخاص لمناقشة أنواع المؤشرات ومصادر البيانات واستعراض للتجربتين الأمريكية والكورية في جمع البيانات وبناء المؤشرات.</span></span></p>\n<p style=\"margin-top: 0in; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed; box-sizing: border-box; margin-bottom: 1rem; font-size: 1rem; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">وأكد أنه في مجال بناء قدرات القطاع العقاري تعمل الهيئة مع المعهد العقاري الذراع الأكاديمي للهيئة لتطوير برامج يمكن الاستفادة منها في بناء القدرات لتنفيذ التسجيل العيني، ومن ذلك تطوير قدرات المساحين وتأهيل الوسطاء العقاريين وخبراء المكاتب الفنية لدعم القضايا العقارية في المحاكم بالتنسيق مع وزارة العدل لتحديد جميع المتطلبات التي يحتاجها القضاة لتسهيل وتسريع عملية اتخاذ القرار في المحاكم.</span></span></p>\n<p style=\"margin-top: 0in; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed; box-sizing: border-box; margin-bottom: 1rem; font-size: 1rem; font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; widows: 2; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box;\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\" lang=\"AR-SA\">وأوضح أن اللقاء مع المهتمين بالقطاع العقاري في الأحساء يسهم في تطوير عمل الهيئة، ومشاركتهم في تنفيذ خططها، الرامية إلى تنظيم القطاع، من خلال الأخذ بآرائهم ومقترحاتهم، مشيراً إلى أن الهيئة تعمل مع شركائها لإنجاح رؤيتها التي أنشئت من أجله.</span></span></p>\n<p style=\"margin-top: 0in; text-align: justify; line-height: 200%; direction: rtl; unicode-bidi: embed;\" dir=\"RTL\"><span style=\"font-size: 14.0pt; line-height: 200%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\"> </span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-ascii-theme-font: minor-bidi; mso-fareast-font-family: 'Times New Roman'; mso-hansi-theme-font: minor-bidi; mso-bidi-theme-font: minor-bidi; color: #63666a;\"> </span></p>"}},"newsTitle":{"Value":{"#cdata-section":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"cef44d40-1f68-3f20-9762-165959e6f631","Alias":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار","Path":"/92e50e14-70bc-4ac1-93f1-c50da6b01187.config","Level":4202,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/92e50e14-70bc-4ac1-93f1-c50da6b01187.config","Node":{"Content":{"@Key":"92e50e14-70bc-4ac1-93f1-c50da6b01187","@Alias":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار"},"SortOrder":"202","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:59:31"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"aa53f5f5-82c2-40df-a7d8-8a8507e82b0a\",\n    \"mediaKey\": \"2d9102d2-fabb-4306-9259-afbd7e79d7a7\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\" dir=\"RTL\">استقبل صاحب السمو الأمير بدر بن محمد بن جلوي محافظ الأحساء اليوم (الخميس) بمقر المحافظة بالهفوف معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك<span style=\"box-sizing: border-box;\">.</span></p>\n<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\" dir=\"RTL\">وفي بداية اللقاء رحب سموه بمعالي محافظ الهيئة العامة للعقار، وأكد على دور الهيئة في تنظيم وتطوير القطاع العقاري في المملكة<span style=\"box-sizing: border-box;\">.</span></p>\n<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\" dir=\"RTL\">وقدم المبارك لسموه شرحاً عن دور الهيئة العامة للعقار ورؤيتها ان يكون القطاع العقاري السعودي حيويا وجاذبا ويتميّز بالثقة والابتكار واستعرض أيضا خطتها للخمس أعوام القادمة والتي تعتمد على قاعدتين رئيسيتين هما: التسجيل العيني للعقار والتخطيط والموافقات، وخمسة مسارات هي: توفير شفافية السوق، وبناء القدرات وتحفيز الاستثمار ورعاية الجهات المعنية والتدقيق والتنفيذ.<span style=\"box-sizing: border-box;\"> </span></p>\n<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\" dir=\"RTL\">وشكر معالي المحافظ سمو محافظ الأحساء على حسن الاستقبال، وثمن دور القطاع الخاص في المنطقة ومساهمته في الشراكة مع الهيئة لتحقيق اهداف تنمية القطاع العقاري السعودي.</p>"}},"newsTitle":{"Value":{"#cdata-section":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ba56487c-4221-3e87-895b-674436051209","Alias":"محافظ هيئة العقار يرفع التهاني لخادم الحرمين الشريفين وولي عهد","Path":"/acb61633-ad6a-47d7-8560-2bb4ef04f612.config","Level":4203,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/acb61633-ad6a-47d7-8560-2bb4ef04f612.config","Node":{"Content":{"@Key":"acb61633-ad6a-47d7-8560-2bb4ef04f612","@Alias":"محافظ هيئة العقار يرفع التهاني لخادم الحرمين الشريفين وولي عهد","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"محافظ هيئة العقار يرفع التهاني لخادم الحرمين الشريفين وولي عهد"},"SortOrder":"203","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T15:00:24"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a5ac2f31-5527-41fd-9bc9-c7808156df89\",\n    \"mediaKey\": \"bdb67e56-2447-425c-8894-42a8f725a349\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p><span style=\"display: inline !important; float: none; background-color: #ffffff; color: #63666a; font-family: '29ltbukra-md'; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">رفع معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك باسمه وأسم موظفي الهيئة العامة للعقار لمقام خادم الحرمين الشريفين الملك سلمان بن عبدالعزيز (حفظه الله)، وإلى   صاحب السمو الملكي الأمير محمد بن سلمان بن عبدالعزيز ولي العهد نائب رئيس مجلس الوزراء وزير الدفاع(حفظه الله) وإلى الشعب السعودي الكريم التهنئة بمناسبة عيد الفطر المبارك، سائلاً الله عز وجل أن يديم على خادم الحرمين الشريفين وسمو ولي عهده موفور الصحة والعافية، وأن يحفظهم الله لهذا الوطن العزيز ويعيد هذه المناسبة المباركة .عليهم وعلى الشعب السعودي الكريم والأمة الاسلامية كافة بخير وسلام وعافية</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"محافظ هيئة العقار يرفع التهاني لخادم الحرمين الشريفين وولي عهد"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"محافظ هيئة العقار يرفع التهاني لخادم الحرمين الشريفين وولي عهد"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"00acd698-dd3d-3ba0-bde2-37d0669c114c","Alias":"الهيئة العامة للعقار توقع مذكرة تفاهم مع الهيئة العامة للمساحة","Path":"/28fe7453-5a36-4f50-8bea-66dde89f0de2.config","Level":4204,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/28fe7453-5a36-4f50-8bea-66dde89f0de2.config","Node":{"Content":{"@Key":"28fe7453-5a36-4f50-8bea-66dde89f0de2","@Alias":"الهيئة العامة للعقار توقع مذكرة تفاهم مع الهيئة العامة للمساحة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"الهيئة العامة للعقار توقع مذكرة تفاهم مع الهيئة العامة للمساحة"},"SortOrder":"204","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-12T09:59:32"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2f230680-cd7b-48b3-a6e8-54c279ef0d48\",\n    \"mediaKey\": \"021cbbf5-106b-477b-a35f-f52efde3dcf6\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">نظمت الهيئة العامة للمساحة الملتقي السنوي الثاني للمختصين في المساحة والمعلومات الجيومكانية يوم الثلاثاء 19/10/1439هـ، حيث بدأت أعمال الملتقي بكلمة معالي الدكتور عبدالعزيز بن إبراهيم الصعب رئيس الهيئة العامة للمساحة قال فيها قامت الهيئة العامة  للمساحة بأطلاق رؤيتها المستقبلية لقطاع المساحة والمعلومات الجيومكانية ، بعد دراسة دقيقة لواقع الشأن المساحي والمعلومات الجيومكانية في المملكة، وقد أكد معاليه في عدة ملتقيات سابقة ضرورة وجود جهة تنظميه رقابية اشرافيه على قطاع المساحة والمعلومات الجيومكانية وقد عملنا خلال الفترة الماضية على تحقيق اليات التنفيذ للرؤية المستقبلية لقطاع المساحة والمعلومات الجيومكانية والتي اشتملت على اربع محاور رئيسية .</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">المحور الاستراتيجي الأول : توفير بيئة تنظيمية فعالة لتطوير قطاع المساحة والمعلومات الجيومكانية. المحور الاستراتيجي الثاني : توحيد الجهود الوطنية للوصول الي بنية تحتية جيومكانية وطنية. موحدة ( المركز الجيومكاني الوطني )  .</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">المحور الاستراتيجي الثالث : تطوير بيئة تعزز المنافسة في توفير البيانات والمنتجات والاعمال والخدمات المساحية والمعلومات الجيومكانية .</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">المحور الاستراتيجي الرابع : التخطيط والتطوير بالإضافة الي بناء القدرات الوطنية في قطاع المساحة والمعلومات الجيومكانية كمشروع مستقل مشيراً معاليه  الي ان الهيئة العامة للمساحة قامت بتعزيز التعاون مع العديد من الجهات الحكومية للعمل سوياً لتطوير التعاون في المجالات ذات الاهتمام المشترك وجاري العمل حالياً على صياغة العديد من مذكرات التفاهم بين الهيئة وعدداً من الجهات ، كما اعلن معاليه الانتهاء من حساب المرجع الجيوديسي الوطني ، موضحاً أن الهيئة قامت بتكوين لجنة استشارية متخصصة في نظم المعلومات الجغرافية ومقرها الهيئة العامة للمساحة وهدفها تقديم المساعدة والمشورة في بناء نظم المعلومات الجغرافية للقطاع الحكومي وتم تعيين رئيسها واعضاؤها ، كما اوضح معاليه عن تأسيس مجلة دورية متخصصة في عالم المساحة </p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> </p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">والمعلومات الجيومكانية تحت مسمى ( مجلة جيومكاني العلمية ) ستطلقها الهيئة بالتعاون مع احد الجامعات السعودية لتشجيع البحث العلمي وزيادة الوعي ، بعد ذلك جرت مراسم توقيع مذكرات التفاهم بين كلاً من :</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">الهيئة العامة للمساحة والهيئة السعودية للمواصفات والمقاييس والجودة حيث وقعها معالي الدكتور عبدالعزيز بن ابراهيم الصعب رئيس الهيئة العامة للمساحة ومعالي الدكتور عثمان بن سعد القصبي محافظ الهيئة السعودية للمواصفات والمقاييس والجودة .</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">تلى ذلك توقيع مذكرة التفاهم بين الهيئة العامة للمساحة والهيئة العامة للعقار حيث وقعها معالي الدكتور عبدالعزيز بن إبراهيم الصعب رئيس الهيئة العامة للمساحة ومعالي الأستاذ / عصام بن حمد المبارك محافظ الهيئة العامة للعقار ,وتهدف هذه المذكرة إلى تبادل  البيانات والمعلومات المساحية والجيومكانية ذات الإهتمام المشترك وتوفير طبقة خاصة للهيئة العامة للعقار في المنصة الجيومكانية الوطنية والشراكة في دعم وإنجاح مشروع التسجيل العيني للعقار والتعاون في نشر التوعية باستخدام المرجع الجيوديسي الوطني ،   ثم ألقى معالي محافظ الهيئة العامة للعقار الأستاذ / عصام المبارك كلم<a style=\"background-color: transparent; box-sizing: border-box; color: inherit; text-decoration: none;\" name=\"m_2290798410705725649__GoBack\"></a>ة أعرب من خلالها عن سعادته بالمشاركة في هذا الملتقى مع نخبة من المختصين بالمساحة والمعلومات الجيومكانية مشيداً بالإنجازات التي حققتها الهيئة العامة للمساحة خاصة في مجال تطوير المعلومات الجغرافية وتحديد وتنظيم ومراقبة الأعمال المساحية وإنتاج الخرائط وإنشاء وصيانة نظم الشبكات الجييوديسية الوطنية ومراقبتها والتحكم فيها ، وثمن معاليه جهود الهيئة العامة للمساحة في بناء المنصة الجيومكانية معرباً عن سعادته بالتعاون مع الهيئة وتوقيع مذكرة التفاهم بين الهيئة العامة للمساحة والهيئة العامة للعقار للبدء في شراكة مهمة لتحقيق أهدافنا المشتركة والعمل سوياً على توفير البيانات والمعلومات  الجيومكانية بما يسهم في تحقيق الهيئة العامة للعقار لخطة عملها والتي هي من ضمنها القاعدة الرئيسية للخطة وهو التسجيل العيني للعقار بعد ذلك تم الإعلان عن إطلاق وثيقة المعايير الجيومكانية بنسختها الثانية وتوفيرها لجميع الشركاء للاطلاع والتحميل على موقع الهيئة العامة للمساحة تلى ذلك تقديم عدد من العروض وورش العمل المختصة بإنجازات وخطط العمل للمركز الجيومكاني الوطني والتي شارك فيها عدد من الخبرات الوطنية والعالمية . </p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وقد حضر هذا الملتقي العديد من المسؤولين من اصحاب الاختصاص من الجهات الحكومية والقطاع الخاص .  </p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار توقع مذكرة تفاهم مع الهيئة العامة للمساحة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار توقع مذكرة تفاهم مع الهيئة العامة للمساحة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d54ed78b-83c0-3330-9ea2-55bf4e56f694","Alias":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم (1)","Path":"/3e7f3b34-2b5c-4d56-8e02-884c8d9952a4.config","Level":4205,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3e7f3b34-2b5c-4d56-8e02-884c8d9952a4.config","Node":{"Content":{"@Key":"3e7f3b34-2b5c-4d56-8e02-884c8d9952a4","@Alias":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم (1)","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم (1)"},"SortOrder":"205","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-27T16:37:40"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"087f0b36-b89c-4af8-ad3a-dce7afabed41\",\n    \"mediaKey\": \"139d7861-45b1-4475-9458-54ac9525aafc\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">استقبل صاحب السمو الملكي الأمير فيصل بن مشعل بن سعود بن عبدالعزيز  أمير منطقة القصيم في مكتبه اليوم (الخميس) معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك.<br />وشرح معالي المحافظ لسموه دور الهيئة في تنظيم القطاع العقاري وتنميته وتطويره ، وخطة عمل الهيئة خلال الفترة المقبلة ودورها القادم لتحقيق رؤيتها بأن يكون القطاع العقاري السعودي حيوياً وجاذباً ويتميز بالثقة والابتكار، وعرض معالي المحافظ على سموه المشاريع  التي تعمل الهيئة على تنفيذها لتنظيم القطاع العقاري غير الحكومي.<br />وأثنى سمو أمير منطقة القصيم على دور الهيئة وطموحها في تنظيم القطاع العقاري وتأهيل الكوادر البشرية وتشجيع الاستثمار فيما يعود أثره على الاقتصاد الوطني .</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">من جهة أخرى، نظمت اللجنة العقارية في الغرفة التجارية في منطقة القصيم لقاءً مفتوحاً صباح اليوم (الخميس) مع معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك   استعرض فيه خطتها للخمس أعوام القادمة والتي تعتمد على قاعدتين رئيسيتين هما: التسجيل العيني للعقار والتخطيط والموافقات، وخمسة مسارات هي: توفير شفافية السوق، وبناء القدرات وتحفيز الاستثمار ورعاية الجهات المعنية والتدقيق والتنفيذ. <br />وقال معالي المحافظ بأن الهيئة عقدت عدداً من اللقاءات مع المهتمين بالشأن العقاري بحثت فيها مبادرات الهيئة لتطوير أداء ورفع كفاءة القطاع العقاري مثل مبادرة إنشاء مركز تسوية النزاعات العقارية ، ومبادرة إنشاء المكتب الفني لدعم نظر القضايا العقارية أمام القضاء <br />ومبادرة تقييم الوضع الحالي للتسجيل العيني للعقار والتى عقد لأجل تنفيذها ستة ورش عمل عن التسجيل العيني بمشاركة ممثلين عن 23 جهة حكومية و15 جهة من القطاع الخاص وخبراء دوليين ومحليين،تم خلالها عرض  أفضل الممارسات الدولية والتجارب السابقة،  وجرى تنفيذ خطة لإعادة هندسة إجراءات التسجيل العيني لرفع الكفاءة وتقليص المدة وتحسين التنسيق وتبادل الأدوار بين الجهات المنفذة للتسجيل\".<br />وأضاف أن الهيئة تعمل على تعزيز الشفافية في السوق العقاري، وهو المسار الأول لخطة عملها وبدأت لتحقيق ذلك العمل على عدة مبادرات أهمها بناء المؤشرات العقارية السعرية وغير السعرية، وتم التعاقد مع البنك الدولي للعمل مع مجموعة من خبرائه على تحديد أهم المؤشرات العقارية، وتوصل الفريق المشترك من الهيئة والبنك إلى تعريف قرابة الأربعين مؤشراً قسمت لثمان تصنيفات رئيسية منها مؤشرات البيع والإيجار والاستيعاب والبناء الجديد، لافتاً إلى أن الهيئة عقدت ورشة عمل للمؤشرات العقارية بحضور خبراء دوليين من الولايات المتحدة وكوريا الجنوبية ومشاركة ممثلين من أكثر من 20 جهة من القطاع الحكومي والخاص لمناقشة أنواع المؤشرات ومصادر البيانات واستعراض للتجربتين الأمريكية والكورية في جمع البيانات وبناء المؤشرات</p>"}},"newsTitle":{"Value":{"#cdata-section":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"81da9855-48b1-36ac-94f2-ec100c9dbbe9","Alias":"تعاون بين المعهد العقاري السعودي واللجنة العقارية لتطوير القطاع العقاري في المملكة","Path":"/6906b34f-0009-4004-89fb-6fe67c5159bb.config","Level":4206,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6906b34f-0009-4004-89fb-6fe67c5159bb.config","Node":{"Content":{"@Key":"6906b34f-0009-4004-89fb-6fe67c5159bb","@Alias":"تعاون بين المعهد العقاري السعودي واللجنة العقارية لتطوير القطاع العقاري في المملكة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"تعاون بين المعهد العقاري السعودي واللجنة العقارية لتطوير القطاع العقاري في المملكة"},"SortOrder":"206","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-30T16:28:30"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"932bacb1-2d3e-4523-9264-c5d8163c5e2b\",\n    \"mediaKey\": \"99d68909-d560-4ae0-b1f3-45678bc10c56\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وقع المعهد العقاري السعودي الذراع الأكاديمي للهيئة العامة للعقار مذكرة تعاون مع مجلس الغرف السعودية ممثلاً في اللجنة الوطنية العقارية، لتعزيز التعاون بين الجانبين في الأنشطة ذات العلاقة بالقطاع العقاري في المملكة، وذلك في إطار الجهود التي يبذلها المعهد لتطوير وتنظيم القطاع العقاري وجعله جاذباً للمستثمرين المحليين والدوليين، وبما ينسجم مع مساعي اللجنة الرامية لتطوير الخدمات العقارية وتأهيل وتدريب الشباب السعودي على المهن ذات العلاقة بصناعة العقار بغية توطين وظائف هذا القطاع الحيوي وتلبية احتياجاته من الأيدي العاملة الوطنية.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وقام بتوقيع مذكرة التعاون بمنصة توقيع الاتفاقيات بمعرض \"ريستاتكس الرياض العقاري\" في مركز الرياض الدولي للمؤتمرات والمعارض، المدير التنفيذي للمعهد العقاري السعودي المهندس فوزي بن سليمان العيوني، ورئيس اللجنة الوطنية العقارية الأستاذ حمد الشويعر، وذلك بحضور رئيس مجلس الغرف السعودية المهندس أحمد بن سليمان الراجحي ومعالي محافظ الهيئة العامة للعقار الاستاذ عصام بن حمد المبارك .</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وأكد معالي المحافظ الأستاذ عصام المبارك على أن \"مذكرة التعاون بين اللجنة الوطنية العقارية والمعهد العقاري السعودي\" تأتي منسجمة مع خطة عمل الهيئة العامة للعقار والتى تهدف لبناء شراكة وتعاون بين الجهات المعنية بالتدريب والتاهيل لخدمة القطاع العقاري، وتساهم في  توطين وظائفه ورفع مستوى الخدمات فيه، بالاضافة الى المساعدة على تنظيم السوق العقاري\".</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وأوضح معاليه أن المعهد العقاري يسعى إلى  تنفيذ المسار الخاص ببناء قدرات القطاع العقاري وهو المسار الثاني من المسارات الخمسة لخطة عمل الهيئة، وينفذه عبر برامج ودورات متخصصة يقدمها المعهد ويساهم من خلالها على تحقيق رؤية الهيئة العامة للعقار \"بأن يكون القطاع العقاري السعودي جاذباً وحيوياً ويتمتع بالثقة والابتكار\".</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">فيما نوه رئيس اللجنة الوطنية العقارية بمجلس الغرف السعودية حمد الشويعر بأهمية هذه المذكرة والتعاون بين اللجنة كونها تمثل المظلة الرئيسية للمستثمرين العقاريين في المملكة والمعهد العقاري السعودي باعتباره مختصاَ برفع المعايير المهنية في القطاع العقاري بالمملكة إلى أعلى المستويات، من خلال تدريب وتأهيل العاملين في السوق العقاري، معربا عن أمله بأن تحقق مذكرة التفاهم مصلحة المستثمرين العقاريين السعوديين وتسهم في تنمية وتطوير هذا القطاع الحيوي بالمملكة.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وتهدف مذكرة التعاون التي تشتمل على ستة بنود إلى تعزيز أطر التعاون المتبادل وتوسيع نطاق العلاقات الثنائية بين الجانبين من خلال التعاون المشترك لخدمة المهنيين في جميع المجالات ذات الصلة بالقطاع العقاري، ويشمل ذلك العمل على تدريب وتأهيل الكوادر الوطنية ورفع مستواهم المعرفي لشغل الوظائف في السوق العقاري السعودي.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">ويشمل نطاق التعاون بين الجانبين بحسب بنود المذكرة قيام الطرفان بتبادل المعلومات حول الفعاليات والبرامج والمؤتمرات والمشاريع ذات القيمة المضافة للأطراف ذات الصلة بالقطاع العقاري، وتصميم البرامج التدريبية والتعليمية المشتركة في تخصصات قطاع العقار وفق أفضل الممارسات العالمية، وبما يلبي احتياجات ومتطلبات سوق العمل العقاري، إضافة إلى دعم توجهات وبرامج زيادة نسب التوطين في القطاع العقاري والعمل على تحسين بيئته وتطوير المستوى المهني للعاملين فيه، فضلاً عن تبني وتعزيز مبادرات القطاع الخاص التي ترتقي بقطاع العقار ومجالاته المختلفة، والدراسات والبحوث ، وتحفيز سوق العمل والإسهام في ترسيخ أخلاقيات وثقافة وقيم العمل في القطاع العقاري.</p>"}},"newsTitle":{"Value":{"#cdata-section":"تعاون بين المعهد العقاري السعودي واللجنة العقارية لتطوير القطاع العقاري في المملكة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"تعاون بين المعهد العقاري السعودي واللجنة العقارية لتطوير القطاع العقاري في المملكة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"3cd632ce-968e-3309-b94c-04c96953449b","Alias":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار (1)","Path":"/acfc0b04-037a-4204-b772-4d4d72e14ca0.config","Level":4207,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/acfc0b04-037a-4204-b772-4d4d72e14ca0.config","Node":{"Content":{"@Key":"acfc0b04-037a-4204-b772-4d4d72e14ca0","@Alias":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار (1)","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار (1)"},"SortOrder":"207","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-10-02T17:14:24"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"cf5e035b-4a3c-4ae1-a7fb-fad7eb5676a8\",\n    \"mediaKey\": \"2d9102d2-fabb-4306-9259-afbd7e79d7a7\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">استقبل صاحب السمو الأمير بدر بن محمد بن جلوي محافظ الأحساء اليوم (الخميس) بمقر المحافظة بالهفوف معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وفي بداية اللقاء رحب سموه بمعالي محافظ الهيئة العامة للعقار، وأكد على دور الهيئة في تنظيم وتطوير القطاع العقاري في المملكة<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وقدم المبارك لسموه شرحاً عن دور الهيئة العامة للعقار ورؤيتها ان يكون القطاع العقاري السعودي حيويا وجاذبا ويتميّز بالثقة والابتكار واستعرض أيضا خطتها للخمس أعوام القادمة والتي تعتمد على قاعدتين رئيسيتين هما: التسجيل العيني للعقار والتخطيط والموافقات، وخمسة مسارات هي: توفير شفافية السوق، وبناء القدرات وتحفيز الاستثمار ورعاية الجهات المعنية والتدقيق والتنفيذ.<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"> </span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وشكر معالي المحافظ سمو محافظ الأحساء على حسن الاستقبال، وثمن دور القطاع الخاص في المنطقة ومساهمته في الشراكة مع الهيئة لتحقيق اهداف تنمية القطاع العقاري السعودي.</p>"}},"newsTitle":{"Value":{"#cdata-section":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"سمو محافظ الأحساء يستقبل معالي محافظ الهيئة العامة للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"c8215a7e-c0ab-3fe5-9481-e5d7b9b3ee31","Alias":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة (1)","Path":"/2e0e3040-6342-46eb-8dd6-f2e65ff0630a.config","Level":4208,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2e0e3040-6342-46eb-8dd6-f2e65ff0630a.config","Node":{"Content":{"@Key":"2e0e3040-6342-46eb-8dd6-f2e65ff0630a","@Alias":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة (1)","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة (1)"},"SortOrder":"208","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-10-11T06:39:51"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"b5c72abc-fcc9-4e33-b136-ea66dc63853f\",\n    \"mediaKey\": \"474d257b-57cf-430b-afac-ceed61b54545\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">نظمت اللجنة العقارية في الغرفة التجارية في محافظة الأحساء لقاءً مفتوحاً أمس الأول (الخميس) مع معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك، الذي تحدث عن دور الهيئة العامة للعقار في تطوير وتنمية القطاع العقاري.</span></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">وتحدث معالي المحافظ عن خطة عمل الهيئة ودورها القادم لتحقيق رؤيتها بأن يكون القطاع العقاري السعودي حيوياً وجاذباً ويتميز بالثقة والابتكار، والمشاريع المستقبلية التي ستطلقها الهيئة، من أجل تنظيم القطاع العقاري غير الحكومي، كما استعرض خطتها للخمس أعوام القادمة والتي تعتمد على قاعدتين رئيسيتين هما: التسجيل العيني للعقار والتخطيط والموافقات، وخمسة مسارات هي: توفير شفافية السوق، وبناء القدرات وتحفيز الاستثمار ورعاية الجهات المعنية والتدقيق والتنفيذ.</span></span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\">  </span></span></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">وقال المبارك: \"عملت الهيئة خلال الفترة الماضية على بناء قدراتها البشرية والتقنية واستهداف الأنشطة المحددة في خطة عملها بدءاً من القاعدة الرئيسية لها: التسجيل العيني للعقار\"، مشيراً إلى أن الهيئة نظمت ستة ورش عن التسجيل العيني بمشاركة ممثلين 23 جهة حكومية و15 جهة من القطاع الخاص وخبراء دوليين ومحليين، وعملت على تقييم الوضع الحالي للتسجيل العيني ودراسة أفضل الممارسات الدولية والتجارب السابقة، وإعادة هندسة إجراءات التسجيل العيني لرفع الكفاءة وتقليص المدة وتحسين التنسيق وتبادل الأدوار بين الجهات المنفذة للتسجيل.</span></span></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">وذكر أن الهيئة تعمل على تعزيز الشفافية في السوق العقاري، وهو المسار الأول لخطة عملها وبدأت لتحقيق ذلك العمل على عدة مبادرات أهمها بناء المؤشرات العقارية السعرية وغير السعرية، وتم التعاقد مع البنك الدولي للعمل مع مجموعة من خبرائه على تحديد أهم المؤشرات العقارية، وتوصل الفريق المشترك من الهيئة والبنك إلى تعريف قرابة الأربعين مؤشراً قسمت لثمان تصنيفات رئيسة منها مؤشرات البيع والإيجار والاستيعاب والبناء الجديد، لافتاً إلى أن الهيئة عقدت ورشة عمل للمؤشرات العقارية بحضور خبراء دوليين من الولايات المتحدة وكوريا الجنوبية ومشاركة ممثلين من أكثر من 20 جهة من القطاع الحكومي والخاص لمناقشة أنواع المؤشرات ومصادر البيانات واستعراض للتجربتين الأمريكية والكورية في جمع البيانات وبناء المؤشرات.</span></span></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">وأكد أنه في مجال بناء قدرات القطاع العقاري تعمل الهيئة مع المعهد العقاري الذراع الأكاديمي للهيئة لتطوير برامج يمكن الاستفادة منها في بناء القدرات لتنفيذ التسجيل العيني، ومن ذلك تطوير قدرات المساحين وتأهيل الوسطاء العقاريين وخبراء المكاتب الفنية لدعم القضايا العقارية في المحاكم بالتنسيق مع وزارة العدل لتحديد جميع المتطلبات التي يحتاجها القضاة لتسهيل وتسريع عملية اتخاذ القرار في المحاكم.</span></span></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">وأوضح أن اللقاء مع المهتمين بالقطاع العقاري في الأحساء يسهم في تطوير عمل الهيئة، ومشاركتهم في تنفيذ خططها، الرامية إلى تنظيم القطاع، من خلال الأخذ بآرائهم ومقترحاتهم، مشيراً إلى أن الهيئة تعمل مع شركائها لإنجاح رؤيتها التي أنشئت من أجله.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"معالي محافظ \"هيئة العقار\" يكشف عن خطط ودور الهيئة خلال الفترة المقبلة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"f2ab6747-7331-3ac5-b163-7d035c7f1f8e","Alias":"الهيئة العامة للعقار تبدأ تصنيف مكاتب وشركات الوساطة العقارية","Path":"/f346ce1c-009c-4369-8399-3ce3e82d064e.config","Level":4209,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f346ce1c-009c-4369-8399-3ce3e82d064e.config","Node":{"Content":{"@Key":"f346ce1c-009c-4369-8399-3ce3e82d064e","@Alias":"الهيئة العامة للعقار تبدأ تصنيف مكاتب وشركات الوساطة العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"الهيئة العامة للعقار تبدأ تصنيف مكاتب وشركات الوساطة العقارية"},"SortOrder":"209","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-11-16T16:09:12"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"14a855ed-97fe-4016-8335-009c7b3417c5\",\n    \"mediaKey\": \"f39ca17c-a6f9-4ea5-a0f1-941c8a851e63\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">تعتزم الهيئة العامة للعقار إطلاق مشروع تصنيف منشآت الوساطة العقارية في الرابع من ربيع الآخر 1441هـ، الموافق 1 ديسمبر 2019م، وذلك بهدف تطوير مستوى المنشآت العقارية بالمملكة وإيجاد فرص عمل نوعية للشباب والشابات السعوديين وزيادة تأهيلهم ورفع قدراتهم المهنية، وتحسين كفاءة الخدمات التي يقدمونها.</p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وتشترط الهيئة للحصول على تصنيفها أن يتم تطبيق المنشأة العقارية او المرخص له لأربعة معايير، أولها الالتزام بتطبيق الحد الأدنى من نماذج العقود الموحدة المعتمدة، مثل عقد التسويق، وعقد الرغبة بالشراء، ومحضر الاستلام والتسليم للوحدات العقارية، بجانب اجتياز موظف المنشأة او المرخص له لدورات تدريبية لثلاث خدمات عقارية على الأقل، حيث تهدف الهيئة من هذا التصنيف الى تنمية الكفاءات الوطنية التي تخدم هذا القطاع بجودة وفعالية.</p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وفيما بدأت الهيئة العامة للعقار إطلاق الحملة التوعوية بالمشروع، فقد أكملت في الوقت نفسه ومن خلال ذراعها الأكاديمي المعهد العقاري السعودي، إعداد حقائب تدريبية لجميع مسارات الخدمات المقدمة من منشآت الوساطة العقارية، حيث كثف المعهد تقديم هذه الدورات المتخصصة في خدمات تسويق منتجات سكني، ايجار، الوساطة العقارية، اتحاد الملاك، إدارة المرافق، البيع على الخارطة، وتشترط الهيئة على المنشآت طالبة التصنيف كفاءة وتميز الخدمات المقدمة والتجهيزات المناسبة التي تلبي تطلعات عملاء هذه المنشآت.</p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وأوضح معالي محافظ الهيئة العامة للعقار، الأستاذ عصام المبارك، أن مشروع تصنيف منشآت الوساطة العقارية يأتي ضمن جهود الهيئة الرامية لتنظيم الأنشطة العقارية في المملكة ، والسعي لرفع مستوى أداء القائمين على الوساطة العقارية وخدماتها ورفع كفاءتها وجودتها وفق أفضل الممارسات العالمية، وبما يتوافق مع مستهدفات رؤية 2030 الطموحة للارتقاء بالقطاع العقاري وزيادة مساهمته في الناتج المحلي الاجمالي.</p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وأشار معاليه إلى أن الانضمام إلى مشروع تصنيف منشآت الوساطة العقارية متاح بشكل اختياري للمنشآت العقارية والأشخاص الراغبين في الحصول على تصنيف واعتماد الهيئة وادراجه ضمن هويتهم، مبينا أن مشروع نظام الوساطة العقارية الجديد سوف يلزم عند صدوره كافة العاملين في القطاع العقاري بتطبيق احكامه بما فيها معايير التصنيف.</p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وللحصول على مزيد من التفاصيل حول تصنيف المنشآت العقارية، إضافة الى الاستفادة من الفترة التجريبية بالدخول للرابط التالي: </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"><span style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position-x: initial; background-position-y: initial; background-repeat: initial; background-size: initial; box-sizing: border-box; font-family: Verdana,sans-serif; font-size: 8.5pt; line-height: 107%;\"><a style=\"background-color: transparent; box-sizing: border-box; color: #007bff; text-decoration: none;\" href=\"https://srei.sa/SiteHome/AllCourses\">https://srei.sa/SiteHome/AllCourses</a></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تبدأ تصنيف مكاتب وشركات الوساطة العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تبدأ تصنيف مكاتب وشركات الوساطة العقارية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"1f083e22-a749-360b-a437-1e7abcb4ba08","Alias":"الهيئة العامة للعقار تدشن المركز السعودي للتحكيم العقاري وتربط المركز الكترونياً مع وزارتي العدل والإسكان","Path":"/ffed5a7d-8d35-4a9f-8b16-8e50c3542316.config","Level":4210,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ffed5a7d-8d35-4a9f-8b16-8e50c3542316.config","Node":{"Content":{"@Key":"ffed5a7d-8d35-4a9f-8b16-8e50c3542316","@Alias":"الهيئة العامة للعقار تدشن المركز السعودي للتحكيم العقاري وتربط المركز الكترونياً مع وزارتي العدل والإسكان","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:52","NodeName":{"@Default":"الهيئة العامة للعقار تدشن المركز السعودي للتحكيم العقاري وتربط المركز الكترونياً مع وزارتي العدل والإسكان"},"SortOrder":"210","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-11-16T16:15:15"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1be85f43-d39a-457d-8b19-2e140e9f9fbf\",\n    \"mediaKey\": \"8d3348a7-72f1-4180-859c-d04fc07eb440\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">دشن اليوم الخميس الثامن عشر من شهرصفرمعالي وزير العدل فضيلة الشيخ الدكتور وليد بن محمد الصمعاني ومعالي وزيرالإسكان رئيس مجلس إدارة الهيئة العامة للعقارالأستاذ ماجد بن عبدالله الحقيل المركز السعودي للتحكيم العقاري كما دشنا الربط بين المركز ووزارة العدل لإيداع قرارات التحكيم الكترونيا، إضافة الي الربط الإلكتروني مع مركز المصالحة بوزارة العدل لاعتماد المركز السعودي للتحكيم العقاري كمركز مصالحة معتمد، وكذلك الربط الكتروني مع نظام ايجار، ليخدم عقود الإيجار الموحدة المتضمنة خيار التحكيم بناءً على رغبة أطرافها، وكذلك الربط الالكتروني مع برنامج اتحاد الملاك لخدمة جميع الملاك الذي يرغبون بهذا الخيار من الملاك أعضاء الجمعية</p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وأوضح معالي محافظ الهيئة العامة للعقار، الأستاذ عصام بن حمد المبارك أن مركز التحكيم العقاري سيكون- بأذن الله- وسيلة مساندة للقضاء في النزاعات التي قد تنشأ بين كافة المتعاملين في هذا النشاط الحيوي، مشيرا أن المركز يهدف إلى تقليص المدة الزمنية لإنهاء النزاعات العقارية وباتباع أسلوب مهني وعبر إجراءات إلكترونية سهلة ومرنة وبجودة عالية، وإصدار محاضر الصلح والتحكيم إلكترونيا يقوم بها محكمين مختصين تم تأهيلهم من خلال الذراع الاكاديمي للهيئة (المعهد العقاري السعودي)  بما يسهم  في رفع حيوية وجاذبية القطاع العقاري.  وأضاف بان المركز سيعمل على التعريف بالتقنيات والخبرات لدى المركز وتوعية المستفيدين بالتزاماتهم وحقوقهم</p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تدشن المركز السعودي للتحكيم العقاري وتربط المركز الكترونياً مع وزارتي العدل والإسكان"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تدشن المركز السعودي للتحكيم العقاري وتربط المركز الكترونياً مع وزارتي العدل والإسكان"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b92e0042-c380-39fc-a09f-2a3968a5ba6b","Alias":"ورش عمل توصي بتواجد جهة مشرفة على مشروع التسجيل العيني للعقار","Path":"/2a5a1c0d-3490-4131-9d3b-9732186a4c39.config","Level":4211,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2a5a1c0d-3490-4131-9d3b-9732186a4c39.config","Node":{"Content":{"@Key":"2a5a1c0d-3490-4131-9d3b-9732186a4c39","@Alias":"ورش عمل توصي بتواجد جهة مشرفة على مشروع التسجيل العيني للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"ورش عمل توصي بتواجد جهة مشرفة على مشروع التسجيل العيني للعقار"},"SortOrder":"211","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:28:36"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"930a7198-071b-4765-afa0-fdeedfa59807\",\n    \"mediaKey\": \"d3dd2ce1-8d03-449c-9940-aba9c148645b\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">أوصت ورش عمل التسجيل العيني التي نظمتها الهيئة العامة للعقار بالتعاون مع مركز الإنجاز والتدخل السريع على ضرورة تواجد جهة واحدة مشرفة على التسجيل العيني للعقار، واتفق الأغلبية على أن الهيئة العامة للعقار الجهة المناسبة للقيام بذلك.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وتضمنت توصيات ورش العمل التي أقيمت في فندق رفال كيمبنسكي بالرياض في الفترة 21-23/1/ 2018 أن تقوم الجهة المشرفة بتطبيق التسجيل العيني الالزامي للعقار في مدينة الرياض أولاً وتحديد أولوية التسجيل الالزامي في المناطق الأخرى، والتسريع في انهاء مشروع المرجع الوطني الجيوديسي، وتقوم الجهات الداعمة بتزويد الجهة المشرفة بكافة البيانات والأدوات المطلوبة للتسجيل العيني للعقار، وتكون آلية التسجيل العيني عن طريق مسار الزامي ومسار سريع (اختياري)، وضرورة توحيد قاعدة البيانات المكانية من خلال استخدام المنصة الوطنية والتسريع في إطلاقها.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وهدفت الورش إلى إيجاد حلول متكاملة لتحديات التسجيل العيني للعقار والخروج بخطة تنفيذ للتسجيل العيني في المملكة العربية السعودية، من خلال تطوير إجراءات التسجيل العيني للعقار وتوحيد البيانات والمصادر (نظام المعلومات) وتطوير الأنظمة والتشريعات والحوكمة ومشاركة القطاع الخاص وتطوير خطة التواصل الإعلامي وخطة تدريب وتطوير الكوادر البشرية.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">واحتوت الورش على 6 غرف، أولها عن تطوير إجراءات التسجيل العيني للعقار</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وتضمنت مخرجاتها الاتفاق على إجراءات التسجيل العيني للعقار التي تمت إعادة هندستها، والاتفاق على مدد زمنية لكل مرحلة من مراحل الإجراءات والاتفاق التام على تغيير مسمى صحيفة عقارية إلى وثيقة عقارية، وثانيهما عن توحيد البيانات والمصادر (نظام المعلومات) وتضمنت مخرجاتها ضرورة توحيد قاعدة البيانات المكانية من خلال استخدام المنصة الوطنية والتسريع في اطلاقها والتسريع في انهاء مشروع المرجع الوطني الجيوديسي.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وثالث غرف ورش العمل عن تطوير الأنظمة والتشريعات والحوكمة وتضمنت مخرجاتها إيعاز مهمة الإشراف على التسجيل العيني للعقار للهيئة العامة للعقار كجهة مشرفة ومنفذة، وحوكمة متكاملة توضح الأدوار والمسؤوليات لكافة أطراف العلاقة، وتمنح الهيئة العامة للعقار وفقا للإجراءات النظامية فترة من (سنة حتى سنتين) لتعديل المواد بنظام التسجيل العيني للعقار، ورابع الغرف عن مشاركة القطاع الخاص وتضمنت مخرجاتها أن تكون المرجعية لجهة واحدة فقط مما يشكل حافزاً للقطاع الخاص أن يبدأ التسجيل الاختياري (الشباك الواحد)، ما سيخلق فرص استثمارية معقولة في مجالات رقمنة الصكوك، والنشر الإعلامي، والتدريب.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وتطرقت الغرفة الخامسة إلى تطوير خطة التواصل الإعلامي، وتضمنت مخرجاتها طرح حلول للتواصل بالاستفادة من تجربة حريملاء، والتشديد على أهمية اعداد حملة توعوية شاملة وفعالة تستهدف جميع شرائح الملاك قبل البدء بالتنفيذ، وتأسيس فريق عمل لوضع تفاصيل الخطة الإعلامية مع الجهات ذات العلاقة، فيما كانت الغرفة السادسة عن خطة تدريب وتطوير الكوادر البشرية وتضمنت مخرجاتها ضرورة الاستفادة من أبرز الممارسات العالمية في هذا المجال، والاحتياج الفعلي للتدريب يتمحور حول ديبلومات متخصصة ودورات تدريبية معتمدة، وأهمية تشكيل لجنة من الجهات ذات العلاقة لإعداد الخطة التفصيلية.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"ورش عمل توصي بتواجد جهة مشرفة على مشروع التسجيل العيني للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"ورش عمل توصي بتواجد جهة مشرفة على مشروع التسجيل العيني للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5902a5e7-27af-36c1-bf8d-e5ad56b712c8","Alias":"انطلاق ورشة التسجيل العيني للعقار بمشاركة 152 شخصاً يمثلون 22 جهة","Path":"/e5666b68-d705-47f0-bdd4-83363a6b01db.config","Level":4212,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e5666b68-d705-47f0-bdd4-83363a6b01db.config","Node":{"Content":{"@Key":"e5666b68-d705-47f0-bdd4-83363a6b01db","@Alias":"انطلاق ورشة التسجيل العيني للعقار بمشاركة 152 شخصاً يمثلون 22 جهة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"انطلاق ورشة التسجيل العيني للعقار بمشاركة 152 شخصاً يمثلون 22 جهة"},"SortOrder":"212","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:29:33"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"8ef5d212-2eb2-4f05-bd82-93ed7d6c8d93\",\n    \"mediaKey\": \"cb27000e-0014-4e0e-8331-bf31a94010aa\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">انطلقت ورش عمل التسجيل العيني للعقار الأحد 21-1-2018 بمشاركة 22 جهة حكومية، وحضور أكثر من 152 شخص يمثلون الجهات ذات العلاقة بالمشروع، وممثلين عن القطاع الخاص.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">واستمرت الورش التي نظمها الهيئة العامة للعقار بالتعاون مع مركز الإنجاز والتدخل السريع لمدة ثلاثة أيام متتالية، للخروج بتوصيات من شأنها المساهمة في مشروع التسجيل العيني للعقار. </span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وقال معالي محافظ الهيئة العامة للعقار عصام بن حمد المبارك في كلمته خلال الحفلة الافتتاحية للورش: \"أشكر جميع الحضور على تواجدهم في ورش عمل التسجيل العيني للعقار التي انطلقت بمشاركة 22 جهة، وتهدف الورش إلى جمع الجهات الحكومية على منصة واحدة للخروج ببرنامج متكامل عن التسجيل العيني للعقار\".</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأضاف أن الهيئة العامة للعقار تأسست قبل بضعة أشهر، واستراتيجيتها تعتمد على قاعدتين رئيسيتين أحدهما: التسجيل العيني للعقار، وكما هو معلوم أن التسجيل العيني مر على إقراره نحو 17 عاماً ويحتاج إلى مشاركة الجهات ذات العلاقة للعمل على تطويره وتحسينه ودراسة مواطن القوة والضعف فيه.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأشاد المبارك بتعاون مسؤولي وزارتي العدل والشؤون البلدية والقروية مع الهيئة العامة للعقار في المشروع، وبذلوا جهوداً كبيرة لإقامة هذه الورش، مضيفاً: \"ننتظر مساهمة القطاع الخاص في مشروع التسجيل العيني\".</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وبعد ذلك قدم المدير التنفيذي في مركز الإنجاز والتدخل السريع المهندس سليمان المزروع عرضاً شاملاً عن مشروع التسجيل العيني للعقار، وكذلك أهداف الورشة وتوزيع المشاركين فيها، وتبعها حواراً مفتوحاً لمعالي محافظ هيئة العقار عصام المبارك والمشرف على الشركة الوطنية للتسجيل العيني نايف حمدان وممثل القطاع الخاص سامي الزكري.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وتحدث في البداية محافظ هيئة العقار عن أهمية التسجيل العيني للعقار، فيما تطرق نايف حمدان إلى الحديث عن خصخصة الشركات لتقديم الخدمات ومزايا ذلك، بينما تحدث الزكري عن دور التسجيل العيني للعقار في تحفيز الاستثمار وأهميته في القطاع الخاص.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وبعد الحفلة الافتتاحية توجه المشاركين إلى غرف الورش لمناقشة المحاور المتعلقة بمشروع التسجيل العيني للعقار.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"انطلاق ورشة التسجيل العيني للعقار بمشاركة 152 شخصاً يمثلون 22 جهة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"انطلاق ورشة التسجيل العيني للعقار بمشاركة 152 شخصاً يمثلون 22 جهة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"33969de4-95d4-3302-b463-d407cbba8ace","Alias":"وزير الإسكان يرأس الاجتماع الأول لمجلس إدارة الهيئة العامة للعقار","Path":"/4855b4aa-96a8-46c8-88ed-c984b5917e0e.config","Level":4213,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4855b4aa-96a8-46c8-88ed-c984b5917e0e.config","Node":{"Content":{"@Key":"4855b4aa-96a8-46c8-88ed-c984b5917e0e","@Alias":"وزير الإسكان يرأس الاجتماع الأول لمجلس إدارة الهيئة العامة للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"وزير الإسكان يرأس الاجتماع الأول لمجلس إدارة الهيئة العامة للعقار"},"SortOrder":"213","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:30:09"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ff30630d-36e1-4789-aad1-3c3eeae4efe0\",\n    \"mediaKey\": \"46baae0a-e2d0-4668-b6af-44287ac71ff2\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">رأس معالي وزير الإسكان رئيس مجلس إدارة الهيئة العامة للعقار ماجد بن عبدالله الحقيل اليوم (الأربعاء) الاجتماع الأول لأعضاء مجلس إدارة الهيئة في مقرها بالرياض.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وفي بداية الاجتماع رحب رئيس مجلس الإدارة معالي الوزير ماجد الحقيل بأعضاء المجلس، وهنأهم بإنشاء الهيئة العامة للعقار، التي سيكون لها دور في تنظيم في قطاع العقار بالمملكة، بما يخدم المواطنين والمطورين والجهات ذات العلاقة بالقطاع.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وقال الحقيل: \"إن إنشاء الهيئة ضمن الأهداف الاستراتيجية لرؤية المملكة 2030، لتحسين أداء القطاع العقاري وتطويره ورفع مساهمته في الناتج المحلي، ومستوى الشفافية فيه وزيادة الوعي لدى المتعاملين في القطاع العقاري وتحفيز الاستثمار فيه\".</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">واطلع المجلس على العرض الذي قدمه معالي محافظ الهيئة العامة للعقار عصام بن حمد المبارك عن استراتيجية الهيئة وخطة عملها، الذي أوضح فيه أن الاستراتيجية اعتمدت على قاعدتين رئيسيتين هما: التسجيل العيني للعقار والتخطيط والموافقات، وخمسة محاور هي: توفير شفافية السوق، وبناء القدرات وتحفيز الاستثمار ورعاية الجهات المعنية والتدقيق والتنفيذ.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">واستمع المجلس إلى شرح تفصيلي عن خطة عمل الهيئة الحالية في وضع آليات للإشراف على تنظيم نظام التسجيل العيني للعقار والخطة التنفيذية له بالتنسيق مع الجهات المعنية بالنظام، إضافة إلى العمل الحالي الذي بدأت فيه الهيئة لتطوير المؤشرات العقارية بالتعاون مع فريق من البنك الدولي، لتعزيز الشفافية وتوفير البيانات والمعلومات والمؤشرات لهذا القطاع.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأصدر المجلس قراراً باعتماد الهيكل التنظيمي للهيئة، واعتماد اللوائح الخاصة بتنظيم عمل المجلس والمراجعة الداخلية، ولائحة المستشارين والخبراء، إضافة إلى لائحة الصلاحيات.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وحضر الاجتماع مستشار معالي وزير الإسكان والمشرف العام على وكالة وزارة الإسكان للدعم السكني والفروع صاحب السمو الملكي الأمير سعود بن طلال بن بدر، ومعالي محافظ الهيئة العامة للعقار عصام بن حمد المبارك، ووكيل وزارة الطاقة والصناعة والثروة المعدنية لشؤون الكهرباء الدكتور صالح بن حسين العواجي، ووكيل وزارة المالية للإيرادات المهندس طارق بن عبدالله الشهيب، ووكيل وزارة الشؤون البلدية والقروية لتخطيط المدن الدكتور زهير بن حسن زاهد، ووكيل وزارة الاقتصاد والتخطيط للشؤون الاقتصادية عبدالعزيز بن متعب الرشيد، والقاضي ومستشار معالي وزير العدل الشيخ عبدالعزيز بن محمد الزامل.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"وزير الإسكان يرأس الاجتماع الأول لمجلس إدارة الهيئة العامة للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"وزير الإسكان يرأس الاجتماع الأول لمجلس إدارة الهيئة العامة للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a6976320-428e-315e-840b-43beaa461868","Alias":"المبارك يشكر القيادة لتعيينه محافظاً للهيئة العامة للعقار","Path":"/01c11185-4083-467b-8b02-1c4de9141353.config","Level":4214,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/01c11185-4083-467b-8b02-1c4de9141353.config","Node":{"Content":{"@Key":"01c11185-4083-467b-8b02-1c4de9141353","@Alias":"المبارك يشكر القيادة لتعيينه محافظاً للهيئة العامة للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"المبارك يشكر القيادة لتعيينه محافظاً للهيئة العامة للعقار"},"SortOrder":"214","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:39:37"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"145ef328-82a7-4536-ac5f-ec13309d9fc2\",\n    \"mediaKey\": \"c859e482-14f8-4307-9399-ed6978d55476\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">رفع معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك شكره وامتنانه لمقام خادم الحرمين الشريفين الملك سلمان بن عبدالعزيز، وصاحب السمو الملكي الأمير محمد بن سلمان ولي العهد نائب رئيس مجلس الوزراء وزير الدفاع -يحفظهم الله- على الثقة الملكية الكريمة بتعيينه محافظاً للهيئة العامة للعقار، سائلاً المولى -عز وجل- أن يمده بالعون والتوفيق لتحقيق تطلعات القيادة الرشيدة لوطننا الغالي.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وبيّن معاليه أن هذه الثقة الملكية الغالية وسام يعتز ويفخر به وهو حافز لبذل المزيد من الجهد والعطاء لخدمة الوطن، ومثمناً في الوقت ذاته ثقة ودعم رئيس مجلس إدارة الهيئة العامة للعقار معالي وزير الاسكان الأستاذ ماجد بن عبدالله الحقيل، سائلاً المولى -عزَّ وجلَّ- التوفيق والسداد في مهمته الجديدة.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأكّد المبارك حرصه على تحقيق تطلعات القيادة في قطاع العقار ، والسعي إلى تحقيق رؤيتها الطموحة في تنظيم وتوفير البيئة المناسبة لهذا القطاع الحيوي، والمضي قُدماً وبخطوات واثقة تُعرز مكانة المملكة دولياً.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">ويُعد \"المبارك\" أحد الكفاءات الوطنية التي تبوأت عدد من المناصب القيادية لعل أبرزها عمله ملحقاً تجاريّا للمملكة في جنيف، ومديراً عاماً للتجارة الخارجية ومستشاراً لمعالي وزير التجارة، ووكيلاً مساعداً لوزارة التجارة  للصناعة، ثم وكيلاً لوزارة التجارة والاستثمار للتجارة الخارجية، وكلف وكيلاً لوزارة التجارة والصناعة لشؤون الصناعة، وكلف بتأسيس هيئة تنمية الصادرات السعودية، وكلف بتأسيس الهيئة السعودية للمقيمين المعتمدين وشغل منصب أمينها العام، إضافة إلى ترؤسه للعديد من المجالس والفعاليات واللجان الداخلية والدولية.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"المبارك يشكر القيادة لتعيينه محافظاً للهيئة العامة للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"المبارك يشكر القيادة لتعيينه محافظاً للهيئة العامة للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"1124156d-3491-36a9-9d5c-38a056e05843","Alias":"وزارة العدل توقع اتفاقية مع الهيئة العامة للعقار لتبادل البيانات وبناء المؤشرات العقارية","Path":"/1883ddd3-d703-47a0-94bf-77172d20c1a2.config","Level":4215,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1883ddd3-d703-47a0-94bf-77172d20c1a2.config","Node":{"Content":{"@Key":"1883ddd3-d703-47a0-94bf-77172d20c1a2","@Alias":"وزارة العدل توقع اتفاقية مع الهيئة العامة للعقار لتبادل البيانات وبناء المؤشرات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"وزارة العدل توقع اتفاقية مع الهيئة العامة للعقار لتبادل البيانات وبناء المؤشرات العقارية"},"SortOrder":"215","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:42:28"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0fa814a0-45e7-42c6-a285-26da7bb6ca6b\",\n    \"mediaKey\": \"f16735a5-df62-47af-8f7f-0afb9b80ae69\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p><span style=\"box-sizing: border-box; color: #63666a; font-family: nour2,nour,sans-serif; font-size: 18px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">تحت رعاية معالي وزير العدل الشيخ الدكتور وليد بن محمد الصمعاني , وقّع معالي نائب وزير العدل الشيخ سعد بن محمد السيف مع معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك اتفاقية تعاون لبناء المؤشرات العقارية وفقاً للبيانات المتبادلة بينهما ومن خلال قنوات إلكترونية متقدّمة تسرّع من عملية تبادل البيانات وإصدار المؤشرات لغرض تنمية القطاع العقاري ولتسهم في إجراء البحوث وإعداد الدراسات والإحصاءات في مجال الأنشطة العقارية.</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: nour2,nour,sans-serif; font-size: 18px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وتهدف الاتفاقية إلى أتمتة التعاملات بين وزارة العدل والهيئة العامة للعقار وتحقيق أهداف الوزارة والهيئة في التنمية العقارية وتقديم الدراسات المختصّة بالعقار لرفع كفاءة القطاع العقاري وبما يشجع على الاستثمار فيه ويتفق مع أهداف التنمية الاقتصادية والاجتماعية.</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: nour2,nour,sans-serif; font-size: 18px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وتطلّع معالي نائب وزير العدل إلى أن تثمر هذه الشراكة في تطوير المجال العقاري بما يعزز من حضوره الاقتصادي وينعكس على حراكه التجاري وفق بيانات معتمدة وموثوقة تتم من خلال أحدث الوسائل الرقميّة المتقدّمة , مؤكداً أن وزارة العدل تحرص على بناء الشراكات مع الجهات والهيئات الحكومية بما يسهم في التنمية لهذا الوطن.</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: nour2,nour,sans-serif; font-size: 18px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">ولفت معالي نائب الوزير إلى أن الوزارة مكّنت المواطن والمستثمر من فرصة التعرف على تفاصيل المؤشرات العقارية للمناطق والمدن والأحياء من خلال بوابة وزارة العدل الإلكترونية, وبناء قاعدة معلوماتية يومية مفصلة لأسعار العقار في المملكة حيث اعتمدت الوزارة في تأسيس تلك المؤشرات على أنظمة برامجها المعلوماتية المسحية.</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: nour2,nour,sans-serif; font-size: 18px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وبين معالي الشيخ سعد السيف أن المؤشرات العقارية العدليّة تتيح للمستثمرين العقاريين والجهات المسؤولة متابعة التضخم في قطاع العقار وبحث وتتبع الركود والحراك العقاري, وذلك بفضل ما توفره من بيانات دقيقة وحديثة لحجم الصفقات العقارية وبأسعار حقيقية.</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: nour2,nour,sans-serif; font-size: 18px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">من جهته أعرب معالي محافظ الهيئة العامة للعقار عن خالص الشكر والتقدير لمعالي وزير العدل الشيخ الدكتور وليد بن محمد الصمعاني ومعالي نائب وزير العدل الشيخ سعد بن محمد السيف ومنسوبي وزارة العدل الذين أثمرت جهودهم في التوصل إلى هذه الاتفاقية بين الوزارة والهيئة، مثمناً ببالغ التقدير الدعم الكبير الذي تقدمه وزارة العدل للهيئة العامة للعقار لمساعدتها على تحقيق أهدافها.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"وزارة العدل توقع اتفاقية مع الهيئة العامة للعقار لتبادل البيانات وبناء المؤشرات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"وزارة العدل توقع اتفاقية مع الهيئة العامة للعقار لتبادل البيانات وبناء المؤشرات العقارية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9fa70757-a1a7-302f-b277-0e9bb69e7bfe","Alias":"مذكرة تفاهم بين الهيئة العامة للعقار ومؤسسة البريد السعودي","Path":"/49bc6016-2742-47a3-969c-5d43ec889af4.config","Level":4216,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/49bc6016-2742-47a3-969c-5d43ec889af4.config","Node":{"Content":{"@Key":"49bc6016-2742-47a3-969c-5d43ec889af4","@Alias":"مذكرة تفاهم بين الهيئة العامة للعقار ومؤسسة البريد السعودي","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"مذكرة تفاهم بين الهيئة العامة للعقار ومؤسسة البريد السعودي"},"SortOrder":"216","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:47:43"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2bbe539d-ffef-403a-a189-4847ccaf4da2\",\n    \"mediaKey\": \"19cea240-0c17-4d79-a648-452a2b3933a6\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وقعت الهيئة العامة للعقار ومؤسسة البريد السعودي مذكرة تفاهم لتبادل البيانات والاستفادة من العنوان الوطني لزيادة دقة وموثوقية بيانات ومعلومات الأصول العقارية، حيث وقع المذكرة معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك وسعادة رئيس مؤسسة البريد السعودي - المكلف - المهندس محمد بن عبد الرحمن العبد الجبار.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">ورحب معالي محافظ الهيئة العامة للعقار الأستاذ عصام المبارك بالتعاون بين الهيئة والمؤسسة لخدمة القطاع العقاري في المملكة وتنميته وزيادة كفايته وتشجيع الاستثمار فيه بما يتفق مع اهداف التنمية الاقتصادية والاجتماعية، مؤكداً معاليه على ان الاستفادة من العنوان الوطني وتبادل البيانات الجيومكانيه سيزيد من دقة وموثوقية البيانات والمعلومات العقارية، كما سيساهم في تنفيذ فعال للتسجيل العيني للعقار في المملكة، ويساعد بعد ذلك في إعداد الدراسات والإحصاءات وبناء المؤشرات العقارية لمزيد من الشفافية في السوق العقاري.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">بدوره، أوضح رئيس مؤسسة البريد السعودي- المكلف- المهندس محمد العبدالجبار أنه بمقتضى هذه المذكرة، ستستفيد الهيئة العامة للعقار من \"العنوان الوطني\" الذي طورته المؤسسة بصفتها الجهة الحكومية المسؤولة عنه وعن صيانته وتحديثه بموجب قرار مجلس الوزراء رقم 252 وتاريخ 24/7/1434هـ والقاضي بأن يكون محل الإقامة العام عنواناً لكل من الشخص ذي الصفة الطبيعية، أو الشخص ذي الصفة الاعتبارية أو المؤسسة الفردية، أو الجهة العامة، أو غيرها، ما لم يختر عنوانا لمحل الإقامة الخاص لتلقي الإشعارات والتبليغات ونحوها، وبين أن هذه الاتفاقية تعزز الاستفادة من العنوان الوطني وتدعم انتشاره وتعمم تطبيقاته وتساهم في تطويره كأحد أهم البنى التحتية التي تدعم تطوير الخدمات المختلفة وأيضاً الاستفادة العليا من الأصول العقارية في المملكة .</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وأشار إلى أن \"العنوان الوطني\" سيساعد الهيئة العامة للعقار في تنفيذ أعمالها، بصفتها الجهة الحكومية المسؤولة عن مراقبة مؤشرات القطاع العقاري، وستساعد في إثراء المعلومات البوابة الالكترونية التي تنوي الهيئة تأسيسها لتوفير معلومات العقارية المتوفرة لدى الهيئة أو الجهات الأخرى و تحديثها دورياً وإتاحتها للمستفيدين.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وبناءً على هذه المذكرة، سيتم تشكيل فريق عمل مشترك من الجهتين بغرض الإشراف على تفعيل بنود المذكرة وتولى مهام التنسيق بين الطرفين .</p>"}},"newsTitle":{"Value":{"#cdata-section":"مذكرة تفاهم بين الهيئة العامة للعقار ومؤسسة البريد السعودي"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مذكرة تفاهم بين الهيئة العامة للعقار ومؤسسة البريد السعودي"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"daa36726-70f7-3ae1-bb57-3473d1033ef0","Alias":"وزير الإسكان يرعى ختام ورش التسجيل العيني للعقار","Path":"/8d47302d-b375-44ef-9d8f-2aa3fcc3e2fe.config","Level":4217,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/8d47302d-b375-44ef-9d8f-2aa3fcc3e2fe.config","Node":{"Content":{"@Key":"8d47302d-b375-44ef-9d8f-2aa3fcc3e2fe","@Alias":"وزير الإسكان يرعى ختام ورش التسجيل العيني للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"وزير الإسكان يرعى ختام ورش التسجيل العيني للعقار"},"SortOrder":"217","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:50:53"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2aa29ade-ec20-4069-85e7-7211ebea27e2\",\n    \"mediaKey\": \"8cfc81dc-06c7-49fd-807b-4bc43b9d3ea2\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">برعاية معالي وزير الإسكان رئيس مجلس إدارة الهيئة العامة للعقار ماجد بن عبدالله الحقيل، أُختتمت ورش عمل التسجيل العيني للعقار الثلاثاء 23-1-2018 التي نظمتها الهيئة العامة للعقار ومركز الإنجاز والتدخل السريع، بمشاركة 38 جهة حكومية وخاصة، وحضور أكثر من 152 شخصاً من الجهات ذات العلاقة.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وحضر الحفل الختامي معالي وزير الإسكان رئيس مجلس إدارة الهيئة العامة للعقار ومعالي محافظ الهيئة العامة للعقار عصام بن حمد المبارك وعدد من مسؤولي الجهات ذات العلاقة بمشروع التسجيل العيني للعقار.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">ووجه معالي الوزير ماجد الحقيل في كلمته بالحفل شكره على المشاركين في الورش لحضورهم وجهودهم المبذولة، مؤكداً أن مشروع التسجيل العيني للعقار مهم جداً، ولن يكون فيه العمل سهلاً، لكنه واثق في قدرات الكوادر المشاركة في هذه الورش، وكذلك للدعم الكبير التي تجده جميع المشاريع في المملكة من قبل القيادة الرشيدة.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">من جهته، قال معالي محافظ الهيئة العامة للعقار عصام المبارك في كلمة بالحفل: \"\"أشكر جميع الحضور على تواجدهم في ورش عمل التسجيل العيني للعقار التي انطلقت بمشاركة عدد من الجهات الحكومية والخاصة، وتضمنت الورش غرف للنقاش تنوعت محاورها بغية الوصول إلى توصيات ومقترحات تصب في صالح مشروع التسجيل العيني للعقار\".</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأضاف أن جميع الجهات المشاركة في ورش العمل التي استمرت لثلاثة أيام بذلت جهوداً كبيرة، وبعض الجهات شاركت في جلسات النقاش بخمسة ممثلين، ما يدل على حرصها في المشروع.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وتابع: \"الجهات المشاركة قدمت عروضاً مميزة، وكان هناك تلاقح في الأفكار المطروحة، والثلاثة أيام كانت حافلة بالمداخلات الثرية، وشاركنا فيها القطاع الخاص بآراء ممثليه، ولا ننسى أن نشكر ممثلي البنك الدولي، الذين كانوا متواجدين طوال أيام الورش\".</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وبعد ذلك قدم المدير التنفيذي في مركز الإنجاز والتدخل السريع المهندس سليمان المزروع ملخصاً عاماً لأبرز ما تناولته ورش العمل، وشرحاً لأهدافها وفعالياتها.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وفي نهاية الحفل كرم معالي وزير الإسكان الجهات المشاركة في الورش من القطاعين العام والخاص.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"وزير الإسكان يرعى ختام ورش التسجيل العيني للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"وزير الإسكان يرعى ختام ورش التسجيل العيني للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"59777af8-bd02-35c1-98e2-3007178943bd","Alias":"مجلس إدارة الهيئة العامة للعقار يستعرض إنجازات الربع الثاني 2018 م","Path":"/2a9c703e-5263-47db-aa8c-310fe7f2c350.config","Level":4218,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2a9c703e-5263-47db-aa8c-310fe7f2c350.config","Node":{"Content":{"@Key":"2a9c703e-5263-47db-aa8c-310fe7f2c350","@Alias":"مجلس إدارة الهيئة العامة للعقار يستعرض إنجازات الربع الثاني 2018 م","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"مجلس إدارة الهيئة العامة للعقار يستعرض إنجازات الربع الثاني 2018 م"},"SortOrder":"218","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:52:23"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9a08cc1d-61cb-4bcd-bb79-dab602c818df\",\n    \"mediaKey\": \"8712c570-17cc-44d1-86a0-2c60d53c2d7b\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<div style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 14.4px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">عقد مجلس إدارة الهيئة العامة للعقار اجتماعه الثالث يوم الأحد التاسع عشر من رمضان 1439 هــ، برئاسة معالي الأستاذ / ماجد بن عبدالله الحقيل وزير الإسكان رئيس مجلس إدارة الهيئة.<br />واستعرض المجلس ما قامت به الهيئة من أعمال في الربع الثاني من عام 2018م لتنفيذ خطة عملها في مساراتها الخمسة ابتداءً من توفير الشفافية وبناء المؤشرات العقارية بالتعاون مع وزارة العدل و الهيئة العامة للإحصاء والبنك الدولي وعدد من الجهات الحكومية والخاصة ،    وما قامت به الهيئة لبناء قدرات القطاع العقاري وتنفيذ خطة تحول المعهد العقاري السعودي ليكون مركزاً للبحث والتطوير ونقل المعرفة والاعتماد، والجهود التي بذلت في مسار خدمة الشركاء وتأسيس الهيئة لمركز الاتصال( آمر ) للعناية بخدمة الشركاء بالتعاون مع برنامج التعاملات الإلكترونية الحكومية (يسِّر) ،<br />واطلع المجلس على ما تقوم به الهيئة من إجراءات لمراجعة الأنظمة العقارية الحالية وما يحتاجه القطاع العقاري من تنظيم للمرحلة القادمة.</div>\n<div style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 14.4px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"><br />وأوضح معالي وزير الإسكان رئيس مجلس الإدارة بان الهيئة تعمل على تنظيم القطاع العقاري السعودي وتشرف عليه لرفع كفاءته وتطويره وتحفيز بيئة الاستثمار فيه كما تعمل على تنفيذ خطتها وتحقيق رؤيتها بأن يكون قطاع العقار السعودي حيويًا وجاذباً ويتميز بالثقة والابتكار، وأوضح معاليه بأن المجلس بحث خطة عمل الهيئة للنصف الثاني من عام 2018م .وأقر الاتفاقيات المزمع توقيعها بين الهيئة وعدد من الجامعات السعودية لإدراج مسار علوم العقار ضمن التخصصات في هذه الجامعات ،<br />وأوضح معاليه بان المجلس بحث ما قامت به الهيئة من عمل لتنفيذ القاعدة الرئيسيّة في خطتها والمتمثلة في  التسجيل العيني للعقار والاثار الإيجابية المتوقعة لحفظ حقوق الملكية العقارية وإعطاءها الحجية المطلقة بما يرفع مستوى الثقة في القطاع وجاذبية الاستثمار فيه، وأوضح معاليه بأن المجلس أقر الاتفاقيات التي سوف توقعها الهيئة لخدمة برنامجها  التنفيذي للتسجيل العيني مع كل من وزارة العدل للاستفادة من البيانات العقارية وتطويرها، والاتفاقية بين الهيئة والهيئة العامة للمساحة للتعاون في انشاء المنصة الجيومكانية، والاتفاقية بين الهيئة والبريد السعودي في مجال الاستفادة من بيانات المواقع العقارية وكذلك الاستفادة  من البيانات لبناء المؤشرات العقارية .</div>\n<div style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 14.4px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> </div>\n<div style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 14.4px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">وحضر الاجتماع مستشار معالي وزير الإسكان والمشرف العام على وكالة وزارة الإسكان للدعم السكني والفروع صاحب السمو الملكي الأمير سعود بن طلال بن بدر، ووكيل وزارة المالية للإيرادات المهندس طارق بن عبدالله الشهيب، ووكيل وزارة الاقتصاد والتخطيط للشؤون الاقتصادية عبدالعزيز بن متعب الرشيد، والوكيل المساعد للتسجيل العيني للعقار في وزارة العدل الشيخ عبدالله بن عدنان السليمي، ومدير عام الإدارة الهندسية في وزارة التجارة والاستثمار المهندس محمد بن عبدالعزيز الرويلي ، ووكيل وزارة الطاقة والصناعة والثروة المعدنية الدكتور/ صالح بن حسين العواجي ومعالي نائب رئيس مجلس الإدارة محافظ الهيئة العامة للعقار عصام بن حمد المبارك</div>"}},"newsTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يستعرض إنجازات الربع الثاني 2018 م"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يستعرض إنجازات الربع الثاني 2018 م"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8bcebaff-1701-350a-a451-ad00b3067514","Alias":"المعهد العقاري السعودي عقد الاجتماع الثاني لمجلس إدارته","Path":"/42564342-db64-41f2-b594-e9681fa32d91.config","Level":4219,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/42564342-db64-41f2-b594-e9681fa32d91.config","Node":{"Content":{"@Key":"42564342-db64-41f2-b594-e9681fa32d91","@Alias":"المعهد العقاري السعودي عقد الاجتماع الثاني لمجلس إدارته","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"المعهد العقاري السعودي عقد الاجتماع الثاني لمجلس إدارته"},"SortOrder":"219","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:53:32"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2b0fdbcb-4dc5-49d5-ae97-3589a876642b\",\n    \"mediaKey\": \"0395a45c-b6b1-4fc1-bab8-a8b0b1c2036d\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\">عقد مجلس إدارة المعهد العقاري السعودي اجتماعه الثاني مساء يوم الخميس الماضي الخامس عشر من رمضان 1439 هــ، برئاسة معالي محافظ الهيئة العامة للعقار رئيس مجلس إدارة المعهد الأستاذ عصام بن حمد المبارك.<br />وأكد المبارك على الأمل المعقود في الهيئة على دور المعهد  في بناء قدرات القطاع العقاري، من خلال تأهيل وتدريب الشباب والشابات السعوديات وخلق فرص عمل وظيفية لهم، واستعرض المجلس ما تم تنفيذه من  برامج تدريبية في تسع مدن في انشطة تشمل انشطة عقارية منها الوساطة العقارية وإدارة اتحاد الملاك وفحص المباني والبيع على الخارطة وعمله على تأهيلهم للعمل في السوق العقاري السعودي، كما استعرض المجلس ما تم تنفيذه لمراجعة وتقييم وتطوير برامج المعهد التدريبية وتحكيم مناهجه وضمان الجودة والمراقبة والتميز التعليمي وخطة تحول المعهد كمركز لنقل المعرفة والبحث والتطوير والاعتماد،<br />وبحث المجلس دور المعهد في تطوير جودة المباني وتعزيز الثقة في قدرات القطاع العقاري وتحسين مخرجاته والجهود المبذولة لتطوير البرنامج التدريبي المبتكر الذي يعمل عليه المعهد لتنفيذ دورات تدريبية  في مجال استدامة المباني والتي تمكن المتدرب من الحصول على المهارات اللازمة للتعامل مع نظام ضمان جودة تنفيذ البناء، بالإضافة إلى إجادة معايير النظام ,رفع كفاءة المهندس الفاحص من خلال الزيارة الميدانية خلال فترة التدريب.</p>\n<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\">حضر الاجتماع كل من الدكتور سعيد القرني نائب محافظ الهيئة والأستاذ زياد الصايغ نائب محافظ المؤسسة العامة للتدريب التقني والمهني و الأستاذ / عبدالهادي القحطاني،  والدكتور محمد العوضي  والأستاذ حسن الماضي .</p>"}},"newsTitle":{"Value":{"#cdata-section":"المعهد العقاري السعودي عقد الاجتماع الثاني لمجلس إدارته"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"المعهد العقاري السعودي عقد الاجتماع الثاني لمجلس إدارته"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"7db78a57-5383-32eb-a3d9-c210276d7504","Alias":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم","Path":"/32270fba-a8ef-458f-b05b-a622c3c8130a.config","Level":4220,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/32270fba-a8ef-458f-b05b-a622c3c8130a.config","Node":{"Content":{"@Key":"32270fba-a8ef-458f-b05b-a622c3c8130a","@Alias":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:51","NodeName":{"@Default":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم"},"SortOrder":"220","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:55:38"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0ea9f08b-8d16-4af5-b452-6facf2fc71ae\",\n    \"mediaKey\": \"139d7861-45b1-4475-9458-54ac9525aafc\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\">استقبل صاحب السمو الملكي الأمير فيصل بن مشعل بن سعود بن عبدالعزيز  أمير منطقة القصيم في مكتبه اليوم (الخميس) معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك.<br />وشرح معالي المحافظ لسموه دور الهيئة في تنظيم القطاع العقاري وتنميته وتطويره ، وخطة عمل الهيئة خلال الفترة المقبلة ودورها القادم لتحقيق رؤيتها بأن يكون القطاع العقاري السعودي حيوياً وجاذباً ويتميز بالثقة والابتكار، وعرض معالي المحافظ على سموه المشاريع  التي تعمل الهيئة على تنفيذها لتنظيم القطاع العقاري غير الحكومي.<br />وأثنى سمو أمير منطقة القصيم على دور الهيئة وطموحها في تنظيم القطاع العقاري وتأهيل الكوادر البشرية وتشجيع الاستثمار فيما يعود أثره على الاقتصاد الوطني .</p>\n<p style=\"box-sizing: border-box; margin-top: 0px; margin-bottom: 1rem; font-size: 1rem; line-height: 2.5; text-align: right; color: #63666a; font-family: '29ltbukra-md';\">من جهة أخرى، نظمت اللجنة العقارية في الغرفة التجارية في منطقة القصيم لقاءً مفتوحاً صباح اليوم (الخميس) مع معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك   استعرض فيه خطتها للخمس أعوام القادمة والتي تعتمد على قاعدتين رئيسيتين هما: التسجيل العيني للعقار والتخطيط والموافقات، وخمسة مسارات هي: توفير شفافية السوق، وبناء القدرات وتحفيز الاستثمار ورعاية الجهات المعنية والتدقيق والتنفيذ. <br />وقال معالي المحافظ بأن الهيئة عقدت عدداً من اللقاءات مع المهتمين بالشأن العقاري بحثت فيها مبادرات الهيئة لتطوير أداء ورفع كفاءة القطاع العقاري مثل مبادرة إنشاء مركز تسوية النزاعات العقارية ، ومبادرة إنشاء المكتب الفني لدعم نظر القضايا العقارية أمام القضاء <br />ومبادرة تقييم الوضع الحالي للتسجيل العيني للعقار والتى عقد لأجل تنفيذها ستة ورش عمل عن التسجيل العيني بمشاركة ممثلين عن 23 جهة حكومية و15 جهة من القطاع الخاص وخبراء دوليين ومحليين،تم خلالها عرض  أفضل الممارسات الدولية والتجارب السابقة،  وجرى تنفيذ خطة لإعادة هندسة إجراءات التسجيل العيني لرفع الكفاءة وتقليص المدة وتحسين التنسيق وتبادل الأدوار بين الجهات المنفذة للتسجيل\".<br />وأضاف أن الهيئة تعمل على تعزيز الشفافية في السوق العقاري، وهو المسار الأول لخطة عملها وبدأت لتحقيق ذلك العمل على عدة مبادرات أهمها بناء المؤشرات العقارية السعرية وغير السعرية، وتم التعاقد مع البنك الدولي للعمل مع مجموعة من خبرائه على تحديد أهم المؤشرات العقارية، وتوصل الفريق المشترك من الهيئة والبنك إلى تعريف قرابة الأربعين مؤشراً قسمت لثمان تصنيفات رئيسية منها مؤشرات البيع والإيجار والاستيعاب والبناء الجديد، لافتاً إلى أن الهيئة عقدت ورشة عمل للمؤشرات العقارية بحضور خبراء دوليين من الولايات المتحدة وكوريا الجنوبية ومشاركة ممثلين من أكثر من 20 جهة من القطاع الحكومي والخاص لمناقشة أنواع المؤشرات ومصادر البيانات واستعراض للتجربتين الأمريكية والكورية في جمع البيانات وبناء المؤشرات.</p>"}},"newsTitle":{"Value":{"#cdata-section":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"78715804-9c1e-3341-8d6f-30fe4b2eee46","Alias":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس\".. والمبارك يعرّف بدورها وخططها","Path":"/e1b239be-dc8a-4b89-86cf-00ee348ba742.config","Level":4221,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e1b239be-dc8a-4b89-86cf-00ee348ba742.config","Node":{"Content":{"@Key":"e1b239be-dc8a-4b89-86cf-00ee348ba742","@Alias":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس\".. والمبارك يعرّف بدورها وخططها","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس\".. والمبارك يعرّف بدورها وخططها"},"SortOrder":"221","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:15:10"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"e458e59b-fcbc-4a9e-a661-f378f5e2175e\",\n    \"mediaKey\": \"82787e79-a7c6-4c2b-aeb3-24ec21c5246f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">شاركت الهيئة العامة للعقار في معرض ريستاتكس العقاري، الذي يقام في مركز الرياض للمعارض والمؤتمرات بمدينة الرياض خلال الفترة من 6 إلى 8 شعبان الموافق 22 – 25 إبريل ، وقدمت الهيئة في جناحها بالمعرض برامج توعوية للتعريف بها وبدورها في تنظيم القطاع العقاري، ومشاريعها التي ستطلقها خلال الفترة المقبلة، وعدد من الفعاليات المتعلقة بالقطاع من محاضرات ومقاطع فيديو ومنشورات خاصة بها، بهدف إيصالا رسالتها إلى المستفيدين من خدماتها.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وضم جناح الهيئة قسماً خاصاً بالذراع الأكاديمي للهيئة المعهد العقاري السعودي، الذي يهدف إلى تأهيل العاملين في قطاع العقار ومنحهم شهادات احترافية تمكنهم من دخول سوق العمل بكفاءة عالية، وعرضاً عن الدورات التي يقدمها.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وشارك معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك في لقاء مع المهتمين أقيم على هامش المعرض عرض فيه خطة عمل الهيئة ودورها القادم لتحقيق رؤيتها بأن يكون القطاع العقاري السعودي حيوياً وجاذباً ويتميز بالثقة والابتكار، لافتاً إلى أن الهيئة عملت على بناء قدراتها البشرية والتقنية واستهداف الأنشطة المحددة في خطة عملها بدءاً من القاعدة الرئيسية لها: التسجيل العيني للعقار.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وأضاف أن الهيئة عملت على تقييم الوضع الحالي للتسجيل العيني ودراسة أفضل الممارسات الدولية والتجارب السابقة، وإعادة هندسة إجراءات التسجيل العيني لرفع الكفاءة وتقليص المدة وتحسين التنسيق وتبادل الأدوار بين الجهات المنفذة للتسجيل، وعقدت لهذا الغرض ستة ورش عمل مع ممثلين من 23 جهة حكومية و15 جهة من القطاع الخاص وخبراء دوليين ومحليين.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وأوضح المبارك أن الهيئة تعمل على تعزيز الشفافية في السوق العقاري، وهو المسار الأول لخطة عملها وبدأت لتحقيق ذلك العمل على عدة مبادرات أهمها بناء المؤشرات العقارية السعرية وغير السعرية، وتم التعاقد مع البنك الدولي للعمل مع مجموعة من خبرائه على تحديد أهم المؤشرات العقارية، وتوصل الفريق المشترك من الهيئة والبنك إلى تعريف قرابة الأربعين مؤشراً قسمت لثمان تصنيفات رئيسة منها مؤشرات البيع والإيجار والاستيعاب والبناء الجديد، لافتاً إلى أن الهيئة عقدت ورشة عمل للمؤشرات العقارية بحضور خبراء دوليين من الولايات المتحدة وكوريا الجنوبية ومشاركة ممثلين من أكثر من 20 جهة من القطاع الحكومي والخاص لمناقشة أنواع المؤشرات ومصادر البيانات واستعراض للتجربتين الأمريكية والكورية في جمع البيانات وبناء المؤشرات.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وذكر أنه في مجال بناء قدرات القطاع العقاري تعمل الهيئة مع المعهد العقاري لتطوير برامج يمكن الاستفادة منها في بناء القدرات لتنفيذ التسجيل العيني، ومن ذلك تطوير قدرات المساحين وتأهيل الوسطاء العقاريين وخبراء المكاتب الفنية لدعم القضايا العقارية في المحاكم بالتنسيق مع وزارة العدل لتحديد جميع المتطلبات التي يحتاجها القضاة لتسهيل وتسريع عملية اتخاذ القرار في المحاكم.</p>"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس\".. والمبارك يعرّف بدورها وخططها"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس\".. والمبارك يعرّف بدورها وخططها"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9eb938a5-7d84-335d-bcb0-e720c6e2ace3","Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الرابع","Path":"/8e4d9b0d-4b23-4994-b849-4b1f8f728d16.config","Level":4222,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/8e4d9b0d-4b23-4994-b849-4b1f8f728d16.config","Node":{"Content":{"@Key":"8e4d9b0d-4b23-4994-b849-4b1f8f728d16","@Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الرابع","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الرابع"},"SortOrder":"222","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:21:14"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1283ef21-89e0-44ba-8345-cb3aa3464d00\",\n    \"mediaKey\": \"3f40a18b-8f2b-4663-84d6-4036c9b8940d\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">عقد مجلس إدارة الهيئة العامة للعقار اجتماعه الرابع اليوم، برئاسة معالي وزير الإسكان رئيس مجلس إدارة الهيئة الأستاذ ماجد بن عبد الله الحقيل.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">و قدم في بداية الاجتماع , معالي رئيس المجلس والأعضاء التهنئة لخادم الحرمين الشريفين وسمو ولي عهده الأمين - حفظهما الله - , بمناسبة اليوم الوطني الـ 88 ، سائلين الله عز وجل أن يديم على هذه البلاد الأمن والأمان والاستقرار في ظل قيادتنا الرشيدة كما رفع معالي رئيس المجلس شكره وتقديره لخادم الحرمين الشريفين الملك سلمان بن عبد العزيز - حفظه الله - , بمناسبة صدور قرار مجلس الوزراء بتعيين ثلاثة أعضاء من القطاع الخاص في مجلس إدارة الهيئة.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">واستعرض المجلس ما قامت به الهيئة من أعمال في الربع الثالث من عام 2018م لتنفيذ خطة عملها ابتداءً من توفير الشفافية وبناء المؤشرات العقارية بالتعاون مع الجهات الحكومية المعنية ومنها وزارات العدل والإسكان والشؤون البلدية والهيئة العامة للإحصاء، لبناء نظام تقني لمعالجة البيانات العقارية ونشرها.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">و اطلع المجلس على ما قامت به الهيئة لبناء قدرات القطاع العقاري وتنفيذ خطة تحول المعهد العقاري السعودي وتصميم الهيكل التنظيمي والنموذج التشغيلي للمعهد بتنظيمه الجديد، حيث وصل عدد المتدربين إلى 2000 متدرب وعدد الدورات 68 دورة في 10 مدن وفي 8 مجالات عقارية مختلفة، والجهود التي بذلت لخدمة الشركاء حيث تم استقبال ما يقارب 1200 استفسار هاتفي و83 زيارة مباشرة لمقر الهيئة و66 رد من حساب خدمة الشركاء على موقع التواصل الاجتماعي \" تويتر \" , كما اطلع المجلس على ما تقوم به الهيئة من جهود لتنظيم القطاع العقاري وتحسينه ورفع كفاءته والإشراف عليه ، وبحث في هذا الخصوص خطة عملها للربع الرابع من عام 2018 م والتي اشتملت على مجموعة من المبادرات والمشاريع كان من ضمنها تطوير تنظيم أنشطة المكاتب والشركات العقارية واستراتيجية المؤشرات العقارية ومركز البيانات العقارية، ومبادرة مكتب خبراء النزاعات العقارية، ومركز تسوية النزاعات العقارية، ومشروع دراسة تنظيم المساهمات العقارية، وتطوير حلول لتعزيز ثقة القطاع الخاص في ملكية الأرض وتعديل تنظيم التسجيل العيني للعقار.</p>"}},"newsTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الرابع"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الرابع"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a2286e9e-40f2-39c7-a14e-5583f461e954","Alias":"مجلس الهيئة العامة للعقار يعقد اجتماعه السادس","Path":"/84058526-c441-4d80-ac47-8a8e062620b6.config","Level":4223,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/84058526-c441-4d80-ac47-8a8e062620b6.config","Node":{"Content":{"@Key":"84058526-c441-4d80-ac47-8a8e062620b6","@Alias":"مجلس الهيئة العامة للعقار يعقد اجتماعه السادس","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"مجلس الهيئة العامة للعقار يعقد اجتماعه السادس"},"SortOrder":"223","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:23:17"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1689c3e6-9d0a-4a87-9406-e36a1025fba0\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\">عقد مجلس إدارة الهيئة العامة للعقار اجتماعه السادس صباح اليوم الاثنين 18 رجب 1440هــ الموافق 25 / 3 / 2019 م ، برئاسة معالي الأستاذ / ماجد بن عبدالله الحقيل وزير الإسكان رئيس مجلس إدارة الهيئة<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">،</span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">‎</span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">واستعرض عدد من الموضوعات  ومنها التقرير السنوي للهيئة في عامها الأول 2018م، والذي تضمن تنفيذ الهيئة</span> <span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">25 </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">مشروعا وعقد 6<span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\" lang=\"AR-SA\">اتفاقيات، وأقامه 22 ورشة عمل مع المعنيين بالشأن العقاري حول عدد من المسائل التي تهم القطاع . وأشار التقرير السنوي إلى أن الذراع الأكاديمي للهيئة المعهد السعودي العقاري قد تولى مهمة تأهيل مختصين في الأنشطة العقارية من خلال إقامة 118 دورة تدريبية استفاد منها 2873 متدرب في 15 مدينة بالمملكة<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">،</span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span></span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">كما اطلع المجلس على سير عمل تنفيذ مشروع استراتيجية القطاع العقاري السعودي،  وما تم اتخاذه من إجراءات لموائمة هذه الاستراتيجية مع برامج رؤية المملكة 2030 الثلاثة عشر  وتنظيم وتفعيل دور الانشطة العقارية المستهدف زيادة مساهمتها في الناتج المحلي الإجمالي<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">،</span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span></span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">وناقش المجلس التعديلات المقترحة على نظام التسجيل العيني للعقار، وكذلك مشروع تنظيم الهيئة العامة للعقار الجديد وفقاً للاختصاصات المقترح إشرافها عليها</span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\"> </span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\" lang=\"AR-SA\">،</span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">كما بحث المجلس مشروع نظام المساهمات العقارية ودوره في توفير قناة استثمارية للمواطنين وتمويلية لمشاريع التطوير العقاري، كما ناقش المجلس مشروع تحديث تنظيم أنشطة المكاتب والشركات العقارية ومن ضمنها (معايير الهيئة العامة للعقار ) ووجه مجلس إدارة الهيئة بدراسة تطوير المكاتب والشركات العقارية واصدار المعايير اللازمة وفق ما نص عليه تنظيم الهيئة</span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">لرفع كفاءة وجودة الخدمات التي تقدمها الشركات العقارية وثمن المجلس الشراكة بين الهيئة العامة للعقار والجهات المانحة للحوافز وهي وزارة الإسكان – وزارة التجارة والاستثمار - الهيئة العامة للمنشآت الصغيرة والمتوسطة</span> <span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">- </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">بنك التنمية الاجتماعية –صندوق التنمية العقاري- صندوق تنمية الموارد البشرية (هدف ) - ومجلس الغرف التجارية والصناعية<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">،</span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span></span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">وأكد المجلس على أن تمنح هذه الحوافز من الجهات الداعمة  للمكاتب العقارية التي التزمت بالتحول الى شركة سواء شركة شخص واحد أو ذات مسئولية محدودة، والتزمت كذلك بتطبيق معايير الهيئة العامة للعقار باجتياز منسوبيها لمسارات التدريب  في عدد من  الأنشطة العقارية مثل</span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\">  ( </span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\"> </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">ايجار -إدارة الأملاك</span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\"> </span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">–  </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">التسويق العقاري – الاستشارات العقارية – استشارات التمويل العقاري – المزادات العقارية- البيع على الخارطة )، وتوطين وظائف الخدمات والأنشطة التي تقدمها هذه الشركات ، والتزامها  بالعقود النموذجية التي تصدرها الهيئة مثل ( عقد التسويق الحصري – عقد الرغبة في الشراء، ونماذج التسليم والاستلام للمنتجات العقارية</span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> ) </span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\" lang=\"AR-SA\">، </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">‎</span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" lang=\"AR-SA\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; orphans: 2; -webkit-text-stroke-width: 0px; widows: 2; word-spacing: 0px;\">وحضر الاجتماع مستشار معالي وزير الإسكان والمشرف العام على وكالة وزارة الإسكان للدعم السكني والفروع صاحب السمو الملكي الأمير سعود بن طلال بن بدر، ومعالي نائب رئيس مجلس الإدارة محافظ الهيئة العامة للعقار عصام بن حمد المبارك  ، ووكيل وزارة المالية للإيرادات المهندس طارق بن عبدالله الشهيب، ووكيل وزارة العدل المساعد للتسجيل العيني للعقار فضيلة الشيخ/ عبدالله بن عدنان السليمي ، ووكيل وزارة الشؤون البلدية والقروية المساعد لتخطيط المدن المهندس/ أحمد بن عبدالرحمن السليم ومستشار وزير الطاقة والصناعة والثروة المعدنية المشرف على الشؤون القانونية الدكتور محمد بن حمد الفهد ، ومدير عام الإدارة الهندسية في وزارة التجارة والاستثمار المهندس محمد بن عبدالعزيز الوايلي، ومن القطاع الخاص سعادة الأستاذ / حمد بن علي الشويعر رئيس اللجنة الوطنية العقارية في مجلس الغرف السعودية، وسعادة الأستاذ / سعيد بن محمد الغامدي   رئيس مجلس إدارة البنك الأهلي<span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\"> </span></span><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 13pt; line-height: 200%;\" lang=\"AR-SA\">التجاري</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"مجلس الهيئة العامة للعقار يعقد اجتماعه السادس"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مجلس الهيئة العامة للعقار يعقد اجتماعه السادس"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"6471074c-7587-3554-8e32-8edc764151d8","Alias":"\"الهيئة العامة للعقار تدشن موقعها الإلكتروني.. وتطلق حسابها في \"تويتر","Path":"/6a233bc8-b4ec-410b-b287-0759687a75a5.config","Level":4224,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6a233bc8-b4ec-410b-b287-0759687a75a5.config","Node":{"Content":{"@Key":"6a233bc8-b4ec-410b-b287-0759687a75a5","@Alias":"\"الهيئة العامة للعقار تدشن موقعها الإلكتروني.. وتطلق حسابها في \"تويتر","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"\"الهيئة العامة للعقار تدشن موقعها الإلكتروني.. وتطلق حسابها في \"تويتر"},"SortOrder":"224","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:25:09"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"d8e9b4c6-69c1-4f2e-8727-efd8fbc9a83b\",\n    \"mediaKey\": \"26292c66-5ad7-4172-9695-1ce4be96d28a\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">دشن معالي وزير الإسكان رئيس مجلس إدارة الهيئة العامة للعقار ماجد بن عبدالله الحقيل الموقع الإلكتروني للهيئة (<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">www.rega.gov.sa</span>)، كما أطلق حسابها الرسمي في موقع التواصل الاجتماعي \"تويتر\" (<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">@REGA_KSA</span>)، ليكون نافذة للتواصل مع المهتمين بالقطاع العقاري، وذلك خلال ترأسه للاجتماع الثاني لمجلس إدارة الهيئة. </span></p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وتضمن جدول أعمال اجتماع المجلس عرضاً لإنجازات الهيئة في الربع الأول من عام 2018م، وعرض فيلماً توثيقياً عنها.</span></p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">واستعرض المجلس الأنشطة العقارية المستهدفة من عام 2018م، كما اطلع على ما تقوم به الهيئة من أعمال لتطوير الأنظمة واللوائح الخاصة بهذه الأنشطة، تنفيذاً لاستراتيجية الهيئة ورؤيتها التي تهدف إلى أن يكون القطاع العقاري في المملكة حيوياً وجاذباً ويتميز بالثقة والابتكار.</span></p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وحضر الاجتماع مستشار معالي وزير الإسكان والمشرف العام على وكالة وزارة الإسكان للدعم السكني والفروع صاحب السمو الملكي الأمير سعود بن طلال بن بدر، ومعالي نائب رئيس مجلس الإدارة محافظ الهيئة العامة للعقار عصام بن حمد المبارك، ووكيل وزارة الطاقة والصناعة والثروة المعدنية لشؤون الكهرباء الدكتور صالح بن حسين العواجي، ووكيل وزارة المالية للإيرادات المهندس طارق بن عبدالله الشهيب، ووكيل وزارة الشؤون البلدية والقروية لتخطيط المدن الدكتور زهير بن حسن زاهد، ووكيل وزارة الاقتصاد والتخطيط للشؤون الاقتصادية عبدالعزيز بن متعب الرشيد، والوكيل المساعد للتسجيل العيني للعقار في وزارة العدل عبدالله بن عدنان السليمي، ومدير عام الإدارة الهندسية في وزارة التجارة والاستثمار محمد بن عبدالعزيز الرويلي.</span></p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"> </p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">يذكر أن الهيئة العامة للعقار تأسست بموجب قرار مجلس الوزراء في 25/4/1438هـ، بهدف تنظيم النشاط العقاري غير الحكومي والإشراف عليه وتطويره لرفع كفاءته وتشجيع الاستثمار فيه بما يتفق مع أهداف التنمية الاقتصادية.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار تدشن موقعها الإلكتروني.. وتطلق حسابها في \"تويتر"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار تدشن موقعها الإلكتروني.. وتطلق حسابها في \"تويتر"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"04ac4f0b-6638-3a03-8e0f-b93663f3aeb6","Alias":"مذكرة تفاهم تجمع المركز السعودي للتحكيم التجاري والهيئة العامة للعقار","Path":"/972d7af0-4c37-4f33-aeb8-63b1200ccd5a.config","Level":4225,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/972d7af0-4c37-4f33-aeb8-63b1200ccd5a.config","Node":{"Content":{"@Key":"972d7af0-4c37-4f33-aeb8-63b1200ccd5a","@Alias":"مذكرة تفاهم تجمع المركز السعودي للتحكيم التجاري والهيئة العامة للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"مذكرة تفاهم تجمع المركز السعودي للتحكيم التجاري والهيئة العامة للعقار"},"SortOrder":"225","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:25:52"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a51e28d6-fd51-4dff-810d-3fcb2e398e1b\",\n    \"mediaKey\": \"8a44b8da-76cf-4b55-ad57-ed5dfb62d32a\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">سعياً من الهيئة العامة للعقار لتنفيذ رؤيتها بأن يكون القطاع العقاري السعودي حيوياً وجاذباً ويتميز بالثقة والابتكار، ومن منطلق تعزيز التعاون والشراكات بين المركز السعودي للتحكيم التجاري<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"> \"SCCA\" </span>والجهات الحكومية المؤثرة، لتطوير ممارسات مؤسسية فاعلة لبدائل تسوية منازعات الاختصاصات المهنية في المملكة، وقَّع المركز السعودي للتحكيم التجاري<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"> “SCCA”  </span>مذكرة تفاهم مع الهيئة العامة للعقار، تضمنت التعاون فيما يتصل بتطوير استراتيجيات وإجراءات العمل المتعلقة ببدائل تسوية المنازعات العقارية. كما تهدف المذكرة إلى استقطاب وتبني أفضل الممارسات الإقليمية والدولية وتعزيز نقل المعرفة بما ينعكس على تطوير بدائل تسوية المنازعات العقارية<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">.</span></span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأشاد معالي محافظ الهيئة العامة للعقار الأستاذ/ عصام بن حمد المبارك، بأهمية تعزيز العلاقات وروابط التعاون والتي تتضمن تبادل الخبرات ورفع جودة الكفاءات، بين الهيئة العامة للعقار والجهات ذات الاختصاص والصلة كالمركز السعودي للتحكيم التجاري، بهدف تخفيض عدد القضايا العقارية المحولة للمحاكم والرفع من حيوية وجاذبية القطاع العقاري لجميع الأطراف ذات العلاقة وتعزيز الثقة به، وتقليص المدة الزمنية لإنهاء النزاعات العقارية. والذي يمثّل التوجه الذي تتبناه الهيئة بشكلٍ دائم لتحقيق رؤيتها في أن يكون قطاع العقار السعودي متّسمًا بالحيوية والجاذبية، ومتميّزًا في جودة ابتكاره وثقة المستثمرين والمستهلكين الراسخة فيه، وإنفاذًا لمهامها عبر الإسهام في تحقيق رؤية المملكة 2030<span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\">.</span></span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">كما أثنى الرئيس التنفيذي للمركز السعودي للتحكيم التجاري الدكتور حامد ميرة على هذه الخطوة المباركة والتي تجسّد النية العازمة لتذليل المصاعب، والتعاون المثمر مع الهيئات والجهات المنظمة مثل الهيئة العامة للعقار باعتبارها شريكاً مبادراً في تنمية القطاع العقاري في المملكة.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأكد د. حامد ميرة على جاهزية المركز السعودي للتحكيم التجاري واستعداده الدائم للتعاون فيما له مصلحة في تعزيز وتطوير خدمات مهنيّة وشفّافة وسريعة لبدائل تسوية منازعات القطاع العقاري، كالتحكيم والوساطة، والتي تتميز بوضوح الإجراءات واختصار الوقت للمستفيدين، وذلك وفق أعلى الممارسات الدولية وأعمقَ فهمٍ للممارسة المحلية.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"مذكرة تفاهم تجمع المركز السعودي للتحكيم التجاري والهيئة العامة للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مذكرة تفاهم تجمع المركز السعودي للتحكيم التجاري والهيئة العامة للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"7002169a-2eac-369a-a235-72691ac12668","Alias":"الهيئة العامة للعقار توقع اتفاقية مع مركز الاتصال الوطني آمر","Path":"/6c60d396-1825-4f8e-b007-a0a8c7348fdc.config","Level":4226,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6c60d396-1825-4f8e-b007-a0a8c7348fdc.config","Node":{"Content":{"@Key":"6c60d396-1825-4f8e-b007-a0a8c7348fdc","@Alias":"الهيئة العامة للعقار توقع اتفاقية مع مركز الاتصال الوطني آمر","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"الهيئة العامة للعقار توقع اتفاقية مع مركز الاتصال الوطني آمر"},"SortOrder":"226","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:26:52"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9ff474d1-5b88-40d0-9d09-1f726c54a9d2\",\n    \"mediaKey\": \"4451a5b7-cbe5-4a8c-b231-797aae055832\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وقعت الهيئة العامة للعقار اتفاقية تعاون مع مركز الاتصال الوطني (آمر)، الذي يشرف عليه برنامج التعاملات الإلكترونية الحكومية (يسر)، ووقع الاتفاقية معالي محافظ الهيئة الأستاذ عصام بن حمد المبارك ووقع من جانب البرنامج  سعادة المهندس علي بن ناصر العسيري المدير العام لبرنامج (يسّر).</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وأوضح  معالي المحافظ أن أحد المسارات الرئيسية لخطة عمل الهيئة هو مسار خدمة العملاء ورفع مستوى جودة الخدمات المقدمة للمستفيدين، وأن هذ الاتفاقية تأتي لتساهم في تحقيق هذا الهدف وتحسين الخدمات التي تقدمها الهيئة لعملائها بإستخدام أفضل الوسائل وأحدث التقنيات لتمكين المستفيدين من الحصول على خدمات حكومية تواكب احتياجاتهم، وأكد على أن الهيئة سوف تستمر في بناء قنوات التواصل مع الجمهور بما يخدم كافة أفراد المجتمع.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">من جانبه، أكد المدير العام لـ (يسّر) أن البرنامج يسعى إلى خدمة الجهات الحكومية في المملكة وفق أعلى درجات الأداء، فضلاً عن الوقوف إلى جانب تلك الجهات لتمكينها من خدمة المستفيدين على اختلاف شرائحهم.</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\">وأضاف أن مركز الاتصال الوطني (آمر) يقدم المعلومات والإجابات الخاصة بالتعاملات الإلكترونية الحكومية بشكل احترافي سريع وملائم بما يتناسب مع تساؤلات جمهور المستفيدين واستفساراتهم ، بالإضافة إلى تقديم الحلول وكافة الإجابات من خلال قنوات إلكترونية متنوعة وذلك للمواطنين والمقيمين وقطاع الأعمال والزوار، لافتاً إلى أن مركز (آمر) يهدف إلى تيسير وتسهيل عمليات البحث والتواصل الإلكتروني ، وتقليل الأعباء عن القطاعات الرئيسية المقدمة للخدمات، بالإضافة إلى رفع مستوى الاستجابة السريعة للقطاع الحكومي في تقديم المساعدة في الوقت المناسب.</p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار توقع اتفاقية مع مركز الاتصال الوطني آمر"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار توقع اتفاقية مع مركز الاتصال الوطني آمر"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"cd030ff6-3bf9-33f2-96dc-126dfda4d37a","Alias":"هيئة العقار تستعرض استراتيجيتها خلال ورشة عمل","Path":"/2b229008-e77f-4b1a-af73-6e010d2fd952.config","Level":4227,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2b229008-e77f-4b1a-af73-6e010d2fd952.config","Node":{"Content":{"@Key":"2b229008-e77f-4b1a-af73-6e010d2fd952","@Alias":"هيئة العقار تستعرض استراتيجيتها خلال ورشة عمل","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"هيئة العقار تستعرض استراتيجيتها خلال ورشة عمل"},"SortOrder":"227","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:27:16"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"49361417-982c-4b1f-85ff-c881d23933f9\",\n    \"mediaKey\": \"5354d32d-bfef-4cde-9396-8318e9a066c0\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">أكّد مدير مكتب تنفيذ الاستراتيجية والبرامج في الهيئة العامة للعقار الأستاذ خالد الدخيل أن الهيئة تسعى لإيجاد بيئة جاذبة للمستثمرين المحليين والدوليين، وتعزيز ثقتهم باقتصاد المملكة، كاشفاً عن أن استراتيجية الهيئة ترتكز على خمسة محاور رئيسية تعتمد على تعزيز الشفافية وبناء القدرات وتحفيز الاستثمار وتوفير الحماية للمشاركين في السوق والتدقيق والتنفيذ.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأوضح الدخيل خلال ورشة عمل بعنوان \"استراتيجية الهيئة العامة للعقار\" والتي عقدت اليوم (الخميس) ضمن فعاليات معرض \"ريستاتكس – سيتي سكيب 2017\" العقاري، في مركز الرياض الدولي للمؤتمرات والمعارض، أن الهيئة لتحقيق رؤيتها الاستراتيجية وتماشياً مع رؤية المملكة 2030 قامت بمقارنات محلية ودولية تهدف إلى الاطلاع على تجارب عالمية لتوظيف أهم الدروس المكتسبة من الجهات المنظمة للقطاع العقاري في كل من أستراليا والولايات المتحدة وهونج كونج وسنغافورة والإمارات العربية المتحدة، إضافة إلى الاستماع لآراء العموم والمختصين، حيث عقدت عدة اجتماعات مع المختصين والمهتمين في هذا القطاع من عقاريين ومطورين ومستثمرين، وذلك للوصول إلى ما نصت عليه الرؤية من مستهدف يتمثل في تصنيف ثلاث مدن ضمن أفضل 100 مدينة بالعالم، وتخفيض معدل البطالة من 11,6 إلى 7%، وارتفاع مساهمة المنشآت  الصغيرة والمتوسطة في إجمالي الناتج المحلي من 20% إلى 35%، وزيادة الإيرادات الحكومية غير النفطية من 163 مليار رـيال، إلى تريليون ريـال سعودي.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأضاف: \"أن الهدف الأساسي لهيئة العقار التي تأسست بموجب قرار مجلس الوزراء رقم 239 بتاريخ 25/4/1438هـ، هو تنظيم النشاط العقاري غير الحكومي والإشراف عليه وتطويره لرفع كفاءته وتشجيع الاستثمار فيه بما يتفق مع أهداف التنمية الاقتصادية\".</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وحول الصلاحيات المنوطة بالهيئة قال الدخيل: \"أنها تتوزع بين التنظيم والإشراف واقتراح الأنظمة واللوائح والسياسات ذات العلاقة بالأنشطة العقارية، إضافة إلى توفير التدريب والتأهيل اللازمين للعاملين في القطاع، ونشر الوعي بأنظمة القطاع العقاري وأنشطته، وعقد المؤتمرات والندوات واللقاءات المتعلقة بمجالات عمل الهيئة وفقاً للضوابط المنظمة لذلك، إضافة إلى مراقبة السوق العقاري عبر إنشاء بوابة إلكترونية تحتوي على قواعد بيانات للمعلومات العقارية اللازمة للأنشطة العقارية، ومراقبة مؤشرات القطاع العقاري لتحقيق الاستقرار والتوازن، وإجراء البحوث والدراسات والإحصاءات في مجال الانشطة العقارية\".</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأفاد الدخيل أن الهيئة تسعى إلى تشجيع الاستثمار والتطوير العقاري، عبر تشجيع الاستثمار في الأنشطة العقارية وتوفير البيئة المناسبة للمنافسة العادلة في هذا المجال، ومتابعة تنفيذ الاتفاقيات ذات الصلة بالعقار المبرمة بين المملكة والدول الأخرى وذلك بالتنسيق مع الجهات المعنية، إضافة إلى التكامل والتنسيق مع الجهات ذات العلاقة بهدف ضمان تكامل البنى التحتية للعقارات وتحقيق الأهداف والسياسات والاستراتيجيات الوطنية في هذا المجال.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار تستعرض استراتيجيتها خلال ورشة عمل"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"هيئة العقار تستعرض استراتيجيتها خلال ورشة عمل"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"0f8c6f62-d5ff-3d24-89c0-c38e273c9114","Alias":"الحقيل: إنشاء الهيئة العامة للعقار يعزّز أداء القطاع العقاري ويرفع من مساهمته في الناتج المحلي","Path":"/ecef77f0-20c8-487c-bfdf-5295a11eb15b.config","Level":4228,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ecef77f0-20c8-487c-bfdf-5295a11eb15b.config","Node":{"Content":{"@Key":"ecef77f0-20c8-487c-bfdf-5295a11eb15b","@Alias":"الحقيل: إنشاء الهيئة العامة للعقار يعزّز أداء القطاع العقاري ويرفع من مساهمته في الناتج المحلي","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:50","NodeName":{"@Default":"الحقيل: إنشاء الهيئة العامة للعقار يعزّز أداء القطاع العقاري ويرفع من مساهمته في الناتج المحلي"},"SortOrder":"228","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:27:47"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2b5fbaf8-6511-490e-9aad-973cc4441fa7\",\n    \"mediaKey\": \"ef977409-8bec-4cdc-b5cb-5a6414fbaade\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">ثمّن معالي وزير الإسكان ماجد بن عبدالله الحقيل، اعتماد مجلس الوزراء في جلسته اليوم الإثنين 25-4-1438 برئاسة خادم الحرمين الشريفين الملك سلمان بن عبدالعزيز آل سعود -حفظه الله- قرار إنشاء الهيئة العامة للعقار، لتتولى تنظيم النشاط العقاري غير الحكومي والإشراف عليه وتطويره لرفع كفاءته وتشجيع الاستثمار فيه بما يتفق مع أهداف التنمية الاقتصادية والاجتماعية، منوّهاً إلى أن ذلك يأتي امتداداً للدعم المتواصل من القيادة الحكيمة لتنظيم وتنمية القطاع العقاري.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأكد معاليه على أن مبادرة إنشاء الهيئة العامة للعقار حظيت بالدعم والاهتمام من قبل مجلس الشؤون الاقتصادية والتنمية، وتواصلاً لهذا الاهتمام جاء اليوم اعتماد إنشائها لتسهم بدورها في تقديم مجموعة من الخدمات للمواطنين والمطورين والجهات ذات العلاقة، إذ أن هذه الخطوة تُعدّ ضمن الأهداف الاستراتيجية لرؤية المملكة 2030 وبرنامج التحوّل الوطني 2020، في إطار تحسين أداء القطاع العقاري ورفع مساهمته في الناتج المحلي.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأوضح الحقيل أهمية تنظيم القطاع العقاري والإرتقاء به ليصبح قطاعاً جاذباً ومتكاملاً، كونه ذو تأثير فاعل على اقتصاد المملكة، مبيناً أن الإحصاءات الرسمية الصادرة عام 2016م تشير إلى أن الناتج المحلي الإجمالي لقطاع العقار يبلغ بالأسعار الثابتة لعام  2010 حوالي (128) مليار ريال،  في حين تبلغ نسبة النمو السنوي المركب مقدار (6%) للفترة بين عامي (2012) و(2016)، فيما بلغت نسبة المساهمة النسبية لقطاع العقار في الناتج المحلي الإجمالي بالأسعار الثابتة لعام (2010) نحو (4.9%)، بما يشكّل نسبة (8.3%) من إجمالي الناتج المحلي غير النفطي.  </span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وتابع:\" تعكس هذه الإحصاءات الأهمية القصوى للقطاع العقاري ومدى تأثيره الإيجابي، إذ أن  التأثير المضاعف على الاستثمارات في القطاع العقاري يصل إلى حوالي (8.7) ريال كمخرجات اقتصادية مباشرة وغير مباشرة، كما تبلغ قيمة المضاعف للقيمة المضافة حوالي (5.2) ريال، ويمتد هذا التأثير إلى المنشآت والمؤسسات ذات العلاقة، حيث تشير الإحصاءات إلى أن عدد المنشآت التي تعمل في قطاع العقار بلغ حوالي (39.5) ألف منشأة، (90%) منها  منشآت صغيرة، وتسهم بحوالي (4.1%) من إجمالي المنشآت في العام (2015)، وحسب المسح الاقتصادي السنوي للمؤسسات للعام 2015م بلغ عدد العاملين السعوديين في الأنشطة العقارية حوالي (74.5) ألف فرد، بما يعادل حوالي (48%) من إجمالي العاملين في هذا القطاع حيث تهدف الهيئة لزيادة نسبة العاملين السعوديين في القطاع العقاري، علماً أن ذلك يأتي في ظل معدل نمو سكاني يبلغ (2.54%) في العام (2016) وإرتفاع نسبة السكان في الفئة العمرية بين عمر (15) و(34) سنة إلى حوالي (53%).</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">وأفاد بأن الهيئة ستكون ذات استقلالية مالية وإدارية وتمتلك صلاحيات واسعة لاقتراح التعديلات والتحسينات على جميع الأنظمة واللوائح والسياسات ذات العلاقة بالأنشطة العقارية والرفع بها لاستكمال ما يلزم بشأنها، ووضع الخطط اللازمة لممارسة اختصاصاتها، ووضع المعايير للأنشطة العقارية وترخيصها والإشراف عليها، إضافة إلى تشجيع الاستثمار وتوفير البيئة المناسبة للمنافسة العادلة  في هذا المجال، والتنسيق مع الجهات المعنية لضمان تكامل البنى التحتية للعقارات وتحقيق الأهداف والسياسات والاستراتيجيات الوطنية ذات العلاقة.</span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\">كما سيكون من مهام واختصاصات الهيئة أيضاً، العمل على نشر الوعي بأنظمة القطاع العقاري وأنشطته، ومراقبة مؤشرات القطاع العقاري بما يحقق له الاستقرار والتوازن، ومتابعة تنفيذ الاتفاقيات ذات الصلة بالأنشطة العقارية المبرمة بين المملكة والدول الأخرى، إلى جانب تفعيل التدريب والتأهيل للمرخّص لهم بمزاولة الأنشطة العقارية، وإجراء الأبحاث والدراسات والإحصاءات في هذا المجال، ووضع الضوابط اللازمة لتنظيم الإعلانات العقارية ومراقبتها، وإنشاء بوابة إلكترونية تحتوي على قواعد المعلومات العقارية مع تحديثها دورياً وإتاحتها للمعنيين.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الحقيل: إنشاء الهيئة العامة للعقار يعزّز أداء القطاع العقاري ويرفع من مساهمته في الناتج المحلي"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الحقيل: إنشاء الهيئة العامة للعقار يعزّز أداء القطاع العقاري ويرفع من مساهمته في الناتج المحلي"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ee593904-f6b5-3927-ba55-bd41c83d0171","Alias":"محافظ الهيئة العامة للعقار يعلن طرح المسودة الأولى من نظام الوساطة العقارية ونظام المساهمات العقارية لطلب مرئيات العموم","Path":"/58716433-6739-4d72-a13c-ce8e1b268920.config","Level":4229,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/58716433-6739-4d72-a13c-ce8e1b268920.config","Node":{"Content":{"@Key":"58716433-6739-4d72-a13c-ce8e1b268920","@Alias":"محافظ الهيئة العامة للعقار يعلن طرح المسودة الأولى من نظام الوساطة العقارية ونظام المساهمات العقارية لطلب مرئيات العموم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:49","NodeName":{"@Default":"محافظ الهيئة العامة للعقار يعلن طرح المسودة الأولى من نظام الوساطة العقارية ونظام المساهمات العقارية لطلب مرئيات العموم"},"SortOrder":"229","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T12:23:02"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"dfa7d739-f3cc-4caf-909c-11d1a2938a2c\",\n    \"mediaKey\": \"22cb7cda-8b6d-4923-9dda-0d18716d8662\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; font-weight: bolder;\\\">أعلن معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد &nbsp;المبارك عن طرح &nbsp;الهيئة لمشروع نظام الوساطة العقارية، ومشروع نظام المساهمات &nbsp;العقارية، وذلك بهدف إطلاع الجمهور عليهما، والحصول على مرئياتهم &nbsp;وذلك من خلال موقع الهيئة الالكتروني وحساباتها على مواقع التواصل الاجتماعي .</span></p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; font-weight: bolder;\\\">وأوضح معالي المحافظ أن طرح مشروعي النظامين الجديدين &nbsp;يأتي &nbsp;تنفيذا لما قضى به تنظيم الهيئة بأن تقترح &nbsp;الهيئة الأنظمة واللوائح والسياسات ذات العلاقة بالأنشطة العقارية، والرفع عنها وكذلك &nbsp;تفعيلاً لمهام الهيئة بالرقابة والإشراف وتنفيذ أحكام الأنظمة المعنية بقطاع العقار السعودي. مؤكداً على أن<span style=\\\"box-sizing: border-box; font-family: Bukra-Light; font-size: 14px;\\\">&nbsp;</span><em style=\\\"box-sizing: border-box;\\\"><span style=\\\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\\\"><u style=\\\"box-sizing: border-box;\\\">آراء &nbsp;كافة المهتمين بالشأن العقاري &nbsp;ستؤخذ في الاعتبار لتحسين &nbsp;وتطوير النظامين بما يعود بالنفع على كافة الأطراف المعنية.</u></span></em></span></p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; font-weight: bolder;\\\">وأكد معاليه على أن الهيئة ماضية بتوفيق الله في تنظيم النشاط العقاري غير الحكومي والإشراف عليه، وتطويره لرفع كفاءته، وتشجيع الاستثمار فيه. وأوضح بأن مشروع نظام &nbsp;الوساطة العقارية الجديد &nbsp;يعنى بتنظيم وتطوير الوساطة العقارية وأنشطتها ومنها: التسويق العقاري، وإدارة الأملاك، وإدارة المرافق والمزاد العقاري، وتسويق العقار الخارجي، وأن مشروع النظام يحدد إجراءات حصول المنشآت على تراخيصها. ويعزز دور منشآت الوساطة العقارية في توفير خدمات عقارية مميزة ، واكد معاليه على أن من ضمن مساعي الهيئة &nbsp;لرفع كفاءة منشآت الوساطة العقارية، قيامها بتوفير برامج التدريب والتأهيل للمهنيين الممارسين في القطاع العقاري السعودي، ومنح الشهادات التي تمكنهم من دخول سوق العمل بكفاءة عالية، وذلك من خلال المعهد العقاري السعودي التابع للهيئة، والذي يعنى بنشر المعرفة وبناء الكفاءات في هذا المجال.</span></p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\"><span style=\\\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px; font-weight: bolder;\\\">وأشار معاليه الى أن نظام المساهمات العقارية الجديد &nbsp;يهدف إلى تنظيم نشاط المساهمات وحماية حقوق جميع أطراف المساهمة، فضلاً عن رفع مستوى الإفصاح والشفافية في هذا النشاط، وتوضح المسودة الأولى لمشروع النظام كافة الشروط المتعلقة بالمساهمة العقارية، وأشكالها، والوسائل التي سيتم طرح المساهمة عبرها، بالإضافة إلى بنود مفصلة تتعلق بالمرخصين</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"محافظ الهيئة العامة للعقار يعلن طرح المسودة الأولى من نظام الوساطة العقارية ونظام المساهمات العقارية لطلب مرئيات العموم"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"محافظ الهيئة العامة للعقار يعلن طرح المسودة الأولى من نظام الوساطة العقارية ونظام المساهمات العقارية لطلب مرئيات العموم"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"66082460-e4ba-39df-8212-e00c3c43d968","Alias":"الأمير سعود بن طلال يثمن قرار مجلس الوزراء بنقل اختصاص التسجيل العيني للعقار إلى الهيئة العامة للعقار","Path":"/83813bdd-3c4d-40da-bb17-708f94841b65.config","Level":4230,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/83813bdd-3c4d-40da-bb17-708f94841b65.config","Node":{"Content":{"@Key":"83813bdd-3c4d-40da-bb17-708f94841b65","@Alias":"الأمير سعود بن طلال يثمن قرار مجلس الوزراء بنقل اختصاص التسجيل العيني للعقار إلى الهيئة العامة للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:49","NodeName":{"@Default":"الأمير سعود بن طلال يثمن قرار مجلس الوزراء بنقل اختصاص التسجيل العيني للعقار إلى الهيئة العامة للعقار"},"SortOrder":"230","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T12:32:50"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"5d54634d-13ff-4613-b280-4cf2e68b4d6d\",\n    \"mediaKey\": \"b2e02641-6dcb-44bf-9525-717818c46e56\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p dir=\"RTL\" class=\"MsoNormal\"><span style=\"mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\" lang=\"AR-SA\">ثمّن صاحب السمو الملكي الأمير سعود بن طلال بن بدر آل سعود ، عضو مجلس إدارة الهيئة العامة للعقار، قرار مجلس الوزراء بمنح الهيئة العامة للعقار صلاحية مباشرة الاختصاصات المقررة نظاماً والمعهودة إلى وزارتي العدل والشؤون البلدية والقروية فيما يتعلق بالتسجيل العيني للعقار</span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"font-size: 10.0pt; line-height: 105%; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\">.</span></span></p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\" class=\"MsoNormal\"><span style=\"mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\" lang=\"AR-SA\">وأوضح سموه أن هذا القرار سيكون من شأنه المساهمة في حفظ حقوق الملكية العقارية، وتطوير إجراءات بيع وشراء العقار، وتشجيع الاستثمار فيه بزيادة موثوقية الملكية العقاريةوسوف يساهم  في فعالية قطاع التطوير العقاري</span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"font-size: 10.0pt; line-height: 105%; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\">.</span></span></p>\n<p dir=\"RTL\" class=\"MsoNormal\"><span style=\"mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\" lang=\"AR-SA\">وأشار سموه إلى أن تحسين إجراءات التسجيل العيني وزيادة كفاءته سوف تعزز من جاذبية الاستثمار في القطاع العقاري وتشجيع المستثمرين على الاستفادة من الفرص العقارية المميزة، فضلاً عن دوره  في الحد من الخلافات على الملكية العقارية</span><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"font-size: 10.0pt; line-height: 105%; mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\">.</span></span></p>\n<p dir=\"RTL\" class=\"MsoNormal\"><span style=\"mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\" lang=\"AR-SA\">ورفع صاحب السمو الملكي الامير سعود بن طلال خالص الشكر والعرفان  لمقام خادم الحرمين الشريفين الملك سلمان بن عبدالعزيز، وولي عهده الأمين صاحب السمو الملكي الأمير محمد بن سلمان بن عبدالعزيز – حفظهما الله- على ما تقدمه قيادتنا الرشيدة من دعم وتمكين للقطاع العقاري وتحسين دوره وتنميته وزيادة مساهمته في الناتج المحلي الإجمالي للمملكة.</span></p>\n<p dir=\"RTL\" class=\"MsoNormal\"><span style=\"mso-bidi-font-family: Calibri; mso-bidi-theme-font: minor-latin;\"> </span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الأمير سعود بن طلال يثمن قرار مجلس الوزراء بنقل اختصاص التسجيل العيني للعقار إلى الهيئة العامة للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الأمير سعود بن طلال يثمن قرار مجلس الوزراء بنقل اختصاص التسجيل العيني للعقار إلى الهيئة العامة للعقار"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e00addd6-7688-3a1c-8bc4-6978de171eeb","Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه السابع","Path":"/a99b7c81-76bd-4395-aaac-b309ffc7f62a.config","Level":4231,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a99b7c81-76bd-4395-aaac-b309ffc7f62a.config","Node":{"Content":{"@Key":"a99b7c81-76bd-4395-aaac-b309ffc7f62a","@Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه السابع","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:49","NodeName":{"@Default":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه السابع"},"SortOrder":"231","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:06:05"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"8ab60fbc-c781-4a11-b92b-94bdc46b3497\",\n    \"mediaKey\": \"37bd59fb-a10a-4dc1-a42c-95f27c33850a\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 16px;\">عقد مجلس إدارة الهيئة العامة للعقار اجتماعه السابع يوم الخميس 18 رمضان 1440هــ الموافق 23 / 4 / 2019 م في مقر الهيئة برئاسة معالي وزير الإسكان، رئيس مجلس إدارة الهيئة، الأستاذ ماجد بن عبد الله الحقيل.</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 16px;\"> </span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 16px;\">وقد ثمن معالي رئيس وأعضاء المجلس في بداية الاجتماع قرار مجلس الوزراء رقم ( 507 ) وتاريخ 2 / 9 / 1440هــ بمنح الهيئة العامة للعقار صلاحية مباشرة الاختصاصات المقررة نظاماً والمعهودة إلى وزارتي العدل والشؤون البلدية والقروية فيما يتعلق بالتسجيل العيني للعقار ، وقد أكد المجلس على أهمية توحيد الإشراف على التسجيل العيني للعقار  لرفع كفاءة وسرعة إجراءات التسجيل العيني للعقار ويزيد موثوقية ملكية العقار، وشدد على اهمية اكمال مشروع نظام التسجيل العيني للعقار، وعرضه للعموم لطلب مرئياتهم  .</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 16px;\"> </span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 16px;\">واستعرض المجلس ما قامت به الهيئة من أعمال خلال الفترة الماضية من الربع الثاني من عام 2019 وما قامت به  بشأن  خطة عمل تنفيذ التسجيل العيني ، كما ناقش مرئيات العموم بخصوص مشروع نظام المساهمات العقارية ومشروع نظام الوساطة .العقارية ووجه بالأخذ بالمرئيات قبل الرفع بهما لاستكمال الإجراءات النظامية بشأنهما</span><br /><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 16px;\"> واطلع المجلس على تقرير  اللجنة المشتركة من الجهات الحكومية المكلفة بإطلاق منصة المؤشرات العقارية و ناقش مشروع قياس الأثر التنظيمي لمبادرات اتمام وإيجار والبيع على الخارطة ، واستعرض  مراحل صياغة  استراتيجية القطاع العقاري في المملكة، والدراسات التي تم إعدادها لدراسة الوضع الراهن، وتحديد الركائز الرئيسيّة ومبادرات استراتيجية القطاع العقاري المقترحة وما تم اتخاذه لمواءمتها مع برامج الرؤية وخطط الجهات ذوات العلاقة</span><br /><br /></p>\n<p style=\"box-sizing: border-box; color: #212529; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 16px;\">وقد حضر الاجتماع مستشار معالي وزير الإسكان والمشرف العام على وكالة وزارة الإسكان للدعم السكني والفروع صاحب السمو الملكي الأمير سعود بن طلال بن بدر، ومعالي نائب رئيس مجلس الإدارة محافظ الهيئة العامة للعقار عصام بن حمد المبارك، و محافظ الهيئة العامة لعقارات الدولة معالي الأستاذ إحسان بن عباس بن حمزة بافقيه، ووكيل وزارة المالية للإيرادات المهندس طارق بن عبدالله الشهيب، وممثل وزارة العدل فضيلة الشيخ/ عبدالله بن عدنان السليمي ، ووكيل وزارة الشؤون البلدية والقروية المساعد لتخطيط المدن المهندس/ أحمد بن عبدالرحمن السليم ومستشار وزير الطاقة والصناعة والثروة المعدنية المشرف على الشؤون القانونية الدكتور محمد بن حمد الفهد ، ومدير عام الإدارة الهندسية في وزارة التجارة والاستثمار المهندس محمد بن عبدالعزيز الوايلي، ومن القطاع الخاص سعادة الأستاذ / حمد بن علي الشويعر رئيس اللجنة الوطنية العقارية في مجلس الغرف السعودية، وسعادة الأستاذ / سعيد بن محمد الغامدي رئيس مجلس إدارة البنك الأهلي التجاري</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه السابع"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه السابع"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d5cb6e38-8b02-3d36-81cd-db1e94f908a6","Alias":"الهيئة العامة للعقار تطرح مشروع نظام التسجيل العيني للعقار في المملكة","Path":"/cb36a6ef-3f7d-451f-b487-4256202fa858.config","Level":4232,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/cb36a6ef-3f7d-451f-b487-4256202fa858.config","Node":{"Content":{"@Key":"cb36a6ef-3f7d-451f-b487-4256202fa858","@Alias":"الهيئة العامة للعقار تطرح مشروع نظام التسجيل العيني للعقار في المملكة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:49","NodeName":{"@Default":"الهيئة العامة للعقار تطرح مشروع نظام التسجيل العيني للعقار في المملكة"},"SortOrder":"232","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:12:37"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"531156ee-6503-4ff8-a498-e3e7f3546c1e\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">دعت الجمهور لتقديم مرئياتهم بخصوص نظام التسجيل العيني الجديد</p>\n<p style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\">الهيئة العامة للعقار تطرح مشروع نظام التسجيل العيني للعقار في المملكة<br /> <br />:2019الرياض، مايو <br />تعلن الهيئة العامة للعقار إطلاقها مشروع نظام التسجيل العيني للعقار ، والذي يهدف إلى تخصيص صحيفة في السجل العقاري لكل وحدة عقارية توصف فيها الوحدة وصفاً دقيقاً من حيث موقعها ومساحتها وطبيعتها وتبين فيها الحقوق التي لها والالتزامات الواردة عليها<br /> <br />وتتطلع الهيئة إلى تحقيق أهداف تطبيق نظام التسجيل العيني للعقار في المملكة ، لحفظ حقوق الملكية العقارية، وسهولة بيع وشراء العقار،  والحد من النزاعات العقارية،  وزيادة الثقة في القطاع العقاري ورفع كفاءته و تعزيز الاستثمار في القطاع  و زيادة مساهمته في الناتج المحلي الإجمالي<br />ومن أهم ملامح المشروع الجديد هو  منح وثائق ملكية العقار الحجية المطلقة غير قابلة للطعن، مع سهولة تسجيل كل التطورات والتعديلات على العقار. <br />وقد دعت الهيئة كافة المستفيدين والمهتمين بالقطاع العقاري في المملكة إلى الاطلاع على مسودة مشروع نظام التسجيل العيني للعقار لتقييمها عبر موقعها الإلكتروني وحساباتها على مواقع التواصل الاجتماعي</p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تطرح مشروع نظام التسجيل العيني للعقار في المملكة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تطرح مشروع نظام التسجيل العيني للعقار في المملكة"}},"relatedNews":{"Value":{"#cdata-section":"umb://document/c104062bfec44b6ba80c4907708fd4dd,umb://document/5871643367394d72a13cce8e1b268920,umb://document/83813bdd3c4d40dabb17708f94841b65"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"75506676-1259-3e07-97fb-7c37286f24cc","Alias":"الهيئة العامة للمنافسة والهيئة العامة للعقار توقعان مذكرة تفاهم لتشجيع المنافسة في القطاع العقاري","Path":"/71b2583f-7c9c-4ef0-89ed-7df376e7e597.config","Level":4233,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/71b2583f-7c9c-4ef0-89ed-7df376e7e597.config","Node":{"Content":{"@Key":"71b2583f-7c9c-4ef0-89ed-7df376e7e597","@Alias":"الهيئة العامة للمنافسة والهيئة العامة للعقار توقعان مذكرة تفاهم لتشجيع المنافسة في القطاع العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:49","NodeName":{"@Default":"الهيئة العامة للمنافسة والهيئة العامة للعقار توقعان مذكرة تفاهم لتشجيع المنافسة في القطاع العقاري"},"SortOrder":"233","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T14:13:53"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9e079b5e-cd66-4f2f-bc3b-5a1070a8a178\",\n    \"mediaKey\": \"68738373-124f-40be-823d-7f8e321f76c5\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">في إطار السعي إلى تعزيز مناخ المنافسة في قطاع الأعمال وحمايتها وتشجيعها ومكافحة الممارسات الاحتكارية المؤثرة على المنافسة المشروعة، وانطلاقاً من رفع مستوى التعاون والشراكة بين الهيئات والأجهزة الحكومية، وقّعت كلٌ من الهيئة العامة للمنافسة والهيئة العامة للعقار مذكرة تفاهم يوم الثلاثاء الموافق 19/7/1440هـ.</span></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><em style=\"box-sizing: border-box;\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; font-style: normal; line-height: 200%;\"> </span></span></em><em style=\"box-sizing: border-box;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; font-style: normal; line-height: 200%;\" lang=\"AR-SA\">وتهدف مذكرة التفاهم إلى زيادة تبادل المعلومات والدراسات بين الجانبين وتعزيز العمل المشترك لحماية المنافسة العادلة وتشجيعها ونشر ثقافتها وتحسين البيئة الاستثمارية في القطاع العقاري ليكون حيوياً وجاذباً ويتميز بالثقة وعدالة الأسعار والتنوع والإبتكار، واتفق الطرفان على إجراء دراسات لاستشراف الممارسات الدولية لتعزيز شفافية السوق ونشر المعلومات والبيانات الدقيقة للقطاع العقاري والحفاظ على حقوق المستهلك والمستثمر في المنتجات العقارية والحد من الممارسات التقييدية والمعلومات المغلوطة من الدعايات وحملات التسويق المضللة.</span></em></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">من جانبه أشاد معالي محافظ الهيئة العامة للمنافسة الدكتور عبدالعزيز بن عبدالله الزوم بهذه الخطوة لتوطيد العلاقة ومد جسور التعاون الفاعل بين الهيئة العامة للمنافسة والهيئة العامة للعقار، لمواكبة التطورات والإصلاحات الكبيرة الجارية في الاقتصاد الوطني للمحافظة على بيئة المنافسة العادلة والشفافة لقطاع الأعمال، بما يمكِّن المنشآت من تحقيق مبادئ المنافسة التي تنتهجها المملكة العربية السعودية لتحقيق رؤيتها الواعدة 2030.</span></span></p>\n<p style=\"box-sizing: border-box; color: #212529; direction: rtl; font-family: Bukra-Regular; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 200%; margin-bottom: 1rem; margin-top: 0in; orphans: 2; text-align: justify; text-decoration: none; text-indent: 0px; text-transform: none; unicode-bidi: embed; -webkit-text-stroke-width: 0px; white-space: normal; widows: 2; word-spacing: 0px;\" dir=\"RTL\"><span style=\"box-sizing: border-box; font-family: Bukra-Light; font-size: 13px;\"><span style=\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; arial&amp;quot;,sans-serif; font-size: 14pt; line-height: 200%;\" lang=\"AR-SA\">وبدوره أكد معالي محافظ الهيئة العامة للعقار الأستاذ عصام بن حمد المبارك على أن مبادرة التعاون بين الهيئتين ستكون منطلق لتعاون أوسع مع جهات حكومية معنية بضمان تحسين بيئة الاستثمار في القطاع العقاري وزيادة الثقة فيه، وتحسين جاذبيته وتوفير منتجات عقارية متميزة بجودتها ونوعيتها وعدالة أسعارها، وأوضح معاليه على أن هذه الشراكة ستعمل على رفع كفاءة القطاع العقاري وتحد من الممارسات الاحتكارية أو أي عوائق للاستثمار فيه.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للمنافسة والهيئة العامة للعقار توقعان مذكرة تفاهم لتشجيع المنافسة في القطاع العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للمنافسة والهيئة العامة للعقار توقعان مذكرة تفاهم لتشجيع المنافسة في القطاع العقاري"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"3d0aa54a-b6b4-3def-ae26-3f42ddfed4e9","Alias":"معالي وزير الإسكان يشكر القيادة على قرار مجلس الوزراء بمنح الهيئة العامة للعقار صلاحية الإشراف على نظام التسجيل العيني للعقار","Path":"/c104062b-fec4-4b6b-a80c-4907708fd4dd.config","Level":4234,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/c104062b-fec4-4b6b-a80c-4907708fd4dd.config","Node":{"Content":{"@Key":"c104062b-fec4-4b6b-a80c-4907708fd4dd","@Alias":"معالي وزير الإسكان يشكر القيادة على قرار مجلس الوزراء بمنح الهيئة العامة للعقار صلاحية الإشراف على نظام التسجيل العيني للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:39:46","NodeName":{"@Default":"معالي وزير الإسكان يشكر القيادة على قرار مجلس الوزراء بمنح الهيئة العامة للعقار صلاحية الإشراف على نظام التسجيل العيني للعقار"},"SortOrder":"234","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2019-09-11T12:15:57"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"bf8a74c2-9ece-4ef3-b9f1-0edd492264ce\",\n    \"mediaKey\": \"86ec4ca3-3058-4c5b-a308-1f9636e7121d\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\">رفع معالي وزير الإسكان رئيس مجلس إدارة الهيئة العامة للعقار، الأستاذ ماجد الحقيل، أسمى آيات الشكر والعرفان لمقام خادم الحرمين الشريفين الملك سلمان بن عبدالعزيز وولي عهده الأمين صاحب السمو الملكي الأمير محمد بن سلمان بن عبدالعزيز -حفظهما الله- على قرار مجلس الوزراء بمنح الهيئة العامة للعقار صلاحية مباشرة الاختصاصات المقررة نظاماً والمعهودة إلى وزارتي العدل والشؤون البلدية والقروية فيما يتعلق بالتسجيل العيني للعقار.</p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\">وأوضح معاليه بأن توحيد الإشراف على تنفيذ تطبيق التسجيل العيني في جهة واحدة من خلال تعديل نظام التسجيل العيني الصادر في عام 1424هـ، سيكون له أثرٌ بالغٌ -بإذن الله- في توحيد الجهود ورفع كفاءة وسرعة إجراءات التسجيل العيني للعقار والإسهام في تحقيق الأهداف المرجوة منه والمتمثلة في زيادة موثوقية ملكية العقار، وتبيان موقعه وطبيعته ووصفه والحقوق الخاصة به، والالتزامات المترتبة عليه.</p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\">وأكد معاليه بأن الهيئة العامة للعقار قد شرعت في إعداد مشروع نظام التسجيل العيني للعقار، وتعتزم عرضه للعموم لطلب مرئياتهم بداية شهر شوال القادم ليتسنى رفعه للمقام السامي الكريم خلال المدة التي حددها قرار مجلس الوزراء.</p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"box-sizing: border-box; color: #63666a; font-family: &amp;quot; 29ltbukra-md&amp;quot;; font-size: 1rem; font-style: normal; font-variant: normal; font-weight: 400; letter-spacing: normal; line-height: 2.5; margin-bottom: 1rem; margin-top: 0px; orphans: 2; text-align: right; text-decoration: none; text-indent: 0px; text-transform: none; -webkit-text-stroke-width: 0px; white-space: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\">تجدر الإشارة إلى أن اختصاصات وزارة العدل في النظام الحالي تمثلت في تحديد المنطقة المستهدفة بالتسجيل العيني وقيد وتوثيق الحقوق المتعلقة بالوحدات العقارية وحفظ أصول الصكوك والأحكام التي يتم القيد بموجبها والسجلات والوثائق الخاصة بالقيد، واختصاصات وزارة الشؤون البلدية والقروية في النظام الحالي في حصر الوحدات العقارية والقيام بالأعمال المساحية وإعداد الخرائط اللازمة وتحديثها وتنفيذ نظم معلومات الأراضي. ومن المقرر أن يتضمن مشروع النظام الجديد تحديثات جوهرية تتعلق بآلية التسجيل والوثائق المطلوبة لذلك وتوحيد الجهة المشرفة على التسجيل العيني، وتسهيل إجراءات تسجيل القيد الأول، وإشراك القطاع الخاص في تقديم خدمات التسجيل العيني للعقار.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"معالي وزير الإسكان يشكر القيادة على قرار مجلس الوزراء بمنح الهيئة العامة للعقار صلاحية الإشراف على نظام التسجيل العيني للعقار"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"معالي وزير الإسكان يشكر القيادة على قرار مجلس الوزراء بمنح الهيئة العامة للعقار صلاحية الإشراف على نظام التسجيل العيني للعقار"}},"relatedNews":{"Value":{"#cdata-section":"umb://document/c104062bfec44b6ba80c4907708fd4dd,umb://document/5871643367394d72a13cce8e1b268920,umb://document/83813bdd3c4d40dabb17708f94841b65"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b7425797-f253-384f-8cf9-a3afab80b237","Alias":"\"الهيئة العامة للعقار\" شريك تشريعي في معرض \"ريستاتكس الرياض العقاري 2024م\"","Path":"/b864bfcf-e762-46e4-a76c-583f0d9e980e.config","Level":4235,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b864bfcf-e762-46e4-a76c-583f0d9e980e.config","Node":{"Content":{"@Key":"b864bfcf-e762-46e4-a76c-583f0d9e980e","@Alias":"\"الهيئة العامة للعقار\" شريك تشريعي في معرض \"ريستاتكس الرياض العقاري 2024م\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-02-18T10:28:14","NodeName":{"@Default":"\"الهيئة العامة للعقار\" شريك تشريعي في معرض \"ريستاتكس الرياض العقاري 2024م\""},"SortOrder":"235","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-02-18T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"6f4f27fa-7d29-4881-a7c6-7d48ff530478\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin-right: .2pt; text-align: justify; mso-line-height-alt: 13.5pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>برعايــــة معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبدالله الحقيل تُشارك الهيئة كشريك تشريعي في معرض \\\"ريستاتكس الرياض العقاري 2024م\\\"، الذي يقام خلال الفترة 18 فبراير إلى 21 فبراير بمركز الرياض الدولي للمعارض والمؤتمرات ،</span> <span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">ويهدف المعرض إلى تسليط الضوء على دور القطاع العقاري في التأثير على الجهود المبذولة لتنويع مصادر الاستثمار كأحد أهم أهداف رؤية المملكة 2030، كما أنّه ينقل التطورات والتطورات في القطاع العقاري السعودي في المشاريع السكنية والتجارية متعددة الاستخدامات&nbsp;واتجاهاتها</span><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; background: white;\\\">.</span></p>\\n<p style=\\\"mso-margin-bottom-alt: auto; text-align: justify; line-height: 21.0pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">وتستعرض الهيئة خلال مشاركتها في معرض \\\" ريستاتكس الرياض العقاري 2024م\\\" منظومة التشريعات العقارية والتي تشمل \\\"نظام الوساطة العقارية\\\"، و\\\"نظام المساهمات العقارية\\\"، إضافةً إلى الأنشطة التي تأتي تحت تنظيم الهيئة وتشمل: (لجنة البيع والتأجير على الخارطة \\\"وافي\\\"، وبرنامج إيجار، وبرنامج فرز الوحدات العقارية، وبرنامج ملاّك، والمعهد العقاري السعودي، والسجل العقاري، ومركز خدمة الشركاء)، وتُشارك الهيئة في اليوم الثاني بجلسة حوارية بعنوان (المساهمات العقارية).</span></p>\\n<p style=\\\"mso-margin-bottom-alt: auto; text-align: justify; line-height: 21.0pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">وتأتي مشاركة الهيئة العامة للعقار في المعارض والمؤتمرات العقارية ضمن دورها في رفع الوعي العقاري والتعريف بالأنشطة والخدمات التي تقدمها .&nbsp; </span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" شريك تشريعي في معرض \"ريستاتكس الرياض العقاري 2024م\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"f7db0155-e9e9-35fe-8cbc-15e53277e1cd","Alias":"الهيئة العامة للعقار تُعلنْ عن استقبال طلبات تسجيل الدفعة الثانية في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية","Path":"/d5fcb3b2-30b8-4fd8-9bdc-334fede0d08b.config","Level":4236,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/d5fcb3b2-30b8-4fd8-9bdc-334fede0d08b.config","Node":{"Content":{"@Key":"d5fcb3b2-30b8-4fd8-9bdc-334fede0d08b","@Alias":"الهيئة العامة للعقار تُعلنْ عن استقبال طلبات تسجيل الدفعة الثانية في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-10T16:59:02","NodeName":{"@Default":"الهيئة العامة للعقار تُعلنْ عن استقبال طلبات تسجيل الدفعة الثانية في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية"},"SortOrder":"236","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-10T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"7d815021-3910-41b6-9f09-8a6ce29c6fdc\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right;\\\">أعلنتْ الهيئةُ العامة للعقار اليوم، عن بدء استقبال المعهد العقاري السعودي طلبات تسجيل الدفعة الثانية في البرنامج التدريبي للحصول على رخصة فال للاستشارات العقارية، ورخصة فال للتحليلات العقارية، حيث يستمر استقبال طلبات الترشيح في البرنامج لمدة خمسة أيام عن طريق الموقع الرسمي للمعهد، ويُعدّ اجتياز البرنامج التدريبي شرطًا لممارسة نشاط الاستشارات أو التحليلات العقارية سواءً للأفراد أو المُنشآت بعد أنْ بدأ نفاذ اللائحة التنظيمية للاستشارات والتحليلات العقارية ونشرها في الجريدة الرسمية.<br>وأوضحتْ الهيئةُ أنَّ كلا النشاطين: الاستشارات والتحليلات العقارية يُعدَّان من الخدمات العقارية التي شملهما نظام الوساطة العقارية والذي بدأ تطبيق العمل به يوليو الماضي من العام الماضي 2023م، حيث شمل النظام تنظيم ممارسة نشاط التوسط في إتمام الصفقات العقارية بين أطرافها، إضافة إلى أنشطة الخدمات العقارية والتي تشمل: التسويق العقاري، وإدارة الأملاك، وإدارة المرافق، والمزادات العقارية، والإعلانات العقارية، والاستشارات والتحليلات العقارية والتي تُمارس حصراً عن طريق مقدمي الخدمات المُرخصين والمؤهلين من المـُنشآت والأفراد.<br>وأكدتْ الهيئة بأنَّ الفرق بين الاستشارات والتحليلات هو: وسيلة تقديمها، حيث عرَّفت اللائحة التنظيمية الاستشارات والتحليلات العقارية بأنها: التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري غير أنَّ الاستشارات العقارية هي التي يتم تقديمها للمستفيد كتابةً ويلزم مقدمها إبرام عقد بينه وبين المستفيد، بينما يتم تقديم التحليلات العقارية منشورةً عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها كأنشطة الاتصال الجماهيري.<br>وحول البرنامج التدريبي الذي يبدأ باستقبال طلبات الترشيح اليوم وينتهي يوم الخميس 14 مارس 2024م، الموافق 4 رمضان 1445هـ ، أوضحت الهيئة بأنَّه قد تم إعداده في المعهد العقاري بالتعاون مع كبرى دور التدريب المحلي والدولي المتخصصة في برامج الاستشارات والتحليلات العقارية، ويُغطي الجوانب القانونية والاتصالية والفنية في مجال تقديم الاستشارات والتحليلات العقارية عبر كفاءات تدريبية عالية المستوى في هذا المجال، ويعقد البرنامج حضوريًا في كلٍ من الرياض وجدة والدمام، على مدى شهر ونصف (ستة أسابيع)، مما يعكس الاهتمام في أهمية المخرجات لضمان دقة الاستشارات والمعلومات التي تقدّم للمستفيدين.<br>ويقدّم البرنامج التدريبي في هذين المسارين حضوريًا في كل من الريا وجدة والدمام كل ربع سنة ابتداءً من يناير الماضي نظرًا لأهمية تطبيق المهارات والعلوم والمعارف في محتوى هذه البرامج لضمان التأهيل اللازم لممارسة النشاط في القطاع العقاري،ويتضمن كل مسار 14 دورة تدريبية، ويشترط للتقدم في طلب الترشيح لمسار الاستشارات العقارية أن يكون المتقدم حاصلًا على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (3) سنوات في ممارسة أي من الأنشطة العقارية أما بالنسبة للتحليلات العقارية فيشترط خبرة لا تقل عن (10) سنوات في ممارسة أي من الأنشطة العقارية.<br>ويُمكن التقديم على البرنامج التدريبي عبر بوابة المعهد العقاري السعودي لتسجيل الرغبات في مسارالاستشارات العقارية https://srei.sa/FormData/RealEstateConsulting/ أو عبر الرابط التالي لتسجيل الرغبات في مسار التحليلات العقارية https://srei.sa/FormData/RealEstateAnalytics/ ومن ثم تقوم الهيئة بدراسة الطلبات والتحقق من الاشتراطات، ويتم إشعار المتقدمين بنتائج الترشيح كمرحلة أولى ثم إشعار المقبولين بأوقات الدورات ومكان انعقادها، وبعد اجتياز البرنامج التدريبي يقوم المعهد بإصدار شهادة الاجتياز، ويكمل المتقدم إجراءات استخراج الرخصة عن طريق المنصة، ليتم بعد ذلك إصدار الرخصة بعد اجتياز البرنامج التدريبي بخمسة أيام عمل.<br>ووفقًا لنظام الوساطة العقارية فإنَّه لا يمكن للأفراد أو المنشآت تقديم خدمات الاستشارات والتحليلات العقارية إلا بعد الحصول على ترخيص من الهيئة العامة للعقار، وبحسب المادة التاسعة عشر من نظام الوساطة العقارية تصل الغرامات المالية على المخالفين إلى (200.000) ريال.<br>يُذكر بأنَّ رخصة فال العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت من ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة وتوعية المستفيدين، كما يرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، ويحد من النزاعات العقارية، ويحفظ حقوق المتعاملين، ويرفع شفافية السوق العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلنْ عن استقبال طلبات تسجيل الدفعة الثانية في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"03675584-95b8-307c-ae63-8bd5ec4dc68d","Alias":"هيئة العقار تُنفّذ 31 جولة رقابية خلال فبراير الماضي لضمان الامتثال في السوق العقاري","Path":"/05515566-9601-49ba-b55a-5c492e799ba4.config","Level":4237,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/05515566-9601-49ba-b55a-5c492e799ba4.config","Node":{"Content":{"@Key":"05515566-9601-49ba-b55a-5c492e799ba4","@Alias":"هيئة العقار تُنفّذ 31 جولة رقابية خلال فبراير الماضي لضمان الامتثال في السوق العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-12T10:52:43","NodeName":{"@Default":"هيئة العقار تُنفّذ 31 جولة رقابية خلال فبراير الماضي لضمان الامتثال في السوق العقاري"},"SortOrder":"237","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-12T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"b272b6e4-bf9d-46bc-926b-6123b0d2dcd5\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\">نفّذت الهيئة العامة للعقار بمشاركة وزارة الداخلية ووزارة الموارد البشرية والتنمية الاجتماعية خلال شهر فبراير الماضي من العام الجاري، 31 جولة رقابية استهدفت زيارة 8354 منشأة عقارية شملتْ: منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة بهدف ضمان الامتثال للتشريعات العقارية بشكل عام وبنظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين وتراخيص المُنشآت</span><span>.</span><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليها بالشراكة مع الجهات المعنية، وفيما يتعلق بمسار البلاغات فإنَّ إجمالي البلاغات التي تلقتها الهيئة 680 بلاغاً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها، كما بلغ عدد الإعلانات العقارية التي تم مسحها للتحقق من امتثالها للنظام عبر المسار الإلكتروني أكثر من 8067 إعلانًا عقاريًا، حيث تنتهج الهيئة الرقابة الإلكترونية التي تستهدف القنوات الرقمية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة العقارية الرقمية</span><span>.</span></span><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغائه أو الغرامات المالية، مؤكدةً أنه يمكن مُضاعفة الغرامة المحكوم بها في حال تكرار المخالفة خلال ثلاث سنوات من ارتكابها، وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها، كما دعت الهيئة المواطنين والمقيمين إلى التواصل معها في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري أو الاستفسارات الأخرى عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم</span><span> ( 199011 ) .</span></span><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">يُذكر أنَّ رخصة فال العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت من ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة وتوعية المستفيدين، كما يرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، ويحد من النزاعات العقارية، ويحفظ حقوق المتعاملين، ويرفع شفافية السوق العقاري</span><span>.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" هيئة العقار تُنفّذ 31 جولة رقابية خلال فبراير الماضي لضمان الامتثال في السوق العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ab48a09c-c245-34bc-ae90-5f1d174a3ed6","Alias":"الهيئة العامة للعقار تشارك في mipim بمدينة كان الفرنسية لنقل تجاربها في التنظيم العقاري","Path":"/38da46ec-7edc-4241-a72d-ea335dd29fcb.config","Level":4238,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/38da46ec-7edc-4241-a72d-ea335dd29fcb.config","Node":{"Content":{"@Key":"38da46ec-7edc-4241-a72d-ea335dd29fcb","@Alias":"الهيئة العامة للعقار تشارك في mipim بمدينة كان الفرنسية لنقل تجاربها في التنظيم العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//mipim","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-12T21:37:35","NodeName":{"@Default":"الهيئة العامة للعقار تشارك في mipim بمدينة كان الفرنسية لنقل تجاربها في التنظيم العقاري"},"SortOrder":"238","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-12T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"653b0306-2c3a-4016-8422-932a59906825\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تُشارك الهيئة العامة للعقار في المعرض العالمي للقطاع العقاري<span> MIPIM </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; background: white;\\\" lang=\\\"AR-SA\\\">بمدينة كان الفرنسية خلال الفترة من 12 إلى 15 من شهر مارس الجاري، حيث تستعرض الهيئة من خلال جناحها التشريعات العقارية وأبرز الممارسات التنظيمية في مجال العقار، وأكد المتحدث الرسمي للهيئة تيسير المفرج بأنَّ مشاركة الهيئة تأتي انطلاقًا من دورها في تسليط الضوء على القطاع العقاري السعودي، ودوره في تحقيق تنويع مصادر الاستثمار كونه أحد أهم أهداف رؤية المملكة 2030، إضافة إلى التعريف بدور الأنظمة العقاري في رفع جاذبية الاستثمار في القطاع العقاري للمملكة العربية السعودية</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif; background: white;\\\" lang=\\\"AR-SA\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; background: white;\\\" lang=\\\"AR-SA\\\">وأضاف المفرج : أنَّ الهيئة العامة للعقار والجهات الحكومية كافة أصبحت اليوم تُصدر تجاربها وممارستها في العمل التنظيمي، وهذا ما نشهده في جميع المشاركات الدولية من اهتمام بما تقدمه المملكة من تشريعات تُمكن القطاعات الاقتصادية من النمو المستمر، كما تأتي مشاركة الهيئة العامة للعقار في المعارض والمؤتمرات العقارية الدولية بشكل عام، ضمن دورها في رفع الوعي وتشجيع الاستثمار في القطاع العقاري السعودي</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif; background: white;\\\" lang=\\\"AR-SA\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; background: white;\\\" lang=\\\"AR-SA\\\">وأوضح \\\" المفرج \\\" أنَّ الهيئة تستعرض خلال مشاركتها في \\\" المعرض العالمي للقطاع العقاري</span><span> MIPIM 2024 “ </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; background: white;\\\" lang=\\\"AR-SA\\\">منظومة التشريعات العقارية التي تشمل \\\"نظام الوساطة العقارية\\\"، و\\\"نظام المساهمات العقارية\\\"، إضافةً إلى الأنشطة التي تأتي تحت تنظيم الهيئة وتشمل: (البيع والتأجير على الخارطة ، وبرنامج إيجار، وبرنامج فرز الوحدات العقارية، وبرنامج ملاّك، والمعهد العقاري السعودي، والسجل العقاري) ، حيث ستتيح لها المشاركة في هذا التجمع الدولي الالتقاء بكبار المسؤولين والتنفيذيين والخبراء الدوليين في مجال صناعة العقار لتعريفهم بهذه الأنظمة، إضافة إلى الفرص العقارية التي تشهدها المملكة وإبراز التنوع الاقتصادي فيها ، كما ستطلّع الهيئة من خلال مشاركتها على أحدث ما تقدمه الدول المشاركة في مجال التقنيات العقارية وأتمتة الإجراءات وتطوير التشريعات العقارية</span><span style=\\\"font-family: 'NeoSansArabic',serif; background: white;\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif; background: white;\\\" lang=\\\"AR-SA\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; background: white;\\\" lang=\\\"AR-SA\\\">ويُقام المعرض الدولي للعقار</span><span> MIPIM </span><span>، الذي انطلقت أعماله منذ عام 1990م سنوياً في مدينة كان بالجمهورية الفرنسية، حيث يُعدّ أحد أهم وأبرز الفعاليات العقارية، على المستوى العالمي، ويجمع قادة صناعة العقار والبناء من جميع أنحاء العالم، ويضم في نسخته هذا العام أكثر من 6500 مستثمر وأكثر من 300 مؤسسة وشركة عالمية في مجال التطوير والتسويق العقاري</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif; background: white;\\\" lang=\\\"AR-SA\\\">&nbsp;</span>من أكثر من 90 دولة<span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تشارك في mipim بمدينة كان الفرنسية لنقل تجاربها في التنظيم العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"11df7382-027c-3cb1-931c-e20b78ee7fe0","Alias":"«وافي» يرخص أكثر من 100 ألف وحدة عقارية للبيع على الخارطة خلال عام 2023م","Path":"/5d3b2117-ab8f-4949-ac08-13809b1b0264.config","Level":4239,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/5d3b2117-ab8f-4949-ac08-13809b1b0264.config","Node":{"Content":{"@Key":"5d3b2117-ab8f-4949-ac08-13809b1b0264","@Alias":"«وافي» يرخص أكثر من 100 ألف وحدة عقارية للبيع على الخارطة خلال عام 2023م","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-12T23:00:56","NodeName":{"@Default":"«وافي» يرخص أكثر من 100 ألف وحدة عقارية للبيع على الخارطة خلال عام 2023م"},"SortOrder":"239","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-06T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9c6effe0-9849-47e9-897c-14b1bc56d515\",\n    \"mediaKey\": \"4a96eb9d-a816-41fa-b484-7da1bf8917e8\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أتاحت لجنة البيع والتأجير على الخارطة «وافي» خلال العام الماضي 2023 في السوق العقاري السعودي 101.942 وحدة عقارية متنوعة للبيع على الخارطة، من خلال 434 رخصة صادرة لمشاريع سكنية وصناعية وتجارية وخدمية وسياحية وغيرها، ويأتي ذلك امتداداً لجهود اللجنة لتعزيز المعروض العقاري وتوفير وحدات عقارية تلبي تطلعات الأسر السعودية وتساهم في رفع نسبة التملك السكني إلى 70 في المائة بحلول عام 2030، وفقاً لمستهدفات برنامج الإسكان – أحد برامج رؤية المملكة 2030 -.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما أوضح الأمين العام للجنة البيع والتأجير على الخارطة أ.نايف بن نواف الشريف أن رخص المشاريع الصغيرة والمتوسطة شهدت نموًا بلغ 63% خلال عام2023 مقارنة بالعام الماضي، حيث تم الترخيص لـــِ 3273 وحدة عقارية جديدة في جميع مدن ومناطق المملكة. وأنّ نسبة نمو المشاريع المنجزة بلغت 650% مقارنة بعام 2022 حيث تم انجاز واكتمال 3640 وحدة سكنية لعدد 42 مشروعًا موزعة على مناطق المملكة.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار \\\" الشريف\\\" إلى ارتفاع نسبة نمو تأهيـل المنشآت العقاريـة لممارسة نشاط البيع على الخارطة وبلغت نسبة نمو المطورين 9% مقارنـة بعـام 2022، وجاءت نسـبة النمـو لتأهيـل المكاتـب الهندسـية 22 % بالإضافـة إلـى 26 % نسـبة نمـو تأهيل مكاتب المحاسبين. حيث أصدر نظام «وافي» 350 رخصة لتأهيل المطورين العقاريين لتنفيذ مشاريع البيع على الخارطة، كما رخصت \\\"وافي\\\" 35 رخصةً لعرض أكثر من 42.180 ألف وحدة عقارية تحت الإنشاء تتوزع في عدد من مشاريع البيع على الخارطة في مدن ومناطق المملكة، بهدف زيادة المعروض العقاري بوحدات ذات جودة وأسعار مناسبة تحقق التوجهات والأهداف وتعزز روح المنافسة بين المطورين.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وبيّن الأمين العام بأنّه بلغ إجمالي الزيارات الرقابية الميدانية 1130 زيارة لعام 2023م، بمعدل نمو تجاوز 28% مقارنة بعدد الزيارات للعام الماضي، فيما بلغت عدد الزيارات الإشرافية 475 زيارة إشرافية هندسية ويأتي ذلك امتداداً لحرص اللجنة على حفظ حقوق المشترين ومتابعة التزام المطورين العقاريين بالمعايير والمواصفات المحددة في العقود المُبرمة بين أطراف المشروع عن طريق الإشراف المباشر على المشاريع المُرخصة ومراجعة تقاريرها الهندسي ومطابقتها بنسب الإنجاز المحققة على أرض الواقع.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما ساهمت لجنة البيع والتأجير على الخارطة «وافي» في تدريب 1167 متدرب من خلال إقامة 68 دورة تدريبة بمختلف مناطق المملكة، وتعمل اللجنة على تحفيز وتأهيل ممارسي نشاط البيع والتأجير على الخارطة لإنشاء مشروعات متميزة ومتكاملة تلبي تطلعات السوق العقاري، وكذلك تعمل على رفع مستوى الشفافية في قطاع البيع والتأجير على الخارطة بالسوق العقاري وتمكين شركات التطوير العقاري للتحول من العمل الفردي إلى المؤسسي وخلق فرص استثمارية واعدة للمنشآت العقارية في نشاط التطوير العقاري.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الجدير بالذكر أنّ نظام بيع وتأجير المشروعات العقارية على الخارطة صدر بشهر يناير الماضي بانتقال أعمال التنظيم والإشراف على مشاريع البيع والتأجير على الخارطة إلى الهيئة العامة للعقار وسيتم طرح اللائحة التنفيذية عبر منصة \\\"الاستطلاع \\\" خلال الفترة القادمة وسيصبح النظام ولائحته نافذين بمنتصف شهر آبريل القادم.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"«وافي» يرخص أكثر من 100 ألف وحدة عقارية للبيع على الخارطة خلال عام 2023م"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"0c50ea48-aa51-3a90-97cc-a5448c8d1df3","Alias":"\" هيئة العقار\" تستعرض ممكنات التقنية العقارية في (ليب (LEAP","Path":"/a7321879-7d84-4b80-b811-968609ce7fc5.config","Level":4240,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a7321879-7d84-4b80-b811-968609ce7fc5.config","Node":{"Content":{"@Key":"a7321879-7d84-4b80-b811-968609ce7fc5","@Alias":"\" هيئة العقار\" تستعرض ممكنات التقنية العقارية في (ليب (LEAP","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//LEAP","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-12T23:02:50","NodeName":{"@Default":"\" هيئة العقار\" تستعرض ممكنات التقنية العقارية في (ليب (LEAP"},"SortOrder":"240","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-04T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"811f593d-7435-47db-bada-255af0099c05\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تُشارك الهيئة العامة للعقار راعياً ماسياً في مؤتمر</span><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">(ليب</span><span> (LEAP </span><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">التقني الدولي بنسخته الثالثة والذي يقام خلال الفترة من 4 إلى 7 مارس الجاري، بمركز الرياض للمعارض والمؤتمرات بملهم؛ بهدف رفع مستوى المعرفة في مجال التقنية العقارية في السوق السعودي، وتعزيز الاستثمار، والتواصل مع الممارسين والمهتمين من ذوي العلاقة بالقطاع.</span></p>\\n<p style=\\\"mso-margin-bottom-alt: auto; text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتستعرض الهيئة في مشاركتها في “ليب </span>LEAP <span>\\\" المنصات التقنية التي تتم من خلالها مختلف التعاملات العقارية مثل منصة إيجار وفرز الوحدات العقارية إضافة إلى منصة الوساطة العقارية كما ستشارك الهيئة في ورش العمل والجلسات المقامة في التجمع التقني في \\\"ليب </span>LEAP <span>\\\" كما تستعرض الهيئة منظومة التشريعات العقارية ومنها \\\"نظام المساهمات العقارية\\\" الذي صدر مؤخراً.</span></p>\\n<p style=\\\"mso-margin-bottom-alt: auto; text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ مؤتمر</span><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">(ليب</span><span> (LEAP </span><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">التقني الدولي يأتي تحت شعار \\\"آفاق جديدة\\\"، وبمشاركة أكثر من 1.8 ألف جهة عارضة من كبرى الشركات التقنية في العالم،&nbsp; ويضم عدداً من المنصات والمسارح، كالمنصة الرئيسة التي تُناقش موضوعات \\\"ويب 3\\\"، واستراتيجيات الشركات التقنية الكبرى والمليارية، وخصوصية المستخدمين في التقنية، كما يحتضن المؤتمر منصة المستثمرين، إضافة إلى عدد من المسارح؛ مثل: التقنيات التعليمية، وتقنيات التجارة بالتجزئة، والتقنيات المالية، والتقنيات الصحية، والثورة الصناعية الرابعة، وطاقة المستقبل،&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://www.alarabiya.net/aswaq/realestate/2023/02/10/-البلدية-والاسكان-السعودية-تطلق-سكني-ميتافيرس-في-مؤتمر-ليب-2023\\\">والمدن الذكية</a></span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\" هيئة العقار\" تستعرض ممكنات التقنية العقارية في (ليب (LEAP "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"aa225e7e-ad55-3b02-b259-71bfdf168b80","Alias":"هيئة العقار تطرح مسودة اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة","Path":"/fead8a33-833f-49b1-9cd0-4007210d68f1.config","Level":4241,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/fead8a33-833f-49b1-9cd0-4007210d68f1.config","Node":{"Content":{"@Key":"fead8a33-833f-49b1-9cd0-4007210d68f1","@Alias":"هيئة العقار تطرح مسودة اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-13T20:08:51","NodeName":{"@Default":"هيئة العقار تطرح مسودة اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة"},"SortOrder":"241","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-13T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"f65e4b19-6817-43bb-b740-08b93db806fa\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; background: white;\\\" lang=\\\"AR-SA\\\">طرحت الهيئة العامة للعقار مسودة اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة، ومسودة ضوابط حساب الضمان وضوابط تأهيل ممارسي النشاط عبر منصة \\\"استطلاع\\\"، بهدف تمكين العموم والجهات الحكومية والقطاع الخاص من إبداء مرئياتهم وملحوظاتهم عليها قبل إقرارها، وفقاً للمادة الثامنة والعشرين من نظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم 196 بتاريخ 04 / 03 / 1445هـ</span> .</p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\"><br><span style=\\\"background: white;\\\">وأوضحت \\\"الهيئة \\\" أنّ مسودة&nbsp; اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة تتضمن 40 مادة، وضوابط حساب الضمان تتضمن 8 مواد وضوابط تأهيل ممارسي النشاط \\\" تتضمن 6 مواد تهدف إلى تنظيم نشاط البيع والتأجير على الخارطة، ورفع مستوى الشفافية والإفصاح بما يضمن حماية حقوق جميع أطراف العلاقة التعاقدية، كما يهدف من خلال تطبيقه إلى حوكمة أعمال الرقابة والامتثال وأتمتة جميع إجراءات إصدار التراخيص الخاصة بها ومراحل سير إنشائها حتى إنهائها ، وذلك امتدادًا لمنظومة التشريعات العقارية التي تُشرف عليها الهيئة وتأتي في إطار مُستهدفات الإستراتيجية الشاملة للقطاع العقاري.</span><br><span style=\\\"background: white;\\\">وأشارت الهيئة إلى أنّ مواد لائحة نظام بيع وتأجير مشروعات عقارية على الخارطة وضوابط حساب الضمان وضوابط تأهيل ممارسي النشاط، توضح آلية تأهيل وتصنيف ممارسي النشاط واشتراطات فتح حساب الضمان باسم المشروع، وأحكام ترخيص وتنفيذ مشاريع البيع أو التأجير على الخارطة، وأحكام تأخر وتعثر تنفيذ المشروعات على الخارطة، بالإضافة إلى الرقابة والتفتيش والضبط، ودعتْ الهيئة المهتمين من العموم والجهات الحكومية والقطاع الخاص كافة إلى الاطلاع على اللائحة في منصة استطلاع من خلال الرابط التالي:</span></span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; background: white;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/RealEstate#https://istitlaa.ncc.gov.sa/ar/Municipality/rega/RealEstate\\\" title=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/RealEstate\\\">https://istitlaa.ncc.gov.sa/ar/Municipality/rega/RealEstate<span>&nbsp;</span></a></span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; background: white;\\\" lang=\\\"AR-SA\\\">كما دعت الهيئة أيضًا إلى الاطلاع على ضوابط تأهيل ممارسي أنشطة البيع أو التأجير على الخارطة عبر منصة استطلاع من خلال الرابط التالي:&nbsp;</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; background: white;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Controls#https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Controls\\\" title=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Controls\\\">https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Controls</a> </span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; background: white;\\\" lang=\\\"AR-SA\\\">وأيضًا الاطلاع على الضوابط المنظمة لحساب الضمان لبيع وتأجير مشروعات عقارية على الخارطة من خلال الرابط التالي: <a href=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/escrow\\\">https://istitlaa.ncc.gov.sa/ar/Municipality/rega/escrow</a><a href=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/escrow#https://istitlaa.ncc.gov.sa/ar/Municipality/rega/escrow\\\" title=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/escrow\\\"> </a>&nbsp;</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وتقديم الملاحظات والمقترحات بشأنها.</p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; background: white;\\\" lang=\\\"AR-SA\\\">وأكدت الهيئة حرصها على أن يسهم النظام و\\\"اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة، وضوابط حساب الضمان وضوابط تأهيل ممارسي النشاط في الحد من المخالفات في قطاع التطوير العقاري بنظام البيع والتأجير على الخارطة ، وزيادة المعروض من المنتجات العقارية التجارية والسكنية والصناعية والسياحية وغيرها، وسيكون له دور في زيادة قنوات التمويل للمطورين العقاريين والقنوات الاستثمارية للراغبين في الاستثمار، كما سيسهم في تعزيز ثقة المستثمرين في القطاع العقاري في المملكة من خلال ما تضمنَه من قواعد وأحكام تحفظ الحقوق لجميع الأطراف.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار تطرح مسودة اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"bd459908-f696-3c7c-942f-30ee02db3af7","Alias":"الهيئة العامة للعقار تُعلن عن خمسة أحياء مستفيدة من السجل العقاري في مدينة الرياض ابتداءً من 21 رمضان الحالي","Path":"/d730977d-f8fb-42a4-9df1-4917383736a1.config","Level":4242,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/d730977d-f8fb-42a4-9df1-4917383736a1.config","Node":{"Content":{"@Key":"d730977d-f8fb-42a4-9df1-4917383736a1","@Alias":"الهيئة العامة للعقار تُعلن عن خمسة أحياء مستفيدة من السجل العقاري في مدينة الرياض ابتداءً من 21 رمضان الحالي","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-15T16:05:53","NodeName":{"@Default":"الهيئة العامة للعقار تُعلن عن خمسة أحياء مستفيدة من السجل العقاري في مدينة الرياض ابتداءً من 21 رمضان الحالي"},"SortOrder":"242","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-15T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ba6cae85-36a6-4102-ba00-416ba32f143c\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار&nbsp;عن&nbsp;خمسة أحياء&nbsp;بمدينة الرياض ضمن المرحلة الرابعة&nbsp;من مراحل&nbsp;السجل&nbsp;العقاري&nbsp;، وتضم&nbsp;25،700&nbsp;قطعة عقارية بإجمالي مساحة تصل إلى&nbsp;58.14 كلم مربع &nbsp;، وذلك ابتداءً من&nbsp;الواحد والثلاثين&nbsp;من&nbsp;شهر مارس الحالي&nbsp;2024م،&nbsp;الموافق&nbsp;21&nbsp;رمضان&nbsp;1445هـ ، ويستمر التسجيل حتى نهاية اليوم&nbsp;الرابع من شهر يوليو2024م الموافق&nbsp;28&nbsp;ذو الحجة&nbsp;1445هـ&nbsp;،&nbsp;وتشمل:&nbsp;حيالهدا،&nbsp;جزء من&nbsp;حي&nbsp;سدرة،&nbsp;جزء من&nbsp;حي الشعلة،&nbsp;جزء من&nbsp;حي الفرسان&nbsp;والنخبة&nbsp;في مدينة الرياض&nbsp;حيثُ أكدت&nbsp;الهيئة بأنَّ&nbsp;اختيار الأحياء جاء وفقًا لمعايير معتمدة، وسيتم الإعلان تباعًا عن بقية&nbsp;المناطق&nbsp;والأحياء&nbsp;التي ستستفيد من&nbsp;السجل العقاري حسب الجاهزية.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; line-height: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحاً عن طريق <a href=\\\"https://rer.sa/rer-services-ar/#https://rer.sa/rer-services-ar/\\\" title=\\\"https://rer.sa/rer-services-ar/\\\" data-anchor=\\\"#https://rer.sa/rer-services-ar/\\\">منصة السجل العقاري الإلكترونية</a></span><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;أو من خلال مراكز الخدمة، مبيَّنة أنّ التسجيل العيني&nbsp;يشترط وجود صك إلكتروني مُحدَّث صادر عن وزارة العدل مكتمل البيانات مستوفي شروط الملكية.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; line-height: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة ملاَّك عقارات المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن الإجراءات والخطوات اللازمة عن طريق الاتصال على مركز خدمة العملاء 199002.</span>&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; line-height: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">مما يُذكر&nbsp;أنّ&nbsp;الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري)&nbsp;تقوم&nbsp;بأعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات والبيانات الجيومكانية&nbsp;والتقنيات الحديثة&nbsp;عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة في خدمات وبيانات العقارات.&nbsp;وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقاريةيتم تسجيلها.&nbsp;وسيتضمن صك تسجيل الملكية الجديد بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه مرتبطة بالمعلومات الجيومكانية من خلال الرفع المساحي والإحداثيات الجغرافية للعقارات، ليكون أساس تسجيل الملكية والحقوق العقارية المترتبة عليها بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة</span> له.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلن عن خمسة أحياء مستفيدة من السجل العقاري في مدينة الرياض ابتداءً من 21 رمضان الحالي "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"dc8c9aaf-621c-3abc-ade6-c888610be472","Alias":"\"هيئة العقار\" تُعلن عن 8 أحياء مستفيدة من السجل العقاري في مدينة مكة المكرمة ابتداءً من الـ18 من ذي القعدة","Path":"/3842f7a2-4d4f-46e7-a6c3-e858ed987ad5.config","Level":4243,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3842f7a2-4d4f-46e7-a6c3-e858ed987ad5.config","Node":{"Content":{"@Key":"3842f7a2-4d4f-46e7-a6c3-e858ed987ad5","@Alias":"\"هيئة العقار\" تُعلن عن 8 أحياء مستفيدة من السجل العقاري في مدينة مكة المكرمة ابتداءً من الـ18 من ذي القعدة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-22T19:28:27","NodeName":{"@Default":"\"هيئة العقار\" تُعلن عن 8 أحياء مستفيدة من السجل العقاري في مدينة مكة المكرمة ابتداءً من الـ18 من ذي القعدة"},"SortOrder":"243","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-22T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"6352bdc5-4130-4090-88c9-730e520ba7a1\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right;\\\">أعلنت الهيئة العامة للعقار عن 8 أحياء في مدينة \\\"مكة المكرمة\\\" ضمن المرحلة الخامسة من مراحل السجل العقاري، تضم 1336 قطعة عقارية، وذلك ابتداءً من 18 من ذي القعدة 1445هـ الموافق 26 مايو 2024م، ويستمر التسجيل حتى نهاية يوم 25 صفر 1446هـ الموافق 29 أغسطس 2024م.<br>وتتضمن الأحياء المعلن عنها كلاً من: جزء من حي الصفوة، وجزء من حي دار السلام، وجزء من حي الهجرة، ومشروع ذاخر ويشمل حي الجميزة وحي ريع ذاخر، ومشروع مسار مكة القسم الأول ويشمل حي النزهة، وحي الرصيفة، ومشروع جبل عمر، ويشمل حي جرهم الشمالي، حيثُ أكّدت الهيئة أنَّ اختيار الأحياء جاء وفقًا لمعايير مُعتمدة، فيما سيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري حسب الجاهزية.<br>وأوضحت \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية https://rer.sa/rer-services-ar/، أو من خلال مراكز الخدمة، مبيَّنة أنّ التسجيل العيني يشترط وجود صك إلكتروني مُحدَّث صادر عن وزارة العدل مكتمل البيانات مستوفٍ لشروط الملكية.<br>ودعت الهيئة ملاَّك عقارات المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن الإجراءات والخطوات اللازمة عن طريق الاتصال على مركز خدمة العملاء 199002.<br>يذكر أنّ الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تقوم بأعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات والبيانات الجيومكانية والتقنيات الحديثة عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة في خدمات وبيانات العقارات.<br>وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها.<br>وسيتضمن صك تسجيل الملكية الجديد بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه مرتبطة بالمعلومات الجيومكانية، من خلال الرفع المساحي والإحداثيات الجغرافية للعقارات، ليكون أساس تسجيل الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة له.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تُعلن عن 8 أحياء مستفيدة من السجل العقاري في مدينة مكة المكرمة ابتداءً من الـ18 من ذي القعدة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"227df2b0-522d-3147-b032-089e4725b067","Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ26","Path":"/08fd0d36-6a6b-49cf-821a-3a12f6094c92.config","Level":4244,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/08fd0d36-6a6b-49cf-821a-3a12f6094c92.config","Node":{"Content":{"@Key":"08fd0d36-6a6b-49cf-821a-3a12f6094c92","@Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ26","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-25T18:03:51","NodeName":{"@Default":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ26"},"SortOrder":"244","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-24T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"82258ee0-32f5-4f30-b8d9-07e3508db456\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span lang=\\\"AR-SA\\\">عقد مجلس إدارة الهيئة العامة للعقار اجتماعه السادس والعشرون برئاسة معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة الأستاذ ماجد بن عبدالله الحقيل، بحضور الرئيس التنفيذي للهيئة المهندس عبدالله الحماد، وأعضاء المجلس ممثلي الجهات الحكومية، وممثلي القطاع الخاص</span><span>.<br></span><span lang=\\\"AR-SA\\\">واطلّع المجلس في مستهل اجتماعه على القرارات والتوجيهات الصادرة منه، كما استعرض تقارير لجان المجلس المنبثقة منه والتابعة له، واطلّع على الخطط الإستراتيجية للهيئة وسير عمل منظومة التشريعات العقارية والتسجيل العيني للعقار وما يتعلق بالتراخيص والرقابة وخدمات المستفيدين والأنشطة العقارية، وتفعيل نظام المساهمات العقارية، كما استعرض المجلس رحلة تأسيس نشاط البيع والتأجير على الخارطة</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ26"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a2ceaaf5-1f89-3e64-9838-67305acb62ee","Alias":"الهيئة العامة للعقار تدعو ملاك العقارات في خمسة أحياء بمدينة الرياض لتسجيل عقاراتهم في \" السجل العقاري\" ابتداءً من اليوم","Path":"/e500d4c8-ed33-4068-a2b4-d78637d9eb95.config","Level":4245,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e500d4c8-ed33-4068-a2b4-d78637d9eb95.config","Node":{"Content":{"@Key":"e500d4c8-ed33-4068-a2b4-d78637d9eb95","@Alias":"الهيئة العامة للعقار تدعو ملاك العقارات في خمسة أحياء بمدينة الرياض لتسجيل عقاراتهم في \" السجل العقاري\" ابتداءً من اليوم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-03-31T18:27:00","NodeName":{"@Default":"الهيئة العامة للعقار تدعو ملاك العقارات في خمسة أحياء بمدينة الرياض لتسجيل عقاراتهم في \" السجل العقاري\" ابتداءً من اليوم"},"SortOrder":"245","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-03-31T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1d1f4f78-636d-4841-9559-68174b92e26b\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; margin-right: 36.0pt; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار اليوم الأحد 21 رمضان 1445ه، الموافق 31 مارس 2024م، عن بدء التسجيل لخمسة أحياء مستفيدة بمدينة الرياض ضمن المرحلة الرابعة من مراحل السجل العقاري، وهي: حي الهدا، جزء من حي سدرة، جزء من حي الشعلة، جزء من حي الفرسان وحي النخبة، حيث يستمر التسجيل فيها حتى نهاية تاريخ 4 من شهر يوليو 2024م، الموافق 28 ذو الحجة 1445هـ.. وبينت الهيئة أنّ القطع العقارية في هذه الأحياء تبلغ 25،700 قطعة عقارية بإجمالي مساحة تصل إلى 58.14 كلم مربع، موضحةً بأنَّ التسجيل الأول للعقارات في هذه الأحياء مُتاحاً عن طريق <a href=\\\"https://rer.sa/rer-services-ar/#https://rer.sa/rer-services-ar/\\\" title=\\\"https://rer.sa/rer-services-ar/\\\"><span style=\\\"color: blue;\\\">منصة السجل العقاري الإلكترونية</span></a> أو من خلال مراكز الخدمة.&nbsp;</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; margin-right: 36.0pt; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة ملاَّك عقارات المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة (صك إلكتروني مُحدَّث صادر عن وزارة العدل مكتمل البيانات مستوفي شروط الملكية) ويمكن الاستفسار عن الإجراءات والخطوات اللازمة عن طريق الاتصال على مركز خدمة العملاء 199002.</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; margin-right: 36.0pt; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">مما يُذكر أنّ الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تقوم بأعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات والبيانات الجيومكانية والتقنيات الحديثة عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة في خدمات وبيانات العقارات. وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها. وسيتضمن صك تسجيل الملكية الجديد بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه مرتبطة بالمعلومات الجيومكانية من خلال الرفع المساحي والإحداثيات الجغرافية للعقارات، ليكون أساس تسجيل الملكية والحقوق العقارية المترتبة عليها بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة له</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\">.&nbsp;</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تدعو ملاك العقارات في خمسة أحياء بمدينة الرياض لتسجيل عقاراتهم في \" السجل العقاري\" ابتداءً من اليوم "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"03480542-9c75-38d9-8e40-4d4c04f23580","Alias":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م","Path":"/b9c92f83-edce-4e00-a2d1-ca8eb7698e2e.config","Level":4246,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b9c92f83-edce-4e00-a2d1-ca8eb7698e2e.config","Node":{"Content":{"@Key":"b9c92f83-edce-4e00-a2d1-ca8eb7698e2e","@Alias":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-04-21T13:52:49","NodeName":{"@Default":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م"},"SortOrder":"246","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-04-21T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c99debc5-d364-4305-ac2f-e23058283d82\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن إصدار ما يزيد عن 11 ألف رخصة فال عقارية خلال الربع الأول لعام 2024م عبر المنصة الإلكترونية للهيئة؛ ليصل إجمالي الرخص النشطة التي أصدرتها الهيئة منذ بدء تطبيق نظام الوساطة العقارية إلى أكثر من 46 ألف رخصة، منها 64% للأفراد، و36% للمنشآت</span><span>.</span><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأوضحت \\\"هيئة العقار\\\" أنّ \\\"رخصة فال العقارية\\\" تتضمن حزمة من التراخيص، وهي خمس رخص للممارسين من الأفراد والمنشآت، ورخصة سادسة للإعلان العقاري، وتُعد رخصة فال وثيقة رسمية تخوّل الأفراد والمنشآت ممارسة النشاط العقاري المحدّد في الرخصة؛ حيث تخوّل رخصة فال للوساطة والتسويق العقاري الأفراد والمنشآت ممارسة أنشطة التوسّط في إتمام صفقة عقارية بين طرفيها مقابل عمولة، والتسويق للعقار سواء عن طريق الوسائل الإعلانية أو التسويق المباشر في المكاتب والمعارض وغيرها، أما رخصة فال لإدارة الأملاك فهي رخصة خاصة بالمُنشآت تخوّل المنشأة تولّي إدارة الشؤون المالية والإدارية للعقار نيابةً عن الغير، وكذلك رخصة فال لإدارة المرافق فهي رخصة خاصة بالمُنشآت تخوّل المنشأة تولي إدارة الشؤون الفنية للعقار نيابةً عن الغير، إضافة إلى أنَّ رخصة فال لإدارة وتنظيم المزادات تختص بالمُنشآت، وهي رخصة تخوّل المنشأة تولّي مهام عرض العقارات لبيعها بالمزادات العلنية وتشمل المزادات العقارية الإلكترونية، أما رخصة فال للاستشارات ورخصة فال للتحليل العقاري فهما رخص تخوّل المُنشآت والأفراد من تقديم التحليلات والاستشارات العقارية والرأي المتصل بالقطاع العقاري للعموم عبر أي وسيلة إعلامية أو لجهة مستفيدة من الخدمة</span><span>.</span></span><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وطورت الهيئة منصة الوساطة العقارية وأضافت العديد من التحسينات، والتي من شأنها المساهمة في سهولة الإجراءات وسرعتها، وتحسين تجربة العميل، وحفظ حقوق المستفيدين من القطاع العقاري، حيث أتاحت لجميع المستفيدين تجديد الرخصة قبل انتهائها بـ 120 يومًا، مما يسهم في استمرارهم في ممارسة نشاطاتهم العقارية قبل انتهاء الرخصة</span><span style=\\\"font-family: 'NeoSansArabic',serif; background: white;\\\">.</span></span><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">يُذكر أنّ الهيئة العامة للعقار تُنفّذ زيارات ميدانية توعوية بالإضافة لحملات ميدانية رقابية مشتركة على المنشآت العقارية مع الجهات ذات العلاقة، إضافةً إلى مسار الرقابة الإلكترونية الذي يستهدف القنوات الإلكترونية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة الرقمية</span><span>.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" \"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"95f3dd68-83bc-380c-b4a2-57d85a58432a","Alias":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م (1)","Path":"/e625dbf5-7026-4ef0-bdb5-2d3c0ef11028.config","Level":4247,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e625dbf5-7026-4ef0-bdb5-2d3c0ef11028.config","Node":{"Content":{"@Key":"e625dbf5-7026-4ef0-bdb5-2d3c0ef11028","@Alias":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م (1)","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-04-21T13:53:02","NodeName":{"@Default":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م (1)"},"SortOrder":"247","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-04-21T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c99debc5-d364-4305-ac2f-e23058283d82\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن إصدار ما يزيد عن 11 ألف رخصة فال عقارية خلال الربع الأول لعام 2024م عبر المنصة الإلكترونية للهيئة؛ ليصل إجمالي الرخص النشطة التي أصدرتها الهيئة منذ بدء تطبيق نظام الوساطة العقارية إلى أكثر من 46 ألف رخصة، منها 64% للأفراد، و36% للمنشآت</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأوضحت \\\"هيئة العقار\\\" أنّ \\\"رخصة فال العقارية\\\" تتضمن حزمة من التراخيص، وهي خمس رخص للممارسين من الأفراد والمنشآت، ورخصة سادسة للإعلان العقاري، وتُعد رخصة فال وثيقة رسمية تخوّل الأفراد والمنشآت ممارسة النشاط العقاري المحدّد في الرخصة؛ حيث تخوّل رخصة فال للوساطة والتسويق العقاري الأفراد والمنشآت ممارسة أنشطة التوسّط في إتمام صفقة عقارية بين طرفيها مقابل عمولة، والتسويق للعقار سواء عن طريق الوسائل الإعلانية أو التسويق المباشر في المكاتب والمعارض وغيرها، أما رخصة فال لإدارة الأملاك فهي رخصة خاصة بالمُنشآت تخوّل المنشأة تولّي إدارة الشؤون المالية والإدارية للعقار نيابةً عن الغير، وكذلك رخصة فال لإدارة المرافق فهي رخصة خاصة بالمُنشآت تخوّل المنشأة تولي إدارة الشؤون الفنية للعقار نيابةً عن الغير، إضافة إلى أنَّ رخصة فال لإدارة وتنظيم المزادات تختص بالمُنشآت، وهي رخصة تخوّل المنشأة تولّي مهام عرض العقارات لبيعها بالمزادات العلنية وتشمل المزادات العقارية الإلكترونية، أما رخصة فال للاستشارات ورخصة فال للتحليل العقاري فهما رخص تخوّل المُنشآت والأفراد من تقديم التحليلات والاستشارات العقارية والرأي المتصل بالقطاع العقاري للعموم عبر أي وسيلة إعلامية أو لجهة مستفيدة من الخدمة</span><span>.</span></span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وطورت الهيئة منصة الوساطة العقارية وأضافت العديد من التحسينات، والتي من شأنها المساهمة في سهولة الإجراءات وسرعتها، وتحسين تجربة العميل، وحفظ حقوق المستفيدين من القطاع العقاري، حيث أتاحت لجميع المستفيدين تجديد الرخصة قبل انتهائها بـ 120 يومًا، مما يسهم في استمرارهم في ممارسة نشاطاتهم العقارية قبل انتهاء الرخصة</span><span style=\\\"font-family: 'NeoSansArabic',serif; background: white;\\\">.</span></span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">يُذكر أنّ الهيئة العامة للعقار تُنفّذ زيارات ميدانية توعوية بالإضافة لحملات ميدانية رقابية مشتركة على المنشآت العقارية مع الجهات ذات العلاقة، إضافةً إلى مسار الرقابة الإلكترونية الذي يستهدف القنوات الإلكترونية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة الرقمية</span><span>.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" \"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e7032a5e-dee6-3d9f-803a-a1f1144c9d1e","Alias":"الهيئة العامة للعقار تُعلن بدء التسجيل في عشرة أحياء مستفيدة من السجل العقاري في مدينة الرياض","Path":"/a843a5e9-f0c0-467d-9c11-fda68b695fe0.config","Level":4248,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a843a5e9-f0c0-467d-9c11-fda68b695fe0.config","Node":{"Content":{"@Key":"a843a5e9-f0c0-467d-9c11-fda68b695fe0","@Alias":"الهيئة العامة للعقار تُعلن بدء التسجيل في عشرة أحياء مستفيدة من السجل العقاري في مدينة الرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-04-26T15:30:36","NodeName":{"@Default":"الهيئة العامة للعقار تُعلن بدء التسجيل في عشرة أحياء مستفيدة من السجل العقاري في مدينة الرياض"},"SortOrder":"248","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-04-26T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"3318eb9e-aad2-4b73-a837-780c42fb3ba8\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار بدء التسجيل في عشرة أحياء مستفيدة بمدينة الرياض، وذلك ابتداءً من 26 مايو 2024م، الموافق 18 ذو القعدة 1445هـ، ويستمر التسجيل فيها حتى نهاية يوم 29 أغسطس 2024م الموافق 25 صفر 1446هـ</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وبينت الهيئة أنّ الأحياء المستفيدة هي: (حي المهدية، حي الخزامى، حي عرقة، حي ظهرة لبن، حي السفارات، حي نمار، حي المروة، حي شبرا، حي بدر، حي الشفاء) في مدينة الرياض بإجمالي مساحة تصل إلى 172.24 كلم مربع، حيثُ أكدت الهيئة بأنَّ اختيار الأحياء تتم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري</span><span>.</span></span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحاً عن طريق<a href=\\\"https://rer.sa/rer-services-ar/#https://rer.sa/rer-services-ar/\\\" title=\\\"https://rer.sa/rer-services-ar/\\\" data-anchor=\\\"#https://rer.sa/rer-services-ar/\\\"> منصة السجل العقاري الإلكترونية </a></span></span><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\">أو عن طريق مراكز الخدمة، مبيَّنة أنّ التسجيل العيني يشترط وجود صك ملكية مستوف للمتطلبات النظامية لإتمام عملية التسجيل</span><span>.</span></span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وتدعو الهيئة ملاَّك العقارات في المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002. وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري</span><span>.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلن بدء التسجيل في عشرة أحياء مستفيدة من السجل العقاري في مدينة الرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"33fbb184-c68e-3a23-afd0-373cfc109790","Alias":"\"هيئة العقار\" تعلن بدء استقبال طلبات ترخيص المشاريع على الخارطة بالتزامن مع نشر اللائحة التنفيذية للنظام بعد اعتمادها","Path":"/71cb4b1f-aaee-4b19-9212-c768f8596557.config","Level":4249,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/71cb4b1f-aaee-4b19-9212-c768f8596557.config","Node":{"Content":{"@Key":"71cb4b1f-aaee-4b19-9212-c768f8596557","@Alias":"\"هيئة العقار\" تعلن بدء استقبال طلبات ترخيص المشاريع على الخارطة بالتزامن مع نشر اللائحة التنفيذية للنظام بعد اعتمادها","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-05-07T12:47:03","NodeName":{"@Default":"\"هيئة العقار\" تعلن بدء استقبال طلبات ترخيص المشاريع على الخارطة بالتزامن مع نشر اللائحة التنفيذية للنظام بعد اعتمادها"},"SortOrder":"249","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-05-07T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"e2c4f844-b6bf-428f-a148-86691675a288\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار اليوم، عن بدء استقبال طلبات ترخيص المشاريع على الخارطة من خلال المنصة الإلكترونية للهيئة، وذلك وفقًا لنظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم 196 بتاريخ 1445 / 03 / 04 هـ ولائحته التنفيذية المعتمدة والمنشورة على موقع الهيئة</span><span>.</span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأبانت الهيئة أنَّ الترخيص لممارسة أعمال البيع والتأجير على الخارطة يُسهم في تنظيم النشاط والحد من المخالفات في قطاع التطوير العقاري على الخارطة، وزيادة المعروض من المنتجات العقارية التجارية والسكنية والصناعية والسياحية وغيرها</span><span>.</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأضافت أن النظام يُعد أحد قنوات التمويل للمطورين العقاريين، ومُمكنًا رئيسيًا للسوق العقاري ويرفع من موثوقية القطاع من خلال الحوكمة التي تضمنها النظام، داعيةً جميع المطورين العقارين الراغبين في الاستفادة من النظام إلى التقدم بطلب التأهيل - في حال لم يكن مؤهلًا سابقًا - واستخراج التراخيص اللازمة لممارسة النشاط من خلال المنصة الإلكترونية التي تم تخصيصها لاستقبال طلبات التأهيل والترخيص للمشاريع على الخارطة بمختلف أنواعها وأشكالها</span><span>.</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">ووفقًا لمتطلبات الترخيص، فإنَّه يجب على مُقدم الطلب اجتياز برنامج التأهيل الذي أقرته الهيئة وتقديم دراسة جدوى المشروع مشتملة على البيانات المالية، والإنشائية، والتسويقية المقدرة للمشروع، والمصاريف المالية والإدارية المتوقعة، ومدة تسليم الوحدات ومصادر التمويل المتوقعة وتقديم ما يفيد بمطابقة المشروع العقاري للمتطلبات النظامية لرخص البناء، والمخططات الهندسية، والتصاميم المعمارية</span><span>.</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأوضحت الهيئة أنَّ اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة احتوت على 49 مادة رئيسية موزعة على 5 فصول، تشمل التعريفات والأحكام العامة للنظام، حيث جاء الفصل الأول مخصصاً لـ \\\" سجل قيد المطورين \\\" واشتمل على شروط قيد الأشخاص الحقيقيين والاعتباريين، ومعايير تقييمهم للقيد في سجل المطورين وشروط اعتماد المكاتب الاستشارية للمشروعات العقارية</span><span>.</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">واشتمل الفصل الثاني على المواد الخاصة بـ \\\" ترخيص وتنفيذ مشروعات البيع والتأجير على الخارطة \\\"، حيث تضمنت آليات البيع والتأجير على الخارطة، والاشتراطات اللازمة لترخيص المشروع العقاري والأحكام المتعلقة بنماذج الاتفاقيات بين الأطراف ذات العلاقة، بالإضافة إلى آلية الصرف من حساب الضمان</span><span>.</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وجاء الفصل الثالث متضمنّاً الأحكام المترتبة على \\\"التأخر والتعثر في تنفيذ مشروعات البيع والتأجير على الخارطة \\\" حيث عيّنت اللائحة المدة الإضافية الممنوحة لإنجاز المشروعات عند التأخر، ونصّت على الآثار المترتبة عند التعثر في المشروعات، كما تضمنّت الطرق والأساليب والإجراءات الواجب اتباعها لمعالجة التأخر والتعثر</span><span>.</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وشمل الفصل الرابع من اللائحة أحكام \\\"الإشراف والتفتيش والضبط\\\" حيث ذكرت اختصاصات القطاع الخاص في الإشراف الفني على المشروعات العقارية والأدوار والمسؤوليات المسندة إلى مسؤولي الضبط والرقابة والتفتيش، وأحكام المخالفات في تنفيذ مشروعات البيع والتأجير على الخارجة، وختمت اللائحة بالفصل الخامس، وهو مخصص لـ \\\"أحكام ختامية\\\" عن آليات الإبلاغ عن المخالفات ووسائلها، ويمكن الاطلاع على اللائحة التنفيذية</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">عبر موقع الهيئة الرسمي</span><span> https://rega.gov.sa/ .</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">يُذكر أنَّ الهيئة العامة للعقار تعمل من خلال منظومة التشريعات العقارية للإسهام بشكل فاعل في تطوير البيئة التشريعية والتنظيمية للقطاع العقاري، وتعزيز شفافيته وموثوقيته بما يواكب الحراك الاقتصادي والاستثماري في المملكة وتعزيز دوره ورفع مساهمته في الاقتصاد الوطني</span><span>.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تعلن بدء استقبال طلبات ترخيص المشاريع على الخارطة بالتزامن مع نشر اللائحة التنفيذية للنظام بعد اعتمادها"}},"pageName":{"Value":{"#cdata-section":"\"هيئة العقار\" تعلن بدء استقبال طلبات ترخيص المشاريع على الخارطة بالتزامن مع نشر اللائحة التنفيذية للنظام بعد اعتمادها"}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5aeb7cfa-1f52-34b9-ae7f-fb91dd080056","Alias":"\" هيئة العقار\":   أكثر من 20 ألف زيارة خلال الربع الأول لعام 2024م لضمان الامتثال بالأنظمة في التعاملات العقارية","Path":"/21f96464-ad74-4632-bcd2-b7b7e3b19ef4.config","Level":4250,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/21f96464-ad74-4632-bcd2-b7b7e3b19ef4.config","Node":{"Content":{"@Key":"21f96464-ad74-4632-bcd2-b7b7e3b19ef4","@Alias":"\" هيئة العقار\":   أكثر من 20 ألف زيارة خلال الربع الأول لعام 2024م لضمان الامتثال بالأنظمة في التعاملات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-05-12T09:28:06","NodeName":{"@Default":"\" هيئة العقار\":   أكثر من 20 ألف زيارة خلال الربع الأول لعام 2024م لضمان الامتثال بالأنظمة في التعاملات العقارية"},"SortOrder":"250","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-05-10T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"23da564a-b879-4163-ae4f-83ec1a174204\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">نفذت الهيئة العامة للعقار خلال الربع الاول من العام الجاري 21,312 زيارة توعوية للمنشآت العقارية في جميع مناطق المملكة بالإضافة إلى تنفيذ 15حملة ميدانية مشتركة بمشاركة وزارة الداخلية ووزارة الموارد البشرية والتنمية الاجتماعية شملتْ: منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة بهدف ضمان الامتثال للتشريعات والأنظمة العقارية بشكل عام وبنظام الوساطة العقارية على وجه الخصوص والتعاملات العقارية من خلال مكاتب العقار، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين وتراخيص المُنشآت ونظامية العاملين بها، فيما بلغت عدد العمليات الرقابية الإلكترونية التي تمت للتحقق من الامتثال للأنظمة واللوائح عبر مسار المسح الإلكتروني أكثر من 19,246 عملية.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتلقت الهيئة خلال الفترة&nbsp;ذاتها 3,404&nbsp;بلاغاً عبر قنواتها المختلفة تم التعامل معها&nbsp;ومعالجتها، فيما بلغت عدد المخالفات&nbsp;251&nbsp;مخالفة تم اتخاذ الإجراءات النظامية بحقها، حيث&nbsp;أكدتْ الهيئة بأن أعمال الرقابة والامتثال تجري&nbsp;وفق أربعة مسارات&nbsp;رئيسة:&nbsp;فرق الرقابة الخاصة بالهيئة، وحملات الرقابة المشتركة مع الجهات الحكومية ذات العلاقة، إضافةً إلى مسار الرقابة&nbsp;الإلكترونية،&nbsp;ومسار الاستجابة&nbsp;للبلاغات المقدمة في منصة الهيئة.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة كافة الوسطاء ومقدمي الخدمات العقارية بالامتثال لقواعد النظام وعدم مخالفته، وعدم القيام بأي فعل أو الامتناع عن أي فعل، يكون من شأنه الإضرار بمصالح المتعاملين معه، أو يتعارض مع أحكام النظام، وإبلاغ الهيئة عن أي تعديل أو تغيير متعلق بممارسة نشاط الوساطة العقارية، وتسجيل جميع عقود الوساطة التي يبرمها، وجميع الصفقات العقارية التي يتمها في المنصة الإلكترونية، وتمكين فرق الرقابة والامتثال من أداء أعمالهم وتسهيل مهماتهم، ويشمل ذلك دخول مقر عمله، وتزويدهم بالمستندات والرخص والوثائق ذات العلاقة ، والاطلاع على المخالفات الموُجبة للغرامات المالية أو الإجراءات الإدارية من خلال&nbsp;<a href=\\\"/#https://rega.gov.sa/\\\" title=\\\"https://rega.gov.sa/\\\" data-anchor=\\\"#https://rega.gov.sa/\\\">الموقع الرسمي للهيئة</a> ،</span><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;كما دعت الهيئة المواطنين والمقيمين إلى التواصل معها في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري أو الاستفسارات الأخرى من خلال منصة الهيئة الرسمية أو الاتصال على الرقم ( 199011 ) .</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\" هيئة العقار\":   أكثر من 20 ألف زيارة خلال الربع الأول لعام 2024م لضمان الامتثال بالأنظمة في التعاملات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"0f5d907e-62e2-3eca-8b72-bd06df2ae10f","Alias":"الهيئة العامة للعقار شريك تشريعي في معرض سيريدو العقاري 2024 بجدة","Path":"/2f062c51-9a83-4025-9285-e4ace5f01318.config","Level":4251,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2f062c51-9a83-4025-9285-e4ace5f01318.config","Node":{"Content":{"@Key":"2f062c51-9a83-4025-9285-e4ace5f01318","@Alias":"الهيئة العامة للعقار شريك تشريعي في معرض سيريدو العقاري 2024 بجدة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-05-14T11:14:00","NodeName":{"@Default":"الهيئة العامة للعقار شريك تشريعي في معرض سيريدو العقاري 2024 بجدة"},"SortOrder":"251","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-05-14T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"4ab3cc27-275e-49bb-9ccf-d4a38a25c635\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تشارك الهيئة العامة للعقار كشريك تشريعي في المعرض السعــــودي للتطــوير والتمــليك العـــقاري \\\"ســــــيريدو</span><span>\\\"</span><span> </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">2024م الذي تنطلق فعاليته اليوم الثلاثاء 14 مايو ويستمر لمدة أربعة أيام بمركز جدة للمنتديات والفعاليات وبمشاركة عدد من الجهات الحكومية ذات الاختصاص ونخبة من المطورين العقاريين والجهات التمويلية، بالإضافة إلى الخبراء والمختصين في المجال العقاري والاستثماري.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتأتي مشاركة الهيئة العامة للعقار في معرض \\\"ســــــيريدو</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\">\\\"</span><strong><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\"> </span></strong><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقاري 2024 م، ضمن دورها في رفع الوعي العقاري والتعريف بالتشريعات العقارية، وتبادل الخبرات والتجارب مع العاملين بالقطاع، وجعل المجتمع شريكًا في ابتكار الحلول لمواجهة التحديات، والمضي نحو آفاق مستقبلية تعزز من قوة السوق العقاري السعودي باعتباره انموذجًا عالميًا ومحور جذب للاستثمارات والمستثمرين</span><span>.</span><span>&nbsp; </span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتستعرض الهيئة من خلال فريقها وورش العمل التي تعقدها في معرض \\\"ســــــيريدو</span><span>\\\"</span><span> </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقاري منظومة التشريعات العقارية التي تشمل \\\" نظام ولائحة بيع وتأجير مشروعات عقارية على الخارطة \\\" و \\\"نظام الوساطة العقارية\\\"، و\\\"نظام المساهمات العقارية\\\"، إضافةً إلى التعريف بحقوق المتعاملين بالقطاع، وبخدمات الأنشطة التي تأتي تحت تنظيم الهيئة كبرنامج إيجار، وبرنامج فرز الوحدات العقارية، وبرنامج ملاّك، والمعهد العقاري السعودي، والسجل العقاري، ومركز خدمة الشركاء. </span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ معرض \\\"ســــــيريدو</span><span>\\\"</span><span> </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقاري يأتي بهدف نقل أفضل الممارسات والتجارب في المجالات العقارية واستعراض الفرص الاستثمارية التنافسية وجذب المستثمرين إليها، بالإضافة إلى نشر الوعي والمعرفة بآخر المستجدات بالقطاع من أنظمة وتشريعات تسهم في ازدهار السوق العقاري واستدامته وتجعل منه قطاعًا حيويًا يمتلك المرونة العالية للتكيف من المتغيرات المتسارعة، تماشيًا مع الاستراتيجية الوطنية للقطاع العقاري في إطار رؤية المملكة 2030.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار شريك تشريعي في معرض سيريدو العقاري 2024 بجدة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a5719f10-366f-3572-aab6-a9d6c73fd44c","Alias":"هيئة العقار تطلق خدمة الاستعلام عن ترخيص الإعلانات العقارية","Path":"/de961b2f-7404-44ec-bfd7-72e10bf5f3de.config","Level":4252,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/de961b2f-7404-44ec-bfd7-72e10bf5f3de.config","Node":{"Content":{"@Key":"de961b2f-7404-44ec-bfd7-72e10bf5f3de","@Alias":"هيئة العقار تطلق خدمة الاستعلام عن ترخيص الإعلانات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-05-16T09:40:54","NodeName":{"@Default":"هيئة العقار تطلق خدمة الاستعلام عن ترخيص الإعلانات العقارية"},"SortOrder":"252","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-05-16T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a622e1f3-00f8-4fda-a507-46965cd510b6\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أطلقت الهيئة العامة للعقار خدمة الاستعلام عن ترخيص الإعلان العقاري، والتي تمكّن المتعاملين في السوق العقاري التحقق من صحة الإعلانات العقارية بهدف الحد من التعامل مع الاعلانات الوهمية، وتعزيز موثوقية رخص الإعلانات العقارية، ورفع الشفافية وتسهيل تجربة العميل.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت \\\"الهيئة\\\" أنّ هذه الخدمة متاحة للوسطاء العقاريين وملاك العقارات والباحثين عن عقار، ويمكن الاستفادة منها من خلال الدخول إلى منصة الخدمات الإلكترونية للهيئة العامة للعقار، والذهاب إلى خانة الاستعلامات أعلى الصفحة واختيار الاستعلام عن \\\" ترخيص الإعلان العقاري \\\"، ويمكن التأكد من صحة الإعلان باستخدام رقم ترخيصه أو رقم عقد الوساطة أو وثيقة ملكية العقار، كما تتيح الخدمة استعراض بيانات الترخيص وحالته سواء كان ملغي أو منتهي أو نشط.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكّدت الهيئة العامة للعقار</span><span style=\\\"font-family: 'Arial',sans-serif;\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">على ضرورة وجود عقد وساطة بين الوسيط ومالك العقار يحتوي في نطاقه على التسويق لإصدار ترخيص الإعلان العقاري، وأن على الوسطاء ومقدمي الخدمات العقارية كافة الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات، ودعت \\\" الهيئة \\\" المواطنين والمقيمين إلى التواصل معها في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري أو الاستفسارات الأخرى عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم (199011).</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنَّ رخصة&nbsp; \\\"فال\\\" العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت من ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف نظام الوساطة العقارية إلى تنظيم النشاط وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، ورفع جودة التعاملات العقارية بما يسهم في استدامة الأصول العقارية، ويحد من النزاعات ويحفظ حقوق المتعاملين في السوق العقاري السعودي.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار تطلق خدمة الاستعلام عن ترخيص الإعلانات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"2714cf2a-5b11-3d5f-b6b9-2c120846031e","Alias":"الهيئة العامة للعقار تُعلن عن بدء التسجيل العقاري في 7 مناطق عقارية بمدينتي الرياض ومكة المكرمة","Path":"/380d1d53-a013-4beb-b41e-77bbf1004e7a.config","Level":4253,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/380d1d53-a013-4beb-b41e-77bbf1004e7a.config","Node":{"Content":{"@Key":"380d1d53-a013-4beb-b41e-77bbf1004e7a","@Alias":"الهيئة العامة للعقار تُعلن عن بدء التسجيل العقاري في 7 مناطق عقارية بمدينتي الرياض ومكة المكرمة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-05-27T05:21:08","NodeName":{"@Default":"الهيئة العامة للعقار تُعلن عن بدء التسجيل العقاري في 7 مناطق عقارية بمدينتي الرياض ومكة المكرمة"},"SortOrder":"253","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-05-26T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a2f454d2-8088-408b-9c66-09066aea863c\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoCommentText\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار اليوم الأحد 18 ذي القعدة 1445هـ، الموافق 26 مايو 2024م عن بدء التسجيل في 7 مناطق عقارية، تشمل 18 حيّ في مدينتي الرياض ومكة المكرمة، ويستمر التسجيل حتى نهاية يوم 25 صفر 1446هـ الموافق 29 أغسطس 2024م.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت الهيئة إلى أنَ الأحياء المستفيدة في مدينة الرياض هي: (حي المهدية، حي الخزامى، حي عرقة، حي ظهرة لبن، حي السفارات، حي نمار، حي المروة، حي شبرا، حي بدر، حي الشفاء)، فيما تتضمن الأحياء المستهدفة في مدينة مكة المكرمة (جزء من حي الصفوة، وجزء من حي دار السلام، وجزء من حي الهجرة، ومشروع ذاخر ويشمل حي الجميزة وحي ريع ذاخر، ومشروع مسار مكة القسم الأول ويشمل جزء من حي النزهة، جزء من حي الرصيفة، ومشروع جبل عمر، ويشمل حي جرهم الشمالي) حيثُ أكدت الهيئة بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن المناطق المستفيدة من السجل العقاري، إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة (صك إلكتروني مُحدَّث صادر عن وزارة العدل مكتمل البيانات مستوفي شروط الملكية)، وتسجيل عقاراتهم في <a href=\\\"https://eservices.rer.sa،#https://eservices.rer.sa،\\\" title=\\\"https://eservices.rer.sa،\\\" data-anchor=\\\"#https://eservices.rer.sa،\\\">منصة السجل العقاري</a> ،</span><span>&nbsp;ويمكن للمستفيدين التواصل مع مركز خدمة العملاء 199022، للاستفسار عن إجراءات وخطوات التسجيل.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّه ابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر صك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية الجديد بيانات العقار وأوصافه واستعماله وحالته وما يتبعه من حقوق والتزامات وبيانات مالكه، بالإضافة إلى \\\"رقم عقار\\\" مميز لكل وحدة عقارية مرتبطة بالمعلومات الجيومكانية الدقيقة للعقارات ليكون أساس تسجيل الملكية، بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة له.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلن عن بدء التسجيل العقاري في 7 مناطق عقارية بمدينتي الرياض ومكة المكرمة "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"26b61458-a190-3f4a-9e04-001296777d45","Alias":"\"هيئة العقار\" تُنفذ 18 حملة رقابية مشتركة خلال شهر مايو لضمان الامتثال في السوق العقاري","Path":"/ff36d392-0dbe-403f-bcf1-10ec0fe3d015.config","Level":4254,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ff36d392-0dbe-403f-bcf1-10ec0fe3d015.config","Node":{"Content":{"@Key":"ff36d392-0dbe-403f-bcf1-10ec0fe3d015","@Alias":"\"هيئة العقار\" تُنفذ 18 حملة رقابية مشتركة خلال شهر مايو لضمان الامتثال في السوق العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-05-31T10:49:04","NodeName":{"@Default":"\"هيئة العقار\" تُنفذ 18 حملة رقابية مشتركة خلال شهر مايو لضمان الامتثال في السوق العقاري"},"SortOrder":"254","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-05-31T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"06c7acbc-8ddd-4e67-977c-5f578f8267d7\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">نفذت الهيئة العامة للعقار بمشاركة وزارة الموارد البشرية والتنمية الاجتماعية خلال شهر مايو 18 جولة رقابية شملتْ 312 منشأة عقارية في كل من منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة،</span><span> </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">بهدف ضمان الامتثال للتشريعات العقارية بشكل عام ونظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين وتراخيص المُنشآت</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليه لتنظيم السوق العقاري، حيث استهدفت فرقها الرقابية خلال الفترة ذاتها زيارة 14086 منشأة وموقعاً عقارياً مختلفاِ، نتج</span><span> </span>عنها رصد 8990 إعلاناً عقارياً مخالفاً بالأماكن العامة<span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">كما تلقت الهيئة 679 بلاغاً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها، فيما بلغ عدد الإعلانات العقارية التي تم مسحها للتحقق من امتثالها للنظام عبر المسار الإلكتروني أكثر من 4437 إعلانًا</span><span> </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">عقاريًا، حيث تنتهج الهيئة الرقابة الإلكترونية التي تستهدف القنوات الرقمية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة العقارية الرقمية وفق الأنظمة واللوائح</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وطالبت الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة بالامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغائه أو الغرامات المالية، مؤكدةً أنه يمكن مُضاعفة الغرامة المحكوم بها في حال تكرار المخالفة خلال ثلاث سنوات من ارتكابها، وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">ودعت الهيئة المواطنين والمقيمين إلى التواصل معها في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري أو الاستفسارات الأخرى عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم</span><span> ( 199011 ) .</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">يُذكر بأنَّ رخصة فال العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت من ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة وتوعية المستفيدين، كما يرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، ويحد من النزاعات العقارية، ويحفظ حقوق المتعاملين، ويرفع شفافية السوق العقاري</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" \"هيئة العقار\" تُنفذ 18 حملة رقابية مشتركة خلال شهر مايو لضمان الامتثال في السوق العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8d0b1f67-cdb5-3d64-8abf-8c6d1b0df160","Alias":"الهيئة العامة للعقار تستعرض تجاربها في التشريعات العقارية خلال مؤتمر الاتحاد الدولي للعقار في سنغافورة","Path":"/1f5a0555-1c46-42de-b2a0-63c593ec05d9.config","Level":4255,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1f5a0555-1c46-42de-b2a0-63c593ec05d9.config","Node":{"Content":{"@Key":"1f5a0555-1c46-42de-b2a0-63c593ec05d9","@Alias":"الهيئة العامة للعقار تستعرض تجاربها في التشريعات العقارية خلال مؤتمر الاتحاد الدولي للعقار في سنغافورة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-06-02T06:30:05","NodeName":{"@Default":"الهيئة العامة للعقار تستعرض تجاربها في التشريعات العقارية خلال مؤتمر الاتحاد الدولي للعقار في سنغافورة"},"SortOrder":"255","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-06-01T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"b67dd49f-12d7-4dac-a6a1-2f947ffc7d43\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">أكد الرئيس التنفيذي للهيئة العامة للعقار المهندس عبدالله بن سعود الحمّاد أنَّ المملكة أصحبت تُصدّر تجاربها وممارستها التشريعية في مجال العقار لعدد من الدول التي أشادتْ بالتجارب السعودية خصوصًا في مجال التشريعات العقارية وتنظيم العمليات الإيجارية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وأشار خلال ترؤسه وفد الهيئة العامة للعقار المشارك في مؤتمر الاتحاد الدولي للعقار الرابع والسبعين الذي اختم فعاليته اليوم في جمهورية سنغافورة, إلى أنَّ التحول الرقمي الذي تعمل به الجهات الحكومية في المملكة كافة أسهم بشكل كبير في نجاح أتمتة العمليات التشغيلية للبرامج والأنشطة التي تشرف عليها الهيئة في القطاع العقاري</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وقد التقى رئيس \\\"هيئة العقار \\\" خلال المشاركة الدولية بعددٍ من قيادات القطاع العقاري الدولي من الجهات الحكومية والقطاع الخاص حيث تم الاطلاع على عدد من التشريعات والتجارب في تطوير القطاع العقاري كما جرى بالتزامن مع فعاليات المؤتمر عقد عدة اجتماعات منها الاجتماع مع مجلس الإسكان والتنمية، وهيئة إعادة التطوير الحضري في سنغافورة للاطلاع على التجارب والممارسات الدولية في مجال التشريعات العقارية وحوكمة التعاملات لممارسي الأنشطة العقارية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">من جانبٍ آخر أكد الرئيس التنفيذي لقطاع العمليات في الهيئة المهندس جابر المشعل خلال مشاركته في الجلسة الرئيسية للمؤتمر بأنَّ المملكة العربية السعودية تحرص على تطبيقِ أفضلِ الممارساتِ العالمية </span><span style=\\\"font-family: Arial, sans-serif;\\\" lang=\\\"AR-SA\\\">في صناعة العقار، وعقدِ الشراكات الإستراتيجية الهادفة التي تُمكّن وتيسّر مشاركة رواد الصناعة والمطورين العالميين، والاطلاع على فرصهم الاستثمارية المتاحة، وخلق الأفكار المبتكرة، التي تُسهم في تحويل جميع التحديات التي تواجه الصناعة العقارية إلى مكاسب نوعيّة</span>.</p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">كما استعرض \\\"المشعل\\\" ما عملت عليه الهيئة العامة للعقار بصفتها الجهة المشرفة والمنظمة للقطاع العقاري في المملكة العربية السعودية من تطوير في منصاتها الإلكترونية لرفع نسبة الثقة والشفافية في القطاع، بالإضافة لتعزيز كفاءة الخدمات المقدمة عبر أتمتة كافة التعاملات العقارية، من خلال بنية رقمية متكاملة وشاملة ترافق المستثمر والمطور والمستفيد في كل تعاملاته العقارية ابتداءً من البحث عن عقار وحتى ما بعد مرحلة الانتفاع منه وإدارته</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">كما كشفت الهيئة خلال مشاركتها في المؤتمر عن إطلاقها لجائزة التميز العقاري في المملكة العربية السعودية التي سيتم الإعلان عن تفاصيلها وفروعها وآليات المشاركة فيها خلال الفترة القادمة ، وسيتمكن الفائزون فيها من الترشح لجائزة التميز العقاري الدولية التي ينظمها الاتحاد الدولي للعقارات التي أُطلقت في ديسمبر العام الماضي من خلال مكتب الاتحاد في المملكة, الذي تم افتتاحه مؤخرًا في العاصمة الرياض واستطاع خلال فترة وجيزة تقديم عدد من المبادرات في المجال الإعلامي ومجال تطوير القيادات ، تم على أساسها تكريم المكتب ضمن فعاليات مؤتمر سنغافورة</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">مما يذكر بأنَّ مؤتمر الاتحاد الدولي للعقار يُعدّ من أكبر التجمعات التي تجمع المتخصصين في القطاع العقاري من جميع أنحاء العالم ويوفر منصة للتواصل وتبادل المعرفة وبناء العلاقات، ويضم خبراء الصناعة الذين يشاركون وجهات نظرهم حول أحدث الاتجاهات والتطورات في قطاع العقارات</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تستعرض تجاربها في التشريعات العقارية خلال مؤتمر الاتحاد الدولي للعقار في سنغافورة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"7fd979db-12e2-3834-bcdd-7497fd545ced","Alias":"\"هيئة العقار \": تراخيص جديدة للبيع على الخارطة بمساحة 2.8 مليون متر مربع تقدر قيمتها السوقية بـ (6 مليارات ريال)","Path":"/6e615bc9-98ed-4c31-a339-3a1fced67f61.config","Level":4256,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6e615bc9-98ed-4c31-a339-3a1fced67f61.config","Node":{"Content":{"@Key":"6e615bc9-98ed-4c31-a339-3a1fced67f61","@Alias":"\"هيئة العقار \": تراخيص جديدة للبيع على الخارطة بمساحة 2.8 مليون متر مربع تقدر قيمتها السوقية بـ (6 مليارات ريال)","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-06-03T10:57:34","NodeName":{"@Default":"\"هيئة العقار \": تراخيص جديدة للبيع على الخارطة بمساحة 2.8 مليون متر مربع تقدر قيمتها السوقية بـ (6 مليارات ريال)"},"SortOrder":"256","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-06-03T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"40380f26-6c3a-4965-b6af-5d0083dd3182\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\">أصدرت الهيئة العامة للعقار عددًا من التراخيص الجديدة لمزاولة أنشطة التسويق والبيع لمشاريع عقارية على الخارطة لمطورين عقاريين من الشركات المحلية والإقليمية والدولية، وذلك منذ نفاذ النظام في شهر أبريل وحتى منتصف شهر مايو من العام الحالي، بإجمالي 5441 منتجًا عقاريًا سكنيًا وتجاريًا على الخارطة موزعة على عددٍ من مناطق المملكة، وبمساحة إجمالية بلغت 2.8 مليون متر مربع، وتقدر قيمتها السوقية قرابة ( 6 مليارات ريال)، وأضافت الهيئة أنّه بحسب دراسة الجدوى المُقدمة للمشروعات المرخصة؛ فمن المتوقع تسليم أول مشروع في الربع الأخير من العام 2025 وأن الانتهاء من جميع المشاريع المذكورة ستكون بنهاية العام 2028</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">يُذكر أنَّ عدد المشاريع المرخصة للبيع على الخارطة، خلال الـ 15 سنة السابقة تجاوز 390 مشروعًا تحتوي على أكثر من 241 ألف وحدة سكنية بمساحات قاربت 1.7 مليار متر مربع بقيمة سوقية بلغت أكثر من 352 مليار ريال، وهو ما يعكس تطور قطاع التطوير العقاري في المملكة حيث يشهد تنافسية متزايدة في تقديم المنتجات العقارية والضواحي العمرانية المصممة بطرق أكثر ابتكارية وعصرية تتناسب مع اختلاف المتطلبات والاحتياجات للأسر السعودية</span><span>.</span></span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">وأكّدت \\\"الهيئة \\\" أنّ القطاع العقاري يُمثل أرضًا خصبة لجذب الاستثمارات والمستثمرين من مختلف أنحاء العالم، وأنّ التشريع العقاري لنشاط بيع وتأجير مشروعات عقارية على الخارطة أسهم في زيادة الشفافية والموثوقية من خلال التأكد من نظامية وكفاءة العاملين به، والاشتراطات والمعايير التي وضعها لتصنيف المطورين، والقواعد والأحكام التي من شأنها حفظ حقوق الأطراف كافة</span><span> </span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'NeoSansArabic',serif;\\\"><br></span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-theme-font: minor-bidi; background: white;\\\" lang=\\\"AR-SA\\\"><span style=\\\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\\\">يذكر أنّ تنظيم نشاط البيع والتأجير على الخارطة كان تحت إشراف لجنة البيع أو التأجير على الخارطة المشكلة من وزارة الشؤون البلدية والقروية والإسكان، ووزارة العدل، ووزارة التجارة، ومُدن، والبنك المركزي، وعضوين من القطاع الخاص، وبعد صدور المرسوم الملكي رقم م/44 بتاريخ 10 / 03 / 1445 ه بالموافقة على نظام بيع وتأجير مشروعات عقارية على الخارطة أصبحت الهيئة العامة للعقار هي الجهة المختصة بتطبيق أحكام النظام، وقد دخل النظام الجديد حيز النفاذ منذ الرابع من أبريل الماضي للعام الحالي 2024م</span><span>.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار \": تراخيص جديدة للبيع على الخارطة بمساحة 2.8 مليون متر مربع تقدر قيمتها السوقية بـ (6 مليارات ريال)"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"aef2724f-f4d5-3b3f-8ecd-1cb7174bd56c","Alias":"\"هيئة العقار\" تؤهل 27 مطور عقاري لرخصة المساهمات العقارية","Path":"/55bdd026-f2e2-4723-9099-661610c848f1.config","Level":4257,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/55bdd026-f2e2-4723-9099-661610c848f1.config","Node":{"Content":{"@Key":"55bdd026-f2e2-4723-9099-661610c848f1","@Alias":"\"هيئة العقار\" تؤهل 27 مطور عقاري لرخصة المساهمات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-06-06T11:03:16","NodeName":{"@Default":"\"هيئة العقار\" تؤهل 27 مطور عقاري لرخصة المساهمات العقارية"},"SortOrder":"257","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-06-05T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0508350a-6fc7-44a9-a658-68f647433f1c\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئةالعامة للعقار عن تأهيل 27 مطور عقاري لرخصة مزاولة نشاط المساهمات العقارية بعد اجتيازهم للبرنامج التدريبي المقدم من المعهد العقاري، واستيفائهم متطلبات التأهيل الذي يعدّ شرطًا عند تقديم طلب الحصول على ترخيص طرح المشروعات العقارية بنظام المساهمة العقارية وذلك وفق نظام ولائحة المساهمات العقارية التي بدء العمل بهما منذ مطلع العام الحالي 2024.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكّدت \\\"الهيئة \\\"&nbsp;أنّ&nbsp;حصول المطورين العقاريين على شهادة&nbsp;التأهيل لرخصة المساهمات العقارية&nbsp;سيمكنهم من التقدم بطلب ترخيص المشاريع&nbsp;العقارية&nbsp;لطرحها&nbsp;كمساهمات عقارية وفق اشتراطات ومتطلبات النظام، مما&nbsp;يسهم&nbsp;في تسريع وتيرة الإنشاءات وزيادة المعروض العقاري السكني والتجاري والاستثماري والسياحي وغيرها، وخلق مجتمعات حيوية مرنة ومستدامة وملتزمة بالمعايير البيئية&nbsp;والمجتمعية، بالإضافة إلى أن تأهيل المطورين العقاريين قبل ترخيص مشروعاتهم&nbsp;يعزز من سعي الهيئة العامة للعقار في&nbsp;تطوير السوق العقارية وخلق كفاءات&nbsp;مؤهلة&nbsp;علمياً ومهنياً&nbsp;تحد&nbsp;من الممارسات السلبية والخاطئة في مجال&nbsp;المساهمات، بما يحقق مستهدفات خلق بيئة استثمارية تنموية واقتصادية واعدة في المملكة&nbsp;.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما&nbsp;أعلنت&nbsp;الهيئة&nbsp;عن طرح المعهد العقاري السعودي لدورات جديدة ضمن&nbsp;المسار البرنامج التدريبي للمساهمات العقارية المكوّن من 3 دورات تدريبية؛ والتي تعد متطلبًا أساسيًا للحصول على شهادة التأهيل، وتمثل مدخلًا مهمًا للراغبين في ممارسة نشاط المساهمات العقارية وتمكنهم من الإحاطة بالمساهمات العقارية ومفهومها وإجراءاتها النظامية ومقارنتها مع طرق التمويل النظامية الأخرى.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; line-height: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed; caret-color: rgb(0, 0, 0); word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت الهيئة إلى أنّ&nbsp;المسار التدريبي لرخصة المساهمات العقارية يأتي وفق&nbsp;معايير عالية في إعداد المحتوى الفني والعلمي بما يضمن حصول&nbsp;المشتركين على&nbsp;التأهيل&nbsp;المناسب&nbsp;لمزاولة النشاط ورفع مستوى الإدراك بالأعمال المرتبطة&nbsp;به، ويمكن للراغبين&nbsp;بالانضمام&nbsp;للبرنامج التقدم بطلب التسجيل في&nbsp;الدورات&nbsp;التدريبية&nbsp;من خلال الموقع الرسمي للمعهد&nbsp;العقاري السعودي&nbsp;</span><span style=\\\"font-size: 13.5pt;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://srei.sa/\\\">https://srei.sa<span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\">/</span></a></span>.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تؤهل 27 مطور عقاري لرخصة المساهمات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"36bf8f02-e7fb-379d-9367-002d164d3c25","Alias":"\"هيئة العقار\" تُعلن بدء التسجيل العقاري في 8 أحياء شرق الرياض ابتداءً من 17 ذي الحجة","Path":"/7abda693-74c0-4c3b-ad83-613a47a91e73.config","Level":4258,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/7abda693-74c0-4c3b-ad83-613a47a91e73.config","Node":{"Content":{"@Key":"7abda693-74c0-4c3b-ad83-613a47a91e73","@Alias":"\"هيئة العقار\" تُعلن بدء التسجيل العقاري في 8 أحياء شرق الرياض ابتداءً من 17 ذي الحجة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-06-12T11:48:34","NodeName":{"@Default":"\"هيئة العقار\" تُعلن بدء التسجيل العقاري في 8 أحياء شرق الرياض ابتداءً من 17 ذي الحجة"},"SortOrder":"258","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-06-12T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"87371ba3-aedc-4382-91b8-0c84d15c423e\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right;\\\">أعلنتْ الهيئة العامة للعقار عن بدء التسجيل العقاري لـ 51،293 قطعة عقارية في ثمانية أحياء بمدينة الرياض ابتداءً من 23 يونيو 2024م الموافق 17 ذي الحجة 1445هـ، حتى نهاية يوم 26 سبتمبر 2024م الموافق 23 ربيع الأول 1446هـ.</p>\\n<p style=\\\"text-align: right;\\\">&nbsp;وأوضحت الهيئة بأنَّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية: (حي النسيم الشرقي، حي النسيم الغربي، حي المنار، حي السلام، حي الريان، حي الروابي، حي الربوة، حي جرير)، مُبينةً بأنَّ التسجيل الأول للعقارات في هذه الأحياء مُتاحًا عن طريق منصة السجل العقاري الإلكترونية أو من خلال مراكز الخدمة، وأكّدت الهيئة بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري في مختلف مناطق المملكة خلال الفترات القادمة.&nbsp;وأشارت \\\"هيئة العقار\\\" إلى أنَّ عدد الأحياء التي تم الإعلان عنها للسجل العقاري في مدينة الرياض بلغت حتى الآن (77) حيًّا، تشمل (9،671،191) قطعة عقارية.<br>&nbsp;ودعت الهيئة مُلاك العقارات الواقعة ضمن الأحياء المستفيدة من السجل العقاري، إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة (صك إلكتروني مُحدَّث صادر عن وزارة العدل مكتمل البيانات مستوفي شروط الملكية)، وتسجيل عقاراتهم في <a href=\\\"https://eservices.rer.sa#https://eservices.rer.sa\\\" title=\\\"https://eservices.rer.sa\\\" data-anchor=\\\"#https://eservices.rer.sa\\\">منصة السجل العقاري </a>ويمكن للمستفيدين التواصل مع مركز خدمة العملاء 199002، للاستفسار عن إجراءات وخطوات التسجيل.&nbsp;يُذكر بأنَّ السجل العقاري هو نظام لتوثيق العقارات يعتمد على الوحدة العقارية كأساس لتسجيل الملكية والتصرفات والحقوق العقارية الأخرى المترتبة على العقار، وذلك بإصدار وثيقة تشمل على رقم العقار واسم مالكه وأوصافه من حيث نوعه وموقعه الجغرافي كإحداثيات مرتبطة بالبيانات الجيومكانية، ومساحته وحدوده وأبعاده والعقارات المجاورة له، وما له من حقوق وما عليه من التزامات وما يطرأ عليه من تغيير أو تصرفات وما يترتب عليه من حقوق للغير.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تُعلن بدء التسجيل العقاري في 8 أحياء شرق الرياض ابتداءً من 17 ذي الحجة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d1bae899-dea7-3c02-a001-22d06d13c5ba","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 6 أحياء بالمدينة المنورة ابتداءً من 24 ذو الحجة","Path":"/2cbcb277-edcf-433f-b880-86a59c4cd51c.config","Level":4259,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2cbcb277-edcf-433f-b880-86a59c4cd51c.config","Node":{"Content":{"@Key":"2cbcb277-edcf-433f-b880-86a59c4cd51c","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 6 أحياء بالمدينة المنورة ابتداءً من 24 ذو الحجة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-06-13T15:41:38","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 6 أحياء بالمدينة المنورة ابتداءً من 24 ذو الحجة"},"SortOrder":"259","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-06-13T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"83e304bc-b3fb-457f-bf9b-ace411d19a6b\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن بدء التسجيل لـ (4،774 قطعة عقارية) في ستة أحياء بالمدينة المنورة ابتداءً من 30 يونيو 2024م&nbsp;الموافق 24 ذو الحجة 1445ه، وحتى نهاية يوم 3 أكتوبر 2024م الموافق 30 ربيع الأول 1446ه.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة بأنَّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية: (جزء من حي الملك فهد، جزء من حي العاقول، جزء من حي جماء أم خالد، حي سكة الحديد، جزء من حي الخضراء، جزء من حي ابيار الماشي)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري في مختلف مناطق المملكة خلال الفترات القادمة.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحًا عن طريق <a href=\\\"https://rer.sa/rer-services-ar/#https://rer.sa/rer-services-ar/\\\" title=\\\"https://rer.sa/rer-services-ar/\\\" data-anchor=\\\"#https://rer.sa/rer-services-ar/\\\">منصة السجل العقاري الإلكترونية</a></span><span>&nbsp;</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أو عن طريق مراكز الخدمة، مبيَّنة أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتدعو الهيئة ملاَّك العقارات في المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة او عن طريق الاتصال على مركز خدمة العملاء 199002.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 6 أحياء بالمدينة المنورة ابتداءً من 24 ذو الحجة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"c43d5674-b782-3fe6-b6ba-89f7623efdc4","Alias":"\"هيئة العقار\": انتهاء مدة تسجيل العقارات في السجل العقاري لــ (5) أحياء بمدينة الرياض الخميس القادم","Path":"/f841d20f-9116-43ef-be5a-045717d3ff70.config","Level":4260,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f841d20f-9116-43ef-be5a-045717d3ff70.config","Node":{"Content":{"@Key":"f841d20f-9116-43ef-be5a-045717d3ff70","@Alias":"\"هيئة العقار\": انتهاء مدة تسجيل العقارات في السجل العقاري لــ (5) أحياء بمدينة الرياض الخميس القادم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-02T11:30:16","NodeName":{"@Default":"\"هيئة العقار\": انتهاء مدة تسجيل العقارات في السجل العقاري لــ (5) أحياء بمدينة الرياض الخميس القادم"},"SortOrder":"260","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-02T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"6672465d-f4e8-4368-8242-4890e859a1e0\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المدة المحددة للتسجيل العيني الأول للعقار في خمسة أحياء مستفيدة من السجل العقاري في مدينة الرياض ضمن المرحلة الرابعة وهي: حي الهدا، جزء من حي سدرة،</span><span> </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">جزء من حي الشعلة، جزء من حي الفرسان وحي النخبة، وذلك بنهاية يوم الخميس القادم</span><span> .</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن نطاق الأحياء إلى سرعة المبادرة بتسجيل عقاراتهم من خلال منصة السجل العقاري قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ التسجيل العيني للعقار يتيح إصدار \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه،</span><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة له</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وأكدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية </span>متكاملة تُسهم في تعزيز الشفافية والثقة في خدمات وبيانات العقارات<span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\": انتهاء مدة تسجيل العقارات في السجل العقاري لــ (5) أحياء بمدينة الرياض الخميس القادم"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"fb285359-8d54-390c-908f-2adf0cce15d1","Alias":"رئيس هيئة العقار يستقبل رئيس هيئة تنظيم القطاع العقاري القطري","Path":"/f2698c79-0059-4d72-b982-5be700c163f9.config","Level":4261,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f2698c79-0059-4d72-b982-5be700c163f9.config","Node":{"Content":{"@Key":"f2698c79-0059-4d72-b982-5be700c163f9","@Alias":"رئيس هيئة العقار يستقبل رئيس هيئة تنظيم القطاع العقاري القطري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-02T13:48:44","NodeName":{"@Default":"رئيس هيئة العقار يستقبل رئيس هيئة تنظيم القطاع العقاري القطري"},"SortOrder":"261","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-02T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"e6b87cf0-0e51-4fe9-a764-84f1f9b32758\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p>استقبل الرئيس التنفيذي للهيئة العامة للعقار المهندس عبدالله بن سعود الحماد بمقر الهيئة في الرياض، الرئيس التنفيذي للهيئة العامة لتنظيم القطاع العقاري في دولة قطر المهندس خالد بن أحمد العبيدلي والوفد المرافق له.<br>&nbsp;وجرى خلال اللقاء مناقشة الموضوعات ذات الاهتمام المشترك، وبحث تعزيز التعاون بين البلدين الشقيقين في مجال القطاع العقاري.<br>&nbsp;واطلّع الوفد على أعمال الهيئة في مجال التنظيم والتشريع للقطاع العقاري بالمملكة، واستعراض الإستراتيجية الشاملة للهيئة العامة للعقار، وتجربتها الرائدة في قطاع التطوير العقاري بأنظمة البيع على الخارطة والمساهمات العقارية وآلية عمل حساب الضمان، والاطلاع على العمليات العقارية من خلال إصدار التراخيص والرقابة وخدمات المركز السعودي للتحكيم العقاري، إضافة إلى زيارة الوفد لمقر الشركة الوطنية للإسكان واستعراضها كأنموذج للعمليات التشغيلية للهيئة وآلية تطويرها للمنصات ومراقبة الخدمات العقارية ، وزيارة مقر عمليات البيع والتأجير على الخارطة والاطلاع على آليات عمل الفريق التشغيلي لها.<br>&nbsp;من جهتهم ثمن أعضاء الوفد ما اطلعوا عليه من أنظمة وتشريعات وتجارب ونماذج تشغيليه ومنصات وخدمات عقارية من شأنها أن تعزز من الموثوقية والشفافية في القطاع العقاري، وأكدوا على أهمية تبادل الخبرات والتجارب مما يعزز تذليل التحديات ويدفع بنمو القطاع في البلدين وفق أفضل الممارسات الحضرية المستدامة لبناء مجتمعات عمرانية ذات مسؤولية بيئية تتسم بالحيوية والمرونة ومتوافقة مع الأهداف الاقتصادية والاجتماعية.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار يستقبل رئيس هيئة تنظيم القطاع العقاري القطري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"912e926f-76f7-38cc-a94f-54e1bf4f8009","Alias":"الهيئة العامة للعقار تُشارك في ملتقى القصيم العقاري","Path":"/394e3084-de2d-445c-b932-e2872507be0d.config","Level":4262,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/394e3084-de2d-445c-b932-e2872507be0d.config","Node":{"Content":{"@Key":"394e3084-de2d-445c-b932-e2872507be0d","@Alias":"الهيئة العامة للعقار تُشارك في ملتقى القصيم العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-03T09:48:40","NodeName":{"@Default":"الهيئة العامة للعقار تُشارك في ملتقى القصيم العقاري"},"SortOrder":"262","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-03T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"cd3fb05b-6283-4385-9954-f750babe8749\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تُشارك الهيئة العامة للعقار في ملتقى القصيم العقاري خلال الفترة من 03 – 05 يوليو 2024م، والذي يقام بمركز الملك فهد الحضاري بعنيزة، بمشاركة عدد من الجهات من القطاعين العام والخاص ذات الاختصاص ونخبة من قادة ورواد القطاع، بالإضافة إلى الخبراء والمختصين في المجال العقاري والاستثماري.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتأتي مشاركة الهيئة العامة للعقار في ملتقى القصيم العقاري، ضمن دورها في تعزيز الوعي والمعرفة العقارية واستكشاف الفرص التطويرية ، وتبادل الخبرات والتجارب مع العاملين بالقطاع، وتقديم تحليلات منطقية ورؤى مستقبلية حول اتجاهات سوق العقارات والتعريف بأحدث المستجدات فيه من قوانين وتشريعات معمول بها وتحليل تأثيرها على القطاع والمستثمرين ، بالإضافة إلى جعل المجتمع شريكًا في ابتكار الحلول لمواجهة التحديات، والمضي نحو آفاق تعزز من قوة السوق العقاري السعودي باعتباره انموذجًا عالميًا ومحور جذب للاستثمارات والمستثمرين</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\">.</span><span>&nbsp; </span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتستعرض الهيئة من خلال فريقها والجلسات الحوارية</span><span> </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وورش العمل التي تشارك بها في \\\"الملتقى العقاري \\\" منظومة التشريعات العقارية التي تشمل \\\" نظام ولائحة بيع وتأجير مشروعات عقارية على الخارطة \\\" و \\\"نظام الوساطة العقارية\\\"، و\\\"نظام المساهمات العقارية\\\"، إضافةً إلى التعريف بحقوق المتعاملين بالقطاع، وبخدمات الأنشطة التي تأتي تحت تنظيم الهيئة كبرنامج إيجار، وبرنامج فرز الوحدات العقارية، وبرنامج ملاّك، والمعهد العقاري السعودي، والسجل العقاري، ومركز خدمة الشركاء.&nbsp;</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنًّ ملتقى القصيم العقاري يهدف إلى استكشاف وتسليط الضوء على الفرص الواعدة في قطاع العقارات بمنطقة القصيم ويمثل منصة مثالية للمستثمرين والمطورين العقاريين لاستكشاف مجموعة واسعة من الفرص الاستثمارية المتاحة في العقارات التجارية والسكنية والسياحية، بالإضافة إلى نشر الوعي والمعرفة بآخر المستجدات بالقطاع من أنظمة وتشريعات تُسهم في ازدهار السوق العقاري واستدامته.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُشارك في ملتقى القصيم العقاري "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"39a05691-e630-3468-907e-610dcc58777b","Alias":"رئيس هيئة العقار: 1.3 مليون خريطة عقارية مصححة منذ إطلاق السجل العقاري","Path":"/db73a4a9-4bf3-43dd-884b-f67ea6bbe44d.config","Level":4263,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/db73a4a9-4bf3-43dd-884b-f67ea6bbe44d.config","Node":{"Content":{"@Key":"db73a4a9-4bf3-43dd-884b-f67ea6bbe44d","@Alias":"رئيس هيئة العقار: 1.3 مليون خريطة عقارية مصححة منذ إطلاق السجل العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-04T10:08:16","NodeName":{"@Default":"رئيس هيئة العقار: 1.3 مليون خريطة عقارية مصححة منذ إطلاق السجل العقاري"},"SortOrder":"263","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-04T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"62c4192a-fb01-476e-9605-3a561e09ac5f\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أبرز الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد، ما تشهده المنظومة العقارية في المملكة من تحولات تنموية ضخمة، كانت نتاج الدعم غير المحدود من القيادة الرشيدة - حفظها الله - مما مكن القطاع العقاري وجعل منه أنموذجًا عالميًا يحتذى به.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وثمن في كلمته خلال افتتاح \\\"ملتقى القصيم العقاري\\\" جهود ومتابعة صاحب السمو الملكي الأمير الدكتور فيصل بن مشعل أمير منطقة القصيم في دعم التطوير العقاري وبرامج الهيئة وتطبيق السجل العقاري في المنطقة&nbsp; ، وأكّد بأنَّ العقار في المملكة العربية السعودية ، يخطو خطوات واثقة وسط تشريعات تنظيمية تتسم بالحيوية والمرونة من خلال 18 تشريع حتى الآن تشمل أنظمة عقارية ولوائح تنفيذية ولوائح وقواعد تنظيمية، منها نظام التسجيل العيني للعقار الذي يأتي امتدادًا للاستراتيجية الشاملة للقطاع العقاري نتج عنه تصحيح أكثر من مليون وثلاثمئة ألف خريطة عقارية تسهم في تسريع أعمال التسجيل العيني للعقار وتسهيل المعاملات العقارية ودعم التخطيط العمراني والتنمية المستدامة.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار الرئيس التنفيذي للهيئة العامة للعقار إلى أن التسجيل العيني للعقار يأتي وفقاً لأفضل الممارسات العالمية المتبعة، لضمان صحة معلومات وبيانات جميع أنواع العقارات، وبناء سجل عقاري شامل يحتوي على بيانات الملكية والمعلومات الجيومكانية وغيرها، وأنه منذ إعلان بدء أعمال التسجيل العيني في السابع من مايو 2023 الماضي وحتى اليوم شملت أعمال التسجيل العيني للعقار بمدينة الرياض أكثر من 70 حيًا بإجمالي عدد 617,622 قطعة أرض ، وقد بدأت أعمال التسجيل في منطقتي مكة المكرمة والمدينة المنورة ، وكذلك بالمنطقة الشرقية .</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وقد أعلن رئيس الهيئة بحضور سمو أمير المنطقة عن بدء أعمال تطبيق السجل العقاري في منطقة القصيم ابتداءً من يوم الأحد غرة محرم القادم الموافق 7 يوليو 2024 م ، وأكد بأن الهيئة تستهدف هذا العام الإعلان عن تسجيل أكثر من 380 ألف قطعة أرض في القصيم على أن يتم استكمال المتبقي في عام 2025 بالتعاون مع أمانة المنطقة وتنفيذ شركة السجل العقاري .</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكّد المهندس الحماد على حرص الهيئة العامة للعقار على مواصلة العمل بشكل مستمر مع شركائها لرسم خارطة واضحة لرحلة المتعاملين في القطاع العقاري من التمكين وحتى الاستدامة لتعزيز موثوقية وشفافية القطاع بما يعزز الاستثمار فيه وجذب المستثمرين من مختلف أنحاء العالم، ولخلق مجتمعات عمرانية أكثر عصرية وحيوية ورفاهية، وأكثر استدامة والتزاما بالمعايير البيئة والاجتماعية. </span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار: 1.3 مليون خريطة عقارية مصححة منذ إطلاق السجل العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9a885fb9-4de0-386e-8b25-4c3af3a61bfe","Alias":"هيئة العقار تطلق غدًا ملتقى الإعلام العقاري بهدف تعزيز التكامل مع القطاع الإعلامي","Path":"/60ba5240-6975-4a0f-8719-d98752d7f37d.config","Level":4264,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/60ba5240-6975-4a0f-8719-d98752d7f37d.config","Node":{"Content":{"@Key":"60ba5240-6975-4a0f-8719-d98752d7f37d","@Alias":"هيئة العقار تطلق غدًا ملتقى الإعلام العقاري بهدف تعزيز التكامل مع القطاع الإعلامي","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-06T16:27:37","NodeName":{"@Default":"هيئة العقار تطلق غدًا ملتقى الإعلام العقاري بهدف تعزيز التكامل مع القطاع الإعلامي"},"SortOrder":"264","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-06T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"f9ba2d70-f6e1-4b70-a285-de730079b99e\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span lang=\\\"AR-SA\\\">تطلق الهيئة العامة للعقار غدًا, النسخة الأولى من ملتقى الإعلام العقاري, وذلك في معرض الرياض الدولي للمؤتمرات والمعارض، بمشاركة نخبة من الشخصيات الإعلامية والخبراء في القطاع العقاري لمناقشة أهمية دور الإعلام في زيادة الوعي العقاري لجميع فئات المجتمع مما يسهم في تعزيز دور القطاع العقاري وتحقيق تطلعاته</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span><br>&nbsp;</span><span lang=\\\"AR-SA\\\">وأكدت الهيئة العامة للعقار بأن الهدف الرئيسي من تنظيم \\\" ملتقى الإعلام العقاري \\\" التأكيد على ضرورة التكامل بين القطاعين العقاري والإعلامي لنشر المعرفة والوعي بالتوجهات والخدمات العقارية وطرق حفظ الحقوق حيث يتضمن الملتقى جلسات حوارية تستعرض مستقبل العلاقة بين العقار والإعلام ومدى تأثير الإعلام على تطوير وتشكيل القطاع العقاري ومساهمته في تعزيز الشفافية والموثوقية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span><br>&nbsp;</span><span lang=\\\"AR-SA\\\">وأفادت أن ملتقى الإعلام العقاري \\\" في نسخته الأولى يركز على آلية التعامل مع البيانات المتعددة من مصادر داخلية أو خارجية، بالإضافة إلى دور البيانات كمصدر رئيسي للمعلومات وإسهامها في خلق تصور أشمل لأداء مختلف البرامج والأنظمة والعمليات العقارية، إيمانًا من \\\"الهيئة\\\" بأهمية البيانات لوسائل الإعلام بما يعزز إيصال رسائل القطاع العقاري وفق التوجهات والاستراتيجيات التي يعمل عليها بمبدأ الشفافية وزيادة مشاركة المجتمع في تحسين كفاءة الخدمات المقدمة لهم، لتحقيق تنمية واستدامة القطاع</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span lang=\\\"AR-SA\\\">ودعت الهيئة العامة للعقار المهتمين بالمجال العقاري وتقديم التحليلات والاستشارات العقارية عبر وسائل الإعلام، وأصحاب</span><span> </span><span lang=\\\"AR-SA\\\">الاختصاص من القطاعين الإعلامي والعقاري إلى الاستفادة من موضوعات الجلسات</span><span> </span>الحوارية التي سيناقشها الملتقى<span> </span>والمحتوى المعرفي الذي سينشر عبر <a href=\\\"/rega.gov.sa#rega.gov.sa\\\" title=\\\"rega.gov.sa\\\" data-anchor=\\\"#rega.gov.sa\\\">موقعها الإلكتروني الرسمي</a><span> </span>وحساباتها على منصات التواصل الاجتماعي<span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" هيئة العقار تطلق غدًا ملتقى الإعلام العقاري بهدف تعزيز التكامل مع القطاع الإعلامي"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"317fc856-2962-3196-b6ba-b6cb553dc0c9","Alias":"هيئة العقار\" تطلق هويتها البصرية الجديدة\"","Path":"/8c4adb7e-4d3c-455f-a253-1f54eb355ecc.config","Level":4265,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/8c4adb7e-4d3c-455f-a253-1f54eb355ecc.config","Node":{"Content":{"@Key":"8c4adb7e-4d3c-455f-a253-1f54eb355ecc","@Alias":"هيئة العقار\" تطلق هويتها البصرية الجديدة\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-07T10:47:13","NodeName":{"@Default":"هيئة العقار\" تطلق هويتها البصرية الجديدة\""},"SortOrder":"265","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-07T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"8dc4e20e-4f5f-489f-97a4-c680ab8a6c25\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p>أطلقت الهيئة العامة للعقار هويتها البصرية الجديدة المنبثقة من الهوية الوطنية والثقافية والمعمارية السعودية، وتأتي تجسيدًا لرؤية الهيئة في تنظيم وتنمية وتحسين آليات الإشراف في القطاع العقاري؛ لرفع كفاءته وتشجيع الاستثمار فيه، وزيادة إسهامه في الناتج المحلي.<br>&nbsp;وأوضح المتحدث الرسمي \\\"للهيئة\\\" الأستاذ تيسير بن محمد المفرج، أن هذه الخطوة تأتي تأكيدًا على مواصلة الهيئة العامة للعقار دورها الريادي في تعزيز نمو القطاع العقاري بالمملكة، بالإضافة إلى التزامها برؤيتها وإستراتيجيتها التي تتمثل في التمكين والشفافية والموثوقية، لتطوير القطاع وتحفيز النمو الاقتصادي فيه، مؤكدًا مواصلة الجهود في تحقيق أعلى المعايير الإشرافية والتنظيمية لضمان تحقيق المستهدفات.<br>&nbsp;يُذكر أنًّ الهيئة العامة للعقار تعمل على تنظيم وتطوير القطاع العقاري في المملكة، عبر سن الأنظمة والتشريعات التي تمكّن الفاعلين في القطاع من ممارسة أعمالهم وفقًا لأعلى المعايير المعتمدة، وتسهم في تأهيل المختصين في مجالات متعددة تشمل تطوير العقارات والتمويل العقاري، بالإضافة إلى إدارة الممتلكات والاستثمار العقاري، كما تسهم في تحقيق رؤية المملكة في القطاع العقاري عبر تحقيق تنمية عقارية مستدامة وشاملة.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\" تطلق هويتها البصرية الجديدة\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8ee0d8b9-12a2-3859-80f9-d3e5468c5389","Alias":"رئيس هيئة العقار: الإعلام شريك في تنمية واستدامة القطاع العقاري","Path":"/db2ea9f7-6319-481d-8d4c-52112b3e2638.config","Level":4266,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/db2ea9f7-6319-481d-8d4c-52112b3e2638.config","Node":{"Content":{"@Key":"db2ea9f7-6319-481d-8d4c-52112b3e2638","@Alias":"رئيس هيئة العقار: الإعلام شريك في تنمية واستدامة القطاع العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-07T18:56:23","NodeName":{"@Default":"رئيس هيئة العقار: الإعلام شريك في تنمية واستدامة القطاع العقاري"},"SortOrder":"266","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-07T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"b08cb8d9-b35f-4cca-8d95-a94f7f095565\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">أشاد الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد، بدور القطاعات الإعلامية في توثيق وإبراز رسائل المنظومة العقارية وما وَصلت إليه من تنظيمٍ وحوكمةٍ، وايصال صوتَ المستفيدين لتطوير الأعمال بما يسهم في تنمية واستدامة القطاع العقاري والارتقاء بالخدمات المقدمة للمتعاملين به.&nbsp;&nbsp;</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وأكد في كلمته خلال افتتاح \\\"ملتقى الإعلام العقاري\\\" على أن \\\"الملتقى\\\" يأتي ليؤكدَ دور وسائل الإعلام والإعلاميين في تنمية واستدامة القطاع العقاري، بالإضافة إلى أن \\\"الهيئة\\\" والقطاعات الإعلامية تسير جنبًا إلى جنبٍ في رحلةِ تحقيق الآفاق المستقبلية التي أرستْ قواعدها ورسمتْ خارطتها قيادتنا الرشيدة – حفظها الله – وقد أولتْ الإعلام والتفاعل معه أهميةً بالغةً إيمانًا منها بالتكامل والشراكة في البناء والتنمية.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وأشار الرئيس التنفيذي للهيئة العامة للعقار أنّ \\\"الهيئة \\\" تؤمن بأن المعلومة في القطاع العقاري وعنه يُمكنْ أنْ تؤثر تأثيرًا مباشرًا على الأفراد والشركات والمؤسسات والاقتصاد وصورته بشكل عام، وقد عملت \\\"الهيئة \\\" على حوكمةِ تقديم المعلومات والآراء المتصلة بالشأن العقاري من خلال نشاطِ الاستشارات والتحليلات العقارية، واشتراط ممارسته بالحصول على ترخيص يضمن تأهيلَ من يُقدم المعلومة، و تطبيقه لقواعد التحليل وتقديم الآراء عبرَ وسائل الإعلام المختلفة ، وأن الهيئة تتيح البيانات للإعلام لتعزز مبدأ الشفافية والوضوح الذي بُنيت عليه الاستراتيجية الشاملة للقطاع العقاري .</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وذكر المهندس الحماد أن الهيئة العامة للعقار تسعى في هذه النسخة من الملتقى لرفع الوعي لدى العقاريين وتعريفهم على أفضل الطرق في استخدام البيانات وإتاحتها بهدف تعزيز الشفافية وزيادة مشاركةِ المجتمع في تحسين كفاءةِ الخدماتِ المقدمةِ لهم والتشجيع على الإبداع والابتكار، وتحويل الأطروحات \\\"بالملتقى \\\" لمشاريع تتم متابعتها داخل الهيئة.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار: الإعلام شريك في تنمية واستدامة القطاع العقاري "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"6d29a279-58ae-3b3f-bfec-8f9d716847bb","Alias":"\"هيئة العقار\" تختتم أعمال ملتقى الإعلام العقاري بنسخته الأولى","Path":"/9f20b360-3088-4a9f-be60-b5584ee7377e.config","Level":4267,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/9f20b360-3088-4a9f-be60-b5584ee7377e.config","Node":{"Content":{"@Key":"9f20b360-3088-4a9f-be60-b5584ee7377e","@Alias":"\"هيئة العقار\" تختتم أعمال ملتقى الإعلام العقاري بنسخته الأولى","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-08T08:52:56","NodeName":{"@Default":"\"هيئة العقار\" تختتم أعمال ملتقى الإعلام العقاري بنسخته الأولى"},"SortOrder":"267","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-08T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"4db2af74-1600-4067-9faa-73852931a57f\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">اختتمت الهيئة العامة للعقار أمس الأحد &nbsp;1 &nbsp;محرم للعام الهجري الجديد 1446هـ، الموافق 7 يوليو 2024م، أعمال النسخة الأولى من \\\"ملتقى الإعلام العقاري\\\" الذي نظمته بمركز الرياض للمؤتمرات والمعارض بالعاصمة الرياض، بحضور الرئيس التنفيذي للهيئة المهندس عبد الله بن سعود الحمّاد واستعرض \\\" الملتقى \\\" أهمية دور الإعلام في زيادة الوعي العقاري لجميع فئات المجتمع، بما يسهم في تعزيز دور القطاع العقاري وتحقيق تطلعاته، وذلك بمشاركة نخبة من الشخصيات الإعلامية والخبراء في القطاع العقاري.</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأكّد المتحدث الرسمي للهيئة العامة للعقار أ.تيسير بن محمد المفرج أنّ الإعلام يقدم دورًا مؤثرًا في تطوير وتشكيل القطاع العقاري ويساهم بشكل كبير في تعزيز الشفافية والموثوقية بما يحقق تنمية واستدامة القطاع ، مضيفًا أنّ \\\" الهيئة \\\" تعمل مع شركائها بالمنظومة الإعلامية بهدف التكامل بين القطاعيين العقاري والإعلامي لنشر المعرفة والوعي بالأنظمة والتشريعات العقارية لجميع فئات المجتمع ، كما أنّ ملتقى الإعلام العقاري يأتي اليوم بالتزامن مع إطلاق \\\" الهيئة \\\" لهويتها البصرية الجديدة لتؤكد على المضي قدمًا لتحقيق الاستراتيجية الشاملة للقطاع العقاري واستدامتها ، ومرتكزة على الحوكمة والتمكين والاستدامة وفاعلية السوق وخدمة الشركاء ، بما يسهم في تطوير القطاع وتعزيز جاذبيته للاستثمار .</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">واستعرض المتحدثون بالجلسة الحوارية الأولى التي جمعت نخبة من الشخصيات الإعلامية “دور الإعلام في صناعة العقار\\\" وأهمية الشراكة بين الإعلام والعقار، مؤكدين على أن العقار يعد من أكبر القطاعات على مستوى العالم، وأكثرها تأثراً بالمعلومات سوءاَ كانت سلباً أو إيجاباً، كما أشاد المتحدثون بدور الهيئة العامة للعقار الرقابي على ما ينشر بالقطاع العقاري وسرعة التفاعل معها وإصدار البيانات الصحفية والمنشورات التي كانت بدورها مساهمًا واضحًا في زيادة الموثوقية بالقطاع العقاري وتشريعاته.</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">كما تطرق المتحدثون بالجلسة الحوارية الثانية على أهمية \\\"البيانات ودورها في نشاط الاستشارات والتحليلات العقارية\\\" وأهمية مشروع التسجيل العيني للعقار الذي أطلقته \\\"الهيئة \\\" في إتاحة المعلومات للمستهلكين بطريقة واضحة ودقيقة وشاملة للمتعاملين بالقطاع العقاري، كما حذر المتحدثون من أخذ التوصيات العقارية من غير المختصين والمرخصين، وأن على الباحث عن المعلومة استقائها من مصدرها الموثوق.</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">يُذكر أنّ \\\"الهيئة\\\" تهدف من خلال تنظيم \\\" ملتقى الإعلام العقاري \\\" إلى التأكيد على ضرورة التكامل بين القطاعين العقاري والإعلامي لنشر المعرفة والوعي بالتوجهات والخدمات العقارية وطرق حفظ الحقوق، بالإضافة إلى أن رسالة \\\"الملتقى \\\" في هذه النسخة هي التعريف بأهمية ودور البيانات كمصدر رئيسي للمعلومات واسهامها في خلق تصور أشمل لأداء مختلف البرامج والأنظمة والعمليات العقارية.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تختتم أعمال ملتقى الإعلام العقاري بنسخته الأولى"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"58875aa7-5b45-3a44-ab89-5ade79a0e7df","Alias":"\"هيئة العقار\" تطلق الأربعاء القادم ملتقى الوساطة العقارية","Path":"/84333243-005b-4c71-8716-3a7e1b3469ff.config","Level":4268,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/84333243-005b-4c71-8716-3a7e1b3469ff.config","Node":{"Content":{"@Key":"84333243-005b-4c71-8716-3a7e1b3469ff","@Alias":"\"هيئة العقار\" تطلق الأربعاء القادم ملتقى الوساطة العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-11T11:12:40","NodeName":{"@Default":"\"هيئة العقار\" تطلق الأربعاء القادم ملتقى الوساطة العقارية"},"SortOrder":"268","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-11T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"30be542c-0d5e-400a-9ad0-67c3aa395645\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: center;\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تقيم الهيئة العامة للعقار \\\"ملتقى الوساطة العقارية\\\" والمعرض المصاحب&nbsp; له الأربعاء القادم 17 يوليو 2024 الموافق 11 محرم 1446 هـ&nbsp; في مركز الرياض الدولي للمؤتمرات والمعارض، بالتزامن مع مرور عام على نفاذ النظام، ويناقش الملتقى الفرص ومكامن التطوير في السوق العقاري بمشاركة نخبة من الخبراء والمهتمين في القطاع العقاري مما يسهم في تنمية القطاع وتحقيق تطلعاته. </span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكدت الهيئة العامة للعقار أنّ \\\" ملتقى الوساطة العقارية \\\" يأتي لعرض التحديثات التي مره بها نظام الوساطة العقارية خلال عام منذ بدء تطبيقه، وأنّ الملتقى يتضمن عدد من الجلسات الحوارية التي تناقش الفرص والتحديات بالقطاع وكذلك تسليط الضوء على المنصات العقارية ذات التجارب الناجحة في نشاط الوساطة العقارية، وأهمية الامتثال بالأنظمة والتشريعات العقارية التي تسهم في تعزيز الموثوقية والشفافية.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكرت \\\" الهيئة \\\" أنّ \\\"الملتقى \\\" في نسخته الأولى يأتي في إطار الجهود المستمرة لتطوير نشاط الوساطة العقارية، وبناء قطاع متين متقدم يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات الاستراتيجية الشاملة للقطاع العقاري، &nbsp;حيث سيتضمن معرض مصاحب للتعريف بالأنشطة العقارية وأقسام خاصة لخدمة المستفيدين من منصة الوساطة العقارية وخدمات المعهد العقاري وكذلك قسم لاستقبال الأسئلة والاستفسارات وخدمة الشركاء، بما يعزز إيصال رسائل القطاع العقاري والتعريف بالأنظمة والتشريعات العقارية التي تأتي وفق التوجهات والاستراتيجيات التي تعمل عليها الهيئة بمبدأ الشفافية وزيادة مشاركة المجتمع، لتحقيق تنمية واستدامة القطاع.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة العامة للعقار العموم والمهتمين وأصحاب الاختصاص بالمجال العقاري ومزاولي أنشطة الوساطة العقارية وتقديم الاستشارات والتحليلات العقارية، إلى الاستفادة من موضوعات الجلسات الحوارية التي سيناقشها الملتقى والمعرض المصاحب له، من خلال تسجيل وتأكيد الحضور للملتقى عبر الرابط الإلكتروني التالي: </span><a href=\\\"https://survey.rega.gov.sa/s/clyfksi4x002gkgdopx894lvp\\\">https://survey.rega.gov.sa/s/clyfksi4x002gkgdopx894lvp</a></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تطلق الأربعاء القادم ملتقى الوساطة العقارية "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9f1b99bf-652a-3796-97ff-424028438e47","Alias":"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 11 حي بمدينة الرياض ابتداءً من 22 محرم”","Path":"/1cd5e035-aa27-4afb-8560-3d79f46fa318.config","Level":4269,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1cd5e035-aa27-4afb-8560-3d79f46fa318.config","Node":{"Content":{"@Key":"1cd5e035-aa27-4afb-8560-3d79f46fa318","@Alias":"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 11 حي بمدينة الرياض ابتداءً من 22 محرم”","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-13T13:11:46","NodeName":{"@Default":"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 11 حي بمدينة الرياض ابتداءً من 22 محرم”"},"SortOrder":"269","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-13T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9d6c4e5d-6130-42fc-80d1-ab4ba62858fd\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right;\\\" class=\\\"MsoNormal\\\" align=\\\"right\\\">&nbsp;</p>\\n<p style=\\\"text-align: center;\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 18.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الهيئة العامة للعقار\\\" تُعلن عن بدء التسجيل في 11 حي بمدينة الرياض ابتداءً من 22 محرم</span><span style=\\\"font-size: 18.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\">”</span></p>\\n<p style=\\\"text-align: right;\\\" class=\\\"MsoNormal\\\" align=\\\"right\\\"><strong>&nbsp;</strong></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن بدء التسجيل لـ (113,541 قطعة عقارية) في 11 حي بمدينة الرياض ابتداءً من 28 يوليو 2024م، الموافق 22 ذو محرم 1446هـ، وحتى نهاية يوم 31 أكتوبر 2024م الموافق 28 ربيع الثاني 1446هـ</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة بأنَّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية: (حي طويق، جزء من حي عريض، حي الملك عبد العزيز، حي السليمانية، حي الوزارات، حي الفاخرية، حي عليشة، حي الصناعية، حي الخالدية، حي الدار البيضاء، حي الدفاع)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري في مختلف مناطق المملكة خلال الفترات القادمة</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\"><a href=\\\"https://rer.sa/rer-services-ar/\\\">https://rer.sa/rer-services-ar/</a> </span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أو عن طريق مراكز الخدمة، مبيَّنة أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل</span><span>.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتدعو الهيئة ملاَّك العقارات في المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة او عن طريق الاتصال على مركز خدمة العملاء 199002</span><span>.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 11 حي بمدينة الرياض ابتداءً من 22 محرم”"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5a8194af-66b6-3625-989b-7f2ed7e9bc5b","Alias":"هيئة العقار: ملتقى الوساطة العقارية يجمع الخبراء والممارسين","Path":"/002970c6-47a8-4a3c-86c7-84b7dc3585da.config","Level":4270,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/002970c6-47a8-4a3c-86c7-84b7dc3585da.config","Node":{"Content":{"@Key":"002970c6-47a8-4a3c-86c7-84b7dc3585da","@Alias":"هيئة العقار: ملتقى الوساطة العقارية يجمع الخبراء والممارسين","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-15T12:58:45","NodeName":{"@Default":"هيئة العقار: ملتقى الوساطة العقارية يجمع الخبراء والممارسين"},"SortOrder":"270","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-15T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ad8424da-82c6-4279-8858-8009163f433a\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: center; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s3\\\" align=\\\"center\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; color: black;\\\" lang=\\\"AR-SA\\\">هيئة العقار:</span></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><strong><span style=\\\"font-size: 18.0pt; color: black;\\\" lang=\\\"AR-SA\\\">ملتقى</span></strong><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><span class=\\\"bumpedfont15\\\"><strong>الوساطة العقارية</strong></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><span class=\\\"bumpedfont15\\\"><strong>يجمع الخبراء والممارسين</strong></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\">تنظم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الهيئة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العامة للعقار</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"ملتقى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الوساطة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقارية\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والمعرض</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المصاحب&nbsp;له</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الأربعاء القادم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">17</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يوليو</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2024</span><span class=\\\"apple-converted-space\\\">&nbsp;في&nbsp;</span><span class=\\\"bumpedfont15\\\">مركز</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الرياض الدولي للمؤتمرات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والمعارض،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بمناسبة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مرور عام على نفاذ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">النظام،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بمشاركة نخبة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">من الخبراء في القطاع العقاري والمختصين في التقنيات العقارية للحديث عن</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الفرص و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مستقبل السوق العقاري.</span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\">وذكر</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">المتحدث الرسمي \\\"للهيئة \\\" أ.تيسير بن محمد المفرج &nbsp;\\\" أنّ نظام الوساطة العقارية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ساهم في استدامة الأصول العقارية،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وحفظ حقوق المتعاملين،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وقد أسهم في تعزيز</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">شفافية السوق العقاري، وأنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ملتقى الوساطة العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في نسخته الأولى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يأتي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في إطار الجهود المستمرة لتطوير</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خدمات النشاط والتعاملات فيه</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وبناء قطاع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">عقاري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">متين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">متقدم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الاستراتيجية الشاملة للقطاع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حيث</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">سيتضمن \\\" الملتقى “عدد</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">من الجلسات الحوارية التي تناقش</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التأثير والفرص والتحديات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وأثر المنصات العقارية على مستقبل السوق العقاري، بالإضافة إلى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">تسليط الضوء على المنصات العقارية ذات التجارب الناجحة في نشاط الوساطة العقارية،</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأشار \\\"المفرج\\\"</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">إلى أنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الملتقى \\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">سيصاحبه معرض للتعريف بالأنشطة&nbsp;العقارية وأقسام خاصة لخدمة المستفيدين من منصة الوساطة العقارية وخدمات المعهد العقاري وكذلك قسم لاستقبال الأسئلة والاستفسارات وخدمة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الشركاء،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بما يعزز إيصال رسائل القطاع العقاري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والتعريف بالأنظمة والتشريعات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقارية التي تأتي وفي&nbsp;التوجهات والاستراتيجيات التي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تعمل عليها الهيئة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بمبدأ الشفافية&nbsp;وزيادة مشاركة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المجتمع،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لتحقيق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تنمية واستدامة القطاع.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">يذكر أنّ \\\" نظام الوساطة العقارية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">“دخل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حيز النفاذ في 25 جمادى الأولى 1444هـ الموافق 18 يناير 2023</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ويهدف إلى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تنظيم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الوساطةوالخدمات العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، ودعم أنشطة الوسطاء العقاريين والمستفيدين، إضافةً إلى المساهمة في استدامة الأصول العقارية.</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وأن \\\" ملتقى الوساطة العقارية \\\" موجه</span><span class=\\\"apple-converted-space\\\">&nbsp;للعموم</span><span class=\\\"bumpedfont15\\\">&nbsp;والمهتمين وأصحاب الاختصاص</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بالمجال</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقاري ومزاولي أنشطة الوساطة العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وتقديم الاستشارات والتحليلات العقارية، للاستفادة&nbsp;من موضوعات الجلسات الحوارية والمعرض المصاحب&nbsp;له، مما يعزز رفع الوعي في التعاملات العقارية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار: ملتقى الوساطة العقارية يجمع الخبراء والممارسين "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e0ea689f-1944-3eb3-8703-9a6cd13a787e","Alias":"هيئة العقار\" تختتم أعمال ملتقى الوساطة العقارية","Path":"/25edd0c9-aaac-43fa-82b1-2af34134eda8.config","Level":4272,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/25edd0c9-aaac-43fa-82b1-2af34134eda8.config","Node":{"Content":{"@Key":"25edd0c9-aaac-43fa-82b1-2af34134eda8","@Alias":"هيئة العقار\" تختتم أعمال ملتقى الوساطة العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-18T12:17:40","NodeName":{"@Default":"هيئة العقار\" تختتم أعمال ملتقى الوساطة العقارية"},"SortOrder":"272","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-18T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"3269c782-6a45-43c8-9502-941cfeddc67e\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p>الرياض 12 محرم 1446 هـ الموافق 18 يوليو 2024 م واس<br>اختتمت الهيئة العامة للعقار أعمال \\\"ملتقى الوساطة العقارية\\\" الذي نظمته بمركز الرياض للمؤتمرات والمعارض في العاصمة الرياض أمس، بحضور الرئيس التنفيذي للهيئة المهندس عبدالله بن سعود الحمّاد.<br>واستعرض الملتقى التحديثات التي مر بها نظام الوساطة العقارية خلال عام منذ بدء تطبيقه، إضافة إلى مناقشة الفرص ومكامن التطوير في السوق العقاري، بمشاركة نخبة من الخبراء في القطاع العقاري والمتخصصين بالتقنيات العقارية الرقمية الحديثة.<br>واستعرض المتحدثون بالجلسة الحوارية الأولى التأثير والفرص والتحديات في نظام الوساطة العقارية وأن المنافسة والتحدي في السوق العقاري أصبح أكبر للوسطاء العقاريين بعد تطبيق نظام الوساطة، مشيرين إلى أن الاستمرارية فيه ستكون للوسيط العقاري المؤهل الذي يتمتع بالمهارة والاحترافية.<br>وأكدوا دور المعهد العقاري السعودي من خلال دوراته التدريبية التي أسهمت في تأهيل وتمكين العاملين بالقطاع باحترافية ومهنية عالية، مضيفين أن المرأة بعد تنظيم النشاط نجحت وأثبتت وجودها في المجال ووصلت نجاحاتها إلى مجال الاستثمار العقاري، وأن القطاع العقاري السعودي يعيش لحظات استثنائية تمثل حجم الفرص ومستقبل القطاع.<br>كما تطرق المتحدثون بالجلسة الحوارية الثانية إلى أهمية \\\"المنصات العقارية التي تمثل مستقبل السوق العقاري\\\" وما يشكله الواقع المعزز من مستقبل للتسويق العقاري عبر المنصات العقارية وما يوفره من تجارب واقعية للباحثين عن العقارات، إضافة إلى دور الهيئة العامة للعقار الذي يركز على المؤشرات العالمية التي تخدم التحول الرقمي للسوق العقاري في المملكة ومساهمتها في تحقيق نسبة وصول عالية في النضج الإلكتروني على المستوى المحلي والإقليمي، إلى جانب النقلة النوعية التي أحدثتها الهيئة في التعاملات العقارية الإلكترونية التي انعكست على زيادة السرعة والدقة والجودة والكفاءة.<br>يُذكر أنّ \\\"الهيئة\\\" تهدف من خلال تنظيم \\\"ملتقى الوساطة العقارية\\\" إلى استعراض الجهود المستمرة لتطوير نشاط الوساطة العقارية، وبناء قطاع متين متقدم يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات الإستراتيجية الشاملة للقطاع العقاري، إضافة إلى التعريف بدور التقنيات العقارية التي تسهم في تقديم خدمات عقارية نوعية من أجل تحقيق مستقبل عقاري أكثر تطورًا.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\" تختتم أعمال ملتقى الوساطة العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"f652220d-9fc6-3391-8c90-e820eac14551","Alias":"رئيس هيئة العقار: 605 مليارات قيمة الصفقات العقارية خلال عام من تطبيق نظام الوساطة العقارية","Path":"/7df9227f-28e6-4de5-bf78-074cd0a4bbd9.config","Level":4273,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/7df9227f-28e6-4de5-bf78-074cd0a4bbd9.config","Node":{"Content":{"@Key":"7df9227f-28e6-4de5-bf78-074cd0a4bbd9","@Alias":"رئيس هيئة العقار: 605 مليارات قيمة الصفقات العقارية خلال عام من تطبيق نظام الوساطة العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-18T12:20:52","NodeName":{"@Default":"رئيس هيئة العقار: 605 مليارات قيمة الصفقات العقارية خلال عام من تطبيق نظام الوساطة العقارية"},"SortOrder":"273","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-18T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ed770078-2877-4541-adf6-de1b7035a0e1\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: center; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\" align=\\\"center\\\"><span class=\\\"bumpedfont15\\\"><strong>رئيس هيئة العقار:</strong></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><span class=\\\"bumpedfont15\\\"><strong>605</strong></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><span class=\\\"bumpedfont15\\\"><strong>مليارات</strong></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">قيمة الصفقات العقارية خلال عام من تطبيق نظام الوساطة العقارية</span></span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: center; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\" align=\\\"center\\\">&nbsp;</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أبرز الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد، المؤشرات الإيجابية التي وصل إليها نظام الوساطة العقارية من تنظيمٍ وحوكمةٍ خلال عام من بدء تطبيقه، كانت نتاج الدعم غير المحدود الذي أولته القيادة الرشيدة - أيدها الله- للقطاع العقاري من خلال منظومة التشريعات التي مكنته وجعلت منه قطاعًا حيويًا يتسم بالنمو والتطور.</span></p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكر المهندس عبدالله الحماد في كلمته خلال افتتاح \\\"ملتقى الوساطة العقارية\\\" أن تشريع الوساطة العقارية والخدمات العقارية&nbsp; أتاح فرصًا واسعة للتطوير والابتكار وله دور محوري في المنظومة الاقتصادية والتعاملات العقارية، كون أنه يمثل إطار قانوني واضح يضمن حقوق جميع الأطراف، ويسهم في تعزيز الثقة بين المستثمرين وملاك العقارات والوسطاء العقاريين ومقدمي الخدمات العقارية والعملاء، حيث ساهم في رفع كفاءة الوسطاء العقاريين، من خلال تنظيم ممارساتهم وتحديد مسؤولياتهم ، وأن النظام قد حقق نمو يقدر بـ17 % في عدد الصفقات العقارية السكنية والتجارية خلال عام واحد فقط من إطلاقه مقارنة بفترة مماثلة سبقته، حيث بلغت عدد الصفقات خلال عام من الوساطة العقارية&nbsp;قرابة&nbsp; 3.5 مليون صفقة عقارية منها 2.9 مليون صفقة سكنية بزيادة 18% و 604 آلاف صفقة تجارية بزيادة 11 %&nbsp; ، و بقيمة اجمالية بلغت أكثر من&nbsp;605 مليارات ريال سعودي&nbsp; منها 305 مليارات للصفقات السكنية و&nbsp; 300 مليار للصفقات التجارية ، و تعكس هذه حجم التعاملات العقارية التي نظمها وقننها&nbsp; نظام الوساطة العقارية&nbsp; .</span></p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-size: 14.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار إلى أنّ “الهيئة \\\" وثقت قرابة 219 ألف عقد وساطة عقارية، وأصدرت 35.255 ألف رخص لوسيط عقاري من الأفراد و19.735 ألف رخصة وساطة للمنشآت العقارية، بالإضافة إلى أنها قامت بترخيص 52 منصة عقارية، ساهم ترخيصها وفق نظام الوساطة في إزالة أكثر من نصف مليون إعلان غير موثوق، حيث تحتوي هذه المنصات على 269 ألف إعلان عقاري مرخص، وأنّ قيمة العمولات للوسطاء العقاريين من العمليات الموثقة قد بلغت 355 مليون ريال سعودي، بالإضافة إلى أن \\\"الهيئة \\\" من خلال نظام الوساطة العقارية تعمل عبر 4 مسارات رقابية منها الحملات المشتركة مع الجهات ذات العلاقة والرقابة الميدانية لفرق الهيئة ، ومسار المسح الإلكتروني واستقبال البلاغات ، حيث نفذت فرق الرقابة </span><span>58</span><span> حملة رقابية مشتركة خلال عام منذ تطبيق النظام، وفي الرقابة الميدانية لفرق الهيئة تم الوقوف على أكثر من 34 ألف إعلان عقاري في الأماكن العامة والتأكد من نظاميتها ومعالجتها، وفي مسار الرقابة الإلكترونية تم تنفيذ أكثر من 67 ألف عملية مسح ومعالجة إلكترونية ، واستقبال ومعالجة 9100 بلاغ .</span></p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-size: 14.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكر المهندس الحماد أن هذه النسخة من \\\"الملتقى\\\" تأتي في إطار الجهود المستمرة لتطوير خدمات نشاط الوساطة العقارية والتعاملات فيه، وبناء قطاع عقاري متين متقدم يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات الاستراتيجية الشاملة للقطاع العقاري، من خلال مناقشة التأثير والفرص والتحديات وأثر المنصات العقارية على مستقبل السوق العقاري.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار: 605 مليارات قيمة الصفقات العقارية خلال عام من تطبيق نظام الوساطة العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"91ef30a8-0765-3393-b7dc-542e8689ea7e","Alias":"هيئة العقار: الالتزام بتوثيق العقود العقارية يحفظ الحقوق ويعزز الشفافية","Path":"/61faf297-e5f9-46eb-90ef-a67b45b1a5ac.config","Level":4274,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/61faf297-e5f9-46eb-90ef-a67b45b1a5ac.config","Node":{"Content":{"@Key":"61faf297-e5f9-46eb-90ef-a67b45b1a5ac","@Alias":"هيئة العقار: الالتزام بتوثيق العقود العقارية يحفظ الحقوق ويعزز الشفافية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-21T16:18:27","NodeName":{"@Default":"هيئة العقار: الالتزام بتوثيق العقود العقارية يحفظ الحقوق ويعزز الشفافية"},"SortOrder":"274","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-21T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"e55660c9-775c-4d23-8461-c41041eb29ef\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; mso-line-height-alt: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 18.0pt; color: black;\\\" lang=\\\"AR-SA\\\">هيئة العقار: الالتزام بتوثيق العقود العقارية يحفظ الحقوق ويعزز الشفافية</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; color: black;\\\" lang=\\\"AR-SA\\\">أكدت الهيئة العامة للعقار على أهمية الالتزام بتوثيق العقود العقارية في كافة التعاملات المتعلقة بالقطاع العقاري، مشيرة إلى أن التعاملات العقارية الموثوقة تُسهم بصورة فعّالة في حفظ حقوق جميع المتعاملين وتحد من النزاعات العقارية، وترفع من جودة التعاملات بما يحقق نمو واستدامة القطاع.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; color: black;\\\" lang=\\\"AR-SA\\\">وأشارت \\\"الهيئة\\\" أنها تتيح من خلال منصاتها الرقمية المعتمدة خدمة التوثيق العقاري للأفراد والمنشآت، سعيًا لتنظيم التعاملات في السوق العقاري، وحماية المستفيدين ورفع الثقة في السوق وتحفيز النشاط العقاري، كما تعمل على رفع الوعي العقاري لدى المتعاملين العقاريين، والتعريف بالخدمات والأنظمة والتشريعات العقارية من خلال مبادراتها العقارية وتنظيمها للملتقيات العقارية ومشاركتها في المؤتمرات والمعارض ذات العلاقة بالقطاع، مما يسهم في تحقيق الشفافية والموثوقية.&nbsp;</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; color: black;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الهيئة العامة للعقار تهدف من خلال جهودها المستمرة إلى تنظيم الأنشطة العقارية كافة، من خلال تقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، تسهم في رفع جودة التعاملات العقارية، وخدمة المتعاملين في القطاع بما ينسجم مع تطلعات الاستراتيجية الشاملة للقطاع العقاري ومستهدفات رؤية السعودية 2030.&nbsp;</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار: الالتزام بتوثيق العقود العقارية يحفظ الحقوق ويعزز الشفافية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"cc504586-f73b-3472-94cf-d481ffd61ecf","Alias":"\"هيئة العقار\" تُنفذ 11 جولة رقابية مشتركة خلال شهر يوليو لضمان الامتثال في السوق العقاري","Path":"/b7d71879-9f15-4b92-af82-749fcda979d4.config","Level":4275,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b7d71879-9f15-4b92-af82-749fcda979d4.config","Node":{"Content":{"@Key":"b7d71879-9f15-4b92-af82-749fcda979d4","@Alias":"\"هيئة العقار\" تُنفذ 11 جولة رقابية مشتركة خلال شهر يوليو لضمان الامتثال في السوق العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-07-31T10:29:26","NodeName":{"@Default":"\"هيئة العقار\" تُنفذ 11 جولة رقابية مشتركة خلال شهر يوليو لضمان الامتثال في السوق العقاري"},"SortOrder":"275","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-07-31T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"456a60a1-703d-4bac-9e8a-92622f84d641\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">نفذت&nbsp;الهيئة العامة للعقار&nbsp;بمشاركة&nbsp;وزارة الموارد البشرية والتنمية الاجتماعية خلال شهر يوليو، 11 جولة&nbsp;رقابية مشتركة شملتْ زيارة&nbsp;173 منشأة عقارية في كل من&nbsp;منطقة الرياض والمنطقة&nbsp;الشرقية ومنطقة مكة المكرمة، بهدف&nbsp;ضمان&nbsp;الامتثال&nbsp;للتشريعات العقارية بشكل عام&nbsp;ونظام الوساطة العقارية&nbsp;على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين وتراخيص&nbsp;المُنشآت.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 10%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليه&nbsp;لتنظيم السوق&nbsp;العقاري، حيث&nbsp;قامت فرقها الرقابية خلال الفترة&nbsp;ذاتها&nbsp;بزيارة 21،194&nbsp;منشأة&nbsp;وموقع&nbsp;عقاري مختلف،&nbsp;نتج عنها رصد 11،367 إعلان عقاري مخالف بالأماكن العامة، كما تلقت الهيئة&nbsp;603&nbsp;بلاغات عقارية عبر قنواتها المختلفة تم التعامل معها ومعاجلتها،&nbsp;فيما&nbsp;بلغ عدد الإعلانات العقارية التي تم مسحها للتحقق من امتثالها للنظام عبر المسار الإلكتروني أكثر من&nbsp;26،887&nbsp;إعلانًا عقاريًا، حيث&nbsp;تنتهج&nbsp;الهيئة&nbsp;الرقابة الإلكترونية&nbsp;التي&nbsp;تستهدف&nbsp;القنوات&nbsp;الرقمية&nbsp;والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة&nbsp;العقارية&nbsp;الرقمية&nbsp;وفق الأنظمة واللوائح.&nbsp;</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغاءه أو الغرامات المالية،&nbsp; وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها، كما دعت الهيئة المواطنين والمقيمين إلى تقديم بلاغاتهم في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم&nbsp;( 199011 ) للاستفسارات العقارية .</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تُنفذ 11 جولة رقابية مشتركة خلال شهر يوليو لضمان الامتثال في السوق العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8f26bf7e-8914-3d93-a31d-5cfbbf794162","Alias":"\"هيئة العقار\" تطرح جدول مخالفات نظام \"بيع وتأجير مشروعات عقارية على الخارطة \" لاستطلاع العموم","Path":"/ad2f214c-58bb-4469-a3ff-f828d4a6270d.config","Level":4276,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ad2f214c-58bb-4469-a3ff-f828d4a6270d.config","Node":{"Content":{"@Key":"ad2f214c-58bb-4469-a3ff-f828d4a6270d","@Alias":"\"هيئة العقار\" تطرح جدول مخالفات نظام \"بيع وتأجير مشروعات عقارية على الخارطة \" لاستطلاع العموم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-11T09:07:58","NodeName":{"@Default":"\"هيئة العقار\" تطرح جدول مخالفات نظام \"بيع وتأجير مشروعات عقارية على الخارطة \" لاستطلاع العموم"},"SortOrder":"276","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-11T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2f394ae7-4ae2-4ee0-b2b2-ad6ba3a7e2ae\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s3\\\"><span class=\\\"bumpedfont15\\\"><span>\\\"هيئة العقار\\\" تطرح</span></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><span class=\\\"bumpedfont15\\\"><strong>جدول مخالفات نظام \\\"بيع وتأجير مشروعات عقارية على الخارطة</strong></span><span class=\\\"apple-converted-space\\\"><strong>&nbsp;</strong></span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">\\\" لاستطلاع العموم</span></span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; -webkit-tap-highlight-color: rgba(26, 26, 26, 0.3); -webkit-text-stroke-width: 0px; caret-color: rgb(0, 0, 0); -webkit-text-size-adjust: none; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"s3\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; -webkit-tap-highlight-color: rgba(26, 26, 26, 0.3); -webkit-text-stroke-width: 0px; caret-color: rgb(0, 0, 0); -webkit-text-size-adjust: none; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"s3\\\"><span class=\\\"bumpedfont15\\\">طرحت الهيئة العامة للعقار</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">جدول المخالفات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">لنظام بيع وتأجير مشروعات عقارية على الخارطة، عبر منصة \\\"استطلاع\\\"، بهدف تمكين العموم والجهات الحكومية والقطاع الخاص من إبداء مرئياتهم وملاحظاتهم عليها قبل إقرارها،</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذلك إلى غاية 23 أغسطس 2024م.</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; -webkit-tap-highlight-color: rgba(26, 26, 26, 0.3); -webkit-text-stroke-width: 0px; caret-color: rgb(0, 0, 0); -webkit-text-size-adjust: none; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"s3\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"><br>وأوضحت \\\"الهيئة \\\" أنّ&nbsp;<span class=\\\"bumpedfont15\\\">جدول المخالفات</span>&nbsp;لنظام بيع وتأجير مشروعات عقارية على الخارطة&nbsp;يتضمن&nbsp;عقوبات&nbsp;<span class=\\\"bumpedfont15\\\">لـ (ست وعشرون)</span>&nbsp;<span class=\\\"bumpedfont15\\\">مخالفة، تصل إلى غرامة مالية بنصف مليون ريال سعودي، وشطب سجل المطور العقاري من سجل قيد المطورين وإلغاء اعتمادات المخالف والمنع من ممارسة النشاط لفترة محددة،</span>&nbsp;وأن \\\"الجدول\\\"&nbsp;يوضح&nbsp;<span class=\\\"bumpedfont15\\\">آلية التعامل مع المخالفات التي</span>&nbsp;تشمل&nbsp;<span class=\\\"bumpedfont15\\\">التأخر في البدء بتنفيذ المشروع عن الموعد المقرر أو تعثر المطور أو اشهار إفلاسه أو إبرام عقود مغايرة للعقد النموذجي المعد من</span>&nbsp;الهيئة مع&nbsp;<span class=\\\"bumpedfont15\\\">أطراف العلاقة التعاقدية أو تقديم أية معلومات مضللة أو استلام مبالغ من المشترين دون موافقة</span>&nbsp;مسبقة،&nbsp;<span class=\\\"bumpedfont15\\\">أو إعاقة وتعطيل أداء أطراف العلاقة لواجباتهم مما يؤثر على سير أعمال</span>&nbsp;المشروع،&nbsp;<span class=\\\"bumpedfont15\\\">أو الامتناع عن تنفيذ الإجراءات الواجب القيام بها لإنجاز المشروع أو الوفاء بحقوق المشترين</span>&nbsp;وغيرها.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; -webkit-tap-highlight-color: rgba(26, 26, 26, 0.3); -webkit-text-stroke-width: 0px; caret-color: rgb(0, 0, 0); -webkit-text-size-adjust: none; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"s3\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; -webkit-tap-highlight-color: rgba(26, 26, 26, 0.3); -webkit-text-stroke-width: 0px; caret-color: rgb(0, 0, 0); -webkit-text-size-adjust: none; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"s3\\\"><span class=\\\"bumpedfont15\\\">وأشارت</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"الهيئة\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">إلى أنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">جدول المخالفات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">لنظام بيع وتأجير مشروعات عقارية على</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الخارطة،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يهدف إلى تنظيم نشاط البيع</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">والتأجير على</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الخارطة، ورفع مستوى الشفافية والإفصاح بما يضمن حماية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">حقوق جميع أطراف العلاقة التعاقدية، كما يهدف من خلال تطبيقه إلى حوكمة أعمال الرقابة والامتثال</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">بجميع إجراءات</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">واشتراطات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">التراخيص الخاصة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ببيع وتأجير وحدات عقارية على الخارطة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ومراحل سير إنشاءها حتى</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">إنهائها، ودعت</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الهيئة المهتمين من العموم والجهات الحكومية والقطاع الخاص كافة إلى الاطلاع على</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الجدول</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">في منصة استطلاع من خلال الرابط الاتي</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">:</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; -webkit-tap-highlight-color: rgba(26, 26, 26, 0.3); -webkit-text-stroke-width: 0px; caret-color: rgb(0, 0, 0); -webkit-text-size-adjust: none; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"s10\\\"><span style=\\\"font-size: 13.5pt;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/ClassificationTable/Pages/default.aspx\\\"><span style=\\\"color: blue;\\\" lang=\\\"EN-US\\\">https://istitlaa.ncc.gov.sa/ar/Municipality/rega/ClassificationTable/Pages/default.aspx</span></a></span><span class=\\\"apple-converted-space\\\"><span>&nbsp;وتقديم</span></span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;الملاحظات والمقترحات بشأنه.</span></span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; -webkit-tap-highlight-color: rgba(26, 26, 26, 0.3); -webkit-text-stroke-width: 0px; caret-color: rgb(0, 0, 0); -webkit-text-size-adjust: none; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"s10\\\">&nbsp;</p>\\n<p><span class=\\\"bumpedfont15\\\">كما أكدت الهيئة حرصها على أنْ يسهم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">جدول المخالفات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لنظام بيع وتأجير مشروعات عقارية على الخارطة في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">القضاء على</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\\\" lang=\\\"AR-SA\\\">المخالفات في قطاع التطوير العقاري بنظام البيع والتأجير على</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\\\" lang=\\\"AR-SA\\\">الخارطة، ويحقق سعي الهيئة في تنظيم التعاملات والوفاء بالالتزامات</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وحفظ حقوق جميع الأطراف وإنجاز المشاريع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وفق المدد الزمنية بحسب دراسة الجدوى لكل مشروع،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\\\" lang=\\\"AR-SA\\\">بما يسهم في زيادة الموثوقية والشفافية والوضوح بالسوق العقاري السعودي. &nbsp;</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\" تطرح جدول مخالفات نظام \"بيع وتأجير مشروعات عقارية على الخارطة \" لاستطلاع العموم\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"efb835e3-0e78-3179-9bc6-022a3085f5cb","Alias":"\"السجل العقاري\" يصدر أكثر 250 ألف صك تسجيل ملكية جديد مُنذ إطلاق التسجيل العيني للعقار","Path":"/fc4ba937-2afe-4d98-a81f-e873550d6570.config","Level":4277,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/fc4ba937-2afe-4d98-a81f-e873550d6570.config","Node":{"Content":{"@Key":"fc4ba937-2afe-4d98-a81f-e873550d6570","@Alias":"\"السجل العقاري\" يصدر أكثر 250 ألف صك تسجيل ملكية جديد مُنذ إطلاق التسجيل العيني للعقار","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-12T18:24:02","NodeName":{"@Default":"\"السجل العقاري\" يصدر أكثر 250 ألف صك تسجيل ملكية جديد مُنذ إطلاق التسجيل العيني للعقار"},"SortOrder":"277","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":"أعلنت الهيئة العامة للعقار عن إصدار أكثر من 250 ألف صك ملكية جديد عبر منصة \"السجل العقاري\" منذ بدء التسجيل العيني للعقار في مايو 2023. يشمل ذلك مناطق في الرياض، مكة المكرمة، الدمام، المدينة المنورة، وبريدة. وأكدت الهيئة أن نجاح العملية يعود إلى استخدام تقنيات حديثة مثل الطائرات المسيرة، والذكاء الاصطناعي، وتقنيات الاستشعار عن بعد. كما أشارت إلى أن هذه الجهود تساهم في تسريع التحول الرقمي في القطاع العقاري وتوفير مصدر موحد للمعلومات العقارية، تماشياً مع رؤية المملكة 2030.\n\n\n"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-12T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">أعلنت الهيئة العامة للعقار عن إصدار أكثر من 250 ألف صك تسجيل ملكية جديد في منصة السجل العقاري مُنذ بداية أعمال التسجيل العيني للعقار في مايو 2023، وذلك في المناطق التي أعلنتها \\\"الهيئة\\\" كمناطق مستفيدة من \\\"التسجيل العيني\\\" في كل من الرياض، ومكة المكرمة، والدمام، والمدينة المنورة، وبريدة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأوضح الرئيس التنفيذي للهيئة العامة للعقار المهندس عبدالله بن سعود الحماد أنّ \\\"الهيئة\\\" مُنذ انطلاق أعمال التسجيل العيني للعقار في حي الفلاح كأول منطقة عقارية سجلت نجاح يعود إلى جودة البيانات الجيومكانية التي تم العمل عليها باستخدام التقنيات الحديثة والطائرات المأهولة والطائرات بدون طيار و التي تتميّز بالدقة والكفاءة العالية، وواصلت إعلان المناطق العقارية المستفيدة من \\\"التسجيل العيني\\\" وفقا لمعايير محددة، في مقدمتها جهوزية ونضج البيانات المتوفرة للوحدات العقارية فيها.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأشار الحماد إلى أنّ \\\"السجل العقاري \\\" وباستخدام تقنيات الاستشعار عن بعد، والذكاء الاصطناعي، وتحديد المواقع باستخدام الأقمار الصناعية لنظام التموضع العالمي<span> (GPS)</span><span>، وبسرعة معالجة بيانات صكوك العقارات في الأحياء المستفيدة، والتكامل بين الجهات الحكومية والخاصة ذات العلاقة ووعي ملاّك العقارات ، أسهم في سرعة إنجاز إصدار أرقام العقارات و السجلات العقارية ، الأمر الذي يؤكد الاستمرارية بخطوات جادة لتنمية القطاع العقاري من خلال رقمنة الإجراءات وتوفير مصدر موحد للمعلومات والبيانات العقارية، من خلال منصة \\\"السجل العقاري\\\" التي تتضمن جميع المعلومات الرئيسية عن العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات .</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">بدوره أوضح الرئيس التنفيذي للشركة الوطنية لخدمات التسجيل العيني الدكتور محمد بن حمد السليمان أنّ \\\"الشركة\\\" تتولى تنفيذ الأعمال التشغيلية للتسجيل العيني للعقار بشكل حصري في المملكة ، وأنها عملت مُنذ انطلاقها على تطوير منصة \\\"السجل العقاري\\\" وفقًا لأفضل الممارسات والمعايير العالمية المتبعة في بناء السجلات العقارية، كما عملت على توظيف أحدث التقنيات للنهوض بالقطاع العقاري وتسريع عمليات التحول الرقمي في القطاع، وتسهيل رحلة المستفيدين من خلال عدد من الخدمات المتنوعة في مقدمتها تنفيذ التصرفات العقارية وعمليات نقل الملكية عبر المنصة بالكامل، بالإضافة إلى خدمات التحقق من صك الملكية، وخدمة البحث عن العقار، وخدمات الفرز والدمج والتجزئة، والاطلاع على قوائم الملاك والبحث عن العقارات.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">يُذكر أنّ الهيئة العامة للعقار تعمل من خلال السجل العقاري في رفع كفاءة القطاع العقاري والنهـوض بمسـتويات الموثوقية والشفافية وتسهيل الوصول إلى معلومات الملكيات العقارية، ورفع جاذبيته الاستثمارية محليًا وإقليميًا وعالميًا، وفقًا لمستهدفات رؤية المملكة 2030</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"السجل العقاري\" يصدر أكثر 250 ألف صك تسجيل ملكية جديد مُنذ إطلاق التسجيل العيني للعقار"}},"pageName":{"Value":{"#cdata-section":"\"السجل العقاري\" يصدر أكثر 250 ألف صك تسجيل ملكية جديد مُنذ إطلاق التسجيل العيني للعقار"}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":"{\n  \"markup\": \"<div class=\\\"flex max-w-full flex-col flex-grow\\\">\\n<div class=\\\"min-h-[20px] text-message flex w-full flex-col items-end gap-2 whitespace-pre-wrap break-words [.text-message+&amp;]:mt-5 overflow-x-auto\\\" data-message-author-role=\\\"assistant\\\" data-message-id=\\\"234fd0c2-e41f-498c-857f-8c2b9f96b78d\\\">\\n<div class=\\\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\\\">\\n<div class=\\\"markdown prose w-full break-words dark:prose-invert dark\\\">\\n<p>أعلنت الهيئة العامة للعقار عن إصدار أكثر من 250 ألف صك ملكية جديد عبر منصة \\\"السجل العقاري\\\" منذ بدء التسجيل العيني للعقار في مايو 2023. يشمل ذلك مناطق في الرياض، مكة المكرمة، الدمام، المدينة المنورة، وبريدة. وأكدت الهيئة أن نجاح العملية يعود إلى استخدام تقنيات حديثة مثل الطائرات المسيرة، والذكاء الاصطناعي، وتقنيات الاستشعار عن بعد. كما أشارت إلى أن هذه الجهود تساهم في تسريع التحول الرقمي في القطاع العقاري وتوفير مصدر موحد للمعلومات العقارية، تماشياً مع رؤية المملكة 2030.</p>\\n</div>\\n</div>\\n</div>\\n</div>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b7c4c1f7-23f8-31f6-ba1a-891a1f1e5c75","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 10 أحياء بمدينة الرياض ابتداءً من 28 صفر","Path":"/ca0efa11-294d-4fe0-a951-0f699cee01fb.config","Level":4278,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ca0efa11-294d-4fe0-a951-0f699cee01fb.config","Node":{"Content":{"@Key":"ca0efa11-294d-4fe0-a951-0f699cee01fb","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 10 أحياء بمدينة الرياض ابتداءً من 28 صفر","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-15T08:52:39","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل في 10 أحياء بمدينة الرياض ابتداءً من 28 صفر"},"SortOrder":"278","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-14T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ca240315-7b2b-4f63-815d-19ffc212f104\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin-bottom: 8.0pt; text-align: center; line-height: 105%;\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 20.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الهيئة العامة للعقار: تُعلن عن بدء التسجيل في 10 أحياء بمدينة الرياض ابتداءً من 28 صفر</span></p>\\n<p style=\\\"margin-bottom: 8.0pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن بدء التسجيل لـ (57,566 قطعة عقارية) في 10 أحياء بمدينة الرياض ابتداءً من 1 سبتمبر 2024م، الموافق 28 صفر 1446هـ، وحتى نهاية يوم 5 ديسمبر 2024م الموافق 4 جمادى الآخرة 1446هـ</span><span>.</span></p>\\n<p style=\\\"margin-bottom: 8.0pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة بأنَّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية: (المعذر الشمالي، حي المربع، حي الملز، حي العليا، حي النموذجية، حي الزهراء، حي الناصرية، حي المؤتمرات، حي الضباط، ضاحية نمار)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري في مختلف مناطق المملكة خلال الفترات القادمة</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"margin-bottom: 8.0pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية</span><span> </span><span><a href=\\\"https://rer.sa/rer-services-ar/\\\">https://rer.sa/rer-services-ar/</a></span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\"> </span>أو عن طريق مراكز الخدمة<span> </span><span>، <u>مبيَّنة </u>أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل</span><span>.</span></p>\\n<p style=\\\"margin-bottom: 8.0pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاَّك العقارات في المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل</span>،<span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"margin-bottom: 8.0pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري</span><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\">.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: تُعلن عن بدء التسجيل في 10 أحياء بمدينة الرياض ابتداءً من 28 صفر"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"eed31363-260b-30a6-9a39-46318727012d","Alias":"\"هيئة العقار\" تُعلن عن بدء التسجيل العيني في 11 حي بمنطقة القصيم ابتداءً من 26 ربيع الأول","Path":"/4c13863e-a2ec-47eb-b44f-a0e1538c9771.config","Level":4279,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4c13863e-a2ec-47eb-b44f-a0e1538c9771.config","Node":{"Content":{"@Key":"4c13863e-a2ec-47eb-b44f-a0e1538c9771","@Alias":"\"هيئة العقار\" تُعلن عن بدء التسجيل العيني في 11 حي بمنطقة القصيم ابتداءً من 26 ربيع الأول","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-26T06:41:54","NodeName":{"@Default":"\"هيئة العقار\" تُعلن عن بدء التسجيل العيني في 11 حي بمنطقة القصيم ابتداءً من 26 ربيع الأول"},"SortOrder":"279","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-20T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">أعلنتْ الهيئة العامة للعقار عن بدء التسجيل العيني لـ (30.811 قطعة عقارية) في 11 حي بمنطقة القصيم ابتداءً من 29 سبتمبر 2024م، الموافق 26 ربيع الأول 1446هـ، وحتى نهاية يوم 2 يناير 2025م الموافق 2 رجب 1446هـ.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأوضحت الهيئة أنّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية: (حي النهضة، حي الروضة، حي الريان، حي الإسكان، حي الفلاح، حي النخيل، حي الزرقاء، حي المنار، حي الحمر الشمالي، حي الحمر الجنوبي، حي العليا)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأشارت&nbsp; \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية <a href=\\\"https://rer.sa/rer-services-ar/\\\">https://rer.sa/<span> /</span></a> أو عن طريق مراكز الخدمة ، مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تُعلن عن بدء التسجيل العيني في 11 حي بمنطقة القصيم ابتداءً من 26 ربيع الأول"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تُعلن عن بدء التسجيل العيني في 11 حي بمنطقة القصيم ابتداءً من 26 ربيع الأول"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a2cc1e1b-7950-3c79-b86b-4ac2adcc629b","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل العيني في حي طيبة بمدينة الرياض ابتداءً من 28 صفر","Path":"/cd5825ce-bb9e-45a3-bfc6-35ce6dde327f.config","Level":4280,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/cd5825ce-bb9e-45a3-bfc6-35ce6dde327f.config","Node":{"Content":{"@Key":"cd5825ce-bb9e-45a3-bfc6-35ce6dde327f","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل العيني في حي طيبة بمدينة الرياض ابتداءً من 28 صفر","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-26T06:42:41","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل العيني في حي طيبة بمدينة الرياض ابتداءً من 28 صفر"},"SortOrder":"280","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-20T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p>أعلنتْ الهيئة العامة للعقار عن بدء التسجيل العيني لـ (4,871 قطعة عقارية) في حي طيبة بمدينة الرياض ابتداءً من 1 سبتمبر 2024م، الموافق 28 صفر 1446هـ، وحتى نهاية يوم 5 ديسمبر 2024م الموافق 4 جمادى الآخرة 1446هـ، مبينةً بأنَّه تم اختيار الحي وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.<br>وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المنطقة سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية https://rer.sa/ &nbsp; أو عن طريق مراكز الخدمة ، مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.&nbsp;<br>وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل العيني في حي طيبة بمدينة الرياض ابتداءً من 28 صفر"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء التسجيل العيني في حي طيبة بمدينة الرياض ابتداءً من 28 صفر"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"831f50b6-43ad-3dd9-8aac-6299bb644e64","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 4 أحياء بالمدينة المنورة","Path":"/1e5448f7-1cf6-4437-beaa-345b8fbae16d.config","Level":4281,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1e5448f7-1cf6-4437-beaa-345b8fbae16d.config","Node":{"Content":{"@Key":"1e5448f7-1cf6-4437-beaa-345b8fbae16d","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 4 أحياء بالمدينة المنورة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-26T06:43:07","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 4 أحياء بالمدينة المنورة"},"SortOrder":"281","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-21T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">أعلنتْ الهيئة العامة للعقار عن بدء أعمال السجل العقاري لـ (9،695 قطعة عقارية) في 4 أحياء بالمدينة المنورة ابتداءً من 29 سبتمبر 2024م، الموافق 26 ربيع الأول 1446هـ، وحتى نهاية يوم 2 يناير 2025م الموافق 2 رجب 1446هـ.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأوضحت الهيئة أن الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية: (جزء من حي وادي الباطن، جزء من حي ضوضاء، جزء من حي وادي البطان، جزء من حي العاقول،)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأشارت&nbsp; \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية <a href=\\\"https://rer.sa/rer-services-ar/\\\">https://rer.sa/<span> /</span></a> أو عن طريق مراكز الخدمة ، مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 4 أحياء بالمدينة المنورة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 4 أحياء بالمدينة المنورة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"7ca4ee0e-5d69-3942-b73e-8f6411955104","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 18 حياً بمنطقة الرياض ابتداءً من 26 ربيع الأول","Path":"/3bd3f347-b5c5-42cd-ad93-26f72e1c1bdd.config","Level":4282,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3bd3f347-b5c5-42cd-ad93-26f72e1c1bdd.config","Node":{"Content":{"@Key":"3bd3f347-b5c5-42cd-ad93-26f72e1c1bdd","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 18 حياً بمنطقة الرياض ابتداءً من 26 ربيع الأول","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-26T06:43:32","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 18 حياً بمنطقة الرياض ابتداءً من 26 ربيع الأول"},"SortOrder":"282","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-24T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">أعلنتْ الهيئة العامة للعقار عن بدء أعمال التسجيل العيني للعقار لـ (198.842 قطعة عقارية) في 18 حياً بمنطقة الرياض ابتداءً من 29 سبتمبر 2024م، الموافق 26 ربيع الأول 1446هـ، وحتى نهاية يوم 2 يناير 2025م الموافق 2 رجب 1446هـ.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأوضحت الهيئة أن الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية: (حي السعادة، حي الفيحاء، حي السلي، حي الجزيرة، حي النور، حي العزيزية، حي المصانع، حي المنصورة (خنشليلة)، حي الرمال، <br>مطار الملك خالد الدولي، حي سدرة، حي البيان، حي الجنادرية، حي النظيم، حي الندوة، حي الرماية، حي الصفا، حي الفاروق)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأشارت&nbsp; \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحًا عن طريق<a href=\\\"https://rer.sa/#https://rer.sa/\\\" title=\\\"https://rer.sa/\\\" data-anchor=\\\"#https://rer.sa/\\\"> منصة السجل العقاري الإلكترونية </a>أو عن طريق مراكز الخدمة ، مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 18 حياً بمنطقة الرياض ابتداءً من 26 ربيع الأول"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري في 18 حياً بمنطقة الرياض ابتداءً من 26 ربيع الأول"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"afdc774d-b9aa-3777-9281-dd8db28050c6","Alias":"\"الهيئة العامة للعقار\" الخميس القادم تنتهي مدة تسجيل العقارات في السجل العقاري لــ (18) حياً بالرياض ومكة المكرمة","Path":"/821a154a-7a12-459c-8b99-1274d892893f.config","Level":4283,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/821a154a-7a12-459c-8b99-1274d892893f.config","Node":{"Content":{"@Key":"821a154a-7a12-459c-8b99-1274d892893f","@Alias":"\"الهيئة العامة للعقار\" الخميس القادم تنتهي مدة تسجيل العقارات في السجل العقاري لــ (18) حياً بالرياض ومكة المكرمة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-08-26T08:32:50","NodeName":{"@Default":"\"الهيئة العامة للعقار\" الخميس القادم تنتهي مدة تسجيل العقارات في السجل العقاري لــ (18) حياً بالرياض ومكة المكرمة"},"SortOrder":"283","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-08-26T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"3e70ec6c-7453-4b3f-8ace-a8052b6bee59\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: center; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 20.0pt; line-height: 150%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">\\\"الهيئة العامة للعقار\\\" الخميس القادم تنتهي مدة تسجيل العقارات في السجل العقاري لــ (18) حياً بالرياض ومكة المكرمة</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المهلة المحددة للتسجيل العيني الأول للعقار لـ (18) حياً في مدينتي الرياض ومكة المكرمة، وذلك بنهاية يوم الخميس القادم 25 صفر 1446هـ، الموافق 29 أغسطس 2024م.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وبينت \\\"الهيئة\\\" أنّ التسجيل العيني للعقار سينتهي في 10 أحياء بمدينة الرياض وهي: (حي المهدية، حي الخزامى، حي عرقة، حي ظهرة لبن، حي السفارات، حي نمار، حي المروة، حي شبرا، حي بدر، حي الشفا)، إضافةً إلى 8 أحياء بمدينة مكة المكرمة هي: (جزء من حي الصفوة، وجزء من حي دار السلام، وجزء من حي الهجرة، ومشروع ذاخر ويشمل حي الجميزة، وحي ريع اذاخر، ومشروع مسار مكة القسم الأول ويشمل جزء من حي النزهة، جزء من حي الرصيفة، ومشروع جبل عمر، ويشمل حي جرهم الشمالي).</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن نطاق الأحياء المذكورة إلى سرعة المبادرة بتسجيل عقاراتهم من خلال منصة السجل العقاري </span><span style=\\\"font-family: 'Arial',sans-serif;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://eservices.rer.sa\\\">rer.sa</a></span><span> قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ التسجيل العيني للعقار يتيح إصدار \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة له.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة في خدمات وبيانات العقارات</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار\" الخميس القادم تنتهي مدة تسجيل العقارات في السجل العقاري لــ (18) حياً بالرياض ومكة المكرمة\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5360557d-1289-34c2-b7dd-3654a65329e0","Alias":"\"الهيئة العامة للعقار\" تُنفذ 14 جولة رقابية مشتركة خلال شهر أغسطس لضمان الامتثال في السوق العقاري","Path":"/d73c4b23-a91c-4a9e-b14c-6accb8e40175.config","Level":4284,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/d73c4b23-a91c-4a9e-b14c-6accb8e40175.config","Node":{"Content":{"@Key":"d73c4b23-a91c-4a9e-b14c-6accb8e40175","@Alias":"\"الهيئة العامة للعقار\" تُنفذ 14 جولة رقابية مشتركة خلال شهر أغسطس لضمان الامتثال في السوق العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-01T13:24:44","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُنفذ 14 جولة رقابية مشتركة خلال شهر أغسطس لضمان الامتثال في السوق العقاري"},"SortOrder":"284","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-01T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"958d7f00-4fa8-40f9-9ef5-7d4d2dcc9d44\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">نفذت الهيئة العامة للعقار بمشاركة وزارة الموارد البشرية والتنمية الاجتماعية خلال شهر أغسطس، 14 جولة رقابية مشتركة شملتْ زيارة 180 منشأة عقارية في كل من منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة ومنطقة القصيم، بهدف ضمان الامتثال للتشريعات العقارية بشكل عام ونظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين وتراخيص المُنشآت.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليه لتنظيم السوق العقاري، حيث قامت فرقها الرقابية خلال الفترة ذاتها بتنفيذ 16،867 عملية رقابية ميدانية، نتج عنها رصد 9633 إعلاناً عقارياً مخالفاً بالأماكن العامة، كما تلقت الهيئة 907 بلاغاً عقارياً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها، فيما بلغ عدد عمليات المسح الإلكتروني أكثر من 21،322 عملية، حيث تنتهج الهيئة الرقابة الإلكترونية التي تستهدف القنوات الرقمية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة العقارية الرقمية وفق الأنظمة واللوائح.&nbsp;</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغاءه أو الغرامات المالية،&nbsp; وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها، كما دعت الهيئة المواطنين والمقيمين إلى تقديم بلاغاتهم في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم&nbsp;( 199011 ) للاستفسارات العقارية .</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُنفذ 14 جولة رقابية مشتركة خلال شهر أغسطس لضمان الامتثال في السوق العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8c261890-0451-3a61-8afa-351206ab44f5","Alias":"هيئة العقار\" تعقد القمة العالمية للبروبتك أكتوبر المقبل بمشاركة 80 دولة","Path":"/6a523155-b58f-4e47-b5a5-898dda07dc7b.config","Level":4285,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6a523155-b58f-4e47-b5a5-898dda07dc7b.config","Node":{"Content":{"@Key":"6a523155-b58f-4e47-b5a5-898dda07dc7b","@Alias":"هيئة العقار\" تعقد القمة العالمية للبروبتك أكتوبر المقبل بمشاركة 80 دولة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-05T12:48:31","NodeName":{"@Default":"هيئة العقار\" تعقد القمة العالمية للبروبتك أكتوبر المقبل بمشاركة 80 دولة"},"SortOrder":"285","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-05T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"62317223-bf52-4b7e-ae36-7796a04577d1\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">تعقد الهيئة العامة للعقار القمة العالمية للبروبتك</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\"> \\\" The Global Proptech Summit \\\" </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">بنسختها الأولى، في شهر أكتوبر المقبل في العاصمة الرياض برعاية معالي وزير البلديات والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبدالله الحقيل، بشراكة استراتيجية مع الشركة الوطنية للإسكان</span>NHC)<span>).</span></p>\\n<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">وتجمع القمة شخصيات بارزة وخبراء ومتخصصين في صناعة العقار والتقنيات العقارية و الصناديق الاستثمارية والجهات المالية ، إلى جانب الرؤساء التنفيذيين لكبرى شركات العقار والتقنية العقارية من مختلف أنحاء العالم، ويصاحب القمة معرض تقني عقاري بمشاركة شركات، ومنصات عقارية، وتقنية محلية ودولية، يستعرضون من خلاله الابتكارات التقنية العقارية والتجارب والرؤى المستقبلية للصناعة في ظل التقدم التكنولوجي السريع بما يعزز من تحقيق التوجهات الاستراتيجية للقطاع العقاري في المملكة وريادته تماشيًا مع رؤية السعودية 2030</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\">.</span></p>\\n<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">وستشهد القمة إقامة عدد من الجلسات وورش العمل واللقاءات، التي تناقش رحلة التحول التقني في المجال العقاري ودور التقنيات الناشئة في تشكيل مستقبل \\\"البروبتك\\\" وآخر ما توصلت إليه تقنية البناء الحديث ودور تقنيات الواقع الافتراضي والذكاء الاصطناعي وانترنت الأشياء في صناعة مستقبل العقار وأتمتة عملياته وخدماته، إضافة إلى الحديث عن حلول \\\"البروبتك \\\" في التنمية الحضرية واتخاذ القرارات الأكثر ذكاءً بما يسهم في تنمية الاستثمارات وتعزيز الاستدامة المالية، </span></p>\\n<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">كما ستستضيف القمة العالمية أبرز المنصات العقارية و الصناديق والجهات الاستثمارية ورواد الأعمال والخبراء والشركات الاستشارية والمعاهد التدريبية والمطورين وأكثر من 100متحدثٍ يمثلون 80 دولة من مختلف أنحاء العالم ، يشاركون تجاربهم وخبراتهم وتبادل وجهات النظر مع قادة الفكر&nbsp; ،كما ستتضمن القمة عددًا من الإطلاقات والاتفاقيات التي تخدم قطاع التقنية العقارية، وستتناول عددًا من المحاور، منها: الابتكار وريادة الأعمال في مستقبل التكنولوجيا العقارية، وقوة تقنية الطباعة ثلاثية الأبعاد من المخطط إلى الواقع، و تمثل القمة منصة للشراكات مع الجهات العالمية وبوابة للشركات الناشئة والواعدة والرائدة لعرض حلولها المبتكرة&nbsp; في صناعة العقار والالتقاء بالمستثمرين وأصحاب رؤوس الأموال ، مما يعزز مكانة المملكة العربية السعودية كونها نقطة انطلاق مثالية للابتكارات الخاصة بالتقنية العقارية العالمية لما تمتاز به بموقع جغرافي استراتيجي يربط ثلاث قارات إلى جانب المكانة الاقتصادية وبيئة الأعمال وقوة السوق العقاري بها</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\"> .</span></p>\\n<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">وتدعو الهيئة المهتمين والمختصين والباحثين والجهات العاملة في هذا المجال في جميع دول العالم، إلى التسجيل والمشاركة ، والاطلاع على أجندة أعمالها عبر الرابط</span><span> </span><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\"><a href=\\\"https://globalproptechsummit.com/\\\">https://globalproptechsummit.com/</a></span><span> </span><span>&nbsp;.</span><span> .</span></p>\\n<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ القمة العالمية للبروبتك التي ستشهدها العاصمة الرياض في العام الجاري بمشيئة الله تأتي بالتزامن مع ما يشهده السوق العقاري السعودي من ازدهار يجعل منه أكثر طلبًا للحلول المبتكرة التي تلبي الاحتياجات والمتطلبات الخاصة بالنمو السكاني المتسارع ومبادرات المدن الذكية ومشاريع التطوير الطموحة التي تشهدها مختلف مناطق المملكة. </span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\" تعقد القمة العالمية للبروبتك أكتوبر المقبل بمشاركة 80 دولة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"475e4bd3-ade3-3ba2-a1d5-f689e6c02aeb","Alias":"\"هيئة العقار\": التشريعات العقارية أسهمت في رفع مستوى الشفافية والإفصاح بالسوق  وصندوق النقد الدولي يشيد بما حققه القطاع العقاري","Path":"/1eae40fd-a41a-4686-b583-9295c1d50507.config","Level":4286,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1eae40fd-a41a-4686-b583-9295c1d50507.config","Node":{"Content":{"@Key":"1eae40fd-a41a-4686-b583-9295c1d50507","@Alias":"\"هيئة العقار\": التشريعات العقارية أسهمت في رفع مستوى الشفافية والإفصاح بالسوق  وصندوق النقد الدولي يشيد بما حققه القطاع العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-11T07:08:37","NodeName":{"@Default":"\"هيئة العقار\": التشريعات العقارية أسهمت في رفع مستوى الشفافية والإفصاح بالسوق  وصندوق النقد الدولي يشيد بما حققه القطاع العقاري"},"SortOrder":"286","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-10T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c72189e3-26ce-42e6-b161-c43c06ad0683\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: center; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 20.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">\\\"هيئة العقار\\\": التشريعات العقارية أسهمت في رفع مستوى الشفافية والإفصاح بالسوق </span></p>\\n<p style=\\\"text-align: center; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 20.0pt; line-height: 105%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وصندوق النقد الدولي يشيد بما حققه القطاع العقاري&nbsp;&nbsp; </span></p>\\n<p style=\\\"text-align: justify; background: white; direction: rtl; unicode-bidi: embed; margin: 6.0pt 0cm 6.0pt 0cm;\\\" dir=\\\"RTL\\\"><strong><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; font-weight: normal;\\\" lang=\\\"AR-SA\\\">أكدت الهيئة العامة للعقار أنّ التشريعات العقارية التي أُعلنت خلال الفترة الماضية أسهمت في رفع مستوى الشفافية والإفصاح بالسوق العقاري وأنّ&nbsp; إشادة صندوق النقد الدولي في تقريره الصادر بعد اختتام “مشاورات المادة الرابعة 2024</span></strong><strong>″</strong><strong><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; font-weight: normal;\\\" lang=\\\"AR-SA\\\">، بما حققه القطاع العقاري من </span></strong><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ارتفاع في مستوى رضا المستفيدين عن الخدمات السكنية ، إضافة إلى تحقيق نسبة 64% في نسبة تملك المواطنين للمسكن، يأتي نتاج العمل المستمر في تنظيم القطاع وسن الأنظمة والقوانين ورقمنة وحوكمة العمليات العقارية وتمكين العامة من الوصول للبيانات والمعلومات والمؤشرات العقارية.&nbsp; </span></p>\\n<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضح المتحدث الرسمي للهيئة العامة للعقار أ.تيسير بن محمد المفرج&nbsp; أنّ إشادة صندوق النقد الدولي بما حققه القطاع العقاري تأتي بالتزامن </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black; mso-bidi-language: AR-AE;\\\" lang=\\\"AR-AE\\\">مع تصنيف المملكة ضمن أفضل 40 سوقاً عقارياً وأكثرها شفافية عالمياً في تقرير \\\"جيه إل إل\\\" لمؤشر الشفافية العقارية العالمي، وهذا يؤكد فعالية وجدية الإصلاحات الشاملة التي تعمل عليها \\\"الهيئة\\\"&nbsp; من خلال</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\"> منظومة التشريعات العقارية المُعلنة والتي بلغت 18 تشريع عقاري حتى الآن، بهدف تنظيم القطاع وتحقيق وصول المتعاملين به إلى مستهدفاتهم سواءً في قطاع البيع أو الإيجار، بالإضافة إلى أنها تُعد ممكن رئيسي في زيادة المعروضات العقارية السكنية والتجارية، ومن شأنها أنّ تعزز التنافسية في السوق وتلبي توقعات واحتياجات المستفيدين ، مما يسهم في خلق سوق عقاري متزن&nbsp; ومرن ومستدام من خلال الشراكات بين القطاع الحكومي والخاص .</span></p>\\n<p style=\\\"text-align: justify; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار \\\"المفرج\\\"<span style=\\\"color: black;\\\"> إلى أنّ الاستراتيجية الشاملة للقطاع العقاري المنبثقة من رؤية المملكة 2030 أسهمت في رسم خارطة واضحة لمستقبل القطاع العقاري ومواجهة التحديات به ، من خلال التنظيمات الجديدة و المؤشرات العقارية والبرامج والمبادرات التي تأتي للتأكيد على أهمية الامتثال والالتزام بالسياسات والإجراءات المنظمة للسوق، ولتوثيق جميع العمليات والتعاملات العقارية و تعريف الوحدات العقارية بأوصافها وأشكالها وتوثيق ملكياتها من خلال السجل العقاري&nbsp; ، إضافة للشراكات التي أعلنت عنها مع الجهات ذات العلاقة للارتقاء بالمؤشر العقاري وتصميم قواعد بيانية مفصلة بمعلومات دقيقة تعطي مؤشرات تفاعلية عن وضع السوق العقاري والمتغيرات به، وتسهم في تعزيز دورها برصد كافة التحديات التي يواجهها السوق العقاري والمتعاملين فيه ، وتقديم الدراسات والتوصيات ورفعها للجهات المعنية لاتخاذ القرار .</span></span></p>\\n<p style=\\\"text-align: justify; background: white; direction: rtl; unicode-bidi: embed; margin: 6.0pt 0cm 6.0pt 0cm;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ نظام بيع وتأجير مشروعات عقارية على الخارطة الذي أعلنت عنه \\\" الهيئة \\\" جاء لتنظيم العلاقة التعاقدية وتعزيز المعروض العقاري السكني والتجاري والزراعي والسياحي والصناعي والاستثماري وغيرها ، وأنّ نظام المساهمات العقارية يوفر حلول تمويلية تُسهم في تسريع وتيرة الإنشاءات وإتاحة خيارات عقارية متنوعة&nbsp; ، وأنّ نظام الوساطة العقارية يسهم في الحد من النزاعات العقارية وخلق بيئة عقارية آمنة للمتعاملين والمستثمرين في السوق من خلال رفع كفاءة العاملين بالمجال والتأكد من نظاميتهم وصحة الإعلانات العقارية في الأماكن العامة أو عبر المواقع الإلكترونية على حد سواء ، بالإضافة إلى أنّ \\\"الهيئة \\\"&nbsp; سهلت وصول المستفيدين للخدمات العقارية من خلال منصات إلكترونية تمكنهم من انجاز تعاملاتهم في وقت وجيز، مما يسهم في تعزيز دور القطاع&nbsp; واسهاماته في الناتج المحلي الإجمالي غير النفطي في المملكة</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\": التشريعات العقارية أسهمت في رفع مستوى الشفافية والإفصاح بالسوق  وصندوق النقد الدولي يشيد بما حققه القطاع العقاري   "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"90e2ad48-e47b-3c55-b022-e7cbfdd2219a","Alias":"\"هيئة العقار\" الخميس تنتهي مدة تسجيل العقار ات في السجل العقاري لـ(8) أحياء في مدينة الرياض","Path":"/a1214542-b9aa-41fa-8c97-3b131dd2dd9e.config","Level":4287,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a1214542-b9aa-41fa-8c97-3b131dd2dd9e.config","Node":{"Content":{"@Key":"a1214542-b9aa-41fa-8c97-3b131dd2dd9e","@Alias":"\"هيئة العقار\" الخميس تنتهي مدة تسجيل العقار ات في السجل العقاري لـ(8) أحياء في مدينة الرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-24T09:36:18","NodeName":{"@Default":"\"هيئة العقار\" الخميس تنتهي مدة تسجيل العقار ات في السجل العقاري لـ(8) أحياء في مدينة الرياض"},"SortOrder":"287","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-24T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"f70a16c2-f929-4ab9-b32e-0038b0ab474f\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المهلة المحددة للتسجيل العيني الأول للعقار لـ(8) أحياء بمدينة الرياض، وذلك بنهاية يوم الخميس الموافق 23 ربيع الأول 1446هـ الموافق 26 سبتمبر 2024م.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وبينت \\\"الهيئة\\\" أنّ التسجيل العيني الأول للعقار سينتهي في (8) أحياء وهي: (حي جرير، حي الربوة، حي الريان، حي الروابي، حي السلام، حي المنار، حي النسيم الغربي، حي النسيم الشرقي).</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن نطاق الأحياء المذكورة إلى سرعة المبادرة بتسجيل عقاراتهم من خلال <a href=\\\"/rer.sa#rer.sa\\\" title=\\\"rer.sa\\\" data-anchor=\\\"#rer.sa\\\">منصة السجل العقاري</a></span><span>&nbsp;قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ التسجيل العيني للعقار يتيح إصدار \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز نمو القطاع العقاري والممكنات الرئيسة له.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة في خدمات وبيانات العقارات</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" الخميس تنتهي مدة تسجيل العقار ات في السجل العقاري لـ(8) أحياء في مدينة الرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a26065c3-c476-3970-b84c-d4f76ba4cbbb","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بمدينة الرياض و(13) حياً بمحافظة الدرعية","Path":"/4a551d76-a96e-4b64-a74b-0ca6f0781f48.config","Level":4288,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4a551d76-a96e-4b64-a74b-0ca6f0781f48.config","Node":{"Content":{"@Key":"4a551d76-a96e-4b64-a74b-0ca6f0781f48","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بمدينة الرياض و(13) حياً بمحافظة الدرعية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-29T08:02:07","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بمدينة الرياض و(13) حياً بمحافظة الدرعية"},"SortOrder":"288","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-27T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"7407e896-27c3-4951-b1ba-3fc47184006e\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أ</span></span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">علنتْ الهيئة العامة للعقار عن بدء أعمال التسجيل العيني للعقار لـ (43،495</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">قطعة عقارية)</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لـ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">(4)</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أحياء بمدينة الرياض و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">(13)</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حياً</span><span class=\\\"apple-converted-space\\\">&nbsp;بمحافظة</span><span class=\\\"bumpedfont15\\\">&nbsp;الدرعية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ابتداءً من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">27</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أكتوبر</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2024م، الموافق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">24</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ربيع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الثاني</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">1446هـ، وحتى نهاية يوم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">30</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يناير 2025م الموافق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">30</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">رجب 1446هـ.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بمدينة الرياض: (حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بنبان، حي المناخ، حي الفيصلية، حي المشاعل)، فيما</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يشمل التسجيل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الأحياء التالية في محافظة الدرعية:(حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ظهرة العودة غرب، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ظهرة العودة شرق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العاصمة، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الملقاه، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">قريوة، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الفيصلية، حي السرحية،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الثليما،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حي الخالدية، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الشهداء، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">السلمانية، حي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الملك، حي المغترة)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأشارت&nbsp;”هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">سيكون مُتاحًا عن طريق <a href=\\\"https://rer.sa/#https://rer.sa/\\\" title=\\\"https://rer.sa/\\\" data-anchor=\\\"#https://rer.sa/\\\">منصة السجل العقاري الإلكترونية</a></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أو عن طريق مراكز الخدمة ، مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تعزيز البنية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بمدينة الرياض و(13) حياً بمحافظة الدرعية "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"3fe9f83e-4db1-3226-8796-36ca759a9451","Alias":"\"إيجار\" تُسجّل أكثر من 10 مليون عقد إيجاري مُنذ إطلاقها","Path":"/f09b78a7-0100-4cb3-8759-002faa5c76db.config","Level":4289,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f09b78a7-0100-4cb3-8759-002faa5c76db.config","Node":{"Content":{"@Key":"f09b78a7-0100-4cb3-8759-002faa5c76db","@Alias":"\"إيجار\" تُسجّل أكثر من 10 مليون عقد إيجاري مُنذ إطلاقها","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-29T12:39:01","NodeName":{"@Default":"\"إيجار\" تُسجّل أكثر من 10 مليون عقد إيجاري مُنذ إطلاقها"},"SortOrder":"289","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-29T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"8f24126f-0f50-41a7-8c6a-97c0a3626916\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن تسجيل الشبكة الإلكترونية لخدمات الإيجار \\\" إيجار \\\" أكثر من 10 مليون عقد إيجاري مُنذ إطلاقها، وبمعدل يومي يصل إلى 19 ألف عقد، حيث شكلت العقود السكنية أكثر من 8.3 مليون عقد بنسبة بلغت 82.3% من إجمالي العقود الإيجارية السكنية، في حين بلغ عدد العقود التجارية 1.7 مليون بما يمثل 17.6% من إجمالي العقود المسجلة في المنصة، وسجلت العقود الموثقة منذ بداية 2024م حتى الآن أكثر 1.5 مليون عقد موثق، منها ما يزيد عن 1.2 مليون عقد إيجاري سكني، و283 ألف عقد تجاري.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت \\\"الهيئة\\\"&nbsp; أنّ الأرقام التي حقّقتها \\\"إيجار\\\" جاءت لتؤكد على الموثوقية في قطاع الإيجار العقاري السكني والتجاري والتشريعات العقارية التي تنظم التعاملات في السوق العقاري، حيث أتاحت \\\"إيجار\\\" للمستأجر، والمؤجر، والوسيط العقاري مستوى عالٍ من الشفافية&nbsp; في التعاملات العقارية منها: التحقق من الوثائق والصكوك، وبيانات أطراف العقد، بالتكامل مع الجهات الحكومية الشريكة، والتعامل مع وسيط عقاري مرخّص من الهيئة العامة للعقار، وتوثيق العقود عبر القنوات الرقمية واعتمادها لدى الجهات المعنية، واستخدام قنوات الدفع الإلكترونية في إيجار \\\"مدى\\\" و\\\"سداد\\\"؛ لتوثيق الدفعات المالية وإثباتها، مما يسهّل الرحلة الإيجارية، ويحفظ حقوق الأطراف قبل وأثناء العملية الإيجارية</span><span>.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأضافت \\\"الهيئة “أنّ \\\"إيجار\\\" مكَّنت المتعاملين من الاستفادة من خصائص نوعية تعزز الثقة بين الأطراف، وتحسّن من كفاءة التعاملات منها: المؤشر الإيجاري، الاستلام والتسليم، وحفظ مبلغ الضمان، وتقييم السلوك الإيجاري، وإمكانية سداد الدفعات جزئيًا، بالإضافة إلى فترات السداد المختلفة (سنوية، نصف سنوية، ربع سنوية، شهرية)، ووجود شراكات استراتيجية مع جهات خدمية أخرى، مكّنتهم من نقل الخدمات باسم المستخدم الفعلي للوحدة الإيجارية، مما أسهم في إثراء قطاع الإيجار العقاري، والتحفيز على الاستثمار فيه.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ \\\" إيجار\\\" تُقدم عدداً من المميزات لقطاع الإيجار التجاري، ومنها التكامل الرقمي مع الجهات في القطاعين الحكومي والخاص، مثل وزارة العدل، ووزارة الموارد البشرية والتنمية الاجتماعية، ووزارة التجارة، ووزارة الاستثمار، والربط مع منصة بلدي.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"إيجار\" تُسجّل أكثر من 10 مليون عقد إيجاري مُنذ إطلاقها"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ce7da8e4-bcce-3a49-9eea-2eb1d544535e","Alias":"\"هيئة العقار\" تُطلق مسرعة الأعمال في التقنية العقارية بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات","Path":"/b6f1d337-9735-4e9d-ba17-1cda51ec0508.config","Level":4290,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b6f1d337-9735-4e9d-ba17-1cda51ec0508.config","Node":{"Content":{"@Key":"b6f1d337-9735-4e9d-ba17-1cda51ec0508","@Alias":"\"هيئة العقار\" تُطلق مسرعة الأعمال في التقنية العقارية بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-29T18:01:05","NodeName":{"@Default":"\"هيئة العقار\" تُطلق مسرعة الأعمال في التقنية العقارية بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات"},"SortOrder":"290","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-29T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c5e03b71-1e8b-48e4-87bc-c63a916f9388\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; text-indent: -.75pt; direction: rtl; unicode-bidi: embed; margin: 0in .75pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s7\\\">&nbsp;</p>\\n<p style=\\\"text-align: right; text-indent: -.75pt; direction: rtl; unicode-bidi: embed; margin: 0in .75pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">إطلاق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مسرعة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الأعمال في التقنية العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بالتعاون مع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">البرنامج</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الوطني لتنمية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تقنية المعلومات ومسرعة&nbsp;الأعمال</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العالمية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">STARTUP</span><span class=\\\"bumpedfont15\\\"><span> </span></span><span class=\\\"bumpedfont15\\\">WISE GUYS</span><span class=\\\"bumpedfont15\\\"><span>، بهدف تسريع&nbsp;تطوّر ونمو الشركات الناشئة والريادية وتوسعها،</span></span><span class=\\\"apple-converted-space\\\">&nbsp;لتكون&nbsp;</span><span class=\\\"bumpedfont15\\\">داعمة للقطاع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقاري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ورفع مساهمتها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في الناتج المحلي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وفق رؤية المملكة 2030.</span></p>\\n<p style=\\\"text-align: right; text-indent: -.75pt; direction: rtl; unicode-bidi: embed; margin: 0in .75pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحت \\\"الهيئة\\\" أنّ</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">برنامج</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مسرعات الأعمال في التقنية العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الذي سيقام بمقرها الرئيسي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يأتي في نسخته الأولى لبناء</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">شركات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ناشئة وريادية تكون</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">داعمة للقطاع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقاري،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وتسهيل وصولهم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لشبكة من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المستثمرين الملائكيين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">والصناديق الاستثمارية بما يسهم في تعزيز مساهمتها في الاقتصاد الوطني، حيث يُقدم البرنامج &nbsp;عدد من ورش العمل التدريبية المتخصصة وجلسات التوجيه والإرشاد والجلسات الاستشارية والتطويرية التي يقودها خبراء ومختصين ، إضافة إلو استعراض&nbsp;قصص النجاح لأبرز رواد الأعمال والمؤثرين ، وإتاحة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مساحات عمل مشتركة،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">&nbsp;وربط</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خريجين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">المسرعة مع شبكة من العملاء المحتملين لتحقيق نموها واستدامتها بالسوق .</span></span></p>\\n<p style=\\\"text-align: right; text-indent: -.75pt; direction: rtl; unicode-bidi: embed; margin: 0in .75pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\">وأشارت</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"هيئة العقار\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"البرنامج\\\" يأتي انطلاقًا من دورها في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">استكشاف الفرص المستقبلية وتحقيق استراتيجيتها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في تمكين و دعم التنقية العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">للسوق العقاري في المملكة والوصول إلى مستويات عالية في النضج</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الإلكتروني،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والريادة في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خلق شركات ريادية في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التقنيات العقارية محليًا وإقليميًا،وأنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الشراكة مع البرنامج الوطني لتنمية تقنية المعلومات تُسهم في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تشجيع القطاع الخاص المحلي ودعمه لزيادة تبني</span><span class=\\\"apple-converted-space\\\">&nbsp;الحلول الابتكارية&nbsp;</span><span class=\\\"bumpedfont15\\\">والمبادرات&nbsp;والتطبيقات&nbsp;والخدمات</span><span class=\\\"apple-converted-space\\\">&nbsp;التقنية&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">التي من شأنها أن تخلق آفاقًا مستقبلية تقنية للقطاع العقاري أكثر تطورًا</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، وأضافت الهيئة أنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">برنامج مسرعة الأعمال سيمر</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بعدة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مراحل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">منها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">استقبال الطلبات وتقييم وترشيح المتقدمين ثم البدء بأجندة البرنامج الممتدة إلى ستة أشهر وتخريج المبتكرين من رواد الأعمال ومتابعتهم بعد التخرج.</span></span></p>\\n<p style=\\\"text-align: right; text-indent: -.75pt; direction: rtl; unicode-bidi: embed; margin: 0in .75pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ودعت \\\"الهيئة\\\" المهتمين والمختصين ورواد الأعمال وأصحاب الشركات الناشئة الراغبين في الانضمام للبرنامج</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والاستفادة من أنشطته وخدماته</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تقديم طلباتهم من خلال التسجيل عبر الرابط</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التالي:</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 13.5pt; color: black;\\\" lang=\\\"AR-SA\\\"><a href=\\\"http://s.rega.gov.sa/KBp\\\"><span class=\\\"s8\\\">http://s.rega.gov.sa/KBp</span></a></span><span class=\\\"apple-converted-space\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">&nbsp;</span></span><span class=\\\"bumpedfont15\\\">، حيث أنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مسرعة الأعمال</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تأتي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بالشراكة</span><span class=\\\"apple-converted-space\\\"><s>&nbsp;</s></span><span class=\\\"bumpedfont15\\\">مع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">البرنامج الوطني لتنمية تقنية المعلومات ومسرعة&nbsp;الأعمال</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العالمية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">STARTUP</span><span class=\\\"bumpedfont15\\\"><span> </span></span><span class=\\\"bumpedfont15\\\">WISE GUYS</span><span class=\\\"bumpedfont15\\\"><span>،</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التي تمتلك خبرة واسعة في</span><span class=\\\"apple-converted-space\\\">&nbsp;التقنية</span><span class=\\\"bumpedfont15\\\">&nbsp;العقارية والتي &nbsp;ستسهم في دعم الشركات الناشئة على</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">النمو.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تُطلق مسرعة الأعمال في التقنية العقارية بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"28f64e81-eaf7-3626-b03e-ef726c89835c","Alias":"مجلس إدارة الهيئة العامة للعقار  يعقد اجتماعه الـ28","Path":"/b39b308f-3e06-41d3-88a2-4cf5bf75e988.config","Level":4291,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b39b308f-3e06-41d3-88a2-4cf5bf75e988.config","Node":{"Content":{"@Key":"b39b308f-3e06-41d3-88a2-4cf5bf75e988","@Alias":"مجلس إدارة الهيئة العامة للعقار  يعقد اجتماعه الـ28","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-09-30T09:44:50","NodeName":{"@Default":"مجلس إدارة الهيئة العامة للعقار  يعقد اجتماعه الـ28"},"SortOrder":"291","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-09-30T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"49def53f-9437-4ad4-8c29-21c7aac35609\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin-bottom: 22.0pt; text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 20.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">عقد مجلس إدارة الهيئة العامة للعقار أمس اجتماعه الثامن والعشرون،&nbsp; برئاسة معالي وزير البلديات والإسكان رئيس مجلس إدارة الهيئة الأستاذ ماجد بن عبدالله الحقيل، وبحضور الرئيس التنفيذي للهيئة المهندس عبدالله بن سعود الحماد، وأعضاء المجلس ممثلي الجهات الحكومية، وممثلي القطاع الخاص.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 18.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">واستعرض المجلس جملةً من الموضوعات المدرجة على جدول أعماله حيث استهله بالاطلاع على القرارات والتوجيهات الصادرة منه، كما استعرض سير عمل منظومة التشريعات العقارية ومستوى التقدم لأعمال التسجيل العيني للعقار، وما يتعلق بتراخيص الأنشطة العقارية والرقابة عليها ومؤشر خدمات المستفيدين، فيما ناقش المجلس مستوى تقدم الخطط الاستراتيجية للهيئة، كما اطلع المجلس على التقارير الدورية للجان المنبثقة عنه والتابعة له، بالإضافة لمناقشة عدد من الموضوعات المدرجة على جدول أعماله واتخذ حيالها عدداً من القرارات.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار  يعقد اجتماعه الـ28"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"eac10cf5-a01c-3d44-88fb-6caf95faa8ad","Alias":"\"الهيئة العامة للعقار\" تُنفذ 9 جولات رقابية مشتركة خلال شهر سبتمبر لضمان الامتثال في السوق العقاري","Path":"/cb5aeaa6-d3a7-4ae5-8237-7575226b4616.config","Level":4292,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/cb5aeaa6-d3a7-4ae5-8237-7575226b4616.config","Node":{"Content":{"@Key":"cb5aeaa6-d3a7-4ae5-8237-7575226b4616","@Alias":"\"الهيئة العامة للعقار\" تُنفذ 9 جولات رقابية مشتركة خلال شهر سبتمبر لضمان الامتثال في السوق العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-01T10:52:57","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُنفذ 9 جولات رقابية مشتركة خلال شهر سبتمبر لضمان الامتثال في السوق العقاري"},"SortOrder":"292","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-01T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"24a4a438-03e8-4cff-9aaa-0d5ad85d0f6c\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">نفذت الهيئة العامة للعقار بمشاركة وزارة الموارد البشرية والتنمية الاجتماعية خلال شهر سبتمبر، 9 جولات رقابية مشتركة شملتْ زيارة 153 منشأة عقارية في كل من منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة، بهدف ضمان الامتثال للتشريعات العقارية بشكل عام ونظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين وتراخيص المُنشآت.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليه لتنظيم السوق العقاري، حيث قامت فرقها الرقابية خلال الفترة ذاتها بتنفيذ 14,430 عملية رقابية ميدانية، نتج عنها رصد 14,538 إعلاناً عقارياً مخالفاً بالأماكن العامة، كما تلقت الهيئة 511 بلاغاً عقارياً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها، فيما بلغ عدد عمليات المسح الإلكتروني أكثر من 14,609 عملية، حيث تنتهج الهيئة الرقابة الإلكترونية التي تستهدف القنوات الرقمية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة العقارية الرقمية وفق الأنظمة واللوائح.&nbsp;</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغاءه أو الغرامات المالية،&nbsp; وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها، كما دعت الهيئة المواطنين والمقيمين إلى تقديم بلاغاتهم في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم (199011) للاستفسارات العقارية.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُنفذ 9 جولات رقابية مشتركة خلال شهر سبتمبر لضمان الامتثال في السوق العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d53a7d89-00ca-345f-9842-5804af23b699","Alias":"\"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ(6) أحياء بالمدينة المنورة","Path":"/8957b8af-e99a-41ae-b43d-3b836af081ee.config","Level":4293,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/8957b8af-e99a-41ae-b43d-3b836af081ee.config","Node":{"Content":{"@Key":"8957b8af-e99a-41ae-b43d-3b836af081ee","@Alias":"\"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ(6) أحياء بالمدينة المنورة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-01T12:00:25","NodeName":{"@Default":"\"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ(6) أحياء بالمدينة المنورة"},"SortOrder":"293","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-01T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"b7a39069-141e-4c7e-9f36-371329fa0340\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المهلة المحددة للتسجيل العيني الأول للعقار لـ(6) أحياء بالمدينة المنورة، وذلك بنهاية يوم الخميس 3 أكتوبر 2024م الموافق 30 ربيع الأول 1446هـ.، وهي: (جزء من حي الملك فهد، جزء من حي العاقول، جزء من حي جماء أم خالد، حي سكة الحديد، جزء من حي الخضراء، جزء من حي أبيار الماشي)</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\">&nbsp;</span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن نطاق الأحياء إلى سرعة المبادرة بتسجيل عقاراتهم من خلال <a href=\\\"/rer.sa#rer.sa\\\" title=\\\"rer.sa\\\" data-anchor=\\\"#rer.sa\\\">منصة السجل العقاري الإلكترونية</a></span><a href=\\\"/rer.sa#rer.sa\\\" title=\\\"rer.sa\\\" data-anchor=\\\"#rer.sa\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\">&nbsp;</span></a><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\">&nbsp;</span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت أنّ التسجيل العيني للعقار يتيح إصدار \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز نمو القطاع العقاري والممكنات الرئيسة له</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\">&nbsp;</span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكّدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\">&nbsp;</span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى مهمة تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة بخدمات وبيانات العقارات</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" \"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ(6) أحياء بالمدينة المنورة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"c21b75b2-eeba-3d1f-b7af-a532f7620d11","Alias":"\"هيئة العقار \" تشارك في مؤتمر العمل البلدي الخليجي بالرياض","Path":"/774d21f1-fcb0-4dc6-a819-bf9f86f89cd4.config","Level":4294,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/774d21f1-fcb0-4dc6-a819-bf9f86f89cd4.config","Node":{"Content":{"@Key":"774d21f1-fcb0-4dc6-a819-bf9f86f89cd4","@Alias":"\"هيئة العقار \" تشارك في مؤتمر العمل البلدي الخليجي بالرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-03T09:53:58","NodeName":{"@Default":"\"هيئة العقار \" تشارك في مؤتمر العمل البلدي الخليجي بالرياض"},"SortOrder":"294","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-03T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"99bd09d5-beb2-4955-9d25-a70207a4008b\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\"><span>تُشارك الهيئة العامة للعقار في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مؤتمر العمل البلدي الخليجي في دورته الثانية عشرة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">التي تستضيفها المملكة العربية السعودية بمدينة الرياض خلال الفترة 6 - 8 أكتوبر القادم تحت شعار \\\"العمل البلدي المستدام.. الطموحات والتحديات\\\"</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">بهدف تعزيز التعاون والجهود المشتركة، وتبادل الخبرات والمعارف بين دول مجلس التعاون الخليجي للارتقاء بجودة الخدمات البلدية المقدمة للمواطنين والمقيمين وتحقيق التنمية الحضرية المستدامة بالمنطقة.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\">وتأتي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مشاركة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"الهيئة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"من خلال جناحها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مؤتمر العمل البلدي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الخليجي،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ضمن دورها في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تعزيز</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">نمو واستدامة القطاع العقاري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">واستكشاف الفرص</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التطويرية،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وتبادل الخبرات والتجارب مع العاملين بالقطاع،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وبحث</span><span class=\\\"apple-converted-space\\\">&nbsp;الرؤى&nbsp;</span><span class=\\\"bumpedfont15\\\">المستقبلية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حول</span><span class=\\\"apple-converted-space\\\">&nbsp;الاتجاهات&nbsp;</span><span class=\\\"bumpedfont15\\\">الحديثة لبناء مجتمعات حيوية وعصرية مواكبة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">للتطلعات، إضافةً إلى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التعريف بأحدث المستجدات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في القطاع العقاري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وتحليل تأثيرها على</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">القطاع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وجذب الاستثمارات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والمستثمرين.</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">&nbsp;</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\">وتستعرض</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"هيئة العقار \\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"مؤتمر العمل البلدي الخليجي\\\" منظومة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التشريعات العقارية التي تشمل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">\\\" نظام ولائحة بيع وتأجير مشروعات عقارية على الخارطة \\\" و\\\"نظام الوساطة العقارية\\\"، و\\\"نظام المساهمات العقارية\\\"، إضافةً</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">إلى التعريف بحقوق المتعاملين بالقطاع،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وبخدمات الأنشطة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التي تأتي تحت تنظيم الهيئة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">كبرنامج إيجار، والسجل العقاري، ومركز خدمة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الشركاء.</span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\">يُذكر&nbsp;أنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"مؤتمر العمل البلدي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الخليجي\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في دورته الثانية عشر سيستعرض</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أهم الأبحاث وأوراق العمل التي تتناول التحديات الراهنة وأبرز الاتجاهات الحديثة في تطوير وتنمية الخدمات البلدية واستدامتها، من خلال العديد من الجلسات وحلقات النقاش التي يشارك فيها نخبة من المسؤولين الحكوميين والقطاع الخاص والخبراء والمختصين في قطاع الخدمات البلدية بدول مجلس التعاون الخليجي.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار \" تشارك في مؤتمر العمل البلدي الخليجي بالرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5e1edfd1-38c9-3c16-8010-9544e856e10b","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (26) حياً بمدينة الدمام و(14) حياً بمحافظة الخبر","Path":"/1b51c768-1683-465c-8eca-3405f1a70e41.config","Level":4295,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1b51c768-1683-465c-8eca-3405f1a70e41.config","Node":{"Content":{"@Key":"1b51c768-1683-465c-8eca-3405f1a70e41","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (26) حياً بمدينة الدمام و(14) حياً بمحافظة الخبر","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-06T07:53:05","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (26) حياً بمدينة الدمام و(14) حياً بمحافظة الخبر"},"SortOrder":"295","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-05T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"4cf6f336-714f-4569-985f-ab2f1dcc5652\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p>&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن بدء أعمال التسجيل العيني للعقار</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لـ (87,318</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">قطعة عقارية)</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لـ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">(26)</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حياً</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بمدينة الدمام</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">(14)</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حياً</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بمحافظة الخبر</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ابتداءً من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">3</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">نوفمبر</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2024م، الموافق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">1</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">جمادى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أول1446هـ، وحتى نهاية يوم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">6</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">فبراير</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2025م الموافق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">7</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">شعبان1446هـ.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ&nbsp;الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية&nbsp;بمدينة الدمام: (المتبقي من حي الشعلة،الصناعية&nbsp;الأولى،&nbsp;الواحة،&nbsp;طيبة،&nbsp;النزهة،&nbsp;الفردوس،&nbsp;الروضة،الفيصلية،&nbsp;تهامة،&nbsp;المنتزة،&nbsp;الجامعيين،&nbsp;الاسكان،&nbsp;الريان،&nbsp;النهضة،عبدالله&nbsp;فؤاد،&nbsp;مدينة&nbsp;العمال،&nbsp;المنار،ابن&nbsp;خلدون،&nbsp;الأمل،&nbsp;الأتصالات،البساتين،&nbsp;هجر،&nbsp;الانوار،&nbsp;الندى،&nbsp;المريكبات،&nbsp;قصر&nbsp;الخليج)، فيما&nbsp;يشمل التسجيل&nbsp;الأحياء التالية في محافظة الخبر:&nbsp;(شاطئ&nbsp;نصفالقمر،&nbsp;الكوثر،&nbsp;العقيق،&nbsp;السفن،&nbsp;المرجان،&nbsp;الرجاء،&nbsp;الشفاء،&nbsp;الصواري،اللؤلؤ،&nbsp;المها،&nbsp;الامواج،&nbsp;الشراع،&nbsp;الدرة،&nbsp;البحيرة)،&nbsp;مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأشارت&nbsp;”هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">سيكون مُتاحًا عن طريق <a href=\\\"https://rer.sa/#https://rer.sa/\\\" title=\\\"https://rer.sa/\\\" data-anchor=\\\"#https://rer.sa/\\\">منصة السجل العقاري الإلكترونية</a></span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;أو عن طريق مراكز الخدمة ، مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.&nbsp;</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تعزيز البنية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار الى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (26) حياً بمدينة الدمام و(14) حياً بمحافظة الخبر"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e55ef17f-ce2e-3725-956c-ac892686c643","Alias":"\"هيئة العقار\": تعلن قرب انتهاء التسجيل العيني في حي قرطبة بمدينة بريدة","Path":"/ade40aa3-60e7-4e74-9ebd-0302ebd52f2f.config","Level":4296,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ade40aa3-60e7-4e74-9ebd-0302ebd52f2f.config","Node":{"Content":{"@Key":"ade40aa3-60e7-4e74-9ebd-0302ebd52f2f","@Alias":"\"هيئة العقار\": تعلن قرب انتهاء التسجيل العيني في حي قرطبة بمدينة بريدة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-06T07:57:54","NodeName":{"@Default":"\"هيئة العقار\": تعلن قرب انتهاء التسجيل العيني في حي قرطبة بمدينة بريدة"},"SortOrder":"296","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-06T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9f53a5dd-4256-4231-a502-f2d3e6a6a009\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 105%; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المهلة المحددة للتسجيل العيني الأول للعقار لحي قرطبة بمدينة بريدة، وذلك بحلول نهاية يوم الاثنين 7 أكتوبر 2024م الموافق&nbsp;</span><span>4</span><span style=\\\"font-size: 16.0pt; line-height: 105%; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">ربيع الثاني 1446هـ. ودعت ملاك العقارات الواقعة ضمن نطاق حي قرطبة إلى سرعة المبادرة بتسجيل عقاراتهم من خلال منصة السجل العقاري الإلكترونية</span><span> rer.sa </span><span style=\\\"font-size: 16.0pt; line-height: 105%; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 105%; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">وأوضحت \\\" الهيئة \\\" أنّ التسجيل العيني للعقار يتيح إصدار \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز نمو القطاع العقاري والممكنات الرئيسة له</span><span>.<br></span><span style=\\\"font-size: 16.0pt; line-height: 105%; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">وأكّدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان</span><span>.<br></span><span style=\\\"font-size: 16.0pt; line-height: 105%; font-family: 'Sakkal Majalla'; background: white;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى مهمة تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة بخدمات وبيانات العقارات</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\": تعلن قرب انتهاء التسجيل العيني في حي قرطبة بمدينة بريدة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9f71ec3f-b447-398a-a0b8-2bf5691dbf31","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (316)  حياً بمنطقة القصيم","Path":"/dd667176-296b-4012-9045-4519b4548316.config","Level":4297,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/dd667176-296b-4012-9045-4519b4548316.config","Node":{"Content":{"@Key":"dd667176-296b-4012-9045-4519b4548316","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (316)  حياً بمنطقة القصيم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-06T08:00:02","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (316)  حياً بمنطقة القصيم"},"SortOrder":"297","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-05T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"987d8668-1083-48f7-94ca-1bfa05c78ce9\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xs2\\\">&nbsp;</p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xs2\\\"><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن بدء أعمال التسجيل العيني للعقار لـ (351،334 قطعة عقارية) لـ (316)</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">حياً</span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">بمنطقة القصيم منها (130) بمدينة بريدة و(55) بمدينة عنيزة و(23) بمدينة البكيرية و(28) &nbsp;بمدينة البدائع، و(48) بمدينة الرس، و(16) &nbsp;بمدينة الخبراء والسحابين، و(16) &nbsp;بمدينة رياض الخبراء، ابتداءً من 3 نوفمبر 2024م، الموافق 1 جمادى الأول 1446هـ، وحتى نهاية يوم 6 فبراير 2025م الموافق 7 شعبان 1446هـ.</span></span></p>\\n<p style=\\\"text-align: start; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span class=\\\"xbumpedfont15\\\">وأوضحت الهيئة أنّ الأحياء</span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء&nbsp;التالية بمدينة بريدة: (البساتين الغربي،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العجيبة، &nbsp;الهلال، &nbsp;النقع الغربي، الجراد، &nbsp;النسيم، &nbsp;الموطأ، &nbsp;العريضمي</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الشمالي، &nbsp;النازية، &nbsp;واسط، &nbsp;الرفيعة، &nbsp;المريديسية</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الشمالية، &nbsp;القويع، البوطة ، &nbsp;المريديسية</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الجنوبية، السادة، &nbsp;الوسيطا، &nbsp;الفاخرية، &nbsp;الهدية الشمالية، &nbsp;الرمال، &nbsp;حويلان، &nbsp;خضيراء الشمالية، &nbsp;الشماس، &nbsp;المطار القديم، &nbsp;البساتين الشرقي، &nbsp;خب القبر، التخصصي، &nbsp;السلام الغربي، الجردة، المرقب، &nbsp;الخبيب، &nbsp;السلام الشرقي، &nbsp;خب البريدي، &nbsp;النفل، &nbsp;العريمضي</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الجنوبي، &nbsp;الصبيحية، &nbsp;النقع الشرقي، &nbsp;الهدية الجنوبية، &nbsp;الجنوب، &nbsp;الربيع، &nbsp;القادسية، &nbsp;الصفا، &nbsp;الشروق، &nbsp;وهطان، &nbsp;الباطن، &nbsp;القصيعة، المروة، &nbsp;اللسيب، &nbsp;المناخ، &nbsp;رواق الشرقي، &nbsp;اليتيمة، &nbsp;الضاحي</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الشرقي، &nbsp;الخضر، &nbsp;المصانع،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">خب</span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الجطيلي، &nbsp;الضا</span></span><span class=\\\"xapple-converted-space\\\">حي </span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الغربي، &nbsp;المهاريس، &nbsp;خضيراء الجنوبي، &nbsp;رواق الغربي، &nbsp;الأندلس، &nbsp;الروابي،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الغدير، &nbsp;السالمية، &nbsp;اليرموك، الآفق، &nbsp;الزهرة، &nbsp;الحمراء، &nbsp;الصفراء، &nbsp;مبروكة، &nbsp;الورود، &nbsp;المنتزه الشرقي، النقيب الجنوبي، الأخضر، &nbsp;الأمن، &nbsp;المصيف، &nbsp;الخزامى، &nbsp;الرابية، &nbsp;العدل، &nbsp;الفايزية، المنتزه الغربي، &nbsp;الشفق، &nbsp;الشقة، &nbsp;المنصورة، &nbsp;السويلمية، &nbsp;ضراس الشمالية، &nbsp;الجنادرية، &nbsp;خب الحلوة، &nbsp;عين حمزة، &nbsp;الضياء، &nbsp;الأمل، &nbsp;القويطير، &nbsp;المرسلات، الشقة العليا، &nbsp;التوفيق، &nbsp;السليمانية، الفردوس، &nbsp;القيروان، &nbsp;الإزدهار، &nbsp;النقيب الشمالي، &nbsp;طيبة، &nbsp;الراشديات، &nbsp;التيسير، &nbsp;المعارض، &nbsp;الزيتونة، &nbsp;النزهة، &nbsp;الريحان، الجزيرة، &nbsp;النرجس، &nbsp;جبارة، &nbsp;الواحة، &nbsp;المتينيات، &nbsp;ضارج،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الرضوان، الخلود، &nbsp;الياسمين، &nbsp;الرحاب، &nbsp;الحزم، &nbsp;جزء من</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">العقيلات، &nbsp;الخير، &nbsp;البديع، &nbsp;الوطاة، &nbsp;النور، &nbsp;الفاروق، &nbsp;الأنوار،، الربوة، خب الثنيان، التعليم، القاع البارد، الصباخ، الخليج) فيما يشمل التسجيل الأحياء التالية في مدينة عنيزة:(المنار ، &nbsp;الرياضي، &nbsp;البستان، &nbsp;الخالدية، &nbsp;سنام، &nbsp;الروابي، &nbsp;الريان، &nbsp;الأشرفية، &nbsp;الصفاء، &nbsp;اليمامة، &nbsp;الراية، &nbsp;الصفراء، &nbsp;الملك خالد، الروضة، حطين &nbsp;الحمراء، &nbsp;النرجس، &nbsp;الدوحة، &nbsp;السلام، &nbsp;الفيحاء، &nbsp;النظيم، &nbsp;وسط المدينة، &nbsp;العليا، &nbsp;المصيف، &nbsp;الصالحية، &nbsp;العونية، &nbsp;الرمال، &nbsp;البويطن، &nbsp;المعالي، &nbsp;الوهلان، &nbsp;المروج، &nbsp;الملك فهد، &nbsp;الجوهرة، &nbsp;الوفاء، &nbsp;غرناطة، &nbsp;الجزيرة، &nbsp;الشروق، &nbsp;الحفيرة، &nbsp;الجامعي، &nbsp;المروة، &nbsp;الرحمانية، &nbsp;اليرموك، &nbsp;الخزامى، &nbsp;الجلدة، القيروان، &nbsp;الحاجب، &nbsp;سماح، الصناعية، &nbsp;الرايسية، &nbsp;السليمانية، &nbsp;الواحة، &nbsp;الفاخرية، &nbsp;الحزم، &nbsp;الشفاء، جزء من النسيم) كما يشمل التسجيل الأحياء التالية في مدينة البكيرية:</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">( المنتزة، &nbsp;القادسية، &nbsp;الصحة، &nbsp;الياسمين، &nbsp;الريان، &nbsp;المجد، &nbsp;النهضة، &nbsp;البساتين، الروضة، &nbsp;الجامعة، &nbsp;الديرة، &nbsp;الربوة، &nbsp;المنار، &nbsp;البيضاء،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\">الزهرة،</span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">البديعة، &nbsp;الخليج، &nbsp;النخيل، الأمل، &nbsp;الربيع، &nbsp;الصفاء، &nbsp;الصناعية، &nbsp;الرياض) فيما شمل التسجيل الأحياء التالية بمدينة البدائع:</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">( جزء من النسيم، &nbsp;العبدلية، &nbsp;الدحلة، &nbsp;الفيصلية، &nbsp;الإسكان، الجامعة، &nbsp;المرقب، &nbsp;رامات، &nbsp;العليا، &nbsp;القدس، &nbsp;الروضة، &nbsp;العبيلة، &nbsp;الأندلس، &nbsp;الخليج، &nbsp;النهضة، &nbsp;أم تلعة، &nbsp;إشبيليا، &nbsp;الباستين، &nbsp;القادسية، &nbsp;الريان ،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">القبعية، &nbsp;المنار، &nbsp;قرطبة، &nbsp;الأصفر، &nbsp;السليمانية، &nbsp;المنتزة، &nbsp;الرواد، &nbsp;السلام) كما شمل التسجيل الأحياء التالية بمدينة الرس:( &nbsp;سوق الماشية الجديد، السعادة ، &nbsp;المصيف، &nbsp;الخليج ، &nbsp;العبيل، &nbsp;السد، &nbsp;النخيل، &nbsp;الأندلس، &nbsp;التعليم، &nbsp;السلام ، &nbsp;الربيع ، &nbsp;الحزم، &nbsp;الحوطة، &nbsp;الجريف، &nbsp;الحمراء ، &nbsp;المطيه، &nbsp;القدس، &nbsp;الروضة، بهجة، &nbsp;المطار، &nbsp;المدينة، اليرموك، &nbsp;الملك خالد، &nbsp;الزهرة، &nbsp;الملك عبدالعزيز، &nbsp;الملك فيصل، &nbsp;الفيصلية، &nbsp;المنتزة، &nbsp;وادي الرمة، الشفاء، الشنانة الشمالية ، الصناعية، طيبة،</span></span><span class=\\\"xbumpedfont15\\\"></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xs2\\\"><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الجندل ، النسيم، الاحتفالات، النهضة، الربوة، الروابي، المنار، الشهداء، القادسية، الورود، الواحة، الريان، الشنانة الجنوبية، المروج، الحي الغربي) كما يشمل التسجيل الأحياء التالية بمدينة الخبراء والسحابين:</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">( الندى، &nbsp;الورود، &nbsp;التراثي، &nbsp;القدس، &nbsp;الربيع، &nbsp;الربوة، &nbsp;المنار، &nbsp;البساتين، &nbsp;الرفيعة ، &nbsp;المجد، &nbsp;الصناعية، &nbsp;المرقب، &nbsp;السلام ، &nbsp;الوادي، &nbsp;الياسمين،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الريان) وكما يشمل التسجيل الأحياء التالية بمدينة رياض الخبراء:( الخزان، &nbsp;الحزم، &nbsp;الملك سلمان بن عبدالعزيز، &nbsp;القادسية، &nbsp;الجزيرة، &nbsp;النفيد، &nbsp;النهضة، &nbsp;أحد، &nbsp;الجامعة ، &nbsp;التعاون، &nbsp;القدس، &nbsp;النزهة، &nbsp;اليرموك، &nbsp;طيبة، &nbsp;الربوة، زبيدة)</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><a name=\\\"x__GoBack\\\"></a><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: start; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"xs2\\\"><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت ”هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء سيكون مُتاحًا عن طريق <a href=\\\"https://rer.sa/#https://rer.sa/\\\" title=\\\"https://rer.sa/\\\" data-anchor=\\\"#https://rer.sa/\\\">منصة السجل العقاري الإلكترونية</a></span></span><span style=\\\"font-size: 16.0pt;\\\" lang=\\\"AR-SA\\\">&nbsp;</span><span class=\\\"xbumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أو عن طريق مراكز&nbsp;الخدمة ،&nbsp;مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.&nbsp;</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (316)  حياً بمنطقة القصيم "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b7d6ac6c-a200-3571-89ac-4b0e777824ff","Alias":"\"هيئة العقار \" تشارك في المعرض الدولي للعقارات والاستثمار \" EXPO REAL\" بميونخ","Path":"/401d9ead-20b8-4164-a06b-741e7875703f.config","Level":4298,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/401d9ead-20b8-4164-a06b-741e7875703f.config","Node":{"Content":{"@Key":"401d9ead-20b8-4164-a06b-741e7875703f","@Alias":"\"هيئة العقار \" تشارك في المعرض الدولي للعقارات والاستثمار \" EXPO REAL\" بميونخ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//EXPOREAL","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-06T18:16:34","NodeName":{"@Default":"\"هيئة العقار \" تشارك في المعرض الدولي للعقارات والاستثمار \" EXPO REAL\" بميونخ"},"SortOrder":"298","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-06T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"26fda34b-54e3-4e7b-ba2d-7bd52ae92ff5\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">تُشارك الهيئة العامة للعقار في المعرض الدولي للعقارات والاستثمار&nbsp;</span></span><span class=\\\"s7\\\">EXPO</span><span class=\\\"s7\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\"> </span></span><span class=\\\"s7\\\">REA </span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">&nbsp;والمقام&nbsp;بمدينة ميونخ في جمهورية ألمانيا الاتحادية&nbsp;</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">خلال الفترة (7</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">–</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">9</span><span class=\\\"apple-converted-space\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">&nbsp;أكتوبر 2024م</span></span><span class=\\\"bumpedfont15\\\">)&nbsp;،&nbsp;ويمثل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المعرض فرصة للالتقاء</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بالخبراء والمختصين من مختلف أنحاء العالم وتبادل الرؤى و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الأفكار حول</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الحلول</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المبتكرة لمواجهة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التحديات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، والتطلعات والآفاق</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المستقبلية للقطاع العقاري.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وتأتي مشاركة الهيئة من خلال التواجد بجناح تعريفي يستعرض أهم التشريعات العقارية في المملكة العربية السعودية والتي تُعد من أهم الممكنات والمحفزات لرفع جاذبية الاستثمارات العقارية في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">السعودية،&nbsp;حيث تستهدف</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"الهيئة\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الالتقاء بقادة وصنَّاع العقارات من مختلف الدول المشاركة في المعرض وتعريفهم بالبيئة الاستثمارية العقارية واستعراض أهم التجارب في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التنظيمات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقارية ورفع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الوعي لدى المستثمرين&nbsp;بتشريعات القطاع العقاري&nbsp;ودور&nbsp;الأنظمة واللوائح في تطويره&nbsp;ورفع موثوقيته&nbsp;وجاذبيته</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الاستثمارية.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">كما تستعرض الهيئة من خلال المشاركة في الاجتماعات وورش العمل ضمن فعاليات المعرض تجاربها في تنظيم القطاع الإيجاري ونظام البيع على الخارطة وجهودها في السجل العقاري إضافة إلى تعريف الممارسين بنظام الوساطة العقارية والذي يُعد من التنظيمات ذات الاهتمام الدولي في القطاع</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقاري.&nbsp;وكذلك استعراض سياسات حماية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حقوق المتعاملين بالقطاع،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">والمنصات العقارية الرقمية التي يتم من خلالها الوصول لجميع الخدمات العقارية وإنجاز المعاملات واستعراض البيانات والمؤشرات العقارية.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">يذكر أنّ معرض </span></span><span class=\\\"bumpedfont15\\\">EXPO</span><span class=\\\"bumpedfont15\\\"><span> </span></span><span class=\\\"bumpedfont15\\\">REAL</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">&nbsp;الذي يعدّ أكبر معرض تجاري للعقارات والاستثمار في أوروبا،</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يستضيف</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">صنّاع العقارات بأكملها من جميع أنحاء العالم،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">يوفر فرصة للتواصل الفعّال مع الجهات ذات العلاقة، ومنصة للمناقشات البناءة لجميع المشاركين في قطاع العقارات&nbsp;،&nbsp;ويزخر برنامج المعرض بالعديد من الفعاليات والنشاطات والموضوعات التي تناقش أحدث الاتجاهات والابتكارات والتطورات في الاستثمار العقاري وأسواق التمويل، كما يضم منتدى إكسبو ، وملتقى الابتكار، ومنتدى التخطيط والشراكات، ومنتدى المناقشة والتواصل \\\"مرحلة العارضين\\\"، وغراند بلازا، إضافةً إلى مرحلة نقاش التكنولوجيا.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار \" تشارك في المعرض الدولي للعقارات والاستثمار \" EXPO REAL\" بميونخ"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"7aa54171-0ab4-31bf-9334-7974db83bb34","Alias":"الهيئة العامة للعقار تُعلن بدء أعمال السجل العقاري لـ 58 حيًا بمدينة الرياض ومحافظتي الدرعية والمزاحمية","Path":"/8c35feeb-1235-480f-9e12-6838ea8a2a0f.config","Level":4299,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/8c35feeb-1235-480f-9e12-6838ea8a2a0f.config","Node":{"Content":{"@Key":"8c35feeb-1235-480f-9e12-6838ea8a2a0f","@Alias":"الهيئة العامة للعقار تُعلن بدء أعمال السجل العقاري لـ 58 حيًا بمدينة الرياض ومحافظتي الدرعية والمزاحمية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-08T07:34:35","NodeName":{"@Default":"الهيئة العامة للعقار تُعلن بدء أعمال السجل العقاري لـ 58 حيًا بمدينة الرياض ومحافظتي الدرعية والمزاحمية"},"SortOrder":"299","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-07T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a4b56684-7dc6-4727-a1c8-63c9003c7d15\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span><span lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار بدء أعمال التسجيل العيني للعقار بـ 146،478 قطعة عقارية، في 22 حيًا بمدينة الرياض، و25 حيًا بمحافظة المزاحمية، و11 حيًا بمحافظة الدرعية، وذلك ابتداءً من 8 جمادى الأول 1446هـ الموافق 10 نوفمبر 2024م، وتستمر حتى نهاية يوم 14 شعبان 1446هـ الموافق 13 فبراير 2025م.</span></span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;وأوضحت الهيئة أنّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل عددًا من الأحياء بمدينة الرياض وهي: (جزء من حي عريض، وادي لبن، ومدينة الملك عبدالله للطاقة، والوسام، والسحاب، والمرجان، والبشائر، والإسكان، والبرية، والمدينة الصناعية الجديدة، وهيت، وخشم العان، وأُحد، وعكاظ، وديراب، والمنصورية، والحائر، والعماجية، والغنامية، وأم الشعال، والسهباء، والمصفاة)، فيما يشمل التسجيل في محافظة المزاحمية أحياء: (وسيلة، ونوارة، وغرناطة، وطويق، وشخيب، وحضار، والياسمين، والورود، والواحة، والهدا، والمروج، والمحمدية، واللؤلؤة، والغطغط، والعليا، والصناعية، والصقورية، والشلال، والريف، والراشدية، والحزيمية، والحزم، والجامعة، والأندلس، ومشيرفة)، كما يشمل التسجيل أحياءً بمحافظة الدرعية وهي: (الشهداء، وعقرباء، وسلام، والوادي، والعدل، ونجد، والعين، والوصيل، والأمير سلطان، والواحة، وهجرة بوضة)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;وأشارت \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء سيكون مُتاحًا عن طريق <a href=\\\"https://rer.sa/#https://rer.sa/\\\" title=\\\"https://rer.sa/\\\" data-anchor=\\\"#https://rer.sa/\\\">منصة السجل العقاري الإلكترونية </a></span><span>أوعن طريق مراكز الخدمة، مشيرةً إلى أنّ التسجيل العيني يشترط وجود صك ملكية مستوفٍ للمتطلبات النظامية لإتمام عملية التسجيل.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار، وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، حيث يمكن الاستفسار عن</span><span style=\\\"font-family: 'Sakkal Majalla'; font-size: 16pt;\\\">&nbsp;خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; line-height: 107%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;وبينت أنه ابتداءً من الموعد المُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\"، وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار، وأوصافه، وحالته، وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة، بما يُسهم في تعزيز البنية التحتية واستدامة القطاع العقاري؛ حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية، وتعزيز الشفافية في القطاع العقاري.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلن بدء أعمال السجل العقاري لـ 58 حيًا بمدينة الرياض ومحافظتي الدرعية والمزاحمية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9e3e1d9e-1b92-3687-8de5-685190c5efd9","Alias":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس جدة العقاري 2024\"","Path":"/065f5aa3-85ab-472e-88a9-b0f97917fbb7.config","Level":4300,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/065f5aa3-85ab-472e-88a9-b0f97917fbb7.config","Node":{"Content":{"@Key":"065f5aa3-85ab-472e-88a9-b0f97917fbb7","@Alias":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس جدة العقاري 2024\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-09T11:10:44","NodeName":{"@Default":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس جدة العقاري 2024\""},"SortOrder":"300","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-09T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ec5827e7-1f3f-4843-8292-77e7937f205a\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; margin-right: 36.0pt; mso-margin-bottom-alt: auto; line-height: normal;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">تُشارك الهيئة العامة للعقار غدًا في معرض \\\"ريستاتكس جدة العقاري 2024\\\"، الذي يُقام في جدة سوبر دوم خلال الفترة من 10 إلى 13 أكتوبر الجاري،&nbsp;بمشاركةٍ واسعةٍ لكبرى الشركات العقارية والمطوِّرين الذين سيستعرضون أحدث المنتجات والخدمات العقارية الهادفة لتلبية احتياجات وتطلُّعات الأسر السعودية لتملّك المساكن، إضافةً إلى الوسطاء والموسوقين العقاريين، والجهات التمويلية والمستثمرين</span><span>. </span></p>\\n<p style=\\\"mso-margin-top-alt: auto; margin-right: 36.0pt; mso-margin-bottom-alt: auto; line-height: normal;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وتأتي مشاركة الهيئة العامة للعقار في معرض \\\"ريستاتكس جدة العقاري 2024\\\"، ضمن دورها في رفع الوعي العقاري واستكشاف الفرص التطويرية، وتبادل الخبرات والتجارب مع العاملين بالقطاع، وجعل المجتمع شريكًا في ابتكار الحلول لمواجهة التحديات، والمضي نحو آفاق مستقبلية تعزز من قوة السوق العقاري السعودي باعتباره أنموذجًا عالميًا ومحور جذب للاستثمارات والمستثمرين</span><span style=\\\"font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\">.&nbsp; &nbsp;</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; margin-right: 36.0pt; mso-margin-bottom-alt: auto; line-height: normal;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وتستعرض \\\"الهيئة\\\" من خلال فريقها في معرض \\\" ريستاتكس جدة العقاري 2024 \\\" منظومة التشريعات العقارية التي تشمل \\\"نظام ولائحة بيع وتأجير مشروعات عقارية على الخارطة \\\" و \\\"نظام الوساطة العقارية\\\"، و\\\"نظام المساهمات العقارية\\\"، إضافةً إلى التعريف بحقوق المتعاملين بالقطاع، وبخدمات الأنشطة التي تأتي تحت تنظيم الهيئة كبرنامج إيجار، وبرنامج فرز الوحدات العقارية، وبرنامج ملاّك، والمعهد العقاري السعودي، والمركز السعودي للتحكيم العقاري، والسجل العقاري، ومركز خدمة الشركاء</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman';\\\">. </span>&nbsp;</p>\\n<p style=\\\"mso-margin-top-alt: auto; margin-right: 36.0pt; margin-bottom: 14.0pt; line-height: normal;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ معرض \\\"ريستاتكس جدة العقاري 2024\\\"، يأتي بهدف تسليط الضوء على دور القطاع العقاري في تنويع مصادر الاستثمار كأحد أهم أهداف رؤية المملكة 2030. ويستعرض التطورات العقارية والمشاريع السكنية والتجارية متعددة الاستخدامات وتوجهاتها التي من شأنها أن تسهم في ازدهار السوق العقاري السعودي واستدامته وتجعل منه قطاعًا حيويًا يمتلك المرونة العالية للتكيف من المتغيرات المتسارعة</span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman';\\\">.&nbsp;&nbsp; </span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس جدة العقاري 2024\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9d6e7ce4-9da8-3b67-a689-8cb28c9f58ae","Alias":"هيئة العقار \" تختتم مشاركتها في المعرض الدولي للعقارات والاستثمار \" expo real\" بميونخ","Path":"/f0c30099-1117-4f93-be87-5c6b4034c2a7.config","Level":4301,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f0c30099-1117-4f93-be87-5c6b4034c2a7.config","Node":{"Content":{"@Key":"f0c30099-1117-4f93-be87-5c6b4034c2a7","@Alias":"هيئة العقار \" تختتم مشاركتها في المعرض الدولي للعقارات والاستثمار \" expo real\" بميونخ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//expoReal","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-09T17:50:25","NodeName":{"@Default":"هيئة العقار \" تختتم مشاركتها في المعرض الدولي للعقارات والاستثمار \" expo real\" بميونخ"},"SortOrder":"301","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-09T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"f7a57f3d-208f-4049-b15d-7ef3ee598be5\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">اختتمت الهيئة العامة للعقار اليوم مشاركتها في المعرض الدولي للعقارات والاستثمار</span><span> \\\"EXPOREAL\\\" </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">الذي أقيم بمدينة ميونخ في جمهورية ألمانيا الاتحادية خلال الفترة (7 - 9 أكتوبر2024) ، ويُعدّ أكبر معرض تجاري للعقارات والاستثمار في أوروبا يجمع الخبراء والمختصين من مختلف أنحاء العالم لتبادل الرؤى والأفكار حول الحلول المبتكرة لمواجهة التحديات، والتطلعات والآفاق المستقبلية للقطاع العقاري</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">واستعرضت الهيئة من خلال جناحها \\\"بالمعرض\\\" أهم التشريعات العقارية في المملكة التي تُعد من أهم الممكنات والمحفزات لرفع جاذبية الاستثمارات العقارية في المملكة، حيث حرصت \\\"الهيئة\\\" على الاتقاء بقادة وصنَّاع العقارات من مختلف الدول المشاركة في المعرض وتعريفهم بالبيئة الاستثمارية العقارية في المملكة، واستعراض أهم التجارب في التنظيمات العقارية ورفع الوعي لدى المستثمرين بتشريعات القطاع العقاري ودور الأنظمة واللوائح في تطويره ورفع موثوقيته وجاذبيته الاستثمارية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وقدمت\\\" الهيئة \\\" من خلال فريقها المشارك بالمعرض وأنشطته المصاحبة، عددًا من الموضوعات التي تستعرض دور الهيئة في تنظيم القطاع الإيجاري ونظام البيع على الخارطة وجهودها في السجل العقاري, إضافة إلى تعريف الممارسين بنظام الوساطة العقارية والذي يُعد من التنظيمات ذات الاهتمام الدولي في القطاع العقاري, واستعراض سياسات حماية حقوق المتعاملين </span><span style=\\\"font-family: Arial, sans-serif;\\\" lang=\\\"AR-SA\\\">بالقطاع، والمنصات العقارية الرقمية التي يتم من خلالها الوصول لجميع الخدمات العقارية وإنجاز المعاملات واستعراض البيانات والمؤشرات العقارية</span>.</p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span>يذكر أنّ معرض<span> \\\"EXPOREAL \\\" </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">يجمع صنّاع العقارات بأكملها من جميع أنحاء العالم، ويوفر فرصة للتواصل الفعّال مع الجهات ذات العلاقة، ومنصة للمناقشات البناءة لجميع المشاركين في قطاع العقارات ، وقد احتوى برنامج المعرض على العديد من الفعاليات والنشاطات والموضوعات التي ناقشت أحدث الاتجاهات والابتكارات والتطورات في الاستثمار العقاري وأسواق التمويل، كما ضم منتدى إكسبو ، وملتقى الابتكار، ومنتدى التخطيط والشراكات، ومنتدى المناقشة والتواصل \\\"مرحلة العارضين\\\"، وغراند بلازا، إضافةً إلى مرحلة نقاش التكنولوجيا</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار \" تختتم مشاركتها في المعرض الدولي للعقارات والاستثمار \" expo real\" بميونخ"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"647d5c7d-7f11-3298-90bf-b857b5d0c728","Alias":"هيئة العقار\" الأحد القادم تنطلق أعمال القمة العالمية للبروبتك بمشاركة دولية واسعة\"","Path":"/9bb1aa73-aab8-48bf-96c2-fceeed8d0524.config","Level":4302,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/9bb1aa73-aab8-48bf-96c2-fceeed8d0524.config","Node":{"Content":{"@Key":"9bb1aa73-aab8-48bf-96c2-fceeed8d0524","@Alias":"هيئة العقار\" الأحد القادم تنطلق أعمال القمة العالمية للبروبتك بمشاركة دولية واسعة\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-24T09:13:08","NodeName":{"@Default":"هيئة العقار\" الأحد القادم تنطلق أعمال القمة العالمية للبروبتك بمشاركة دولية واسعة\""},"SortOrder":"302","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-24T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1a2cf2ee-9c4a-43b3-af25-290183f5327f\",\n    \"mediaKey\": \"1d468827-5c05-41ca-a6a0-198aa59e708b\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تنطلق أعمال القمة العالمية للبروبتك </span><span>\\\" The Global Proptech Summit \\\" </span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">التي تنظمها الهيئة العامة للعقار يوم الأحد القادم 27 أكتوبر 2024م،&nbsp; في العاصمة الرياض برعاية معالي وزير البلديات والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبدالله الحقيل، وبشراكة استراتيجية مع الشركة الوطنية للإسكان</span>NHC)<span>)، ومشاركة شخصيات بارزة وخبراء ومتخصصين في صناعة العقار والتقنيات العقارية وأكثر من 100متحدثٍ يمثلون 80 دولة يشاركون تجاربهم وخبراتهم&nbsp; ووجهات النظر مع قادة الفكر&nbsp; ، إلى جانب الرؤساء التنفيذيين لكبرى شركات العقار والتقنية العقارية والمستثمرين من مختلف أنحاء العالم</span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\"> </span><span>.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتناقش \\\"القمة \\\" رحلة التحول الرقمي في القطاع العقاري ودور التقنيات الناشئة في تشكيل مستقبل \\\"البروبتك\\\" وآخر ما توصلت إليه تقنيات البناء الحديث ودور تقنيات الواقع الافتراضي والذكاء الاصطناعي في صناعة مستقبل العقار وأتمتة عملياته وخدماته ، إضافة إلى الحديث عن حلول \\\"البروبتك \\\" في التنمية الحضرية واتخاذ القرارات الأكثر ذكاءً بما يسهم في تنمية&nbsp; الاستثمارات و تعزيز الاستدامة المالية ، كما ستسلط القمة الضوء على الدور المحوري للتقنيات العقارية \\\"البروبتك \\\" في سلاسل الإمداد والتحليلات التنبؤية وإدارة المخاطر</span><span> </span><span>&nbsp;، ويصاحب \\\" القمة \\\"&nbsp; معرض تقني عقاري بمشاركة شركات، ومنصات عقارية، وتقنية محلية ودولية، يستعرضون من خلاله الابتكارات التقنية العقارية والجيل القادم منها والتجارب والرؤى المستقبلية للصناعة في ظل التقدم التكنولوجي السريع بما يعزز من تحقيق التوجهات الاستراتيجية للقطاع العقاري في المملكة وريادته تماشيًا مع رؤية السعودية 2030</span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما تستضيف \\\"القمة العالمية للبروبتك \\\" أبرز المنصات العقارية وشركات التقنية المالية ورواد الأعمال والخبراء والشركات الاستشارية والمعاهد التدريبية والمطورين ، وستتضمن القمة عددًا من الإطلاقات والاتفاقيات التي تخدم قطاع التقنية العقارية، وستتناول عددًا من المحاور، منها: النظام التشريعي للتكنولوجيا العقارية، والابتكار وريادة الأعمال في مستقبل التكنولوجيا العقارية، وقوة تقنية الطباعة ثلاثية الأبعاد من المخطط إلى الواقع، و تمثل القمة منصة للشراكات مع الجهات العالمية وبوابة للشركات الناشئة والواعدة والرائدة لعرض حلولها المبتكرة&nbsp; في صناعة العقار والالتقاء بالمستثمرين وأصحاب رؤوس الأموال الجريئة ، حيث أن حجم الاستثمارات في سوق \\\"البروبتك \\\" حقق 42.13 بليون دولار أمريكي لعام 2023 وأن عدد المستثمرين النشطين حول العالم بلغ 3347 مستثمر و 2177 شركة رائدة ، مما يعكس الاهتمام العالمي بهذه الصناعة التي ستكون الرياض بمثابة نقطة انطلاق مثالية للابتكارات الخاصة بالتقنية العقارية العالمية لما تمتاز به المملكة العربية السعودية بموقع جغرافي استراتيجي يربط ثلاث قارات إلى جانب المكانة الاقتصادية وبيئة الأعمال وقوة السوق العقاري بها</span><span> .</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"rtl\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\\\" lang=\\\"AR-SA\\\">و تدعو الهيئة المهتمين والمختصين والباحثين والجهات العاملة في هذا المجال في جميع دول العالم، إلى التسجيل والمشاركة ، والاطلاع على أجندة أعمال القمة من خلال الرابط</span><span> </span><span style=\\\"font-size: 11.0pt; font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\\\"><a href=\\\"https://globalproptechsummit.com/\\\">https://globalproptechsummit.com/</a></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\" الأحد القادم تنطلق أعمال القمة العالمية للبروبتك بمشاركة دولية واسعة\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"6f163863-dba1-39c6-a076-d66d1245f90f","Alias":"\"هيئة العقار\" غدًا تنطلق أعمال القمة العالمية للبروبتك في العاصمة الرياض","Path":"/6d0f69d9-983e-490a-ba0b-15ee840240d7.config","Level":4303,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6d0f69d9-983e-490a-ba0b-15ee840240d7.config","Node":{"Content":{"@Key":"6d0f69d9-983e-490a-ba0b-15ee840240d7","@Alias":"\"هيئة العقار\" غدًا تنطلق أعمال القمة العالمية للبروبتك في العاصمة الرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-26T16:43:55","NodeName":{"@Default":"\"هيئة العقار\" غدًا تنطلق أعمال القمة العالمية للبروبتك في العاصمة الرياض"},"SortOrder":"303","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-26T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a3cc08e4-c39b-4d74-bc01-3709fb8b4a2b\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تنطلق غدًا الأحد أعمال القمة العالمية للبروبتك \\\" </span><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\">The Global Proptech Summit</span><span> \\\" التي تنظمها الهيئة العامة للعقار في العاصمة الرياض برعاية معالي وزير البلديات والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبدالله الحقيل، وبشراكة استراتيجية مع الشركة الوطنية للإسكان</span>NHC<span>))، ومشاركة شخصيات بارزة وخبراء ومتخصصين في صناعة العقار والتقنيات العقارية وأكثر من 100متحدثٍ يمثلون 80 دولة يشاركون تجاربهم وخبراتهم&nbsp; ووجهات النظر مع قادة الفكر&nbsp; ، إلى جانب الرؤساء التنفيذيين لكبرى شركات العقار والتقنية العقارية والمستثمرين من مختلف أنحاء العالم .</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضح المتحدث الرسمي للهيئة العامة للعقار تيسير بن محمد المفرج أن \\\"القمة\\\" ستستضيف أبرز المنصات العقارية وشركات التقنية المالية ورواد الأعمال والخبراء والشركات الاستشارية والمعاهد التدريبية والمطورين ، وستتضمن القمة عددًا من الإطلاقات والاتفاقيات التي تخدم قطاع التقنية العقارية، وستتناول عددًا من المحاور، منها: النظام التشريعي للتكنولوجيا العقارية، والابتكار وريادة الأعمال في مستقبل التكنولوجيا العقارية، وقوة تقنية الطباعة ثلاثية الأبعاد من المخطط إلى الواقع، و تمثل القمة منصة للشراكات مع الجهات العالمية وبوابة للشركات الناشئة والواعدة والرائدة لعرض حلولها المبتكرة&nbsp; في صناعة العقار والالتقاء بالمستثمرين وأصحاب رؤوس الأموال الجريئة.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار \\\"المفرج \\\" إلى أن القمة العالمية للبروبتك ستناقش رحلة التحول الرقمي في القطاع العقاري ودور التقنيات الناشئة في تشكيل مستقبل \\\"البروبتك\\\" وآخر ما توصلت إليه تقنيات البناء الحديث ودور تقنيات الواقع الافتراضي والذكاء الاصطناعي في صناعة مستقبل العقار وأتمتة عملياته وخدماته ، إضافة إلى الحديث عن حلول \\\"البروبتك \\\" في التنمية الحضرية واتخاذ القرارات الأكثر ذكاءً بما يسهم في تنمية&nbsp; الاستثمارات و تعزيز الاستدامة المالية ، كما ستسلط القمة الضوء على الدور المحوري للتقنيات العقارية \\\"البروبتك \\\" في سلاسل الإمداد والتحليلات التنبؤية وإدارة المخاطر&nbsp; ، ويصاحب \\\" القمة \\\"&nbsp; معرض تقني عقاري بمشاركة شركات، ومنصات عقارية، وتقنية محلية ودولية، يستعرضون من خلاله الابتكارات التقنية العقارية والجيل القادم منها والتجارب والرؤى المستقبلية للصناعة في ظل التقدم التكنولوجي السريع بما يعزز من تحقيق التوجهات الاستراتيجية للقطاع العقاري في المملكة وريادته تماشيًا مع رؤية السعودية 2030.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ القمة العالمية للبروبتك تأتي بالتزامن مع ما يشهده السوق العقاري السعودي من ازدهار يجعل منه أكثر طلبًا للحلول المبتكرة التي تلبي الاحتياجات والمتطلبات الخاصة بالنمو السكاني المتسارع ومبادرات المدن الذكية ومشاريع التطوير الطموحة التي تشهدها مختلف مناطق المملكة ، وتدعو الهيئة المهتمين والمختصين والباحثين والجهات العاملة في هذا المجال في جميع دول العالم، إلى التسجيل والمشاركة ، والاطلاع على أجندة أعمالها عبر الرابط</span> <span lang=\\\"AR-SA\\\"><a href=\\\"https://globalproptechsummit.com\\\">https://globalproptechsummit.com</a></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" غدًا تنطلق أعمال القمة العالمية للبروبتك في العاصمة الرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ab9b0e8f-7c64-3291-b686-dbef73b5354d","Alias":"التقنيات العقارية تقود تحولاً جذريًا في قطاع العقارات السعودي","Path":"/85586556-453b-495c-b5a3-88ff03a579c3.config","Level":4304,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/85586556-453b-495c-b5a3-88ff03a579c3.config","Node":{"Content":{"@Key":"85586556-453b-495c-b5a3-88ff03a579c3","@Alias":"التقنيات العقارية تقود تحولاً جذريًا في قطاع العقارات السعودي","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-26T17:16:58","NodeName":{"@Default":"التقنيات العقارية تقود تحولاً جذريًا في قطاع العقارات السعودي"},"SortOrder":"304","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-26T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"10ae3233-6fcd-48c3-b8b3-73ed7b27e7c1\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; mso-ligatures: none;\\\" lang=\\\"AR-SA\\\">يشهد قطاع العقارات في المملكة العربية السعودية تحولًا جذريًا بفضل اعتماد التقنيات العقارية \\\"البروبتك\\\"، التي تعمل على إعادة تشكيل مستقبل العقارات في السعودية من خلال حلول تكنولوجية متقدمة تسهم في رفع كفاءة العمليات العقارية وتقديم تجارب متميزة للمستثمرين والمتعاملين على حدٍ سواء</span><span>.</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; mso-ligatures: none;\\\" lang=\\\"AR-SA\\\">وقد حققت المملكة تقدمًا مذهلًا في التحول الرقمي خلال السنوات الخمس الأخيرة مما أتاح فرصًا جديدة لتعزيز التنمية الرقمية داخل المملكة ،و تُظهر الإحصائيات الصادرة عن وزارة المالية السعودية تأثير الاقتصاد الرقمي المتنامي على الناتج المحلي الإجمالي فقد سجلت المملكة نمواً في الناتج المحلي الإجمالي من القطاع الرقمي بنسبة تزيد على 7% في العام الماضي، وهو ما يشير إلى دوره المتزايد في تحقيق الاستقرار الاقتصادي وتوفير فرص عمل جديدة ، ويعد تبني الهيئة العامة للعقار للتقنيات العقارية \\\"البروبتك\\\" ضمن استراتيجيتها لعملية التحول الرقمي في القطاع العقاري، و زيادة الشفافية والموثوقية به وسهولة الوصول إلى البيانات والمؤشرات العقارية ، وتقديم رؤى مستندة إلى تحليلات دقيقة تدعم قرارات المستثمرين والمطورين. كما تدعم هذه التقنيات الاستدامة من خلال تحسين استهلاك الموارد وترشيد الطاقة في العقارات، بما يتماشى مع أهداف المملكة في بناء مستقبل مستدام ، إضافًة إلى تعزيز امكانيات القطاع العقاري الواعد، وتمكين القطاع الخاص، وزيادة المساهمة في حجم المحتوى المحلي. وفتح أسواق جديدة تسهم في تنويع مصادر الدخل ، ودعم الناتج المحلي غير النفطي، واستحداث فرص عمل مباشرة وغير مباشرة لأبناء الوطن </span><span>.</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; mso-ligatures: none;\\\" lang=\\\"AR-SA\\\">وتأتي النقلة النوعية في قطاع العقارات والتقنيات به نتاج التشريعات العقارية التي بلغت حتى اليوم ١٨ تشريع تشمل أنظمة ولوائح وضوابط تنظيمية ، أسهمت بشكل مباشر في خلق منتجات عقارية مبتكرة ، إضافةً إلى أن البيئة التنظيمية الداعمة في السعودية سهلت الابتكار والاستثمار في مجال التكنولوجيا العقارية ، عطفًا على أن الهيئة العامة للعقار تسعى إلى تعزيز الاستثمار في التقنيات العقارية والوصول إلى مجتمع حيوي واقتصاد مزدهر، من خلال توفير بيئة مناسبة للنمو، ورعاية المواهب وجذب المستثمرين والاستثمارات في القطاع العقاري وتقنياته من أجل بناء مجتمعات سكنية حيوية ومستدامة </span><span>.</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; mso-ligatures: none;\\\" lang=\\\"AR-SA\\\">وتشمل التقنيات العقارية \\\"البروبتك\\\" مجموعة واسعة من التطبيقات التكنولوجية التي تغطي مختلف مراحل العملية العقارية، بدءاً من التخطيط والتصميم والبناء وحتى الشراء والإدارة ، ومن أهم الاتجاهات الملفتة في التقنية العقارية هي الذكاء الاصطناعي، التعلم الآلي، والبيانات الضخمة، والواقع الافتراضي، وإنترنت الأشياء، وهندسة المناخ، وتقنية سلسلة الكتل، الذي يسمح لنا باستخدام أدوات مبتكرة للبحث والتسويق والإدارة، ومع التحسينات التشغيلية تركز التقنية العقارية على دعم تجربة العملاء وإيجاد حلول تقنية لطابعهم الشخصي؛ فهو يعزز التعاملات الرقمية وإدارة الممتلكات أوتوماتيكيًا والاستدامة، ويضيف الطابع الرقمي على الاستثمار العقاري، إضافة إلي المساحة الحرة التي تمكن الرواد من صناعة عقارية ناجحة ومستدامة مُتسمَّة بالابتكار، وترفع مستوى الخدمات المقدمة للمتعاملين بالقطاع العقاري، ومساهمة في رفع جودة المنتجات وخلق منتجات جديدة حيوية وعصرية ومواكبة لمتطلبات المرحلة المستقبلية </span><span>.</span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Times New Roman'; mso-ligatures: none;\\\" lang=\\\"AR-SA\\\">يذكر أن الهيئة العامة للعقار تطلق القمة العالمية للبروبتك&nbsp; بهدف مناقشة رحلة التحول الرقمي في القطاع العقاري ودور التقنيات الناشئة في تشكيل مستقبل العقار وآخر ما توصلت إليه التقنيات الحديثة ، إضافة إلى تسليط الضوء على الدور المحوري للتقنيات العقارية \\\"البروبتك\\\" في سلاسل الإمداد والتحليلات التنبؤية وإدارة المخاطر ، وستتضمن القمة عددًا من الإطلاقات والاتفاقيات التي تخدم قطاع التقنية العقارية، وستتناول عددًا من المحاور، منها: النظام التشريعي للتكنولوجيا العقارية، والابتكار وريادة الأعمال في مستقبل التكنولوجيا العقارية، وقوة تقنية الطباعة ثلاثية الأبعاد من المخطط إلى الواقع </span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"التقنيات العقارية تقود تحولاً جذريًا في قطاع العقارات السعودي"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5d8c6af2-7702-30bc-8005-9d1c8d5e0330","Alias":"\"الحقيل\" في افتتاح القمة العالمية للبروبتك: نتبنى التقنيات العقارية لصناعة بيئات معيشية ذكية ومستدامة","Path":"/33f3d67d-cd5e-4b05-8556-706bd0be65f0.config","Level":4305,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/33f3d67d-cd5e-4b05-8556-706bd0be65f0.config","Node":{"Content":{"@Key":"33f3d67d-cd5e-4b05-8556-706bd0be65f0","@Alias":"\"الحقيل\" في افتتاح القمة العالمية للبروبتك: نتبنى التقنيات العقارية لصناعة بيئات معيشية ذكية ومستدامة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-27T10:41:48","NodeName":{"@Default":"\"الحقيل\" في افتتاح القمة العالمية للبروبتك: نتبنى التقنيات العقارية لصناعة بيئات معيشية ذكية ومستدامة"},"SortOrder":"305","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-27T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"3463ffbf-c887-40d8-92a2-fdad4f9a1067\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">رعى معالي وزير البلديات والإسكان الأستاذ ماجد بن عبدالله الحقيل انطلاق أعمال القمة العالمية للبروبتك \\\" </span>The Global Proptech Summit<span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\"> \\\" التي تنظمها الهيئة العامة للعقار في العاصمة الرياض بشراكة استراتيجية مع الشركة الوطنية للإسكان</span>NHC<span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">))، ومشاركة شخصيات بارزة وخبراء ومتخصصين في صناعة العقار والتقنيات العقارية ومتحدثيين دوليين يمثلون 80 دولة من أنحاء العالم. </span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وأكد معالي \\\" الحقيل \\\" خلال كلمته في افتتاح القمة العلمية للبروبتك على أهمية القمة التي تأتي بالتزامن مع ما يشهده القطاع العقاري المحلي والدولي والإقليمي من حراك كبير على كافة مستوياته، ولعزم المملكة العربية السعودية أن تجعل من الرياض مركزًا عالميًا في قطاع التقنية العقارية تقوده الهيئة العامة للعقار للنهوض بالقطاع العقاري وتطوير بيئته التنظيمية وتهيئة فرصه الاستثمارية، وتوظيف التقنيات العقارية لتحقيق التحول الرقمي وتعزيز الشفافية والكفاءة.</span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وأضاف معالي وزير البلديات والإسكان أن التحول الرقمي جزءًا لا يتجزأ من رؤية السعودية ، حيث نسعى لتحسين جودة الحياة ورفع كفاءة الخدمات المقدمة للمواطنين والمقيمين والزوار والمستثمرين، وهو ما يسهم في تطوير قطاع الإسكان وتعزيز الابتكار في التخطيط الحضري والتطوير العقاري، من خلال تبني تقنيات مثل الذكاء الاصطناعي وإنترنت الأشياء والبيانات الضخمة، لخلق بيئات معيشية أكثر ذكاء واستدامة ، وأنّ هذه التحولات تفتح آفاقًا واسعة للاستثمار، وخاصة في منصات الوساطة والخدمات والتمويل العقاري ، التي تسهم في تسهيل البحث والتعاملات لكل أصحاب العلاقة ، مما يعزز &nbsp;شفافية السوق ويسهل التعاملات بين جميع الأطراف، ويزيد من نمو الناتج المحلي.</span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وشهدت \\\"القمة\\\" في افتتاحها عددًا من الإطلاقات والاتفاقيات التي تخدم قطاع التقنية العقارية، منها إعلان الهيئة العامة للعقار إطلاق مركز بروبتك السعودية ليكون القناة الرئيسية للابتكار في التقنيات العقارية في المملكة العربية السعودية ، بالإضافة إلى اتفاقية تعاون بين هيئة العقار والبرنامج الوطني لتنمية تقنية المعلومات بهدف إقامة تعاون استراتيجي بين الطرفين لاستقطاب المسرعات التي تتبنى أفضل الممارسات العالمية ، ولدعم وتشجيع الشركات التقنية في القطاع العقاري وتقديم الحوافز والاستشارات لها وتمكينها من مباشرة أعمالها.</span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وتناقش جلسات \\\"القمة \\\" التي تستمر على مدى يومين متتاليين النظام التشريعي للتكنولوجيا العقارية، والابتكار وريادة الأعمال في مستقبل التكنولوجيا العقارية، وقوة تقنية الطباعة ثلاثية الأبعاد من المخطط إلى الواقع، ودور تقنيات الواقع الافتراضي والذكاء الاصطناعي في صناعة مستقبل العقار وأتمتة عملياته وخدماته، إضافة إلى الحديث عن حلول \\\"البروبتك \\\" في التنمية الحضرية واتخاذ القرارات الأكثر ذكاءً بما يسهم في تنمية الاستثمارات وتعزيز الاستدامة المالية. </span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وصاحب \\\"القمة \\\" معرض تقني عقاري ضم مشاركة لمجموعة من الشركات الناشئة والمبتكرة، ومنصات عقارية، وتقنية محلية ودولية، يستعرضون من خلاله الابتكارات التقنية العقارية والجيل القادم منها والتجارب والرؤى المستقبلية للصناعة في ظل التقدم التكنولوجي السريع بما يعزز من تحقيق التوجهات الاستراتيجية للقطاع العقاري في المملكة وريادته تماشيًا مع رؤية السعودية 2030.</span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ القمة العالمية للبروبتك تأتي بالتزامن مع ما يشهده السوق العقاري السعودي من ازدهار يجعل منه أكثر طلبًا للحلول المبتكرة التي تلبي الاحتياجات والمتطلبات الخاصة بالنمو السكاني المتسارع ومبادرات المدن الذكية ومشاريع التطوير الطموحة التي تشهدها مختلف مناطق المملكة لبناء مجتمعات حضرية عصرية ومستدامة.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الحقيل\" في افتتاح القمة العالمية للبروبتك: نتبنى التقنيات العقارية لصناعة بيئات معيشية ذكية ومستدامة "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"3d6981e4-009e-3d5b-81bd-b550d60c808a","Alias":"الهيئة العامة للعقار تطلق مركز بروبتك السعودية Sph","Path":"/3575f2da-546b-4a2b-a86e-c549f62d3f81.config","Level":4306,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3575f2da-546b-4a2b-a86e-c549f62d3f81.config","Node":{"Content":{"@Key":"3575f2da-546b-4a2b-a86e-c549f62d3f81","@Alias":"الهيئة العامة للعقار تطلق مركز بروبتك السعودية Sph","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//Sph","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-27T12:52:59","NodeName":{"@Default":"الهيئة العامة للعقار تطلق مركز بروبتك السعودية Sph"},"SortOrder":"306","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-27T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c305489c-c1f8-4a87-b247-f5f9cab5a437\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">أعلن الرئيس التنفيذي للهيئة العامة للعقار المهندس عبدالله بن سعود الحماد عن إطلاق مركز بروبتك السعودية </span><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">&nbsp;</span>Sph<span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">ليكون مركزًا يخدم جميع المهتمين بالتقنية العقارية من داخل المملكة وخارجها، ويُقدم الخدمات التي تُسهم في تمكين أصحاب العلاقة في القطاع ، ورفع كفاءته، وليكون القناة الرئيسية للابتكار في التقنيات العقارية في المملكة العربية السعودية ، جاء ذلك خلال افتتاح القمة العالمية للبروبتك التي تنظمها \\\"الهيئة\\\" بالعاصمة الرياض. </span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وأوضح الرئيس التنفيذي لـ \\\"هيئة العقار\\\" المهندس عبدالله الحماد أنّ التحول الرقمي يشكل أهمية ودورًا محوريًا في جميع مجالات الحياة، سيما في صناعة العقار، وإننا في المملكة العربية السعودية في ظل ما تعيشه كافة القطاعات من دعم غير محدود من لدن القيادة الرشيدة – حفظها الله – لتحتل المملكة مراتب متقدمة في التحول الرقمي بين دول العالم &nbsp;، ومن هذا المنطلق يأتي إطلاق مركز بروبتك السعودية </span>Sph<span>&nbsp;بهدف صناعة بيئة مرنة للاستدامة الابتكارية في القطاع العقاري وتسهيل وتعزيز دخول مقدمي الخدمات إلى السوق المحلي وتحسين جودة الخدمات والمنتجات المقدمة وخلق فرص وظيفية في القطاع ورفع مهارة العاملين &nbsp;و المساهمة في تحقيق مستهدفات الرؤية والاستراتيجية العامة للقطاع العقاري &nbsp;، </span>f<span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">ما يسهم في رفع التصنيفات العالمية للتقنيات العقارية منها مؤشر التنافسية الرقمي ومؤشر الموهبة و تعزيز مكانة المملكة كمركز عالمي للابتكار والاستثمار في مجال العقار ، بالإضافة إلى المساهمة في رفع نسبة الناتج المحلي الاجمالي من الايرادات غير النفطية &nbsp;، حيث سيحقق المركز من سعي \\\"الهيئة\\\" في إصدار الأنظمة والتشريعات التي تُساهم في دعم المُبتكرين والشركات الناشئة وإيجاد بيئة مرنة مع الشركاء لاختبار النماذج المبتكرة وخلق شركات ناشئة مبُتكرِة في مجالات التقنية العقارية.</span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وأشار \\\"الحماد\\\" إلى أن مركز بروبتك السعودية </span>Sph<span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\"> &nbsp;يضم عدد من المبادرات الرئيسية تتمثل في : البيئة التنظيمية التجريبية ومسرعة التقنية العقارية والقمة العالمية للبروبتك ومجلس البروبتك حيث أعلن عن بدء استقبال طلبات الشركات الناشئة لمزاولة أعمالهم وتسهيل إجراءاتهم من خلال البيئة التنظيمية التجريبية </span>Sandbox<span> بهدف تطوير الأطر التنظيمية التي تعكس التقدم التقني وتحقق التوازن بين الابتكار والتنظيمات والتشريعات في قطاع العقارات ولتتيح للشركات الناشئة والمبتكرين في مجال العقار فرصة اختبار وتطبيق التقنيات الجديدة في بيئة واقعية آمنة ومرنة قبل تبنيها على نطاق واسع ، بالإضافة إلى إطلاق &nbsp;مسرعة التقنية العقارية بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات </span>ntdp<span> والشريك العالمي \\\"مسرعة الأعمال الأوروبية </span>Startup Wise Guys<span>\\\" لتكون مثابة حاضنة توفر الموارد والخبرات اللازمة للنمو والتوسع، كما تعد القمة العالمية للبروبتك أحد أهم مبادرات المركز، لتجمع تحت سقف واحد أبرز العقول والخبرات العالمية، وكبار المستثمرين وأصحاب رؤوس الأموال الجريئة التي تتبنى الأفكار ورواد الأعمال والشركات الناشئة في مجال تكنولوجيا، وأنّ مجلس البروبتك يأتي كمنصة لاستضافة الرواد والخبراء في القطاع العقاري وليكون مساحة لتبادل الأفكار والخبرات، واستشراف الفرص والتحديات المقبلة التي ستدفع القطاع نحو آفاق جديدة. </span></p>\\n<p style=\\\"text-align: right; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">يذكر أنّ القمة العالمية للبروبتك التي انطلقت بالعاصمة الرياض تُساهم في تشكيل مستقبل القطاع العقاري من خلال تعزيز التعاون العالمي وتعزيز الممارسات المستدامة وتحديد الحلول المبتكرة، ويمكن وصفها بأنها حدث قيِّم للممارسين العقاريين والتقنيين الذين يسعون إلى البقاء في الطليعة وتوسيع شبكاتهم والمساهمة في تقدم الصناعة.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تطلق مركز بروبتك السعودية Sph "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ae417f59-0361-3eb2-b8f5-a06121df230f","Alias":"القمة العالمية للبروبتك تختتم يومها الأول بالتأكيد على دور السعودية في صناعة المستقبل التقني العقاري","Path":"/4e6296c4-c5ba-4f6c-ac18-92a6d5e54e14.config","Level":4307,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4e6296c4-c5ba-4f6c-ac18-92a6d5e54e14.config","Node":{"Content":{"@Key":"4e6296c4-c5ba-4f6c-ac18-92a6d5e54e14","@Alias":"القمة العالمية للبروبتك تختتم يومها الأول بالتأكيد على دور السعودية في صناعة المستقبل التقني العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-27T19:03:19","NodeName":{"@Default":"القمة العالمية للبروبتك تختتم يومها الأول بالتأكيد على دور السعودية في صناعة المستقبل التقني العقاري"},"SortOrder":"307","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-27T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"4679e51e-472b-45f0-832d-bd7eb6b57d81\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi; color: black;\\\" lang=\\\"AR-SA\\\">اختتم اليوم الأول من أعمال القمة العالمية للبروبتك \\\" </span>The Global Proptech Summit<span> \\\" التي تنظمها الهيئة العامة للعقار في العاصمة الرياض برعاية معالي وزير البلديات والإسكان الأستاذ ماجد بن عبدالله الحقيل ، وبشراكة استراتيجية مع الشركة الوطنية للإسكان</span>NHC<span>))، ومشاركة شخصيات بارزة وخبراء ومتخصصين في صناعة العقار والتقنيات العقارية ومتحدثيين دوليين يمثلون 80 دولة من أنحاء العالم.&nbsp;</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi; color: black;\\\" lang=\\\"AR-SA\\\">واستهلت القمة أعمالها بكلمة معالي وزير البلديات والإسكان الأستاذ ماجد بن عبدالله الحقيل الذي بدوره &nbsp;رحب بضيوف القمة وأكد على أهمية انعقاد القمة العالمية للبروبتك التي تأتي بالتزامن مع ما يشهده القطاع العقاري المحلي و الدولي والإقليمي من حراك كبير على كافة مستوياته ، ولعزم المملكة العربية السعودية أن تجعل من الرياض مركزًا عالميًا في قطاع التقنية العقارية تقوده الهيئة العامة للعقار &nbsp;للنهوض بالقطاع العقاري وتطوير بيئته التنظيمية وتهيئة فرصه الاستثمارية ، وتوظيف التقنيات العقارية لتحقيق التحول الرقمي وتعزيز الشفافية والكفاءة .</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi; color: black;\\\" lang=\\\"AR-SA\\\">بدوره أكد الرئيس التنفيذي للهيئة العامة للعقار م.عبدالله بن سعود الحماد على أنّ التحول الرقمي يشكل أهمية ودورًا محوريًا في جميع مجالات الحياة، سيما في صناعة العقار، في ظل ما تعيشه كافة القطاعات من دعم غير محدود من لدن القيادة الرشيدة – حفظها الله – لتحتل المملكة مراتب متقدمة في التحول الرقمي بين دول العالم، وأن \\\"الهيئة \\\" تسعى لتجعل من القطاع العقاري السعودي &nbsp;قائدًا لعمليات التحول الرقمي العقاري على مستوى التجارب العالمية، بما يعزز من التنافسية في مجالات \\\"(البروبتك \\\" (</span>PropTech<span> .</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi; color: black;\\\" lang=\\\"AR-SA\\\">من جهته أشار الرئيس التنفيذي للشركة الوطنية للإسكان م. محمد بن صالح البطي إلى أنّ عمل \\\"الشركة “في تطوير المنصاتِ الرقميةِ بالشراكة مع القطاعَينِ العامِ والخاص يأتي لتعزيزِ الثقةِ في القطاعِ العقاري، وإعادة هندسة الإجراءات فيه، وتسهيلِ الرحلة علَى المتعاملين من خلال هذه المنصاتِ الرقمية، وبتقديم خدمات مبتكرة ذات قيمة مضافة ترفع من مستوى رضَا المستفيد وتحقق تطلعاته.&nbsp;</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi; color: black;\\\" lang=\\\"AR-SA\\\">كما ناقشت جلسات القمة العالمية للبروبتك في يومها الأول ، الإدارة المتقدمة وتحليل البيانات، ودور التقنيات الناشئة في تشكيل مستقبل \\\"البروبتك\\\" وآخر ما توصلت إليه تقنيات البناء الحديث ودور تقنيات الواقع الافتراضي والذكاء الاصطناعي في صناعة مستقبل العقار وأتمتة عملياته وخدماته ، إضافة إلى الحديث عن حلول \\\"البروبتك \\\" في التنمية الحضرية واتخاذ القرارات الأكثر ذكاءً بما يسهم في تنمية &nbsp;الاستثمارات و تعزيز الاستدامة المالية ، ونوه ضيوف \\\"القمة\\\" بأهمية عقد الشركات على المستوى المحلي والدولي والإقليمي والاستفادة من التجارب التقنية العقارية التي تقود القطاع العقاري على مستوى الدول كافة إلى آفاق جديدة. </span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi; color: black;\\\" lang=\\\"AR-SA\\\">كما شهدت القمة إطلاق الهيئة العامة للعقار \\\"مركز بروبتك السعودية </span>Sph<span>\\\" ليكون مركزًا يخدم جميع المهتمين بالتقنية العقارية من داخل المملكة وخارجها ، ويُقدم الخدمات التي تُسهم في تمكين أصحاب العلاقة في القطاع ورفع كفاءته ، وليكون القناة الرئيسية للإبتكار في التقنيات العقارية في المملكة العربية السعودية &nbsp;، إضافة إلى أن \\\"القمة\\\" شهدت توقيع عدد من الإتفاقيات بهدف استقطاب المسرعات التي تتبنى أفضل الممارسات العالمية ، ولدعم وتشجيع الشركات التقنية في القطاع العقاري وتقديم الحوافز والاستشارات لها وتمكينها من مباشرة أعمالها ، ولتوفير خدمات تأمينية رقمية.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi; color: black;\\\" lang=\\\"AR-SA\\\">يذكر أنّ التقنيات العقارية هي إحدى الممكنات التي تقود القطاع العقاري لرفع كفاءته وفاعليته وتعزيز دوره في تنويع مصادر الدخل وتُعظّم الاستفادة القصوى من التَحوُّل الرقمي الذي تعيشه المملكة العربية السعودية في شتى المجالات وتُساهم بشكل كبير في تحقيق مستهدفات جودة الحياة، وتأخذ القطاع العقاري نحو آفاق واسعة من فرص الاستثمار وجذب المستثمرين لخلق مجتمعات سكنية حيوية ومستدامة.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"القمة العالمية للبروبتك تختتم يومها الأول بالتأكيد على دور السعودية في صناعة المستقبل التقني العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"690817f6-aa36-3ce4-9fec-ff9dc32997df","Alias":"القمة العالمية للبروبتك تستكمل أعمالها بالرياض","Path":"/aa195f07-6fb9-4802-bb59-dad87b606513.config","Level":4308,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/aa195f07-6fb9-4802-bb59-dad87b606513.config","Node":{"Content":{"@Key":"aa195f07-6fb9-4802-bb59-dad87b606513","@Alias":"القمة العالمية للبروبتك تستكمل أعمالها بالرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-28T09:32:25","NodeName":{"@Default":"القمة العالمية للبروبتك تستكمل أعمالها بالرياض"},"SortOrder":"308","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-28T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"86d3caaa-2b56-4b56-b142-55302976def3\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">استكملت لليوم الثاني أعمال القمة العالمية للبروبتك \\\" التي تنظمها الهيئة العامة للعقار في العاصمة الرياض برعاية معالي وزير البلديات والإسكان الأستاذ ماجد بن عبدالله الحقيل، وبشراكة استراتيجية مع الشركة الوطنية للإسكان</span>NHC<span>))، ومشاركة شخصيات بارزة وخبراء ومتخصصين في صناعة العقار والتقنيات العقارية ومتحدثيين دوليين يمثلون 80 دولة من أنحاء العالم.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">وأكد المتحدثين في \\\"القمة\\\" على أهمية الابتكار في تقديم الخدمات ذات القيمة المضافةِ التي ترفع من مستوَى رضَا المستفيد وتحقق تطلعاته، باستخدام التقنيَات الناشئة، وتطبيقات الذكاء الاصطناعِي، وغيرها، للنهوض بالقطاع العقاري وتطوير بيئته التنظيمية وتهيئة فرصه الاستثمارية، وتوظيف التقنيات العقارية لتحقيق التحول الرقمي وتعزيز الشفافية والكفاءة وجعل القطاع العقاري السعودي قائدًا لعمليات التحول الرقمي العقاري على مستوى التجارب العالمية، بما يعزز من التنافسية في مجالات \\\"(البروبتك \\\" (</span>PropTech<span> ، ويصنع مجتمعات سكنية حضرية ومستدامة.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">كما تشهد \\\"القمة\\\" في يومها الثاني استعراض للتقنيات والمنتجات والخدمات المبتكرة وآخر ما توصلت إليه تقنيات البناء الحديث ودور تقنيات الواقع الافتراضي والذكاء الاصطناعي في صناعة مستقبل العقار وأتمتة عملياته وخدماته، التي تعمل على إحداث تحول في قطاع العقارات وسبل تنميته، لرفع كفاءته وفاعليته وتعزيز دوره في تنويع مصادر الدخل وتُعظّم الاستفادة القصوى من التَحوُّل الرقمي الذي تعيشه المملكة العربية السعودية في شتى المجالات.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">يذكر أنّ القمة العالمية للبروبتك التي انطلقت بالعاصمة الرياض تُساهم في تشكيل مستقبل القطاع العقاري من خلال تعزيز التعاون العالمي وتعزيز الممارسات المستدامة وتحديد الحلول المبتكرة، ويمكن وصفها بأنها حدث قيِّم للممارسين العقاريين والتقنيين الذين يسعون إلى البقاء في الطليعة وتوسيع شبكاتهم والمساهمة في تقدم الصناعة.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"القمة العالمية للبروبتك تستكمل أعمالها بالرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9546d3a0-9346-360e-b27f-07c9c6f14e7d","Alias":"اختتام أعمال القمة العالمية للبروبتك في العاصمة السعودية الرياض","Path":"/4fa2ef21-1a81-4665-a37c-c989a47c4ae3.config","Level":4309,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4fa2ef21-1a81-4665-a37c-c989a47c4ae3.config","Node":{"Content":{"@Key":"4fa2ef21-1a81-4665-a37c-c989a47c4ae3","@Alias":"اختتام أعمال القمة العالمية للبروبتك في العاصمة السعودية الرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-28T16:00:29","NodeName":{"@Default":"اختتام أعمال القمة العالمية للبروبتك في العاصمة السعودية الرياض"},"SortOrder":"309","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-28T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"46ce3ff7-d9b5-4d35-a05d-9c4a21157dba\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أكد البيان الختامي الصادر عن القمة العالمية للبروبتك</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">على</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أهمية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الاستثمار في التقنيات العقارية وتعزيز الاقتصاد الرقمي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">اتجاهالمطورين العقاريين للاعتماد على التقنيات العقارية المُتقدمة في مجال البناء وتأسيس البنية التحتية للمشاريع العقارية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">من اجل صناعة مجتمعات حيوية ومستدامة تلبي متطلبات المرحلة المستقبلية.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">جاء ذلك خلال اختتام أعمال القمة العالمية للبروبتك</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التي أقيمت في العاصمة السعودية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الرياض يومي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">27 ،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">28 أكتوبر 2024م بتنظيم من الهيئة العامة للعقار</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وشريكها الاستراتيجي الشركة الوطنية للإسكان</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">NHC</span><span class=\\\"bumpedfont15\\\"><span>))</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،و،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تم خلالها انعقاد</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">50 جلسة علمية وحوارية و40 ورشة عمل قدمها أكثر من 100 متحدث من 80 دولة وحضرها قرابة الـ</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">9000 مستفيد وشاهدها عبر البث الرقمي أكثر من 450 ألف مشاهد على مدى يومي القمة.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوصى قادة العقار</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والبروبتك</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بأهمية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">رفع الوعي في مجال التقنيات العقارية والتوسع في تنظيم الفعاليات والأحداث التي تعزز من التواصل المستمر بين أصحاب المصلحة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، وتطوير التشريعات العقارية أو استحداث تشريعات عقارية جديدة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تتواءم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">مع المتغيرات المتسارعة لاستخدام التقنية العقارية في القطاع العقاري السعودي</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">مع أهمية مشاركة القطاع الخاص في مجالي العقار والتقنية في هذه التشريعات</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، إضافةً إلى ضرورة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">تعزيز أطر التعاون الدولي مع المنظمات الدولية المتخصصة في مجال التقنيات العقارية والشركات ودعم التحالفات بين الشركات المتخصصة في السوق السعودي مع نظيراتها في كافة دول العالم لاستقطاب وتوطين التقنيات والاستفادة من التكنلوجيا العقارية وتبادل الزيارات بالتعاون مع اتحاد الغرف السعودية ، &nbsp;ودعم الجهات الحكومية ذات العلاقة ، وضرورة تنفيذ مبادرات لجذب رؤوس الأموال لمشاريع التقنيات العقارية وتعزيز</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">فعالية هذه الاستثمارات ،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لدفع النمو في قطاع التقنيات العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">، وأن تستمر الشركة الوطنية للإسكان بمبادرتها في دعم وتمكين رواد الأعمال والشركات الناشئة والمبتكرة لتحقيق مستقبل التقنيات العقارية &nbsp;. &nbsp;</span></span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed; margin: 3.75pt 0in 3.75pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\">كما أكدت \\\"القمة\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">بأنَّها تدعم التحول الاقتصادي وتعزيز الاقتصاد الرقمي في المملكة العربية السعودية لتحقيق مستهدفات رؤية السعودية 2030 في تنويع الاقتصاد ، من خلال فتح آفاق جديدة في استثمار التقنيات العقارية في شتى مجالات العمل في القطاع العقاري سواءً ما يتعلق بالتعاملات العقارية أو تقنيات البناء الحديث، وحثتْ القمة المستثمرين للاستفادة من التحول الرقمي الهائل في المملكة والبنية الرقمية المتكاملة التي تدعم أي اقتصاد رقمي</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وأن</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مستقبل الاستثمار العقاري على الصعيدين المحلي والعالمي،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يكمن في استخدام التقنيات الحديثة التي تسهم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">في تعزيز التنمية المستدامة باعتبارها ممكن استثماري وتشغيلي في المباني الخضراء واستخدام الموارد بكفاءة أكبر وتقلل من استنفاذ الموارد الطبيعية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والتقليل من الاحتياج للطاقة واستبدالها بمصادر الطاقة المتجددة .</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s5\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وركز قادة العقار و</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">البروبتك في توصياتهم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">على</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أهمية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">تطوير القوى العاملة والكوادر المتخصصة في مجال التقنيات العقارية ، من خلال تبني برامج تعليمية وتدريبية متخصصة لكافة الممارسين في مجالات الأنشطة العقارية المختلفة ، ودعم الراغبين في مجال الاستثمار في التدريب المتخصص بهدف تنمية المهارات وبناء القدرات في القطاع العقاري بشكل عام وفي مجال التقنيات العقارية بشكل خاص</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، داعين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">مؤسسات التعليم والجامعات على تبني الدراسات المتخصصة والبحوث العلمية وكراسي البحث العملي في مجال التقنيات العقارية لوجود حاجة كبيرة في تطوير التقنيات العقارية باعتبارها علم متجدد واتجاه مستقبلي للتطوير العقاري في المنطقة مما يدفع صناعة التكنولوجيا والبحث نحو تطوير تقنيات ومواد جديدة في البناء والتطوير.</span></span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed; margin: 3.75pt 0in 3.75pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\">ودعت \\\"القمة\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">إلى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الاستفادة من الاتجاه العالمي في استخدام تقنيات الذكاء الاصطناعي في القطاع العقاري باعتباره من أهم التقنيات الحديثة التي تسهم بشكل ملحوظ في التطور التقني السريع وزيادة فرص الابتكار والنمو في القطاع ، ولمساهمته المباشرة في رفع الجودة وزيادة الإمكانات وكفاءة الأعمال وتحسين الإنتاجية ، كما حثت القمة الجهات ذات العلاقة بإنشاء مراكز وطنية داعمة لهذه التقنيات وإنشاء بيئات اختبار خاضعة للرقابة من القطاع العام، مع وضع أطر تنظيمية مرنة، وذلك لتعزيز الابتكار المسؤول، وأن تتبنى</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">&nbsp;الجهات ذات العلاقة بالمؤشرات الوطنية والمؤشرات العقارية إصدار مؤشرات متخصصة للقطاع العقاري تساهم في رفع جودة المنتجات العقارية المعتمدة على التقنيات العقارية وتساهم في وضع معايير ترتبط بخدمة المتعاملين وسهولة الاستخدام والتأثير في تسهيل حياة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المستفيدين، ورصد</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المتغيرات في هذا القطاع .</span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\\n<p style=\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed; margin: 0in 0in 13.5pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s9\\\"><span class=\\\"bumpedfont15\\\">كما</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أشادت القمة بالمبادرة التي أطلقتها الهيئة العامة للعقار بالتعاون مع الشركة الوطنية للإسكان في إطلاق مركز بروبتك السعودية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">sph</span><span class=\\\"apple-converted-space\\\"><span>&nbsp;</span></span><span class=\\\"bumpedfont15\\\">&nbsp;،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الذي يضم البيئة التجريبية والتنظيمية ومسرعة الأعمال وحثت على التوسع في إطلاق مُسرعات التقنيات العقارية واحتواء المبتكرين ورواد الأعمال لرفع مستوى مساهمتهم في المحتوى المحلي من جهة وزيادة مساهمة القطاع العقاري في الناتج المحلي غير النفطي من جهة أخرى .</span></span><span class=\\\"apple-converted-space\\\"> </span></p>\\n<p style=\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed; margin: 0in 0in 13.5pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"s9\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">بدورها قدمت الهيئة العامة للعقار شكرها</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لشريكها الاستراتيجي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الشركة الوطنية للإسكان</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ولضيوف القمة و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">جميع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">شركائها من الجهات الحكومية والخاصة ، والداعمين</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والرعاة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، والخبراء التقنيين والعقاريين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والمتحدثين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">والمستثمرين ورواد الأعمال والشركات الناشئة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">على</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ما قدموه</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">من قيمة إضافية للقمة وزوارها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وللقطاع العقاري على وجه العموم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، وأعلنت</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"الهيئة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"عن</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">إقامة القمة العالمية للبروبتك</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بنسختها الثانية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; line-height: 200%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">في شهر أكتوبر من العام المقبل &nbsp;2025 ، بمشيئة الله تعالى</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"اختتام أعمال القمة العالمية للبروبتك في العاصمة السعودية الرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"481ff564-cf33-32c7-b730-f3e80d7a3ea6","Alias":"\"الهيئة العامة للعقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لــ (12) حي في مدينة الرياض","Path":"/60534850-c99b-458d-a30d-101df567c684.config","Level":4310,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/60534850-c99b-458d-a30d-101df567c684.config","Node":{"Content":{"@Key":"60534850-c99b-458d-a30d-101df567c684","@Alias":"\"الهيئة العامة للعقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لــ (12) حي في مدينة الرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-29T10:20:23","NodeName":{"@Default":"\"الهيئة العامة للعقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لــ (12) حي في مدينة الرياض"},"SortOrder":"310","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-29T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"1525ab88-0037-498a-b738-af9c49eb9d71\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المهلة المحددة للتسجيل العيني الأول للعقار لـ(12) حي بمدينة الرياض، وذلك بنهاية الخميس 31 أكتوبر 2024م الموافق 28 ربيع الثاني 1446هـ.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن نطاق الأحياء التالية: (حي طويق، جزء من حي عريض، حي الملك عبد العزيز، حي السليمانية، حي الوزارات، حي الفاخرية، حي عليشة، حي الصناعية، حي الخالدية، حي الدار البيضاء، حي الدفاع، جزء من حي ضاحية نمار) إلى سرعة المبادرة بتسجيل عقاراتهم من خلال <a href=\\\"https://rer.sa/#https://rer.sa/\\\" title=\\\"https://rer.sa/\\\">منصة السجل العقاري الإلكترونية</a>&nbsp;قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت \\\" الهيئة \\\" أنّ التسجيل العيني للعقار يتيح إصدار \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة له.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يذكر أن الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى مهمة تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة بخدمات وبيانات العقار</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لــ (12) حي في مدينة الرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"0b68c784-5176-35eb-9522-d3b2f964e61b","Alias":"\"هيئة العقار\" تؤكد على أهمية التقنيات العقارية في حفظ الحقوق","Path":"/f32d2eb8-651f-4ed3-a7b6-0ea1725618b6.config","Level":4311,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f32d2eb8-651f-4ed3-a7b6-0ea1725618b6.config","Node":{"Content":{"@Key":"f32d2eb8-651f-4ed3-a7b6-0ea1725618b6","@Alias":"\"هيئة العقار\" تؤكد على أهمية التقنيات العقارية في حفظ الحقوق","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-29T17:21:47","NodeName":{"@Default":"\"هيئة العقار\" تؤكد على أهمية التقنيات العقارية في حفظ الحقوق"},"SortOrder":"311","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-29T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a5c98fca-c05b-40f3-adee-7fd5284e6dc7\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أكدت الهيئة العامة للعقار على أنّ التكنولوجيا تُسهم في تعزيز شفافية وكفاءة التعاملات العقارية، وأنه ومع تقدم الحلول التقنية، أصبح حفظ الحقوق في هذه التعاملات ضرورة حتمية، حيث أن الأنظمة العقارية التقنية الحديثة تشكل دورًا حيويًا في توثيق الحقوق وحمايتها، بما يضمن العدالة لجميع الأطراف المشاركة في العمليات العقارية</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">. </span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت \\\"الهيئة\\\" أنّ القطاع العقاري يشهد نقلة نوعية في عملية التحول الرقمي و التعاملات التقنية العقارية التي تعتمد بشكل كبير على العقود الرقمية الموثقة، و توفر ضمانات قانونية للأطراف حال وقوع نزاعات العقارية لا سمح الله ، وأنها محمية من التزوير أو التلاعب ، وقد خطت \\\"الهيئة\\\" خطوات جادة من خلال اعتماد عقد ايجار موحد من وزارة العدل واستخدامه كسند تنفيذي ، واتاحة توثيق عقد الوساطة العقارية إلكترونيًا وتسجيل واقعة إيجارية حال رفض أحد الأطراف توثيق العقد عبر منصة إيجار ، مضيفةً إلى أنّ التكامل مع الأنظمة الوطنية ، أتاح للمتعاملين التحقق من هويات الأطراف المتعاملة بشكل مؤتمت ودقيق بما يضمن أن التعاملات تتم مع أطراف موثوقة وأن العقارات المسجلة صحيحة ومطابقة للوائح ، حيث يتيح هذا التكامل التحقق من الصكوك العقارية الإلكترونية ، و السجلات التجارية ، وبيانات العقار المراد استئجاره و هوية الوسيط العقاري</span><span> . </span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت \\\"الهيئة\\\" إلى أنّ التقنيات العقارية توفر قنوات دفع إلكترونية آمنة وموثقة، تضمن توثيق وتسجيل جميع المعاملات المالية بين الأطراف بما يقلل من الاعتماد على التعاملات النقدية ويضمن حماية أموال الأطراف، ويمنع الاحتيال أو التلاعب في السجلات المالية ، وحفظ مبلغ الضمان في محفظة إيجار وعدم الإلزام بسداد فواتير الخدمات خارج مدة العقد الإيجاري ، وحساب قيمة الضريبة المضافة آليا و توثيق حق الوسيط العقاري بالسعي ، إضافةً إلى أن التقنية مكنت المتعاملين من توثيق حالة العقار إلكترونيًا من خلال صور ومقاطع فيديو ، مما يتيح للأطراف حفظ حقوقهم في حال حدوث أي تلفيات أو خلافات حول حالة العقار عند الاستلام أو التسليم</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وبينت \\\"الهيئة\\\" أنّه وبفضل التقدم التقني في القطاع العقاري ، أصبح بإمكان المتعاملين الوصول إلى المعروض العقاري من خلال منصات عقارية توفر بيئة آمنة للتواصل بين المشترين والبائعين والوسطاء ، حيث تُلزم هذه المنصات الوسطاء بالإفصاح عن جميع تفاصيل العقارات بما في ذلك رخصهم ومعلومات الملكية، مما يحد من الاحتيال ويضمن حقوق جميع الأطراف ، وأنه ومن خلال توثيق كافة التعاملات والعقود بشكل رقمي ، يمكن حل النزاعات بشكل إلكتروني مما يختصر الوقت والجهد ويعزز من الشفافية والمرونة من خلال منصة المركز السعودي للتحكيم العقاري</span><span style=\\\"font-family: 'Sakkal Majalla';\\\"> . </span></p>\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الهيئة العامة للعقار اختتمت أعمال القمة العالمية للبروبتك أمس الاثنين 28 أكتوبر 2024م , بهدف مناقشة مستقبل التقنيات العقارية واستخداماتها ، حيث أنّ التقنيات العقارية هي إحدى الممكنات التي تقود القطاع العقاري لرفع كفاءته وفاعليته وتعزيز دوره في تنويع مصادر الدخل وتُعظّم الاستفادة القصوى من التَحوُّل الرقمي الذي تعيشه المملكة العربية السعودية في شتى المجالات وتُساهم بشكل كبير في تحقيق مستهدفات جودة الحياة ، وتأخذ القطاع العقاري نحو آفاق واسعة من فرص الاستثمار وجذب المستثمرين لخلق مجتمعات سكنية حيوية ومستدامة .</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تؤكد على أهمية التقنيات العقارية في حفظ الحقوق"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e7ccf962-edbf-310d-9b98-236157d97673","Alias":"\"هيئة العقار \" توقع مذكرة تفاهم مع \" جيه إل إل \" لتبني الأبحاث والدراسات العقارية  وتطوير الكوادر البشرية المتخصصة","Path":"/4373a920-b28a-41e5-b65c-77dc2b1b2aea.config","Level":4312,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4373a920-b28a-41e5-b65c-77dc2b1b2aea.config","Node":{"Content":{"@Key":"4373a920-b28a-41e5-b65c-77dc2b1b2aea","@Alias":"\"هيئة العقار \" توقع مذكرة تفاهم مع \" جيه إل إل \" لتبني الأبحاث والدراسات العقارية  وتطوير الكوادر البشرية المتخصصة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-30T15:00:32","NodeName":{"@Default":"\"هيئة العقار \" توقع مذكرة تفاهم مع \" جيه إل إل \" لتبني الأبحاث والدراسات العقارية  وتطوير الكوادر البشرية المتخصصة"},"SortOrder":"312","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-30T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"bea0816f-da6f-435f-a5d7-d7f69382e78c\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وقعت الهيئة العامة للعقار اليوم الأربعاء 30 أكتوبر 2024م، بحضور معالي وزير البلديات والإسكان الأستاذ ماجد بن عبدالله الحقيل، والسيد كريستيان أولبريتش، الرئيس التنفيذي رئيس شركة \\\"جيه إل</span><span> </span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">إل&nbsp;\\\"،&nbsp;مذكرة&nbsp;تفاهم&nbsp;مع&nbsp;\\\"جيه إل إل\\\"، شركة&nbsp;الاستشارات</span><span> </span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">والاستثمارات&nbsp;العقارية&nbsp;الرائدة&nbsp;عالمياً،&nbsp;وتأتي هذه المذكرة بمثابة شراكة</span><span> </span>استراتيجية&nbsp;تدعم&nbsp;بشكل<span> </span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">مباشر الأهداف الطموحة لرؤية السعودية2030، واستراتيجية القطاع العقاري بما يشمل تطوير مهارات العاملين</span><span> </span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">بالقطاع&nbsp;وتعزيز&nbsp;الابتكار&nbsp;في&nbsp;التكنولوجيا&nbsp;العقارية. &nbsp;</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت \\\"هيئة العقار \\\" أن المذكرة والتي وقعها سعادة رئيس الهيئة م.عبدالله بن سعود الحماد، والسيد</span><span> </span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">سعود&nbsp;السليماني،&nbsp;المديرالاقليمي&nbsp;لشركة&nbsp;\\\"جيه&nbsp;إل&nbsp;إل\\\"&nbsp;في&nbsp;السعودية،&nbsp;تأتي &nbsp;في&nbsp;إطار&nbsp;التعاون عبر&nbsp;عدة&nbsp;مجالات&nbsp;رئيسية،&nbsp;حيث&nbsp;ستعمل&nbsp;\\\"الهيئة\\\" وشركة \\\"جيه إل إل\\\" معاً&nbsp;على&nbsp;تطوير&nbsp;وتقديم&nbsp;برامج تعليمية وتدريبية متخصصة لكافة الممارسين في مجالات الأنشطة العقارية المختلفة&nbsp;،&nbsp;تهدف&nbsp;إلى&nbsp;رفع كفاءة&nbsp;العاملين في&nbsp;قطاع&nbsp;العقارات،&nbsp;وتلبية&nbsp;الطلب&nbsp;المتزايد&nbsp;الذي يشهده سوق&nbsp;العقارات في المملكة العربية&nbsp;السعودية.&nbsp;وتشمل&nbsp;هذه&nbsp;البرامج تبني&nbsp;المناهج والدراسات المتخصصة والبحوث العلمية&nbsp;في القطاع العقاري، وعقد ورش&nbsp;عمل&nbsp;ومنح شهادات&nbsp;معتمدة وتوفير&nbsp;تدريب&nbsp;على رأس العمل،&nbsp;وسوف تستفيد تلك البرامج&nbsp;من&nbsp;الخبرة&nbsp;الواسعة&nbsp;التي تتمتع&nbsp;بها&nbsp;\\\"جيه إل إل\\\" في&nbsp;مختلف مجالات الأعمال&nbsp;لتطوير كوادر بشرية&nbsp;على درجة عالية من المهارة والخبرة في المجال.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكرت \\\"هيئة العقار\\\" أنّ هذا التعاون سيساهم في العمل المشترك لتحسين إدارة البيانات وزيادة وصول الجمهور إلى المعلومات العقارية. وستساهم هذه الجهود في دعم تحول المملكة العربية السعودية نحو سوق أكثر ملاءمة للمستثمرين فضلاً عن دفع عجلة التحسينات الكبيرة في الشفافية وإرساء التزام طويل الأمد بالممارسات العقارية المستدامة والبيئة المبنية، بما يتماشى مع هدفالمملكة المتمثل في تحقيق الحياد الصفري بحلول عام 2060.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما تأتي هذه الشراكة امتدادًا لإطلاق الهيئة العامة للعقار مركز بروبتك السعودية&nbsp;</span>sph<span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;مؤخرًا في القمة العالمية للبروبتك والذي&nbsp;يأتي كمركز يخدم&nbsp;جميع المهتمين بالتقنية العقارية من داخل المملكة وخارجها ، ويُقدم الخدمات التي تُسهم في تمكين أصحاب العلاقة في القطاع&nbsp;، ورفع كفاءته&nbsp;، ويكون القناة الرئيسية للابتكار في التقنيات العقارية في المملكة العربية السعودية، ويتضمن عدد من المبادرات الرئيسية تتمثل في :&nbsp;\\\"البيئة التنظيمية التجريبية\\\"&nbsp;التي تهدف لتطوير&nbsp;الأطر&nbsp;التنظيمية&nbsp;وتحقيق&nbsp;التوازن بين الابتكار والتنظيمات والتشريعات&nbsp;في قطاع العقارات&nbsp;،&nbsp;و\\\"مسرعة التقنية العقارية\\\"&nbsp;لتكون بمثابة حاضنة&nbsp;توفر الموارد والخبرات اللازمة للنمو&nbsp;والتوسع&nbsp;،&nbsp;و\\\"القمة العالمية للبروبتك\\\"&nbsp;التي&nbsp;تجمع تحت سقف واحد أبرز العقول والخبرات&nbsp;العالمية، وكبار المستثمرين وأصحاب رؤوس الأموال الجريئة التي تتبنى الأفكار ورواد الأعمال والشركات الناشئة&nbsp;،إضافةً إلى \\\"مجلس البروبتك\\\"&nbsp;الذي يعد&nbsp;مساحة&nbsp;لتبادل الأفكار&nbsp;والخبرات،&nbsp;واستشراف الفرص والتحديات&nbsp;المقبلة التي&nbsp;ستدفع القطاع نحو آفاق&nbsp;جديدة. &nbsp;.&nbsp;</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: normal; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يذكر أنّ \\\" جيه إل إل \\\"&nbsp;افتتحت مقرها بالعاصمة السعودية الرياض أمس الثلاثاء 29 أكتوبر 2024 ، وتعد&nbsp;شركة&nbsp;\\\"جيه إل إل \\\"&nbsp;رائدة في مجال الخدمات المهنية ومتخصصة في إدارة العقارات والاستثمارات.،&nbsp;وعلى مدار أكثر من 200&nbsp;عام،&nbsp;حققت لعملائها&nbsp;شراء وبناء وإشغال وإدارة مجموعة متنوعة من العقارات التجارية والصناعية والفندقية والسكنية ومنافذ التجزئة والاستثمار فيها&nbsp;، وهي&nbsp;واحدة من الشركات المدرجة في قائمة فورتشن لأفضل 500 شركة بحجم إيرادات سنوية بلغ 20.9 مليار دولار، وتعمل في أكثر من 80 دولة&nbsp;.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار \" توقع مذكرة تفاهم مع \" جيه إل إل \" لتبني الأبحاث والدراسات العقارية  وتطوير الكوادر البشرية المتخصصة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"002c8470-2639-30c4-ac67-75aa26b0f15d","Alias":"\"الهيئة العامة للعقار\" تُنفذ 15 جولة رقابية مشتركة خلال شهر أكتوبر لضمان الامتثال في السوق العقاري","Path":"/4b357b48-fa3a-49d2-a723-7320c0b9dbc8.config","Level":4313,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4b357b48-fa3a-49d2-a723-7320c0b9dbc8.config","Node":{"Content":{"@Key":"4b357b48-fa3a-49d2-a723-7320c0b9dbc8","@Alias":"\"الهيئة العامة للعقار\" تُنفذ 15 جولة رقابية مشتركة خلال شهر أكتوبر لضمان الامتثال في السوق العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-10-31T09:55:29","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُنفذ 15 جولة رقابية مشتركة خلال شهر أكتوبر لضمان الامتثال في السوق العقاري"},"SortOrder":"313","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-10-31T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"086bc541-d2a0-4139-a133-27272af4f199\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">نفذت الهيئة العامة للعقار بمشاركة وزارة الموارد البشرية والتنمية الاجتماعية خلال شهر أكتوبر، 15 جولة رقابية مشتركة شملتْ زيارة 192 منشأة عقارية في كل من منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة بالإضافة إلى منطقة المدينة المنورة بالتعاون مع أمانة المنطقة ، وتأتي هذه الجولات بهدف ضمان الامتثال للتشريعات العقارية بشكل عام ونظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين، وتحسين المشهد الحضري للارتقاء بجودة الحياة التي تعد من أهداف رؤية المملكة 2030.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليه لتنظيم السوق العقاري، حيث قامت فرقها الرقابية خلال الفترة ذاتها بتنفيذ 19,633 عملية رقابية ميدانية، نتج عنها رصد 764 إعلاناً عقارياً مخالفاً بالأماكن العامة، كما تلقت الهيئة 271 بلاغاً عقارياً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها، فيما بلغ عدد عمليات المسح الإلكتروني أكثر من 13717 عملية، حيث تنتهج الهيئة الرقابة الإلكترونية التي تستهدف القنوات الرقمية والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة العقارية الرقمية وفق الأنظمة واللوائح.&nbsp;</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغاءه أو الغرامات المالية،&nbsp; وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها، كما دعت الهيئة المواطنين والمقيمين إلى تقديم بلاغاتهم في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم&nbsp;( 199011 ) للاستفسارات العقارية.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُنفذ 15 جولة رقابية مشتركة خلال شهر أكتوبر لضمان الامتثال في السوق العقاري"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d77186f2-de1c-38af-8c21-a1e7ea09bb91","Alias":"\"هيئة العقار \" تشارك في المنتدى الحضري العالمي بالقاهرة","Path":"/9ed8b6af-0d0b-497a-ace7-8a9b8925b66d.config","Level":4314,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/9ed8b6af-0d0b-497a-ace7-8a9b8925b66d.config","Node":{"Content":{"@Key":"9ed8b6af-0d0b-497a-ace7-8a9b8925b66d","@Alias":"\"هيئة العقار \" تشارك في المنتدى الحضري العالمي بالقاهرة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-03T14:13:02","NodeName":{"@Default":"\"هيئة العقار \" تشارك في المنتدى الحضري العالمي بالقاهرة"},"SortOrder":"314","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-03T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"80077253-584c-4c31-81cd-8489bf39b711\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">تشارك الهيئة العامة للعقار في المنتدى الحضري العالمي المقام&nbsp;بمدينة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">القاهرة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في جمهورية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مصر العربية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خلال الفترة (4–8 نوفمبر</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2024م)،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ضمن جناح السعودية الذي يضم أ&nbsp;كثر من 30 جهة وطنية حكومية وخاصة،</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وتأتي المشاركة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">بهدف إبراز دور المملكة الريادي في تحقيق المستهدفات العالمية للتنمية الحضرية المستدامة ومشاركتها في صياغة المشهد الحضري الإقليمي والعالمي.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وتأتي مشاركة الهيئة العامة للعقار في \\\"</span></span><span class=\\\"bumpedfont15\\\">المنتدى الحضري العالمي</span><span class=\\\"bumpedfont15\\\">\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2024</span><span class=\\\"bumpedfont15\\\">م</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الذي يعد كأكبر حدث عالمي لمناقشة تحديات التنمية الحضرية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المستدامة،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ضمن دورها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لتعزيز</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التعاون بين قادة الصناعةالعقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وصانعي السياسات والخبراء من جميع أنحاء العالم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مما يعزز تذليل التحديات ويدفع بنمو القطاع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقاري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">السعودي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لآفاقمستقبلية أكثر حداثة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وعصرية،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خلال تبني</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">أفضل الممارسات العالمية في التخطيط والتصميم الحضري المستدام، مما يضمن توافق مشاريع التنمية الحضرية مع مبادئ الاستدامة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والمسؤولية.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وتستعرض الهيئة من خلال</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الجلسات الحوارية التي تشارك بها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وورش العمل التي تعقدها في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المنتدى الحضري العالمي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">منظومةالتشريعات العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بما فيها</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">نظام التسجيل العيني للعقارات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"السجل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقاري\\\" الذي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يُعد ركيزة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أساسية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لتحقيق التحول الحضري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ويُسهم في تنظيم حيازة الأراضي وتسجيل الملكيات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بكل شفافية ودقة،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بالإضافة إلى استعراض</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\" نظام ولائحة بيع وتأجير مشروعات عقارية على الخارطة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">كما ستركز مشاركة الهيئة على إبراز</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الفرص والممكنات الاقتصادية الاستثمارية بالسوق العقاري السعودي والدور المحوري للابتكار والتحول الرقمي واستخداما التكنولوجيا العقارية بالسعودية &nbsp;في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">فتح آفاق مستقبلية لصناعة العقار،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مما يتيح للمطورين والمستثمرين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المحليين والدوليينالاستفادة المثلى من الأصول</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والممكنات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقارية،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وبناء مجتمعات حضرية مستدامة تؤكد على متانة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">البيئة الاستثمارية وسوق العقارات بالسعودية.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">جناح السعودية المشارك بالمنتدى الحضري العالمي يمتد</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">على مساحة أكثر من 3000 م2، ويضم منطقة للاجتماعات وورش العمل والجلسات الحوارية، ومنصات للتوقيع ومنطقة لكبار الشخصيات وأجنحة الجهات الوطنية المشاركة، كما يشهد الجناح تنظيم أكثر من 40 نشاطًا تفاعلياً و150 ممثلًا للجهات</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">السعودية،ويشمل جدول أعمال المشاركة السعودية إحدى عشرة جلسة رفيعة المستوى تناقش التحديات والحلول المتعلقة بالتنمية الحضرية؛ أبرزها إسكان المستقبل، والمدن وتحديات المناخ والتطورات التكنولوجية.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار \" تشارك في المنتدى الحضري العالمي بالقاهرة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"43bd7172-410e-3d68-8257-c3f9ea2e3a9f","Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (24) حياً بمنطقة مكة المكرمة","Path":"/60f5a8dc-2f4f-45d8-8123-f0457fcb8fe5.config","Level":4315,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/60f5a8dc-2f4f-45d8-8123-f0457fcb8fe5.config","Node":{"Content":{"@Key":"60f5a8dc-2f4f-45d8-8123-f0457fcb8fe5","@Alias":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (24) حياً بمنطقة مكة المكرمة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-06T08:10:42","NodeName":{"@Default":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (24) حياً بمنطقة مكة المكرمة"},"SortOrder":"315","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-06T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in 0in 0.0001pt; text-align: justify; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن بدء أعمال التسجيل العيني للعقار لـ (37،023</span></span><span class=\\\"apple-converted-space\\\">)&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">قطعة عقارية&nbsp;لـ&nbsp;(24)</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">حياً</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">بمنطقة مكة المكرمة، ابتداءً</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">من&nbsp;8&nbsp;ديسمبر&nbsp;2024م، الموافق&nbsp;7 جمادى</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الآخرة&nbsp;</span><span class=\\\"apple-converted-space\\\">1446</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">هـ، وحتى نهاية يوم&nbsp;13&nbsp;مارس</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">2025م الموافق&nbsp;13&nbsp;رمضان</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">1446هـ..</span></p>\\n<p style=\\\"margin: 0in 0in 0.0001pt; text-align: justify; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية بمنطقة مكة المكرمة هي: (حي الشامية الجديد ، جزء من حي الشبيكة الجديد ، جزء من حي الفلق الجديد ، جزء من حي حارة الباب الجديد ، جزء من حي القشاشية الجديد ، جزء من حي المسيال الجديد ، جزء من حي الهجلة الجديد ، جزء من حي طوى ، جزء من حي طيبة ، جزء من حي الحمراء، جزء من حي اليمامة ، جزء من حي الخضراء ، جزء من حي معاد ، جزء من حي الجامعة ، جزء من حي السنابل ، جزء من حي التروية ، جزء من حي الشرائع، جزء من حي المقام، جزء من حي وادي جليل ، جزء من حي الصفا، جزء من حي المغمس ، وأجزاء من حي العدل، وأجزاء من حي قرطبة، وأجزاء من حي الخضراء)، مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</span></span></p>\\n<p style=\\\"margin: 0in 0in 0.0001pt; text-align: justify; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت ”هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء سيكون مُتاحًا عن طريق <a href=\\\"https://rer.sa/#https://rer.sa/\\\" title=\\\"https://rer.sa/\\\" data-anchor=\\\"#https://rer.sa/\\\">منصة السجل العقاري الإلكترونية&nbsp;</a></span></span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أو عن طريق مراكز&nbsp;الخدمة،&nbsp;مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.&nbsp;</span></span></p>\\n<p style=\\\"margin: 0in 0in 0.0001pt; text-align: justify; unicode-bidi: embed;\\\" dir=\\\"rtl\\\" class=\\\"s7\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 18.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات&nbsp;الجيومكانية&nbsp;الدقيقة بما يُسهم في&nbsp;تعزيز البنية&nbsp;التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (24) حياً بمنطقة مكة المكرمة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"74416e06-56a8-374c-9e6b-542b7d8f6ba3","Alias":"رئيس هيئة العقار: المنتدى الحضري العالمي«WUF12» يعزز من الشراكة المحلية والدولية في مواجهة التحديات الحضرية وبناء مجتمعات عصرية مستدامة","Path":"/1223ca5c-85bb-4160-a9ed-380858c97277.config","Level":4316,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1223ca5c-85bb-4160-a9ed-380858c97277.config","Node":{"Content":{"@Key":"1223ca5c-85bb-4160-a9ed-380858c97277","@Alias":"رئيس هيئة العقار: المنتدى الحضري العالمي«WUF12» يعزز من الشراكة المحلية والدولية في مواجهة التحديات الحضرية وبناء مجتمعات عصرية مستدامة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//WUF12","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-06T08:54:24","NodeName":{"@Default":"رئيس هيئة العقار: المنتدى الحضري العالمي«WUF12» يعزز من الشراكة المحلية والدولية في مواجهة التحديات الحضرية وبناء مجتمعات عصرية مستدامة"},"SortOrder":"316","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-05T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c3055b93-7b9c-4fc5-9d53-64be059c48f7\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">أكد الرئيس التنفيذي للهيئة العامة للعقار المهندس عبدالله بن سعود الحماد, أنّ المملكة العربية السعودية، بقيادة خادم الحرمين الشريفين الملك سلمان بن عبدالعزيز آل سعود وصاحب السمو الملكي الأمير محمد بن سلمان بن عبد العزيز آل سعود - حفظهما الله -، تسير بخطى واثقة نحو تحقيق رؤيتها لمستقبلها وشعبها والمنطقة عمومًا ومن أجل صناعة مستقبل حضري أكثر تقدمًا وانسجامًا مع معايير الاستدامة والتحديات البيئية العالمية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وأوضح المهندس الحماد أنّ مشاركة \\\"الهيئة\\\" في المنتدى الحضري العالمي</span><span> «WUF12» </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">تأتي انطلاقًا من إيمانها بأهمية التعاون والشراكة المحلية والدولية في مواجهة التحديات الحضرية وبناء مجتمعات عصرية مستدامة تدعم المرونة والتكيف مع متغيرات العصر الحالي والمستقبلي، بالإضافة إلى الاطلاع على أحدث الممارسات والتجارب العالمية لبناء مدن المستقبل التي تلبي احتياجات المواطنين والزوار والمستثمرين، وتعزز من جودة الحياة بما يحقق صناعة مجتمعات متكاملة أكثر حيوية وتطورًا وابتكارًا لمواجهة التحديات المستقبلية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">جاء ذلك في كلمة ألقاها المتحدث الرسمي للهيئة العامة للعقار تيسير بن محمد المفرج, خلال المنتدى الحضري العالمي نيابة عن الرئيس التنفيذي للهيئة أنّ المملكة انتهجت ضمن رحلتها لتطوير المدن نهج معالجة العشوائيات وتحويلها إلى مجتمعات حيوية مستدامة للارتقاء بحياة المواطن والمقيم والزائر وتوفير السكن الملائم، مما يؤكد على أهمية إعادة تشكيل خارطة المدن بما يحقق أنسنتها واستدامتها وتعزيز بناها التحتية بمختلف أشكالها وأوجهها، ومنها البنية التحتية القانونية للعقارات التي تشكل دورًا حيويًا في بناء مدن المستقبل المستدامة، وأنّ التحديات الحضرية التي يواجهها العالم تحتاج إلى تعاون دولي لتطوير حلول مشتركة ومبتكرة ترتكز على رؤية شمولية ومستقبلية للتخطيط العمراني الذي يخدم مدننا ومستقبل أبنائنا، مع الأخذ بعين الاعتبار كافة الأبعاد البيئية والاقتصادية والاجتماعية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">وأكد أنّ منظومة الإسكان والعقار بالمملكة مستمرة في سعيها لخلق توازن بين التنمية العمرانية والتنوع البيئي، وإنشاء بيئة حضرية تُعزز من رفاهية السكان، حيث إن التشريعات العقارية في القطاع العقاري السعودي أسهمت في حوكمة القطاع وأتاحت المرونة للنمو والتكيف مع المتغيرات، لبناء مجتمعات تعتمد على الطاقة المتجددة، وتُدار بتقنيات الذكاء الاصطناعي، وتؤسس لنمط حياة أكثر استدامة وتوازنًا بين الإنسان والطبيعة، وأن نظام التسجيل العيني للعقارات \\\"السجل العقاري \\\" يُعد ركيزة أساسية لتحقيق هذا التحول الحضري ويُسهم في تنظيم حيازة الأراضي وتسجيل الملكيات بكل شفافية ودقة، مما يتيح للمطورين والمستثمرين المحليين والدوليين الاستفادة المثلى من الأصول العقارية، ويعزز الموثوقية في البيئة الاستثمارية وسوق العقارات بالسعودية</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span>يُذكر أنّ المنتدى الحضري العالمي \\\"12<span> WUF\\\" </span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">يُعَد أحد أبرز مؤتمرات الأمم المتحدة ويُعنى بالتنمية الحضرية المستدامة، مستهدفًا معالجة قضية التحضر العالمي، بوصفها أحد أكثر القضايا إلحاحًا والتي تواجه العالم اليوم، وتشارك \\\"الهيئة\\\" فيه من خلال فريقها والجلسات الحوارية التي تشارك بها وورش العمل التي تعقدها للتعريف بالتشريعات العقارية بما فيها \\\"نظام ولائحة بيع وتأجير مشروعات عقارية على الخارطة\\\"، بالإضافة إلى إبراز الدور المحوري للابتكار والتحول الرقمي واستخداما التكنولوجيا العقارية بالسعودية في فتح آفاق مستقبلية لصناعة العقار، واستعراض دور نظام التسجيل العيني للعقارات \\\"السجل العقاري\\\" الذي يُعد ركيزة أساسية لتحقيق التحول الحضري</span><span>.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-spacerun: yes;\\\">&nbsp;</span><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">كما تشارك الهيئة العامة للعقار في المنتدى ضمن دورها لتعزيز التعاون بين قادة الصناعة العقارية وصانعي السياسات والخبراء من جميع أنحاء العالم</span><span>.</span></p>\\n<p>&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار: المنتدى الحضري العالمي«WUF12» يعزز من الشراكة المحلية والدولية في مواجهة التحديات الحضرية وبناء مجتمعات عصرية مستدامة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"bdcaacf6-5f61-382c-9b63-cc35bd6873ab","Alias":"الرئيس التنفيذي لهيئة العقار : معرض سيتي سكيب 2024 سيسهم في تحقيق أهداف القطاع العقاري وجذب المزيد من الاستثمارات المحلية والدولية","Path":"/dfc59385-4c49-400f-8052-70740667b27e.config","Level":4317,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/dfc59385-4c49-400f-8052-70740667b27e.config","Node":{"Content":{"@Key":"dfc59385-4c49-400f-8052-70740667b27e","@Alias":"الرئيس التنفيذي لهيئة العقار : معرض سيتي سكيب 2024 سيسهم في تحقيق أهداف القطاع العقاري وجذب المزيد من الاستثمارات المحلية والدولية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-07T17:44:55","NodeName":{"@Default":"الرئيس التنفيذي لهيئة العقار : معرض سيتي سكيب 2024 سيسهم في تحقيق أهداف القطاع العقاري وجذب المزيد من الاستثمارات المحلية والدولية"},"SortOrder":"317","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-07T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"a03167e3-23b6-488c-a9a7-8b5c24b9e0c0\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">كشف الرئيس التنفيذي للهيئة العامة للعقار المشرف العام على معرض سيتي سكيب العالمي 2024 المهندس</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">عبد الله</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بن سعود الحماد</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خلال اللقاء التعريفي \\\"بسيتي سكيب\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أنَ المعرض</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الذي يعد</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الحدث العقاري الأكبر والأضخم عالميًا،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وتستضيفه</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">السعودية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">للعام الثاني، برعاية وزارة والبلديات والإسكان وبالشراكة بين الهيئة العامة للعقار، وبرنامج الإسكان أحد برامج رؤية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2030.</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">سيقام بنسخته الثانية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خلال الفترة من 11 إلى 14 نوفمبر المقبل في</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مركز الرياض للمعارض والمؤتمرات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"ملهم\\\" بالعاصمة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الرياض تحت شعار</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"مستقبل الحياة\\\" ،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وسيشهد تجمع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أكثر من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">400</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">جهة عارضة من أهم وأكبر الشركات العالمية والوطنية في مجال الاستثمار والتطوير العقاري، وأكثر من</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">100</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">من مستثمر مؤسسي، وأكثر من 500 من قادة القطاع الدوليين والمحليين.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\">وأضاف</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الرئيس التنفيذي \\\"لهيئة العقار \\\"</span><span class=\\\"bumpedfont15\\\">&nbsp;أن استضافة المملكة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العربية السعودية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لهذا المعرض تعكس النهضة العقارية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الكبرى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تعيشها في ظل رؤية السعودية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2030، مما يعزز دور</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">القطاع العقاري باعتباره</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">محركًا</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">رئيسيًا للاقتصاد الوطني،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وأنّ \\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">معرض سيتي سكيب العالمي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">2024</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">\\\" سيساهم في تحقيق أهداف القطاع العقاري من خلال توفير منصات متعددة وتجارب متميزة لعرض الابتكارات، وتبادل التجارب، والتقنيات العقارية ، بما يسهم في زيادة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">الفرص الاستثمارية المتنوعة في السوق العقاري السعودي، وجذب المزيد من الاستثمارات الأجنبية، لتنويع الاقتصاد، وتعزيز التنمية المستدامة، حيث حققت النسخة الماضية من \\\"المعرض \\\" نجاح في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">حجم والمعاملات والمشاريع الاستثمارية والاتفاقيات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الاستراتيجية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بأكثر من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">110</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مليار ريال، والاستثمارات الخارجية بأكثر من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">19</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مليار دولار، وفي هذه النسخة نطمح لنحقق ارتفاع بنسبة تتجاوز</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">50%.</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأشار \\\"الحماد \\\" إلى أنّ النجاحات السابقة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">زادت الفرص هذا العام ومنها توفير أكثر من</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">100</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ألف وحدة سكنية بعروض حصرية وحلول تمويلية تسهل رحلة التملك</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">للمساكن،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">إضافة إلى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">استعراض للمشاريع الفريدة والفرص المتنوعة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">يقدمها الشركاء، مثل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الشركة الوطنية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">للإسكان</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">نيوم،و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">روشن،والمربع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الجديد و</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مركز الملك عبدالله المالي (كافد)، والدرعية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">، كما ستتيح هذه النسخة من \\\"المعرض \\\" العديد من الفرص الاستثمارية العقارية من خلال أكبر مزاد عقاري</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مباشر في الشرق الأوسط بالتعاون مع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مركز الإسناد والتصفية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">(إنفاذ)، تتجاوز قيمته التقديرية مليار ريال</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">وما</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">نشهده اليوم من نهضة في القطاع العقاري يأتي نتاج البنية التحتية القانونية التي أوجدتها التشريعات العقارية مما يعزز من متانة السوق العقاري السعودي والموثوقية به ويجعله جاذب للاستثمارات والمستثمرين .</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s8\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">يذكر أن \\\"</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">معرض سيتي سكيب العالمي 2024</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">\\\"</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">سيتيح</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">للمستثمرين الشباب وأصحاب الشركات الناشئة،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">فرص</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">التواصل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المباشر مع المستثمرين والمطورين العقاريين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">المحليين والدوليين، وعرض مشاريعهم وأفكارهم، مع فرصة الفوز بجوائز تصل إلى</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">1.5</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مليون ريال في مسابقة \\\"روشن</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">هاكثون2024\\\" التي تهدف</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">إلى تشجيع الابتكار والإبداع في إيجاد حلول تكنولوجية مبتكرة لمعالجة التحديات الكبرى في القطاع العقاري باستخدام مختلف التقنيات الحديثة.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الرئيس التنفيذي لهيئة العقار : معرض سيتي سكيب 2024 سيسهم في تحقيق أهداف القطاع العقاري وجذب المزيد من الاستثمارات المحلية والدولية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"316aa368-aa62-3e44-be97-32e347254140","Alias":"هيئة العقار تختتم مشاركتها في المنتدى الحضري العالمي «WUF12» وتؤكد أن الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل","Path":"/7142342f-e6b4-4223-9cd7-a3b41407778e.config","Level":4318,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/7142342f-e6b4-4223-9cd7-a3b41407778e.config","Node":{"Content":{"@Key":"7142342f-e6b4-4223-9cd7-a3b41407778e","@Alias":"هيئة العقار تختتم مشاركتها في المنتدى الحضري العالمي «WUF12» وتؤكد أن الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//WUF12","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-10T08:46:17","NodeName":{"@Default":"هيئة العقار تختتم مشاركتها في المنتدى الحضري العالمي «WUF12» وتؤكد أن الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل"},"SortOrder":"318","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-10T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"e707fd3c-8153-4913-85ac-f666350e8be6\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">اختتمت الهيئة العامة للعقار ضمن وفد المملكة العربية السعودية مشاركتها في المنتدى الحضري العالمي \\\"</span>WUF12<span>\\\" الذي أُقيم بالعاصمة المصرية خلال الفترة من 4 إلى 8 نوفمبر 2024، استعرضت فيها أهم التشريعات العقارية بالمملكة، والتي تُعد من أهم الممكنات لتحقيق أهداف التنمية الحضرية وبناء مدن ومجتمعات عصرية ومستدامة، تسهم في تحقيق جودة الحياة وتدعم الحراك الاقتصادي وترفع جاذبية الاستثمارات العقارية بالمملكة. <br>واستعرضت الهيئة خلال مشاركتها في الاجتماعات وورش العمل المقامة ضمن فعاليات المنتدى، أهم التجارب في التنظيمات العقارية، ورفع الوعي لدى المستثمرين بتشريعات القطاع العقاري، ودور الأنظمة واللوائح في تطويره ورفع موثوقيته وجاذبيته الاستثمارية</span><span>.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار المتحدث الرسمي مدير عام الاتصال الاستراتيجي للهيئة العامة للعقار أ. تيسير بن محمد المفرج خلال كلمة ألقاها ضمن أعمال المنتدى، أن القطاع العقاري في السعودية، يخطو خطوات واثقة وسط تشريعات تنظيمية تتسم بالحيوية والمرونة بعد نقلته النوعية التي كانت نتاج التوجهات الاستراتيجية التي غيرت وجه السوق العقاري السعودي تمامًا وانطلقت به إلى آفاق مستقبلية تتسم بالحيوية والمرونة والتكييف مع متطلبات التنمية الحضرية وبناء مدن المستقبل المستدامة.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما أكد المتحدث الرسمي للهيئة أنّ الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل والطريق ممهد لكافة أراد المستثمرين من حول العالم، إما بشكل مباشر أو حتى من خلال تكوين رأس المال، وأن التشريعات العقارية كنظام المساهمات العقارية ونظام بيع وتأجير مشروعات عقارية على الخارطة من ممكنات الاستثمارات العقارية، وتعتبر قنوات تمويلية مرنة بالتوازي مع الصناديق&nbsp;الاستثمارية&nbsp;العقارية، مما يعزز&nbsp;حماية&nbsp;المستثمرين واستثماراتهم في القطاع العقاري السعودي ، مما يمثل فرصًا فريدة ، سيما في البنية التحتية والمرافق العقارية، لما تشهده المملكة من طفرة في تطوير الملاعب، والفنادق، والمنشآت التجارية، والمرافق الترفيهية التي ستظل ذات قيمة طويلة الأجل خاصة في ظل المشاريع الكبرى التي تستعد المملكة لاستضافتها .</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">واستعرض فريق \\\"الهيئة\\\" خلال الجلسات الحوارية وورش العمل في \\\"المنتدى الحضري \\\" رحلة التحول الرقمي والتقني في القطاع العقاري واسهامها في تقديم خدمات نوعية متقدمة، ودور \\\"هيئة العقار \\\" في تبني التقنيات العقارية وتوفير بيئة محفزة تدعم الابتكار ورواد الأعمال من خلال المركز السعودي للبروبتك الذي أطلقته مؤخرًا ليكون مركزًا يخدم جميع المهتمين بالتقنية العقارية من داخل المملكة وخارجها ، بالإضافة إلى التعريف بأهمية نظام بيع وتأجير مشروعات عقارية على الخارطة ومدى اسهامه في تعزيز التنافسية في نشاط التطوير العقاري&nbsp; وتشجيع الاستثمار فيه لزيادة المعروض من الوحدات العقارية.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يذكر أنّ المنتدى الحضري العالمي </span><span>«WUF12»</span><span> يعد المؤتمر الرئيسي&nbsp;للأمم المتحدة</span><span>&nbsp;</span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كأكبر حدث عالمي، لمناقشة تحديات التنمية الحضرية المستدامة، وتشارك فيه الهيئة العامة للعقار ضمن دورها لتعزيز التعاون بين قادة الصناعة العقارية وصانعي السياسات والخبراء من جميع أنحاء العالم، ولإبراز دور المملكة الريادي في تحقيق المستهدفات العالمية للتنمية الحضرية المستدامة ومشاركتها في صياغة المشهد الحضري الإقليمي والعالمي.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار تختتم مشاركتها في المنتدى الحضري العالمي «WUF12» وتؤكد أن الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"710b12f4-1cf1-304b-863e-fcfc61ccf28e","Alias":"الهيئة العامة للعقار\" تُشارك في المعرض العقاري الأكبر \"سيتي سكيب العالمي\" 2024م بنسخته الثانية","Path":"/1d8fac21-fd1e-4db1-b008-e7e826a067f0.config","Level":4319,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1d8fac21-fd1e-4db1-b008-e7e826a067f0.config","Node":{"Content":{"@Key":"1d8fac21-fd1e-4db1-b008-e7e826a067f0","@Alias":"الهيئة العامة للعقار\" تُشارك في المعرض العقاري الأكبر \"سيتي سكيب العالمي\" 2024م بنسخته الثانية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-11T18:30:18","NodeName":{"@Default":"الهيئة العامة للعقار\" تُشارك في المعرض العقاري الأكبر \"سيتي سكيب العالمي\" 2024م بنسخته الثانية"},"SortOrder":"319","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-11T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"047e927d-8c5b-4dcf-97d9-8cb532d0f236\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">تشارك الهيئة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العامة للعقار في معرض سيتي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">سكيب العالمي 2024م بنسخته الثانية،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">خلال الفترة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">من 11-</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">14 نوفمبر في مركز الرياض للمعارض والمؤتمرات \\\"ملهم\\\" بالعاصمة الرياض تحت شعار \\\"مستقبل الحياة\\\"</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الذي يأتي كمنصة تجمع الخبراء</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والمختصين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">من أكثر من 50 دولة من حول العالم</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">لتبادل آخر التطورات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والممارسات العالمية في قطاع الإسكان والعقار</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">كما يمثل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ساحة للاستثمارات</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الواعدة في المشاريع</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">العقارية الكبرى</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">من خلال التواصل</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المباشر بين المستثمرين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الدوليين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">والمطورين المحليين</span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأكد المتحدث الرسمي للهيئة العامة للعقار</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">أ.تيسير</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بن محمد المفرج &nbsp;أنّ</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">مشاركة \\\"هيئة العقار\\\" في معرض سيتي سكيب العالمي 2024م،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">تأتي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">بهدف تسليط الضوء على التطورات الأخيرة في السوق العقاري السعودي، بما في ذلك الإصلاحات التنظيمية والتشريعية التي تسهل الاستثمار الأجنبي، بما يعزز الثقة في السوق المحلي ويحفز النمو في القطاع، ويفتح آفاقًا جديدة للتعاون والشراكات الاستراتيجية بين الشركات العقارية السعودية ونظيراتها العالمية وهذه الفرصة تعد ذات أهمية لتبادل الخبرات والتقنيات العقارية المُتقدمة في مجال البناء وتأسيس البنية التحتية للمشاريع العقارية من أجل صناعة مجتمعات حيوية ومستدامة تلبي متطلبات المرحلة المستقبلية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">مبيناً أنّ المعرض سيسهم في تحقيق أهداف القطاع العقاري من خلال توفير منصات متعددة وتجارب متميزة لعرض الابتكارات، وتبادل التجارب، والتقنيات العقارية ، بما يسهم في زيادة الفرص الاستثمارية المتنوعة في السوق العقاري السعودي، وجذب المزيد من الاستثمارات الأجنبية، لتنويع الاقتصاد، وتعزيز التنمية المستدامة،</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s6\\\"><span class=\\\"bumpedfont15\\\">كما</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">دشن الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد،</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">بوابة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المطورين العقاريين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">ضمن منصة السجل العقاري</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">كوجهة متكاملة</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">تهدف إلى تسهيل أعمال المطورين العقاريين، وحفظ حقوق ملاك العقارات في مشاريع البيع على الخارطة، وتمّكن المنصة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">المطوريين</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">العقاريين في التسجيل وإصدار رخص البيع على الخارطة وعرض شهادات البيع وتسجيلها باسم ملاك العقارات بكل مرونة وفعالية</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">، بالإضافة إلى أنها تأتي</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ضمن جهود الهيئة في تنظيم وتطوير قطاع العقار واستمراراً للإصلاحات والتشريعات التي شهدها القطاع العقاري خلال الفترة الماضية، حيث ستساهم البوابة في تنظيم مشاريع البيع على الخارطة</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ورقمنةإجراءاتها بالكامل، بالإضافة إلى تحفيز المطورين العقاريين من خلال توفير وجهة رقمية متكاملة تصحبهم في رحلة التطوير بداية من تسجيل الترخيص في البوابة وحتى إتمام البناء وإصدار صكوك تسجيل ملكية للمستفيدين من السجل العقاري مباشرة.</span></span></p>\\n<p style=\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"s4\\\"><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">يُذكر أنّ</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">معرض سيتي سكيب العالمي 2024م</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">في انطلاق نسخته</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">الثانية</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\">،</span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">شهد &nbsp;توقيع اتفاقيات وشراكات بلغت قيمتها أكثر من 180 مليار ريال سعودي ، بالإضافة إلى تجمع أكثر من 400 جهة عارضة من أهم وأكبر الشركات العالمية والوطنية في</span></span><span class=\\\"apple-converted-space\\\">&nbsp;</span><span class=\\\"bumpedfont15\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">مجال الاستثمار والتطوير العقاري، وأكثر من 100 من مستثمر مؤسسي، وأكثر من 500 من قادة القطاع الدوليين والمحليين</span></span><span class=\\\"s7\\\">.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار\" تُشارك في المعرض العقاري الأكبر \"سيتي سكيب\" العالمي 2024م بنسخته الثانية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b5e87d2f-81c4-3aef-92ca-ad25fa15cdba","Alias":"الرئيس التنفيذي للهيئة العامة للعقار يلتقي بوزير الإسكان المصري والوفد المرافق له","Path":"/822996d6-6863-463a-be7c-05aefb2615d1.config","Level":4320,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/822996d6-6863-463a-be7c-05aefb2615d1.config","Node":{"Content":{"@Key":"822996d6-6863-463a-be7c-05aefb2615d1","@Alias":"الرئيس التنفيذي للهيئة العامة للعقار يلتقي بوزير الإسكان المصري والوفد المرافق له","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-11T18:45:46","NodeName":{"@Default":"الرئيس التنفيذي للهيئة العامة للعقار يلتقي بوزير الإسكان المصري والوفد المرافق له"},"SortOrder":"320","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-11T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"f99ce68c-7d59-4816-a04d-ed4c1c892d75\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\" lang=\\\"AR-SA\\\">التقى الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد على هامش فعاليات معرض سيتي سكيب العالمي 2024م بنسخته الثانية، معالي وزير الإسكان والمرافق والمجتمعات العمرانية بجمهورية العربية المصرية المهندس شريف الشريبني والوفد المرافق له.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\" lang=\\\"AR-SA\\\">وأكّد الرئيس التنفيذي لهيئة العقار على قوة العلاقات السعودية المصرية التي تستند إلى أسس أخوية تاريخية، تعزز المصالح المشتركة بالمنطقة ومن أهمها الشراكة الاقتصادية المتبادلة، وهذه العلاقات تمتد لعقود من التعاون الوثيق، إذ تؤدي التجارة والاستثمارات المتبادلة خصوصًا بالقطاع العقاري دورًا محوريًا في تنمية هذه العلاقات وتعزز دورها على المستويين الإقليمي والدولي.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\" lang=\\\"AR-SA\\\">وأشار \\\" الحماد\\\"إلى &nbsp;أنّ ما يعزز هذه الشراكة الاستثمارية العقارية بين البلدين هو التوجه الحكومي نحو الإصلاح الاقتصادي، حيث تبنت الحكومتان في المملكة ومصر سياسات اقتصادية مرنة تستهدف تحفيز الاستثمار الأجنبي، وتحسين بيئة الأعمال، وتقديم التسهيلات للمستثمرين وحماية الاستثمارات المتبادلة بين السعودية ومصر . </span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\" lang=\\\"AR-SA\\\">وبين \\\" الرئيس التنفيذي لهيئة العقار\\\" أنَ الحراك العمراني الحضري في السعودية &nbsp;لا يهدأ لتطوير مدنٍ ذكية ومستدامة، ترتكز على الحلول المبتكرة للتحديات الحضرية من خلال المشروعات الكبرى، وأنّ الطريق ممهدٌ اليوم أمام كل من أراد الاستثمار في القطاع العقاري بشكل مباشر ، أو حتى من خلال تكوين رأس المال فنظام المساهمات العقارية ونظام بيع وتأجير مشروعات عقارية على الخارطة &nbsp;يمثلان خطوة مهمة في الاستثمار العقاري، و قنوات تمويلية واستثمارية مرنة &nbsp;بالتوازي مع الصناديق الاستثمارية العقارية، مما يعزز حماية المستثمرين واستثماراتهم في القطاع العقاري السعودي.</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\" lang=\\\"AR-SA\\\">يذكر أن &nbsp;معرض سيتي سكيب العالمي 2024 يسعى لفتح آفاقًا جديدة للتعاون والشراكات الاستراتيجية بين الشركات العقارية السعودية ونظيراتها العالمية وهذه الفرصة تعد ذات أهمية لتبادل الخبرات والتقنيات الحديثة في مجال التطوير العقاري ويمثل المعرض ساحة للاستثمارات الواعدة في المشاريع العقارية الكبرى من خلال التواصل المباشر بين المستثمرين الدوليين والمطورين المحليين، آملين في أن يبني المعرض تصورًا واضحًا لرحلة المستثمرين في القطاع العقاري السعودي.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الرئيس التنفيذي للهيئة العامة للعقار يلتقي بوزير الإسكان المصري والوفد المرافق له "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"c15863af-a92c-3df0-8565-348c041d29ac","Alias":"20 تشريع عقاري أسهمت بتصنيف السوق العقاري السعودي كأكثر الأسواق تحسنًا عالميًا","Path":"/9c267483-0334-44c6-840f-c2e669682825.config","Level":4321,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/9c267483-0334-44c6-840f-c2e669682825.config","Node":{"Content":{"@Key":"9c267483-0334-44c6-840f-c2e669682825","@Alias":"20 تشريع عقاري أسهمت بتصنيف السوق العقاري السعودي كأكثر الأسواق تحسنًا عالميًا","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-14T14:42:39","NodeName":{"@Default":"20 تشريع عقاري أسهمت بتصنيف السوق العقاري السعودي كأكثر الأسواق تحسنًا عالميًا"},"SortOrder":"321","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-14T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ffec16f5-21bc-47a9-8dea-99761544193f\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"aCxSpFirst\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">شهد القطاع العقاري في المملكة خلال السنوات القليلة الماضية، إصدار أكثر من 20 تشريعًا عقاريًا أساسيًا أعلنتها الهيئة العامة للعقار بهدف تنظيم القطاع العقاري بالمملكة العربية السعودية وتعزيز جاذبيته وحيويته ورفع نسبة الموثوقية والشفافية به، حيث أسهمت التشريعات في تصنيف السوق العقاري السعودي كأحد الأسواق الأكثر تحسنًا عالميًا، وفقاً لتقريرِ مؤشرِ الشفافيةِ العقاريةِ العالمي 2024.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"aCxSpMiddle\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتمثل التشريعات العقارية التي يشهدها السوق العقاري السعودي أنظمة وقواعد ولوائح تنفيذية و تنظيمية تعكس الاهتمام الحكومي بهذا القطاع ، حيث يأتي على رأسها تنظيم الهيئة العامة للعقار لتكون الجهة الحكومية الرسمية التي تعمل من أجل تنظيم النشاط العقاري وتطويره ورفع كفايته وتشجيع الاستثمار فيه بما يتفق مع أهداف التنمية الاقتصادية والاجتماعية ، وقد انطلقت رحلة التشريعات العقارية ليأتي نظام ملكية الوحدات العقارية وفرزها وإدارتها ،لينظم أحكام الملكية العقارية للعقارات المشتركة، وأحكام فرز الوحدات العقارية، وإدارة جمعيات الملاك ،متبوعًا&nbsp; بلائحته التنفيذية لتتضمن الأحكام التنفيذية للنظام</span>، &nbsp;ثم نظام التسجيل العيني للعقار لتبدأ عمليات <span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تسجيل العقارات عينيا وتنظيم أحكام اكتساب الحقوق العينية على العقار وقد أسهم النظام في تصحيح أكثر من مليون وثلاثمئة ألف خريطة عقارية وتسجيل أكثر من 350 ألف صك ملكية&nbsp; ويستهدف تسجيل 8 ملايين عقار خلال الفترة المقبلة ،وقد جاءت اللائحة التنفيذية لنظام التسجيل العيني للعقار لتبين أحكامه التنفيذية .</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"aCxSpMiddle\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وقد أسهم نظام الوساطة العقارية ولائحته التنفيذية في رفع الموثوقية بالسوق العقاري كون أنه يمثل إطار قانوني واضح يضمن حقوق جميع الأطراف، ويسهم في تعزيز الثقة بين المستثمرين وملاك العقارات والوسطاء العقاريين ومقدمي الخدمات العقارية والعملاء ، حيث يزاول النشاط حوالي 60 ألف وسيط عقاري مرخص ، وقد انبثق من نظام الوساطة العقارية عدد من اللوائح التنفيذية والتنظيمية شملت أحكام التوسط لإتمام الصفقات العقارية والخدمات العقارية المقدمة للمستفيدين من قبل المرخصين ، و أحكام ممارسة خدمة الاستشارات والتحليلات العقارية، وأحكام ممارسة خدمة المزادات العقارية، من الترخيص وإجراء المزاد إلى إغلاق المزادات وغيرها من الأحكام ، إضافة إلى جدول تصنيف المخالفات والعقوبات المقررة حال مخالفة نظام الوساطة العقارية ، وقد وضعت معايير لترخيص المنصات العقارية الإلكترونية وتصنيفها و ضوابط وشروط تنظم عملية الإعلانات العقارية وما تحتويه من بيانات بهدف حفظ الحقوق وزيادة الشفافية والموثوقية بالسوق العقاري .</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"aCxSpMiddle\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp; فيما يأتي نظام المساهمات العقارية ولائحته التنفيذية والضوابط المنضمة لتأهيل وتصنيف ممارسي النشاط وضوابط حساب الضمان للمساهمات وجدول تصنيف المخالفات والعقوبات لمخالفي النظام بهدف تعزيز ثقة المستثمرين في القطاع العقاري السعودي والقضاء على ممارسة المساهمات العقارية العشوائية غير النظامية ، بما يسهم في خلق فرص استثمارية واعدة ، ويأتي النظام جنبًا إلى جنب مع نظام بيع وتأجير مشروعات عقارية على الخارطة&nbsp; ولائحته التنفيذية وجدول تصنيف المخالفات والعقوبات ليكون منظمًا لأحكام تطوير المشاريع على الخارطة من إجراءات الترخيص وحتى إنهاء المشروع العقاري وقد أسهم في تحقيق نمواً ملحوظاً، حيث تم إصدار أكثر من 130 رخصة لمشاريع تجاوزت قيمتها 200 مليار ريال خلال العامين الماضيين.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"aCxSpLast\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتأتي هذه التشريعات العقارية لما يشكله القطاع العقاري في المملكة العربية السعودية من أهمية ، كونه واحدًا من أهم الركائز الأساسية للاقتصاد الوطني الذي رسمت خارطته رؤية السعودية 2030، وتشهد المنظومة العقارية ككل نمواً ملحوظاً ومرونة هي نتاج التشريعات المنظمة للتعاملات العقارية بكافة أشكالها بما يعزز استدامة القطاع وتطوره من خلال صناعة خارطة جديدة مستقبلية للقطاع العقاري مبنية على أسس قانونية مرنة قابلة للتكيف مع المتغيرات العالمية . </span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"20 تشريع عقاري أسهمت بتصنيف السوق العقاري السعودي كأكثر الأسواق تحسنًا عالميًا"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d6f12b7e-0b11-309a-a355-d7fa699aeec7","Alias":"هيئة العقار تختتم مشاركتها في \"معرض سيتي سكيب العالمي 2024 \"","Path":"/f29bd6ab-fafc-46e6-90bf-de5f6108665d.config","Level":4322,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f29bd6ab-fafc-46e6-90bf-de5f6108665d.config","Node":{"Content":{"@Key":"f29bd6ab-fafc-46e6-90bf-de5f6108665d","@Alias":"هيئة العقار تختتم مشاركتها في \"معرض سيتي سكيب العالمي 2024 \"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-14T18:51:28","NodeName":{"@Default":"هيئة العقار تختتم مشاركتها في \"معرض سيتي سكيب العالمي 2024 \""},"SortOrder":"322","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-14T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"29490533-0e03-413b-a05c-198bff7d43ad\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">اختتمت الهيئة العامة للعقار مشاركتها في معرض سيتي سكيب العالمي 2024 بنسخته الثانية، الذي أقيم&nbsp;خلال الفترة&nbsp;11- 14</span><span> </span><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">نوفمبر في مركز الرياض للمعارض والمؤتمرات \\\"ملهم\\\" بالعاصمة الرياض برعاية وزارة والبلديات والإسكان وبالشراكة بين الهيئة العامة للعقار، وبرنامج الإسكان أحد برامج رؤية </span><span>2030</span><span> تحت شعار \\\"مستقبل الحياة\\\" بمشاركة أكثر من </span><span>400</span><span> جهة عارضة من أهم وأكبر الشركات العالمية والوطنية في مجال الاستثمار والتطوير العقاري، وأكثر من </span><span>100</span><span> من مستثمر مؤسسي، وأكثر من 500 من قادة القطاع الدوليين والمحليين.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتأتي مشاركة \\\"الهيئة\\\" في معرض سيتي سكيب العالمي 2024م، بهدف تسليط الضوء على التطورات الأخيرة في السوق العقاري السعودي، بما في ذلك الإصلاحات التنظيمية والتشريعية التي تسهل الاستثمار الأجنبي، بما يعزز الثقة في السوق المحلي ويحفز النمو في القطاع، ويفتح آفاقًا جديدة للتعاون والشراكات الاستراتيجية بين الشركات العقارية السعودية ونظيراتها العالمية وهذه الفرصة تعد ذات أهمية لتبادل الخبرات والتقنيات العقارية المُتقدمة في مجال البناء وتأسيس البنية التحتية للمشاريع العقارية من أجل صناعة مجتمعات حيوية ومستدامة تلبي متطلبات المرحلة المستقبلية ، مبيناً أنّ المعرض سيسهم في تحقيق أهداف القطاع العقاري من خلال توفير منصات متعددة وتجارب متميزة لعرض الابتكارات، وتبادل التجارب، والتقنيات العقارية ، بما يسهم في زيادة الفرص الاستثمارية المتنوعة في السوق العقاري السعودي، وجذب المزيد من الاستثمارات الأجنبية، لتنويع الاقتصاد، وتعزيز التنمية المستدامة.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت \\\"هيئة العقار \\\" إلى أن \\\"سيتي سكيب 2024 \\\" شهد لقاءً جمع الرئيس التنفيذي للهيئة العامة للعقار المشرف العام على \\\"معرض سيتي سكيب العالمي 2024\\\" المهندس عبد الله بن سعود الحماد و معالي وزير الإسكان والمرافق والمجتمعات العمرانية بجمهورية العربية المصرية المهندس شريف الشريبني والوفد المرافق له لمناقشة أوجه التعاون الاستثماري العقاري بين البلدين ، كما شهد توقيع عدد الاتفاقيات والشراكات بين الهيئة وعدد من القطاعات الداعمة تضمنت تدشين بوابة المطورين العقاريين ضمن منصة السجل العقاري كوجهة متكاملة تهدف إلى تسهيل أعمال المطورين العقاريين، وحفظ حقوق ملاك العقارات في مشاريع البيع على الخارطة، وتمّكن المنصة المطورين العقاريين في التسجيل وإصدار رخص البيع على الخارطة وعرض شهادات البيع وتسجيلها باسم ملاك العقارات بكل مرونة وفعالية ، بالإضافة إلى توقيع مذكرة تفاهم لتنظيم نشاط المساهمات العقارية ، ورفع مستوى الشفافية والإفصاح، وحماية حقوق جميع أطراف المساهمة العقارية، وحوكمة المساهمات العقارية وتنظيمها وأتمتها، باعتبارها أحد قنوات التمويل الاستثمارية للمطورين العقاريين، والهادفة لتعزيز ثقة المستثمرين في القطاع العقاري في المملكة.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما استعرضت \\\"الهيئة\\\" من خلال الجلسات الحوارية وورش العمل وجناحها الخص بالمعرض رحلة التحول الرقمي والتقني في القطاع العقاري واسهامها في تقديم خدمات نوعية متقدمة، بالإضافة إلى التأكيد على دور \\\"هيئة العقار \\\" في تبني التقنيات العقارية وتوفير بيئة محفزة تدعم الابتكار ورواد الأعمال من خلال المركز السعودي للبروبتك الذي أطلقته مؤخرًا ليكون مركزًا يخدم جميع المهتمين بالتقنية العقارية من داخل المملكة وخارجها ، بالإضافة إلى التعريف بأهمية نظام بيع وتأجير مشروعات عقارية على الخارطة ومدى اسهامه في تعزيز التنافسية في نشاط التطوير العقاري&nbsp; وتشجيع الاستثمار فيه لزيادة المعروض من الوحدات العقارية</span><span>.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ معرض سيتي سكيب العالمي 2024م ، شهد&nbsp; توقيع اتفاقيات وشراكات بلغت قيمتها أكثر من 180 مليار ريال سعودي ، وإقامة أكبر مزاد عقاري مباشر في الشرق الأوسط بالتعاون مع مركز الإسناد والتصفية (إنفاذ)، تجاوزت قيمته المليار ريال ،بالإضافة إلى توفير أكثر من </span><span>100 </span><span style=\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ألف وحدة سكنية بعروض حصرية وحلول تمويلية تسهل رحلة التملك للمساكن ، وأتاح للمستثمرين الشباب وأصحاب الشركات الناشئة، فرص التواصل المباشر مع المستثمرين والمطورين العقاريين المحليين والدوليين، وعرض مشاريعهم وأفكارهم</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار تختتم مشاركتها في \"معرض سيتي سكيب العالمي 2024 \""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"5f8b843c-c3d9-39d4-bc17-998ede35d8e0","Alias":"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بالمدينة المنورة\"","Path":"/3f01c208-b349-436f-90c4-bb96d3db20db.config","Level":4323,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3f01c208-b349-436f-90c4-bb96d3db20db.config","Node":{"Content":{"@Key":"3f01c208-b349-436f-90c4-bb96d3db20db","@Alias":"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بالمدينة المنورة\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-11-27T07:18:22","NodeName":{"@Default":"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بالمدينة المنورة\""},"SortOrder":"323","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-11-25T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c7cc0c7c-d72a-43ef-a50f-29bff84f94bd\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xs4\\\"><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئة العامة للعقار عن بدء أعمال التسجيل العيني للعقار لـ (370)&nbsp;قطعة عقارية&nbsp;في (4)&nbsp;أحياء&nbsp;بالمدينة المنورة&nbsp;ابتداءً&nbsp;من&nbsp;26&nbsp;ديسمبر&nbsp;2024م، الموافق&nbsp;25</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">جمادى&nbsp;الثاني&nbsp;1446هـ، وحتى نهاية يوم&nbsp;31&nbsp;مارس&nbsp;2025م الموافق&nbsp;2&nbsp;شوال&nbsp;1446هـ..&nbsp;</span></span></p>\\n<p style=\\\"text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px; margin: 3.75pt 0cm 3.75pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"xs7\\\"><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنّ&nbsp;الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية&nbsp;بالمدينة المنورة:</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">(المسجد النبوي الشريف،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">جزء من حي بضاعة،</span></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">جزء من حي النقا</span></span><span class=\\\"xs6\\\"><em>،</em></span><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xs5\\\">حي المناخة</span><em><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">،</span></em><span class=\\\"xapple-converted-space\\\">&nbsp;</span><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</span></span></p>\\n<p style=\\\"text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px; margin: 3.75pt 0cm 3.75pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"xs7\\\">&nbsp;</p>\\n<p style=\\\"text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px; margin: 3.75pt 0cm 3.75pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"xs7\\\"><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت&nbsp;”هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء&nbsp;سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية&nbsp;</span></span><span style=\\\"font-size: 13.5pt;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://rer.sa/\\\"><span class=\\\"xs8\\\">https://rer.sa</span><span class=\\\"xs9\\\"><span>/</span></span></a></span><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">&nbsp;أو عن طريق مراكز&nbsp;الخدمة،&nbsp;مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.&nbsp;</span></span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"xs4\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px;\\\" dir=\\\"RTL\\\" class=\\\"xs4\\\"><span class=\\\"xs5\\\"><span style=\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات&nbsp;الجيومكانية&nbsp;الدقيقة بما يُسهم في&nbsp;تعزيز البنية&nbsp;التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بالمدينة المنورة\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"2568eebd-2fbf-3245-a832-5538495b4517","Alias":"الهيئة العامة للعقار\" تُنفذ 12 جولة رقابية مشتركة خلال شهر نوفمبر لضمان الامتثال في السوق العقاري\"","Path":"/a274b024-ccd3-41a4-a223-96b79b47db8a.config","Level":4324,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a274b024-ccd3-41a4-a223-96b79b47db8a.config","Node":{"Content":{"@Key":"a274b024-ccd3-41a4-a223-96b79b47db8a","@Alias":"الهيئة العامة للعقار\" تُنفذ 12 جولة رقابية مشتركة خلال شهر نوفمبر لضمان الامتثال في السوق العقاري\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-01T08:24:41","NodeName":{"@Default":"الهيئة العامة للعقار\" تُنفذ 12 جولة رقابية مشتركة خلال شهر نوفمبر لضمان الامتثال في السوق العقاري\""},"SortOrder":"324","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-01T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"70d4008d-5c85-4659-bfcb-6cfa786a14d7\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">نفذت الهيئة العامة للعقار بمشاركة وزارة الموارد البشرية والتنمية الاجتماعية خلال شهر نوفمبر 12 جولة رقابية مشتركة شملتْ زيارة 148 منشأة عقارية في كل من منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة، وتأتي هذه الجولات بهدف ضمان الامتثال للتشريعات العقارية بشكل عام ونظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين.</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليه&nbsp;لتنظيم السوق&nbsp;العقاري، حيث&nbsp;قامت فرقها الرقابية خلال الفترة&nbsp;ذاتها&nbsp;بتنفيذ 13،255&nbsp;عملية رقابية ميدانية،&nbsp;نتج عنها رصد 9،457<strong> </strong>إعلاناً عقارياً مخالفاً بالأماكن العامة، كما تلقت الهيئة&nbsp;213 بلاغاً عقارياً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها،&nbsp;فيما&nbsp;بلغ عدد عمليات المسح الإلكتروني أكثر من&nbsp;14،559عملية، حيث&nbsp;تنتهج&nbsp;الهيئة&nbsp;الرقابة الإلكترونية&nbsp;التي&nbsp;تستهدف&nbsp;القنوات&nbsp;الرقمية&nbsp;والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة&nbsp;العقارية&nbsp;الرقمية&nbsp;وفق الأنظمة واللوائح.&nbsp;</span></p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">&nbsp;</p>\\n<p style=\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span style=\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغاءه أو الغرامات المالية،&nbsp; وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها، كما دعت الهيئة المواطنين والمقيمين إلى تقديم بلاغاتهم في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم&nbsp;( 199011 ) للاستفسارات العقارية.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار\" تُنفذ 12 جولة رقابية مشتركة خلال شهر نوفمبر لضمان الامتثال في السوق العقاري\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"9a16b592-da42-3b46-95d9-9117a320dcad","Alias":"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ (11) حياً بمدينة الرياض\"","Path":"/1ccec545-dd3b-46dd-8494-c310e9d43c16.config","Level":4325,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1ccec545-dd3b-46dd-8494-c310e9d43c16.config","Node":{"Content":{"@Key":"1ccec545-dd3b-46dd-8494-c310e9d43c16","@Alias":"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ (11) حياً بمدينة الرياض\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-03T07:33:44","NodeName":{"@Default":"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ (11) حياً بمدينة الرياض\""},"SortOrder":"325","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-03T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"b8749217-1d9c-4a1b-8231-4fe6d4fa7b5c\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المهلة المحددة للتسجيل العيني الأول للعقار لـ(11) حيا بمدينة الرياض، وذلك&nbsp;نهاية يوم الخميس 5 ديسمبر 2024م الموافق 4 جمادى الآخرة 1446هـ. </span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span class=\\\"s7\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن نطاق الأحياء التالية</span></span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">: (المعذر الشمالي، حي المربع، حي الملز، حي العليا، حي النموذجية، حي الزهراء، حي الناصرية، حي المؤتمرات، حي الضباط، حي طيبة، ضاحية نمار)</span> <span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">إلى سرعة المبادرة بتسجيل عقاراتهم من خلال منصة السجل العقاري الإلكترونية </span><span style=\\\"font-family: 'Sakkal Majalla';\\\">&nbsp;</span><span style=\\\"font-size: 10.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\"><a href=\\\"http://rer.sa\\\">rer.sa</a></span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار</span><span>.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت </span><span>\\\" </span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الهيئة \\\" أنّ التسجيل العيني للعقار يتيح إصدار \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز نمو القطاع العقاري والممكنات الرئيسة له</span><span>.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأكدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان.</span></p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p style=\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يذكر أن الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى مهمة تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة بخدمات وبيانات العقارات.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ (11) حياً بمدينة الرياض\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8f2864ef-53dc-3f6d-996e-0a972778f255","Alias":"\"هيئة العقار\" تقيم ملتقى التدريب العقاري الأسبوع القادم","Path":"/9e50c536-bb29-41ba-910c-32363f681674.config","Level":4326,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/9e50c536-bb29-41ba-910c-32363f681674.config","Node":{"Content":{"@Key":"9e50c536-bb29-41ba-910c-32363f681674","@Alias":"\"هيئة العقار\" تقيم ملتقى التدريب العقاري الأسبوع القادم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-22T14:47:05","NodeName":{"@Default":"\"هيئة العقار\" تقيم ملتقى التدريب العقاري الأسبوع القادم"},"SortOrder":"326","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-22T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"87f6e285-c82c-49ee-81dd-9adda85d4be8\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تُقيم الهيئة العامة للعقار \\\"ملتقى التدريب العقاري\\\" الإثنين القادم 30 ديسمبر 2024 الموافق 29 جمادى الثاني 1446 هـ في مركز الرياض الدولي للمؤتمرات والمعارض - قاعة كبار الشخصيات، بهدف مناقشة أهمية التدريب كعملية تطويرية لمهارات وقدرات الأفراد والمنشآت في مختلف الأنشطة العقارية بما يعزز التنافسية محليًا ودوليًا.&nbsp;</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكرت الهيئة العامة للعقار أنّ \\\" ملتقى التدريب العقاري\\\" يأتي في إطار الجهود المستمرة للمعهد العقاري السعودي لتعزيز كفاءة العاملين بالأنشطة العقارية، وبناء قطاع متين متقدم يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات الاستراتيجية الشاملة للقطاع العقاري، حيث سيتضمن \\\"الملتقى\\\" جلسات حوارية يشارك بها عدد من الخبراء والمتخصصين في مجالات الأنشطة العقارية و التدريب والتنمية، ويستعرضون من خلالها دور التدريب المتخصص في القطاع العقاري وأبرز التحديات والحلول المبتكرة، و أهمية دعم وتنمية القدرات البشرية وأثرها في تعزيز تنافسية المواطن عالميًا .</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت \\\"الهيئة \\\" أن \\\"الملتقى \\\" سيناقش واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، بما يساهم في رفع المعايير المهنية في القطاع العقاري، إضافةً إلى استعراض الاتجاهات والمسارات الحديثة في التدريب العقاري وماله من تأثير على احترافية التعاملات العقارية، والتأكيد على ضرورة الموائمة بين مخرجات التعليم ومتطلبات سوق العمل، التي تسهم في مواجهة التحديات وابتكار الحلول التطويرية، وتوفير معارف نوعية للمتميزين في المجالات الاقتصادية ذات الأولوية.&nbsp;</span></p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة العامة للعقار العموم والمهتمين وأصحاب الاختصاص بالمجال العقاري ومزاولي الأنشطة العقارية ، إلى الاستفادة من موضوعات الجلسات الحوارية التي سيناقشها الملتقى ، من خلال تسجيل الحضور للملتقى عبر الرابط الإلكتروني التالي: </span><span style=\\\"font-family: 'Arial',sans-serif;\\\" lang=\\\"AR-SA\\\"><a href=\\\"https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e\\\">https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e</a></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تقيم ملتقى التدريب العقاري الأسبوع القادم"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"c943627e-739a-384f-9348-402af6fc3594","Alias":"\"هيئة العقار\" تطلق غدًا ملتقى التدريب العقاري","Path":"/f0968b53-f39f-4322-aae3-bb34d4110d4d.config","Level":4327,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f0968b53-f39f-4322-aae3-bb34d4110d4d.config","Node":{"Content":{"@Key":"f0968b53-f39f-4322-aae3-bb34d4110d4d","@Alias":"\"هيئة العقار\" تطلق غدًا ملتقى التدريب العقاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-29T13:07:31","NodeName":{"@Default":"\"هيئة العقار\" تطلق غدًا ملتقى التدريب العقاري"},"SortOrder":"327","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-29T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"e554a8af-55b9-427c-8c72-5a6859428e91\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يطلق الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد غدًا الإثنين 30 ديسمبر 2024 ملتقى التدريب العقاري الذي تنظمه الهيئة في مركز &nbsp;الرياض الدولي للمؤتمرات والمعارض – قاعة كبار الشخصيات، ويناقش الملتقى بمشاركة عدد من الخبراء والمتخصصين في مجالات الأنشطة العقارية والتدريب والتنمية، أهمية التدريب كعملية تطويرية لمهارات وقدرات الأفراد والمنشآت في مختلف الأنشطة العقارية بما يعزز التنافسية محليًا ودوليًا. </span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة العامة للعقار بأن الهدف الرئيسي من تنظيم \\\" ملتقى التدريب العقاري \\\" هو التأكيد على دور المعهد العقاري السعودي و أهمية التدريب كأداة استراتيجية لدعم التنافسية، وتحقيق تنمية القدرات البشرية وتعزيز كفاءة العاملين بالأنشطة العقارية، وبناء قطاع متين متقدم يسهم في دعم النمو الاقتصادي والوصول لمستهدفات الاستراتيجية الشاملة للقطاع العقاري ، إضافة ً إلى تعزيز التواصل بين المهنيين ، ومواكبة التطورات وتحفيز الابتكارات وتطوير القدرات من خلال إعداد ممارسين عقاريين مؤهلين يحملون شهادات مهنية معتمدة وتراخيص لمزاولة الأنشطة العقارية المختلفة، مما يعزز ثقة المستثمرين المحليين والدوليين والمتعاملين في السوق العقاري</span><span>.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكرت \\\" الهيئة \\\" أن \\\" الملتقى \\\"سيناقش واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، بما يساهم في رفع المعايير المهنية في القطاع العقاري، إضافةً إلى استعراض الاتجاهات والمسارات الحديثة في التدريب العقاري وماله من تأثير على احترافية التعاملات العقارية، والتأكيد على ضرورة الموائمة بين مخرجات التعليم ومتطلبات سوق العمل، التي تسهم في مواجهة التحديات وابتكار الحلول التطويرية، وتوفير معارف نوعية للمتميزين في المجالات الاقتصادية ذات الأولوية.&nbsp;</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعت الهيئة العامة للعقار العموم والمهتمين وأصحاب الاختصاص بالمجال العقاري ومزاولي الأنشطة العقارية ، إلى الاستفادة من موضوعات الجلسات الحوارية التي سيناقشها الملتقى ، من خلال تسجيل الحضور للملتقى عبر الرابط الإلكتروني التالي</span><span>:&nbsp;<a href=\\\"https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e\\\">https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e</a></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تطلق غدًا ملتقى التدريب العقاري "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"a1f79ba5-c7b3-3c3a-b2dd-764d7e28b6df","Alias":"هيئة العقار\" تُعلن بدء أعمال السجل العقاري لـ (28) حيًا بمنطقة مكة المكرمة\"","Path":"/6d1dfbbd-78fc-4282-83f0-eea3df3b9376.config","Level":4328,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6d1dfbbd-78fc-4282-83f0-eea3df3b9376.config","Node":{"Content":{"@Key":"6d1dfbbd-78fc-4282-83f0-eea3df3b9376","@Alias":"هيئة العقار\" تُعلن بدء أعمال السجل العقاري لـ (28) حيًا بمنطقة مكة المكرمة\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-30T09:55:31","NodeName":{"@Default":"هيئة العقار\" تُعلن بدء أعمال السجل العقاري لـ (28) حيًا بمنطقة مكة المكرمة\""},"SortOrder":"328","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-30T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"7131d61a-b102-48fe-9866-bbf9d1a7a514\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"rtl\\\">أعلنتْ الهيئة العامة للعقار بدء أعمال التسجيل العيني للعقار لـ (19.239) قطعة عقارية في (28) حيًا بمنطقة مكة المكرمة ابتداءً من 19 يناير 2025م، وحتى نهاية يوم 24 أبريل 2025م.<br>وأوضحت الهيئة أنّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل أجزاءً من الأحياء التالية بمكة المكرمة: (حي الصفوة، حي دار السلام، حي النسيم، حي الشميسي، حي التروية، حي الراشدية، حي الكوثر، حي طيبة، حي عين شمس، حي الحطيم، حي العوالي، حي العمرة، حي الشهداء، حي الكعكية، حي جبل النور، حي العمرة، حي الجامعة، حي الضيافة، حي أحد، حي الراشدية، حي الحمراء، حي الفرقان، حي العسلية، حي وادي جليل، حي جعرانة، حي الصفا، حي الغزيات، حي المقام).<br>وبينت أنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.<br>وأشارت الهيئة العامة العقار أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية <a rel=\\\"noopener\\\" href=\\\"https://rer.sa/\\\" target=\\\"_blank\\\" title=\\\"\\\">https://rer.sa</a> أو عن طريق مراكز الخدمة، منوهةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل، ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.<br>وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية للقطاع العقاري؛ حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\" تُعلن بدء أعمال السجل العقاري لـ (28) حيًا بمنطقة مكة المكرمة\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"caadc017-a495-3301-a744-be0dac174a52","Alias":"\"هيئة العقار \" تُعلنْ بدء استقبال طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية","Path":"/f607d0ad-67dd-4910-be33-7ab44dfbd028.config","Level":4329,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f607d0ad-67dd-4910-be33-7ab44dfbd028.config","Node":{"Content":{"@Key":"f607d0ad-67dd-4910-be33-7ab44dfbd028","@Alias":"\"هيئة العقار \" تُعلنْ بدء استقبال طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-30T21:26:10","NodeName":{"@Default":"\"هيئة العقار \" تُعلنْ بدء استقبال طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية"},"SortOrder":"329","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-31T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"049cf77a-3a4d-4af1-a954-1139f8b8f45a\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنتْ الهيئةُ العامة للعقار اليوم، عن بدء استقبال المعهد العقاري السعودي طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي للحصول على رخصة فال للاستشارات العقارية، ورخصة فال للتحليلات العقارية، حيث يستمر استقبال طلبات الترشيح في البرنامج لمدة خمسة أيام عن طريق الموقع الرسمي للمعهد، ويُعدّ اجتياز البرنامج التدريبي شرطًا لممارسة نشاط الاستشارات أو التحليلات العقارية.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئةُ أنَّ كلا النشاطين الاستشارات والتحليلات العقارية يُعدَّان من الخدمات العقارية التي شملهما نظام الوساطة العقارية والذي بدأ تطبيق العمل به في يوليو من العام 2023م، حيث شمل النظام تنظيم ممارسة نشاط التوسط في إتمام الصفقات العقارية بين أطرافها، إضافة إلى أنشطة الخدمات العقارية والتي تشمل: التسويق العقاري، وإدارة الأملاك، وإدارة المرافق، والمزادات العقارية، والإعلانات العقارية، والاستشارات والتحليلات العقارية والتي تُمارس حصراً عن طريق مقدمي الخدمات المُرخصين والمؤهلين من المـُنشآت والأفراد</span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ووضحت الهيئة أنَّ الفرق بين الاستشارات والتحليلات هو وسيلة تقديمها، حيث عرَّفت اللائحة التنظيمية الاستشارات والتحليلات العقارية بأنها التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري، غير أنَّ الاستشارات العقارية هي التي يتم تقديمها للمستفيد كتابةً ويلزم مقدمها إبرام عقد بينه وبين المستفيد، بينما يتم تقديم التحليلات العقارية منشورةً عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها كأنشطة الاتصال الجماهيري.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\"></span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت \\\"الهيئة\\\" إلى أنّ البرنامج التدريبي الذي يبدأ استقبال طلبات الترشيح اليوم وينتهي يوم الجمعة&nbsp;</span><span>3</span><span> <span lang=\\\"AR-SA\\\">يناير 2025م، الموافق 3 رجب 1446هـ ، تم إعداده في المعهد العقاري السعودي&nbsp; بالتعاون مع كبرى دور التدريب المحلي والدولي المتخصصة في برامج الاستشارات والتحليلات العقارية، ويُغطي الجوانب القانونية والاتصالية والفنية في مجال تقديم الاستشارات والتحليلات العقارية عبر كفاءات تدريبية عالية المستوى في هذا المجال، على مدى شهرين (ثمانية أسابيع)، مما يعكس الاهتمام في أهمية المخرجات لضمان دقة الاستشارات والمعلومات التي تقدّم للمستفيدين</span></span><span>.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\"></span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ويقدّم البرنامج التدريبي في هذين المسارين حضوريًا في كل من الرياض وجدة والدمام كل ربع سنة نظرًا لأهمية تطبيق المهارات والعلوم والمعارف في محتوى هذه البرامج لضمان التأهيل اللازم لممارسة النشاط في القطاع العقاري ويتضمن كل مسار 14 دورة تدريبية، ويشترط للتقدم في طلب الترشيح لمسار الاستشارات العقارية أن يكون المتقدم حاصلًا على شهادة جامعية، وخبرة لا تقل عن (3) سنوات في ممارسة أي من الأنشطة العقارية أما بالنسبة للتحليلات العقارية فيشترط خبرة لا تقل عن (10) سنوات في ممارسة أي من الأنشطة العقارية بالإضافة الى شهادة جامعية.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\"></span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ويُمكن التقديم على البرنامج التدريبي عبر بوابة المعهد العقاري السعودي لتسجيل الرغبات في مسار الاستشارات العقارية&nbsp;</span><span lang=\\\"AR-SA\\\"><a href=\\\"https://srei.sa/FormData/RealEstateConsulting\\\">https://srei.sa/FormData/RealEstateConsulting</a></span><span> أو عبر الرابط التالي لتسجيل الرغبات في مسار التحليلات العقارية</span><span> </span><span><a href=\\\"https://srei.sa/FormData/RealEstateAnalytics\\\">https://srei.sa/FormData/RealEstateAnalytics</a></span><span>، ومن ثم تقوم الهيئة بدراسة الطلبات والتحقق من الاشتراطات، ويتم إشعار المتقدمين بنتائج الترشيح كمرحلة أولى ثم إشعار المقبولين بأوقات الدورات ومكان انعقادها، وبعد اجتياز البرنامج التدريبي يقوم المعهد بإصدار شهادة الاجتياز، ويكمل المتقدم إجراءات استخراج الرخصة عن طريق منصة الخدمات الإلكترونية للهيئة العامة للعقار، ليتم بعد ذلك إصدار الرخصة بعد اجتياز البرنامج التدريبي بخمسة أيام عمل</span><span>.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\"></span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر بأنَّ رخصة فال العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت من ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، كما يرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، ويحد من النزاعات العقارية، ويحفظ حقوق المتعاملين، ويرفع شفافية السوق العقاري</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":" \"هيئة العقار \" تُعلنْ بدء استقبال طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e66011c1-5777-3ba9-ab8b-0d80b3ed9716","Alias":"رئيس هيئة العقار: 300 ألف مستفيد من المسارات التدريبة للمعهد العقاري السعودي","Path":"/999245f8-b0fc-4223-98a5-9036eb09eb45.config","Level":4330,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/999245f8-b0fc-4223-98a5-9036eb09eb45.config","Node":{"Content":{"@Key":"999245f8-b0fc-4223-98a5-9036eb09eb45","@Alias":"رئيس هيئة العقار: 300 ألف مستفيد من المسارات التدريبة للمعهد العقاري السعودي","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-30T21:32:06","NodeName":{"@Default":"رئيس هيئة العقار: 300 ألف مستفيد من المسارات التدريبة للمعهد العقاري السعودي"},"SortOrder":"330","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-30T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"c1168707-ad6f-402a-aea4-bbe553d9e59b\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أكد الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد، على الدور الريادي للمعهد العقاري السعودي الذراع الأكاديمي \\\"للهيئة\\\"، وما يبذله من جهود تسهم في تنمية القدرات البشرية ورفع كفاء العاملين بالقطاع العقاري، وأنّ ما حققه المعهد من مؤشرات إيجابية، هي نتاج الدعم غير المحدود الذي أولته القيادة الرشيدة - أيدها الله- للقطاع العقاري من خلال منظومة التشريعات التي مكنته وجعلت منه قطاعًا حيويًا يتسم بالنمو والتطور.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكر المهندس عبدالله الحماد في كلمته خلال افتتاح \\\"ملتقى التدريب العقاري\\\" أنّ </span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\" lang=\\\"AR-MA\\\">التدريب العقاري يساهم في رفع معايير الممارسات المهنية داخل القطاع ويُمكّن المواطن من اكتساب مهارات استثنائية، تجعله مؤهلاً ليس فقط لتلبية متطلبات السوق المحلي، بل للمنافسة على أعلى المستويات العالمية، ويسهم بشكل مباشر في </span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">تحقيق أهداف الاستراتيجية الشاملة للقطاع العقاري ويحفز </span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\" lang=\\\"AR-MA\\\">النمو الاقتصادي، من خلال إعداد ممارسين مؤهلين يحملون شهادات مهنية معتمدة وتراخيص لمزاولة الأنشطة العقارية المختلفة، وقد نجح المعهد العقاري السعودي </span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">منذ تأسيسه في تدريب أكثر من 300,000 ألف مستفيد، من خلال تقديم أكثر من 4500 برنامجًا تدريبيًا عبر 5 مسارات رئيسية تتضمن </span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\" lang=\\\"AR-MA\\\">الاستشارات العقارية، التحليلات العقارية، الوساطة والتسويق العقاري، المساهمات العقارية، التسجيل العيني</span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">، إضافة إلى أنّ المعهد يعمل على تقديم مسارات تدريبية حديثة تتضمن التقنيات العقارية التي تسهم&nbsp; في&nbsp; تقديم حلول عقارية مبتكرة تدعم بناء مدن مستقبلية مستدامة.</span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\"></span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار إلى أنّ \\\"الهيئة\\\" ومن خلال المعهد العقاري السعودي، تعمل على تأهيل قادة يسهمون في تحويل القطاع العقاري السعودي إلى نموذج عالمي يُحتذى به في الابتكار والاحترافية، إضافةً إلى رسم خارطة واضحة لرحلة المتعاملين في القطاع العقاري، بدءًا من التمكين وصولًا إلى تحقيق الاستدامة، وأنه ومن خلال التدريب المتخصص يمكن تطوير الكوادر العقارية بما يعزز من قدرتها على التكيف مع التطورات التقنية والتنظيمية الحالية والمستقبلية في القطاع.</span></p>\\n<p style=\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وذكر \\\"الحماد\\\" أن هذه النسخة من ملتقى التدريب العقاري </span><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\" lang=\\\"AR-MA\\\">تمثل منصة معرفية تعليمية تطويرية، تناقش واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، إضافةً إلى استعراض الاتجاهات والمسارات الحديثة في التدريب العقاري وماله من أثر ايجابي على احترافية التعاملات العقارية، التي ستسهم في مواجهة التحديات وابتكار الحلول التطويرية، وتوفير معارف نوعية لدى المهتمين.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"رئيس هيئة العقار: 300 ألف مستفيد من المسارات التدريبة للمعهد العقاري السعودي"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"be3be971-fac0-3a36-9444-ac9e52d5aeb0","Alias":"هيئة العقار\" تختتم أعمال ملتقى التدريب العقاري\"","Path":"/dfd9ec1e-252e-4196-8a9a-16ed963ddbe2.config","Level":4331,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/dfd9ec1e-252e-4196-8a9a-16ed963ddbe2.config","Node":{"Content":{"@Key":"dfd9ec1e-252e-4196-8a9a-16ed963ddbe2","@Alias":"هيئة العقار\" تختتم أعمال ملتقى التدريب العقاري\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-12-31T12:15:10","NodeName":{"@Default":"هيئة العقار\" تختتم أعمال ملتقى التدريب العقاري\""},"SortOrder":"331","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-12-31T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"31ed5e85-9d82-4452-818b-7b41c1830370\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"rtl\\\">اختتمت الهيئة العامة للعقار أمس, أعمال \\\"ملتقى التدريب العقاري\\\" الذي نظمته بمركز الرياض للمؤتمرات والمعارض, بحضور الرئيس التنفيذي للهيئة المهندس عبدالله بن سعود الحمّاد.<br>وناقش الملتقى واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، بما يسهم في رفع المعايير المهنية في القطاع العقاري، إضافةً إلى تسليط الضوء على الاتجاهات والمسارات الحديثة في التدريب العقاري وأثرها على احترافية التعاملات العقارية.<br>واستعرض المتحدثون بالجلسة الحوارية الأولى التي جمعت نخبة من الشخصيات المتخصصة في تنمية القدرات البشرية، وتطوير القطاع العقاري، أهمية تعزيز تنافسية المواطن محليًا وعالميًا، وأفادوا بأن ما تقدمه الهيئة العامة للعقار من خلال المعهد العقاري السعودي يؤكد على أهمية التدريب بصفتها أداة استراتيجية لدعم التنافسية وتحقيق تنمية القدرات البشرية، وأنه في ظل رؤية المملكة 2030 وبرامجها الطموحة أصبحت الحاجة ملحة لوجود جامعة سعودية عقارية، توفر تعليم متخصص في علوم العقار.<br>وأشاروا إلى أنّ المملكة نجحت في إعداد مواطن سعودي يُنافس مهاريًا في مختلف القطاعات، وأنّ التجربة السعودية في رحلة التعلّم باستخدام الذكاء الاصطناعي تعد إنجازًا وطنيًا؛ لنجاحها على المستوى العالمي وأنّ المواطن السعودي أصبح أكثر وعيًا واهتمامًا بتطوير مهاراته ليصبح منافسًا عالميًا في مختلف القطاعات.<br>كما تطرق المتحدثون بالجلسة الحوارية الثانية على أهمية التدريب العقاري في ابتكار الحلول ومواجهة التحديات وأن البرامج الأكاديمية التي بدأت بتبنيها الجامعات السعودية تسهم في سد الفجوة بين التعليم الأكاديمي ومتطلبات السوق العقاري، وأن الاعتماد على التقنيات العقارية يمثل مستقبل التعاملات العقارية وتحسين تجربة المستفيدين، وعلى الممارس في القطاع العقاري أن يتبنى التقنيات الحديثة ويلمّ بكيفية مواءمتها في أعماله اليومية لتحسين الكفاءة وتعزيز الإنتاجية.<br>ودعا المتحدثون إلى ضرورة تبني برامج أكاديمية وزمالات متخصصة في نشاط التطوير العقاري لتدريب وتأهيل الشباب السعودي لمساعدتهم في بناء قدراتهم المهنية وتزويدهم بأهم المعارف والمهارات اللازمة لممارسة العمل العقاري، كما أشاروا إلى أنّ الاطلاع على التجارب العالمية يبعث الفخر بما وصلت إليه التجربة السعودية في قطاع العقار خصوصًا شبكة إيجار ونظام الوساطة العقارية.<br>يذكر أن ملتقى التدريب العقاري يأتي في إطار الجهود المستمرة للهيئة العامة للعقار لتعزيز كفاءة العاملين بالأنشطة العقارية، وبناء قطاع متين متقدم يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات الاستراتيجية الشاملة للقطاع العقاري، بما يحقق الاستدامة في تقديم خدمات عقارية نوعية من أجل مستقبل عقاري أكثر تطورًا.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\" تختتم أعمال ملتقى التدريب العقاري\""}},"pageName":{"Value":{"#cdata-section":"هيئة العقار\" تختتم أعمال ملتقى التدريب العقاري\""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"30ea64be-66e5-34c0-9e80-cc10071ad78a","Alias":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","Path":"/7193daa5-2b19-4ccc-8148-9ded81b9f7e5.config","Level":5000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/7193daa5-2b19-4ccc-8148-9ded81b9f7e5.config","Node":{"Content":{"@Key":"7193daa5-2b19-4ccc-8148-9ded81b9f7e5","@Alias":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","@Level":"5","Info":{"Parent":{"@Key":"c332c79b-387d-428b-9194-0910837a19e6","#text":"اللوائح"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-08-04T16:23:25","NodeName":{"@Default":"اللائحة التنظيمية للاستشارات والتحليلات العقارية"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"612a1aab-ff1b-410f-a988-5d90faccd2e9\",\n    \"mediaKey\": \"23f630b6-6cbe-4ff6-b706-7ad816ce2dad\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/c6804aab6efd46efbedfd13985a0ca6d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2fb4a582ebae4d07939d448d5ae79055\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0309d266208c45b1bc796c9490bc685b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c5826f46f78f4e59a39781af862a49b9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b714de54fe2b4f639ec2a9cf67013632\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e3a08a957dc74901b40a49be4f7570c1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d93bad38592d4f69bf23d0346e81e18c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/81702182288e4457b88f0181a1ea9cc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f1f0dbcfa3104f74b5471cc53895fa6d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/056e771e4b694fbaac3a5d560840c20b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6da4afa568734764983da3f155bd27a1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e01367fc892d430e8bfa527b4e5f0c53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c9b0c2257fa4415aa40ed1641153b2e7\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c6804aab6efd46efbedfd13985a0ca6d\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; يكون للألفاظ والمصطلحات الواردة في هذه اللائحة المعاني المُبينة أمام كل منها في المادة (الأولى) من نظام الوساطة العقارية الصادر بالمرسوم الملكي رقم: (م/130) في 30/11/1443هـ، ولائحته التنفيذية ما لم يقتض السياق خلاف ذلك.<br>2- &nbsp; يُقصد بالألفاظ والمصطلحات التالية -أينما وردت- في هذه اللائحة المعاني المُبينة أمام كل منها، ما لم يقتض السياق خلاف ذلك:<br><strong>الاستشارات العقارية:</strong> التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري، التي تقدم للمستفيد كتابة.<br><strong>التحليلات العقارية:</strong> الرأي أو التحليل المتصل بالقطاع العقاري، الذي يقدم للعموم عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها.<br><strong>المستفيد:</strong> طالب خدمة الاستشارة العقارية من المرخص له.<br><strong>المرخص له:</strong> شخص طبيعي أو اعتباري مرخص له بممارسة خدمة الاستشارات والتحليلات العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0309d266208c45b1bc796c9490bc685b\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يشترط للترخيص لممارسة خدمة الاستشارات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية – للأفراد الممارسين التابعين للأشخاص الاعتباريين (المنشآت)، أو الأشخاص الطبيعيين (الأفراد)، الحصول على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (3) سنوات في ممارسة أي من الأنشطة العقارية، وللهيئة الإعفاء من اشتراط المؤهل بناء على معايير تضعها في هذا الشأن، وتعتمد من المجلس.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c5826f46f78f4e59a39781af862a49b9\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط للترخيص لممارسة خدمة التحليلات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية – للأفراد الممارسين التابعين للأشخاص الاعتباريين (المنشآت)، أو الأشخاص الطبيعيين (الأفراد)، الحصول على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (10) سنوات في ممارسة أي من الأنشطة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e3a08a957dc74901b40a49be4f7570c1\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية -إضافة للأحكام الواردة في نظام الوساطة العقارية ولائحته التنفيذية -، الالتزام بما يأتي:<br>1-    التحلي بالنزاهة والإخلاص، وبذل العناية المهنية والتعامل بحياد وموضوعية مع المستفيدين أو المتلقين.<br>2-    التأكد من دقة وصحة المعلومات التي يقدمها، وعدم تضمينها أي معلومات أو بيانات مضللة، أو غير متوافقة مع البيانات والمعلومات العقارية الصادرة من الجهات الرسمية أو الجهات المرخص لها، عند تقديم الاستشارة العقارية.<br>3-    الحصول على ترخيص المقيمين المعتمدين عند ممارسة الخدمة المتضمنة تقييماً العقارات.<br>4-    تزويد الهيئة بأي معلومات أو بيانات تطلبها خلال المدة المحددة في الطلب.<br>5-    ممارسة الخدمة من قبل الأفراد الممارسين التابعين للمنشأة والمسجلين لدى الهيئة.<br>6-    الالتزام بما تقضي به الأنظمة والتعليمات في ممارسة الخدمة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d93bad38592d4f69bf23d0346e81e18c\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>يحظر على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية الآتي:<br>1- &nbsp; &nbsp;إنتاج أو ترويج ما من شأنه المساس باستقرار السوق العقاري أو الإضرار به، أو إرباك العموم.<br>2- &nbsp; &nbsp;تقديم الخدمة إذا كانت تؤدي إلى تحقيق مصلحة شخصية له أو لآخرين؛ أو الإضرار بالغير، وتمت بطريقة تنطوي على غش أو خداع أو تضليل.<br>3- &nbsp; &nbsp;تقديم الخدمة بناء على معلومات غير رسمية إذا كانت نتيجتها التأثير على السوق العقاري سلباً أو إيجاباً.<br>4- &nbsp; &nbsp;إفشاء أي معلومات ذات طابع سري بشأن الخدمة.<br>5- &nbsp; &nbsp;إعطاء أي مقارنات أو إشارات تسيء للآخرين.<br>6- &nbsp; &nbsp;ممارسة الخدمة عبر اسم مستعار في وسائل التواصل الاجتماعي أو أي وسيلة إعلامية.<br>7- &nbsp; &nbsp;استخدام اسم وشعار الهيئة في أي استشارة أو تحليل عقاري.<br>8- &nbsp; &nbsp;ممارسة خدمة التحليلات العقارية بناء على إعلان مدفوع.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/81702182288e4457b88f0181a1ea9cc8\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>على المرخص له عند إبرام عقد وساطة مع المستفيد لتقديم الاستشارات العقارية، أن يتم تقديمها كتابة –خلال مدة سريان العقد-، وتضمين الاستشارة البيانات التالية:<br>1- &nbsp; &nbsp;رقم عقد الوساطة.<br>2- &nbsp; &nbsp;اسم المرخص له ورقم ترخيصه.<br>3- &nbsp; &nbsp;تاريخ تقديم الاستشارة.<br>4- &nbsp; &nbsp;المعلومات الجوهرية والبيانات التي بنيت عليها الاستشارة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f1f0dbcfa3104f74b5471cc53895fa6d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية حال تقديم معلومات أو بيانات غير صحيحة أو ارتكاب مخالفة، تصحيح ذلك في ذات الوسيلة، بناء على طلب من المستفيد أو من الهيئة، دون أن يترتب على ذلك إعفاء مقدمها عن أي مسؤولية ناتجة عنها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/056e771e4b694fbaac3a5d560840c20b\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يعاقب كل من يخالف الأحكام النظامية بالعقوبات الواردة في جدول تصنيف المخالفات والعقوبات المقررة لها باللائحة التنفيذية.</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e01367fc892d430e8bfa527b4e5f0c53\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; line-height: 90%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تقيد بيانات المرخص لهم في سجل خاص بالمنصة الإلكترونية بالهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c9b0c2257fa4415aa40ed1641153b2e7\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; line-height: 90%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تُنشر هذه اللائحة في الجريدة الرسمية، ويُعمل بها من تاريخ نشرها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2fb4a582ebae4d07939d448d5ae79055\",\n      \"title\": \"أحكام وشروط الترخيص\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b714de54fe2b4f639ec2a9cf67013632\",\n      \"title\": \"التزامات ومحظورات المرخص له\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6da4afa568734764983da3f155bd27a1\",\n      \"title\": \"أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":"اللائحة التنظيمية للاستشارات والتحليلات العقارية"}},"header":{"Value":{"#cdata-section":"اللائحة التنظيمية للاستشارات والتحليلات العقارية"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"اللائحة التنظيمية للاستشارات والتحليلات العقارية\",\n  \"التحليلات\",\n  \"العقارية\",\n  \"الانظمة واللوائح والادلة\",\n  \"لوائح\",\n  \"الهيئة العامة للعقار\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"اللائحة التنظيمية للاستشارات والتحليلات العقارية"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2023-12-22T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2023-12-03T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"أنظمة\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":"الرأي أو التحليل المتصل بالقطاع العقاري، الذي يقدم للعموم عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها"}},"title":{"Value":{"#cdata-section":"اللائحة التنظيمية للاستشارات والتحليلات العقارية"}}}}},"IsRoot":true},{"Key":"0b7b4e8c-62b3-379b-bb1a-711d57d9b28c","Alias":"التقديم","Path":"/644430d0-b05c-4e27-babd-320927603de8.config","Level":5000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/644430d0-b05c-4e27-babd-320927603de8.config","Node":{"Content":{"@Key":"644430d0-b05c-4e27-babd-320927603de8","@Alias":"التقديم","@Level":"5","Info":{"Parent":{"@Key":"36652cc6-eff7-4f20-be38-16b554f1146c","#text":"البيئة التنظيمية التجريبية"},"Path":"/////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-29T13:54:16","NodeName":{"@Default":"التقديم"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/bbc82cafdac84b07a95687b95640963f\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/bbc82cafdac84b07a95687b95640963f\",\n      \"title\": \"\",\n      \"content\": \"\",\n      