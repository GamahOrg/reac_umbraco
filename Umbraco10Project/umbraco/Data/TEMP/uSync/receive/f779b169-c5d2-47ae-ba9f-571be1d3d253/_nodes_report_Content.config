عامة للعقار رموز الفخر والاعتزاز<span>&nbsp;</span>بالهوية الوطنية عبر السيفين والنخلة، إضافة إلى لمسات فنية تعمّق ذلك الاعتزاز وتمثل شكل العمارة السعودية.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">يتلوها أربعة أشكال تعكس الركائز الإستراتيجية الأربعة للهيئة. وأخيراً يظهر عنصر التشريعات كأساس يعبر عن دور الهيئة في التمكين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تحتضن الركائز وتنطلق منها بروح وطنية مبتكرة</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">نحو قطاع زاخر بالنمو والمنجزات</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":{"@Culture":"ar-jo","#cdata-section":"هوية الهيئة العامة للعقار"}},"videos":{"Value":{"@Culture":"ar-jo","#cdata-section":""}},"words":{"Value":{"@Culture":"ar-jo","#cdata-section":""}}}}},"IsRoot":true},{"Key":"4782bcb8-ea5a-31c6-af11-fdd70cd4e255","Alias":"فرز الوحدات العقارية","Path":"/7591a71f-51f7-49cc-a16b-496b8ea0e73e.config","Level":3010,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/7591a71f-51f7-49cc-a16b-496b8ea0e73e.config","Node":{"Content":{"@Key":"7591a71f-51f7-49cc-a16b-496b8ea0e73e","@Alias":"فرز الوحدات العقارية","@Level":"3","Info":{"Parent":{"@Key":"75795868-cfb0-4021-a108-d26b070a39a4","#text":"الخدمات الإلكترونية"},"Path":"///","Trashed":"false","ContentType":"service","CreateDate":"2023-09-06T17:35:02","NodeName":{"@Default":"فرز الوحدات العقارية","Name":[{"@Culture":"ar-jo","#text":"فرز الوحدات العقارية"},{"@Culture":"en-us","#text":"Sorting Real Estate Units – Subdivision"}]},"SortOrder":"10","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go to Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"فرز برنامج يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديد مساحات وحقوق كل وحدة في المباني والمجمعات العقارية وحدود الأجزاء المشتركة لتعزيز العلاقات بين مُلاك الوحدات"},{"@Culture":"en-us","#cdata-section":"Subdivision is a program that manages the mechanism of sorting real estate units technically and legally through (the system of ownership, sorting, and management of real estate units) which contributes to determining the unit’s square meter and the rights of every unit in apartment buildings and real estate compounds"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":"[\n  \"فرز\",\n  \"الوحدات العقارية\",\n  \"ملكية\",\n  \"الهيئة العامة للعقار\",\n  \"الخدمات الالكترونية\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"فرز الوحدات العقارية"},{"@Culture":"en-us","#cdata-section":"Sorting Real Estate Units – Subdivision"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"فرز الوحدات العقارية"},{"@Culture":"en-us","#cdata-section":"Sorting Real Estate Units – Subdivision "}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>\\\"فرز\\\" برنامج يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديد مساحات وحقوق كل وحدة في المباني والمجمعات العقارية وحدود الأجزاء المشتركة لتعزيز العلاقات بين مُلاك الوحدات وتسهيل الإجراءات والخدمات اللازمة، والمحافظة على الأصول العقارية واستدامة القطاع، وتعزيز بيئة سكنية آمنة.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>“Subdivision” is a program that manages the mechanism of sorting real estate units technically and legally through (the system of ownership, sorting, and management of real estate units) which contributes to determining the unit’s square meter and the rights of every unit in apartment buildings and real estate compounds. Additionally, the program determines the boundaries of common and public areas to enhance landlords’ relations and facilitate the necessary services and procedures, preserve real estate assets, and foster safe residential environments to sustain the real estate sector. &nbsp; &nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"f97b5fe6-c921-453e-ad96-bd975d955389\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"فرز\\\\\\\" برنامج يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديد مساحات وحقوق كل وحدة في المباني والمجمعات العقارية وحدود الأجزاء المشتركة لتعزيز العلاقات بين مُلاك الوحدات وتسهيل الإجراءات والخدمات اللازمة، والمحافظة على الأصول العقارية واستدامة القطاع، وتعزيز بيئة سكنية آمنة.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"41a41d7c-2506-40ee-8e37-9f112d993372\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>“Subdivision” is a program that manages the mechanism of sorting real estate units technically and legally through (the system of ownership, sorting, and management of real estate units) which contributes to determining the unit’s square meter and the rights of every unit in apartment buildings and real estate compounds. Additionally, the program determines the boundaries of common and public areas to enhance landlords’ relations and facilitate the necessary services and procedures, preserve real estate assets, and foster safe residential environments to sustain the real estate sector. &nbsp; &nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"}]},"serviceIcon":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"6d1b780c-8b88-4bcd-a7f1-1c21b7a16284\",\n    \"mediaKey\": \"b6fcd311-5e6d-4597-a848-462410654803\"\n  }\n]"}},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"support":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/5b388c7335e74bb0a7dc641a1f02978a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6aaea490451b401d85802198a17d18e5\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\",\n      \"udi\": \"umb://element/6aaea490451b401d85802198a17d18e5\",\n      \"title\": \"\",\n      \"items\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/97eaa1a10af54a56b6469736050395db\"\n            },\n            {\n              \"contentUdi\": \"umb://element/dd9b86edd8924c1181171e5feab7374f\"\n            },\n            {\n              \"contentUdi\": \"umb://element/56288c9bb7ee45