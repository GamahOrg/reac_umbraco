"},{"@Culture":"en-us","#cdata-section":"Wafi is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system."}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"بيع\",\n  \"تأجير\",\n  \"تراخيص\",\n  \"ترخصي\",\n  \"الخدمات الالكترونية\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بيع وتأجير مشروعات عقارية على الخارطة"},{"@Culture":"en-us","#cdata-section":"Wafi – Off-Plan Sales & Lease"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بيع وتأجير مشروعات عقارية على الخارطة"},{"@Culture":"en-us","#cdata-section":"Off-Plan Sales & Lease "}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه، تهدف إلى أتمتة خدمات قطاع التطوير العقاري، تحت إشراف الهيئة العامة للعقار، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم (196) وتاريخ 1445/03/04هـ.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>\\\"Wafi\\\" is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"3ba4a362-5015-41be-b87c-f57c199f1265\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه، تهدف إلى أتمتة خدمات قطاع التطوير العقاري، تحت إشراف الهيئة العامة للعقار، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم (196) وتاريخ 1445/03/04هـ.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"cec460cf-9431-4812-9a76-7739d64a4ef3\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/2d60419ed1954a2d90581e33b729900d\",\n    \"featureTabTitle\": \"التأهيل\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">تتيح هذه الخدمة طلب التأهيل للراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة والمهن المتربطة بها، باعتباره متطلب أساسي للحصول على الترخيص، وفقاً للنظام واللائحة التنفيذية لبيع وتأجير مشروعات عقارية على الخارطة.</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/05dc2f225bef4b16a41894d4369a41ba}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص اعتباري/ منشأة)\\\\\\\">المطور العقاري (شخص اعتباري/ منشأة)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/62663e1acf024536a87ca36d360f276f}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص طبيعي/فرد)\\\\\\\">المطور العقاري (شخص طبيعي/فرد)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/1e66c8906f48454a9937f23aadc06fde}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"الاستشاري الهندسي\\\\\\\">الاستشاري الهندسي</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/70b22a18e7ce43eeb16e93af8d6aefbe}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المحاسب القانوني\\\\\\\">المحاسب القانوني</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">للتقدم بطلب التأهيل:</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"منصة الخدمة\\\\\\\">منصة الخدمة</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"a26f40f8-7f62-4f0b-9bd4-4cdc0f8530f3\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a2fab649a0c74f1c8c1ca6eb11260385\",\n    \"featureTabTitle\": \"الترخيص \",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p><strong>متطلبات رخصة بيع وتأجير مشروعات عقارية على الخارطة :</strong></p>\\\\n<p>&nbsp;</p>\\\\n<ol>\\\\n<li>نسخة من السجل التجاري ساري المفعول، الذي يسمح له بمزاولة التطوير العقاري.</li>\\\\n<li>شهادة عضوية الغرفة التجارية.</li>\\\\n<li>نسخة من السجل الائتماني من شركة مرخص لها كم الجهة المختصة بالخدمات الائتمانية. من تاتا.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بينه وبين مالك الارض أو مالك منفعتها بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي - إن وجد- بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>التصاميم المعمارية والمخططات الهندسية التي اعتمدتها الجهات المختصة.</li>\\\\n<li>نسخة من العقد المبرم بينه وبين المكتب الاستشاري، بما يتفق مع أحكام النظام واللائحة</li>\\\\n<li>&nbsp;نسخة من العقد المبرم بينه وبين المحاسب القانوني، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>دراسة الجدوى الاقتصادية للمشروع العقاري من مكتب استشاري تتضمن: تكاليف المشروع العقاري التقديرية، وأوجه الصرف اللازمة عليه، والتدقيق النقدي له، والمدة المتوقعة لتنفيذه.</li>\\\\n<li>تعهد منه ببدء الأعمال الإنشائية للمشروع العقاري خلال (سته) أشهر من تاريخ حصوله على الترخيص .</li>\\\\n<li>نموذج عقد بيع بينه وبين المشتري ومواعيد تسليم البيع محددة باليوم بما يتفق مع أحكام النظام واللائحة وغير متعارضة مع أجكام الشريعة الإسلامية.</li>\\\\n<li>اتفاقية فتح حساب ضمان بينه وبين بنك مرخص له في المملكة، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقًا لنظام ملكية الوحدات العقارية وفرزها وإدارتها.</li>\\\\n<li>يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري إلا إذا كانت مسجلة عينيًا.</li>\\\\n</ol>\\\\n<p>&nbsp;</p>\\\\n<p><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\\n<p>&nbsp;</p>\\\\n<p>&nbsp;</p>\\\\n<p><strong>متطلبات رخصة تسويق مشروعات عقارية على الخارطة</strong></p>\\\\n<ol style=\\\\\\\"text-align: right;\\\\\\\">\\\\n<li><em><span style=\\\\\\\"font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span></em>رقم صك تسجيل ملكية العقار.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp;</span><!--[endif]-->رقم عقد التسويق بين الوسيط العقاري والمطور-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span><!--[endif]-->نسخة عقد التطوير بين المطور ومالك الأرض-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">.</span><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; </span><!--[endif]-->التصاميم المعمارية والمخططات الهندسية</li>\\\\n</ol>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">وفي حال رغبة المطور استلام مبلغ حجز وحدات عقارية من المشتري أو المستأجر خلال مدة ( ترخيص تسويق المشروع العقاري ) الالتزام بالتالي :</p>\\\\n<ul>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- الإفصاح عن حالة المشروع والمخططات المستقبلية&nbsp;</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- عدم استلام أكثر من (5%) من قيمة الوحدة العقارية.</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- إيداع جميع مبالغ الحجز المستلمة في حساب الضمان المخصص لذلك.&nbsp;</li>\\\\n</ul>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"2ef88132-6afd-4796-813f-4479f679af37\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"المشاريع المرخصة\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Projects\\\"\\n]\",\n    \"linkedToPage\": \"umb://document/b97ea291532645a587fa2257586e22f6\"\n  },\n  {\n    \"key\": \"9c34889b-7541-4c15-ae27-27e5b636b6c6\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"المطورين المعتمدين\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Developers\\\"\\n]\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"a8f183c3-591c-48e6-b530-82da38973af2\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"Wafi\\\\\\\" is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"e881996e-1050-400d-b141-9a9f6cf81866\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"Projects\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Projects\\\"\\n]\",\n    \"linkedToPage\": \"umb://document/b97ea291532645a587fa2257586e22f6\"\n  },\n  {\n    \"key\": \"ca6706f6-fd9f-4bd5-b4e4-04eb9adc2af0\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"Certified Facilities\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Developers\\\"\\n]\",\n    \"linkedToPage\": \"\"\n  }\n]"}]},"serviceIcon":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"e2a6fcec-39a3-4711-8c61-39d7cef12462\",\n    \"mediaKey\": \"699fd5d5-4c8e-