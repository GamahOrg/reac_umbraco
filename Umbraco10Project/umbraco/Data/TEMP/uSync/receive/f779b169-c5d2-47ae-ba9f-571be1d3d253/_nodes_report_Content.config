ault":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go to Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المركز السعودي للتحكيم العقاري يسهّل إجراءات التحكيم، والتوفيق، والصلح، وإيجاد الحلول السريعة للنزاعات والخلافات العقارية للمساهمة في تخفيف العبء عن المحاكم القضائية، ويُعد مرجع قانوني وجهة تحكيمية موثوقة للقطاع العقاري.\n"},{"@Culture":"en-us","#cdata-section":"The Saudi Real Estate Arbitration Center facilitates and mediates arbitration and reconciliation procedures, and resolves real estate disputes to reduce the burden on the Kingdom’s judicial courts"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":"[\n  \"المركز السعودي للتحكيم العقاري\",\n  \"التحكيم\",\n  \"العقاري\",\n  \"الهيئة العامة للعقار\",\n  \"الخدمات الالكترونية\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المركز السعودي للتحكيم العقاري"},{"@Culture":"en-us","#cdata-section":"Saudi Real Estate Arbitration Center"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المركز السعودي للتحكيم العقاري"},{"@Culture":"en-us","#cdata-section":"Saudi Real Estate Arbitration Center "}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>المركز السعودي للتحكيم العقاري يسهّل إجراءات التحكيم، والتوفيق، والصلح، وإيجاد الحلول السريعة للنزاعات والخلافات العقارية للمساهمة في تخفيف العبء عن المحاكم القضائية، ويُعد مرجع قانوني وجهة تحكيمية موثوقة للقطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Saudi Real Estate Arbitration Center facilitates and mediates arbitration and reconciliation procedures, and resolves real estate disputes to reduce the burden on the Kingdom’s judicial courts. The arbitration center stands as the legal entity and arbitral representative for the real estate sector.&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"5420f39b-6bb8-4c1b-9b2d-c8c1dc45ce81\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>المركز السعودي للتحكيم العقاري يسهّل إجراءات التحكيم، والتوفيق، والصلح، وإيجاد الحلول السريعة للنزاعات والخلافات العقارية للمساهمة في تخفيف العبء عن المحاكم القضائية، ويُعد مرجع قانوني وجهة تحكيمية موثوقة للقطاع العقاري.&nbsp;&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"3b23e710-aab6-4a8b-8635-90e834fbd74a\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Saudi Real Estate Arbitration Center facilitates and mediates arbitration and reconciliation procedures, and resolves real estate disputes to reduce the burden on the Kingdom’s judicial courts. The arbitration center stands as the legal entity and arbitral representative for the real estate sector.&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\":