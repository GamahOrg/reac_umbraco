 for job"}]}}}},"IsRoot":true},{"Key":"df7c2dac-5e70-38fa-b6f5-a79dad9b8091","Alias":"القمة العالمية للبروبتك","Path":"/332fceee-681a-4f0a-8359-9d5a589c8aba.config","Level":3000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/332fceee-681a-4f0a-8359-9d5a589c8aba.config","Node":{"Content":{"@Key":"332fceee-681a-4f0a-8359-9d5a589c8aba","@Alias":"القمة العالمية للبروبتك","@Level":"3","Info":{"Parent":{"@Key":"3b184f5f-42a2-4b95-8b1b-a780b3348e65","#text":"القمة العالمية للبروبتك"},"Path":"///","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-09-09T13:09:10","NodeName":{"@Default":"القمة العالمية للبروبتك"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/7f6e375f509d4b339eec8f5554a5b22e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/32b23fffdfca4f8f842b6aec987bdbc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/af8a9b5bb8774643bceaf65e5fe11a69\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/7f6e375f509d4b339eec8f5554a5b22e\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p dir=\\\"rtl\\\">&nbsp;قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/32b23fffdfca4f8f842b6aec987bdbc8\",\n      \"title\": \"أهداف المبادرة\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز مكانة المملكة العربية السعودية كمركز رائد في التقنية العقارية .</li>\\n<li class=\\\"O0\\\">فتح الفرص للشركات العالمية للاستثمار محلياً في التقنية العقارية.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات التقنية  من خلال استقطاب الخبرات العالمية.</li>\\n<li class=\\\"O0\\\">الارتقاء بريادة الأعمال المحلية.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/af8a9b5bb8774643bceaf65e5fe11a69\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"https://globalproptechsummit.com\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":" قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية."}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":""}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"القمة العالمية للبروبتيك\",\n  \"بروبتيك\",\n  \"الهيئة العامة للعقار\",\n  \"قمة\",\n  \"القمة\",\n  \"العالمية\"\n]"}},"pageName":{"Value":{"#cdata-section":"القمة العالمية للبروبتك"}},"pageTitle":{"Value":{"#cdata-section":"القمة العالمية للبروبتك"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":{"#cdata-section":"القمة العالمية للبروبتك"}}}}},"IsRoot":true},{"Key":"44a3c927-b7cd-3233-abb2-943c98bfe0ea","Alias":"عن الهيئة العامة للعقار","Path":"/155c75b8-c2e3-4b26-8451-fcd2838119b6.config","Level":3000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/155c75b8-c2e3-4b26-8451-fcd2838119b6.config","Node":{"Content":{"@Key":"155c75b8-c2e3-4b26-8451-fcd2838119b6","@Alias":"عن الهيئة العامة للعقار","@Level":"3","Info":{"Parent":{"@Key":"7f764067-3c85-403f-99f4-66fecbbc4158","#text":"من نحن"},"Path":"///","Trashed":"false","ContentType":"whoWeAre","CreateDate":"2023-07-24T15:21:58","NodeName":{"@Default":"عن الهيئة العامة للعقار","Name":[{"@Culture":"ar-jo","#text":"عن الهيئة العامة للعقار"},{"@Culture":"en-us","#text":"About the Real Estate General Authority"}]},"SortOrder":"0","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"3096ebad-14f2-43cb-8987-910579aa5c57","#text":"aboutUs"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"تأسست الهيئة العامة للعقار عام 2017 لتنظيم النشاط العقاري غير الحكومي، والإشراف عليه، وتطويره بهدف تعزيز وتشجيع الاستثمار في القطاع العقاري، وتحقيق مستهدفات الاستراتيجية الشاملة للقطاع العقاري."},{"@Culture":"en-us","#cdata-section":"The Real Estate General Authority (REGA) was created in 2017 with the aim of regulating, overseeing, and promoting non-governmental real estate activities. Its main goal is to attract investments to the real estate sector while aligning with the comprehensive strategy of the sector."}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عن الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"About the Real Estate General Authority"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عن الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"Who We Are"}]},"rightBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تأسست الهيئة العامة للعقار عام 2017 لتنظيم النشاط العقاري غير الحكومي، والإشراف عليه، وتطويره بهدف تعزيز وتشجيع الاستثمار في القطاع العقاري، وتحقيق مستهدفات الاستراتيجية الشاملة للقطاع العقاري.</p>\\n<p>&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Real Estate General Authority (REGA) was created in 2017 with the aim of regulating, overseeing, and promoting non-governmental real estate activities. Its main goal is to attract investments to the real estate sector while aligning with the comprehensive strategy of the sector.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"rightFacts":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"a476b603-d6f6-40f2-8e24-7a786eae3dc5\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"تنظيم القطاع العقاري غير الحكومي\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<p>وضع اللوائح والأنظمة المُنظمة للنشاط العقاري الغير حكومي ويشمل ذلك إصدار التراخيص والتصاريح لممارسي الأنشطة العقارية.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"fe6db999-187d-415e-a0c3-25d9c968966c\\\",\\n    \\\"mediaKey\\\": \\\"e5220737-f37c-4b07-bbf3-a859ee5d873f\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"87709a70-c8a8-489a-9ba0-36b1a2025ffd\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"الإشراف على القطاع\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"مراقبة ومراجعة أنشطة القطاع العقاري غير الحكومي لضمان الامتثال للأنظمة والمعايير. كما تتبع وتقييم أداء وامتثال ممارسي الأنشطة العقارية. \\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"cf00ca1c-f2e9-4c31-b9f6-349fefec6f77\\\",\\n    \\\"mediaKey\\\": \\\"91b8b130-dda0-4199-a3b2-6127cb820ab1\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"70bc87be-ea13-411b-89eb-19c21863e2bc\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"تمكين و تطوير القطاع\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"بناء وتطوير قدرات القطاع البشرية وتحسين كفاءة الخدمات المقدمة للقطاع، ووضع إجراءات لاستدامة الأصول العقارية، وتوفير البيانات والإحصائيات العقارية لاتخاذ القرارات وتعزيز الشفافية.\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"b941f49e-ee08-4db1-ad4b-b140b339057d\\\",\\n    \\\"mediaKey\\\": \\\"4377a0e6-53fe-48bf-90f2-2475ae47abe3\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"0c6d16ff-5d20-4686-8cf7-22effb354f41\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"تشجيع الاستثمار\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تعزيز بيئة الاستثمار في القطاع العقاري من خلال تقديم مزيد من الفرص والتسهيلات للمستثمرين. يتم ذلك من خلال توفير معلومات دقيقة وشفافة حول المؤشرات العقارية السعودية، وجعل القطاع بيئة تنافسية</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"eb060428-e5b3-4d3a-9c09-bea530fef478\\\",\\n    \\\"mediaKey\\\": \\\"98ce9afc-26e3-4fd1-9099-b4f75a15eef2\\\"\\n  }\\n]\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"914b76ee-24cd-4bcd-9284-8fb4ba755175\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"Organize the Non-Governmental Real Estate Sector \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Authority is responsible for creating and enforcing rules and regulations for non-governmental real estate activities. This includes granting licenses and permits to individuals and organizations involved in the real estate sector.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"2c1481bf-aee8-4342-bc46-508fa1cab198\\\",\\n    \\\"mediaKey\\\": \\\"e5220737-f37c-4b07-bbf3-a859ee5d873f\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"92c06cf4-9671-469d-9476-0e72c10cf749\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"Supervise the Sector\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Authority oversees and assesses non-governmental real estate activities to ensure they adhere to regulations and standards. Additionally, it monitors and evaluates the compliance and performance of individuals and organizations involved in real estate activities.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"3265079d-d81f-4597-a778-5334b69cb631\\\",\\n    \\\"mediaKey\\\": \\\"91b8b130-dda0-4199-a3b2-6127cb820ab1\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"a90ad5eb-9036-497e-8890-4825684f2fda\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"Empower and Develop the Sector \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Authority focuses on enhancing the skills and capabilities of individuals in the real estate sector. It also aims to improve the efficiency of services provided to the sector, establish procedures to ensure the sustainability of real estate assets, and provide data and statistics to support decision-making and promote transparency.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"cf0e3fe5-a062-40d6-a9ea-643f78e4ee44\\\",\\n    \\\"mediaKey\\\": \\\"4377a0e6-53fe-48bf-90f2-2475ae47abe3\\\"\\n  }\\n]\"\n  },\n  {\n    \"key\": \"a9212296-8ac7-4f6a-b208-8f5d994fd877\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"Encourage Investments \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Authority aims to strengthen the investment ecosystem in the real estate sector by creating more opportunities and streamlining procedures for investors. This is achieved by offering accurate and transparent data on the Saudi Real Estate Indicators and fostering a competitive environment within the sector.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"5c10a67c-1b81-47be-ab9a-928f264ace46\\\",\\n    \\\"mediaKey\\\": \\\"98ce9afc-26e3-4fd1-9099-b4f75a15eef2\\\"\\n  }\\n]\"\n  }\n]"}]},"rightFactsTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"تسعى الهيئة إلى تحقيق استراتيجية القطاع العقاري من خلال:"},{"@Culture":"en-us","#cdata-section":"The Authority aims to fulfill the real estate sector's strategy by achieving the following objectives:"}]},"rightTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"من نحن"},{"@Culture":"en-us","#cdata-section":"Who We Are"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عن الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"About the Real Estate General Authority"}]}}}},"IsRoot":true},{"Key":"756181e8-55ac-39f3-a009-d0bc70e1d9e7","Alias":"الأنظمة واللوائح والأدلة","Path":"/92ba0fb3-29d5-49c2-b99e-522a10db9d05.config","Level":3000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/92ba0fb3-29d5-49c2-b99e-522a10db9d05.config","Node":{"Content":{"@Key":"92ba0fb3-29d5-49c2-b99e-522a10db9d05","@Alias":"الأنظمة واللوائح والأدلة","@Level":"3","Info":{"Parent":{"@Key":"256de293-04b8-413b-a7de-afdafaf300c4","#text":"المكتبة"},"Path":"///","Trashed":"false","ContentType":"legislationsRegulations","CreateDate":"2024-07-30T11:59:51","NodeName":{"@Default":"الأنظمة واللوائح والأدلة","Name":[{"@Culture":"ar-jo","#text":"الأنظمة واللوائح والأدلة"},{"@Culture":"en-us","#text":"Rules, Regulations, and Guidelines"}]},"SortOrder":"0","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"292aa2d4-bcb8-46bd-a5c9-1db824857948","#text":"LegislationsRegulations"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأنظمة واللوائح والأدلة"},{"@Culture":"en-us","#cdata-section":"Rules, Regulations, and Guidelines"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"الانظمة\",\n  \"الوائح\",\n  \"الادلة\",\n  \"الانظمة واللوائح والادلة\",\n  \"الهيئة العامة للعقار\",\n  \"قوانين\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأنظمة واللوائح والأدلة"},{"@Culture":"en-us","#cdata-section":"Rules, Regulations, and Guidelines"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأنظمة واللوائح والأدلة"},{"@Culture":"en-us","#cdata-section":"Rules, Regulations, and Guidelines"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأنظمة واللوائح والأدلة"},{"@Culture":"en-us","#cdata-section":"Rules, Regulations, and Guidelines"}]}}}},"IsRoot":true},{"Key":"266b3fa0-f542-39ab-bfad-fb917c2aa534","Alias":"الوساطة العقارية","Path":"/919833c5-6fef-41d8-a738-e5a276acb43e.config","Level":3001,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/919833c5-6fef-41d8-a738-e5a276acb43e.config","Node":{"Content":{"@Key":"919833c5-6fef-41d8-a738-e5a276acb43e","@Alias":"الوساطة العقارية","@Level":"3","Info":{"Parent":{"@Key":"75795868-cfb0-4021-a108-d26b070a39a4","#text":"الخدمات الإلكترونية"},"Path":"///","Trashed":"false","ContentType":"service","CreateDate":"2023-09-05T10:16:47","NodeName":{"@Default":"الوساطة العقارية","Name":[{"@Culture":"ar-jo","#text":"الوساطة العقارية"},{"@Culture":"en-us","#text":"FAL – Real Estate Brokerage"}]},"SortOrder":"1","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go To Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"صفحة الخدمات الإلكترونية للوساطة العقارية، تقدم للأفراد والمنشآت العقارية تراخيص فال لممارسة الأنشطة العقارية، بالإضافة إلى خدمات الوساطة المبتكرة، سعيًا لتنظيم وتحسين الخدمات المقدمة في السوق العقاري، وحماية المستفيدين، ورفع الثقة في السوق وتحفيز النشاط العقاري.\n"},{"@Culture":"en-us","#cdata-section":"The Electronic Services page for Real Estate Brokerage offers individuals and real estate establishments the \"FAL\" license to engage in real estate activities."}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"الوساطة\",\n  \"الوساطة العقارية\",\n  \"الخدمات الالكترونية\",\n  \"الافراد\",\n  \"فال\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الوساطة العقارية"},{"@Culture":"en-us","#cdata-section":"FAL – Real Estate Brokerage"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الوساطة العقارية"},{"@Culture":"en-us","#cdata-section":"FAL – Real Estate Brokerage "}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>صفحة الخدمات الإلكترونية للوساطة العقارية، تقدم للأفراد والمنشآت العقارية تراخيص \\\"فال \\\" لممارسة الأنشطة العقارية، بالإضافة إلى خدمات الوساطة المبتكرة، سعيًا لتنظيم وتحسين الخدمات المقدمة في السوق العقاري، وحماية المستفيدين، ورفع الثقة في السوق وتحفيز النشاط العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Electronic Services page for Real Estate Brokerage offers individuals and real estate establishments the \\\"FAL\\\" license to engage in real estate activities. It also provides innovative services to enhance and organize the services offered in the real estate market. These services aim to protect the rights of beneficiaries, boost market confidence, and facilitate real estate activities.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"bc77edf1-894c-41c4-a893-8e53e29da42e\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>صفحة الخدمات الإلكترونية للوساطة العقارية، تقدم للأفراد والمنشآت العقارية تراخيص \\\\\\\"فال \\\\\\\" لممارسة الأنشطة العقارية، بالإضافة إلى خدمات الوساطة المبتكرة، سعيًا لتنظيم وتحسين الخدمات المقدمة في السوق العقاري، وحماية المستفيدين، ورفع الثقة في السوق وتحفيز النشاط العقاري.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"014ded59-4cc1-4e7a-bf07-f565a0a891ed\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/889279a4914246a9b2db42f9b22a4b68\",\n    \"featureTabTitle\": \"الاستعلامات\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>إمكانية البحث والتحقق من الأفراد والمنشآت العقارية، بالإضافة إلى التحقق من صلاحية الإعلان العقاري.</p>\\\\n<p>&nbsp;</p>\\\\n<p><a href=\\\\\\\"https://eservicesredp.rega.gov.sa/auth/queries\\\\\\\">الاستعلامات</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"a0b90090-73f3-430e-b9e2-eba9f5073d72\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"المنصات العقارية المرخصة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">يُتاح للأفراد إمكانية استعراض جميع المنصات العقارية الإلكترونية المرخصة من الهيئة العامة للعقار برخصة فال للوساطة والتسويق العقاري.</p>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">&nbsp;</span></p>\\\\n<div>\\\\n<table border=\\\\\\\"0\\\\\\\" cellspacing=\\\\\\\"0\\\\\\\" cellpadding=\\\\\\\"0\\\\\\\" width=\\\\\\\"95%\\\\\\\" class=\\\\\\\"MsoNormalTable\\\\\\\" style=\\\\\\\"width: 95.84%; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 0cm 0cm 0cm; mso-table-dir: bidi;\\\\\\\" dir=\\\\\\\"rtl\\\\\\\">\\\\n<tbody>\\\\n<tr style=\\\\\\\"mso-yfti-irow: 0; mso-yfti-firstrow: yes;\\\\\\\">\\\\n<td width=\\\\\\\"16%\\\\\\\" valign=\\\\\\\"top\\\\\\\" style=\\\\\\\"width: 16.86%; border: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\\\\\\\">\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: center; tab-stops: 88.5pt;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"center\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: center; tab-stops: 88.5pt;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"center\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: center; tab-stops: 88.5pt;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"center\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">&nbsp; &nbsp; &nbsp; <a href=\\\\\\\"https://eservicesredp.rega.gov.sa/main/Admin/Requests/sa.aqar.fm\\\\\\\">عقار</a></s