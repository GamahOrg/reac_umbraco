n-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go to Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"منصة السجل العقاري تُمكّن مُلاّك العقارات ووكلاءهم من تسجيل العقارات عينيًا، وتتيح الوصول الى خدمات التسجيل العيني للعقار بشكل فعّال وميسر، حيث يساهم السجل العقاري في حفظ حقوق الملكية للعقارات، وسهولة تداولها وتوثيق التصرفات عليها، والحد من النزاعات العقارية، وزيادة الثقة في القطاع العقاري.\n"},{"@Culture":"en-us","#cdata-section":"The Real Estate Registry (RER) platform makes it easy for landlords and agents to register real estate. It simplifies the process, preserves ownership rights, and reduces disputes while building trust in the real estate sector.\n"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":"[\n  \"السجل العقاري\",\n  \"السجل\",\n  \"العقاري\",\n  \"العقار\",\n  \"تسجيل\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\",\n  \"الخدمات الالكترونية\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"السجل العقاري"},{"@Culture":"en-us","#cdata-section":"Real Estate Registry (RER)"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"السجل العقاري"},{"@Culture":"en-us","#cdata-section":"Real Estate Registry (RER)"}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>منصة السجل العقاري تُمكّن مُلاّك العقارات ووكلاءهم من تسجيل العقارات عينيًا، وتتيح الوصول الى خدمات التسجيل العيني للعقار بشكل فعّال وميسر، حيث يساهم السجل العقاري في حفظ حقوق الملكية للعقارات، وسهولة تداولها وتوثيق التصرفات عليها، والحد من النزاعات العقارية، وزيادة الثقة في القطاع العقاري.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Real Estate Registry (RER) platform makes it easy for landlords and agents to register real estate. It simplifies the process, preserves ownership rights, and reduces disputes while building trust in the real estate sector.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"2005b907-619f-4bfb-a707-4f7ed617bf23\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>منصة \\\\\\\"السجل العقاري\\\\\\\" تُمكّن مُلاّك العقارات ووكلاءهم من تسجيل العقارات عينيًا، وتتيح الوصول الى خدمات التسجيل العيني للعقار بشكل فعّال وميسر، حيث يساهم السجل العقاري في حفظ حقوق الملكية للعقارات، وسهولة تداولها وتوثيق التصرفات عليها، والحد من النزاعات العقارية، وزيادة الثقة في القطاع العقاري.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"3a4e0626-f612-49d3-aba0-0c23fe99f2ef\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": \"Lorem ipsum dolor sit amet,\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate Registry (RER) platform makes it easy for landlords and agents to register real estate. It simplifies the process, preserves ownership rights, and reduces disputes while building trust in the real estate sector.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n