0Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ed1eb219-ac81-4a3c-89ee-6ae657744bd5.config","Node":{"Content":{"@Key":"ed1eb219-ac81-4a3c-89ee-6ae657744bd5","@Alias":"\"هيئة العقار\" تُصدر اللائحة التنفيذية للمساهمات العقارية وتعلن عن استقبال الطلبات بموجبها","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-02-16T18:56:19","NodeName":{"@Default":"\"هيئة العقار\" تُصدر اللائحة التنفيذية للمساهمات العقارية وتعلن عن استقبال الطلبات بموجبها"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-02-16T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"fd750e4d-e33e-4c4a-9940-ae4c7b8839d6\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: 200%; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 12.0pt; line-height: 200%; font-family: 'Times New Roman',serif; mso-ascii-font-family: NeoSansArabic; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: NeoSansArabic;\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن صدور اللائحة التنفيذية لنظام المساهمات العقارية ونشرها عبر الموقع الرسمي للهيئة وصحيفة أم القرى اليوم الجمعة السادس من شعبان 1445هـ الموافق 16 فبراير 2024 م، بالتنسيق مع هيئة السوق المالية، وفقاً لنظام المساهمات العقارية الصادر عن مجلس الوزراء ، مؤكدة إتاحة التقدم لطلب ترخيص المساهمات العقارية عبر الخدمات الإلكترونية للهيئة</span><span style=\\\"font-size: 12.0pt; line-height: 200%; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">.<br></span><span style=\\\"font-size: 12.0pt; line-height: 200%; font-family: 'Times New Roman',serif; mso-ascii-font-family: NeoSansArabic; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: NeoSansArabic;\\\" lang=\\\"AR-SA\\\">وأوضحت الهيئة أنَّ اللائحة التنفيذية لنظام المساهمات العقارية احتوت على أربعين مادة رئيسية موزعة على ستة فصول ، تشمل التعريفات والأحكام العامة وتصنيف المساهمة العقارية وصور العقار محل المساهمة العقارية، وجاء الفصل الأول مخصصاً لـ \\\" إجراءات الترخيص \\\" حيث اشتمل على شروط ترخيص المساهمة العقارية ونموذج اتفاقية المساهمة العقارية، بينما اشتمل الفصل الثاني على المواد الخاصة بـ \\\" أحكام رأس مال المساهمة العقارية \\\" واشتراطات إضافة المبلغ الاحتياطي للمساهمة العقارية وآلية التصرف به، وتصرف المساهم بحصته في المساهمة العقارية</span><span style=\\\"font-size: 12.0pt; line-height: 200%; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\">.<br></span><span style=\\\"font-size: 12.0pt; line-height: 200%; font-family: 'Times New Roman',serif; mso-ascii-font-family: NeoSansArabic; mso-fareast-font-family: 'Times New Roman'; mso-hansi-font-family: NeoSansArabic;\\\" lang=\\\"AR-SA\\\">فيما اشتمل الفصل الثالث على ما يخص \\\"ممارسو نشاط المساهمات العقارية واختصاصاتهم \\\" وتصنيف الممارسين للنشاط وشروطهم والاختصاصات المسندة إليهم وواجباتهم، بينما جاء الفصل الرابع مشتملاً على اختصاصات \\\" جمعية المساهمين \\\" ودورها في المساهمة العقارية وآلية دعوة اجتماع جمعية المساهمين، فيما تطرق الفصل الخامس إلى \\\"آلية توزيع الأرباح وتصفية المساهمة العقارية \\\" وبين الأحكام الخاصة بالأرباح القابلة للتوزيع، وجوازية توزيع أرباح مرحلية ناتجة عن متحصلات البيع على مساهميها بشكل نصف سنوي أو ربع سنوي، والأحكام الخاصة بتقييم العقار محل المساهمة العقارية، وأخيراً فقد بينّت اللائحة التنفيذية بالفصل السادس أحكام \\\"الرقابة والتفتيش والضبط\\\" وصلاحية مسؤول الضبط ومهامهم ودورهم عند ضبط مخالفات أحكام النظام واللائحة التنفيذية.<br>وفي سياق متصل نشرت الهيئة ضوابط حساب الضمان للمساهمات العقارية التي اشتملت على 7 مواد رئيسية حيث جاء في المادة الأولى تعريف حساب الضمان بأنّه: الحساب المصرفي الخاص بالمساهمة العقارية وتعريف أمين الحساب بأنّه المؤسسة المصرفية المرخص لها من قبل جهة الاختصاص، وذكرت المادة الثانية أنّ هذه الضوابط تهدف إلى تنظيم حساب الضمان في مشاريع المساهمات العقارية فيما تطرقت المادة الثالثة إلى الأحكام المتعلقة بفتح الحساب وآلية إنشاء الحسابات الفرعية المرتبطة بالحساب الرئيسي الخاص بالمساهمة العقارية، أما الفصل الرابع جاء مخصصاً لأحكام إدارة الحساب الرئيس والحسابات الفرعية وآليات الصرف منهما، وتضمنت المادة الخامسة مهام أمين الحساب والقيود الواجبة عليه, وقد ذكرت الضوابط بالمادة السادسة بعدم إغلاق حساب الضمان من قبل المرخص له بعد انقضاء المساهمة العقارية وإعادة الأموال إلى مستحقيها إلى بعد موافقة الهيئة العامة للعقار ، ويمكن الاطلاع اللائحة عبر<a href=\\\"/media/1siktujc/mosahamat.pdf\\\" title=\\\"https://rega.gov.sa/media/1siktujc/mosahamat.pdf\\\"> موقع الهيئة الرسمي</a></span><span style=\\\"font-size: 12.0pt; line-height: 200%; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';\\\" lang=\\\"AR-SA\\\"><a href=\\\"/media/1siktujc/mosahamat.pdf%20.#https://rega.gov.sa/media/1siktujc/mosahamat.pdf%20.\\\" title=\\\"https://rega.gov.sa/media/1siktujc/mosahamat.pdf .\\\">&nbsp;</a></span></p>\\n<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>&nbsp;</span></p>\\n<p style=\\\"line-height: 200%;\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"هيئة العقار\" تُصدر اللائحة التنفيذية للمساهمات العقارية وتعلن عن استقبال الطلبات بموجبها "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e1ca19ba-fe7f-31fe-b966-c8c5e7bb8d8f","Alias":"تفاصيل المشروع","Path":"/b97ea291-5326-45a5-87fa-2257586e22f6.config","Level":4000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b97ea291-5326-45a5-87fa-2257586e22f6.config","Node":{"Content":{"@Key":"b97ea291-5326-45a5-87fa-2257586e22f6","@Alias":"تفاصيل المشروع","@Level":"4","Info":{"Parent":{"@Key":"6218a02f-9895-4aed-a87b-65580ff81940","#text":"بيع وتأجير مشروعات عقارية على الخارطة"},"Path":"////","Trashed":"false","ContentType":"wafiProjectsDetails","CreateDate":"2024-10-06T11:09:24","NodeName":{"@Default":"تفاصيل المشروع"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"e32bfd01-78a1-46d1-9efe-d4f37e3f3cc9","#text":"WafiProjectsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"تفاصيل المشروع"}},"pageTitle":{"Value":{"#cdata-section":"تفاصيل المشروع"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":"تفاصيل المشروع"}}}}},"IsRoot":true},{"Key":"191da11f-8b31-3053-80be-dc7ca3d70635","Alias":"مجلس بروبتيك","Path":"/6bb3663f-1747-46c0-b49b-c57485392f66.config","Level":4000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6bb3663f-1747-46c0-b49b-c57485392f66.config","Node":{"Content":{"@Key":"6bb3663f-1747-46c0-b49b-c57485392f66","@Alias":"مجلس بروبتيك","@Level":"4","Info":{"Parent":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","#text":"مركز بروتيك السعودية"},"Path":"////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-29T13:53:01","NodeName":{"@Default":"مجلس بروبتيك"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطا ع التقنية العقارية لتبادل المعرفة والخبرات و تسليط الضوء على أحدث التطورات في التقنيات العقارية بما يسهم في رفع مستوى الوعي بأهمية التقنيات في تعزيز كفاءة السوق العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\",\n      \"title\": \"أهداف المبادرة :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز المعرفة بالتقنيات العقارية وتسليط الضوء على أحدث التطورات فيها.</li>\\n<li class=\\\"O0\\\">تشجيع التعاون بين الشركات عن طريق بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية.</li>\\n<li class=\\\"O0\\\">نشر الوعي والتثقيف بأهمية التقنيات العقارية الحديثة وكيفية الاستفادة منها لتحسين الأداء وزيادة الكفاءة في السوق العقاري.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات والأفكار عن طريق توفير منصة يشارك فيها المتخصصون تجاربهم وأفكارهم والحلول المبتكرة لمواجهة تحديات القطاع العقاري .</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مجلس <span>&nbsp;بروبتيك؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">جلسات حوارية تجمع الخبرات والعاملين بالقطاع العقاري والتقني</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو الهدف من<span>&nbsp; المجلس؟</span>\\n<ul style=\\\"list-style-type: circle;\\\">\\n<li>تعزيز المعرفة بالتقنيات العقارية</li>\\n<li>تبادل الخبرات والأفكار</li>\\n<li>رفع مستوى الوعي بأهمية التقنيات العقارية الحديثة</li>\\n<li>تحسين الأداء وزيادة الكفاءة في السوق العقاري</li>\\n<li>بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية</li>\\n<li>تعزيز التكامل وتحقيق الفائدة المشتركة</li>\\n</ul>\\n</li>\\n</ul>\\n<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد شهادة للحضور ؟</li>\\n</ul>\\n</div>\\n<div class=\\\"O0\\\" style=\\\"padding-right: 40px; padding-left: 40px;\\\">لا</div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; رواد الأعمال </span>و أصحاب الشركات الناشئة<span>&nbsp; الصغيرة </span>و المتوسطة</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مجلس التقنية العقارية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"61eab568-c3c6-3dff-9cb1-0c71c3b9a0cf","Alias":"معالي محافظ الهيئة يلتقي بسمو أمير القصيم ويعقد اللقاء المفتوح بغرفة القصيم","Path":"/f2ce8916-1feb-4268-a805-918d33f767cc.config","Level":4000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f2ce8916-1feb-4268-a805-918d33f767cc.config","Node":{"Content":{"@Key":"f2ce8916-1feb-4268-a805-918d33f767cc","@Alias":"معالي محافظ الهيئة يلتقي بسمو أمير القصيم ويعقد اللقاء المفتوح بغرفة القصيم","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-09-19T11:32:06","NodeName":{"@Default":"معالي محافظ الهيئة يلتقي بسمو أمير القصيم ويعقد اللقاء المفتوح بغرفة القصيم","Name":[{"@Culture":"ar-jo","#text":"معالي محافظ الهيئة يلتقي بسمو 