#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"القمة السعودية للبناء والبنية التحتية"},{"@Culture":"en-us","#cdata-section":"القمة السعودية للبناء والبنية التحتية"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-04T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-04T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"8e16f374-ec3c-3a6c-a942-c0c2ac3bfbb3","Alias":"هيئة العقار\": انضمام 8 أحياء جنوب و غرب الرياض للسجل العقاري ضمن المرحلة الثالثة\"","Path":"/27619cdc-00e4-489a-952b-bf012f715d52.config","Level":4014,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/27619cdc-00e4-489a-952b-bf012f715d52.config","Node":{"Content":{"@Key":"27619cdc-00e4-489a-952b-bf012f715d52","@Alias":"هيئة العقار\": انضمام 8 أحياء جنوب و غرب الرياض للسجل العقاري ضمن المرحلة الثالثة\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-31T11:56:42","NodeName":{"@Default":"هيئة العقار\": انضمام 8 أحياء جنوب و غرب الرياض للسجل العقاري ضمن المرحلة الثالثة\""},"SortOrder":"14","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-26T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"6cd75119-9e80-4417-96f8-480d66402ba9\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">أعلنتْ الهيئة العامة للعقار عن انضمام ثمانية أحياء مستفيدة من السجل العقاري جنوب وغرب مدينة الرياض ضمن المرحلة الثالثة والتي بدأت مطلع هذا الأسبوع.<br><span>ودعت الهيئة ملاك العقارات في أحياء: ( الحزم، الزهرة، السويدي الغربي، العريجاء الأوسط، العريجاء الغربي ، العوالي ، ظهرة البديعة، لبن ) إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل ابتداءً من اليوم الأربعاء، ويستمر التسجيل حتى نهاية 28 مارس 2024م الموافق 18 رمضان 1445هـ ، وبذلك تكون المرحلة الثالثة من رحلة أعمال السجل العقاري شملت 8 مناطق عقارية, تضم كل منطقة عقارية مستفيدة عدداً من الأحياء ليبلغ إجمالي عدد الأحياء المستفيدة في المدن الثلاث ( 56 حياً) بواقع ( 54 حياً ) في مدينة الرياض ، وحي واحد في الدمام والمدنية المنورة&nbsp;.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه الأحياء مُتاح عن طريق منصة السجل العقاري الإلكترونية&nbsp;https://eservices.rer.sa&nbsp;أو من خلال مراكز الخدمة، مبيَّنة أنّ التسجيل العيني يشترط وجود صك إلكتروني مُحدَّث صادر عن وزارة العدل مكتمل البيانات مستوفٍ لشروط الملكية، وهوية سارية، ووكالة في حال كان مقدم الطلب وكيلاً.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأشارت إلى إمكانية التواصل مع شركة \\\"السجل العقاري\\\" من خلال الرقم الموحد للاستفسارات (199002) الذي تم تخصيصه للإجابة على أية استفسارات أو متابعة الطلبات، أو لتسهيل عملية التسجيل يمكن للمستفيدين الراغبين في زيارة مركز خدمة العملاء في مدينة الرياض حجز موعد عن طريق الموقع الرسمي للسجل العقاري&nbsp;<a href=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex.#https://bookmyappointment.rer.sa/ar/AppointmentIndex.\\\" title=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex.\\\" data-anchor=\\\"#https://bookmyappointment.rer.sa/ar/AppointmentIndex.\\\">https://bookmyappointment.rer.sa/ar/AppointmentIndex.</a></span></p>\\n<p>&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار\": انضمام 8 أحياء جنوب و غرب الرياض للسجل العقاري ضمن المرحلة الثالثة\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"هيئة العقار\": انضمام 8 أحياء جنوب و غرب الرياض للسجل العقاري ضمن المرحلة الثالثة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"e42cc5cd-38cb-389b-bde5-719602fba78f","Alias":"EXPO Real 2023","Path":"/927b4fc6-1a91-4f72-88ef-aaa564de5c05.config","Level":4014,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/927b4fc6-1a91-4f72-88ef-aaa564de5c05.config","Node":{"Content":{"@Key":"927b4fc6-1a91-4f72-88ef-aaa564de5c05","@Alias":"EXPO Real 2023","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//EXPOReal2023","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:47:29","NodeName":{"@Default":"EXPO Real 2023","Name":[{"@Culture":"ar-jo","#text":"EXPO Real 2023"},{"@Culture":"en-us","#text":"EXPO Real 2023"}]},"SortOrder":"14","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-06T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-06T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>يهدف المعرض إلى تقديم نسخة استثنائية من معارض إكسبو ستترك أثرًا باقيًا في ذاكرة زواره. سيشكل المعرض منصةً فريدةً تستعرض أبرز الابتكارات والتقنيات الحديثة، واسهاماتها في تذليل العقبات التي تواجه الكوكب في مختلف المجالات.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>يهدف المعرض إلى تقديم نسخة استثنائية من معارض إكسبو ستترك أثرًا باقيًا في ذاكرة زواره. سيشكل المعرض منصةً فريدةً تستعرض أبرز الابتكارات والتقنيات الحديثة، واسهاماتها في تذليل العقبات التي تواجه الكوكب في مختلف المجالات.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المانيا - ميونخ"},{"@Culture":"en-us","#cdata-section":"المانيا - ميونخ"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"54511f01-a4c6-4827-86b2-9f4b15c4e0f9\",\n    \"mediaKey\": \"51ac778b-4259-4c5d-a624-398941ca16e0\"\n  },\n  {\n    \"key\": \"8dd0fe67-c98f-4a09-b342-d57496939eef\",\n    \"mediaKey\": \"1ee808ef-ef54-41ab-87b6-e167093c068b\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"EXPO Real 2023"},{"@Culture":"en-us","#cdata-section":"EXPO Real 2023"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث دولي"},{"@Culture":"en-us","#cdata-section":"International event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"EXPO Real 2023"},{"@Culture":"en-us","#cdata-section":"EXPO Real 2023"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-04T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-04T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"6c20fb90-1650-3c84-90eb-bcbd1a4bad83","Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ 25","Path":"/de54fa09-fe89-4a65-baae-d37e2fdf80f3.config","Level":4015,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/de54fa09-fe89-4a65-baae-d37e2fdf80f3.config","Node":{"Content":{"@Key":"de54fa09-fe89-4a65-baae-d37e2fdf80f3","@Alias":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ 25","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-31T11:53:04","NodeName":{"@Default":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ 25"},"SortOrder":"15","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-25T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"8e3f6088-151d-4fd9-9a1c-ad12fc51fc6e\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">عقد مجلس إدارة الهيئة العامة للعقار اجتماعه الخامس والعشرين برئاسة معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة الأستاذ ماجد بن عبد الله الحقيل، وبحضور معالي نائبه المهندس عبد الله البدير، والرئيس التنفيذي للهيئة المهندس عبد الله الحماد، وأعضاء المجلس ممثلي الجهات الحكومية، وممثلي القطاع الخاص.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>واطلّع المجلس على القرارات والتوجيهات الصادرة منه، واعتمد مستهدفات الهيئة لعام 2024م، وحوكمة تنفيذ الإستراتيجية الشاملة للقطاع العقاري، كما اطلّع على سير عمل منظومة التشريعات العقارية، وأبرز الأعمال التي تمت فيما يخص البنية التحتية للتسجيل العيني للعقار والمناطق المعلن عنها، وما سيتم إطلاقه في عام 2024م، فيما استعرض أبرز الأعمال التي تخص الأنشطة العقارية والأعمال الرقابية عليها، ورحلة تفعيل نظام المساهمات العقارية.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ 25"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ 25"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8eb40c17-6c19-30c5-8a90-926301e0f7e0","Alias":"مؤتمر ومعرض ميفما","Path":"/d4258e32-551a-44fc-9413-e3d97bbd1f7e.config","Level":4015,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/d4258e32-551a-44fc-9413-e3d97bbd1f7e.config","Node":{"Content":{"@Key":"d4258e32-551a-44fc-9413-e3d97bbd1f7e","@Alias":"مؤتمر ومعرض ميفما","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:48:40","NodeName":{"@Default":"مؤتمر ومعرض ميفما","Name":[{"@Culture":"ar-jo","#text":"مؤتمر ومعرض ميفما"},{"@Culture":"en-us","#text":"مؤتمر ومعرض ميفما"}]},"SortOrder":"15","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-15T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-15T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>يهدف مؤتمر ومعرض ميفما كونفكس إلى إنشاء منصة لمشاركة المعرفة والخبرات بين أصحاب المصالح والشركات في قطاع إدارة المرافق، كما يوفر فرصة فريدة للتواصل مع أبرز المحترفين وصناع القرار في مجال إدارة المرافق، بما في ذلك ممثلي الحكومة والمطورين ومقدمي خدمات إدارة المرافق والموردين.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>يهدف مؤتمر ومعرض ميفما كونفكس إلى إنشاء منصة لمشاركة المعرفة والخبرات بين أصحاب المصالح والشركات في قطاع إدارة المرافق، كما يوفر فرصة فريدة للتواصل مع أبرز المحترفين وصناع القرار في مجال إدارة المرافق، بما في ذلك ممثلي الحكومة والمطورين ومقدمي خدمات إدارة المرافق والموردين.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - فندق الفيصلية"},{"@Culture":"en-us","#cdata-section":"الرياض - فندق الفيصلية"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"134daf38-57bc-47ba-962a-b7a72268fcfa\",\n    \"mediaKey\": \"61c8c46b-67bb-4818-b5c9-55e58197af87\"\n  },\n  {\n    \"key\": \"de3e0ec9-cfb6-4798-bd08-552204b934fd\",\n    \"mediaKey\": \"921c3025-985d-40af-b037-ac6c5dc843dd\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"مؤتمر ومعرض ميفما"},{"@Culture":"en-us","#cdata-section":"مؤتمر ومعرض ميفما"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"مؤتمر ومعرض ميفما"},{"@Culture":"en-us","#cdata-section":"مؤتمر ومعرض ميفما"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-15T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-15T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"ae473930-539b-3098-b9ca-8b7ae8bf809a","Alias":"هيئة العقار تدعو ملاَّك العقارات في (48) حي في \" الرياض والدمام والمدينة المنورة “لتسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ولمدة 90 يوم","Path":"/2c5ed817-29ea-47a8-a8b5-1500d345bde7.config","Level":4016,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2c5ed817-29ea-47a8-a8b5-1500d345bde7.config","Node":{"Content":{"@Key":"2c5ed817-29ea-47a8-a8b5-1500d345bde7","@Alias":"هيئة العقار تدعو ملاَّك العقارات في (48) حي في \" الرياض والدمام والمدينة المنورة “لتسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ولمدة 90 يوم","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-31T11:51:08","NodeName":{"@Default":"هيئة العقار تدعو ملاَّك العقارات في (48) حي في \" الرياض والدمام والمدينة المنورة “لتسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ولمدة 90 يوم"},"SortOrder":"16","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-24T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"4626bdaa-9cef-4ec8-8899-45d8b1d883b0\",\n    \"mediaKey\": \"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">دعتْ الهيئةُ العامة للعقار ملاَّك العقارات في<span>&nbsp;</span>48 حي بمدينة الرياض والدمام والمدينة المنورة لتسجيل عقاراتهم في \\\" السجل العقاري “ابتداءً من اليوم الأحد الرابع والعشرين من ديسمبر 2023م الموافق 11 جمادى الآخر 1445هـ، حتى نهاية اليوم الثامن والعشرين من مارس 2024م الموافق 18 رمضان 1445هـ.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأكدتْ الهيئة أنَّ التسجيل الأول للعقارات في هذه الأحياء يتم عن طريق منصة السجل العقاري الإلكترونية<span>&nbsp;</span><a href=\\\"https://rer.sa/rer-services-ar\\\"><span>https://rer.sa/rer-services-ar</span></a><span>&nbsp;</span>&nbsp;حيث يتعين<span>&nbsp;</span>على ملاك العقارات السكنية والتجارية وغيرها في الأحياء تقديم طلب التسجيل العيني الأول، مرفقاً به المستندات المثبتة للعقار (صك إلكتروني صادر من وزارة العدل مكتمل البيانات مستوفٍ لشروط الملكية وهوية سارية ووكالة في حال كان مقدم الطلب وكيل عن المالك ).</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأوضحت الهيئة بأنَّ هذه المرحلة تُعد&nbsp; هي المرحلة الثالثة في رحلة أعمال السجل العقاري وتشمل&nbsp; 46 حي بمدينة الرياض&nbsp; هي : حي الملك سلمان، البساتين، التضامن، الزاهر، الرسالة، الراية، العلا، المشرق ، الخير ، العارض، النرجس، القيروان، الياسمين، الملقا، الصحافة، الندى، الربيع، العقيق، حطين، النخيل، المحمدية، الملك فهد، الورود، الرحمانية، الرائد، جامعة الملك سعود، المرسلات،<span>&nbsp;</span>المغرزات، النزهة، الملك عبدالله، الروضة، القدس، الحمراء، الشهداء، قرطبة، جامعة الامام محمد بن سعود، الأندلس، الملك فيصل، غرناطة ،&nbsp; النهضة، الخليج، إشبيلية، اليرموك، المونسية، المعيزيلة، القادسية ، إضافة إلى حي واحد بمدينة الدمام هو&nbsp; حي الشعلة ، وحي واحد في المدينة المنورة هو حي العاقول . حيث تضم هذه المرحلة أكثر من 368,565 ألف قطعة عقارية في المدن الثلاث، وأنَّ السجلات العقارية التي يبدأ إصدارها اليوم في هذه الأحياء تتضمن بيانات وأوصاف العقار وحالته وجميع ما يتعلق به من حقوق والتزامات وتصرفات عقارية مرتبطة بالمعلومات الجيومكانية من خلال الرفع المساحي والإحداثيات الجغرافية للعقارات التي تمت خلال الفترة الماضية.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأوضحت الهيئة أنَّ&nbsp; شركة \\\" السجل العقاري \\\" قد أكملت استعدادها لتسجيل العقارات عن طريق المنصة الإلكترونية أو زيارة المستفيدين لـ \\\"مراكز خدمة مستفيدي السجل العقاري\\\" في رويال مول\\\" بمدينة الرياض و في \\\"البوابة الاقتصادية\\\" في مدينة الدمام، و \\\"فرع مركز خدمة العملاء لأمانة المدينة المنورة في عالية سنتر\\\" في المدينة المنورة طوال أيام العمل من الساعة التاسعة صباحاً وحتى الخامسة مساءً، حيث تم تجهيز هذه المراكز لتقديم الدعم للمستفيدين في تسجيل عقاراتهم، ومساعدتهم على استخدام الخدمات الإلكترونية من خلال أجهزة الخدمة الذاتية المتوفرة في المركز، إضافة إلى الرقم الموحد للاستفسارات 199002 الذي تم تخصيصه للإجابة على أية استفسارات أو متابعة الطلبات ، ولتسهيل عملية التسجيل يمكن للمستفيدين الراغبين في زيارة مراكز خدمة العملاء حجز موعد عن طريق&nbsp; الموقع الرسمي للسجل العقاري&nbsp;<span>&nbsp;</span><a href=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex&nbsp;%20.#https://bookmyappointment.rer.sa/ar/AppointmentIndex&nbsp;%20.\\\" title=\\\"https://bookmyappointment.rer.sa/ar/AppointmentIndex&nbsp; .\\\" data-anchor=\\\"#https://bookmyappointment.rer.sa/ar/AppointmentIndex&nbsp; .\\\"><span lang=\\\"EN-US\\\">https://bookmyappointment.rer.sa/ar/AppointmentIndex</span>&nbsp; .</a></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"هيئة العقار تدعو ملاَّك العقارات في (48) حي في \" الرياض والدمام والمدينة المنورة “لتسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ولمدة 90 يوم"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"هيئة العقار تدعو ملاَّك العقارات في (48) حي في \" الرياض والدمام والمدينة المنورة “لتسجيل عقاراتهم في السجل العقاري ابتداءً من اليوم ولمدة 90 يوم"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"beb72318-1802-39ea-bd4f-a7db4fd29a22","Alias":"فعالية اغلى بلد","Path":"/3580e3b3-f202-4853-9714-16ac684976a3.config","Level":4016,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3580e3b3-f202-4853-9714-16ac684976a3.config","Node":{"Content":{"@Key":"3580e3b3-f202-4853-9714-16ac684976a3","@Alias":"فعالية اغلى بلد","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:50:06","NodeName":{"@Default":"فعالية اغلى بلد","Name":[{"@Culture":"ar-jo","#text":"فعالية اغلى بلد"},{"@Culture":"en-us","#text":"فعالية اغلى بلد"}]},"SortOrder":"16","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-20T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-20T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تهدف الفعالية الى ابراز الطاقات الثرية والابداعية واتاحة الفرصة لتقديم ما لدى الشباب السعودي وتحويلها الى واقع وتشجيعها وإظهارها بتنوع اشكالها &nbsp;نشاطات اجتماعية وثقافية و رياضية وترفيهية وغيرها من اجل الاستكشاف والابداع وابرازها.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>تهدف الفعالية الى ابراز الطاقات الثرية والابداعية واتاحة الفرصة لتقديم ما لدى الشباب السعودي وتحويلها الى واقع وتشجيعها وإظهارها بتنوع اشكالها &nbsp;نشاطات اجتماعية وثقافية و رياضية وترفيهية وغيرها من اجل الاستكشاف والابداع وابرازها.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - منتزه حي النخيل"},{"@Culture":"en-us","#cdata-section":"الرياض - منتزه حي النخيل"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"826bf1d8-4119-4489-8093-b247576c0504\",\n    \"mediaKey\": \"45583790-003c-4b7f-ba44-b54e19b0d439\"\n  },\n  {\n    \"key\": \"c0263358-bfb2-4993-8cd8-398fe8757150\",\n    \"mediaKey\": \"495773e7-7d5b-413f-be4b-34e4610ccb50\"\n  },\n  {\n    \"key\": \"58e7700c-ca2f-4dfe-a77e-c4e6b6d608d3\",\n    \"mediaKey\": \"56cc1508-8932-4708-be7c-70f9feeed742\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"فعالية اغلى بلد"},{"@Culture":"en-us","#cdata-section":"فعالية اغلى بلد"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"فعالية اغلى بلد"},{"@Culture":"en-us","#cdata-section":"فعالية اغلى بلد"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-18T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-18T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"8769ebf9-b119-38a1-88b2-9933dd7665ec","Alias":"الهيئة العامة للعقار تُعلنْ عن بدء استقبال طلبات الترشيح للدورات التدريبية في مجال الاستشارات والتحليلات العقارية.","Path":"/1ea93f25-a0f6-49d3-822a-446744b0c50f.config","Level":4017,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1ea93f25-a0f6-49d3-822a-446744b0c50f.config","Node":{"Content":{"@Key":"1ea93f25-a0f6-49d3-822a-446744b0c50f","@Alias":"الهيئة العامة للعقار تُعلنْ عن بدء استقبال طلبات الترشيح للدورات التدريبية في مجال الاستشارات والتحليلات العقارية.","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-31T11:48:18","NodeName":{"@Default":"الهيئة العامة للعقار تُعلنْ عن بدء استقبال طلبات الترشيح للدورات التدريبية في مجال الاستشارات والتحليلات العقارية."},"SortOrder":"17","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-23T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0d0f9b38-b3bc-4fdb-9fe4-443f47b910e2\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">أعلنتْ الهيئةُ العامة للعقار اليوم السبت 23 ديسمبر2023 م الموافق 10 جمادى الآخرة 1445هـ<span>&nbsp;&nbsp;عن بدء المعهد العقاري السعودي لاستقبال طلبات التسجيل في البرنامج التدريبي للحصول على رخصة فال للاستشارات العقارية، ورخصة فال للتحليلات العقارية حيثُ يستمر استقبال طلبات الترشيح في البرنامج لمدة خمسة أيام عن طريق الموقع الرسمي للمعهد ، إذ يُعد اجتياز البرنامج التدريبي شرطًا لممارسة نشاط الاستشارات أو التحليلات العقارية سواءً للأفراد أو المُنشآت بعد أنْ بدأ نفاذ اللائحة التنظيمية للاستشارات والتحليلات العقارية ونشرها في الجريدة الرسمية.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>&nbsp;وأوضحتْ الهيئةُ أنَّ كلا النشاطين: الاستشارات والتحليلات العقارية يُعدَّان من الخدمات العقارية التي شملهما نظام الوساطة العقارية والذي بدأ تطبيق العمل به يوليو الماضي، حيث شمل النظام تنظيم ممارسة نشاط التوسط في إتمام الصفقات العقارية بين أطرافها، إضافة إلى أنشطة الخدمات العقارية والتي تشمل: التسويق العقاري، وإدارة الأملاك، وإدارة المرافق، والمزادات العقارية، والإعلانات العقارية، والاستشارات والتحليلات العقارية والتي تُمارس حصراً عن طريق مقدمي الخدمات المُرخصين والمؤهلين من المـُنشآت والأفراد.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأكدتْ الهيئة بأنَّ الفرق بين الاستشارات والتحليلات هو: وسيلة تقديمها، حيث عرَّفت اللائحة التنظيمية الاستشارات والتحليلات العقارية بأنها: التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري غير أنَّ الاستشارات العقارية هي التي يتم تقديمها للمستفيد كتابةً ويلزم مقدمها إبرام عقد بينه وبين المستفيد، بينما يتم تقديم التحليلات العقارية منشورةً عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها كأنشطة الاتصال الجماهيري.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وحول البرنامج التدريبي الذي بدأ باستقبال طلبات الترشيح اليوم وينتهي يوم الخميس 28 ديسمبر2023 م الموافق 15 جمادى الآخرة 1445هـ ، أوضحت الهيئة بأنَّه قد تم إعداده في المعهد العقاري بالتعاون مع كبرى دور التدريب المحلي والدولي المتخصصة في برامج الاستشارات والتحليلات ، ويُغطي الجوانب القانونية والاتصالية والفنية في مجال تقديم الاستشارات والتحليلات العقارية عبر كفاءات تدريبية عالية المستوى في هذا المجال، وتصل مدة البرنامج التدريبي إلى شهر ونصف (ستة أسابيع) مما يعكس الاهتمام في أهمية المخرجات لضمان دقة الاستشارات والمعلومات التي تقدّم للمستفيدين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وتقدّم الدورات التدريبية في هذين المسارين حضوريًا كل ربع سنة ابتداءً من يناير القادم نظرًا لأهمية تطبيق المهارات والعلوم والمعارف في محتوى هذه البرامج لضمان التأهيل اللازم لممارسة النشاط في القطاع العقاري، ويتضمن كل مسار 14 دورة تدريبية ، ويتشرط للتقدم في طلب الترشيح لمسار الاستشارات العقارية أن يكون المتقدم حاصلًا<span>&nbsp;&nbsp;على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (3) سنوات في ممارسة أي من الأنشطة العقارية أما بالنسبة&nbsp;&nbsp;للتحليلات العقارية فيشترط خبرة لا تقل عن (10) سنوات في ممارسة أي من الأنشطة العقارية.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">ويُمكن التقديم على البرنامج التدريبي عبر بوابة المعهد العقاري السعودي واختيار المسار المطلوب ومن ثم تقوم الهيئة بدراسة الطلب والتحقق من الاشتراطات، ويتم إشعار المتقدمين بنتائج الترشيح كمرحلة أولى ثم إشعار المقبولين بأوقات الدورات ومكان انعقادها، وبعد اجتياز البرنامج التدريبي يقوم المعهد بإصدار شهادة الاجتياز، ويكمل المتقدم إجراءات استخراج الرخصة عن طريق المنصة، ليتم بعد ذلك إصدار الرخصة بعد اجتياز البرنامج التدريبي بخمسة أيام عمل.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">ووفقًا لنظام الوساطة العقارية فإنَّه لا يمكن للأفراد أو المنشآت تقديم خدمات الاستشارات والتحليلات العقارية إلا بعد الحصول على ترخيص من الهيئة العامة للعقار، وبحسب المادة التاسعة عشر من نظام الوساطة العقارية تصل الغرامات المالية على المخالفين إلى (200.000) ريال.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلنْ عن بدء استقبال طلبات الترشيح للدورات التدريبية في مجال الاستشارات والتحليلات العقارية."}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلنْ عن بدء استقبال طلبات الترشيح للدورات التدريبية في مجال الاستشارات والتحليلات العقارية."}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"f3766cc4-d7fa-3e8e-a95a-1b75691e3410","Alias":"معرض ريستاتكس الشرقية","Path":"/7fff116b-e2b4-429b-9564-dd8ffb91ee73.config","Level":4017,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/7fff116b-e2b4-429b-9564-dd8ffb91ee73.config","Node":{"Content":{"@Key":"7fff116b-e2b4-429b-9564-dd8ffb91ee73","@Alias":"معرض ريستاتكس الشرقية","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:52:04","NodeName":{"@Default":"معرض ريستاتكس الشرقية","Name":[{"@Culture":"ar-jo","#text":"معرض ريستاتكس الشرقية"},{"@Culture":"en-us","#text":"معرض ريستاتكس الشرقية"}]},"SortOrder":"17","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-11-03T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-11-03T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>يهدف معرض ريستاتكس العقاري لإبراز دور القطاع العقاري المؤثر في جهود تنوع مصادر الاستثمار كأحد أهم أهداف رؤية المملكة 2030وتسليط الضوء ونقل تطورات ومستجدات القطاع العقاري السعودي في المشاريع السكنية والتجارية ومتعددة الاستخدامات وتوجهاته والاستثمارات والشركات الجديدة التي أضافها على خارطته سواء في التطوير العقاري أو مشروعات الإسكان.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>يهدف معرض ريستاتكس العقاري لإبراز دور القطاع العقاري المؤثر في جهود تنوع مصادر الاستثمار كأحد أهم أهداف رؤية المملكة 2030وتسليط الضوء ونقل تطورات ومستجدات القطاع العقاري السعودي في المشاريع السكنية والتجارية ومتعددة الاستخدامات وتوجهاته والاستثمارات والشركات الجديدة التي أضافها على خارطته سواء في التطوير العقاري أو مشروعات الإسكان.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الظهران - مركز معارض الظهران"},{"@Culture":"en-us","#cdata-section":"الظهران - مركز معارض الظهران"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9a452aac-ae42-4495-b3aa-ae68b1383031\",\n    \"mediaKey\": \"b99f9a7e-1fbf-401f-b8ad-49a2efcaefe2\"\n  },\n  {\n    \"key\": \"1040fb71-1f3d-4b64-9f6a-1782c5413a3f\",\n    \"mediaKey\": \"04544ae7-ade3-469f-99eb-c551e79b1089\"\n  },\n  {\n    \"key\": \"03559083-1f98-41d3-83e9-db348760e450\",\n    \"mediaKey\": \"4eb9ed14-4451-472b-80a3-a6a2711cf892\"\n  },\n  {\n    \"key\": \"6dad6a2c-e074-454c-900e-6563e992ec4c\",\n    \"mediaKey\": \"9923fef6-0fe6-4791-8fe2-5f38b8ec688d\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض ريستاتكس الشرقية"},{"@Culture":"en-us","#cdata-section":"معرض ريستاتكس الشرقية"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض ريستاتكس الشرقية"},{"@Culture":"en-us","#cdata-section":"معرض ريستاتكس الشرقية"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-10-31T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-10-31T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"2daf470e-bb22-301b-a811-f7a2a62ae1e2","Alias":"معرض سيتي سكيب الرياض","Path":"/856fb614-4994-4aab-a24d-98d486154b1e.config","Level":4018,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/856fb614-4994-4aab-a24d-98d486154b1e.config","Node":{"Content":{"@Key":"856fb614-4994-4aab-a24d-98d486154b1e","@Alias":"معرض سيتي سكيب الرياض","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:53:45","NodeName":{"@Default":"معرض سيتي سكيب الرياض","Name":[{"@Culture":"ar-jo","#text":"معرض سيتي سكيب الرياض"},{"@Culture":"en-us","#text":"معرض سيتي سكيب الرياض"}]},"SortOrder":"18","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-09-13T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-09-13T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تتولّى شركة «تحالف» تنظيم معرض «سيتي سكيب العالمي» بما ينسجم مع توجهات «رؤية 2030» وتطلعاتها. وتمثل «تحالف» شراكة إستراتيجية بين شركة «إنفورما» العالمية المحدودة من جهة، و«الاتحاد السعودي للأمن السيبراني والبرمجة والدرونز» من جهة أخرى.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>تتولّى شركة «تحالف» تنظيم معرض «سيتي سكيب العالمي» بما ينسجم مع توجهات «رؤية 2030» وتطلعاتها. وتمثل «تحالف» شراكة إستراتيجية بين شركة «إنفورما» العالمية المحدودة من جهة، و«الاتحاد السعودي للأمن السيبراني والبرمجة والدرونز» من جهة أخرى.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - مركز معارض الرياض - ملهم"},{"@Culture":"en-us","#cdata-section":"الرياض - مركز معارض الرياض - ملهم"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"2a74b67e-baba-4d70-92c8-3f0ae66f5b5b\",\n    \"mediaKey\": \"68347cd8-02b0-4c51-a6fd-d128e7648925\"\n  },\n  {\n    \"key\": \"b3ef3c0d-5174-4129-96cb-67f3ec8f4d31\",\n    \"mediaKey\": \"34259193-42f4-4fb0-b607-f83b37ec7b46\"\n  },\n  {\n    \"key\": \"63982b60-f2c3-418e-b1c2-6a7dbf02f293\",\n    \"mediaKey\": \"38b4b1db-4a0a-499e-ab74-94f917d3ef6f\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض سيتي سكيب الرياض"},{"@Culture":"en-us","#cdata-section":"معرض سيتي سكيب الرياض"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض سيتي سكيب الرياض"},{"@Culture":"en-us","#cdata-section":"معرض سيتي سكيب الرياض"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-09-10T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-09-10T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"918699d8-69f2-350d-a288-ef59a24fa6b9","Alias":"\"مجلس إدارة الهيئة العامة للعقار يعتمد \"اللائحة التنظيمية للاستشارات والتحليلات العقارية\"","Path":"/d43c850e-6eef-4da9-a2de-33781d75e0f9.config","Level":4018,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/d43c850e-6eef-4da9-a2de-33781d75e0f9.config","Node":{"Content":{"@Key":"d43c850e-6eef-4da9-a2de-33781d75e0f9","@Alias":"\"مجلس إدارة الهيئة العامة للعقار يعتمد \"اللائحة التنظيمية للاستشارات والتحليلات العقارية\"","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-31T11:44:42","NodeName":{"@Default":"\"مجلس إدارة الهيئة العامة للعقار يعتمد \"اللائحة التنظيمية للاستشارات والتحليلات العقارية\""},"SortOrder":"18","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-22T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0428e78e-f22a-4d2c-9707-0008d38fac7f\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;اعتمد مجلس إدارة الهيئة العامة للعقار \\\"اللائحة التنظيمية للاستشارات والتحليلات العقارية\\\" التي تأتي ضمن منظومة التشريعات العقارية, وتهدف إلى رفع كفاءة السوق العقاري من جهة ورفع الموثوقية من جهة أخرى، وهي امتداد للوائح التنظيمية التي أفرزها نظام الوساطة والخدمات العقارية ولائحته التنفيذية، حيث جاء اعتماد اللائحة بعد طرحها على منصة \\\" استطلاع \\\" تمكيناً للعموم والجهات الحكومية والقطاع الخاص من إبداء مرئياتهم وملحوظاتهم عليها قبل إقرارها في سبتمبر الماضي.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>وأوضحت الهيئة العامة للعقار أنه ووفقاً للائحة يقصد \\\"بالاستشارات العقارية\\\" التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري، التي تقدم للمستفيد كتابة، ويقصد \\\"بالتحليلات العقارية\\\" فهي الرأي أو التحليل المتصل بالقطاع العقاري، الذي يقدم للعموم عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأكدت الهيئة أن اللائحة ستكون نافذة حال نشرها في الصحيفة الرسمية، التي تضم عشرة مواد توضح أحكام وشروط التراخيص والتزامات ومحظورات المرخص له، بالإضافة لعقوبات ومخالفات الأحكام النظامية الواردة في جدول تصنيف المخالفات والعقوبات المقررة لها باللائحة التنفيذية.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>يذكر أنه وفقًا لنظام الوساطة العقارية لا تجوز ممارسة أنشطة الوساطة العقارية والخدمات العقارية إلا بعد الحصول على ترخيص من الهيئة العامة للعقار، وبحسب المادة التاسعة عشر من نظام الوساطة العقارية يعاقب كل من يخالف أي حكم من أحكام النظام بعقوبة أو أكثر من العقوبات الآتية: الإنذار، تعليق الترخيص لمدة لا تتجاوز (سنة)، إلغاء الترخيص، غرامة لا تتجاوز (200.000) ريال.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"مجلس إدارة الهيئة العامة للعقار يعتمد \"اللائحة التنظيمية للاستشارات والتحليلات العقارية\""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"مجلس إدارة الهيئة العامة للعقار يعتمد \"اللائحة التنظيمية للاستشارات والتحليلات العقارية\""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"846ebbb4-09f4-3e1f-a2e0-78d2268841a1","Alias":"بروبتك السعودية","Path":"/1812f57f-0beb-49b2-972d-b91830d1380e.config","Level":4019,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/1812f57f-0beb-49b2-972d-b91830d1380e.config","Node":{"Content":{"@Key":"1812f57f-0beb-49b2-972d-b91830d1380e","@Alias":"بروبتك السعودية","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:55:11","NodeName":{"@Default":"بروبتك السعودية","Name":[{"@Culture":"ar-jo","#text":"بروبتك السعودية"},{"@Culture":"en-us","#text":"بروبتك السعودية"}]},"SortOrder":"19","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-11-07T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-11-07T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>هدف رفع مستوى المعرفة في مجال التقنية العقارية في السوق السعودي. وتعزيز الاستثمار في هذا المجال بالمملكة.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>هدف رفع مستوى المعرفة في مجال التقنية العقارية في السوق السعودي. وتعزيز الاستثمار في هذا المجال بالمملكة.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - فندق الفورسيزنز"},{"@Culture":"en-us","#cdata-section":"الرياض - فندق الفورسيزنز"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"5e3b0861-2196-4da7-b6de-28ea8d59624b\",\n    \"mediaKey\": \"c741117c-3eab-48f8-b2ed-188667e3524a\"\n  },\n  {\n    \"key\": \"5ae24045-5f1b-47ab-80bc-b913c8fb67db\",\n    \"mediaKey\": \"32ed816e-cbad-428d-a591-22248048a0b3\"\n  },\n  {\n    \"key\": \"d8674fb9-9f7a-4115-b342-f7548a73c48a\",\n    \"mediaKey\": \"e8b7d5ac-2c06-4c7e-b155-56cdfa9420c4\"\n  },\n  {\n    \"key\": \"41e78422-a09f-4ec3-adb7-38b350295242\",\n    \"mediaKey\": \"83a2f206-6ecf-4625-a651-ffdabd12c715\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بروبتك السعودية"},{"@Culture":"en-us","#cdata-section":"بروبتك السعودية"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بروبتك السعودية"},{"@Culture":"en-us","#cdata-section":"بروبتك السعودية"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-11-06T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-11-06T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"989df617-0e90-3d98-88d1-894c8e548403","Alias":"\"القمة العالمية لقادة العقار\": إطلاق عدد من الاتفاقيات والمبادرات لتعزيز الشراكات العالمية واستدامة القطاع","Path":"/2e5af012-7a86-4b28-a3cc-f5c32876aa0b.config","Level":4019,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2e5af012-7a86-4b28-a3cc-f5c32876aa0b.config","Node":{"Content":{"@Key":"2e5af012-7a86-4b28-a3cc-f5c32876aa0b","@Alias":"\"القمة العالمية لقادة العقار\": إطلاق عدد من الاتفاقيات والمبادرات لتعزيز الشراكات العالمية واستدامة القطاع","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-21T12:12:38","NodeName":{"@Default":"\"القمة العالمية لقادة العقار\": إطلاق عدد من الاتفاقيات والمبادرات لتعزيز الشراكات العالمية واستدامة القطاع"},"SortOrder":"19","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-05T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0a376c91-ddd2-4218-b768-cf3458e2ec5a\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وُقعت اليوم عدد من الاتفاقيات والمبادرات العقارية على هامش أعمال القمة العالمية لقادة العقار في دورتها الحالية الـ42 التي ترعاها الهيئة العامة للعقار.<br><span>وتضمنت الاتفاقيات والمبادرات، شراكات عالمية استراتيجية تعزز استدامة القطاع وترفع جاذبية الاستثمار في جميع مكوناته كتأسيس مكتب الأمانة العامة للاتحاد الدولي للعقار بمدينة الرياض ليعمل على تعزيز العمل المشترك بين الاتحاد الدولي للعقار والهيئات والجهات الأخرى ذات العلاقة، وتقديم الدعم الفني والإداري للمجموعات التابعة للاتحاد، كما تم اطلاق \\\"المركز العالمي للإعلام العقاري\\\" بمدينة الرياض لربط وسائل الاعلام الإقليمية والدولية بعدة لغات والذي يسهم في وصول الرسائل العقارية الإعلامية لكافة أنحاء العالم في فترة وجيزة يعمل على تحسين رصد المحتوى وتحليله.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>كما تم الإعلان عن منصة الاتحاد العقاري (كونكت) لتكون شبكة للأعمال المهنية العقارية الدولية، وتعزيز الشراكة بين الأفراد والمنشآت العقارية المحلية والعالمية، مع إمكانية الوصول إلى الأسواق العالمية والتواصل مع الخبراء العقاريين في جميع أنحاء العالم، والإعلان عن مبادرة الشراكة مع جامعة أكسفورد لتقديم برامج متخصصة ومعتمدة في القطاع العقاري تتواكب مع التطور في القطاع وتعزز من مبدأ الاستدامة وجودة الحياة مثل برنامج الاستثمار والتطويرالعقاري، وبرنامج قادة العقار.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وتأكيدًا على أهمية تحفيز القطاعات العقارية وخلق التنافسية أعلن عن إطلاق (جائزة التميز العقاري العالمية) في المملكة العربية السعودية بهدف رفع مستوى صناعة القطاع من خلال عرض الابتكارات وأفضل الممارسات، وإطلاق خدمة (التقارير الاستشارية والمؤشرات العقارية العالمية) لدعم تحقيق الميثاق العالمي \\\"بناء حياة أفضل\\\" بالتعاون مع شركاء عالميين، مثل برنامج الأمم المتحدة للمستوطنات البشرية، وتبادل الخبرات والجهود في مجالات: حماية البيئة، والمدن الذكية، والمباني الخضراء، وغيرها من القضايا العالمية الأخرى.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>كما أطلقت مبادرة اعتماد اللغة العربية ضمن اللغات المعتمدة في الاتحاد الدولي للعقار، والإعلان عن افتتاح أكاديمية فيليب كوتلر امباكت للتسويق العقاري بالمملكة العربية السعودية لتقديم برامج تسويقية متخصصة في القطاع العقاري تقدم لأول مره على مستوى العالم.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>يذكر أن القمة العالمية لقادة العقار في دورتها ٤٢ تستضيفها الرياض لأول مرة في منطقة الشرق الأوسط وأفريقيا بعد فوزها بالمنافسة ،وتشهد حضور قادة العقار والرؤساء التنفيذيين لكبرى الشركات، وأعضاء الاتحاد الدولي للعقار، ومتحدثين دوليين يمثلون أكثر من 110 دول.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"\"القمة العالمية لقادة العقار\": إطلاق عدد من الاتفاقيات والمبادرات لتعزيز الشراكات العالمية واستدامة القطاع"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ca6395fe-af9d-384b-a1d9-9db896c2b878","Alias":"انطلاق أعمال \"القمة العالمية لقادة العقار\" غداً بالرياض","Path":"/a6e09ec0-acc7-4b74-b3a2-792fa37dd464.config","Level":4020,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/a6e09ec0-acc7-4b74-b3a2-792fa37dd464.config","Node":{"Content":{"@Key":"a6e09ec0-acc7-4b74-b3a2-792fa37dd464","@Alias":"انطلاق أعمال \"القمة العالمية لقادة العقار\" غداً بالرياض","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-21T12:09:21","NodeName":{"@Default":"انطلاق أعمال \"القمة العالمية لقادة العقار\" غداً بالرياض"},"SortOrder":"20","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-04T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"8bf181ba-b44f-4871-ab51-fdce4e0c78ba\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">برعاية معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبد الله الحقيل، تنطلق غداً أعمال القمة العالمية لقادة العقار التي تستضيفها الرياض، بحضور ومشاركة شخصيات عقارية بارزة وعدد من الرؤساء التنفيذيين لكبرى الشركات، وأعضاء الاتحاد الدولي للعقار، ومتحدثين دوليين يمثلون أكثر من 110 دول.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وتأتي القمة العالمية لقادة العقار كحدث سنوي ينظمه الاتحاد الدولي للعقارات بهدف تعزيز التواصل بين قادة الصناعة والخبراء من جميع أنحاء العالم، حيث فازت المملكة باستضافتها في دورتها الـ42 والتي تسعى من خلالها إلى مناقشة آخر ما وصل في صناعة العقار من حيث التشريعات والتنظيمات على المستويين المحلي والدولي إلى جانب الفرص الاستثمارية المتاحة، فضلاً عن دور القيادات في ابتكار الأفكار الريادية عبر استعراض أفضل الممارسات العالمية وآلية تطبيقها في المنطقة، والمستقبل الرقمي باستخدام الذكاء الاصطناعي، كما سيحظى فريق الاتحاد الدولي وضيوف القمة بزيارات لأبرز المشاريع العقارية بالمملكة.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأوضح المتحدث الرسمي للهيئة العامة للعقار تيسير المفرج، أنّ القمة العالمية لقادة العقار التي تستضيفها الرياض وجاءت بعد منافسة واسعة النطاق مع العديد من الأسواق العالمية مثل الولايات المتحدة وأفريقيا وآسيا ومنطقة المحيط الهادي، وبدورها استطاعت المملكة الفوز بنتائج التصويت وفرصة استضافة القمة للمرة الأولى على مستوى منطقة الشرق الأوسط وأفريقيا.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأكد أن القمة ستشهد انطلاق أعمالها بجلسات حوارية متخصصة ولقاءات متعددة في مجالات التسويق والابتكار والقيادة والإدارة العقارية، ومناقشة القضايا الأكثر إلحاحًا التي تواجه صناعة العقار واستعراض الحلول المبتكرة في الاستدامة والتخطيط الاستراتيجي طويل المدى وتنوع الاستثمار وإدارة المخاطر وطرق التمويل والاستخدام الأمثل للتقنيات الناشئة.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>مما يُذكر أنّ الاتحاد العالمي للعقارات، يعدّ أكبر كيان عالمي في مجال منظومة العقار، وقد تم تأسيسه في عام 1951 في فرنسا، ويبلغ عدد أعضائه مليوناً و500 ألف عضو، من 70 دولة، حول العالم، ويتبنى الاتحاد منظومة مولية تُعنى بالتكامل الشامل ما بين الاقتصادي والاجتماعي والتكامل مع الشق البيئي، فيما يخدم مسيرة التنمية المستدامة، ويعود بالمنفعة على كل المجتمعات التي يعمل فيها الاتحاد على تنفيذ خططه ، كما يعمل الاتحاد على تطبيق نموذج متقدم لتطوير القطاع العقاري، وهو نموذج مستدام في تنافسية القطاع مثل تكنولوجيا العقار والفنتكوالبروبتك.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"انطلاق أعمال \"القمة العالمية لقادة العقار\" غداً بالرياض"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"571be8d8-7ec9-38ea-9706-235d758dd79e","Alias":"معرض سيتي سكيب البحرين","Path":"/4de6246a-d7fc-4049-869e-ca09306d936f.config","Level":4020,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4de6246a-d7fc-4049-869e-ca09306d936f.config","Node":{"Content":{"@Key":"4de6246a-d7fc-4049-869e-ca09306d936f","@Alias":"معرض سيتي سكيب البحرين","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:56:36","NodeName":{"@Default":"معرض سيتي سكيب البحرين","Name":[{"@Culture":"ar-jo","#text":"معرض سيتي سكيب البحرين"},{"@Culture":"en-us","#text":"معرض سيتي سكيب البحرين"}]},"SortOrder":"20","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-11-16T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-11-16T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>يضم معرض ومؤتمر ستي سكيب عارضين للشركات والمشاريع العقارية المحلية والإقليمية والعالمية تحت سقف واحد ليقدم أحدث ماتوصلت اليه التكنلوجيا العقارية وشركات التطوير العقاري والخدمات العقارية في هذا القطاع كما يمثل فرصة استثنائية لعقد الصفقات وإجراء اللقاءات وإقامة الشراكات</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>يضم معرض ومؤتمر ستي سكيب عارضين للشركات والمشاريع العقارية المحلية والإقليمية والعالمية تحت سقف واحد ليقدم أحدث ماتوصلت اليه التكنلوجيا العقارية وشركات التطوير العقاري والخدمات العقارية في هذا القطاع كما يمثل فرصة استثنائية لعقد الصفقات وإجراء اللقاءات وإقامة الشراكات</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المنامة - معارض البحرين الدولي"},{"@Culture":"en-us","#cdata-section":"المنامة - معارض البحرين الدولي"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"3fcbc899-7083-4c5e-a43a-815f596e5c2f\",\n    \"mediaKey\": \"78a75495-d47a-405e-91fd-6d0d6fe10095\"\n  },\n  {\n    \"key\": \"6918e2b6-b64b-484c-a8de-57abd4c8cf02\",\n    \"mediaKey\": \"4f51ce24-e2e9-4838-bfce-fd728b4ec1cc\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض سيتي سكيب البحرين"},{"@Culture":"en-us","#cdata-section":"معرض سيتي سكيب البحرين"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث اقليمي"},{"@Culture":"en-us","#cdata-section":"Regional event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض سيتي سكيب البحرين"},{"@Culture":"en-us","#cdata-section":"معرض سيتي سكيب البحرين"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-11-14T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-11-14T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"751b96e9-dfa0-349e-a9d7-f53d7eab3dd1","Alias":"الهيئة العامة للعقار تُعلن عن 48 حي مُستفيد من السجل العقاري في الرياض والدمام والمدينة المنورة","Path":"/4150ccc0-96f2-4e45-a7e1-78ca561285ec.config","Level":4021,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/4150ccc0-96f2-4e45-a7e1-78ca561285ec.config","Node":{"Content":{"@Key":"4150ccc0-96f2-4e45-a7e1-78ca561285ec","@Alias":"الهيئة العامة للعقار تُعلن عن 48 حي مُستفيد من السجل العقاري في الرياض والدمام والمدينة المنورة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-21T12:05:42","NodeName":{"@Default":"الهيئة العامة للعقار تُعلن عن 48 حي مُستفيد من السجل العقاري في الرياض والدمام والمدينة المنورة"},"SortOrder":"21","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-12-03T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"57baa8c6-5cba-4160-8672-8555a7100079\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">أعلنتْ الهيئة العامة للعقار عن سبعة مناطق مستفيدة من السجل العقاري في مدنية الرياض والدمام والمدينة المنورة ، وتضم هذه المرحلة&nbsp;&nbsp; 368.565 قطعة عقارية في 48 حي بإجمالي مساحة تصل إلى 910.27 كلم مربع&nbsp; في المدن الثلاث، وذلك ابتداءً من الرابع والعشرين من ديسمبر 2023م&nbsp; الموافق 11 جمادى الآخر 1445هـ ، ويستمر التسجيل حتى نهاية اليوم الثامن والعشرين من مارس 2024م الموافق 18 رمضان 1445هـ، حيثُ أكدتْ الهيئة بأنَّ اختيار الأحياء جاء وفقًا لمعايير معتمدة، وسيتم الإعلان تباعًا عن بقية المناطق والأحياء التي ستستفيد من السجل العقاري حسب الجاهزية.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وتعد هذه المرحلة هي المرحلة الثالثة في رحلة أعمال السجل العقاري وتشمل سبعة مناطق في ثلاث مدن وتضم كل منطقة مستفيدة عدد من الأحياء على النحو التالي : خمسة مناطق في مدينة الرياض تضم&nbsp; 46 حي هي: حي الملك سلمان، البساتين، التضامن، الزاهر، الرسالة، الراية، العلا، المشرق ، الخير ، العارض، النرجس، القيروان، الياسمين، الملقا، الصحافة، الندى، الربيع، العقيق، حطين، النخيل، المحمدية، الملك فهد، الورود، الرحمانية، الرائد، جامعة الملك سعود، المرسلات،<span>&nbsp;</span>المغرزات، النزهة، الملك عبدالله، الروضة، القدس، الحمراء، الشهداء، قرطبة، جامعة الامام محمد بن سعود، الأندلس، الملك فيصل، غرناطة،النهضة، الخليج، إشبيلية، اليرموك، المونسية، المعيزيلة، القادسية .أما المنطقة السادسة فتضم حي الشعلة في مدينة الدمام ، والمنطقة السابعة تضم حي العاقول في المدينة المنورة.&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وأوضحتْ \\\"هيئة العقار\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق سيكون مُتاحاً عن طريق منصة السجل العقاري الإلكترونية&nbsp;<span>&nbsp;</span><a href=\\\"https://rer.sa/rer-services-ar/\\\"><span lang=\\\"EN-US\\\">https://rer.sa/rer-services-ar/</span></a>&nbsp;&nbsp;<span>&nbsp;</span>&nbsp;أو من خلال مراكز الخدمة، مبيَّنة أنّ التسجيل العيني يشترط وجود صك ملكية صادر عن وزارة العدل مكتمل البيانات مستوفي شروط الملكية، وهوية سارية، ووكالة في حال كان مقدم الطلب وكيلاً.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">ودعتْ الهيئة ملاَّك عقارات المناطق والأحياء المستفيدة من السجل العقاري إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن الإجراءات والخطوات اللازمة عن طريق الاتصال على مركز خدمة العملاء 199002.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">&nbsp;</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">يذكر بأن الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تقوم بأعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة في خدمات وبيانات العقارات. وإضافة إلى استخدام التقنيات الحديثة، سيقوم الـمُسجِلون المعتمدون بأعمالهم الميدانية داخل المناطق المستفيدة من السجل ابتداءً من الموعد الـمُحدد لبدء التسجيل حيث سيصدر \\\"رقم عقار\\\" وصك تسجيل ملكية لكل وحدة عقارية. وسيتضمن صك تسجيل الملكية الجديد بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه والمرتبطة بالمعلومات الجيومكانية من خلال الرفع المساحي والإحداثيات الجغرافية للعقارات، ليكون أساس تسجيل الملكية والحقوق العقارية المترتبة عليها بما يُسهم في استدامة وتعزيز القطاع العقاري والممكنات الرئيسة له.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تُعلن عن 48 حي مُستفيد من السجل العقاري في الرياض والدمام والمدينة المنورة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"88e671b1-c20c-3339-a101-a23c57a2c917","Alias":"القمة العالمية لقادة العقار","Path":"/aa819707-23c8-4855-8f3e-5338be9406c0.config","Level":4021,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/aa819707-23c8-4855-8f3e-5338be9406c0.config","Node":{"Content":{"@Key":"aa819707-23c8-4855-8f3e-5338be9406c0","@Alias":"القمة العالمية لقادة العقار","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-12-17T17:57:48","NodeName":{"@Default":"القمة العالمية لقادة العقار","Name":[{"@Culture":"ar-jo","#text":"القمة العالمية لقادة العقار"},{"@Culture":"en-us","#text":"القمة العالمية لقادة العقار"}]},"SortOrder":"21","Published":{"@