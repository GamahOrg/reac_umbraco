f !supportLists]--><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Sakkal Majalla';\\\"><span style=\\\"mso-list: Ignore;\\\">-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">        </span></span></span><!--[endif]--><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; color: black; mso-color-alt: windowtext;\\\" lang=\\\"AR-SA\\\">ومنع مدير المساهمة من القيام -مستقبلاً- بأي عمل مرتبط بالمساهمات العقارية لمدة لا تتجاوز سنتين.</span></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 27; mso-yfti-lastrow: yes; height: 18.4pt;\\\">\\n<td width=\\\"78\\\" style=\\\"width: 58.2pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.5pt; border-right: solid windowtext 1.5pt; mso-border-top-alt: solid windowtext 1.5pt; mso-border-alt: solid windowtext 1.5pt; mso-border-left-alt: solid windowtext .5pt; background: #9CC2E5; mso-background-themecolor: accent1; mso-background-themetint: 153; padding: 0in 5.4pt 0in 5.4pt; height: 18.4pt;\\\">\\n<p style=\\\"mso-add-space: auto; text-align: center; text-indent: -.25in; line-height: normal; mso-list: l0 level1 lfo3; direction: rtl; unicode-bidi: embed; margin: 0in 27.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraph\\\" align=\\\"center\\\"><!-- [if !supportLists]--><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: 'Sakkal Majalla';\\\"><span style=\\\"mso-list: Ignore;\\\">24<span style=\\\"font: 7.0pt 'Times New Roman';\\\">    </span></span></span><!--[endif]--> </p>\\n</td>\\n<td width=\\\"329\\\" style=\\\"width: 246.9pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.5pt; border-right: none; mso-border-top-alt: 1.5pt; mso-border-right-alt: .5pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 1.5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; background: #F2F2F2; mso-background-themecolor: background1; mso-background-themeshade: 242; padding: 0in 5.4pt 0in 5.4pt; height: 18.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: normal; direction: rtl; unicode-bidi: embed; margin: 2.0pt 0in 2.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; color: black; mso-color-alt: windowtext;\\\" lang=\\\"AR-SA\\\">تقصير مدير المساهمة في الاشراف والرقابة على الاستشاري الهندسي والمحاسب القانوني وسير مشروع المساهمة العقارية، وتسببه بأثر على المساهمة العقارية.</span></p>\\n</td>\\n<td width=\\\"194\\\" style=\\\"width: 145.65pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.5pt; border-right: none; mso-border-top-alt: 1.5pt; mso-border-right-alt: .5pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 1.5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; background: #D5DCE4; mso-background-themecolor: text2; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 18.4pt;\\\">\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed; margin: 2.0pt 0in 2.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; color: black; mso-color-alt: windowtext;\\\" lang=\\\"AR-SA\\\">غرامة بحد أدنى خمسة عشر ألف ريال وبحد أعلى ثلاثين ألف ريال.</span></p>\\n</td>\\n<td width=\\\"170\\\" style=\\\"width: 127.8pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.5pt; border-right: none; mso-border-top-alt: 1.5pt; mso-border-right-alt: .5pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 1.5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; background: #D5DCE4; mso-background-themecolor: text2; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 18.4pt;\\\">\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed; margin: 2.0pt 0in 2.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; color: black; mso-color-alt: windowtext;\\\" lang=\\\"AR-SA\\\">غرامة بحد أدنى عشرة آلاف ريال وبحد أعلى خمسة وعشرين ألف ريال.</span></p>\\n</td>\\n<td width=\\\"183\\\" style=\\\"width: 137.4pt; border-top: none; border-left: solid windowtext 1.5pt; border-bottom: solid windowtext 1.5pt; border-right: none; mso-border-top-alt: solid windowtext 1.5pt; mso-border-right-alt: solid windowtext .5pt; background: #D5DCE4; mso-background-themecolor: text2; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 18.4pt;\\\">\\n<p style=\\\"text-align: right; line-height: normal; direction: rtl; unicode-bidi: embed; margin: 2.0pt 0in 2.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; color: black; mso-color-alt: windowtext;\\\" lang=\\\"AR-SA\\\">غرامة بحد أدنى عشرة آلاف ريال وبحد أعلى خمسة وعشرين ألف ريال</span></p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":"جدول تصنيف المخالفات والعقوبات المقررة لها وفقاً لنظام المساهمات العقارية ولائحته التنفيذية"}},"header":{"Value":{"#cdata-section":"جدول تصنيف المخالفات والعقوبات المقررة لها وفقاً لنظام المساهمات العقارية ولائحته التنفيذية"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"المخالفات\",\n  \"العقوبات\",\n  \"المساهمات\",\n  \"المساهمات العقارية\",\n  \"التنفيذ\",\n  \"الادلة\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"جدول تصنيف المخالفات والعقوبات المقررة لها وفقاً لنظام المساهمات العقارية ولائحته التنفيذية"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2024-08-05T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2024-04-29T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"أدلة\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":"جدول تصنيف المخالفات والعقوبات المقررة لها وفقاً لنظام المساهمات العقارية ولائحته التنفيذية"}}}}},"IsRoot":true},{"Key":"15a8dfcd-a799-34bf-aa19-3d1dbf4cc690","Alias":"نظام الوساطة العقارية","Path":"/3efd4b79-7f3d-4dae-9ce0-cb4ef63af1af.config","Level":5000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3efd4b79-7f3d-4dae-9ce0-cb4ef63af1af.config","Node":{"Content":{"@Key":"3efd4b79-7f3d-4dae-9ce0-cb4ef63af1af","@Alias":"نظام الوساطة العقارية","@Level":"5","Info":{"Parent":{"@Key":"2e83ad93-6ff8-412f-961b-49003de4c4aa","#text":"الانظمة"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-07-31T07:48:42","NodeName":{"@Default":"نظام الوساطة العقارية"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"fb0cabaa-b082-4187-8c5b-e973ea255801\",\n    \"mediaKey\": \"2b08518e-3ac3-4f92-b0d6-aae34da50c84\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/6aff3c97f5e44db2b27305b3e70b04a0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3b4a39fe3f9448b6a4109ea7b043ee3a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8a062f82d798474397060ea917e8bba3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b717bc6d704f4b7f8401fcea4258e990\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7334f3f2ed604325b91a9650544abf2f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c050e75dcecf4ce288a0bc09c5267062\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5f41d2153fb24f87b2c5b2d6305d71e1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/942837dacff94066b2bb25f11ceddb41\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4aa7e612690e4c87a282be4457693acf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4098f129e6324e119b3b809becf6bf60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1073dbc5f584432ca76ca1d4990753b5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f5eba86322654822b80e07318e7dd307\"\n      },\n      {\n        \"contentUdi\": \"umb://element/040670e2b62a4ad4b9245d6020760aab\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b70410eff5ec4673967ac87f0be7dc68\"\n      },\n      {\n        \"contentUdi\": \"umb://element/49e636a8d0f94611896f3cf97c622349\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5b12cc2cadc14cf2be5cff0414a14d17\"\n      },\n      {\n        \"contentUdi\": \"umb://element/78ef80e0d78b4c97a7715e441371762e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e3af6ec8f559462280347aa690585c1c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a6c5d023577446408b4fcc5ef7ca586b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a74cc5d2a6d74a49828117ae30893bfc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/10969a3c5e5e46eeb8f22f0af864698d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b4586688e28c411685ffa3e7bf69456f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/67323025a7504cffa7fceaa60a4ca83c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6045a50f41394dfc9dda96178ff3ce7f\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6aff3c97f5e44db2b27305b3e70b04a0\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>لغرض تطبيق أحكام النظام، يكون للألفاظ والعبارات الآتية المعاني المبيّنة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\n<p><strong>النظام</strong>: نظام الوساطة العقارية.</p>\\n<p><strong>اللائحة</strong>: اللائحة التنفيذية للنظام.</p>\\n<p><strong>الهيئة</strong>: الهيئة العامة للعقار.</p>\\n<p><strong>المجلس</strong>: مجلس إدارة الهيئة.</p>\\n<p><strong>الوساطة العقارية</strong>: ممارسة نشاط التوسط في إتمام صفقة عقارية بين أطرافها؛ وذلك مقابل الحصول على عمولة. ويشمل ذلك الوساطة الإلكترونية من خلال وسائل التقنية؛ كالمواقع الإلكترونية ومنصات التواصل الاجتماعي ونحوها.</p>\\n<p><strong>الخدمات العقارية</strong>: الأنشطة المتعلقة بالعقار والتسويق له وإدارته وبيعه وبيع منفعته وتأجيره، ومن ذلك: التسويق العقاري، وإدارة الأملاك، وإدارة المرافق، والمزادات العقارية، والإعلانات العقارية، والاستشارات والتحليلات العقارية.</p>\\n<p><strong>الخدمات العقارية المكملة</strong>: أنشطة يرخص لها وفق أنظمة خاصة.</p>\\n<p><strong>الصفقة العقارية</strong>: بيع أو شراء أو تأجير العقار أو منفعته.</p>\\n<p><strong>عقد الوساطة</strong>: اتفاق بين الوسيط العقاري والطرف المستفيد من الوساطة العقارية؛ لإتمام صفقة عقارية أو تقديم خدمة عقارية.</p>\\n<p><strong>الوسيط العقاري</strong>: شخص طبيعي أو اعتباري، مرخص له بممارسة الوساطة العقارية أو تقديم الخدمات العقارية وفقاً لأحكام النظام.</p>\\n<p><strong>العمولة</strong>: مبلغ يستحقه الوسيط العقاري مقابل الوساطة العقارية.</p>\\n<p><strong>التسويق العقاري</strong>: ترويج منتج عقاري باستخدام الوسائل الدعائية والإعلانية.</p>\\n<p><strong>إدارة الأملاك</strong>: تولي الشؤون المالية والإدارية للعقار نيابة عن مالكه أو مالك منفعته.</p>\\n<p>إ<strong>دارة المرافق</strong>: تولي الشؤون الفنية للعقار نيابة عن مالكه أو مالك منفعته، مثل إدارة الشبكات الداخلية كالمياه والغاز والكهرباء وتكييف الهواء والهاتف وشبكات الكمبيوتر والتلفاز والصرف الصحي وتصريف مياه الأمطار والتخلص من النفايات والمخلفات وتسليم البريد أو الطرود أو البضائع ونحوها.</p>\\n<p><strong>المزادات العقارية</strong>: نشاط المزايدة العلنية على عقار من أجل بيعه أو بيع منفعته أو تأجيره؛ للوصول بثمنه إلى أعلى قدر. ويشمل ذلك المزادات الإلكترونية.</p>\\n<p><strong>الضمان</strong>: مبلغ يدفعه المستأجر على سبيل الأمانة؛ لتعويض مالك العقار أو المنفعة عن أي ضرر داخل في ضمانة المستأجر وواقع بسببه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3b4a39fe3f9448b6a4109ea7b043ee3a\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يهدف النظام إلى تنظيم الوساطة العقارية والخدمات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8a062f82d798474397060ea917e8bba3\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>تسري أحكام النظام على كل من يمارس الوساطة العقارية أو الخدمات العقارية، أو يتعامل بهما، أو يستفيد منهما.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b717bc6d704f4b7f8401fcea4258e990\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>لا تجوز ممارسة الوساطة العقارية ولا تقديم الخدمات العقارية إلا بعد الحصول على ترخيص من الهيئة. وتحدد اللائحة أحكامه، وشروطه، وإجراءاته، ومدته، وتجديده.</li>\\n<li>للوسيط العقاري تقديم خدمات عقارية مكملة، وفقاً للفقرة (6) من المادة (السادسة) من النظام، وذلك بعد الحصول على ترخيص من الجهة المختصة، ووفقاً لما تحدده اللائحة من ضوابط.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7334f3f2ed604325b91a9650544abf2f\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>تتولى الهيئة ما يلي:</p>\\n<ol>\\n<li>إعداد نماذج العقود الإلزامية والاسترشادية الواردة في النظام.</li>\\n<li>إعداد برامج وآليات للتحفيز على ممارسة الوساطة العقارية والخدمات العقارية المشمولة بأحكام النظام.</li>\\n<li>تحديد الاشتراطات والمواصفات لوسائل التسويق العقاري.</li>\\n<li>إعداد المعايير والضوابط اللازمة لممارسة الوساطة العقارية.</li>\\n<li>إعداد إجراءات ضبط المخالفات، وتلقي البلاغات والشكاوى.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c050e75dcecf4ce288a0bc09c5267062\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>يتولى المجلس المهمات الآتية:</p>\\n<p>1- اعتماد اللوائح التنظيمية للنشاطات والخدمات المشمولة باختصاصات الهيئة، وفقاً لأحكام النظام.<br>2- اعتماد المعايير والضوابط اللازمة لممارسة الوساطة العقارية.<br>3- تحديد المقابل المالي للتراخيص التي تصدرها الهيئة بناءً على النظام وتجديدِها.<br>4- اعتماد إجراءات ضبط المخالفات، وتلقي البلاغات والشكاوى.<br>5- تحديد الخدمات العقارية التي يمكن للوسيط العقاري تقديمها، وضوابط ذلك وشروطه.<br>6- تحديد الخدمات العقارية المكملة التي يمكن للوسيط العقاري تقديمها، وذلك بالاتفاق مع الجهات المرخصة لها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5f41d2153fb24f87b2c5b2d6305d71e1\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- يجب أن يكون عقد الوساطة مكتوباً، وأن يودع الوسيط نسخة من العقد لدى الهيئة، ولا يُحتج به إلا بذلك، وتحدد اللائحة إجراءات الإيداع.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- يجب أن يكون عقد الوساطة محدد المدة، وإذا لم يُتفق عليها في العقد فتكون (تسعين) يوماً من تاريخ إبرامه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/942837dacff94066b2bb25f11ceddb41\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>للوسيط العقاري التعاقد مع وسيط عقاري آخر أو أكثر؛ للتوسط في العقار محل عقد الوساطة وفقاً لأحكامه، ما لم ينص في العقد على غير ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4aa7e612690e4c87a282be4457693acf\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>على الوسيط العقاري عند إبرام عقد الوساطة مع مالك العقار أو مالك المنفعة الحصول على صورة من إثبات ملكية العقار أو ملكية المنفعة، والمعلومات، والوثائق التي تحددها اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4098f129e6324e119b3b809becf6bf60\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم الوسيط العقاري بما يأتي:</p>\\n<p>1- ممارسة نشاط الوساطة العقارية بنفسه إذا كان شخصا طبيعيًّا، أو بوساطة المدير المسؤول أو أحد تابعيه المرخص له إذا كان شخصا معنويًّا.<br>2- عدم القيام بأي فعل أو الامتناع عن أي فعل، يكون من شأنه الإضرار بمصالح المتعاملين معه، أو يتعارض مع أحكام النظام.<br>3- إبلاغ الهيئة عن أي تعديل أو تغيير متعلق بممارسة نشاط الوساطة العقارية.<br>4- عدم إفشاء سرٍّ من أسرار الصفقات محل الوساطة.<br>5- أن يبذل العناية اللازمة للتحقق من صحة المعلومات التي يحصل عليها بناءً على المادة (التاسعة) من النظام.<br>6- الإفصاح -عند عرضه للعقار- عن المعلومات التي حصل عليها بناءً على المادة (التاسعة) من النظام، وعدم تقديم أي معلومة مضللة بشأن العقار.<br>7- بيان اسمه ورقم الترخيص، في أي إعلان، أو منشور متعلق بالعقار.<br>8- ممارسة نشاطه بشفافية ومصداقية، وتقديم الخدمات بجودة وكفاية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1073dbc5f584432ca76ca1d4990753b5\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>على الوسيط العقاري تسجيل جميع عقود الوساطة التي يبرمها، وجميع الصفقات العقارية التي يتمها، في المنصة الإلكترونية الخاصة بها؛ وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f5eba86322654822b80e07318e7dd307\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- يتسلّم الوسيط العقاري الضمان -إن وجد- ويسلمه للهيئة أو من تخوله، ويحفظ لديها إلى حين إعادة تسليم العقار دون أضرار، ويعاد الضمان -أو ما تبقى منه بعد اقتطاع قيمة الأضرار- إلى المستأجر، وتحدد اللائحة ما يتعلق بذلك.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- كل خلاف ينشأ بين المؤجر والمستأجر في شأن الضمان وتقدير الأضرار التي يشملها؛ يحل ابتداءً عن طريق خبراء متخصصين -تحددهم الهيئة- بموافقة الطرفين على ذلك، ويتحمل الطرفان أتعابهم مناصفة، فإن لم يتفق الطرفان على قبول حل الخبراء فإن لهما الحق في اللجوء إلى المحكمة المختصة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/040670e2b62a4ad4b9245d6020760aab\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- يحدد مبلغ عربون الصفقة العقارية التي تتم عن طريق الوسيط العقاري، بالاتفاق بين أطرافها؛ بما لا يتجاوز (5%) من قيمتها، وفي حال تجاوز هذه النسبة عُدَّ المبلغ مقدم ثمن للصفقة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- لا يعد المبلغ الذي دفعه المشتري أو المستأجر عربوناً إلا إذا نُصّ على ذلك كتابة، وإلّا فهو مقدم ثمن لا يستحقه البائع أو المؤجر إذا فُسخ العقد.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- على البائع أو المؤجر حال تسلم العربون إتمام الصفقة، وإذا تعثر إتمامها بسبب من المشتري أو المستأجر دون وجود عيب في العقار؛ فلا يعاد العربون، وإن كان سبب التعثر لا يعود إلى أي منهما، فيلزم إعادة العربون إلى من دفعه.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">4- لا يجوز للوسيط العقاري الاحتفاظ بالعربون ضماناً لحقه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b70410eff5ec4673967ac87f0be7dc68\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- تتحدد عمولة الوساطة العقارية بنسبة (2.5%) من قيمة الصفقة إن كانت بيعاً، ومن قيمة إيجار السنة الأولى فقط إن كانت إيجاراً، ما لم يتفق أطراف عقد الوساطة -كتابةً- على غير ذلك.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- يتحمل دفع العمولة الطرف المتعاقد مع الوسيط العقاري في عقد الوساطة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- في حال أبرم الوسيط العقاري عقد وساطة مع أكثر من طرف من أطراف الصفقة العقارية الواحدة؛ فلا يجوز أن يتجاوز مجموع ما يتقاضاه من عمولة النسبة المحددة للعمولة في الفقرة (1) من هذه المادة، وتحدد اللائحة طريقة تحمل الأطراف العمولة في هذه الحالة، ما لم ينص في العقد على غير ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/49e636a8d0f94611896f3cf97c622349\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يستحق الوسيط العقاري العمولة في الحالات الآتية:</p>\\n<p>1- إتمام الصفقة العقارية التي توسط بها، وفقاً لعقد الوساطة، أثناء مدة سريانه، أو خلال مدة لا تتجاوز (شهرين) من انتهاء العقد، على أن يثبت وساطته في هذه الحالة.<br>2- عدم إتمام الصفقة العقارية، واستحقاق البائع أو المؤجر للعربون، وتحدد اللائحة النسبة والضوابط المتعلقة بذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5b12cc2cadc14cf2be5cff0414a14d17\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- لا يجوز للوسيط العقاري تسلم أي مبلغ من أي من الأطراف المتعاقد معهم لمصلحة أي منهم إلا بالقدر الذي يتطلبه القيام بعمله، وفقاً لما تحدده اللائحة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- لا يجوز للوسيط العقاري التصرف في أي مبلغ تسلّمه وفقاً للفقرة (1) من هذه المادة إلا في الأغراض المخصصة له.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- تضع الهيئة ضوابط لتعامل الوسيط العقاري مع المبالغ التي يتسلّمها من أي من الأطراف المتعاقد معهم.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/78ef80e0d78b4c97a7715e441371762e\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- تباشر الهيئة مهمات الرقابة والتفتيش والضبط لتنفيذ أحكام النظام، ويجوز لها أن تستعين بمن تراه من الجهات العامة أو الخاصة لتأدية هذه المهمات، وتحدد اللائحة الإجراءات اللازمة لذلك.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- يتولى المكلف بالرقابة والتفتيش والضبط ضبط ما يقع من مخالفات لأحكام النظام، وفقاً لإجراءات الضبط التي تحددها اللائحة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- يلتزم كل من يمارس نشاط الوساطة العقارية أو الخدمات العقارية بتمكين المكلف بالرقابة والتفتيش والضبط من أداء أعماله وتسهيل مهماته، ويشمل ذلك دخول مقر عمله، وتزويده بما يطلب من مستندات أو معلومات متصلة بأحكام النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e3af6ec8f559462280347aa690585c1c\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يُعد من مخالفات أحكام النظام ارتكاب أي من الأفعال الآتية:</p>\\n<p>1- ممارسة نشاط الوساطة العقارية والخدمات العقارية دون ترخيص.<br>2- تقديم معلومات غير صحيحة للحصول على ترخيص لممارسة نشاط الوساطة العقارية والخدمات العقارية.<br>3- تقديم معلومات مضللة أو إخفاء معلومات جوهرية في شأن العقار محل الوساطة أو الخدمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a6c5d023577446408b4fcc5ef7ca586b\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- يعاقب كل من يخالف أي حكم من أحكام النظام، بعقوبة أو أكثر من العقوبات الآتية:<br>أ- الإنذار.</p>\\n<p>ب- تعليق الترخيص لمدة لا تتجاوز (سنة).</p>\\n<p>ج- إلغاء الترخيص.</p>\\n<p>د- غرامة لا تتجاوز (200,000) مائتي ألف ريال.</p>\\n<p>2- تجوز مضاعفة الغرامة المحكوم بها في حال تكرار المخالفة خلال (ثلاث) سنوات من ارتكابها.<br>3- تحدد اللائحة تصنيف المخالفات والعقوبات المقررة لها بناءً على الفقرة (1) من هذه المادة.<br>4- يحق لمن أُلغي ترخيصه التقدم بطلب ترخيص جديد وفق الإجراءات النظامية بعد مضي (ثلاث) سنوات من تاريخ الإلغاء.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a74cc5d2a6d74a49828117ae30893bfc\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- تكوَّن بقرار من رئيس المجلس لجنة (أو أكثر) من ثلاثة أعضاء -على الأقل- يكون أحدهم من المختصين في الشريعة أو الأنظمة؛ تتولى النظر في مخالفات أحكام النظام، وإيقاع العقوبات المنصوص عليها في المادة (التاسعة عشرة) من النظام، وتصدر قراراتها بالأغلبية، ويعتمدها الرئيس التنفيذي للهيئة. وتحدد اللائحة إجراءات عمل اللجنة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- يجوز لمن صدر بحقه قرار العقوبة التظلم منه لدى الجهة القضائية المختصة خلال (ثلاثين) يوماً من إبلاغه بقرار العقوبة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/10969a3c5e5e46eeb8f22f0af864698d\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>إذا شكل ارتكاب أي مخالفة لأحكام النظام مخالفةً أخرى يعاقب عليها نظام آخر؛ فتطبق العقوبة الأشد.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b4586688e28c411685ffa3e7bf69456f\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">يلغي النظام لائحة تنظيم المكاتب العقارية، الصادرة بقرار مجلس الوزراء رقم (334) وتاريخ 7 / 3 / 1398هـ.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/67323025a7504cffa7fceaa60a4ca83c\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر المجلس اللائحة خلال (مائة وثمانين) يوماً من تاريخ صدور النظام، وتنشر في الجريدة الرسمية، ويعمل بها من تاريخ نفاذ النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6045a50f41394dfc9dda96178ff3ce7f\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يعمل بالنظام بعد (مائة وثمانين) يوماً من تاريخ نشره في الجريدة الرسمية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":"نظام الوساطة العقارية"}},"header":{"Value":{"#cdata-section":"نظام الوساطة العقارية"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"نظام الوساطة العقارية\",\n  \"الوساطة\",\n  \"الوساطة العقارية\",\n  \"نظام\",\n  \"الانظمة\",\n  \"الانظمة واللوائح والادلة\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"نظام الوساطة العقارية"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2022-07-22T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2022-06-30T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"أنظمة\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":"نظام ممارسة نشاط التوسط في إتمام صفقة عقارية بين أطرافها؛ وذلك مقابل الحصول على عمولة. ويشمل ذلك الوساطة الإلكترونية من خلال وسائل التقنية؛ كالمواقع الإلكترونية ومنصات التواصل الاجتماعي ونحوها."}},"title":{"Value":{"#cdata-section":"نظام الوساطة العقارية"}}}}},"IsRoot":true},{"Key":"e99f8468-2b64-32db-9bf9-ce70442120aa","Alias":"نظام بيع وتأجير مشروعات عقارية على الخارطة","Path":"/dad36d29-6b31-4d36-8787-fcb9a2921a25.config","Level":5001,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/dad36d29-6b31-4d36-8787-fcb9a2921a25.config","Node":{"Content":{"@Key":"dad36d29-6b31-4d36-8787-fcb9a2921a25","@Alias":"نظام بيع وتأجير مشروعات عقارية على الخارطة","@Level":"5","Info":{"Parent":{"@Key":"2e83ad93-6ff8-412f-961b-49003de4c4aa","#text":"الانظمة"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-08-04T13:36:17","NodeName":{"@Default":"نظام بيع وتأجير مشروعات عقارية على الخارطة"},"SortOrder":"1","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"9a0c8b55-09eb-4218-807e-75916662ee3b\",\n    \"mediaKey\": \"3e74db69-a104-426d-b3ea-f0eeebc025b2\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/90e021c44fc845dfaddfbdb7dc6ed049\"\n      },\n      {\n        \"contentUdi\": \"umb://element/33725376ad7a4ca29eb2497051a1bb90\"\n      },\n      {\n        \"contentUdi\": \"umb://element/078bc882e5a24d3cb9c638245a8e8abb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1130f9b06f8a45c59832abeaa1c00d6a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/785cbe37676c418791418a2b836c97ad\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d6e23b5772a34aafb14297bc612aefc7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0f1c986b26794c19ac20308da68f8e64\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b9fc6e274c484d34b4ec7f777739ad2f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a1c106112c8340b78baf411551580c40\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e3f1d21279334ad08c79f54f2d442c2f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1a2f2f67ccb8402b8ef1614766bb3b2e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8196081cb9d44c5481fd1e42b3b4032f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7bb2be401df540f5b35f8506f784a6de\"\n      },\n      {\n        \"contentUdi\": \"umb://element/64839a47dbd0463c8c9e240ad6824707\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4ac35aaae4d340c98d806a4ad74e6bb1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/430a448f7d5042a6b2376b7b7ff88a37\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0fe757a20b04497abe3c982443ab4532\"\n      },\n      {\n        \"contentUdi\": \"umb://element/add1ed9c6e4648079d6a90a533271ba8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/82321781c9f04699aae4a5ae5f7083a2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7f8931c1b30c41b7b546468a94b74cab\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8d1612a937e64995a8dc5728b5b2ba40\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5a95480232d84eed82fce71dbae8c2db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/161a9edc436747c7aec434a6fea5cf0f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/667af33273ca4b27bc46596306855bed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/faf3e9867ea6489ca97c1476f589a6cf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/07d5a188ef504628bff75604997e0afc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f3251aeb0d954a50a73adbf1a1fc66f5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1d9296377ead40e68ad09ea44342eb3b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8d32052743b04b8a99d0516a01d1f218\"\n      },\n      {\n        \"contentUdi\": \"umb://element/17fbacd6e9d943db9bb93f03772a52cf\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/90e021c44fc845dfaddfbdb7dc6ed049\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p> </p>\\n<p>يقصد بالكلمات والعبارات الآتية -أينما وردت في هذا النظام- المعاني المبينة أمام كل منها، ما لم يقتضِ السياق غير ذلك:<br><strong>النظام:</strong> نظام بيع وتأجير مشروعات عقارية على الخارطة.<br><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.<br><strong>الجهة المختصة:</strong> الجهة المختصة بتطبيق أحكام النظام، التي يصدر بتحديدها أمر من رئيس مجلس الوزراء.<br><strong>المسؤول:</strong> المسؤول الأول في الجهة المختصة.<br><strong>المشروع العقاري:</strong> مشروع عقاري يراد تطويره لبيع أو تأجير أراضٍ مطورة أو وحدات عقارية على الخارطة، قبل البدء في تنفيذه أو في أثناء أعمال الإنشاء والتطوير بحسب التصميم أو المخطط المتفق عليه.<br><strong>حساب الضمان:</strong> حساب بنكي خاص بالمشروع العقاري، تودع فيه المبالغ التي دفعها الممولون للمشروع العقاري، أو المشترون، أو المستأجرون من المشروع.<br><strong>التطوير العقاري:</strong> تشييد المشروعات العقارية السكنية أو التجارية أو المكتبية أو الخدمية أو الصناعية أو السياحية أو غيرها.<br><strong>المطور:</strong> الشخص ذو الصفة الاعتبارية المرخص له بمزاولة نشاط امتلاك العقارات أو استئجارها من أجل تطويرها وبيعها أو تأجيرها بحسب الأحوال، ويشمل المطور الرئيس والفرعي.<br><strong>المطور الفرعي:</strong> الشخص ذو الصفة الاعتبارية المرخص له بمزاولة نشاط امتلاك العقارات أو استئجارها من أجل تطويرها وبيعها أو تأجيرها بناءً على اتفاق مع المطور الرئيس.<br><strong>الوسيط العقاري:</strong> شخص طبيعي أو اعتباري، مرخص له بممارسة الوساطة العقارية أو تقديم الخدمات العقارية وفقاً للأحكام النظامية.<br><strong>المكتب الاستشاري:</strong> مكتب هندسي استشاري مرخص له من جهة الاختصاص، اعتمدته الجهة المختصة للمشروع العقاري.<br><strong>المحاسب القانوني:</strong> شخص مرخص له من جهة الاختصاص، اعتمدته الجهة المختصة للمشروع العقاري.<br><strong>سجل قيد المطورين:</strong> سجل تقيد فيه أسماء المطورين المؤهلين لتطوير وبيع وتأجير المشروعات العقارية، المرخص لهم من الجهة المختصة بمزاولة نشاط التطوير العقاري في المملكة.<br><strong>الوحدة العقارية:</strong> الجزء المفرز من العقار، الذي يبيعه أو يؤجره المطور للغير.<br><strong>الجزء المشاع: </strong>الجزء المشترك بين ملاك الوحدات العقارية في المشروع العقاري.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/33725376ad7a4ca29eb2497051a1bb90\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تسري أحكام النظام على ما يلي: &nbsp;</p>\\n<p>1. &nbsp;نشاط بيع وتأجير مشروعات عقارية على الخارطة، تسلم فيه مبالغ من المشترين، أو من المستأجرين، أو من الممولين للمشروع العقاري.</p>\\n<p>2. &nbsp;نشاط بيع وتأجير المشروعات العقارية التابعة للجهات الحكومية على الخارطة بما يتفق مع طبيعتها وفي حدود ما تتضمنه اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/078bc882e5a24d3cb9c638245a8e8abb\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p> </p>\\n<p>لا يحق لأي مطور عقاري مزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة إلا إذا كان مقيدًا في سجل قيد المطورين، ولا يحق الإعلان عنها في وسائل الإعلام المحلية أو الخارجية، ولا إقامة معارض لها والدعوة إليها؛ إلا إذا كان المشروع العقاري مرخصاً له من الجهة المختصة؛ وفقاً لأحكام النظام واللائحة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1130f9b06f8a45c59832abeaa1c00d6a\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تتولى الجهة المختصة وفقًا للنظام ما يلي:</p>\\n<p>1. &nbsp;الإشراف على المشروعات العقارية، بما في ذلك إصدار التراخيص اللازمة لها، ومتابعة تنفيذها، والرقابة والتفتيش عليها. ويجوز للمسؤول إسناد بعض تلك المهمات إلى القطاع الخاص، وفقًا لأحكام النظام واللائحة.</p>\\n<p>2. &nbsp;إعداد قاعدة بيانات للعموم خاصة بالمشروعات العقارية المرخص لها وفق النظام. وتحدد اللائحة البيانات الواجب تضمينها في قاعدة البيانات.</p>\\n<p>3. &nbsp;إعداد سجل خاص يسمى (سجل قيد المطورين). وتحدد اللائحة ضوابط وإجراءات القيد.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/785cbe37676c418791418a2b836c97ad\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>للجهة المختصة أن تطلب من المطور -إذا رغب في تسويق المشروع العقاري من خلال وسيط عقاري- تزويدها بنسخة من الاتفاقية المبرمة مع الوسيط العقاري، وذلك وفقًا لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6e23b5772a34aafb14297bc612aefc7\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1. &nbsp;يجب على المطور الراغب في بيع أو تأجير مشروعات عقارية على الخارطة -بعد قيد اسمه في سجل قيد المطورين- أن يقدم طلبًا إلى الجهة المختصة للحصول على الترخيص الخاص للمشروع العقاري مشفوعًا بما يلي:<br>أ- نسخة من السجل التجاري ساري المفعول، الذي يسمح له بمزاولة نشاط التطوير العقاري.<br>ب- شهادة عضوية الغرفة التجارية.<br>ج- نسخة من السجل الائتماني من شركة مرخص لها من الجهة المختصة بالخدمات الائتمانية.<br>د- رخصة بناء للمشروع العقاري سارية المفعول.<br>هـ- صك تسجيل الملكية (ساري المفعول) للعقار المراد تطويره.&nbsp;<br>و- نسخة من الاتفاقية المبرمة بينه وبين مالك الأرض أو مالك منفعتها بما يتفق مع أحكام النظام واللائحة.<br>ز- نسخة من الاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي -إن وجدت- بما يتفق مع أحكام النظام واللائحة.<br>ح- التصاميم المعمارية والمخططات الهندسية التي اعتمدتها الجهات المختصة.<br>ط- نسخة من العقد المبرم بينه وبين المكتب الاستشاري، بما يتفق مع أحكام النظام واللائحة.<br>ي- نسخة من العقد المبرم بينه وبين المحاسب القانوني، بما يتفق مع أحكام النظام واللائحة.<br>ك- دراسة الجدوى الاقتصادية للمشروع العقاري من مكتب استشاري تتضمن: تكاليف المشروع العقاري التقديرية، وأوجه الصرف اللازمة عليه، والتدفق النقدي له، والمدة الزمنية المتوقعة لتنفيذه.<br>ل- تعهد منه ببدء الأعمال الإنشائية للمشروع العقاري خلال (ستة) أشهر من تاريخ حصوله على الترخيص.<br>م- نموذج عقد بيع بينه وبين المشتري ومواعيد تسليم المبيع محددة باليوم بما يتفق مع أحكام النظام واللائحة وغير متعارضة مع أحكام الشريعة الإسلامية.<br>ن- اتفاقية فتح حساب ضمان بينه وبين بنك مرخص له في المملكة، بما يتفق مع أحكام النظام واللائحة.<br>وللجهة المختصة إضافة أو تعديل بعض الشروط.</p>\\n<p>2. &nbsp;تبت الجهة المختصة في الطلب خلال (ثلاثين) يومًا من تاريخ استكمال المستندات المطلوبة، وإذا انقضت تلك المدة دون البت عُدَّ ذلك موافقة على الطلب. وفي حال رفض الجهة المختصة للطلب فيجب أن يكون القرار مسببًا.<br>وعلى الجهة المختصة أن تضع الاشتراطات اللازمة للموافقة على المشروع العقاري في كل مراحله، وتبين تلك الاشتراطات في اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0f1c986b26794c19ac20308da68f8e64\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>للجهة المختصة -في سبيل تحقيق أهداف النظام وعند الاقتضاء- قيد الشخص الطبيعي في سجل قيد المطورين والترخيص له بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة؛ وفق ضوابط تحددها اللائحة على أن تشتمل على سقف محدد لحجم المشروع العقاري، وعلى عدد محدد من المشروعات العقارية التي يسمح له بتنفيذها سنويًّا، وذلك وفقًا لأحكام النظام واللائحة.&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b9fc6e274c484d34b4ec7f777739ad2f\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>دون إخلال بأحكام نظام التسجيل العيني للعقار؛ على الجهة المختصة عند إصدار الترخيص الخاص للمشروع العقاري، طلب إجراء التأشير على صك تسجيل الملكية للعقار المراد تطويره (لدى الجهة المختصة بالتوثيق) بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري، ولا يرفع التأشير عن صك تسجيل الملكية لذلك العقار إلا بعد موافقة الجهة المختصة. وتحدد اللائحة الحالات التي يرفع فيها التأشير بعدم التصرف. وللمتضرر من قرار الجهة المختصة التظلم أمام اللجنة المنصوص عليها في المادة (الحادية والعشرين) من النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a1c106112c8340b78baf411551580c40\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>ينشأ حساب ضمان مستقل باسم كل مشروع عقاري، ولا يُفعَّل إلا بعد الحصول على الترخيص الخاص للمشروع العقاري والتأشير على صك تسجيل الملكية للعقار المراد تطويره.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e3f1d21279334ad08c79f54f2d442c2f\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1. &nbsp;يكون حساب الضمان مخصصًا لأغراض الصرف على المشروع العقاري المرخص له فقط، ولا يجوز الحجز على المبالغ المودعة فيه لمصلحة دائني المطور.</p>\\n<p>2. &nbsp;إذا حصل المطور أو مالك الأرض على تمويل للمشروع العقاري المرخص له، فيجب إيداعه في حساب الضمان، ويكون التصرف بمبلغ التمويل وفقًا لأحكام النظام واللائحة.&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1a2f2f67ccb8402b8ef1614766bb3b2e\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يكون الصرف من حساب الضمان بناءً على وثيقة صرف يوقعها المطور والمكتب الاستشاري والمحاسب القانوني، وفي الحالات الطارئة يجوز الصرف بطلب من الجهة المختصة، وفقًا لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8196081cb9d44c5481fd1e42b3b4032f\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجوز للمطور طلب الصرف من حساب الضمان للمصاريف الإدارية والتسويقية -والمصاريف الأخرى غير الإنشائية للمشروع العقاري المرخص له- بنسبة لا تتجاوز (20%) من قيمة الوحدة العقارية المبيعة. وعلى المحاسب القانوني التأكد من ألا يتجاوز مجموع ما يصرف من حساب الضمان للمصاريف غير الإنشائية ما نسبته (20%) من إجمالي قيمة الوحدات العقارية المبيعة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7bb2be401df540f5b35f8506f784a6de\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجوز للمطور -بعد موافقة الجهة المختصة- سحب ما يفيض عن التكلفة الفعلية الإجمالية لإنهاء المشروع العقاري وخدماته، بناءً على تقرير من المقاول والمكتب الاستشاري. على أن يبقي المحاسب القانوني ما نسبته (20%) في حساب الضمان، إلى حين انتهاء المشروع العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/64839a47dbd0463c8c9e240ad6824707\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجب على المحاسب القانوني الاحتفاظ بنسبة (5%) من القيمة الإجمالية لتكلفة الإنشاءات في حساب الضمان، أو أن يقدم المطور للمحاسب القانوني ضمانًا بنكيًّا بالنسبة نفسها، وذلك بعد حصول المطور على شهادة الإنجاز. ولا يصرف المبلغ المحتفظ به في حساب الضمان للمطور إلا بعد انقضاء مدة (سنة) من تاريخ انتهاء المشروع العقاري المرخص له. أو في حال تقديم وثيقة تأمين على العيوب الخفية للمباني والإنشاءات وذلك وفقًا لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4ac35aaae4d340c98d806a4ad74e6bb1\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يلتزم المطور بتقديم قوائم مالية - يعدها المحاسب القانوني - لكل مشروع عقاري مرخص له؛ إلى الجهة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/430a448f7d5042a6b2376b7b7ff88a37\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>لا يحق للمطور ولا مالك الأرض التصرف في الجزء المشاع من المشروع العقاري المرخص له قبل فرز الوحدات العقارية. ويكون التصرف فيه بعد الفرز وفقًا لنظام ملكية الوحدات العقارية وفرزها إدارتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0fe757a20b04497abe3c982443ab4532\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يحق للمشتري، أو المستأجر، أو من ينوب عنهما؛ الاطلاع على السجلات المحاسبية الخاصة به، وتزويده بنسخ منها، وفقًا لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/add1ed9c6e4648079d6a90a533271ba8\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p> </p>\\n<p>1.  يجوز للجهة المختصة أن تطلب من المحاسب القانوني والمكتب الاستشاري تزويدها بالمعلومات والبيانات التي ترى ضرورة الاطلاع عليها، ويجوز لها أيضًا أن تستعين بمن تراه للتدقيق في تلك المعلومات والبيانات.</p>\\n<p>2.  يجوز للجهة المختصة طلب تقرير عن سير المشروع العقاري المرخص له من المحاسب القانوني والمكتب الاستشاري، وفقًا لما تحدده اللائحة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/82321781c9f04699aae4a5ae5f7083a2\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1. &nbsp;يجب على كل من المحاسب القانوني والمكتب الاستشاري -كل فيما يخصه- إبلاغ الجهة المختصة عن أي مخالفة لأحكام النظام أو اللائحة يطلع عليها بحكم عمله.</p>\\n<p>2. &nbsp;إذا ثبت للجهة المختصة قيام المطور أو المحاسب القانوني أو المكتب الاستشاري بارتكاب أي مخالفة لأحكام النظام أو اللائحة؛ فعليها إبلاغ المخالف بذلك كتابيًّا وتحديد مهلة له لتصحيح المخالفة، وذلك دون إخلال بتطبيق العقوبات الواردة في النظام في حقه. ويجب على المخالف إشعار الجهة المختصة كتابيًّا بتصحيح المخالفة خلال تلك المهلة.</p>\\n<p>3. &nbsp;إذا ثبت للجهة المختصة قيام البنك بارتكاب أي مخالفة لأحكام النظام أو اللائحة، فعليها إشعار البنك المركزي السعودي بذلك كتابيًّا.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7f8931c1b30c41b7b546468a94b74cab\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1. &nbsp;يلتزم المطور بإنهاء المشروع العقاري في الموعد المحدد لإنجازه. وفي حال التأخر عن تسليم الأرض أو الوحدة العقارية دون سبب خارج عن إرادته؛ فيستحق المشتري تعويضاً ماديًّا يحدد مسبقاً إن كانت أرضاً مطورة، أو أجرة مثلٍ إن كانت وحدة سكنية.</p>\\n<p>2. &nbsp;إذا حدث أي ظرف طارئ يترتب عليه عدم إكمال المشروع العقاري المرخص له، فللجهة المختصة -بالتشاور مع المحاسب القانوني والمكتب الاستشاري للمشروع العقاري- اتخاذ التدابير اللازمة، بما يضمن إكمال المشروع العقاري المرخص له أو تصفيته وإعادة المبالغ المدفوعة للمشروع العقاري؛ وفقًا لما تحدده اللائحة.</p>\\n<p>3. &nbsp;إذا وقعت مخالفة لأحكام النظام أو اللائحة، فللجهة المختصة اتخاذ التدابير اللازمة بما في ذلك إيقاف المشروع العقاري المرخص له إلى حين إزالة المخالفة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8d1612a937e64995a8dc5728b5b2ba40\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- يتولى النظر في مخالفات أحكام النظام واللائحة -عدا المخالفات الواردة في المادة (الرابعة والعشرين) منه- وإيقاع عقوبة الغرامة بما لا يتجاوز (مليون) ريال؛ لجنةٌ (أو أكثر) تشكل بقرار من المسؤول لمدة (ثلاث) سنوات قابلة للتجديد، وتتكون من أعضاء لا يقل عددهم عن (ثلاثة)، ويحدد قرار تشكيلها من يتولى رئاستها، على أن يكون من المختصين في الشريعة أو الأنظمة، وتصدر قراراتها بالأغلبية، وتكون مسببة، ويعتمدها المسؤول.<br>2- تحدد اللائحة قواعد عمل اللجنة وإجراءاتها ومكافآت أعضائها.&nbsp;<br>3- يجوز الاعتراض على قرارات اللجنة أمام المحكمة الإدارية خلال (ستين) يومًا من تاريخ الإبلاغ بالقرار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5a95480232d84eed82fce71dbae8c2db\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>دون إخلال بحكم الفقرة (1) من المادة (السادسة والعشرين) من النظام، يتولى مفتشون -يصدر بتحديدهم قرار من المسؤول- مجتمعين أو منفردين ضبط مخالفات أحكام النظام واللائحة، وإثباتها، والتحقيق فيها، وتحدد اللائحة آلية عملهم.&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/161a9edc436747c7aec434a6fea5cf0f\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يُصدر المسؤول -بقرار منه- جدول تصنيف للمخالفات -عدا المخالفات المنصوص عليها في المادة (الرابعة والعشرين) من النظام- وتحديدًا للعقوبات ضمن حدها المنصوص عليه في المادة (الحادية والعشرين) من النظام، يراعى فيه طبيعة كل مخالفة وجسامتها، والظروف المشددة والمخففة لها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/667af33273ca4b27bc46596306855bed\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>دون إخلال بأي عقوبة أشد ينص عليها نظام آخر، يعاقب بالسجن لمدة لا تزيد على (خمس) سنوات أو بغرامة لا تزيد على (عشرة ملايين) ريال، أو بهما معًا:</p>\\n<p>1. &nbsp;كل من زاول نشاط بيع وتأجير مشروعات عقارية على الخارطة، أو جمع مبالغ من مشترين أو مستأجرين لعقارات في مشروع عقاري، دون الحصول على ترخيص.</p>\\n<p>2. &nbsp;كل من قدم مستندات أو بيانات غير صحيحة لطلب الحصول على الترخيص للمشروع العقاري.</p>\\n<p>3. &nbsp;كل من عرض أو أعلن عن بيع أو تأجير عقارات على الخارطة في مشروعات عقارية وهمية مع علمه بذلك.</p>\\n<p>4. &nbsp;كل من اختلس أو بدد أو استعمل دون وجه حق مبالغ سُلِّمت له لغرض إقامة المشروع العقاري.</p>\\n<p>5. &nbsp;كل من تسلم مبالغ لغرض حجز أراضٍ أو وحدات عقارية بنيَّة بيعها أو تأجيرها على الخارطة بحسب الأحوال، ولم يودعها في حساب الضمان.</p>\\n<p>6. &nbsp;كل محاسب قانوني تعمد وضع تقرير غير صحيح نتيجة مراجعته للمركز المالي للمشروع العقاري، أو أخفى عمدًا وقائع جوهرية في تقريره.</p>\\n<p>7. &nbsp;كل من صادق من الاستشاريين على مستندات غير صحيحة تخص المشروع العقاري مع علمه بذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/faf3e9867ea6489ca97c1476f589a6cf\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1. &nbsp;للجهة المختصة أن تشطب قيد المطور من سجل قيد المطورين في أي من الحالتين الآتيتين:<br>أ- إذا لم يباشر الأعمال الإنشائية للمشروع العقاري المرخص له بعد انقضاء (ستة) أشهر من تاريخ حصوله على الترخيص، دون عذر مقبول.<br>ب- إذا تكرر منه تأخير أو تعثر في الإنجاز لعدد من المشروعات العقارية، أو ثبت إخلاله بجودة تنفيذها بصورة ينتج عنها ضرر للمشترين أو المستأجرين.</p>\\n<p>2. &nbsp;تشطب الجهة المختصة قيد المطور من سجل قيد المطورين في أي من الحالتين الآتيتين:<br>أ- إذا أشهر إفلاسه.<br>ب- إذا عوقب لارتكابه أي مخالفة جسيمة لأحكام النظام أو أحكام الأنظمة واللوائح المنظمة لمزاولة نشاط التطوير العقاري في المملكة خلال تنفيذه للمشروع العقاري، على أن تحدد اللائحة المخالفات الجسيمة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/07d5a188ef504628bff75604997e0afc\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1. &nbsp;تتولى النيابة العامة مباشرة التحقيق والادعاء في المخالفات المنصوص عليها في المادة (الرابعة والعشرين) من النظام؛ أمام المحكمة المختصة.&nbsp;</p>\\n<p>2. &nbsp;تتولى المحكمة المختصة النظر في القضايا الناشئة عن المخالفات المنصوص عليها في المادة (الرابعة والعشرين) من النظام وتوقيع العقوبات بحق المخالفين.&nbsp;</p>\\n<p>3. &nbsp;للمحكمة المختصة تضمين الحكم الصادر بالعقوبة النص على نشر ملخصه على نفقة المخالف في صحيفة محلية تصدر في مكان إقامته، فإن لم يكن في مكان إقامته صحيفة ففي أقرب منطقة له، أو نشره في أي وسيلة أخرى مناسبة، وذلك بحسب نوع المخالفة المرتكبة وجسامتها وتأثيرها، على أن يكون النشر بعد اكتساب الحكم الصفة النهائية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f3251aeb0d954a50a73adbf1a1fc66f5\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>للجهة المختصة أن تتقاضى مقابلًا ماليًّا لما تقدمه من خدمات بناءً على أحكام النظام. وذلك وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1d9296377ead40e68ad09ea44342eb3b\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يصدر المسؤول اللائحة خلال (تسعين) يومًا من تاريخ نشر النظام في الجريدة الرسمية، ويعمل بها من تاريخ العمل به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8d32052743b04b8a99d0516a01d1f218\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يلغي النظام كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/17fbacd6e9d943db9bb93f03772a52cf\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يعمل بالنظام بعد (تسعين) يومًا من تاريخ نشره في الجريدة الرسمية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":"نظام بيع وتأجير مشروعات عقارية على الخارطة"}},"header":{"Value":{"#cdata-section":"نظام بيع وتأجير مشروعات عقارية على الخارطة"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"نظام بيع وتأجير مشروعات عقارية على الخارطة\",\n  \"بيع\",\n  \"بيع وتأجير\",\n  \"نظام\",\n  \"الانظمة واللوائح والادلة\",\n  \"الانظمة\",\n  \"الهيئة العامة للعقار\",\n  \"الهيئة\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"نظام بيع وتأجير مشروعات عقارية على الخارطة"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2024-01-05T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2023-09-25T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"أنظمة\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":"نظام بيع وتأجير مشروعات عقارية على الخارطة"}}}}},"IsRoot":true},{"Key":"96ddddc2-1be5-32de-a137-17d3f03aaf09","Alias":"اللائحة التنظيمية للمزادات العقارية","Path":"/0242b700-ad86-4dba-a812-c5eb6f7f9b61.config","Level":5001,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/0242b700-ad86-4dba-a812-c5eb6f7f9b61.config","Node":{"Content":{"@Key":"0242b700-ad86-4dba-a812-c5eb6f7f9b61","@Alias":"اللائحة التنظيمية للمزادات العقارية","@Level":"5","Info":{"Parent":{"@Key":"c332c79b-387d-428b-9194-0910837a19e6","#text":"اللوائح"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-08-04T16:39:18","NodeName":{"@Default":"اللائحة التنظيمية للمزادات العقارية"},"SortOrder":"1","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"275b264d-a22f-42ac-8b5b-42c8ee6005f5\",\n    \"mediaKey\": \"6f6e61ca-07c0-4b62-8a2a-c66737e936da\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/c05cac4c65834858b70131a5e1470e98\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e6aa439b118347978c8cc28399260ba7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/79e3a0c9cacb49daabd0ed32c54f5a5b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/774dc0d992de4eb0aa9558a78f556fb4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/852a7f732dc6481ab3ed9572dc9c496e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ec2d3d4785ac416c91777b8a1bb241a8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4fa171b16b7e4ef58d430095c098badb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b6e9fa213c2b47a3bce8ce4c654b2142\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a1a8f4a3aa4b4898b49eed440a1ceebd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/24cf183cb8374c6f83981476a4d6388d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3b5fd9c8f8054d9fa92436c3a5566e89\"\n      },\n      {\n        \"contentUdi\": \"umb://element/91707b4583e8497abc7232dabd527ae1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6f93e85909ce4e5faefee78e8cc05eb8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f7a5508aab11429fb547f8534fbba896\"\n      },\n      {\n        \"contentUdi\": \"umb://element/31e11ad366984ce5ac5a900f7a54eec9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/740b50bfe26f42e9b0d6e976ad22a72a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a8ca639b080441a8d687f531c5bf30f\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c05cac4c65834858b70131a5e1470e98\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">1-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><!--[endif]--><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">يكون للألفاظ والمصطلحات الواردة في هذه اللائحة المعاني المُبينة أمام كل منها في المادة (الأولى) من نظام الوساطة العقارية الصادر بالمرسوم الملكي رقم: (م/130) في 30/11/1443هـ، ولائحته التنفيذية ما لم يقتض السياق خلاف ذلك.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpLast\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">2-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><!--[endif]--><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">يُقصد بالألفاظ والمصطلحات التالية -أينما وردت- في هذه اللائحة المعاني المُبينة أمام كل منها، ما لم يقتض السياق خلاف ذلك: </span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><strong>المزاد العقاري: </strong><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">المزايدة العلنية على عقار من أجل بيعه أو بيع منفعته أو تأجيره؛ للوصول بثمنه إلى أعلى قدر ويشمل ذلك المزادات الإلكترونية</span><span>.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><strong>المالك: </strong><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">شخص طبيعي أو اعتباري مالك للأصل أو المنفعة أو من يمثلهما نظاماً، المتعاقد مع الوسيط العقاري لإقامة المزاد العقاري.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><strong>المُقٍيم المعتمد: </strong><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الشخص المرخص له بمزاولة مهنة التقييم العقاري وفق نظام المقيمين المعتمدين.</span></p>\\n<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><strong>المرخص له:</strong><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"> شخص اعتباري مرخص له بممارسة خدمة المزادات العقارية. </span></p>\\n<p style=\\\"margin-right: .25in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"><strong>مدير المزاد العقاري:</strong> </span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">شخص طبيعي مؤهل وتابع للمنشأة المرخصة مخول بالقيام بإدارة كافة أعمال المزاد العقاري لصالح المرخص له.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/79e3a0c9cacb49daabd0ed32c54f5a5b\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">يشترط للترخيص لممارسة خدمة المزادات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية - للمنشآت التي تقدمها من خلال الوسائل الإلكترونية الآتي:</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">1- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">ربط منصة المزاد العقاري الإلكتروني الخاصة بالمرخص له، بالمنصة الإلكترونية للهيئة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">2-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">التعهد بضمان سلامة العمليات التي تتم في منصة المرخص له، وإيقاف أو إعادة المزاد العقاري في الصفقات التي يشوبها أخطاء تقنية أو مخالفات، بما يضمن حماية تنافسية العرض والطلب. </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">3-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">التعهد بنشر كافة بيانات المزادات العقارية المقامة على منصة المرخص له في المنصة الإلكترونية للهيئة. </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">4-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الحصول على كافة التراخيص النظامية اللازمة لممارسة النشاط، من الجهات ذات العلاقة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">5-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">ربط المنصة الإلكترونية مع منصة النفاذ الوطني، ودخول المستفيدين للوسيلة الإلكترونية عن طريقه.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/852a7f732dc6481ab3ed9572dc9c496e\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">يجب على المرخص له بممارسة المزادات العقارية، الالتزام بما يأتي:&nbsp;</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">1-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">التحلي بالنزاهة والإخلاص، والتعامل بحياد وعدل، وعدم التأثير على المنافسة العادلة بأي شكل.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">2-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">بذل العناية المهنية بحرص وإخلاص لتحقيق أفضل الأسعار.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">3-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">حفظ جميع نشرات المزادات العقارية وسجلاتها، </span>وتسجيل وقائع المزادات المرئية،<span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"> والمستندات والبيانات لجميع تعاملاته لمدة (خمس) سنوات من تاريخ انتهاء المزاد العقاري.<strong><u>&nbsp;</u></strong></span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">4-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">إقامة المزاد العقاري خلال مدة سريان عقد الوساطة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">5-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الحصول على الموافقات اللازمة من الجهات ذات الاختصاص في إقامة المزاد العقاري.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">6- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">ممارسة الخدمة من قبل الأفراد المؤهلين التابعين للمرخص له والمسجلين لدى الهيئة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">7- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الالتزام بما تقضي به الأنظمة والتعليمات من الجهات ذات الاختصاص في ممارسة المزادات العقارية.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">8- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الإعلان عن نشرة المزاد العقاري قبل (خمسة) أيام -بحد أدنى- من تاريخ إقامته.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ec2d3d4785ac416c91777b8a1bb241a8\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">على المرخص له تضمين عقد الوساطة لتقديم خدمة المزادات العقارية - إضافةً للأحكام الواردة لعقد الوساطة المنصوص عليها في النظام واللائحة التنفيذية - المعلومات التالية: </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">1-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">طريقة إقامة المزاد العقاري</span>.</p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">2-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">تاريخ إقامة المزاد العقاري ومدته –إن وجد-.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">3-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">  </span></span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">نوع التصرف بالعقار محل المزاد العقاري.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">4-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">  </span></span></span><!--[endif]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">الحد الأدنى لقيمة الترسية المقبولة للتصرف في العقار بعد المزايدة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">5-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">الحد الأدنى لقيمة بدء المزاد العقاري.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">6-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">مبلغ الدخول في المزايدة - إن وجد –</span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">، </span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">على ألا يتجاوز المبلغ نسبة (5%) من القيمة التقديرية للعقار بناء على تقييم من مقيم معتمد.</span>، و<span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">تحديد نوع المبلغ (عربون – مقدم ثمن – تأمين مسترد).</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">7-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">  </span></span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">المدة الزمنية المحددة للترسية على السعر الأعلى بعد المزايدة وإمكانية تمديدها لمدة مماثلة مرة واحدة. </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">8-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">  </span></span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">آليات ومدد تسلُّم وتسليم الثمن بعد الترسية.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">9- </span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">الأحكام المتعلقة بالتصرف في العقار كحق الشفعة، وخيار المجلس، وخيار الشرط، وبيع العربون، وغير ذلك.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b6e9fa213c2b47a3bce8ce4c654b2142\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">تنشأ في المنصة الإلكترونية بالهيئة سجل المزادات العقارية، يقيد فيها الآتي:&nbsp;</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"><span style=\\\"mso-list: Ignore;\\\"><span style=\\\"font: 7.0pt 'Times New Roman';\\\">&nbsp;</span>‌أ- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">سجل بيانات المرخص لهم.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"><span style=\\\"mso-list: Ignore;\\\">ب-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">بيانات كافة المزادات العقارية المنظَّمة من المرخص لهم، سواءً كانت إلكترونية أو غير إلكترونية.&nbsp;<br></span><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\">ج-</span></span>نشر كافة المؤشرات الإحصائية للمزادات بشكل دوري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a1a8f4a3aa4b4898b49eed440a1ceebd\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">يتقدم المرخص له للهيئة بطلب إقامة المزاد العقاري في المنصة الإلكترونية للهيئة، وتعبئة النموذج المعتمد -قبل إقامته- بخمسة عشر يوماً -بحدٍ أدنى-، مرفقاً به البيانات والمتطلبات التالية: </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">1-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">  </span></span></span><!--[endif]-->تحديد مكان وطريقة<span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"> إقامة المزاد العقاري.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">2-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">  </span></span></span><!--[endif]-->تاريخ<span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"> إقامة المزاد العقاري ومدته.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">3-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">  </span></span></span><!--[endif]-->تحديد مدير المزاد العقاري التابع له.</p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">4-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span>نوع التصرف بالعقار محل المزاد العقاري.</p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">5-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">آليات حفظ أموال المتنافسين في المزاد العقاري.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">6-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">آليات المزايدة والترسية الواردة في الفقرات (5-9) من المادة الرابعة من اللائحة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">7-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span><!--[endif]-->تسجيل بيانات<span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"> العقار محل المزاد العقاري، بما يشمل الآتي:</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\"><span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span>‌أ-   </span></span><!--[endif]-->بيانات مالك العقار أو مالك المنفعة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\"><span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span>‌ب- </span></span>البيانات المساحية والموقع، ومواصفات العقار، وحالته.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\">ج- </span></span>تحديد ملكية العقار على الأصل أو المنفعة، والاشتراك أو الشيوع أو نحو ذلك.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\"><span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span>‌د- </span></span>الإفصاح عن الحقوق العينية المرتبطة بالعقار.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\"><span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span>‌هـ- </span></span>النزاعات القائمة بشأن العقار -إن وجدت-.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\"><span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span>‌و- </span></span>الرهن أو القيد المؤثر في الانتفاع من العقار -إن وجد-.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\"><span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span>ز- </span></span>الحقوق والالتزامات على العقار غير الموثقة في وثيقة العقار -إن وجدت-.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\">‌ح- </span></span>الخدمات المتعلقة بالعقار -إن وجدت-.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpLast\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\"><span style=\\\"mso-list: Ignore;\\\">ط- </span></span>المعلومات التي قد تؤثر في قيمة العقار –إن وجدت-.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/24cf183cb8374c6f83981476a4d6388d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">1- </span></span><span style=\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">تدرس الهيئة طلب إقامة المزاد العقاري خلال مدة لا تتجاوز (خمسة) أيام عمل من اكتمال الطلب، و</span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">للهيئة</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">عند الحاجة لأي بيانات أو مستندات إضافية ترى ضرورتها، إشعار مقدم الطلب وعليه استكمال ما يلزم خلال مدة لا تتجاوز (خمسة) أيام عمل من تاريخ إبلاغه بذلك، وإلا عدّ الطلب مرفوضًا</span><span>.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpLast\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">2- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">تصدر الهيئة الموافقة على إقامة المزاد العقاري، أو ترفضه مع ذكر مسببات الرفض وإفادة مقدم الطلب بذلك.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/91707b4583e8497abc7232dabd527ae1\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">يجب أن يدرج المرخص له (نشرة المزاد العقاري) على المنصة الإلكترونية قبل نشرها للعموم، متضمنة: </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">1- </span></span>تحديد مكان <span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">وطريقة ووقت</span> إقامة المزاد العقاري.</p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">2-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">بيانات العقار المساحية والموقع، ومواصفات العقار، وحالته.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">3- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">تحديد نوع التصرف بالعقار محل المزاد العقاري.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">4-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الإفصاح عن الحقوق العينية المرتبطة بالعقار. </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">5- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">النزاعات القائمة بشأن العقار -إن وجدت-. </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">6-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الرهن أو القيد المؤثر في الانتفاع من العقار -إن وجد-. </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">7- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الحقوق والالتزامات على العقار غير الموثقة في وثيقة العقار -إن وجدت-.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">8- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">الخدمات المتعلقة بالعقار -إن وجدت-.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">9-</span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">المعلومات التي قد تؤثر في قيمة العقار –إن وجدت-.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">10- </span></span><!--[endif]--><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">رابط النقل المرئي المباشر للمزادات –إن وجد-.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">11- </span></span><!--[endif]--><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">البيانات الواردة في الفقرة رقم (6) من المادة (السادسة) من هذه اللائحة.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6f93e85909ce4e5faefee78e8cc05eb8\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l2 level1 lfo3; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">1- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">يتولى مدير المزاد العقاري إدارة المزايدة السعرية بين المتنافسين، </span>ويبدأ المزاد العقاري ‌<span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">وفقاً لقيمة بدء المزاد العقاري المحددة في عقد الوساطة، ويجوز بدء المزاد بغير تلك القيمة حال إقرار المالك - أو من يمثله نظاماً –كتابة على ذلك.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l2 level1 lfo3; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">2- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">إذا قدم أحد المتنافسين أعلى عطاء ولم يقم أحدٌ بالمزايدة عليه، -وفق المدة الزمنية المحددة في عقد الوساطة-، فيجوز لمدير المزاد العقاري تمديدها لمدة مماثلة مرة واحدة</span><span style=\\\"font-family: '29LT Bukra Lt';\\\">.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l2 level1 lfo3; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">3- </span></span>إذا لم يصل<span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"> المزاد العقاري للقيمة المتفق عليها لقبول البيع في عقد الوساطة، فيتم التعامل معها بأحد الأحوال التالية:</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 45.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"><span style=\\\"mso-list: Ignore;\\\">أ‌- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">إقرار المالك - أو من يمثله نظاماً - كتابة على قبول الترسية والتصرف في العقار بالسعر الذي وصلت له المزايدة.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 45.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"><span style=\\\"mso-list: Ignore;\\\">ب‌-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> &nbsp;</span></span></span><!--[endif]--><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">إنهاء المزايدة في حال عدم الإقرار من المالك - أو من يمثله نظاماً -، وتحرير محضر بذلك.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l2 level1 lfo3; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">4- </span></span>يتم ترسية<span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"> المزاد العقاري على المتنافس الذي قدم أعلى عطاء ولم يقم أحد بالمزايدة عليه، وانتهاء المدة المحددة للمزايدة، وفق الحالات التالية:</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l1 level1 lfo2; direction: rtl; unicode-bidi: embed; margin: 0in 45.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"><span style=\\\"mso-list: Ignore;\\\">أ‌-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">&nbsp;</span></span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">بلوغ المزايدة أو تجاوزها للقيمة المحددة لقبول الترسية والتصرف في العقار المنصوص عليها في عقد الوساطة.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l1 level1 lfo2; direction: rtl; unicode-bidi: embed; margin: 0in 45.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpMiddle\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"><span style=\\\"mso-list: Ignore;\\\">ب‌- </span></span><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">عدم بلوغ المزايدة للقيمة المحددة لقبول الترسية والتصرف في العقار المنصوص عليها في عقد الوساطة، وإقرار المالك -أو من يمثله نظاماً- كتابة على قبول الترسية والتصرف في العقار، وفقا للفقرة (3/أ) من هذه المادة.</span></p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l2 level1 lfo3; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpLast\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">5- </span></span>تستكمل<span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"> إجراءات التصرف في العقار، وحجز مبلغ العربون وفقا للمدة المحددة لتسلم وتسليم الثمن في عقد الوساطة.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f7a5508aab11429fb547f8534fbba896\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\"><span style=\\\"mso-list: Ignore;\\\">1-<span style=\\\"font: 7.0pt 'Times New Roman';\\\"> </span></span></span>يجب على<span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"> المرخص له إقفال المزاد العقاري في المنصة الإلكترونية بعد الانتهاء من إقامته خلال مدة لا تزيد على (خمسة) أيام عمل</span>.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpLast\\\"><!-- [if !supportLists]--><span style=\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\"><span style=\\\"mso-list: Ignore;\\\">2- </span></span>يعيد المرخص<span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\"> له جميع المبالغ المالية للمتنافسين المستلمة من قبله في المزاد العقاري - عدا من رسا عليه المزاد العقاري - خلال مدة لا تتجاوز (ثلاثة) أيام عمل من تاريخ الانتهاء من إقامته. </span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/740b50bfe26f42e9b0d6e976ad22a72a\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">تسري أحكام هذه اللائحة على كافة المزادات العقارية في المملكة، ومنها المزادات العقارية القضائية وما في حكمها في حدود ما لم يرد فيه نص خاص لتنظيمها.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6a8ca639b080441a8d687f531c5bf30f\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: '29LT Bukra Lt';\\\" lang=\\\"AR-SA\\\">تُنشر هذه اللائحة في الجريدة الرسمية، ويُعمل بها من تاريخ نشرها.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e6aa439b118347978c8cc28399260ba7\",\n      \"title\": \"أحكام الترخيص\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/774dc0d992de4eb0aa9558a78f556fb4\",\n      \"title\": \"التزامات المرخص له\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4fa171b16b7e4ef58d430095c098badb\",\n      \"title\": \"المنصة الإلكترونية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3b5fd9c8f8054d9fa92436c3a5566e89\",\n      \"title\": \"أحكام إقامة المزاد العقاري\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/31e11ad366984ce5ac5a900f7a54eec9\",\n      \"title\": \"أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":"اللائحة التنظيمية للمزادات العقارية"}},"header":{"Value":{"#cdata-section":"اللائحة التنظيمية للمزادات العقارية"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"اللائحة التنظيمية للمزادات العقارية\",\n  \"المزاد\",\n  \"المزادات العقارية\",\n  \"لوائح\",\n  \"الانظمة\",\n  \"الانظمة واللوائح والادلة\",\n  \"الهيئة العامة للعقار\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"اللائحة التنظيمية للمزادات العقارية"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2023-08-25T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2023-06-19T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"لوائح\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":"اللائحة التنظيمية للمزايدة العلنية على عقار من أجل بيعه أو بيع منفعته أو تأجيره؛ للوصول بثمنه إلى أعلى قدر ويشمل ذلك المزادات الإلكترونية."}},"title":{"Value":{"#cdata-section":"اللائحة التنظيمية للمزادات العقارية"}}}}},"IsRoot":true},{"Key":"80a95b6d-f7ec-341e-b38c-61bfdaf29f89","Alias":"ضوابط حساب الضمان المساهمات العقارية","Path":"/d5fd858d-8fc6-4317-a23c-3464da744332.config","Level":5001,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/d5fd858d-8fc6-4317-a23c-3464da744332.config","Node":{"Content":{"@Key":"d5fd858d-8fc6-4317-a23c-3464da744332","@Alias":"ضوابط حساب الضمان المساهمات العقارية","@Level":"5","Info":{"Parent":{"@Key":"3be850ea-467f-4ea1-bf3f-5d6a2657243d","#text":"ضوابط"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-08-04T16:11:24","NodeName":{"@Default":"ضوابط حساب الضمان المساهمات العقارية"},"SortOrder":"1","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"803f21c4-8234-4866-b5ad-5106621dd977\",\n    \"mediaKey\": \"9458ea9e-e472-480d-bc5a-79095f9feb7b\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/43cce3ff2ee847fcaf6309401444b99e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/386bc49eeee04189a44e3595261155e8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f69c0699b0664add9781e8358d5823c0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b3f93bbe2cab4173b7b31b16c3f49ca2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac055273a92245b9b051a5f343d3fa25\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d549305b3023429b9e745e828103971e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f436e6deffd04363a5f3eb9ea09fa5ef\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/43cce3ff2ee847fcaf6309401444b99e\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed; margin: 0in 13.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">لغرض تطبيق هذه الضوابط، يقصد بالعبارات والألفاظ الآتية -أينما وردت فيه- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المساهمة العقارية:</strong> مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقارية.<br><strong>المرخص له: </strong>المطور العقاري الحاصل على الترخيص.<br><strong>حساب الضمان: </strong>الحساب المصرفي الخاص بالمساهمة العقارية.<br><strong>سجل المساهمين: </strong>سجل تقيد فيه أسماء المساهمين وحصصهم وأي تغيير يحدث في ملكية حصصهم.<br>الترخيص: ترخيص المساهمة العقارية الصادر من الهيئة.<br><strong>أمين الحساب:</strong> المؤسسة المصرفية المرخص لها من جهة الاختصاص.<br><strong>المحاسب القانوني:</strong> الشخص المرخص له من الهيئة السعودية للمراجعين والمحاسبين لمزاولة مهنة المحاسبة والمراجعة.<br><strong>الاستشاري الهندسي:</strong> مكتب الإشراف الهندسي المرخص له من الهيئة السعودية للمهندسين بأعمال الاستشارات الهندسية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/386bc49eeee04189a44e3595261155e8\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed; margin: 0in 22.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تهدف هذه الضوابط إلى تنظيم حساب الضمان في مشاريع المساهمات العقارية وتسري هذه الضوابط على حساب الضمان مع مراعاة ما ورد من أحكام في نظام المساهمات العقارية ولائحته التنفيذية، وتعليمات البنك المركزي السعودي والأنظمة والتعليمات ذات الصلة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f69c0699b0664add9781e8358d5823c0\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>1-يفتح حساب الضمان (بالريال السعودي) باسم المساهمة العقارية بناء على طلب المرخص له وذلك بعد الحصول على الترخيص.</p>\\n<p>2-&nbsp; يُنشأ حساب ضمان واحد رئيس باسم المساهمة العقارية بموجب اتفاق كتابي بين المرخص له وأمين الحساب؛ لإيداع وإدارة أموال المساهمة العقارية.</p>\\n<p>3-&nbsp; تُفتح حسابات فرعية مرتبطة بالحساب الرئيس الخاص بالمساهمة العقارية وفق الآتي:<br>أ- حساب الاحتياطي لأغراض مواجهة أي مصاريف غير متوقعة للمساهمة العقارية وفق الأحكام المنصوص عليها في نظام المساهمات العقارية ولائحته التنفيذية.<br>ب- حساب الإيرادات لأغراض إيداع الناتج عن عملية بيع أصول المساهمة أو تصفيتها.<br>ج- أي حسابات فرعية أخرى لغرض المشروع، على سبيل المثال: حساب التمويل.</p>\\n<p>4- يجب أن تضمن اتفاقية فتح حساب الضمان بين المرخص له وأمين الحساب التزام المرخص له بعدم الصرف من الحساب إلا للأغراض الخاصة بالمساهمة العقارية المحددة فقط، وشروط وإجراءات الصرف من حساب الضمان بما يتفق مع هذه الضوابط والاتفاقيات أو العقود الموقعة بين المرخص له وكل من أمين الحساب والاستشاري الهندسي والمحاسب القانوني.</p>\\n<p>5- تعهد خطي من المرخص له بالموافقة على تعديل الاتفاقية الموقعة بينه وبين أمين الحساب في حال صدور أو تعديل أي أنظمة أو لوائح أو قرارات ذات علاقة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b3f93bbe2cab4173b7b31b16c3f49ca2\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تتم إدارة حساب الضمان الرئيس والحسابات الفرعية وفق الضوابط الآتية:<br>1- &nbsp; يتم الصرف من الحساب الرئيس بموجب وثيقة الدفع المقدمة من المرخص له إلى أمين الحساب على أن تكون مصادقة من الاستشاري الهندسي والمحاسب القانوني ومتضمنة المبالغ ومبررات الصرف، ويسمح باعتماد وثائق الصرف من خلال وسائل التقنية الآمنة.<br>2- &nbsp; يتم الصرف من الحساب الاحتياطي بموجب وثيقة الدفع المقدمة من المرخص له إلى أمين الحساب على أن تكون مصادقة من الاستشاري الهندسي والمحاسب القانوني ومتضمنة المبالغ ومبررات الصرف، مرفقاً بها موافقة جمعية المساهمين.<br>3- &nbsp; يتم الصرف من حساب الإيرادات بموجب وثيقة الدفع المقدمة من المرخص له إلى أمين الحساب، على أن تكون الوثيقة مبنية على سجل المساهمين ومصادقاً عليها من المحاسب القانوني ومتضمنة المبالغ المطلوبة، ومرفقاً بها شهادة الانجاز من الاستشاري الهندسي أو ما يفيد بتصفية المساهمة العقارية.<br>4- &nbsp; يكون الإيداع في الحساب الرئيس والفرعي من مؤسسة السوق المالية المعينة لطرح شهادات المساهمة أو الممولين أو المشترين أو الناتج من عمليات تصفية المساهمة العقارية بأي وسيلة دفع يقبلها أمين الحساب عدا النقد.<br>5- &nbsp; يقتصر الصرف من حساب الضمان من خلال شيكات أو حوالات فقط.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac055273a92245b9b051a5f343d3fa25\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 31.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- لا يسمح لأمين الحساب بالحجز على حساب الضمان لصالحه أو لصالح دائني المطور، إلا في حال وجود أمر قضائي على المساهمة العقارية.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 31.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">2- لا يسمح بنقل أي مبالغ مالية من حساب الضمان إلى أي حسابات أخرى، ما عدا الحسابات الفرعية لحساب الضمان المحدد الغرض منها.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 31.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- في حال حصول المرخص له على تمويل لصالح المساهمة العقارية فيجب إيداع مبلغ التمويل في حساب الضمان.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 31.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">4- لا يسمح بإصدار بطاقات صرف آلي أو بطاقات ائتمان على حساب الضمان.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 31.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">5- لا يسمح باستخدام الأموال الموجودة في الحساب في أي عمليات استثمارية أو مضاربة أياً كان نوعها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d549305b3023429b9e745e828103971e\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed; margin: 0in 31.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraph\\\">مع مراعاة تعليمات البنك المركزي السعودي، لا يتم إغلاق حساب الضمان من قبل المرخص له بعد انقضاء المساهمة العقارية وإعادة الأموال لمستحقيها إلا بعد موافقة الهيئة العامة للعقار.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f436e6deffd04363a5f3eb9ea09fa5ef\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; direction: rtl; unicode-bidi: embed; margin: 0in 31.5pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraph\\\">تنشر الضوابط ويعمل بها من تاريخ نشرها في الجريدة الرسمية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":"ضوابط حساب الضمان المساهمات العقارية"}},"header":{"Value":{"#cdata-section":"ضوابط حساب الضمان المساهمات العقارية"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"ضوابط حساب الضمان المساهمات العقارية\",\n  \"الضمان\",\n  \"المساهمات العقارية\",\n  \"ضوابط\",\n  \"الهيئة العامة للعقار\",\n  \"الهيئة\",\n  \"الانظمة واللوائح والادلة\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"ضوابط حساب الضمان المساهمات العقارية"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2024-02-16T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2024-01-30T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"ضوابط\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":"ضوابط الحسابات المصرفية الخاصة بالمساهمة العقارية"}},"title":{"Value":{"#cdata-section":"ضوابط حساب الضمان المساهمات العقارية"}}}}},"IsRoot":true},{"Key":"9b31a71d-6bab-3461-9d5e-13620c67bafc","Alias":"اللائحة التنفيذية لنظام التسجيل العيني للعقار","Path":"/5c9bebe3-8715-4a67-be6c-5a7a678b3521.config","Level":5002,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/5c9bebe3-8715-4a67-be6c-5a7a678b3521.config","Node":{"Content":{"@Key":"5c9bebe3-8715-4a67-be6c-5a7a678b3521","@Alias":"اللائحة التنفيذية لنظام التسجيل العيني للعقار","@Level":"5","Info":{"Parent":{"@Key":"c332c79b-387d-428b-9194-0910837a19e6","#text":"اللوائح"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-08-04T16:42:24","NodeName":{"@Default":"اللائحة التنفيذية لنظام التسجيل العيني للعقار"},"SortOrder":"2","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"fb534abb-63de-40fb-af52-03ac8571615c\",\n    \"mediaKey\": \"f0c43a1d-ad74-44f3-8c92-310a9e912a18\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/7337406543cd4480aa70f12ff137c484\"\n      },\n      {\n        \"contentUdi\": \"umb://element/568b1dda882a4979ab7c36e5ed0753d0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/02b172353aea4dc99c3589a8ff270d42\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7684ea6b260241c98cc7a4d230bff4b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/66f79e80c63c4eef8d6e4e7fbadc4279\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9c4d4089352a432f994ca29c2b62bdc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/343ec968d0a54687b9f2d97c5330a570\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cd3186af527c4fa7bfb43796d04ad728\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2290aa9c22e74dbc805a56c2a395ada2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b528254639e9405798f0a6ca2a2ec07c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d972e6e8c0984c578cc0f62bf89a8a82\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a9fb9bb7c3a942718b1494cc8bf0b4ff\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e0878895e44b4a6fb69c54e5f25c2a18\"\n      },\n      {\n        \"contentUdi\": \"umb://element/18b66b240b29465289725c0c8c684a56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/586992a89aac4d6e8bbd76315b66f96d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa260d591b5a4e00813a151c41beb4ad\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4755e6431b0540caa7cccdd269598024\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1e281e8aa00a4116a138336ac4bfdd3c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7633f34792df4a31be0a98e262820046\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4f18d6ad23174387942c3eb179c88474\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b93db5c388f24f6ea309604ebd7f6fb5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bced23bb413a407786cb8bf1f74ca967\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd279711adae47a9a010d9ce2129efcb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7869e05553f8421b80cc4168fcaa9bc1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5a5ad9e62d1140ccb1295ac9875fadaf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b3967558c4354039bcb38713ea31b111\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dda36db755b54fbea167ccebb78a0fad\"\n      },\n      {\n        \"contentUdi\": \"umb://element/42880503b31a4903bff65dadc3990fa1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/08932c3803084788b6c330065b613a90\"\n      },\n      {\n        \"contentUdi\": \"umb://element/71d01875bde44befb4320340996bfa67\"\n      },\n      {\n        \"contentUdi\": \"umb://element/99646bf6b22b4fea8d019855848328bd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b68e15bba79d4e88a49c19b3bda0d83e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f750b69af56f4b649c6e460bd10af82e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/18f15b97b61d45e0a00f90cbc8b764c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c6941ab4ea90430fa1cbb7898d28325a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4cbb1e205b5844efa6f0cdafaed28d4c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5bfa69e6113744ca9c521fafeaf6d1e8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/354662fee22349e6a26984473245cdd0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf3ebc022f9f4d8fa95fa51dc8206388\"\n      },\n      {\n        \"contentUdi\": \"umb://element/036fc398ccac4acf9cb889fe9035ca62\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ee075296e4034479b757f7562f236781\"\n      },\n      {\n        \"contentUdi\": \"umb://element/05a86d25ab6f4dbeabc432835f97c0fe\"\n      },\n      {\n        \"contentUdi\": \"umb://element/533dd3b5cbff4c5384e694dcc5083af7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9e54b4a8818245f8a78ac70ecf95e6c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a5c849813bf4ffa831bce026f159cd5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/516384bc9edc44d88f044fd2020b9696\"\n      },\n      {\n        \"contentUdi\": \"umb://element/70d2373cfe4f4c2d83824c0705b4af8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/df00f55bfdf64374994172ad8b702c41\"\n      },\n      {\n        \"contentUdi\": \"umb://element/693a3e5d521a44b89e92708721458570\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2a0d383514c54742b4bc32a59441a560\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cae7f669fd6b4dda9cfd190f0d813ad2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/69134ada7c4f4b1fb7ab77b35af744ec\"\n      },\n      {\n        \"contentUdi\": \"umb://element/86ebd2b2aaf74e0aa4c105ace3a113c3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac94a22e76874f4a80de7ef516777c16\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/568b1dda882a4979ab7c36e5ed0753d0\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون للكلمات والعبارات الواردة في هذه اللائحة المعاني المبينة أمام كل منها في المادة (الأولى) من نظام التسجيل العيني للعقار الصادر بالمرسوم الملكي رقم (م/91) وتاريخ 19/9/1443هـ، ما لم يقتض السياق غير ذلك.<br>2-يقصد بالكلمات والعبارات الآتية - أينما وردت في هذه اللائحة - المعاني المبينة أمام كل منها، مالم يقتضِ السياق خلاف ذلك:<br>الهيئة: الهيئة العامة للعقار.<br><strong>قاعدة البيانات العقارية:</strong> مجموعة البيانات الرقمية المكانية والوصفية للعقارات بكافة أشكالها وصورها؛ تتكون من طبقات وجداول وخرائط ومعالم مختلفة ومتكاملة مخزنة ومرتبطة مع بعضها البعض.<br><strong>صحيفة العقار:</strong> وثيقة في السجل العقاري تبين أوصاف العقار وموقعه وحالته المادية والنظامية، وما يتبعه من حقوق والتزامات، والتعديلات التي تطرأ على ذلك.<br><strong>تسجيل التصرفات العقارية: </strong>توثيق الحقوق العينية الأصلية والتبعية في السجل العقاري.<br><strong>الأعمال المساحية: </strong>عمليات فنية تبين حدود وأطوال ومساحة العقار في الطبيعة وإحداثياتها والخرائط العقارية اللازمة لها، وفقاً للمعايير الفنية.<br><strong>الدقة الأفقية المطلقة:</strong> مؤشر على دقة الخارطة في تمثيل المواقع المكانية للمعالم بالنسبة لمواقعها الحقيقية على سطح الأرض، وهي تمثل جذر خطأ متوسط التربيع لمجموعة البيانات.<br><strong>الدقة الأفقية النسبية:</strong> حجم القطع الناقص النسبي الناتج عن مقدار الثقة بين نقطتين.<br><strong>الخارطة العقارية:</strong> هي خارطة الأساس الرقمية المساحية للعقارات والتي رُسمت لأغراض التسجيل العيني للعقار وتحديثاتها.<br><strong>الرفع المساحي:</strong> عمليات قياس ورصد لحدود العقار على الواقع ونقلها الى خرائط باستخدام الأجهزة المساحية المختلفة.<br><strong>درجة الوضوح:</strong> المسافة الفعلية على سطح الأرض التي تمثلها خلية واحدة في مصورات الاستشعار عن بعد.<br><strong>مصورات مصححة عموديًا:</strong> هي صور يتم فيها تصحيح الإزاحة العامودية للمعالم الطبيعية والصناعية بحيث تكون المسافات فيها مساوية للمسافات على خارطة بالمقياس ذاته.<br><strong>المرجع المكاني الوطني للمملكة:</strong> نظام مرجعي ثابت معتمد من الهيئة العامة للمساحة والمعلومات الجيومكانية يحدد الإحداثيات الكارتيزية وخطوط الطول ودوائر العرض والارتفاع والمقياس والجاذبية والتوجيه في جميع أنحاء المملكة.<br><strong>نظام إسقاط مركاتور المستعرض العالمي:</strong> نظام إسقاط خرائطي يُستخدم في إنشاء الخرائط عن طريق نظام مركاتور الأسطواني (الإسقاط) وفيه تُحوَّل الإحداثيات الجغرافية إلى إحداثيات كارتيزية (مُسقَطة) تُستخدم في رسم الخرائط والقياسات الطولية وقياسات المساحة.<br><strong>الشخص:</strong> الشخص الطبيعي أو الاعتباري.<br><strong>رقم العقار: </strong>رقم صحيفته في السجل العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/02b172353aea4dc99c3589a8ff270d42\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">1- يشكل في الهيئة لجنة عليا للتسجيل العيني للعقار، برئاسة الرئيس التنفيذي للهيئة أو من ينيبه، وستة أعضاء من ذوي الخبرة والاختصاص يعينون بقرار من المسؤول الأول، وتتولى اللجنة المهام التالية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ-اقتراح السياسات والخطط الاستراتيجية المتعلقة بالتسجيل العيني للعقار والرفع به<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب.اقتراح تحديد المناطق العقارية، والخطط اللازمة للتنفيذ<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ج. إجراء البحوث والدراسات التي من شأنها تطوير أنظمة التسجيل العيني للعقار، والأنظمة التقنية والفنية ذات الصلة، بما يضمن استخدام أحدث وسائل التقنية والمعلومات لتنفيذ أحكام هذا النظام<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; د. اقتراح معالجة الإشكالات التنفيذية، وإبداء الرأي في المسائل التي تحال إليها فيما يتعلق بتطبيق نظام التسجيل العيني للعقار.<br>2- للجنة في سبيل تنفيذ المهمات الموكلة إليها الاستعانة بمن تراه من الخبراء والمختصين والجهات العامة أو الخاصة ذات الاختصاص</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7684ea6b260241c98cc7a4d230bff4b8\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>1-ينشأ السجل العقاري إلكترونياً، ويسمح بحفظ وأرشفة المستندات، وتعقب التعديلات ومعرفة القائمين بإدخالها.<br>2-يقسم السجل العقاري إلى مناطق عقارية، يعطى كل منها رقماً متسلسلاً مرتبطاً برقم المدينة أو المحافظة أو المركز، ويكون هو رقم سجل المنطقة العقارية.<br>3-يخصص لكل عقار صحيفة عقارية، تكون جزءاً من السجل العقاري.<br>4-يكون رقم صحيفة العقار في السجل العقاري مميزاً وفريداً.<br>5- ينشا في السجل العقاري فهرس شخصي، يخصص فيه لكل شخص صحيفة بحقوقه العينية الأصلية والتبعية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/66f79e80c63c4eef8d6e4e7fbadc4279\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>تنشأ قواعد بيانات مبنية على السجل العقاري، للانتفاع والاستثمار بها، بما في ذلك:</p>\\n<p>1- تمكين القطاع العام من الربط المكاني لمزاولة اختصاصاته، وتوظيف البيانات المكانية لتحسين خدماته.</p>\\n<p>2- تمكين القطاعين الخاص وغير الربحي من توظيف البيانات المكانية للأغراض التجارية وغير الربحية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9c4d4089352a432f994ca29c2b62bdc8\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>يكون الإشعار الوارد في النظام واللائحة بطريقة أو أكثر من الطرق التالية:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ-الإشعار عبر الرسائل النصية على الهاتف المحمول الموثق.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب-الإشعار عبر البريد الإلكتروني المسجل في السجل العقاري.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج-الإشعار عبر أحد الحسابات المسجلة في أي من الأنظمة الآلية الحكومية.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د-الإشعار عبر كتاب مسجل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/343ec968d0a54687b9f2d97c5330a570\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>1- يقدم طلب تصحيح الأخطاء المادية من أي ذي مصلحة، ويشمل الطلب:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ-رقم العقار.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب-صفة طالب التصحيح.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج-الخطأ المراد تصحيحه والمستندات اللازمة لذلك.</p>\\n<p>2- &nbsp;يعد محضر بالتصحيح ويرفق بملف صحيفة العقار ويشتمل على ما يلي:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ-رقم المحضر وتاريخه.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب-رقم العقار.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج-ذكر الخطأ وسببه؛ وكيفية التوصل إليه.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د-الإجراء المراد اتخاذه ومستنده.</p>\\n<p>3- تقوم الهيئة بتصحيح الأخطاء المادية إذا تبين لها ذلك دون تقدم ذوي المصلحة، ويعد محضر بذلك وفق الفقرة (2) من هذه المادة.</p>\\n<p>4- يعتمد المسجل العقاري طلبات تصحيح الأخطاء المادية.</p>\\n<p>5- لا يؤثر تصحيح الأخطاء المادية البحتة والكتابية على الأحكام المتعلقة بالحجية المطلقة للعقار.</p>\\n<p>6- تصحح الأخطاء المادية في بيانات السجل العقاري بما يضمن التعقب ومعرفة ما تم تصحيحه، ومن قام بالتصحيح.</p>\\n<p>7- تشعر الهيئة ذوي الشأن بالتصحيح، بأي من الطرق المنصوص عليها في المادة (الخامسة) من اللائحة.</p>\\n<p>8- يحق لذي الشأن الاعتراض على التصحيح خلال ثلاثين يوماً من تاريخ الإشعار بإجراء التصحيح.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cd3186af527c4fa7bfb43796d04ad728\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>1- يمكّن مالك أي من الحقوق العينية -دون مقابل- من الاطلاع على صحيفة عقاره، بما في ذلك التأشيرات المسجلة في الصحيفة.</p>\\n<p>2- مع مراعاة المادة الثامنة من اللائحة، يجوز لأي شخص أن يقدم طلباً للحصول على بيانات من السجل العقاري يبين فيه البيانات المطلوبة والغرض من ذلك الطلب.</p>\\n<p>3- &nbsp;يُصدر الرئيس التنفيذي -أو من يفوضه– قراراً باعتبار العقارات سرية، بناء على طلب من الجهات المعنية بهذه المواقع.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2290aa9c22e74dbc805a56c2a395ada2\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>1- لا يجوز الاطلاع على صحيفة الحقوق العينية للأشخاص إلا للآتي:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ-مالك الحق أو من يمثله نظاماً.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب-الوارث عن مورثه.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج-المحاكم والجهات القضائية.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د-الجهات الحكومية ذات العلاقة.</p>\\n<p>2- يجب أن تكون الطلبات المقدمة من الجهات الحكومية واردة بطلب رسمي، ويجوز الربط الإلكتروني مع أي جهة قضائية أو حكومية مختصة لتفعيل الاطلاع إلكترونياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b528254639e9405798f0a6ca2a2ec07c\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1- يعلن قرار تحديد المنطقة العقارية بأي وسيلة مناسبة يحددها القرار، على أن يكون منها واحدة أو أكثر مما يلي:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; &nbsp; الإعلان في المنصة الإلكترونية للسجل العقاري.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; النشر في الجريدة الرسمية وإحدى الصحف اليومية التي تصدر في منطقة العقار.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; النشر عبر حسابات الهيئة الرسمية في مواقع التواصل.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; &nbsp;اللوحات في مداخل المنطقة العقارية.</p>\\n<p>2- يجب أن يحتوي إعلان تحديد المنطقة العقارية، على البيانات التالية:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; &nbsp; رقم وتاريخ قرار الهيئة بتحديد المنطقة العقارية.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; موقع وحدود المنطقة أو المناطق العقارية بشكل دقيق وإرفاق خارطة توضيحية لكل منطقة.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; طريقة استقبال طلبات التسجيل العيني الأول والمدة المحددة لذلك.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; &nbsp;دعوة لذوي الشأن من ملاك وأصحاب الحقوق العينية، لتقديم طلبات التسجيل العيني الأول خلال المدة المحددة.</p>\\n<p>3- يبلغ قرار تحديد المنطقة العقارية إلى كافة الجهات ذات العلاقة بالتسجيل العيني الأول فور صدوره.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d972e6e8c0984c578cc0f62bf89a8a82\",\n      \"title\": \"المادة العاشرة \",\n      \"content\": {\n        \"markup\": \"<p>1- يقدم ذوي الشأن أو من يمثلهم؛ طلب التسجيل العيني الأول، مرفقاً به المستندات المثبتة للحقوق العينية، ومنها على سبيل المثال:</p>\\n<p>                 ‌أ-رقم وتاريخ الصك ومصدره.</p>\\n<p>               ‌ب- الوثائق التي تثبت الحقوق العينية -إن وجد-.</p>\\n<p>               ‌ج-المستندات المتعلقة بالعقار من مخططات هندسية ورخص البناء والهدم، وضمانات البناء والتأمين ونحوها -إن وجدت-.</p>\\n<p>2- يشعر المتقدم برقم طلب التسجيل العيني الأول، متضمناً اليوم والتاريخ والوقت، بأي من الطرق المنصوص عليها في المادة (الخامسة) من اللائحة.</p>\\n<p>3- مع مراعاة الفقرة (3) من المادة (الثامنة) من النظام يتم القيام بأعمال المساحة المتعلقة بالعقار محل التسجيل.</p>\\n<p>4- يتحقق المسجل العقاري من الاشتراطات والمستندات المتعلقة بالطلب، ويعتمد التسجيل العيني الأول.</p>\\n<p>5- مع مراعاة المادة (الثالثة عشرة) من اللائحة، إذا كانت مساحة العقار في التسجيل العيني الأول أقل من المساحة المذكورة في صك العقار المقدم، فلا يعتمد التسجيل العيني الأول إلا بموافقة ذوي الشأن على النقص.</p>\\n<p>6- تُصدِر الهيئة صك تسجيل الملكية بناء على السجل العقاري.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a9fb9bb7c3a942718b1494cc8bf0b4ff\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- تقترح اللجنة العليا للتسجيل العيني للعقار الجهة المعنية بتوثيق التصرفات العقارية في المنطقة العقارية المعلنة والتي تجري خلال فترة إجراءات التسجيل العيني الأول، ويضمن ذلك في قرار الإعلان الخاص بالمنطقة العقارية.</p>\\n<p>2- يحل من انتقل له الحق العقاري خلال فترة إجراءات التسجيل العيني الأول -وفق الفقرة (1) من هذه المادة- محل المالك السابق في استكمال إجراءات التسجيل العيني الأول.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e0878895e44b4a6fb69c54e5f25c2a18\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>إذا وقعت ازدواجية أو تداخل بين صكوك الملكية المقدمة في شأن عقار واحد، أثناء إجراءات التسجيل العيني الأول، ولم يتفق الملاك، فتوقف إجراءات التسجيل العيني الأول للعقار؛ ويرفض التسجيل ويعاملون وفق المادة (الحادية والعشرون) من النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/18b66b240b29465289725c0c8c684a56\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-right: 18.1pt; text-align: justify; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">إذا اختلفت مساحة الصك عن مساحة العقار في الطبيعة - زيادةً أو نقصاً -؛ فتسجل المساحة الواردة في الصك بعد التحقق من عدم تجاوزها في الطبيعة عن نسبة الزيادة والنقص المغتفرة وفق الجدول رقم (1) الآتي:</p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" class=\\\"MsoTableGrid\\\" style=\\\"border-collapse: collapse; border: none; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-table-dir: bidi; mso-border-insideh: .5pt solid #BFBFBF; mso-border-insideh-themecolor: background1; mso-border-insideh-themeshade: 191; mso-border-insidev: .5pt solid #BFBFBF; mso-border-insidev-themecolor: background1; mso-border-insidev-themeshade: 191;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr style=\\\"mso-yfti-irow: 0; mso-yfti-firstrow: yes;\\\">\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Times New Roman'; color: black; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-fareast-language: EN-GB; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">تصنيف المناطق العقارية</span></p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-right: none; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Times New Roman'; color: black; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-fareast-language: EN-GB; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">نسبة الخطأ في الأطوال</span></p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-right: none; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Times New Roman'; color: black; mso-color-alt: windowtext; mso-ansi-language: EN-GB; mso-fareast-language: EN-GB; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">نسبة الخطأ في المساحة</span></p>\\n</td>\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-right: none; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>درجة التفاوت</strong></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 1; height: 15.25pt;\\\">\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-top: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 15.25pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">•المناطق الحضرية</p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt; height: 15.25pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">1%</p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt; height: 15.25pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">2%</p>\\n</td>\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt; height: 15.25pt;\\\">\\n<p style=\\\"margin: 0in; text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-GB; mso-fareast-language: EN-GB; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">بشرط ألا تتجاوز الزيادة أو النقص عن 100م مربع عما ورد في الصك</span><span>.</span></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 2;\\\">\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-top: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">•<span> المناطق العشوائية</span></p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">2.3%</p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5%</p>\\n</td>\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin: 0in; text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-GB; mso-fareast-language: EN-GB; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">بشرط ألا تتجاوز الزيادة 300م مربع عما ورد في الصك</span><span>.</span></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 3; height: 5.8pt;\\\">\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-top: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 5.8pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">•<span> </span>المناطق الأخرى</p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt; height: 5.8pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3.5%</p>\\n</td>\\n<td width=\\\"125\\\" style=\\\"width: 93.5pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt; height: 5.8pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">7%</p>\\n</td>\\n<td width=\\\"163\\\" style=\\\"width: 122.25pt; border-top: none; border-left: solid #BFBFBF 1.0pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-right-alt: solid #BFBFBF .5pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt; height: 5.8pt;\\\">\\n<p style=\\\"margin: 0in; text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">بشرط ألا تتجاوز 3500م مربع عما ورد في الصك<span>.</span></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 4; mso-yfti-lastrow: yes; height: 2.9pt;\\\">\\n<td colspan=\\\"4\\\" width=\\\"575\\\" style=\\\"width: 431.5pt; border: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; padding: 0in 5.4pt 0in 5.4pt; height: 2.9pt;\\\">\\n<p style=\\\"text-align: center; line-height: 70%; direction: rtl; unicode-bidi: embed; margin: 3.0pt 0in 3.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Times New Roman'; mso-ansi-language: EN-GB; mso-fareast-language: EN-GB;\\\" lang=\\\"AR-SA\\\">جدول رقم (1): النسبة المغتفرة في تسجيل البيانات الواردة في الصك</span></p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/586992a89aac4d6e8bbd76315b66f96d\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- مع مراعاة الفقرة (5) من المادة (العاشرة) من اللائحة يجوز تسجيل العقارات دون تقدم ذوي الشأن بطلب التسجيل، إذا توفرت بيانات صكوك الملكية مستوفية للمتطلبات النظامية واكتملت البيانات الجيومكانية للعقار.</p>\\n<p>2- تشعر الهيئة ذوي الشأن بقيامها بالتسجيل بأي من الطرق المنصوص عليها في المادة (الخامسة) من اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fa260d591b5a4e00813a151c41beb4ad\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- لملاك العقارات الواقعة خارج نطاق المنطقة العقارية طلب تسجيل عقاراتهم في السجل العقاري وفق التالي:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ-التقدم بطلب إعلان موقع عقاراتهم منطقة عقارية وفق الاشتراطات اللازمة للاعلان.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب-تقديم بيانات جيومكانية مطابقة للمواصفات الجيومكانية المعمول بها في التسجيل العيني الأول، للموقع المراد إعلانه.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج-أن يكون للعقار -عدا العقارات المملوكة للدولة- صك ملكية مستوفٍ للمتطلبات النظامية.</p>\\n<p>2- تقوم الهيئة بدراسة الطلب والنظر في إعلان المنطقة التي يدخل في نطاقها العقار منطقة عقارية، واستكمال إجراءات الإعلان والتسجيل وفق أحكام النظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4755e6431b0540caa7cccdd269598024\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ينشأ في السجل العقاري صحيفة لكل عقار عند تسجيله، تتضمن ما يلي:</p>\\n<p>1-رقم العقار.</p>\\n<p>2- البيانات التخطيطية للعقار وتشمل على سبيل المثال: (رقم المخطط، رقم القطعة، رقم البلك) -إن وجدت-.</p>\\n<p>3- بيانات موقع العقار وتشمل على سبيل المثال: (اسم الحي، والمدينة).</p>\\n<p>4- حدود العقار، وأطواله، ومساحته.</p>\\n<p>5- رقم صك التملك السابق وتاريخه ومصدره.</p>\\n<p>6- الحقوق العينية وملاكها وبياناتهم، ونسبة تملكهم.</p>\\n<p>7- أوصاف العقار ويشمل على سبيل المثال: (البناء أو الملحقات الثابتة أو المزروعات أو المصانع أو المنشآت الأخرى كالموانئ والمطارات وخطوط الكهرباء والأنابيب وغيرها) -إن وجدت-.</p>\\n<p>8- بيانات الرخص المتعلقة بالعقار واستعمالاته وتشمل على سبيل المثال: (رخص إنشاء المباني أو إضافتها أو تعديلها أو إزالتها ونحوها) -إن وجدت-.</p>\\n<p>9- تاريخ التسجيل العيني الأول في السجل العقاري وتاريخ النشر في قوائم الملاك.</p>\\n<p>10- قيمة انتقال الحق العيني - إن وجد -.</p>\\n<p>11- تسلسل مالكي الحقوق العينية بعد التسجيل الأول.</p>\\n<p>12- الصحائف العقارية السابقة والمتفرعة - إن وجدت -.</p>\\n<p>13- بيان ما للعقار من حقوق والتزامات، وتاريخ نشأتها، وأصحابها.</p>\\n<p>14- صورة مصغرة لخارطة العقار النهائية، توضح فيها الانكسارات في جميع الأضلاع واتجاهاتها، وزاوية الانكسار والطول الإجمالي لكل ضلع، وإحداثيات أركانها، ويستثنى من ذلك الوحدات العقارية المفرزة.</p>\\n<p>15- اسم المسجل العقاري للحقوق العينية وتاريخ تسجيله لها.</p>\\n<p>16- بيان القيود المانعة من التصرف في العقار، وأسبابها، ومستند ذلك.</p>\\n<p>17- التأشيرات الواجب تدوينها في السجل العقاري وفق أحكام النظام واللائحة.</p>\\n<p>18- الأحكام النهائية الواجب تضمينها في السجل العقاري وفق أحكام النظام واللائحة.</p>\\n<p>19-ملف خاص ترفق به كافة المستندات المتعلقة بالعقار، ومنها على سبيل المثال (المخططات الهندسية ورخص البناء والهدم وشهادة التقييم والتثمين ووثائق التأمين ونحوها).</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1e281e8aa00a4116a138336ac4bfdd3c\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- تنشر قوائم الملاك في المنصة الالكترونية التابعة للسجل العقاري بعد اكتمال إجراءات التسجيل الأول.</p>\\n<p>2- تعلن الهيئة في الوسائل التي تراها مناسبة عن قيامها بنشر قوائم الملاك.</p>\\n<p>3- تحتوي قوائم الملاك على بيانات صك تسجيل الملكية التالية:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ-رقم العقار.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب-موقع العقار والبيانات التخطيطية له.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج-مساحة العقار.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د-الحقوق العينية وملاكها.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌هـ-آخر أربعة أرقام من هوية ملاك الحقوق العينية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7633f34792df4a31be0a98e262820046\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- يتقدم المعترض على التسجيل العيني الأول -بعد قيد الدعوى لدى المحكمة المختصة - للسجل العقاري، بطلب التأشير بالدعوى القضائية في السجل العقاري وقوائم الملاك.</p>\\n<p>2- يجوز لكل ذي مصلحة أن يطلب تزويده بما يفيد حصول التأشير بالدعوى القضائية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4f18d6ad23174387942c3eb179c88474\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تُصدِر الهيئة صك تسجيل الملكية بناء على السجل العقاري ويتضمن ما يلي:</p>\\n<p>1- رقم العقار.</p>\\n<p>2- الحقوق العينية وملاكها وبياناتهم، ونسبة تملكهم.</p>\\n<p>3- قيمة انتقال الحق العيني -إن وجد-.</p>\\n<p>4- بيان ما للعقار من حقوق والتزامات.</p>\\n<p>5- حدود العقار، وأطواله، ومساحته.</p>\\n<p>6- بيانات موقع العقار وتشمل على سبيل المثال: (اسم الحي، والمدينة).</p>\\n<p>7- صورة مصغرة لخارطة العقار النهائية، توضح فيها الانكسارات في جميع الأضلاع واتجاهاتها، وزاوية الانكسار والطول الإجمالي لكل ضلع، وإحداثيات أركانها، ويستثنى من ذلك الوحدات العقارية المفرزة.</p>\\n<p>8- البيانات التخطيطية للعقار وتشمل على سبيل المثال: (رقم المخطط، رقم القطعة، رقم البلوك) -إن وجدت-.</p>\\n<p>9- أوصاف العقار إجمالاً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b93db5c388f24f6ea309604ebd7f6fb5\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- يختص المسجل العقاري بتوثيق جميع التصرفات اللاحقة للتسجيل العيني الأول، وفق الدليل الإجرائي الذي تعده الهيئة لهذا الغرض.</p>\\n<p>2- يمكّن المتصرف إليه من الاطلاع على جميع بيانات صحيفة العقار قبل توثيق التصرف.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bced23bb413a407786cb8bf1f74ca967\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- يجوز تعديل بيانات العقار -الواردة من جهة الاختصاص- في السجل العقاري، ما لم تؤثر على الحقوق العينية فيجب أخذ موافقة ملاكها.</p>\\n<p>2- تصحح الإحداثيات في السجل العقاري دورياً؛ وفقاً لمقدار الإزاحة الذي تحدده الجهة المختصة بالمرجع الجيوديسي الوطني المعتمد.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dd279711adae47a9a010d9ce2129efcb\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تقوم الهيئة -آلياً- بالتأشير في السجل العقاري، بجميع عقود الإيجار المسجلة، متى ما كانت هذه العقود مدتها عشر سنوات فأكثر.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7869e05553f8421b80cc4168fcaa9bc1\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- يجوز لكل من يملك حق الشفعة أن يتقدم بطلب التأشير بإعلان رغبته في الأخذ بالشفعة في السجل العقاري.</p>\\n<p>2- يجوز لكل ذي مصلحة أن يطلب تزويده بما يفيد حصول التأشير بإعلان الرغبة في الأخذ بالشفعة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5a5ad9e62d1140ccb1295ac9875fadaf\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- يقوم صاحب الشأن بتزويد السجل العقاري بالأحكام النهائية الصادرة بشأن الدعاوى المشار إليها في المادة (السابعة عشرة) والمادة (الثامنة عشرة) من النظام.</p>\\n<p>2- تسجل الهيئة الأحكام النهائية في السجل العقاري.</p>\\n<p>3- يحفظ في السجل العقاري الأحكام النهائية التي جرى تسجيلها في السجل العقاري.</p>\\n<p>4- يجوز لكل ذي مصلحة أن يطلب من الهيئة تزويده بما يفيد حصول التسجيل المشار إليه في هذه المادة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b3967558c4354039bcb38713ea31b111\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يقدم طالب التسجيل أو التأشير وفق المادة (العشرون) من النظام؛ المستندات الرسمية التي تثبت أحقيته بالإجراء المطلوب، ومنها ما يلي:</p>\\n<p>1- صكوك الأحكام النهائية.</p>\\n<p>2- صكوك الإنهاءات والإقرارات الصادرة من الجهة المختصة.</p>\\n<p>3- صحائف الدعاوى القضائية.</p>\\n<p>4- عقود الإيجار المسجلة.</p>\\n<p>5- المستندات الموثقة نظاماً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dda36db755b54fbea167ccebb78a0fad\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- يدوّن وقت وتاريخ تقديم طلب التسجيل أو التأشير، محدداً باليوم والساعة والدقيقة.<br>2- إذا قدم إلى السجل العقاري أكثر من طلب للتسجيل أو التأشير في شأن العقار ذاته؛ وجب بحثها وفقاً لأسبقية تسجيل الطلب؛ إذا كان بينها تعارض أو ارتباط، يمنع تقديم أحدها على الآخر.</p>\\n<p>3- إذا قدم الطلب ناقصاً فيعاد الطلب للمتقدم لإكمال النواقص خلال ثلاثين يوماً؛ ويمكن للمتقدم استكمال الطلب لأكثر من مرة خلال هذه المدة، فإذا لم يكمل النواقص المطلوبة خلال هذه المدة فيعد طلب التسجيل كأن لم يكن.</p>\\n<p>4- يزود مقدم الطلب بما يفيد تقدمه بطلب التسجيل أو التأشير.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/42880503b31a4903bff65dadc3990fa1\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة المادة (الحادية والعشرون) من النظام يبلّغ طالب التسجيل أو التأشير في السجل العقاري برفض طلبه أو سقوط أسبقيته أو بوقف الإجراءات، وأسباب ذلك، بأي من الطرق المنصوص عليها في المادة (الخامسة) من اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/08932c3803084788b6c330065b613a90\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- تقوم الهيئة بالتأشير بالرخص والشهادات المتعلقة بالعقارات واستعمالاها، في السجل العقاري حال ورودها، وذلك لكافة العقارات المدرجة في السجل العقاري.</p>\\n<p>2- تشمل الرخص والشهادات المشار إليها على سبيل المثال لا الحصر: رخص الحفر، والبناء والترميم، والهدم والتسوير، وشهادة إتمام البناء، وحفر الآبار، وكافة رخص استعمال الأراضي الصناعية والتعدينية، ورخص الأبراج اللاسلكية ومحطات التقوية والهوائيات وغرف الكهرباء ونحوها.</p>\\n<p>3- يكون التأشير بالرخص والشهادات بتدوين رقمها وتاريخها ونوعها في صحيفة العقار، وتاريخ ووقت ورودها، وتاريخ ووقت تسجيلها أو التأشير بها.</p>\\n<p>4- ترفق صور الرخص والشهادات في الملف الخاص بها في صحيفة العقار وذلك بعد التأشير بموجبها في الصحيفة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/71d01875bde44befb4320340996bfa67\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- يكون الإبلاغ - المشار إليه في المادة (الرابعة والعشرون) من النظام - المقدم من مالك العقار أو من يمثله وفق النموذج المعد لذلك، وإرفاق المستندات المؤيدة له.</p>\\n<p>2- تقوم الهيئة بمراجعة المستندات المؤيدة للطلب، وتتخذ الإجراءات اللازمة حيال الطلب.</p>\\n<p>3- تشعر الهيئة ذوي الشأن بتحديث بيانات السجل العقاري، بأي من الطرق المنصوص عليها في المادة (الخامسة) من اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/99646bf6b22b4fea8d019855848328bd\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- ينشأ سجل التصرف في العقار الموصوف على الخارطة بطلب من المطور العقاري -المرخص له بمزاولة نشاط بيع أو تأجير عقار على الخارطة-، بعد ورود رخصة المشروع من الجهة المصدرة لها.</p>\\n<p>2- تدون بيانات العقارات الموصوفة على الخارطة في السجل المذكور قبل البدء في عملية التصرف بها، وفقاً للبيانات الواردة من الجهة المصدرة لرخصة المشروع والجهة المعنية بفرز الوحدات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b68e15bba79d4e88a49c19b3bda0d83e\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- يوثق المسجل العقاري التصرف في العقار الموصوف على الخارطة بين أطرافه، بعد اكتمال إنشاء السجل المشار إليه في المادة (الثلاثين) من اللائحة.</p>\\n<p>2- يصدر المسجل العقاري شهادة بذلك، تتضمن البيانات الواجب توافرها في المادة (السادسة عشرة) من اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f750b69af56f4b649c6e460bd10af82e\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- يجب على مالك العقار عند تقديم طلبه لتحويل البيانات الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام، إلى السجل العقاري إرفاق المستندات التالية:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- شهادة من الجهة المرخصة للمشروع باكتمال إنجاز العقار الموصوف على الخارطة.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- شهادة تثبت مطابقة العقار في الطبيعة لمحضر فرز الوحدة العقارية الصادر من الجهة المعنية بالفرز.</p>\\n<p>2- إذا لم يتقدم مالك العقار خلال (ثلاثين) يوماً، فيجوز بناء على قرار صادر الجهة المرخصة لمشروع العقار الموصوف على الخارطة -بعد استيفاء المتطلبات المنصوص عليها في الفقرة (1) من هذه المادة- طلب تحويل بيانات العقار من سجل العقار الموصوف على الخارطة إلى السجل العقاري، وتصدر الهيئة صك تسجيل الملكية بناء على ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/18f15b97b61d45e0a00f90cbc8b764c2\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- يكون لكل عقار مشترك صحيفة أساسية، تتفرع عنها صحيفة عقارية مستقلة لكل عقار مفرز، تكون مرتبطة بالصحيفة الأساسية.</p>\\n<p>2- يكون لكل عقار مفرز صك تسجيل ملكية مستقل.</p>\\n<p>3- تسجل وثائق الملكية المشتركة الصادرة من الجهة المعنية بالفرز، في صحيفة العقار الأساسية، ويشار لها في الصحائف المتفرعة عنها، وتشمل الوثائق على سبيل المثال: (وثيقة الأجزاء المشتركة، وثيقة فرز الوحدات).</p>\\n<p>4- تدون البيانات الجيومكانية لكل وحدة عقارية مفرزة بناء على ما يرد من الجهة المعنية بالفرز.</p>\\n<p>5- فيما عدا الأخطاء المادية البحتة تعدل بيانات الوحدة العقارية المفرزة بعد موافقة الجهة المعنية بالفرز، ما لم يحدث تأثيراً في بيانات بقية الوحدات المفرزة فيلزم موافقة ذوي الشأن.</p>\\n<p>6- إذا دمج عقاران أو أكثر، ولكل عقار صحيفة عقارية مستقلة، فتدمج صحائف العقار في صحيفة واحدة جديدة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c6941ab4ea90430fa1cbb7898d28325a\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>إذا دمج عقاران أحدهما محمل بحق عيني والآخر غير محمل، امتد الحق ليشمل العقار الجديد بأكمله، أما إذا كان كل من العقارين محمل بحق عيني مستقل، فيجب موافقة أصحاب الحقوق العينية على الدمج.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5bfa69e6113744ca9c521fafeaf6d1e8\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُصنّف المناطق العقارية -في قرار تحديد المنطقة العقارية- إلى ثلاث مستويات على النحو الآتي:</p>\\n<p>1- ‌المناطق الحضرية: وتضم العقارات الواقعة داخل النطاق العمراني للأمانات والبلديات والقرى التابعة لها، والعقارات الواقعة ضمن نطاق إشراف الهيئات الملكية والمدن الاقتصادية والصناعية ومشاريع الرؤية ونحوها.</p>\\n<p>2- المناطق العشوائية المأهولة: وتضم العقارات الداخلة في حدود الكتل العشوائية المأهولة والتي تقع خارج النطاق العمراني.</p>\\n<p>3- المناطق الأخرى: وتضم العقارات خارج نطاق إشراف الأمانات أو البلديات وخارج المناطق العشوائية المأهولة، مثل: المناطق الزراعية والغابات والمناطق الريفية والصحراوية والتعدينية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/354662fee22349e6a26984473245cdd0\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- تصمم قاعدة البيانات العقارية حسب النموذج الرقمي للبيانات المساحية العقارية وفق المعايير الجيومكانية الوطنية المعتمدة.</p>\\n<p>2- تتكون قاعدة البيانات العقارية من عدة طبقات تحتوي كل منها على عدة مستويات من البيانات.</p>\\n<p>3- يراعي النموذج الرقمي للبيانات المساحية المتعلقة بقاعدة البيانات العقارية الحد الأدنى من معلومات وبيانات الطبقات التالية:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- طبقة \\\"قطع الأراضي\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- طبقة \\\"الصور\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- طبقة \\\"المياه \\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- طبقة \\\"الجيولوجيا\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌هـ- طبقة \\\"الارتفاعات\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌و-طبقة \\\"الغطاء الأرضي\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ز-طبقة \\\" المرجع المكاني الوطني للملكة العربية السعودية \\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ح- طبقة\\\" استخدامات الأراضي\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ط- طبقة \\\"الأسماء الجغرافية\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ي- طبقة \\\"النقل\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ك- طبقة \\\"المناطق الإدارية\\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ل- طبقة \\\"العنوان الوطني \\\".<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌م- طبقة \\\"تقسيمات التصنيف العقاري\\\": وتتكون من حدود المناطق العقارية حسب تصنيف المناطق العقارية بالمملكة الواردة في المادة (الخامسة والثلاثين) من اللائحة.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ن- طبقة \\\"خطوط الكهرباء والأنابيب\\\" وتتكون من: خطوط أنابيب النفط وأنابيب الغاز والمياه والصرف الصحي وخطوط الأنابيب الأخرى، والعلامات التي تشير إلى موضعها، وخطوط الكهرباء والشبكات ونحوها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf3ebc022f9f4d8fa95fa51dc8206388\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- وحدة القياس المعيارية المعتمدة في قياس الطول هي (المتر الطولي) وتقاس المسافات لأقرب جزء من مئة من المتر (أي لغاية سنتيميتر).</p>\\n<p>2- وحدة القياس المعيارية المعتمدة لحساب المساحات هي (المتر المربع)، وتقاس المساحة لأقرب جزء من مئة من المتر (أي لغاية سنتيمتر).</p>\\n<p>3- عند رصد الإحداثيات في الموقع، تسجل لأقرب جزء من ألف من المتر (أي لغاية مليميتر).</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/036fc398ccac4acf9cb889fe9035ca62\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- تنفذ الأعمال المساحية باستخدام نظام المرجع الجيوديسي الوطني للمملكة العربية السعودية.</p>\\n<p>2- يُستخدم نظام (إسقاط مركاتور المستعرض العالمي) المستند إلى نظام المرجع الجيوديسي الوطني.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ee075296e4034479b757f7562f236781\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب الاستناد إلى النطاق الجغرافي الذي يغطي مساحة العقار وفقًا لـنظام (إسقاط مركاتور المستعرض العالمي)، وفي حالة وجود العقار بين نطاقين جغرافيين، فيجب اعتماد النطاق الجغرافي الذي يقع فيه الجزء الأكبر من العقار، من حيث جمع الإحداثيات والشهادات المساحية الصادرة بشأنه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/05a86d25ab6f4dbeabc432835f97c0fe\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يكون لكل عقار معلومات في قاعدة البيانات العقارية تشمل البيانات المذكورة في المادة (السادسة عشرة) من اللائحة، وتُعد هذه البيانات أساسية لإصدار خارطة عقارية مستقلة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/533dd3b5cbff4c5384e694dcc5083af7\",\n      \"title\": \"المادة الحادية والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يكون لكل منطقة عقارية خارطة أو خرائط عقارية تُبين العقارات الموجودة بها وأرقامها، ويعتمد إصدارها على قاعدة البيانات العقارية، وتحدّث خرائط المناطق العقارية وقاعدة البيانات العقارية دوريًا عند إجراء أنشطة المسح الجديدة، وفق أحكام النظام واللائحة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9e54b4a8818245f8a78ac70ecf95e6c2\",\n      \"title\": \"المادة الثانية والأربعون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 18.1pt 10.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\"><!-- [if !supportLists]-->1- تُعدّ الخرائط باستخدام التقنيات الحديثة مثل الصور الحديثة المأخوذة من التصوير الجوي والمصححة عمودياً باستخدام نقاط الضبط الأرضية التي تتوافق مع درجة الوضوح والمواصفات الموصى بها من الجهة المختصة، شريطة أن تكون جميع الإحداثيات مرتبطة في الخارطة المساحية الأولية ووفقًا لنظام المرجع الجيوديسي الوطني، على أن تكون الدقة الأفقية المطلقة المحددة للنقاط الأرضية لأركان قطع الأراضي والمباني بقياس (25) سم أو أفضل في المناطق الحضرية و(200) سم لما عدا ذلك.</p>\\n<p>2- يجوز من خلال الصور الجوية والفضائية؛ تعيين الحدود بمبنى قائم مثل: سور أو جدار أو سياج أو معلم مادي ثابت كسلسلة من التلال أو مجرى مائي، شريطة أن يكون هذا التحديد واضحًا على الأرض وعلى الصورة الجوية أو الفضائية، وفقا للمواصفات الفنية لجمع البيانات الجيومكانية والمساحية المدرجة في الجدول رقم (2)، وفي حال صعوبة تعيين الحدود أو عند الحاجة لدقة مكانية أعلى؛ فيجرى رفع مساحي ميداني أرضي.</p>\\n<p>&nbsp;</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-indent: -.25in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 18.1pt 10.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;</p>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" width=\\\"614\\\" class=\\\"MsoNormalTable\\\" align=\\\"left\\\" style=\\\"width: 460.7pt; border-collapse: collapse; border: none; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; mso-table-overlap: never; mso-yfti-tbllook: 1184; mso-table-lspace: 9.0pt; margin-left: 6.75pt; mso-table-rspace: 9.0pt; margin-right: 6.75pt; mso-table-anchor-vertical: paragraph; mso-table-anchor-horizontal: column; mso-table-left: center; mso-table-top: .05pt; mso-padding-alt: 0in 0in 0in 0in; mso-border-insideh: .5pt solid #BFBFBF; mso-border-insideh-themecolor: background1; mso-border-insideh-themeshade: 191; mso-border-insidev: .5pt solid #BFBFBF; mso-border-insidev-themecolor: background1; mso-border-insidev-themeshade: 191;\\\">\\n<tbody>\\n<tr style=\\\"mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 19.05pt;\\\">\\n<td width=\\\"132\\\" style=\\\"width: 99.2pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 0in 0in 0in; height: 19.05pt;\\\">\\n<p style=\\\"margin-bottom: 0in; margin-top: 0in; mso-margin-bottom-alt: 8.0pt; mso-margin-top-alt: 0in; mso-add-space: auto; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المناطق الأخرى</strong></p>\\n</td>\\n<td width=\\\"104\\\" style=\\\"width: 78.0pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-left: none; mso-border-left-alt: solid #BFBFBF .5pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 0in 0in 0in; height: 19.05pt;\\\">\\n<p style=\\\"margin-bottom: 0in; margin-top: 0in; mso-margin-bottom-alt: 8.0pt; mso-margin-top-alt: 0in; mso-add-space: auto; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"font-size: 13.0pt; line-height: 70%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-bidi-language: AR-EG;\\\" lang=\\\"AR-EG\\\">المناطق العشوائية المأهولة</span></p>\\n</td>\\n<td width=\\\"204\\\" style=\\\"width: 152.75pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-left: none; mso-border-left-alt: solid #BFBFBF .5pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 0in 0in 0in; height: 19.05pt;\\\">\\n<p style=\\\"mso-para-margin-top: .2gd; mso-para-margin-right: 0in; mso-para-margin-bottom: .2gd; mso-para-margin-left: 0in; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المناطق الحضرية</strong></p>\\n</td>\\n<td width=\\\"174\\\" style=\\\"width: 130.75pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-left: none; mso-border-left-alt: solid #BFBFBF .5pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; background: white; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: .75pt 5.4pt 0in 5.4pt; height: 19.05pt;\\\">\\n<p style=\\\"mso-para-margin-top: .2gd; mso-para-margin-right: 0in; mso-para-margin-bottom: .2gd; mso-para-margin-left: 0in; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المواصفات</strong></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 1; height: 2.05pt;\\\">\\n<td colspan=\\\"2\\\" width=\\\"236\\\" style=\\\"width: 177.2pt; border: solid #BFBFBF 1.0pt; mso-border-themecolor: background1; mso-border-themeshade: 191; border-top: none; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; padding: 0in 0in 0in 0in; height: 2.05pt;\\\">\\n<p style=\\\"mso-para-margin-top: .2gd; mso-para-margin-right: 0in; mso-para-margin-bottom: .2gd; mso-para-margin-left: 0in; text-align: center; line-height: 70%; mso-pagination: none; direction: rtl; unicode-bidi: embed; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: column; mso-element-left: center; mso-element-top: .05pt; mso-height-rule: exactly; margin: 2.4pt 0in 2.4pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span>15 – 50 سنتمتر</span></p>\\n</td>\\n<td width=\\\"204\\\" style=\\\"width: 152.75pt; border-top: none; border-left: none; border-bottom: solid #BFBFBF 1.0pt; mso-border-bottom-themecolor: background1; mso-border-bottom-themeshade: 191; border-right: solid #BFBFBF 1.0pt; mso-border-right-themecolor: background1; mso-border-right-themeshade: 191; mso-border-top-alt: solid #BFBFBF .5pt; mso-border-top-themecolor: background1; mso-border-top-themeshade: 191; mso-border-left-alt: solid #BFBFBF .5pt; mso-border-left-themecolor: background1; mso-border-left-themeshade: 191; mso-border-alt: solid #BFBFBF .5pt; mso-border-themecolor: background1; mso-border-themeshade: 191; padding: 0in 0in 0in 0in; height: 2.05pt;\\\">\\n<p style=\\\"mso-para-margin-top: .2gd; mso-para-margin-right: