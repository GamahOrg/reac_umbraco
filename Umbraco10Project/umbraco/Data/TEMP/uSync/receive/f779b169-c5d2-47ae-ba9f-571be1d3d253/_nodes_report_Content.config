eateDate":"2023-09-18T16:03:01","NodeName":{"@Default":"انضم إلينا","Name":[{"@Culture":"ar-jo","#text":"انضم إلينا"},{"@Culture":"en-us","#text":"Join the Team"}]},"SortOrder":"5","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":null},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"Join the Team"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"Join the Team"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"انضم إلينا"},{"@Culture":"en-us","#cdata-section":"Join Us"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>شكرا لك تم استلام طلبك&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"Join the Team"}]}}}},"IsRoot":true},{"Key":"6e37d14f-a3b6-319b-8f39-77ac534b60bf","Alias":"الشروط والأحكام","Path":"/8ac3294b-a997-45c4-bcec-1ad7e3797e67.config","Level":2007,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/8ac3294b-a997-45c4-bcec-1ad7e3797e67.config","Node":{"Content":{"@Key":"8ac3294b-a997-45c4-bcec-1ad7e3797e67","@Alias":"الشروط والأحكام","@Level":"2","Info":{"Parent":{"@Key":"97a252c6-8b24-473c-bfcc-6a96a54e6d41","#text":"الرئيسية"},"Path":"//","Trashed":"false","ContentType":"termsAndConditions","CreateDate":"2023-08-16T14:24:28","NodeName":{"@Default":"الشروط والأحكام","Name":[{"@Culture":"ar-jo","#text":"الشروط والأحكام"},{"@Culture":"en-us","#text":"Terms and Conditions"}]},"SortOrder":"7","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"9d538a6f-afac-4466-85bf-a65c57c5ab5b","#text":"TermsAndConditions"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"تضع بوابة الهيئة العامة للعقار سرية معلومات مستخدميها وزوارها على رأس قائمة الأولويات، وتبذل إدارة البوابة قصارى جهدها لتقديم خدمة عالية الجودة لجميع المستفيدين. يجب على زوار البوابة والمستفيدين من خدماتها مراجعة شروط ومبادئ الخصوصية "},{"@Culture":"en-us","#cdata-section":"Terms and Conditions"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":"[\n  \"شروط\",\n  \"احكام\",\n  \"الشروط والاحكام\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشروط والأحكام"},{"@Culture":"en-us","#cdata-section":"Terms and Conditions"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشروط والأحكام"},{"@Culture":"en-us","#cdata-section":"Terms and Conditions"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"termsSections":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"77843526-a0a2-42ca-9ee7-56d204e2231f\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"شروط وأحكام بوابة الهيئة العامة للعقار\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تضع بوابة الهيئة العامة للعقار سرية معلومات مستخدميها وزوارها على رأس قائمة الأولويات، وتبذل إدارة البوابة قصارى جهدها لتقديم خدمة عالية الجودة لجميع المستفيدين. يجب على زوار البوابة والمستفيدين من خدماتها مراجعة شروط ومبادئ الخصوصية وسرية المعلومات بشكل مستمر وذلك لمعرفة أي تحديثات تطرأ عليهم، مع العلم أن إدارة البوابة غير مطالبة بالإعلان عن أي تحديثات لهؤلاء الشروط والمبادئ، واستخدامك للبوابة يعني أنك اطلعت على تلك الشروط ووافقت عليها</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"3c8f6a81-e45a-4fca-9fc5-59f46ba66491\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"أمن المعلومات الشخصية\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تم إعداد وثيقة خصوصية وسرية المعلومات لمساعدة الزوار والمستخدمين على فهم طبيعة البيانات المجمعة منهم عند زيارة البوابة وكيفية التعامل معها. تتخذ إدارة البوابة الإجراءات والتدابير المناسبة والملائمة للحفاظ على المعلومات الشخصية الموجودة لديها بطريقة آمنة تضمن حمايتها من الضياع أو الوصول غير المصرح به أو سوء الاستخدام أو التعديل والإفصاح غير المصرح به.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"bf4f7959-ebfb-493b-99b5-d1542d9340fb\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"ومن أهم الإجراءات التي اتخذتها الهيئة لحماية المعلومات الشخصية للزائر\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>اتصل بنا على الفور عندما تعتقد أن شخصًا ما قد حصل على كلمة المرور أو رمز الاستخدام أو كلمة المرور أو أي معلومات سرية أخرى<br />التحديث المنتظم والدوري لإجراءات وضوابط الحماية التي تلبي أو تتجاوز المعايير القياسية.<br />موظفونا مؤهلون ومدربون على احترام سرية المعلومات الشخصية لزوارنا</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"87f7b821-e610-4fd7-be66-7d1b9a5be4f4\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"جمع المعلومات الشخصية\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>جمع واستخدام المعلومات الخاصة بك لإدارة أعمالنا وتزويدك بخدمات أفضل. يتم جمع هذه المعلومات من مصادر متعددة مثل نماذج طلب الخدمة المتنوعة، وأي معلومات تظهر على وسائل الاتصال الكتابية أو الإلكترونية التي تتم بيننا مثل الاسم والعنوان ورقم وثيقة الهوية الشخصية والمهنة وأي بيانات أخرى يتم توفيرها لنا. إذا قمت بإرسال بريد إلكتروني إلينا عبر البوابة الإلكترونية للهيئة العامة للعقار تزودنا فيه ببياناتك الشخصية، فقد نقوم بمشاركة البيانات اللازمة مع جهات أو إدارات أخرى، وذلك لخدمتك بشكل أكثر فعالية. لن نشارك بياناتك الشخصية مع الجهات غير الحكومية إلا إذا تم ترخيصها من قبل السلطات المختصة لأداء خدمات حكومية محددة. وبتقديم بياناتك ومعلوماتك الشخصية عبر البوابة الإلكترونية للهيئة العامة للعقار، فإنك توافق بشكل كامل على تخزين تلك البيانات ومعالجتها واستخدامها من قبل السلطات السعودية. نحن نحتفظ بالحق في جميع الأوقات في الكشف عن أي معلومات إلى السلطات المختصة، عندما يكون ذلك ضروريًا للامتثال لأي قانون أو لائحة أو طلب حكومي. أنت وحدك المسؤول عن اكتمال وصحة وصدق البيانات التي ترسلها عبر هذه البوابة.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"1576a860-516d-452f-9711-f08e98e23229\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"حماية خصوصيتك\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>اتصل بنا على الفور عندما تعتقد أن شخصًا ما قد حصل على كلمة المرور أو رمز الاستخدام أو كلمة المرور أو أي معلومات سرية أخرى<br />التحديث المنتظم والدوري لإجراءات وضوابط الحماية التي تلبي أو تتجاوز المعايير القياسية.<br />موظفونا مؤهلون ومدربون على احترام سرية المعلومات الشخصية لزوارنا<br />اتصل بنا على الفور عندما تعتقد أن شخصًا ما قد حصل على كلمة المرور أو رمز الاستخدام أو كلمة المرور أو أي معلومات سرية أخرى<br />التحديث المنتظم والدوري لإجراءات وضوابط الحماية التي تلبي أو تتجاوز المعايير القياسية.<br />موظفونا مؤهلون ومدربون على احترام سرية المعلومات الشخصية لزوارنا</p>\\\\n<p> </p>\\\\n<p><br />Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut Labore et dolore magna aliqua. إننا لا نسمح إلا بالحد الأدنى من النشاط الذي نمارسه من خلال العمل، ولا نتركه بعيدًا عن أي شيء يترتب على ذلك. Duis aute irure dolor في reprehenderit في voluptate velit esse cillum dolore eu</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"681ddf73-c837-475a-8929-6c2b48afe257\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"إرسال الرسائل الإلكترونية للهيئة\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>عندما تستفسر أو تطلب معلومات حول منتج أو خدمة معينة، أو إذا قمت بتقديم معلومات إضافية باستخدام أي من وسائل الاتصال مع الهيئة، سواء كانت إلكترونية أو غير إلكترونية، مثل طلب الاستفسار على موقعنا الإلكتروني، فإننا سوف نستخدم معلوماتك عنوان البريد الإلكتروني للرد على استفساراتك. من الممكن حفظ عنوان بريدك ورسالتك وردنا عليها لأغراض مراقبة الجودة، وقد نفعل ذلك لأغراض قانونية وتنظيمية.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"365ce8e2-25c3-4db0-b74e-9b43451a98d0\",\n    \"name\": \"Item 7\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"نطاق تطبيق هذه السياسة\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>أينما وردت كلمة \\\\\\\"هيئة\\\\\\\" في هذه السياسة فهي تعني الهيئة العامة للعقار</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"a8a186c4-0835-4ad1-a232-520d7fcadbf0\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Terms and conditions of the Real Estate General Authority portal\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate General Authority portal puts the confidentiality of the information of its users and visitors at the top of the list of priorities, and the portal management makes every effort to provide high quality service to all beneficiaries. The visitors of the portal and the beneficiaries of its services must constantly review the terms and principles of privacy and confidentiality of information in order to know any updates made to them, noting that the management of the portal is not required to announce any updates to those conditions and principles, and your use of the portal means that you have seen and agreed to those terms</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"9e86b2a3-f0db-4212-9308-4b4cff0289d0\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Security of personal information\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The privacy and confidentiality of information document has been prepared to help visitors and users understand the nature of the data collected from them when visiting the portal and how to deal with it. The management of the portal takes appropriate and appropriate procedures and measures to maintain the personal information it has in a secure manner that guarantees its protection from loss, unauthorized access, misuse, or unauthorized modification and disclosure.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"567be984-2eeb-4ee8-b8a5-d0e3d1b6e977\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Among the most important measures taken by the authority to protect the visitor's personal information\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<ul>\\\\n<li>Contact us immediately when you think someone has obtained your password, usage code, password, or any other confidential information</li>\\\\n<li>Regular and periodic updating of protection procedures and controls that meet or exceed standard standards.</li>\\\\n<li>Our staff are qualified and trained to respect the confidentiality of our visitors' personal information</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"d792dd92-59fc-4650-9279-778cc788c875\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Collection of personal information\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>Collect and use information about you to run our business and to provide you with better services. This information is collected from multiple sources such as various service request forms, and any information that appears on the written or electronic means of communication that take place between us, such as name, address, personal identification document number, profession and any other data that is provided to us. If you send an e-mail to us through the online portal of the Real Estate General Authority providing us with your personal data, we may share the necessary data with other entities or departments, in order to serve you more effectively. We will not share your personal data with non-governmental entities unless they are authorized by the competent authorities to perform specific government services. By submitting your personal data and information through the online portal of the Real Estate General Authority, you fully agree to the storage, processing and use of that data by the Saudi authorities. We reserve the right at all times to disclose any information to the competent authorities, when this is necessary to comply with any law, regulation or government request. You are solely responsible for the completeness, correctness and truthfulness of the data that you send through this portal.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"203b03a2-5e00-45e0-bf18-8744d3ac2247\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Protect your privacy\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<ul>\\\\n<li>Contact us immediately when you think someone has obtained your password, usage code, password, or any other confidential information</li>\\\\n<li>Regular and periodic updating of protection procedures and controls that meet or exceed standard standards.</li>\\\\n<li>Our staff are qualified and trained to respect the confidentiality of our visitors' personal information</li>\\\\n<li>Contact us immediately when you think someone has obtained your password, usage code, password, or any other confidential information</li>\\\\n<li>Regular and periodic updating of protection procedures and controls that meet or exceed standard standards.</li>\\\\n<li>Our staff are qualified and trained to respect the confidentiality of our visitors' personal information</li>\\\\n</ul>\\\\n<p> </p>\\\\n<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"72f878b8-94a2-4ef0-a4dc-6192d798af1e\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Sending electronic messages to the Authority\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>When you inquire or request information about a specific product or service, or if you provide additional information using any of the means of communication with the Authority, whether electronic or non-electronic, such as requesting an inquiry on our website, we will use your email address to respond to your inquiries. It is possible to save your mail address, message and our response to it for quality control purposes, and we may do so for legal and regulatory purposes.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"18795cac-e2c0-496e-a524-8fc5142d713a\",\n    \"name\": \"Item 7\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Scope of application of this policy\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>Wherever the word “Authority” appears in this policy, it means the Real Estate General Authority</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]"}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشروط والأحكام"},{"@Culture":"en-us","#cdata-section":"Terms and Conditions"}]}}}},"IsRoot":true},{"Key":"8041d3e0-2320-330c-b5f9-cfa3ab92ca7f","Alias":"سياسة الخصوصية","Path":"/f4b421cc-97e5-4ba5-942a-9650c6601147.config","Level":2008,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f4b421cc-97e5-4ba5-942a-9650c6601147.config","Node":{"Content":{"@Key":"f4b421cc-97e5-4ba5-942a-9650c6601147","@Alias":"سياسة الخصوصية","@Level":"2","Info":{"Parent":{"@Key":"97a252c6-8b24-473c-bfcc-6a96a54e6d41","#text":"الرئيسية"},"Path":"//","Trashed":"false","ContentType":"termsAndConditions","CreateDate":"2023-08-24T14:58:18","NodeName":{"@Default":"سياسة الخصوصية","Name":[{"@Culture":"ar-jo","#text":"سياسة الخصوصية"},{"@Culture":"en-us","#text":"Privacy Policy"}]},"SortOrder":"8","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"9d538a6f-afac-4466-85bf-a65c57c5ab5b","#text":"TermsAndConditions"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"تضع بوابة الهيئة العامة للعقار سرية معلومات مستخدميها وزوارها على رأس قائمة الأولويات، وتبذل إدارة البوابة قصارى جهدها لتقديم خدمة عالية الجودة لجميع المستفيدين."},{"@Culture":"en-us","#cdata-section":"Privacy Policy"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":"[\n  \"سياسة\",\n  \"الخصوصية\",\n  \"سياسة الخصوصية\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"سياسة الخصوصية"},{"@Culture":"en-us","#cdata-section":"Privacy Policy"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"سياسة الخصوصية"},{"@Culture":"en-us","#cdata-section":""}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"termsSections":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"3070901b-7af2-4c2e-b98e-3c573518191d\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"شروط وأحكام بوابة الهيئة العامة للعقار\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تضع بوابة الهيئة العامة للعقار سرية معلومات مستخدميها وزوارها على رأس قائمة الأولويات، وتبذل إدارة البوابة قصارى جهدها لتقديم خدمة عالية الجودة لجميع المستفيدين. يجب على زوار البوابة والمستفيدين من خدماتها مراجعة شروط ومبادئ الخصوصية وسرية المعلومات بشكل مستمر وذلك لمعرفة أي تحديثات تطرأ عليهم، مع العلم أن إدارة البوابة غير مطالبة بالإعلان عن أي تحديثات لهؤلاء الشروط والمبادئ، واستخدامك للبوابة يعني أنك اطلعت على تلك الشروط ووافقت عليها</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"9c6992ba-13bc-4236-8743-b28c5d786b53\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"أمن المعلومات الشخصية\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تم إعداد وثيقة خصوصية وسرية المعلومات لمساعدة الزوار والمستخدمين على فهم طبيعة البيانات المجمعة منهم عند زيارة البوابة وكيفية التعامل معها. تتخذ إدارة البوابة الإجراءات والتدابير المناسبة والملائمة للحفاظ على المعلومات الشخصية الموجودة لديها بطريقة آمنة تضمن حمايتها من الضياع أو الوصول غير المصرح به أو سوء الاستخدام أو التعديل والإفصاح غير المصرح به.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"f8d79e78-b28e-4068-b043-a3a260f375fc\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"ومن أهم الإجراءات التي اتخذتها الهيئة لحماية المعلومات الشخصية للزائر\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>اتصل بنا على الفور عندما تعتقد أن شخصًا ما قد حصل على كلمة المرور أو رمز الاستخدام أو كلمة المرور أو أي معلومات سرية أخرى<br />التحديث المنتظم والدوري لإجراءات وضوابط الحماية التي تلبي أو تتجاوز المعايير القياسية.<br />موظفونا مؤهلون ومدربون على احترام سرية المعلومات الشخصية لزوارنا</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"d64bddfd-b519-49a9-b4d1-5a622a60ee5d\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"جمع المعلومات الشخصية\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>جمع واستخدام المعلومات الخاصة بك لإدارة أعمالنا وتزويدك بخدمات أفضل. يتم جمع هذه المعلومات من مصادر متعددة مثل نماذج طلب الخدمة المتنوعة، وأي معلومات تظهر على وسائل الاتصال الكتابية أو الإلكترونية التي تتم بيننا مثل الاسم والعنوان ورقم وثيقة الهوية الشخصية والمهنة وأي بيانات أخرى يتم توفيرها لنا. إذا قمت بإرسال بريد إلكتروني إلينا عبر البوابة الإلكترونية للهيئة العامة للعقار تزودنا فيه ببياناتك الشخصية، فقد نقوم بمشاركة البيانات اللازمة مع جهات أو إدارات أخرى، وذلك لخدمتك بشكل أكثر فعالية. لن نشارك بياناتك الشخصية مع الجهات غير الحكومية إلا إذا تم ترخيصها من قبل السلطات المختصة لأداء خدمات حكومية محددة. وبتقديم بياناتك ومعلوماتك الشخصية عبر البوابة الإلكترونية للهيئة العامة للعقار، فإنك توافق بشكل كامل على تخزين تلك البيانات ومعالجتها واستخدامها من قبل السلطات السعودية. نحن نحتفظ بالحق في جميع الأوقات في الكشف عن أي معلومات إلى السلطات المختصة، عندما يكون ذلك ضروريًا للامتثال لأي قانون أو لائحة أو طلب حكومي. أنت وحدك المسؤول عن اكتمال وصحة وصدق البيانات التي ترسلها عبر هذه البوابة.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"ccf2bae8-7a48-40dd-8ff6-507a5d8fba5a\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"حماية خصوصيتك\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>اتصل بنا على الفور عندما تعتقد أن شخصًا ما قد حصل على كلمة المرور أو رمز الاستخدام أو كلمة المرور أو أي معلومات سرية أخرى<br />التحديث المنتظم والدوري لإجراءات وضوابط الحماية التي تلبي أو تتجاوز المعايير القياسية.<br />موظفونا مؤهلون ومدربون على احترام سرية المعلومات الشخصية لزوارنا<br />اتصل بنا على الفور عندما تعتقد أن شخصًا ما قد حصل على كلمة المرور أو رمز الاستخدام أو كلمة المرور أو أي معلومات سرية أخرى<br />التحديث المنتظم والدوري لإجراءات وضوابط الحماية التي تلبي أو تتجاوز المعايير القياسية.<br />موظفونا مؤهلون ومدربون على احترام سرية المعلومات الشخصية لزوارنا</p>\\\\n<p> </p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"e27368a9-2ea8-4aa8-8755-560abe2bedfd\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"إرسال الرسائل الإلكترونية للهيئة\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>عندما تستفسر أو تطلب معلومات حول منتج أو خدمة معينة، أو إذا قمت بتقديم معلومات إضافية باستخدام أي من وسائل الاتصال مع الهيئة، سواء كانت إلكترونية أو غير إلكترونية، مثل طلب الاستفسار على موقعنا الإلكتروني، فإننا سوف نستخدم معلوماتك عنوان البريد الإلكتروني للرد على استفساراتك. من الممكن حفظ عنوان بريدك ورسالتك وردنا عليها لأغراض مراقبة الجودة، وقد نفعل ذلك لأغراض قانونية وتنظيمية.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"498e3d1e-1319-40f2-942f-2769226f8399\",\n    \"name\": \"Item 7\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"نطاق تطبيق هذه السياسة\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>أينما وردت كلمة \\\\\\\"هيئة\\\\\\\" في هذه السياسة فهي تعني الهيئة العامة للعقار</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"c64f44c4-2286-49e6-841c-29d942208c75\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Terms and conditions of the Real Estate General Authority portal\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Real Estate General Authority portal puts the confidentiality of the information of its users and visitors at the top of the list of priorities, and the portal management makes every effort to provide high quality service to all beneficiaries. The visitors of the portal and the beneficiaries of its services must constantly review the terms and principles of privacy and confidentiality of information in order to know any updates made to them, noting that the management of the portal is not required to announce any updates to those conditions and principles, and your use of the portal means that you have seen and agreed to those terms</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"d45012f5-4410-47b3-a7c0-de2a36604c36\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Security of personal information\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The privacy and confidentiality of information document has been prepared to help visitors and users understand the nature of the data collected from them when visiting the portal and how to deal with it. The management of the portal takes appropriate and appropriate procedures and measures to maintain the personal information it has in a secure manner that guarantees its protection from loss, unauthorized access, misuse, or unauthorized modification and disclosure.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"758a6f65-38d5-4c05-ab08-50eedce7398b\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Among the most important measures taken by the authority to protect the visitor's personal information\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<ul>\\\\n<li>Contact us immediately when you think someone has obtained your password, usage code, password, or any other confidential information</li>\\\\n<li>Regular and periodic updating of protection procedures and controls that meet or exceed standard standards.</li>\\\\n<li>Our staff are qualified and trained to respect the confidentiality of our visitors' personal information</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"40bfd0a8-7c17-4cd5-88c3-41eb81e90665\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Collection of personal information\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>Collect and use information about you to run our business and to provide you with better services. This information is collected from multiple sources such as various service request forms, and any information that appears on the written or electronic means of communication that take place between us, such as name, address, personal identification document number, profession and any other data that is provided to us. If you send an e-mail to us through the online portal of the Real Estate General Authority providing us with your personal data, we may share the necessary data with other entities or departments, in order to serve you more effectively. We will not share your personal data with non-governmental entities unless they are authorized by the competent authorities to perform specific government services. By submitting your personal data and information through the online portal of the Real Estate General Authority, you fully agree to the storage, processing and use of that data by the Saudi authorities. We reserve the right at all times to disclose any information to the competent authorities, when this is necessary to comply with any law, regulation or government request. You are solely responsible for the completeness, correctness and truthfulness of the data that you send through this portal.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"31b8e700-2821-4f6e-b4fa-16468822713a\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Protect your privacy\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<ul>\\\\n<li>Contact us immediately when you think someone has obtained your password, usage code, password, or any other confidential information</li>\\\\n<li>Regular and periodic updating of protection procedures and controls that meet or exceed standard standards.</li>\\\\n<li>Our staff are qualified and trained to respect the confidentiality of our visitors' personal information</li>\\\\n<li>Contact us immediately when you think someone has obtained your password, usage code, password, or any other confidential information</li>\\\\n<li>Regular and periodic updating of protection procedures and controls that meet or exceed standard standards.</li>\\\\n<li>Our staff are qualified and trained to respect the confidentiality of our visitors' personal information</li>\\\\n</ul>\\\\n<p> </p>\\\\n<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"33ed087e-bde8-4465-b3b9-ba4f46920717\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Sending electronic messages to the Authority\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>When you inquire or request information about a specific product or service, or if you provide additional information using any of the means of communication with the Authority, whether electronic or non-electronic, such as requesting an inquiry on our website, we will use your email address to respond to your inquiries. It is possible to save your mail address, message and our response to it for quality control purposes, and we may do so for legal and regulatory purposes.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"d38f662b-f8eb-4396-b3e3-cd9d458e235f\",\n    \"name\": \"Item 7\",\n    \"ncContentTypeAlias\": \"termsBlock\",\n    \"PropType\": null,\n    \"sectionTitle\": \"Scope of application of this policy\",\n    \"sectionBrief\": \"{\\n  \\\"markup\\\": \\\"<p>Wherever the word “Authority” appears in this policy, it means the Real Estate General Authority</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]"}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"سياسة الخصوصية"},{"@Culture":"en-us","#cdata-section":"Privacy Policy"}]}}}},"IsRoot":true},{"Key":"07705a93-3cc7-3d1a-83df-2d83177bca88","Alias":"خريطة الموقع","Path":"/ec9664e4-41e5-40df-8c67-f7e3122f3b46.config","Level":2009,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/ec9664e4-41e5-40df-8c67-f7e3122f3b46.config","Node":{"Content":{"@Key":"ec9664e4-41e5-40df-8c67-f7e3122f3b46","@Alias":"خريطة الموقع","@Level":"2","Info":{"Parent":{"@Key":"97a252c6-8b24-473c-bfcc-6a96a54e6d41","#text":"الرئيسية"},"Path":"//","Trashed":"false","ContentType":"siteMap","CreateDate":"2023-09-18T13:35:55","NodeName":{"@Default":"خريطة الموقع","Name":[{"@Culture":"ar-jo","#text":"خريطة الموقع"},{"@Culture":"en-us","#text":"Site Map"}]},"SortOrder":"9","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"c76cb1d5-a05f-4ec0-9c14-9f7f18f764cd","#text":"SiteMap"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"خريطة الموقع"},{"@Culture":"en-us","#cdata-secti