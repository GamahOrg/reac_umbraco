n":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض"},{"@Culture":"en-us","#cdata-section":"Downtown Amman"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"84fa1388-e647-4c87-8eff-22c5b82c28b1\",\n    \"mediaKey\": \"9551eef8-87b9-4d33-82fc-ee60e17fa0f9\"\n  },\n  {\n    \"key\": \"2027e0cb-78c5-4718-a560-057511e5a41e\",\n    \"mediaKey\": \"64135d16-353f-4ec4-b925-63c5c30e5c20\"\n  },\n  {\n    \"key\": \"9e8d53a1-29d4-40d0-a44d-55276a9d1f84\",\n    \"mediaKey\": \"f897c796-9d68-425c-a334-906ca69d4daa\"\n  },\n  {\n    \"key\": \"6ab41392-edc0-45db-955e-5e106fc7086d\",\n    \"mediaKey\": \"2ad4aa75-b66b-4a18-9693-d42b641e3399\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"صور من الاجتماع الثاني لمجلس إدارة الهيئة"},{"@Culture":"en-us","#cdata-section":"Event 4"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"International event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"صور من الاجتماع الثاني لمجلس إدارة الهيئة"},{"@Culture":"en-us","#cdata-section":"Event 4"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2019-10-09T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-09-25T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"Businesses"}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"acdcc008-41ac-3d74-9248-270ff375c9aa","Alias":"الهيئة العامة للعقار: توثيق ما يقارب 60 ألف عقد \"إيجار\" تجاري","Path":"/e78cae08-e6c4-4ccf-b0be-477a4e80dd83.config","Level":4003,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e78cae08-e6c4-4ccf-b0be-477a4e80dd83.config","Node":{"Content":{"@Key":"e78cae08-e6c4-4ccf-b0be-477a4e80dd83","@Alias":"الهيئة العامة للعقار: توثيق ما يقارب 60 ألف عقد \"إيجار\" تجاري","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-02-13T09:14:09","NodeName":{"@Default":"الهيئة العامة للعقار: توثيق ما يقارب 60 ألف عقد \"إيجار\" تجاري"},"SortOrder":"3","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-02-12T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"0e8ae69f-9c74-4b0e-bc6a-b58f7f4be6d7\",\n    \"mediaKey\": \"b36c5d44-c850-40c3-a4bf-c1068c7722d6\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; text-indent: 9.0pt; direction: rtl; unicode-bidi: embed; margin: 12.0pt 0cm 12.0pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أعلنت الهيئة العامة للعقار عن توثيق \\\"إيجار\\\" 59,575 عقد إيجار تجاري عقاري خلال يناير 2024م، وبمعدل يومي يصل إلى ألفي عقد؛ كأعلى رقم لتوثيق العقود التجارية خلال شهرٍ واحد، ليصل إجمالي عقود الإيجار التجارية الموثّقة أكثر من 1.5 مليون عقد.</span></p>\\n<p style=\\\"text-align: justify; text-indent: 9.0pt; direction: rtl; unicode-bidi: embed; margin: 12.0pt 0cm 12.0pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت هيئة العقار أنّ العقود الإيجارية التجارية سجّلت ارتفاعًا يتجاوز </span><span>15</span><span>% خلال يناير الحالي مقارنة بيناير 2023، مضيفة أنّ الأرقام التي حقّقها \\\"إيجار\\\" جاءت نتيجة لارتفاع مستوى الموثوقية في قطاع الإيجار العقاري بشكل عام، وقطاع الإيجار التجاري والاستثماري بشكل خاص، واستيعاب \\\"إيجار\\\" لمتطلبات المرحلة الاقتصادية الجديدة التي تعيشها المملكة في استقطاب المشاريع التجارية الاستثمارية الكبرى، لتكون وجهة إقليمية رئيسة، حيث سجلت الوحدات العقارية التجارية بمختلف أنواعها نموًا ملحوظًا، سجّلت فيها الوحدات العقارية التجارية من نوع (المكاتب) ارتفاعًا تجاوز 26% خلال يناير&nbsp; 2024م، مقارنة بيناير العام الماضي 2023م بأكثر من 6600 مكتب مسجل في \\\"إيجار\\\" خلال شهرٍ واحد.</span></p>\\n<p style=\\\"text-align: justify; text-indent: 9.0pt; direction: rtl; unicode-bidi: embed; margin: 12.0pt 0cm 12.0pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأضافت الهيئة أنّ \\\"إيجار\\\" أتاحت مجالًا جديدًا لتوثيق عقود الإيجار للاستثمارات الحكومية في العقارات، بخطوة أولى بدأت فيها بتوثيق عقود أمانات المناطق، مضيفة إلى سعي \\\"إيجار\\\" لاستيعاب متطلبات قطاع الإيجار التجاري ومتغيراته، وتسجيل جميع عقود الإيجار التجارية بنوعيها الموحّدة وغير الموحّدة، بما يحفظ حقوق الأطراف ويحسن كفاءة التعاملات في قطاع الإيجار العقاري في المملكة، ويزيد الثقة في التعاملات المالية والتعاقدية، وييسر الإجراءات من خلال توفير خيارات متعددة لسداد الدفعات، وقنوات متنوعة لسدادها، إضافة إلى الخدمات النوعيّة الأخرى التي تقدمها \\\"إيجار\\\".</span></p>\\n<p style=\\\"text-align: justify; text-indent: 9.0pt; direction: rtl; unicode-bidi: embed; margin: 12.0pt 0cm 12.0pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الشبكة الإلكترونية لخدمات الإيجار \\\"إيجار\\\" تُقدم عدداً من المميزات لقطاع الإيجار التجاري، ومنها التكامل الرقمي مع الجهات في القطاعين الحكومي والخاص، مثل وزارة العدل، ووزارة الموارد البشرية والتنمية الاجتماعية، ووزارة التجارة، ووزارة الاستثمار، والربط مع منصة بلدي.</span></p>\\n<p style=\\\"text-align: justify; text-indent: 9.0pt; direction: rtl; unicode-bidi: embed; margin: 12.0pt 0cm 12.0pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">هذا ويوفر العقد التجاري في \\\"إيجار\\\" عددًا من المزايا المهمة للقطاع العقاري التجاري، مثل العقد المشروط، والمرونة في صياغة البنود والالتزامات، ومنح صلاحيات أكبر للمستأجر، وتسجيل عقود الإيجار التجارية بأثر رجعي، واحتساب القيمة المضافة، ومرونة الدفعات وتنوع آليات سدادها، وتنوع العقارات (المكاتب، والمعارض التجارية، والمحال، والأكشاك، والمستودعات) وغيرها، في خطوة استباقية، تهدف إلى استيعاب كافة العقود الإيجارية التجارية.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: توثيق ما يقارب 60 ألف عقد \"إيجار\" تجاري "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"b27def3c-eb6d-3b0d-847b-7781afad6ab1","Alias":"«هيئة العقار» توقع مذكرة تفاهم مع صندوق الاستثمارات العامة لتعزيز دور المملكة كمركز للتكنولوجيا العقارية","Path":"/e1dd3e99-ddd9-44a4-9a99-49b54f093e96.config","Level":4004,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e1dd3e99-ddd9-44a4-9a99-49b54f093e96.config","Node":{"Content":{"@Key":"e1dd3e99-ddd9-44a4-9a99-49b54f093e96","@Alias":"«هيئة العقار» توقع مذكرة تفاهم مع صندوق الاستثمارات العامة لتعزيز دور المملكة كمركز للتكنولوجيا العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-02-06T11:16:26","NodeName":{"@Default":"«هيئة العقار» توقع مذكرة تفاهم مع صندوق الاستثمارات العامة لتعزيز دور المملكة كمركز للتكنولوجيا العقارية"},"SortOrder":"4","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-02-06T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"93022b64-a0bf-4df3-936b-c2429f404dbe\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وقعت الهيئة العامة للعقار اليوم الثلاثاء 6 فبراير 2024م، مذكرة تفاهم مع صندوق الاستثمارات العامة تهدف لتمكين سوق العقارات في المملكة العربية السعودية، من خلال تعزيز دور التكنولوجيا العقارية والبيانات وتنمية المواهب والسياسات واللوائح التنظيمية، بما يُسهم في تطوير القطاع العقاري بالمملكة</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ووقع المذكرة من جانب الهيئة العامة للعقار الرئيس التنفيذي المهندس عبدالله بن سعود الحماد، فيما وقع من جانب صندوق الاستثمارات العامة رئيس الإدارة العامة للاستثمار العقاري الأستاذ أيمن المديفر</span><span>&nbsp;</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتتضمن مذكرة التفاهم تعزيز التكنولوجيا والابتكار من خلال تمكين أربعة مراكز رئيسية تسعى لوضع المملكة العربية السعودية كمركز للتكنولوجيا العقارية، وتتمثل المراكز الأربعة في \\\"مركز رأس المال\\\" الذي يهدف لتمكين القطاع عن طريق تحفيز المستثمرين من خلال رأس مال يركز على التكنولوجيا العقارية، فيما يعمل \\\"مركز الحلول\\\" على زيادة المعروض من حلول التكنولوجيا العقارية عبر الشركات بما فيه ذلك الشركات الناشئة والحاضنات</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ويسعى المركز الثالث \\\"مركز التبني\\\" إلى توليد الطلب على حلول التكنولوجيا العقارية من خلال شركات صندوق الاستثمارات للتطوير العقاري ومشاريع رؤية 2030 والقطاع الخاص، بينما يركز \\\"مركز التمكين\\\" على تسريع نمو قطاع التكنولوجيا العقارية في المملكة من خلال الممكنات كالمواهب والبحث ووسائل الإعلام</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتركز المذكرة على تنمية المواهب من خلال تعاون الطرفين على تعزيز تنمية رأس المال البشري في القطاع العقاري في المملكة، بتسهيل الوصول المتبادل وتوفير الفرص للمهنيين العقاريين المبتدئين ودورات المعهد العقاري للفئات المستهدفة</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضح \\\" الحماد\\\" أن التعاون مع صندوق الاستثمارات العامة يعد خطوة مهمة نحو تسريع تبني التقنيات العقارية، باعتباره أحد المحركات الرئيسة للاقتصاد والاستثمار في المملكة، من خلال ما يمتلكه من استراتيجية طموحة تقود النهضة التنموية للاقتصاد المحلي وتوطين التقنيات والمعرفة</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار إلى أن المذكرة تتضمن العديد من البنود التي تعزز دور القطاع من بينها التعاون على تحفيز نمو القطاع الخاص في القطاع العقاري من خلال تطوير الإطار التنظيمي اللازم لتقليل المخاطر وزيادة الثقة في السوق العقاري المحلي، فضلاً عن تحفيز الاستثمار الأجنبي المباشر في سوق العقارات في المملكة، من خلال جذب رواد السوق العقاري العالمي وزيادة جاذبية القطاع العقاري للشركات الصغيرة والمتوسطة المحلية والإقليمية لتحفيز التوطين وزيادة المحتوى المحلي</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يذكر أن الهيئة العامة للعقار مستمرة في تعزيز شراكاتها الاستراتيجية مع مختلف القطاعات بالمملكة، انطلاقا من أهدافها لتطوير السوق العقاري ورفع المعايير المهنية في القطاع العقاري بالمملكة</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"«هيئة العقار» توقع مذكرة تفاهم مع صندوق الاستثمارات العامة لتعزيز دور المملكة كمركز للتكنولوجيا العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"ede67410-eca1-3811-aceb-0e3a120d078e","Alias":"صور من ورشة عمل بناء المؤشرات العقارية","Path":"/6ac2a589-b52c-4360-aedc-f041f26e4881.config","Level":4004,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6ac2a589-b52c-4360-aedc-f041f26e4881.config","Node":{"Content":{"@Key":"6ac2a589-b52c-4360-aedc-f041f26e4881","@Alias":"صور من ورشة عمل بناء المؤشرات العقارية","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2023-11-23T16:58:09","NodeName":{"@Default":"صور من ورشة عمل بناء المؤشرات العقارية","Name":[{"@Culture":"ar-jo","#text":"صور من ورشة عمل بناء المؤشرات العقارية"},{"@Culture":"en-us","#text":"Event 4 (1)"}]},"SortOrder":"4","Published":{"@Default":"false","Published":[{"@Culture":"ar-jo","#text":"false"},{"@Culture":"en-us","#text":"false"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventsImages":{"Value":{"#cdata-section":""}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"17fb66b4-bc8a-3deb-bfdd-fdf13e9466c0","Alias":"الشيخ محمد بن عبدالله العياف","Path":"/dd1380f4-7f98-4501-98ff-6ad0c65fb59e.config","Level":4004,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/dd1380f4-7f98-4501-98ff-6ad0c65fb59e.config","Node":{"Content":{"@Key":"dd1380f4-7f98-4501-98ff-6ad0c65fb59e","@Alias":"الشيخ محمد بن عبدالله العياف","@Level":"4","Info":{"Parent":{"@Key":"1d910e48-371e-4392-8b05-a77b3939da64","#text":"مجلس الإدارة"},"Path":"////","Trashed":"false","ContentType":"director","CreateDate":"2024-03-12T22:35:08","NodeName":{"@Default":"الشيخ محمد بن عبدالله العياف","Name":[{"@Culture":"ar-jo","#text":"الشيخ محمد بن عبدالله العياف"},{"@Culture":"en-us","#text":"الشيخ محمد بن عبدالله العياف"}]},"SortOrder":"4","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":null},"Properties":{"directorName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الشيخ محمد بن عبدالله العياف"},{"@Culture":"en-us","#cdata-section":"الشيخ محمد بن عبدالله العياف "}]},"personalImage":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"77c4b67a-9276-4639-a375-ff6078001ed7\",\n    \"mediaKey\": \"e0a6bb89-8bbf-41c7-bee0-1e07192653c8\"\n  }\n]"}},"position":{"Value":[{"@Culture":"ar-jo","#cdata-section":"عضو مجلس الإدارة"},{"@Culture":"en-us","#cdata-section":"عضو مجلس إدارة "}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"e7fd3151-a7c3-3681-9e27-fa6df1ddb5b6","Alias":"الهيئة العامة للعقار وجامعة الفيصل توقعان مذكرة تفاهم لتعزيز التعاون وتطوير القدرات البشرية","Path":"/e89e1b61-0467-471b-96c6-1605ff7490ac.config","Level":4005,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e89e1b61-0467-471b-96c6-1605ff7490ac.config","Node":{"Content":{"@Key":"e89e1b61-0467-471b-96c6-1605ff7490ac","@Alias":"الهيئة العامة للعقار وجامعة الفيصل توقعان مذكرة تفاهم لتعزيز التعاون وتطوير القدرات البشرية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-02-04T06:50:52","NodeName":{"@Default":"الهيئة العامة للعقار وجامعة الفيصل توقعان مذكرة تفاهم لتعزيز التعاون وتطوير القدرات البشرية"},"SortOrder":"5","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-02-01T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"67f7ee75-0b1b-4295-b674-1c0281066874\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وقّعت الهيئة العامة للعقار&nbsp; مذكرة تفاهم مع جامعة الفيصل؛ تهدف لإنشاء إطارٍ لتطوير برامج متعلقة بالأنشطة العقارية وتطوير القدرات البشرية، وذلك ضمن جهود الهيئة الهادفة لرفع المعايير المهنية في القطاع العقاري بالمملكة</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ووقع المذكرة الرئيس التنفيذي للهيئة المهندس عبدالله بن سعود الحماد، ومعالي رئيس الجامعة الدكتور محمد بن علي آل هيازع</span><span>.<br></span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتركز المذكرة على تدعيم إدخال العلوم العقارية في التعليم عن طريق المقررات والمناهج ومشاريع التخرج والدراسات العليا، ومشاريع الأبحاث والنشر العلمي، بما يحقق تفعيل تطبيق هذه الأنشطة على أرض الواقع من قبل الخريجين عند التحاقهم بقطاع العمل سواءً العام أو الخاص</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما تهدف للإسهام في نشر المعرفة وزيادة الوعي العام بأنشطة وخدمات الهيئة العامة للعقار، والتنسيق مع الأجهزة الحكومية والمؤسسات في مجال البحوث والدراسات وتبادل المعلومات والخبرات، فضلاً عن الإسهام في إعداد وتنفيذ الدبلومات والبرامج المتخصصة في العلوم العقارية، إلى جانب التنسيق لعمل برامج بحثية مشتركة وتطوير المناهج الدراسية وبرامج التدريب والتوظيف وغيرها من المجالات ذات العلاقة</span><span style=\\\"font-family: 'Sakkal Majalla';\\\">.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضح الرئيس التنفيذي للهيئة العامة للعقار, أنّ التعاون مع جامعة الفيصل يأتي إيمانًا بدورها المهم بصفتها شريكًا معرفيًا يعمل على تزويد الدارسين بقواعد وأسس متينة من المهارات والمعرفة ترتكز على مناهج دراسية اُختيرت بعناية فائقة لتلبي احتياجات ومتطلبات المجتمع وسوق العمل</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشار إلى أنّ الهيئة العامة للعقار تعمل على تعزيز التعاون مع الجهات ذات الصلة، انطلاقًا من إستراتيجية واضحة تهدف لتطوير القطاع العقاري وتعزيز الثقة فيه، بما يتواكب مع تطلعات رؤية المملكة 2030</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">يُذكر أنّ الهيئة العامة للعقار تعمل من خلال ذراعها التعليمي المعهد العقاري السعودي على رفع المستوى المعرفي وتأهيل العاملين في السوق العقاري السعودي، للإلمام بأنظمة وتشريعات السوق العقاري السعودي وتطوير مهاراتهم الاحترافية من خلال التدريب والتأهيل</span><span>.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار وجامعة الفيصل توقعان مذكرة تفاهم لتعزيز التعاون وتطوير القدرات البشرية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"f12ea9de-4a02-3f1d-9f33-052dc9c6f329","Alias":"المهندس طارق بن عبدالله الشهيب","Path":"/75483659-047e-4cce-a426-8ac35e7a017f.config","Level":4005,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/75483