:[{"@Culture":"ar-jo","#text":"معرض مسكن العقاري"},{"@Culture":"en-us","#text":"معرض مسكن العقاري"}]},"SortOrder":"22","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-12-09T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-12-09T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>يضم المعرض الجهات العقارية بعرض عدد خيارات الوحدات المتنوعة وبوجود جهات التمويل حتى يتم التسهيل للمواطن السعودي اختيار المسكن المناسب وتسهيل عملية التملك وعرض منتجات وخدمات ومواصفات الشركات المشاركة.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>يضم المعرض الجهات العقارية بعرض عدد خيارات الوحدات المتنوعة وبوجود جهات التمويل حتى يتم التسهيل للمواطن السعودي اختيار المسكن المناسب وتسهيل عملية التملك وعرض منتجات وخدمات ومواصفات الشركات المشاركة.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض -  فندق الفورسيزنز"},{"@Culture":"en-us","#cdata-section":"الرياض -  فندق الفورسيزنز"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"35c2a2fb-bfaf-45e0-acf5-072ae584b6ba\",\n    \"mediaKey\": \"5a9cd342-7a40-4b6e-8ba5-fcff09e201aa\"\n  },\n  {\n    \"key\": \"ab48935e-a608-484f-a946-2205a7b05b01\",\n    \"mediaKey\": \"4d1ffad2-cc51-4560-87ae-0b5108d2bc3e\"\n  },\n  {\n    \"key\": \"a09f9eac-5217-4fbd-96c7-1db74fc262af\",\n    \"mediaKey\": \"7d69909b-732b-47dd-8f44-f7752324fbfc\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض مسكن العقاري"},{"@Culture":"en-us","#cdata-section":"معرض مسكن العقاري"}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":"حدث محلي"},{"@Culture":"en-us","#cdata-section":"Local event"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"معرض مسكن العقاري"},{"@Culture":"en-us","#cdata-section":"معرض مسكن العقاري"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2023-12-07T00:00:00"},{"@Culture":"en-us","#cdata-section":"2023-12-07T00:00:00"}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"a3441a07-ee42-3745-9033-871189b32c3a","Alias":"انعقاد القمة العالمية لقادة العقار مطلع ديسمبر المقبل","Path":"/9824a760-ed28-4073-8963-7c640176bc07.config","Level":4022,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/9824a760-ed28-4073-8963-7c640176bc07.config","Node":{"Content":{"@Key":"9824a760-ed28-4073-8963-7c640176bc07","@Alias":"انعقاد القمة العالمية لقادة العقار مطلع ديسمبر المقبل","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-12-21T11:48:26","NodeName":{"@Default":"انعقاد القمة العالمية لقادة العقار مطلع ديسمبر المقبل"},"SortOrder":"22","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-28T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"cdea269e-ecea-4a55-b015-f09cad1959e6\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تستضيف العاصمة الرياض القمة العالمية لقادة العقار<span>&nbsp;(GLS2023)&nbsp;</span>خلال الفترة 4 - 7 ديسمبر القادم، برعاية معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبد الله الحقيل، بحضور ومشاركة شخصيات عقارية بارزة وعدد من الرؤساء التنفيذيين لكبرى الشركات، وأعضاء الاتحاد الدولي للعقار، ومتحدثين دوليين يمثلون أكثر من 110 دول.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>وأوضح المتحدث الرسمي للهيئة تيسير المفرج، أن القمة العالمية لقادة العقار تشهد جلسات حوارية متخصصة ولقاءات متعددة في مجالات التسويق والابتكار والقيادة والإدارة العقارية ، مبيناً أنَّ القمة تتناول التحديات في صناعة العقار إلى جانب الفرص الاستثمارية المتاحة، فضلاً عن دور القيادات في ابتكار الأفكار الريادية عبر مناقشة أفضل الممارسات العالمية وآلية تطبيقها في المنطقة، والذكاء الاصطناعي، كما تم التنسيق مع جهات حكومية والخاصة لتنظيم عدة زيارات لضيوف القمة لأبرز المشاريع العقارية في المملكة.</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><br><span>مما يذكر أن الاتحاد العالمي للعقارات، يعد أكبر كيان عالمي في مجال منظومة العقار، وقد تم تأسيسه في عام 1951 في فرنسا، ويبلغ عدد أعضائه مليوناً و500 ألف عضو، من 70 دولة، حول العالم، ويتبنى الاتحاد منظومة شمولية تُعنى بالتكامل الشامل ما بين الاقتصادي والاجتماعي والتكامل مع الشق البيئي، فيما يخدم مسيرة التنمية المستدامة، ويعود بالمنفعة على كل المجتمعات التي يعمل الاتحاد على تنفيذ خططه فيها، كما يعمل الاتحاد على تطبيق نموذج متقدم لتطوير القطاع العقاري، وهو نموذج مستدام في تنافسية القطاع مثل تكنولوجيا العقار والفنتكوالبروبتك.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"انعقاد القمة العالمية لقادة العقار مطلع ديسمبر المقبل"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"53871a26-b22d-35ad-af4c-50e925559e45","Alias":"منتدى مستقبل العقار (1)","Path":"/e899740e-ac4b-49ef-bc96-7c0771df9d34.config","Level":4023,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e899740e-ac4b-49ef-bc96-7c0771df9d34.config","Node":{"Content":{"@Key":"e899740e-ac4b-49ef-bc96-7c0771df9d34","@Alias":"منتدى مستقبل العقار (1)","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2024-01-30T09:05:25","NodeName":{"@Default":"منتدى مستقبل العقار (1)","Name":[{"@Culture":"ar-jo","#text":"منتدى مستقبل العقار (1)"},{"@Culture":"en-us","#text":"منتدى مستقبل العقار (1)"}]},"SortOrder":"23","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"ترعى هيئة العقار أعمال منتدى مستقبل العقار لمناقشة أبرز التطورات في القطاع العقاري بعد عامٍ استثنائي شهد فيه القطاع العديد من التشريعات التي تهدف إلى تعزيز كفاءته واستدامته"},{"@Culture":"en-us","#cdata-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":"2024-01-24T00:00:00"},{"@Culture":"en-us","#cdata-section":"2024-01-24T00:00:00"}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>ترعى هيئة العقار أعمال منتدى مستقبل العقار&nbsp;لمناقشة أبرز التطورات في <a dir=\\\"rtl\\\" href=\\\"https://twitter.com/hashtag/%D8%A7%D9%84%D9%82%D8%B7%D8%A7%D8%B9_%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A?src=hashtag_click\\\" class=\\\"css-1qaijid r-bcqeeo r-qvutc0 r-1k78y06 r-1vmecro r-1loqt21\\\">ا</a>لقطاع العقاري بعد عامٍ استثنائي شهد فيه القطاع العديد من التشريعات التي تهدف إلى تعزيز كفاءته واستدامته.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>ترعى هيئة العقار أعمال منتدى مستقبل العقار&nbsp;لمناقشة أبرز التطورات في <a dir=\\\"rtl\\\" href=\\\"https://twitter.com/hashtag/%D8%A7%D9%84%D9%82%D8%B7%D8%A7%D8%B9_%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A?src=hashtag_click\\\" class=\\\"css-1qaijid r-bcqeeo r-qvutc0 r-1k78y06 r-1vmecro r-1loqt21\\\">ا</a>لقطاع العقاري بعد عامٍ استثنائي شهد فيه القطاع العديد من التشريعات التي تهدف إلى تعزيز كفاءته واستدامته.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الرياض - فندق الفورسيزون"},{"@Culture":"en-us","#cdata-section":"الرياض - فندق الفورسيزون"}]},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"f283f0f8-0310-4ddd-ab72-6833e1cee367\",\n    \"mediaKey\": \"edbe4dd1-d2ed-4fad-b939-b361711c91f1\"\n  },\n  {\n    \"key\": \"4d63f6cd-9adf-4c52-8201-7c4590986375\",\n    \"mediaKey\": \"13655ce1-7cd3-4130-b193-9095534b0737\"\n  },\n  {\n    \"key\": \"8cffd8fd-4b57-4e10-a477-46205435fd8c\",\n    \"mediaKey\": \"65632915-8c9f-4241-a272-86e504df9abe\"\n  },\n  {\n    \"key\": \"ee297e94-63cf-4e7e-a871-5a75726032dc\",\n    \"mediaKey\": \"904f6799-cafa-4ea3-8bea-3487cbe5f1b5\"\n  }\n]"}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-se