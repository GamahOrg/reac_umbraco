Content/9ba9c31f-1a20-4991-b82f-366f6757f12f.config","Node":{"Content":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","@Alias":"مركز بروتيك السعودية","@Level":"3","Info":{"Parent":{"@Key":"57e2ffd7-7ded-4321-be03-902bb2436ac8","#text":"مركز بروتيك السعودية"},"Path":"///","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-26T15:35:45","NodeName":{"@Default":"مركز بروتيك السعودية"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p><img style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"\\\" alt=\\\"\\\" width=\\\"279\\\" height=\\\"128\\\" data-udi=\\\"umb://media/803b9f26f2de429893517e77b49fcb89\\\"></p>\\n<p>&nbsp;</p>\\n<p>إسهاماً من الهيئة العامة للعقار وإيمانًا منها بدور التقنية في القطاع العقاري وما تمثله من آفاق مستقبلية تسهم في تحقيق مستهدفات رؤية السعودية<span>&nbsp; ٢٠٣٠ التي دعت إلى ضرورة التحول الرقمي ومواصلة توسيع نطاق الخدمات الرقمية، ولما تحظى به التقنيات العقارية \\\"</span>البروبتك\\\" من تمكين كونها تمثل جزءً لا يتجزأ من الحراك التقني والتحول الرقمي الذي<span>&nbsp; تشهده مختلف القطاع الحيوية والاقتصادية بالسعودية </span>، فقد سعت الهيئة لخلق بيئة حاضنة للتقنية العقارية ومجتمع يضم التقنيين العقاريين من خلال إنشاء مركز متكامل لخدمة المهتمين والمتخصصين بالمجال ، مما يسهم في بناء فرص للتواصل مع الجهات المحلية والعالمية، وربط الشركات التقنية ورواد الأعمال بالمستثمرين وأصحاب رؤوس الأموال ، إضافةً إلى تبادل المعرفة وتعزيز الابتكار وتطوير التقنيات العقارية للوصول إلى مستهدفات الاستراتيجية الشاملة للقطاع العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\",\n      \"title\": \"التعريف بالمركز :\",\n      \"content\": {\n        \"markup\": \"<p>مركز بروتيك السعودية مجتمع متكامل لخدمة المهتمين والمتخصصين بالتقنية العقارية محليًا وعالميًا ، ويقدم العديد من الخدمات التي تسهم في تمكين أصحاب العلاقة بما يسهم في تطوير<span>&nbsp; القطاع وتعزيز </span>نموه ورفع كفاءته.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\",\n      \"title\": \"المستفيدون :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li>\\n<p>رواد الأعمال <span>&nbsp;وأصحاب </span>المنشآت الناشئة</p>\\n</li>\\n<li>\\n<p>الشركات المحلية</p>\\n</li>\\n<li>الشركات العالمية</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\",\n      \"title\": \"المبادرات التابعة للمركز:\",\n      \"content\": \"\",\n      \"listOfSubcontent\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/19e5b30a0ac94e6a928590206a37294a\"\n            },\n            {\n              \"contentUdi\": \"umb://element/d625b07075144966b8a697edc2f4d21e\"\n            },\n            {\n              \"contentUdi\": \"umb://element/cc73c50281194e0784500396a04e51e3\"\n            },\n            {\n              \"contentUdi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\",\n            \"title\": \"القمة العالمية للتقنية العقارية\",\n            \"content\": {\n              \"markup\": \"<p>تعزيز مكانة المملكة العربية السعودية في مجال التقنية العقارية وجذب الشركات والخبراء البارزين في هذا المجال.</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/c3395462683542fd8c1378dd0fd2a0db\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/cc73c50281194e0784500396a04e51e3\",\n            \"title\": \"مجلس بروبتيك\",\n            \"content\": {\n              \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطاع التقنية العقارية لتبادل المعرفة والخبرات</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/6bb3663f174746c0b49bc57485392f66\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/19e5b30a0ac94e6a928590206a37294a\",\n            \"title\": \"البيئة التنظيمية التجريبية\",\n            \"content\": {\n              \"markup\": \"<p>إجراء التجارب للتقنيات والمنتجات والخدمات واختبار توافقها مع الأنظمة والتشريعات الحالية أو اقتراح تعديلات عليها ، ويكون ذلك عبر بيئة واقعية<span>&nbsp; </span>و مرنة تختبر فاعلية التقنيات ونماذج الأعمال المبتكرة التي لها صلة بالتقنية العقارية</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/36652cc6eff74f20be3816b554f1146c\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/d625b07075144966b8a697edc2f4d21e\",\n            \"title\": \"مسرعة الاعمال\",\n            \"content\": {\n              \"markup\": \"<p>برنامج متقدم يركز على تسريع نمو وتوسع الشركات الريادية والناشئة في مجال التقنية العقارية</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/a7565298ce4b4bba924efc1dfb9d1411\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          }\n        ],\n        \"settingsData\": []\n      },\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"مركز بروتيك السعودية"}},"pageTitle":{"Value":{"#cdata-section":"مركز بروتيك السعودية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":"مركز بروتيك السعودية"}}}}},"IsRoot":true},{"Key":"205f6acd-d6da-3b6d-9fe9-788734ad3979","Alias":"الأخبار","Path":"/2ce40610-a6fb-49dd-9eb1-2a576fd33d03.config","Level":3000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/2ce40610-a6fb-49dd-9eb1-2a576fd33d03.config","Node":{"Content":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","@Alias":"الأخبار","@Level":"3","Info":{"Parent":{"@Key":"20152095-8ca8-4f4a-b577-3a3a2c5d0083","#text":"media-center"},"Path":"//mediaCenter/","Trashed":"false","ContentType":"news","CreateDate":"2023-08-14T11:25:34","NodeName":{"@Default":"الأخبار","Name":[{"@Culture":"ar-jo","#text":"الأخبار"},{"@Culture":"en-us","#text":"News"}]},"SortOrder":"0","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"5f8459fd-a6f5-4f65-8cc6-92c58c5d020c","#text":"News"}},"Properties":{"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"أخر أخبار الهيئة العامة للعقار"},{"@Culture":"en-us","#cdata-section":"The lastest news of REGA"}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"اخبار\",\n  \"news\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأخبار"},{"@Culture":"en-us","#cdata-section":"News"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأخبار والإعلانات"},{"@Culture":"en-us","#cdata-section":"News & Announcements"}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأخبار"},{"@Culture":"en-us","#cdata-section":"News"}]}}}},"IsRoot":true},{"Key":"8342c9ff-181c-3af3-ac7c-090d2dc2354a","Alias":"المساهمات العقارية","Path":"/6f151a00-b225-4f24-895f-6f58571a2667.config","Level":3000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6f151a00-b225-4f24-895f-6f58571a2667.config","Node":{"Content":{"@Key":"6f151a00-b225-4f24-895f-6f58571a2667","@Alias":"المساهمات العقارية","@Level":"3","Info":{"Parent":{"@Key":"75795868-cfb0-4021-a108-d26b070a39a4","#text":"الخدمات الإلكترونية"},"Path":"///","Trashed":"false","ContentType":"service","CreateDate":"2024-02-14T12:55:27","NodeName":{"@Default":"المساهمات العقارية","Name":[{"@Culture":"ar-jo","#text":"المساهمات العقارية"},{"@Culture":"en-us","#text":"Real Estate Contributions"}]},"SortOrder":"0","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":{"@Key":"1c13c3d5-3008-4d88-a473-f63eb161685d","#text":"ServicesDetails"}},"Properties":{"buttonText":{"Value":[{"@Culture":"ar-jo","#cdata-section":"بدء الخدمة"},{"@Culture":"en-us","#cdata-section":"Go To Service"}]},"description":{"Value":[{"@Culture":"ar-jo","#cdata-section":"منصة المساهمات العقارية هي المنصة الإلكترونية الرسمية لتلقي طلبات إصدار التراخيص اللازمة لممارسة نشاط المساهمات العقارية وتعديلها وإلغائها، واستقبال طلبات تأهيل وتصنيف المطورين العقاريين"},{"@Culture":"en-us","#cdata-section":"The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically."}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"المساهمات\",\n  \"العقارية\",\n  \"المساهمات العقارية\",\n  \"Rega\",\n  \"الخدمات الالكترونية\",\n  \"تراخيص\",\n  \"مساهمات\"\n]"}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المساهمات العقارية"},{"@Culture":"en-us","#cdata-section":"Real Estate Contributions"}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":"المساهمات العقارية "},{"@Culture":"en-us","#cdata-section":"Real Estate Contributions"}]},"serviceBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: center; line-height: 95%; direction: rtl; unicode-bidi: embed; margin: 12.0pt 0cm 12.0pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">منصة المساهمات العقارية هي المنصة الإلكترونية الرسمية لتلقي طلبات إصدار التراخيص اللازمة لممارسة نشاط المساهمات العقارية وتعديلها وإلغائها، واستقبال طلبات تأهيل وتصنيف المطورين العقاريين، وإتمام كافة إجراءات الترخيص والتأهيل بشكل إلكتروني.</p>\\n<p style=\\\"text-align: center; line-height: 95%; direction: rtl; unicode-bidi: embed; margin: 12.0pt 0cm 12.0pt 0cm;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"serviceFeature":{"Value":[{"@Culture":"ar-jo","#cdata-section":"[\n  {\n    \"key\": \"000c4341-21eb-4ddc-aa31-662766fc9b42\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">منصة المساهمات العقارية هي المنصة الإلكترونية الرسمية لتلقي طلبات إصدار التراخيص اللازمة لممارسة نشاط المساهمات العقارية وتعديلها وإلغائها، واستقبال طلبات تأهيل وتصنيف المطورين العقاريين، وإتمام كافة إجراءات الترخيص والتأهيل بشكل إلكتروني.</p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/media/kwrbhkn2/نظام-المساهمات-العقارية.pdf#https://rega.gov.sa/media/kwrbhkn2/نظام-المساهمات-العقارية.pdf\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"https://rega.gov.sa/media/kwrbhkn2/نظام-المساهمات-العقارية.pdf\\\\\\\" data-anchor=\\\\\\\"#https://rega.gov.sa/media/kwrbhkn2/نظام-المساهمات-العقارية.pdf\\\\\\\">نظام المساهمات العقارية </a></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/d1a990f293224fb893216d0576c151e9}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"Mosahamat\\\\\\\">اللائحة التنفيذية لنظام المساهمات العقارية</a></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/media/snnhcgct/ضوابط-حساب-الضمان-للمساهمات-العقارية.pdf#https://rega.gov.sa/media/snnhcgct/ضوابط-حساب-الضمان-للمساهمات-العقارية.pdf\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"https://rega.gov.sa/media/snnhcgct/ضوابط-حساب-الضمان-للمساهمات-العقارية.pdf\\\\\\\" data-anchor=\\\\\\\"#https://rega.gov.sa/media/snnhcgct/ضوابط-حساب-الضمان-للمساهمات-العقارية.pdf\\\\\\\">ضوابط حساب الضمان للمساهمين العقاريين</a></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/media/i3upagav/تعليمات-طرح-شهادات-المساهمات-العقارية.pdf#https://rega.gov.sa/media/i3upagav/تعليمات-طرح-شهادات-المساهمات-العقارية.pdf\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"https://rega.gov.sa/media/i3upagav/تعليمات-طرح-شهادات-المساهمات-العقارية.pdf\\\\\\\" data-anchor=\\\\\\\"#https://rega.gov.sa/media/i3upagav/تعليمات-طرح-شهادات-المساهمات-العقارية.pdf\\\\\\\">تعليمات طرح شهادات المساهمات العقارية</a></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/media/5lrntbnx/instructions-on-the-offering-of-real-estate-contrbutions-certificates.pdf#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf#https://rega.gov.sa/media/5lrntbnx/instructions-on-the-offering-of-real-estate-contrbutions-certificates.pdf#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"https://rega.gov.sa/media/5lrntbnx/instructions-on-the-offering-of-real-estate-contrbutions-certificates.pdf#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf\\\\\\\" data-anchor=\\\\\\\"#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf#https://rega.gov.sa/media/5lrntbnx/instructions-on-the-offering-of-real-estate-contrbutions-certificates.pdf#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf\\\\\\\">Instructions on the Offering of Real Estate Contributions Certificates</a></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a href=\\\\\\\"/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf#https://rega.gov.sa/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\" title=\\\\\\\"https://rega.gov.sa/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\" data-anchor=\\\\\\\"#https://rega.gov.sa/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\">الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"},{"@Culture":"en-us","#cdata-section":"[\n  {\n    \"key\": \"03e13ec8-3ab0-43fb-aaa7-d6348a181249\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically.</p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a href=\\\\\\\"/{localLink:umb://media/d1a990f293224fb893216d0576c151e9}\\\\\\\" title=\\\\\\\"Mosahamat\\\\\\\">Real Estate Contributions Regulations</a><br><a href=\\\\\\\"/{localLink:umb://media/18e069691e154040a9941f4395c47d47}\\\\\\\" title=\\\\\\\"تعليمات طرح شهادات المساهمات العقارية\\\\\\\">Executive Regulations of the Real Estate Contributions System</a><br><a href=\\\\\\\"/{localLink:umb://media/18615bbd6b53432a873add1f1f10eb2c}\\\\\\\" title=\\\\\\\"ضوابط حساب الضمان للمساهمات العقارية\\\\\\\">Guidelines for the Real Estate Contributors' Guarantee Account</a><br><a href=\\\\\\\"/{localLink:umb://media/85d9e3d439b74a84864e2f0c8dcfae31}\\\\\\\" title=\\\\\\\"Instructions On The Offering Of Real Estate Contrbutions Certificates\\\\\\\">Instructions for Issuing Real Estate Contribution Certificates</a></p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]"}]},"serviceIcon":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"092af7af-2754-40aa-92a6-b9f817500543\",\n    \"mediaKey\": \"e8b422d4-a68e-492f-a0f3-56b419b04c92\"\n  }\n]"}},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":"{\n  \"markup\": \"<p>The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}]},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"support":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/413e84227656477899757fa9fd9ed3c9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ea4390a2a49442c0a9aed4e3e9349b29\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\",\n      \"udi\": \"umb://element/ea4390a2a49442c0a9aed4e3e9349b29\",\n      \"title\": \"\",\n      \"items\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/f99894c133f548319c82482ad434bcc1\"\n            },\n     