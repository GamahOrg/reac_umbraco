-section":""}]},"endDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventLocation":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventsImages":{"Value":{"#cdata-section":""}},"eventTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"eventType":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"pageTitle":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"shortBrief":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"socialMediaImage":{"Value":{"#cdata-section":""}},"startDate":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"targetAudience":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]},"title":{"Value":[{"@Culture":"ar-jo","#cdata-section":""},{"@Culture":"en-us","#cdata-section":""}]}}}},"IsRoot":true},{"Key":"c2972076-021f-3fbd-9eb4-3631ac1de4f4","Alias":"الهيئة العامة للعقار بالتعاون مع الهيئة الملكية لمدينة مكة المكرمة والمشاعر المقدسة وأمانة العاصمة المقدسة تعلن بدء أعمال \"السجل العقاري\" في مكة المكرمة","Path":"/7d0587b0-c59e-42cc-b47c-20f6df28096e.config","Level":4007,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/7d0587b0-c59e-42cc-b47c-20f6df28096e.config","Node":{"Content":{"@Key":"7d0587b0-c59e-42cc-b47c-20f6df28096e","@Alias":"الهيئة العامة للعقار بالتعاون مع الهيئة الملكية لمدينة مكة المكرمة والمشاعر المقدسة وأمانة العاصمة المقدسة تعلن بدء أعمال \"السجل العقاري\" في مكة المكرمة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-01-16T12:48:38","NodeName":{"@Default":"الهيئة العامة للعقار بالتعاون مع الهيئة الملكية لمدينة مكة المكرمة والمشاعر المقدسة وأمانة العاصمة المقدسة تعلن بدء أعمال \"السجل العقاري\" في مكة المكرمة"},"SortOrder":"7","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-01-16T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"52631c3d-3728-494b-a59f-a1b89d49f422\",\n    \"mediaKey\": \"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span lang=\\\"AR-SA\\\">بحضور صاحب السمو الملكي الأمير سعود بن مشعل بن عبد العزيز آل سعود، نائب أمير منطقة مكة المكرمة، الهيئة العامة للعقار بالتعاون مع الهيئة الملكية لمدينة مكة المكرمة والمشاعر المقدسة وأمانة العاصمة المقدسة عن بدء أعمال \\\"السجل العقاري\\\" في منطقة مكة المكرمة، حيث تم تنسيقها لتقسيمها إلى مناطق عقارية تتضمن كل مجموعة من المناطق الحيوية، وسيتم الإعلان عن الأجزاء الجديدة التي سيسجلها العقارات بشكل أفضل خلال الفترة القادمة، وذلك حسب بناء عملية عملية لذلك بالتنسيق مع الهيئات الحكومية ذات الصلة، حيث يتم اختيار المناطق العقارية بشكل جيد معايير جهوزية ونضج البيانات الجيومكانية للأراضي والوحدات العقارية، وهي استمرارية في أن يتم تغطية مدينة مكة المكرمة وجميع المدن ومحافظات المملكة</span><span>.</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span><br></span><span lang=\\\"AR-SA\\\">أنشأت \\\"هيئة العقار\\\" ذلك نظام التسجيل العيني للعقارات بقرار مجلس الوزراء يهدف إلى زيادة موثوقية التملك، خدمات معلومات مؤكدة عن العقار، حفظ حقوق المتعاملين في السجل العقاري، جاذبية الاستثمارية للقطاع، وبموجب النظام سيتم إنشاء سجل عقاري يشمل جميع المعلومات وبيانات الوحدات العقارية ،، الزراعية، الصناعية وغيرها، إضافة إلى العقارات الحكومية على مستوى المملكة، حيث سيصدر لكل وحدة عقارية أيًا كانت \\\"رقم عقار\\\" ولك تسجيل ملكية كصحيفة عقارية تتضمن بيانات وأوصاف الملكية وحالته وما يمتلكه من حقوق والتزامات وتصرف التصرفات العقارية التي تطرأ عليها علاقة بالمعلومات الجيومكانية من خلال الصندوق المساحية والحداثيات الجغرافية الدقيقة للعقارات، كونها مؤسسة تسجيل ملكية وحقوق ملكية عقارية بما في ذلك المساهمة في استدامة السائل العقاري والممكنات الرئيسية له </span><span>.&nbsp;</span></p>\\n<p style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><span><br>&nbsp;</span><span lang=\\\"AR-SA\\\">اعتراف \\\"هيئة العقار\\\" بموجب التسجيل الأول للعقارات ستكون مُتاحًا بشكل مجاني عن طريق <a rel=\\\"noopener\\\" href=\\\"https://rer.sa/rer-services-ar/\\\" target=\\\"_blank\\\" title=\\\"منصة السجل العقاري العقاري\\\">منصة السجل العقاري الإلكتروني</a></span><span> ، مُبينةً تلك التي تشترط التسجيل العيني بوجود صك إلكتروني مُحدَّث صادر من وزارة العدل مكتمل مستوفٍ لشروط البيانات الملكية وهي سارية ووكالة في حال كان مقدم طلب وكيل، وسيشمل كافة العقارات السكنية والتجارية والزراعية والكومية </span><span>.</span><span> </span><span></span><span></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار بالتعاون مع الهيئة الملكية لمدينة مكة المكرمة والمشاعر المقدسة وأمانة العاصمة المقدسة تعلن بدء أعمال \"السجل العقاري\" في مكة المكرمة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d61b2faa-1263-32e6-80d5-b49a371462c1","Alias":"الهيئة العامة للعقار: \"نظام بيع وتأجير مشروعات على الخارطة\" يحد من المخالفات ويراقب الوفاء بالمتطلبات الهندسية والمحاسبية","Path":"/3732d6f8-2d36-45aa-a533-bed1735dcedd.config","Level":4008,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/3732d6f8-2d36-45aa-a533-bed1735dcedd.config","Node":{"Content":{"@Key":"3732d6f8-2d36-45aa-a533-bed1735dcedd","@Alias":"الهيئة العامة للعقار: \"نظام بيع وتأجير مشروعات على الخارطة\" يحد من المخالفات ويراقب الوفاء بالمتطلبات الهندسية والمحاسبية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2024-01-08T15:00:31","NodeName":{"@Default":"الهيئة العامة للعقار: \"نظام بيع وتأجير مشروعات على الخارطة\" يحد من المخالفات ويراقب الوفاء بالمتطلبات الهندسية والمحاسبية"},"SortOrder":"8","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":"umb://media/de2bcbe1ebae4854a302b2bcb02bd7f6"}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2024-01-08T00:00:00"}},"newsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ea597d4f-e4c2-4228-b933-25f8a9de43d2\",\n    \"mediaKey\": \"5354d32d-bfef-4cde-9396-8318e9a066c0\"\n  }\n]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"margin-bottom: .0001pt; text-align: justify; line-height: normal; text-autospace: none; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xmsonormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">أكدتْ الهيئة العامة للعقار أنَّ نظام \\\"بيع وتأجير مشروعات عقارية على الخارطة \\\"&nbsp;&nbsp; يهدف إلى تنظيم نشاط بيع وتأجير مشروعات عقارية على الخارطة و رفع مستوى الشفافية والإفصاح بما يضمن حماية حقوق جميع أطراف العلاقة التعاقدية كما يهدف من خلال تطبيقه إلى الحد من المخالفات في قطاع التطوير العقاري على الخارطة ، ويساهم مع منظومة التشريعات العقارية إلى رفع ثقة المستثمرين في القطاع العقاري في المملكة ، وأضافت ؛ بأن النظام الجديد سيكون نافذًا&nbsp; ابتداءً من&nbsp; 25 رمضان 1445هـ الموافق 4 أبريل 2024 م ، وسيتم نشر لائحته التنفيذية خلال الفترة القادمة .</span></p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; line-height: normal; text-autospace: none; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xmsonormal\\\">&nbsp;</p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; line-height: normal; text-autospace: none; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xmsonormal\\\"><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحتْ الهيئة بأنَّ النظام - والذي تم نشره مؤخرًا في صحيفة أم القرى - &nbsp;يحتوي على ثلاثين مادة تضمنتْ التعريفات والأحكام العامة وإلزامية التراخيص والقيد واختصاصات الجهة المختصة واشتراطات الإعلان عن أي مشروع تطوير وحدات عقارية على الخارطة أو تسويقها كما اشتمل على شروط قيد الشخص الطبيعي في سجل المطورين وآلية وضوابط حساب الضمان والصرف منه ، والمصاريف الإدارية والتسويقية والفائض عن التكلفة الفعلية الإجمالية وضمانات إنشاءات المشروع والقوائم المالية له ، وآلية فرز الوحدات والتصرُّف فيها ،&nbsp; كما اشتمل على تحديد مسئولي تصنيف و ضبط مخالفات أحكام النظام ولجنة الفصل فيها&nbsp; ومنْ يتوجب عليه الإبلاغ عن المخالفات لأحكام النظام ،&nbsp; وآلية الإحالة إلى الجهات المختصة ، والإفصاح والرقابة والتدابير اللازمة للمشاريع المتعثرة.</span></p>\\n<p style=\\\"margin-bottom: .0001pt; text-align: justify; line-height: normal; text-autospace: none; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"xmsonormal\\\">&nbsp;</p>\\n<p><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\\\" lang=\\\"AR-SA\\\">وذكرتْ الهيئة على أنَّ النظام يُتيح تأهيل وتسجيل المطورين العقاريين لمزاولة النشاط و الرقابة والتفتيش على كافة أعمال قطاع البيع والتأجير على الخارطة، بالإضافة لمراقبة الملاءة المالية للمطورين في حدود تنفيذهم لمشاريع النشاط،&nbsp; ومراقبة استمرار الوفاء بمتطلبات الترخيص وإلزام المطورين بتوفيرها، كما تقوم الهيئة بأعمال الإشراف على الاستشاريين من الهندسيين والمحاسبين القانونيين وأمناء الحساب في تنفيذ واجباتهم التعاقدية من خلال تعيين المفتشين الفنيين هندسيًا ومحاسبيًا وغيرهم للتحري عن أي اشتباه في مخالفة النظام واللائحة ، وأتاحتْ الهيئة للجميع الاطلاع على النظام من خلال الموقع الإلكتروني للهيئة &nbsp;</span></p>\\n<p><span style=\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;\\\" lang=\\\"AR-SA\\\"><a href=\\\"/media/l0thhdou/نظام-بيع-وتا-جير-مشروعات-على-الخارطة.pdf#https://rega.gov.sa/media/l0thhdou/نظام-بيع-وتا-جير-مشروعات-على-الخارطة.pdf\\\" title=\\\"https://rega.gov.sa/media/l0thhdou/نظام-بيع-وتا-جير-مشروعات-على-الخارطة.pdf\\\" data-anchor=\\\"#https://rega.gov.sa/media/l0thhdou/نظام-بيع-وتا-جير-مشروعات-على-الخارطة.pdf\\\">https://rega.gov.sa/media/l0thhdou/نظام-بيع-وتا-جير-مشروعات-على-الخارطة.pdf</a></span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: \"نظام بيع وتأجير مشروعات على الخارطة\" يحد من المخالفات ويراقب الوفاء بالمتطلبات الهندسية والمحاسبية"}},"pageName":{"Value":{"#cdata-section":"الهيئة العامة للعقار: \"نظام بيع وتأجير مشروعات على الخارطة\" يحد من المخالفات ويراقب الوفاء بالمتطلبات الهندسية والمحاسبية"}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار: \"نظام بيع وتأجير مشروعات على الخارطة\" يحد من المخالفات ويراقب الوفاء بالمتطلبات الهندسية والمحاسبية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/de2bcbe1ebae4854a302b2bcb02bd7f6"}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"be85c1ce-aacf-3792-8a86-3ae3d2fcac44","Alias":"الأستاذ هاني بن عبدالله أبو النجا","Path":"/32e168b6-b0c3-4cbd-aeca-a0f3b6c7c0b8.config","Level":4008,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/32e168b6-b0c3-4cbd-aeca-a0f3b6c7c0b8.config","Node":{"Content":{"@Key":"32e168b6-b0c3-4cbd-aeca-a0f3b6c7c0b8","@Alias":"الأستاذ هاني بن عبدالله أبو النجا","@Level":"4","Info":{"Parent":{"@Key":"1d910e48-371e-4392-8b05-a77b3939da64","#text":"مجلس الإدارة"},"Path":"////","Trashed":"false","ContentType":"director","CreateDate":"2024-03-12T22:45:34","NodeName":{"@Default":"الأستاذ هاني بن عبدالله أبو النجا","Name":[{"@Culture":"ar-jo","#text":"الأستاذ هاني بن عبدالله أبو النجا"},{"@Culture":"en-us","#text":"الأستاذ هاني بن عبدالله أبو النجا"}]},"SortOrder":"8","Published":{"@Default":"true","Published":[{"@Culture":"ar-jo","#text":"true"},{"@Culture":"en-us","#text":"true"}]},"Schedule":null,"Template":null},"Properties":{"directorName":{"Value":[{"@Culture":"ar-jo","#cdata-section":"الأستاذ هاني بن عبدالله أبو النجا"},{"@Culture":"en-us","#cdata-section":"الأستاذ هاني بن عبدالله أبو النجا"}]},"personalImage":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"ea2285e0-dc67-4585-a3b6-c012f72f6274\",\n    \"mediaKey\": \"e30b0097-9c04-4d3e-9b45-a34b8e2e352d\"\n  }\n]"}},"position":{"Value":[{"@Culture":"ar-jo"