},"shortBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>&nbsp;الهيئة العامة للعقار راعي رئيسي في مؤتمر تجربة العميل، و يشارك المتحدث الرسمي&nbsp; بجلسة حوارية للحديث حول جهود الجهات الحكومية لتحقيق مستهدفاتها في تجربة المستفيد&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/9d59954086224c919453967f2465bc4d"}},"startDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-07-09T00:00:00"}},"targetAudience":{"Value":{"@Culture":"ar-jo","#cdata-section":"أصحاب الاختصاص"}},"title":{"Value":{"@Culture":"ar-jo","#cdata-section":"مؤتمر E3"}}}}},"IsRoot":true},{"Key":"8f339513-18b4-3c52-bdc8-f8f1bfe11ec1","Alias":"\"الهيئة العامة للعقار\" و \" مكاتفة \" يُوقعان اتفاقية تعاون مشتركة لرفع الوعي وتطوير الإجراءات ","Path":"/e1d66805-1f13-4c91-a5ec-80cb618f2eb0.config","Level":4029,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/e1d66805-1f13-4c91-a5ec-80cb618f2eb0.config","Node":{"Content":{"@Key":"e1d66805-1f13-4c91-a5ec-80cb618f2eb0","@Alias":"\"الهيئة العامة للعقار\" و \" مكاتفة \" يُوقعان اتفاقية تعاون مشتركة لرفع الوعي وتطوير الإجراءات ","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":"\"الهيئة العامة للعقار\" و \" مكاتفة \" يُوقعان اتفاقية تعاون مشتركة لرفع الوعي وتطوير الإجراءات "},"SortOrder":"29","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-06T13:40:11"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">برعاية معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة العامة للعقار وقّعت \"الهيئة \" و \" شركة مكاتفة للخدمات التجارية\" اليوم الإثنين 6 نوفمبر 2023 م اتفاقية تعاون مشترك بحضور المهندس عبد الله بن سعود الحمَّاد الرئيس التنفيذي للهيئة العامة للعقار، وسمو الأمير وليد بن ناصر آل سعود الرئيس التنفيذي لشركة مكاتفة للخدمات التجارية.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وتهدف اتفاقية التعاون إلى عقد ورش عمل مع الجهات المستفيدة من التشريعات العقارية للتوعية بالأنظمة العقارية وتمكين المشاريع العقارية في أنشطة إدارة الأملاك وإدارة المرافق من تطوير إجراءاتها بما يتواكب مع التوجهات الحديثة للسوق العقاري ، والتعاون لتحقيق المبادرات والأولويات التي تضمنتها الاستراتيجية الشاملة للقطاع العقاري.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-right: .2pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وجرى توقيع اتفاقية التعاون خلال مؤتمر \"بروبتك السعودية\" والذي تنظمه هيئة العقار بنسخته الأولى في العاصمة الرياض<span style=\"mso-spacerun: yes;\">&nbsp; </span>.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">وتأتي اتفاقية التعاون في إطار الشراكات النوعية التي تقوم بها الهيئة العامة للعقار مع القطاعات الحكومية والقطاع الخاص؛ لتفعيل دور الهيئة في الإشراف على القطاع العقاري غير الحكومي، لرفع موثوقيته وتعزيز جاذبيته، وتحقيق ركائز الاستراتيجية الشاملة للقطاع العقاري</span><span dir=\"LTR\" style=\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\">.</span></p>"}},"newsTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" و \" مكاتفة \" يُوقعان اتفاقية تعاون مشتركة لرفع الوعي وتطوير الإجراءات "}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"\"الهيئة العامة للعقار\" و \" مكاتفة \" يُوقعان اتفاقية تعاون مشتركة لرفع الوعي وتطوير الإجراءات "}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d02bc671-5659-3c03-b470-456d51eaaf40","Alias":"مؤتمر leap24","Path":"/85b5184b-4ac0-4981-bfb5-f6eb3fd69ab3.config","Level":4030,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/85b5184b-4ac0-4981-bfb5-f6eb3fd69ab3.config","Node":{"Content":{"@Key":"85b5184b-4ac0-4981-bfb5-f6eb3fd69ab3","@Alias":"مؤتمر leap24","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//leap24","Trashed":"false","ContentType":"eventDetails","CreateDate":"2024-07-15T12:40:56","NodeName":{"@Default":"مؤتمر leap24","Name":{"@Culture":"ar-jo","#text":"مؤتمر leap24"}},"SortOrder":"30","Published":{"@Default":"true","Published":{"@Culture":"ar-jo","#text":"true"}},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":{"@Culture":"ar-jo","#cdata-section":"هيئة العقار راعِ ماسي في مؤتمر ليب التقني "}},"endDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-03-07T00:00:00"}},"eventBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>هيئة العقار راعِ في مؤتمر ليب 24 للتقنية،حيث تقدم دعمها وتعزيزها للمبادرات التقنية والابتكارات في القطاع العقاري</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"eventLocation":{"Value":{"@Culture":"ar-jo","#cdata-section":"مركز الرياض للمعارض والمؤتمرات - ملهم "}},"eventsImages":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"221b3c4d-3434-4c63-bb3d-f6cd567bfb3a\",\n    \"mediaKey\": \"fbdee2ed-f222-4af7-8c77-f8c197ad736a\"\n  }\n]"}},"eventTitle":{"Value":{"@Culture":"ar-jo","#cdata-section":"مؤتمر ليب 24"}},"eventType":{"Value":{"@Culture":"ar-jo","#cdata-section":"حدث محلي "}},"headerBackgroundImage":{"Value":{"#cdata-section":"umb://media/fbdee2edf2224af78c77f8c197ad736a"}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"@Culture":"ar-jo","#cdata-section":"مؤتمر #ليب24 "}},"pageTitle":{"Value":{"@Culture":"ar-jo","#cdata-section":"مؤتمر #ليب24 "}},"shortBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>&nbsp;</p>\\n<p>هيئة العقار راعِ في مؤتمر ليب 24 للتقنية،حيث تقدم دعمها وتعزيزها للمبادرات التقنية والابتكارات في القطاع العقاري</p>\\n<p>&nbsp;</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/fbdee2edf2224af78c77f8c197ad736a"}},"startDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-03-04T00:00:00"}},"targetAudience":{"Value":{"@Culture":"ar-jo","#cdata-section":"أصحاب الاختصاص "}},"title":{"Value":{"@Culture":"ar-jo","#cdata-section":"مؤتمر #ليب24 "}}}}},"IsRoot":true},{"Key":"113bbc5b-a4cb-3de0-86c0-359edb595e56","Alias":"الهيئة العامة للعقار تطرح مسودة اللائحة التنفيذية لنظام المساهمات العقارية","Path":"/0fe73dd0-3800-4528-8fd3-4faca74a0d14.config","Level":4030,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/0fe73dd0-3800-4528-8fd3-4faca74a0d14.config","Node":{"Content":{"@Key":"0fe73dd0-3800-4528-8fd3-4faca74a0d14","@Alias":"الهيئة العامة للعقار تطرح مسودة اللائحة التنفيذية لنظام المساهمات العقارية","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":"الهيئة العامة للعقار تطرح مسودة اللائحة التنفيذية لنظام المساهمات العقارية"},"SortOrder":"30","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-06T21:30:53"}},"newsImages":{"Value":{"#cdata-section":"[]"}},"newsText":{"Value":{"#cdata-section":"{\n  \"markup\": \"<p style=\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">طرحت الهيئة العامة للعقار مسودة اللائحة التنفيذية لنظام المساهمات العقارية عبر منصة \\\"استطلاع\\\"، بهدف تمكين العموم والجهات الحكومية والقطاع الخاص من إبداء مرئياتهم وملحوظاتهم عليها قبل إقرارها، وذلك بالتنسيق مع هيئة السوق المالية، وفقاً للمادة السابعة والثلاثين من نظام المساهمات العقارية الصادر بالمرسوم الملكي بتاريخ 1444/12/28هـ</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\">.<br></span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأوضحت \\\"الهيئة\\\" أنّ مسودة\\\"اللائحة التنفيذية لنظام المساهمات العقارية\\\" تتضمن ستة وثلاثين مادة تهدف إلى حفظ الحقوق لجميع الأطراف والقضاء على ممارسة المساهمات العقارية العشوائية وغير النظامية، وحوكمة أعمال الرقابة والامتثال، وذلك امتدادًا لمنظومة التشريعات العقارية التي تُشرف عليها الهيئة وتأتي في إطار مُستهدفات الإستراتيجية الشاملة للقطاع العقاري</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\">.<br></span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وأشارت الهيئة إلى أنّ مواد اللائحة توضح تصنيف المساهمات العقارية وتصنيف المطورين العقاريين، وإجراءات ترخيص المساهمات العقارية، وأحكام رأس مال المساهمة العقارية، وما يتعلق بممارسي نشاط الوساطة العقارية واختصاصاتهم، بالإضافة إلى الرقابة والتفتيش والضبط</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\">.<br></span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">ودعتْ الهيئة المهتمين من العموم والجهات الحكومية والقطاع الخاص كافة إلى الاطلاع على اللائحة في منصة استطلاع</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\"> <a href=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Implementing/Pages/default.aspx#https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Implementing/Pages/default.aspx\\\" title=\\\"https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Implementing/Pages/default.aspx\\\" data-anchor=\\\"#https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Implementing/Pages/default.aspx\\\">https://istitlaa.ncc.gov.sa/ar/Municipality/rega/Implementing/Pages/default.aspx</a></span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">وتقديم</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\"><br></span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">الملاحظات والمقترحات بشأنها مؤكدةً حرصها على أنْ يسهم النظام و\\\"اللائحة التنفيذية لنظام المساهمات العقارية في زيادة المعروض من المنتجات العقارية التجارية والسكنية بوصفه قناة تمويلية واستثمارية جديدة للمطورين العقاريين، كما سيكون له دور في تعزيز ثقة المستثمرين في القطاع العقاري في المملكة من خلال ما تضمنَه من قواعد وأحكام تحفظ الحقوق لجميع الأطراف وسيقضي على ممارسة المساهمات العقارية العشوائية وغير النظامية، وحوكمة أعمال الرقابة والامتثال</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\">.<br></span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\" lang=\\\"AR-SA\\\">كما أنَّ النظام سيتيح خلق فرص استثمارية واعدة للمُنشآت الصغيرة أو المتوسطة في السوق العقاري، ويوفر وعاء استثماريًا عقاريًا جديدًا وموثوقًا</span><span style=\\\"font-size: 17.0pt; line-height: 200%; font-family: 'Sakkal Majalla';\\\">.</span></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}"}},"newsTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تطرح مسودة اللائحة التنفيذية لنظام المساهمات العقارية"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"الهيئة العامة للعقار تطرح مسودة اللائحة التنفيذية لنظام المساهمات العقارية"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"3e9ddf12-5410-363c-b5e5-f2e3ed4bc281","Alias":" الحقيل.. يدشن مؤتمر \"بروبتك السعودية\" بنسخته الأولى بمشاركة دولية واسعة","Path":"/780abaff-5702-4d6a-8dca-b68b7a26a541.config","Level":4031,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/780abaff-5702-4d6a-8dca-b68b7a26a541.config","Node":{"Content":{"@Key":"780abaff-5702-4d6a-8dca-b68b7a26a541","@Alias":" الحقيل.. يدشن مؤتمر \"بروبتك السعودية\" بنسخته الأولى بمشاركة دولية واسعة","@Level":"4","Info":{"Parent":{"@Key":"2ce40610-a6fb-49dd-9eb1-2a576fd33d03","#text":"الأخبار"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"newsDetails","CreateDate":"2023-11-23T17:40:10","NodeName":{"@Default":" الحقيل.. يدشن مؤتمر \"بروبتك السعودية\" بنسخته الأولى بمشاركة دولية واسعة"},"SortOrder":"31","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"9bf55ecf-aee0-4d9b-836c-8e028dc91ed1","#text":"NewsDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"newsDate":{"Value":{"#cdata-section":"2023-11-07T13:32:09"}},"newsImages":{"Value":{"#cdata-section":""}},"newsText":{"Value":{"#cdata-section":"<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\">دشن معالي وزير الشؤون البلدية والقروية والإسكان رئيس مجلس إدارة الهيئة العامة للعقار الأستاذ ماجد بن عبد الله الحقيل , اليوم، النسخة الأولى من مؤتمر \"بروبتك السعودية\"، الذي تنظمه الهيئة العامة للعقار على مدى يومين بالعاصمة الرياض</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">ويستعرض المؤتمر أبرز المستجدات التقنية العقارية وتجاربالمستفيدين وجلسات حوارية وورش عمل بمشاركة أكثر من 25 متحدثًا يمثلون 20 دولة من مختلف أنحاء العالم، ويصاحبه معرض تقني عقاري بمشاركة شركات ومنصات عقارية وتقنية محلية ودولية</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وققال \"الحقيل\" خلال تدشين بروبتك السعودية \" إنّ أهمية التقنية العقارية ودورها في تطوير مستقبل العقار يعطينا مؤشرات حقيقة بأننا نسير في الاتجاه الصحيح، ولنستذكر أنّ رؤية المملكة 2030 تستهدف الوصول إلى مجتمع حيوي واقتصاد مزدهر من خلال توفير بيئة مناسبة للنمو، واستحداث فرص عمل للمواطنين، ورعاية المواهب وتنمية الاستثمارات، واغتنام الإمكانات الكبيرة التي يتمتع بها الوطن، وأن التقنيات العقارية هي أحد الممكنات التي يسهم من خلالها أبناء الوطن المبدعين والمبتكرين في رسم المستقبل الواعد، واليوم بروبتك السعودية جاء ليدعم ثقافة الابتكار ويساهم في توفير فرص مميزة لنمو القطاع العقاري، ويساعد في استقطاب أفضل الخبرات العالمية في هذا المجال، وسيستمر في السنوات القادمة ليكون منصة معرفية تدعم التقنية العقارية</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">\" .</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وأكّد أنّ إطلاق بروبتك السعودية هو إطلاق لإمكانيات القطاع العقاري الواعدة، وتمكين القطاع الخاص، والإسهام في تطوير المشاريع العقارية ومشاريع البنية التحتية، وستقوم الهيئة العامة للعقار بتمكين مشاريع التقنية العقارية من خلال التشريعات العقارية والأنظمة لفتح أسواق جديدة تسهم في تنويع مصادر دخل الاقتصاد المحلي، ودعم الناتج المحلي غير النفطي</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">بدوره أوضح الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحمّاد أنّ الهيئة العامة للعقار تؤمن بأن التقنيات العقارية هي إحدى الممكنات التي تقود القطاع العقاري لرفع كفاءته وفاعليته وتعزيز دوره في تنويع مصادر الدخل، وتعظيم الاستفادة القصوى من التحول الرقمي الذي تعيشه المملكة العربية السعودية في شتى المجالات، بأفقها الواسع وتعدد مشاريعها وازدياد الحاجة لها كجزء من جودة الحياة هي مكمن فرص الاستثمار العقاري في المستقبل القريب، ويدعم نموهها كافة استراتيجيات البحث العلمي والابتكار واستراتيجيات التحول الرقمي وتقنية المعلومات وتطوير التشريعات والأنظمة العقارية، والمتأمل في المشاريع العقارية السعودية العملاقة التي يتم الإعلان عنها بشكل مستمر يدرك بأنَّ التقنية العقارية هي المستقبل فمن خلالها يتم تطبيق معايير الاستدامة ورفع مستوى جودة الحياة</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 200%;\"><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif;\"><br style=\"box-sizing: inherit; color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; word-spacing: 0px;\"></span><span lang=\"AR-SA\" style=\"font-family: 'Arial',sans-serif; mso-ascii-font-family: NeoSansArabic; mso-hansi-font-family: NeoSansArabic; mso-bidi-font-family: Arial; mso-bidi-theme-font: minor-bidi; background: white;\"><span style=\"color: rgba(0, 0, 0, 0.87); font-variant-ligatures: normal; font-variant-caps: normal; orphans: 2; text-align: start; widows: 2; -webkit-text-stroke-width: 0px; white-space: pre-wrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; word-spacing: 0px;\">وجرى خلال حفل افتتاح \"بروبتك السعودية\"الإعلان عن تقرير التقنية العقارية، وإطلاق منصة المؤشرات العقارية، وإطلاق منصة السجل العقاري إضافة إلى افتتاح المعرض المصاحب والذي يضم أكثر من 50 جناحا يمثلون 25 دولة، وتشارك فيه الجهات الحكومية المُشرِعة والممكنة في القطاع العقاري إضافة إلى شركات عقارية، وتقنية، وشركات ناشئة في التطوير العقاري والبناء، وتطبيقات عقارية، وشركات استثمارية وصناديق تمويلية</span><span dir=\"LTR\" style=\"font-family: 'NeoSansArabic',serif; background: white;\">.</span></span></p>"}},"newsTitle":{"Value":{"#cdata-section":" الحقيل.. يدشن مؤتمر \"بروبتك السعودية\" بنسخته الأولى بمشاركة دولية واسعة"}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":" الحقيل.. يدشن مؤتمر \"بروبتك السعودية\" بنسخته الأولى بمشاركة دولية واسعة"}},"relatedNews":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"edf8573b-545e-328d-bb2e-4c177589d031","Alias":"ملتقى الوساطة العقارية","Path":"/f04ae7d6-25fe-4cea-9aea-14ed6ee1ff7b.config","Level":4031,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/f04ae7d6-25fe-4cea-9aea-14ed6ee1ff7b.config","Node":{"Content":{"@Key":"f04ae7d6-25fe-4cea-9aea-14ed6ee1ff7b","@Alias":"ملتقى الوساطة العقارية","@Level":"4","Info":{"Parent":{"@Key":"3e8a5477-c74a-4afe-a727-2886312d5d7a","#text":"الفعاليات"},"Path":"//mediaCenter//","Trashed":"false","ContentType":"eventDetails","CreateDate":"2024-09-09T08:55:55","NodeName":{"@Default":"ملتقى الوساطة العقارية","Name":{"@Culture":"ar-jo","#text":"ملتقى الوساطة العقارية"}},"SortOrder":"31","Published":{"@Default":"true","Published":{"@Culture":"ar-jo","#text":"true"}},"Schedule":null,"Template":{"@Key":"210f6e09-27b6-4e44-a7b1-93c5661395f8","#text":"EventDetails"}},"Properties":{"description":{"Value":{"@Culture":"ar-jo","#cdata-section":"تنظّم ⁧#هيئة_العقار⁩ الملتقى الأول لـ #الوساطة_العقارية بالتزامن مع مرور عام على نفاذ النظام، والذي يناقش الفرص ومكامن التطوير في السوق العقاري."}},"endDate":{"Value":{"@Culture":"ar-jo","#cdata-section":"2024-07-17T00:00:00"}},"eventBrief":{"Value":{"@Culture":"ar-jo","#cdata-section":"{\n  \"markup\": \"<p>تنظّم ⁧<a dir=\\\"rtl\\\" href=\\\"https://x.com/hashtag/%D9%87%D9%8A%D8%A6%D8%A9_%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1?src=hashtag_click\\\" class=\\\"css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-1k78y06 r-1vmecro r-1loqt21\\\">#هيئة_العقار</a>⁩ الملتقى الأول لـ <a dir=\\\"rtl\\\" href=\\\"https://x.com/hashtag/%D8%A7%D9%84%D9%88%D8%B3%D8%A7%D8%B7%D8%A9_%D8%A7%D9