 \"contentUdi\": \"umb://element/fb0b635c66d04e91ac44f2e8493a4b41\"\n      },\n      {\n        \"contentUdi\": \"umb://element/05f16d0bc41a4e4887eef872102f299f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/56ae3a144276416eb254b259683d679c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c801e726dd304835a549bfa9cdc0370f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d75a51d9717c4c398bb9f818511938b9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/379b0ca59edf42cb8132be03b4216ed1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b4e1245a274745bda4ca7ad33ef60198\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bf6d867e45c54baaa3c0704c1d98b76e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5f2f0840905c4814a4ddf1ee3e238884\"\n      },\n      {\n        \"contentUdi\": \"umb://element/349d7f2ed6bb4c63b9ab03fc04fe39d2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c34a049e08d54238b60c63e11079e1b7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/540cd24918ca4a8fa65b90c1f32719ea\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f03189a5dbe4a2097b3e7dd82f9ab0b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8b565ffe76894538835511184bb154cc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/404beca320b64f59992fb3f755c0392b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f2d0f6625974744953da269b3ccf2b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f2cbc8939abb4914bfac964e96b9fd71\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b98b5755a1544462b9402d15bab0fd6b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6035652ded5b4df6998631fdd5d3b505\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e7fc3b4f90c840389de3845879f6d7f3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/895a552b924541ea97866220614ca031\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7ab170665cce4c6b93567d09853bed75\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b497fabec85d4bfeafcbe2ae5b29f9cf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a606f7f6bc04024a6db372a0de0eace\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5e0bda6081f34600adfd0ac69da31b49\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f77204d0b3054ebe9b052dd0460b8f39\"\n      },\n      {\n        \"contentUdi\": \"umb://element/76815f474507461ea1140bf4d4d3e07e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1adf9545aecc435eb3e2ceaf7162b46d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9773996d955248578f6384b392b2d8a8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ad68673dc37d4356860d8c81762e9526\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b5c77a3c94c74f7ba56817f529cc3b2f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa63cfc675ea4404a0c3c9c2cf3db6e3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e0e68a96affd4a6ea310ea3e66926059\"\n      },\n      {\n        \"contentUdi\": \"umb://element/582aedb1e7ce422194d9b9492e9cddb2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c31e8cd000e24240a01f90119d44ac95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/61f3906ad2774dbe9227e0ae6d4f06ef\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d25be1c92e0642b7991840866f466e7a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/733458372d904fd2a1a380bef36b038d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0b525757c3384f25929deb730228a8e9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/411bd50a9c9a496b8e4ec60255c21a9b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8f75845a2cd640019ffec7202f998623\"\n      },\n      {\n        \"contentUdi\": \"umb://element/27429907113544569bbf16a5031cbb34\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e66c6a227c8048329b16c05bb4062b65\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8755e28605a0426a96b80814106c790f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d968564d9290470da921f58721752b95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f2c79532be5240679b89d5f7317de701\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7724781d2b3d4a93be2cb64e1a88ce83\"\n      },\n      {\n        \"contentUdi\": \"umb://element/96b393e19a494ab2b2f10fbf564e605e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8f562d2d946045b9ab88c17d7f66bd96\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a0445566f1e543c2821f9574a3302065\"\n      },\n      {\n        \"contentUdi\": \"umb://element/03870778426b4c7988c9de0a1cc21b60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/62b4acb46cac4479919914524ff91a9d\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/18df720ad3b145a6a9453abda1e98ae1\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>يكون للألفاظ والعبارات الواردة في اللائحة معاني الألفاظ والعبارات الواردة في النظام، ما لم يقتضِ السياق خلاف ذلك، ويُقصد بالعبارات الآتية -أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها:<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المجلس:</strong> مجلس إدارة الهيئة العامة للعقار.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5ed06469a002401a9024770771fa926d\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة أحكام المادة (الرابعة) من النظام تختص الهيئة بالإشراف على تنظيم بيع وتأجير مشروعات عقارية على الخارطة، بما في ذلك:<br>1 - &nbsp;إصدار الدليل الاجرائي لبيع وتأجير مشروعات عقارية على الخارطة، وفقًا للنظام واللائحة.<br>2 - &nbsp;إصدار القرارات التنفيذية لممارستها الاختصاصات وفقاً للنظام واللائحة.<br>3 - &nbsp;قيد المطورين العقاريين؛ وفقاً للنظام واللائحة.<br>4 - &nbsp;ترخيص المشروعات العقارية؛ وفقًا للنظام واللائحة.<br>5 - &nbsp;الرقابة والتفتيش على سائر أعمال النشاط.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/05f16d0bc41a4e4887eef872102f299f\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">     1 -  يشترط لقيد الشخص الاعتباري في سجل قيد المطورين الآتي:</p>\\n<p style=\\\"text-align: right;\\\"> ‌أ- سجل تجاري ساري المفعول<br> ‌ب- الحصول على (خمسة وثلاثين) نقطة من (مئة) نقطة كحدٍ أدنى وفقاً للجدول في المادة (الخامسة) من        اللائحة.<br>     2 -  يشترط لقيد الشخص الطبيعي -عند الاقتضاء- في سجل قيد المطورين الحصول على (خمسة وثلاثين) نقطة من (خمسة وخمسين) نقطة كحدٍ أدنى وفقاً للجدول في المادة (الخامسة) من اللائحة.<br>     3 -  يجوز للمطور طلب رفع نقاط تقييمه في سجل قيد المطورين إذا تغيرت قدراته بعد قيده.<br>     4 -  يعلق قيد المطور إذا فقد الحد الأدنى من معايير التقييم ويعطى مهلة تصحيحية مدتها (ثلاثة) أشهر، ويشطب قيده إذا لم يصحح وضعه خلال هذه المدة.<br>     5 -  لا يؤثر التعليق أو الشطب وفق هذه المادة على المشروعات التي صدرت لها تراخيص للبيع أو التأجير على الخارطة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/56ae3a144276416eb254b259683d679c\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>يضمّن سجل قيد المطورين الآتي:<br>1 -  ‌اسم المطور، وبيانات السجل التجاري ورأس ماله، وعنوانه الوطني، وبيانات الاتصال بممثله النظامي.<br>2 -  ‌الهيكل التنظيمي للمطور، شاملًا للوظائف الأساسية.<br>3 -  ‌أسماء المشروعات العقارية المنفذة أو القائمة، وقيمتها.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c801e726dd304835a549bfa9cdc0370f\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>     1 -  تكون معايير تقييم قدرات الشخص الاعتباري للقيد في سجل المطورين الآتي:</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"> </p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" width=\\\"100%\\\" class=\\\"MsoTableGrid\\\" style=\\\"border-collapse: collapse; width: 100%; border-spacing: 0px; border: medium solid currentcolor;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المعيار</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المتطلبات</strong></p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>طريقة التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>وزن التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>النوع</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"5\\\" width=\\\"100%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">أولاً: القدرات المالية</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">قوائم مالية من محاسب قانوني معتمد</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">1/البيان المالي للمنشآت الحديثة أقل من سنة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">2/قوائم مالية لسنة مالية، للمنشآت التي أنشئت من سنة ولا تزيد عن سنتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">3/قوائم مالية لسنتين متتاليتين للمنشآت التي أنشئت منذ سنتين وأكثر.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><strong>*</strong>القوائم: الأصول المتداولة- الالتزامات النقدية- الأرباح والخسائر.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات أقل من 20% من حجم الأصول: 20 نقطة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات أكبر من 20% وأقل من 80% من حجم الأصول: 15 نقطة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات أكبر من 80% وأقل من 100% من حجم الأصول: 10 نقاط.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات (أكبر من/تساوي) حجم الأصول: 5 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">20</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>شهادة سلامة السجل الائتماني</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة من شركة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب التأهيل، على ألا يتجاوز تاريخ إصدار الشهادة (ثلاثة) أشهر من تاريخ تقديم الطلب.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">-  عدم وجود قضايا: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">-  عدم وجود شيكات مرتجعة: 4 نقاط.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">-  عدم وجود مبالغ متعثرة: 4 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"5\\\" width=\\\"100%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">ثانياً: القدرات الفنية</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">بيان بالمشروعات المنفذة وإرفاق ما يثبت تنفيذها</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">مشروعات تطوير عقارية: وهي المشروعات الانشائية بحسب نوعها وفق الآتي:</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">السكنية: أن تكون بحد أدنى (10) وحدات سكنية للمشروع الواحد.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">غير السكنية (صناعية، تجارية، مكتبية، ...): أن يكون مسطح بناء المشروع (2000) متر مربع فأكثر.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تطوير بنية تحتية: أن يكون بمساحة (50.000) متر مربع فأكثر.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">كل مشروع تطوير عقاري منفذ خلال (10) سنوات ماضية: 10نقاط</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">30</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">المنهج المتبع لأحد المشروعات المنفذة</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">توضيح المنهج المتبع للمشروعات وفق الآتي:</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">1/نبذه عن المشروع وبياناته، توضح مساحته وأنواعه والغرض من انشاء المشروع ومخطط المشروع. </p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">2/برامج تقنية تستخدم في إدارة المشروعات لمراقبة تقدم المشروع على سبيل المثال لا الحصر (مايكروسوفت، بروجكت، بريمافيرا) وغيرها.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">3/ملخص دراسة الجدوى للمشروع تتضمن (التكاليف والايرادات).</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">4/هيكل فريق المشروع.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">5/الجدول الزمني للمشروع.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">كل فقرة في المتطلبات: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">استكمال المتطلبات: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"5\\\" width=\\\"100%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">ثالثاً: القدرات المؤسسية والموارد البشرية</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الهيكل التنظيمي</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الهيكل التنظيمي المعتمد للمنشأة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الهيكل التنظيمي المعتمد: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">1</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>لائحة تنظيم العمل</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">لائحة تنظيم العمل معتمدة من وزارة الموارد البشرية والتنمية الاجتماعية</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">لائحة تنظيم العمل: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>لائحة إدارة السلامة والصحة المهنية</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">معتمدة من صاحب الصلاحية في المنشأة أو شهادة ايزو 45001</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة ايزو 45001 أو معتمدة من صاحب الصلاحية في المنشأة: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>نطاق السعودة</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة التوطين الصادرة من الجهة المختصة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة التوطين: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">2</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادات التأمينات الاجتماعية وقائمة المشتركين على رأس العمل.</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادات التسجيل الصادرة من المؤسسة العامة للتأمينات الاجتماعية</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">عدد الموظفين من 1 الى 5: نقطة واحدة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">عدد الموظفين من 6 الى 49: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">عدد الموظفين 50 فأكثر: ثلاث نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اجتياز البرنامج التأهيلي المعتمد من الهيئة</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اجتياز مالك المنشأة أو المدير أو الموظفين المدرجين في قائمة المشتركين على رأس العمل</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شخص واحد: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة من هيئة الزكاة والضريبة والجمارك</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة (إقرار زكوي) سارية المفعول</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مطابقة رقم السجل التجاري مع شهادة التسجيل السارية: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>عدد المهندسين العاملين في المنشأة</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">المهندسين المعتمدين من الهيئة السعودية للمهندسين العاملين في المنشأة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">المهندسين من 1 إلى 2: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">المهندسين من 3 إلى 9: 3 نقاط.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">المهندسين من 10 فأكثر: 5 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>برامج المسؤولية الاجتماعية</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">معتمدة من المنشأة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">برنامج معتمد: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"2\\\" width=\\\"52%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span> </span></p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المجموع</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>100</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"> </p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span> </span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">     2 -  تكون معايير تقييم قدرات الشخص الطبيعي للقيد في سجل المطورين الآتي:</p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" width=\\\"100%\\\" class=\\\"MsoTableGrid\\\" align=\\\"right\\\" style=\\\"border-collapse: collapse; width: 100%; border-width: 1px; border-spacing: 0px; border-style: solid;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المعيار</strong></p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المتطلبات</strong></p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>طريقة التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>وزن التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>النوع</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اجتياز البرنامج التأهيلي للمطور العقاري</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة اجتياز البرنامج التدريبي المعتمد من المعهد العقاري</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة الاجتياز: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">بيان بالمشروعات التي قام بتنفيذها الشخص الطبيعي وارفاق ما يثبت تنفيذها.</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">مشروعات تطوير عقارية: وهي المشروعات الانشائية بحسب نوعها وفق الآتي:</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">1/السكنية: بحد أدنى (3) وحدات سكنية للمشروع الواحد.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">2/ غير السكنية (صناعية، تجارية، مكتبية، ...): أن يكون مسطح بناء المشروع غير سكني (1000) متر مربع فأكثر.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">3/تطوير بنية تحتية: أن يكون بمساحة (50.000) متر مربع فأكثر.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">كل مشروع تطوير عقاري منفذ خلال (10) سنوات ماضية: 10 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">30</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة سلامة السجل الائتماني للأفراد</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة من شركة مرخص لها بتقديم الخدمات الائتمانية على ألا يتجاوز تاريخ إصدار الشهادة شهرين من تاريخ تقديمها.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">خلو السجل الائتماني من القضايا والمرافعات والشيكات المرتجعة: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة تسجيل في ضريبة القيمة المضافة للأفراد</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة تسجيل سارية المفعول مطابقة لرقم السجل المدني.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة تسجيل سارية صادرة من هيئة الزكاة والضريبة والجمارك للشخص الطبيعي.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span> </span></p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"> </p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المجموع</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>55</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"> </p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span> </span></p>\\n<p class=\\\"MsoNormal\\\"> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d75a51d9717c4c398bb9f818511938b9\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة الأحكام الواردة في المادة (السادسة) من النظام يرخص للمشروع العقاري على الخارطة بعد استيفاء الآتي:<br>&nbsp; &nbsp; &nbsp; 1 - &nbsp;تقديم دراسة جدوى المشروع مشتملة -بالإضافة لما ورد في الفقرة (ك) من (1) من المادة السادسة من النظام- على البيانات المالية، والانشائية، والتسويقية المقدرة للمشروع، والمصاريف المالية والإدارية المتوقعة، ومدة تسليم الوحدات ومصادر التمويل المتوقعة.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;خطاب من (مركز خدمات المطورين \\\"إتمام\\\" أو أي جهة مختصة بتراخيص البناء) يفيد بمطابقة المشروع العقاري للمتطلبات النظامية لرخص البناء، والمخططات الهندسية، والتصاميم المعمارية، ويكتفى به عن المتطلبات الواردة في الفقرتين (د) و (ح) من المادة السادسة من النظام.<br>&nbsp; &nbsp; &nbsp; 3 - &nbsp;إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقاً لنظام ملكية الوحدات العقارية وفرزها وإدارتها.<br>&nbsp; &nbsp; &nbsp; 4 - &nbsp;فيما عدا العقارات المسجلة عينياً؛ يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري.</p>\\n<p>&nbsp; &nbsp; &nbsp; 5 - &nbsp;حصول المطور العقاري على نقاط التقييم وفقاً للجدول الآتي:</p>\\n<p>&nbsp;</p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" class=\\\"MsoTableGrid\\\" style=\\\"width: 100%; border-collapse: collapse; border-spacing: 0px; border: medium solid currentcolor;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td width=\\\"54%\\\" style=\\\"border-width: medium 1pt 1pt; border-style: solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>درجة شهادة تصنيف مقدمي خدمات المدن</strong></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong><span>\\\"بلدي\\\"</span></strong></p>\\n</td>\\n<td width=\\\"45%\\\" style=\\\"border-width: medium 1pt 1pt; border-style: solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الحد الأعلى لقيمة المشروع الواحد</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الأولى</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">غير محددة.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الثانية</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مليار ريال.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الثالثة</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">خمس مئة مليون ريال.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الرابعة</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مئتين وخمسون مليون ريال.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الخامسة</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مئة مليون ريال.</p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<div></div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/379b0ca59edf42cb8132be03b4216ed1\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط لاعتماد المحاسب القانوني للمشروع العقاري الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;سجل تجاري ساري المفعول.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;أن يكون مرخصاً من الهيئة السعودية للمراجعين والمحاسبين.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;اجتياز (10%) أو (4) من محاسبي المكتب البرنامج التأهيلي المعتمد من الهيئة، أيهما أقل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bf6d867e45c54baaa3c0704c1d98b76e\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يجوز للمطور طلب (ترخيص تسويق المشروع العقاري) قبل ترخيص المشروع العقاري على الخارطة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يقدم المطور المستندات والبيانات لترخيص تسويق المشروع وفق الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; رقم صك تسجيل ملكية العقار.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; رقم عقد التسويق بين الوسيط العقاري والمطور- إن وجد-.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; نسخة عقد التطوير بين المطور ومالك الأرض-إن وجد-.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; التصاميم المعمارية والمخططات الهندسية.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;تبت الهيئة في طلب (ترخيص تسويق المشروع العقاري) خلال (عشرة) أيام عمل من تاريخ اكتمال الطلب، وفي حال الرفض فيجب أن يكون القرار مسبباً.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;تكون مدة (ترخيص تسويق المشروع العقاري) بما لا يتجاوز (مئة وثمانين يوماً) ويجوز تمديدها للمشروعات التي لا تتطلب استلام أموال حجز الوحدات العقارية من المشترين أو المستأجرين، لمدة أو مدد مماثلة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5f2f0840905c4814a4ddf1ee3e238884\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم الوسيط العقاري في تسويقه للمشروعات العقارية على الخارطة، لأحكام نظام الوساطة العقارية ولوائحه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/349d7f2ed6bb4c63b9ab03fc04fe39d2\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يجب على المطور في حال رغبته باستلام مبلغ حجز وحدات عقارية من المشتري أو المستأجر خلال مدة (ترخيص تسويق المشروع العقاري) الالتزام بالآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; الإفصاح عن حالة المشروع والمخططات المستقبلية له.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; عدم استلام أكثر من (5%) من قيمة الوحدة العقارية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; إيداع جميع مبالغ الحجز المستلمة في حساب الضمان المخصص لذلك.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;إذا انتهت المدة المحددة في ترخيص تسويق المشروع العقاري، ولم يستكمل المطور ترخيص المشروع، فتعيد الهيئة المبالغ المودعة في حساب الضمان إلى أصحابها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c34a049e08d54238b60c63e11079e1b7\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة الأحكام الواردة في المادة (السادسة) من النظام يرخص للمشروع العقاري على الخارطة بعد استيفاء الآتي:<br>      1 -  تقديم دراسة جدوى المشروع مشتملة -بالإضافة لما ورد في الفقرة (ك) من (1) من المادة السادسة من النظام- على البيانات المالية، والانشائية، والتسويقية المقدرة للمشروع، والمصاريف المالية والإدارية المتوقعة، ومدة تسليم الوحدات ومصادر التمويل المتوقعة.<br>      2 -  خطاب من (مركز خدمات المطورين \\\"إتمام\\\" أو أي جهة مختصة بتراخيص البناء) يفيد بمطابقة المشروع العقاري للمتطلبات النظامية لرخص البناء، والمخططات الهندسية، والتصاميم المعمارية، ويكتفى به عن المتطلبات الواردة في الفقرتين (د) و (ح) من المادة السادسة من النظام.<br>      3 -  إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقاً لنظام ملكية الوحدات العقارية وفرزها وإدارتها.<br>      4 -  فيما عدا العقارات المسجلة عينياً؛ يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري.</p>\\n<p>      5 -  حصول المطور العقاري على نقاط التقييم وفقاً للجدول الآتي:</p>\\n<p> </p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" class=\\\"MsoTableGrid\\\" style=\\\"width: 100%; border-collapse: collapse; border-spacing: 0px; border: medium solid currentcolor;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>مساحة المشروع العقاري</strong></p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>النقاط المطلوبة</strong></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>وفق المادة الخامسة من اللائحة</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور الفرد</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">35 نقطة فأكثر</p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور –شخص اعتباري-، التي تقل مسطحات البناء عن 15,000م2</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">35 نقطة فأكثر</p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور –شخص اعتباري-، التي تقل مسطحات البناء عن 25,000م2</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">45 نقطة فأكثر</p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور –شخص اعتباري-، التي تزيد مسطحات البناء عن 25,000م2</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">55 نقطة فأكثر</p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<div></div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/540cd24918ca4a8fa65b90c1f32719ea\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يُشترط لترخيص المشروع العقاري للشخص الطبيعي الآتي:<br>&nbsp; &nbsp; &nbsp; 1 - &nbsp;ألا يتجاوز مسطح البناء في المشروع عن (5000) متر مربع.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;ألا تزيد مدة تنفيذ المشروع على (ثلاث سنوات).<br>&nbsp; &nbsp; &nbsp; 3 - &nbsp;ألا تتجاوز عدد المشروعات العقارية التي يسمح بتنفيذها سنوياً عن (ثلاثة) مشروعات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f03189a5dbe4a2097b3e7dd82f9ab0b\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp; 1 - &nbsp;يجوز للهيئة تقسيم المشروع العقاري إلى عدة نطاقات.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;يشترط في تقسيم المشروع العقاري إلى عدة نطاقات الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; موافقة الهيئة على البدء في النطاق.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; أن يكون لكل نطاق حساب ضمان مستقل.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; أن يكون لكل نطاق تقارير هندسية ومالية مستقلة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8b565ffe76894538835511184bb154cc\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المطور العقاري بالآتي:<br>&nbsp; &nbsp; &nbsp; 1 - &nbsp;تقديم قوائم مالية عند نهاية المشروع العقاري –معدة من المحاسب القانوني- للهيئة، أو عند طلبها.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;تزويد المشتري أو المستأجر بجميع المخططات الفعلية للوحدة العقارية والمنفذة على الطبيعة.</p>\\n<p>&nbsp; &nbsp; &nbsp; 3 - &nbsp;تنفيذ المشروع حسب المواصفات المتفق عليها في العقود ودراسة الجدوى.</p>\\n<p>&nbsp; &nbsp; &nbsp; 4 - &nbsp;إيداع المبالغ من المشترين أو المستأجرين في حساب الضمان مباشرة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/404beca320b64f59992fb3f755c0392b\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المحاسب القانوني بالآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;متابعة وتدقيق البيانات المالية الخاصة بقيمة الوحدات العقارية المتعاقد عليها، والتأكد من أنها أودعت في حساب الضمان.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;إعداد تقارير العمليات المالية والمحاسبية لحساب الضمان، وقائمة المركز المالي للمشروع، وأوجه الصرف من حساب الضمان مرفقًا بها المستندات اللازمة، أو عند طلب الهيئة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f2d0f6625974744953da269b3ccf2b8\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>إذا كان عقار المشروع مسجلاً عينياً وفقاً لنظام التسجيل العيني للعقار؛ فيجب توثيق جميع العقود والتصرفات في (سجل البيع على الخارطة) لدى السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f2cbc8939abb4914bfac964e96b9fd71\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;فيما عدا العقارات المسجلة عينياً وفقاً لنظام التسجيل العيني للعقار؛ يؤشر على صك ملكية العقار -محل المشروع العقاري- لدى الجهة المختصة بالتوثيق بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري، أو إلى أن يسجل العقار لدى السجل العقاري، وإصدار وثيقة التسجيل وفق نظام التسجيل العيني للعقار ولائحته.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يشترط للتأشير على صك تسجيل الملكية للعقار المرهون، موافقة المرتهن.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b98b5755a1544462b9402d15bab0fd6b\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز رفع التأشير بعدم التصرف عن صك تسجيل الملكية للعقار المراد تطويره قبل استكمال المشروع العقاري، بعد موافقة الهيئة في الحالات الآتية:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;المشروعات المقامة على أراضٍ حكومية.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;استكمال إجراءات الفرز، أو الدمج، أو التعديل، أو نقل الملكية.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;الإفراغ للمشتري قبل إنجاز الوحدة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6035652ded5b4df6998631fdd5d3b505\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تعد الهيئة نموذجاً استرشادياً للاتفاقية المبرمة بين المطور العقاري وبين مالك الأرض أو مالك منفعتها، على أن تتضمن الاتفاقية مسؤولية المطور العقاري والمالك والتزامهم أمام المشتري أو المستأجر.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;تعد الهيئة نموذجاً استرشادياً للاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي-إن وجد- ونموذجاً للاتفاقيات بين المطور وبين المكتب الاستشاري، والمحاسب القانوني، والوسيط العقاري -إن وجد-.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e7fc3b4f90c840389de3845879f6d7f3\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تعد الهيئة عقداً نموذجياً للبيع بين مالك الأرض والمطور وبين المشتري أو المستأجر -وذلك فيما عدا العقارات المسجلة عينياً وفق نظام التسجيل العيني للعقار-، يتضمن ما يلي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; جدول الدفعات المالية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; الأحكام المترتبة على تأخر المشتري أو المستأجر في سداد الدفعات المالية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; الأحكام المتعلقة بالتعويض وأجرة المثل عند تأخر المطور في تسليم الأرض أو الوحدة العقارية، بما في ذلك أحكام فسخ العقد.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; مدة تنفيذ المشروع بما في ذلك المدد الإضافية التي يجوز منحها للمطور.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; أحكام الملكية المشتركة، وفق ما ورد في نظام ملكية الوحدات العقارية وفرزها وإدارتها ولائحته.<br>ويجوز للمطور تعديل هذا العقد بعد موافقة الهيئة.&nbsp;</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;تضمن البيانات الواردة في الفقرة رقم (1) من هذه المادة في توثيق التصرف في العقار الموصوف على الخارطة بين أطرافه، وفقاً لنظام التسجيل العيني للعقار ولائحته.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;يجب أن يتضمن عقد مالك الأرض والمطور مع المشتري والمستأجر الإقرار بأن للهيئة إحلال مطور بديل في الحالات التي تقتضيها ظروف تعثر المشروع العقاري، طبقًا للنظام واللائحة وأفضل الممارسات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/895a552b924541ea97866220614ca031\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تكون ملكية الأجزاء المشتركة في المشروع العقاري والتصرف فيها، وفقاً لأحكام نظام ملكية الوحدات العقارية وفرزها وإدارتها ولائحته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7ab170665cce4c6b93567d09853bed75\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يتيح المطور لكل مشترٍ ومستأجر، أو من ينوب عنهما؛ الاطلاع على السجل المحاسبي لوحدته العقارية، بناء على طلب يقدّم للمطور.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;على المطور تزويد المشتري أو المستأجر بنسخة من السجل المحاسبي لوحدته خلال (عشرة أيام) عمل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b497fabec85d4bfeafcbe2ae5b29f9cf\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنشئ الهيئة قاعدة بيانات للمشروعات العقارية على الخارطة، وعلى المطور أن يضيف فيها ما يلي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;أسماء المقاولين والمكتب الاستشاري والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;بيانات ومواصفات تنفيذ المشروع.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;التقارير الصادرة من المكتب الاستشاري، والمحاسب القانوني، والبنك، وشهادات الانجاز.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;محاضر تعديل المخططات التنفيذية، ونسخاً من المخططات المنفذة فعلياً.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;بيانات الموردين وشهادات الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6a606f7f6bc04024a6db372a0de0eace\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تتيح الهيئة –من قاعدة البيانات- لاطلاع العموم ما يلي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;اسم المشروع العقاري، وبيانات صك تسجيل الملكية، والمخطط المعتمد، وموقعه، ومساحته، وعدد وحداته، ونوعها، ومكونات وحداتها، وبيانات الموردين، وبيانات ومواصفات تنفيذ المشروع، وتقارير سير العمل، وتقارير المكتب الاستشاري، والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;اسم المطور، وتصنيفه.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;اسم المكتب الاستشاري، والمحاسب القانوني، والبنك، والمسوق أو الوسيط العقاري-إن وجد-.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;مدة المشروع العقاري، وتاريخ البدء والتسليم.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;استطلاع آراء المشترين أو المستأجرين بشأن الخدمات المقدمة من المطور.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5e0bda6081f34600adfd0ac69da31b49\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;للهيئة طلب تقرير سير المشروع العقاري من المكتب الاستشاري، أو المحاسب القانوني، أو البنك، كل (شهر) في الحالات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; إذا تجاوزت مسطحات البناء للمشروع العقاري (5000) متر مربع، أو إذا تجاوزت عدد الوحدات العقارية في المشروع العقاري (ثلاثين) وحدة.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; إذا كان المشروع العقاري من المشروعات الحكومية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; إذا كان المشروع واقع في المناطق الخاضعة للتطوير الحكومي.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; أي حالة أخرى تحددها الهيئة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;فيما عدا الحالات الواردة في الفقرة رقم (1) من هذه المادة؛ للهيئة طلب تقرير سير المشروع العقاري من المكتب الاستشاري، أو المحاسب القانوني، أو البنك، كل (ثلاثة) أشهر.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f77204d0b3054ebe9b052dd0460b8f39\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تضمن اتفاقية فتح حساب الضمان بين المطور وبين البنك الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;أن يكون لكل مشروع حساب ضمان مستقل، ويكون له رقماً موحداً يعد مرجعًا للإيداع.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;أن يكون حساب الضمان (بالريال السعودي).</p>\\n<p>&nbsp; &nbsp; &nbsp;3 - &nbsp;التزام المطور بعدم الصرف من الحساب إلا للأغراض الخاصة بالمشروع.</p>\\n<p>&nbsp; &nbsp; &nbsp;4 - &nbsp;شروط وإجراءات الصرف من حساب الضمان بما يتفق مع أحكام النظام واللائحة.</p>\\n<p>&nbsp; &nbsp; &nbsp;5 - &nbsp;أن يقتصر الصرف من حساب الضمان من خلال شيكات أو حوالات فقط.</p>\\n<p>&nbsp; &nbsp; &nbsp;6 - &nbsp;أن يكون لكل عملية إيداع رقم مرجع مذكور فيه رقم الوحدة العقارية، بناء على عقد المطور مع المشتري أو المستأجر.</p>\\n<p>&nbsp; &nbsp; &nbsp;7 - &nbsp;عدم إسناد مهام البنك المبنية على الاتفاق مع المطور، إلى طرف ثالث أثناء فترة تنفيذ المشروع لأي سبب.</p>\\n<p>&nbsp; &nbsp; &nbsp;8 - &nbsp;أن تزوّد الهيئة -عند طلبها- بكشف حساب الضمان.</p>\\n<p>&nbsp; &nbsp; &nbsp;9 - &nbsp;عدم إغلاق حساب الضمان بالاتفاق مع المطور إلا بعد موافقة الهيئة.</p>\\n<p>10 - &nbsp;عدم إصدار بطاقات صرف آلي أو بطاقات ائتمان على حساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/76815f474507461ea1140bf4d4d3e07e\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يتم الصرف من حساب الضمان بموجب وثيقة الصرف المقدمة من المطور إلى البنك على أن تكون مصادقة من المكتب الاستشاري والمحاسب القانوني ومتضمنة المبالغ ومبررات الصرف، ويجوز أن تكون وثائق الصرف من خلال وسائل التقنية الآمنة.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;على المطور والمكتب الاستشاري والمحاسب القانوني تحديد المفوض من قبل كل منهم للمصادقة على وثيقة الصرف، وتزويد البنك بتواقيعهم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1adf9545aecc435eb3e2ceaf7162b46d\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة المادة الحادية عشرة من النظام يجوز بطلب من الهيئة الصرف من حساب الضمان في الحالات الآتية:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;سداد المستحقات المالية للجهات الحكومية.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;إعادة المبالغ للمشترين أو المستأجرين.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;صرف مستحقات أطراف المشروع حال استحقاقها وعدم تعاون المطور.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;تحويل موجودات حساب الضمان لحساب الضمان للمطور البديل.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;إصلاح العيوب في المشروع وفق ما ورد في الفقرة رقم (3) من المادة (الحادية والثلاثون) من اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9773996d955248578f6384b392b2d8a8\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يعد من المصاريف غير الانشائية للمشروع المرخص له الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;سداد قيمة الأرض للمالك.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;سداد مبالغ التمويل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ad68673dc37d4356860d8c81762e9526\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;إذا رغب المطور سحب ما يفيض عن التكلفة الفعلية، فيرفع تقريراً مالياً لإنهاء المشروع إلى الهيئة، متضمناً تكلفة المشروع الفعلية على أن تكون مبنية على عقود مع الموردين والمقاولين ومقدمي الخدمات، ومصادقًا عليها من المكتب الاستشاري والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;إذا أجازت الهيئة التقرير؛ أصدرت إذنًا للمكتب الاستشاري والمحاسب القانوني بالتوقيع على أوامر الصرف للمبالغ الفائضة إلى المطور، ولا يعفي ذلك عن مسؤولية المطور والمكتب الاستشاري والمحاسب القانوني في أي مرحلة.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;للهيئة منع صرف الفائض إذا رأت تأخر المطور في مراحل العمل، أو عند الإخلال بالجودة المتعاقد عليها.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يجوز للهيئة تحديد الصرف بجزء من المبلغ الفائض، وفقاً لتقديرها وملاءة المطور وسجل مشروعاته العقارية السابقة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b5c77a3c94c74f7ba56817f529cc3b2f\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;مع مراعاة المادة (الرابعة عشرة) من النظام يحظر على المحاسب القانوني صرف المبلغ المحتفظ به في حساب الضمان، إذا تبين للمكتب الاستشاري، أو المشتري، أو المستأجر، وجود عيوب في الإنشاءات أو التشطيب، بموجب تقرير من خبير مرخص نظاماً، وتُصدر الهيئة قراراً بإصلاح العيوب.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;للهيئة تمديد الاحتفاظ بالمبلغ، أو تطلب تمديد الضمان البنكي -بحسب الأحوال- لمدة (ستة) أشهر، تبدأ بعد صدور قرار إصلاح العيوب.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;إذا أشعرت الهيئة المطور العقاري بالعيوب، ولم يقم بالبدء بإصلاحها خلال (خمسة أيام) من تاريخ إبلاغه فيجوز للهيئة التصرف بالمبلغ المحجوز لإصلاح العيوب، أو مصادرة مبلغ الضمان البنكي، في حدود التكلفة التقديرية للإصلاح.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يجوز صرف المبلغ المحتفظ به في حساب الضمان وإعادة مبلغ الضمان البنكي للمطور قبل انقضاء المدة المحددة في المادة (الرابعة عشرة) من النظام إذا قدم وثيقة تأمين على العيوب الخفية للمباني والإنشاءات معتمدة من هيئة التأمين، على ألا تقل مدتها عن (سنة).</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fa63cfc675ea4404a0c3c9c2cf3db6e3\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز للمطور تعديل المخططات التنفيذية المعتمدة إلا بعد موافقة الهيئة والمشترين أو المستأجرين.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e0e68a96affd4a6ea310ea3e66926059\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المكتب الاستشاري، والمحاسب القانوني، -كل فيما يخصه- إبلاغ الهيئة عن أي مخالفة لأحكام النظام واللائحة، أو الإخلال بالالتزامات التعاقدية للمطور تجاه المشترين والمستأجرين، خلال مدة لا تزيد عن (خمسة) أيام عمل من تاريخ العلم بها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c31e8cd000e24240a01f90119d44ac95\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يعد المطور متأخراً عن تنفيذ المشروع إذا لم ينجز المشروع بعد انتهاء مدته دون سبب خارج عن إرادته.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;يجوز أن تمنح الهيئة مدة إضافية لتنفيذ المشروع بعد انتهاء مدته، على ألا تزيد عن (سنة).</p>\\n<p>&nbsp; &nbsp; &nbsp;3 - &nbsp;يعد المطور متعثراً عن تنفيذ المشروع في الحالات الآتية:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; &nbsp; إذا لم ينجز المشروع بعد انتهاء مدته بما في ذلك المدة الإضافية الممنوحة له.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ب- &nbsp; &nbsp;إذا توقفت أعمال التنفيذ لمدة تزيد عن (مئة وثمانين) يوماً في أي مرحلة من مراحل المشروع.<br>ما لم يقدم المطور سبباً مشروعاً تقبله الهيئة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/61f3906ad2774dbe9227e0ae6d4f06ef\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المطور عند تأخره عن تسليم الأرض أو الوحدة العقارية في الموعد المحدد لإنجازه -دون سبب خارج عن إرادته- بدفع تعويض مادي للمشتري أو المستأجر وفق الآتي:<br>     1 -  إذا كان المشروع أرضاً مطورة؛ فيكون التعويض بناء على اتفاق الأطراف على ألا يقل عن نسبة 2% من قيمة البيع تحتسب على أساس سنوي.</p>\\n<p>     2 -  إذا كان المشروع وحدة عقارية؛ فيكون التعويض بناء على اتفاق الأطراف على ألا يقل عن أجرة المثل للوحدة من مقيم معتمد.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d25be1c92e0642b7991840866f466e7a\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تصدر الهيئة دليلًا فنياً لمعالجة المشروعات العقارية المتأخرة والمتعثرة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يجب أن يتضمن الدليل الفني جميع البيانات اللازمة فنياً وفقاً لأفضل الممارسات، ومنها:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; ‌وصف أنواع تأخر وتعثر المشروعات العقارية ودرجاتها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; ‌الطرق والأساليب والإجراءات الواجب اتباعها لمعالجة التأخر أو التعثر، بما في ذلك خطط إدارة تصحيح إنجازها، وتقرير التغييرات اللازمة لاستكمالها، بما في ذلك تغيير تابعي المطور، وتعديل المواصفات، دون إخلال بحقوق المشترين أو المستأجرين.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; أدوات التدخل الرئيسة لمعالجة التأخر أو التعثر.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; ‌إعادة الهيكلة المالية بما في ذلك خيارات سد فجوات التمويل حال وجودها، وخيارات التمويل في حال اقتضى تأخر أو تعثر المشروع العقاري تمويلاً إضافياً.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; آليات منح المدد الإضافية للمشروعات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/733458372d904fd2a1a380bef36b038d\",\n      \"title\": \" المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -35.65pt; mso-text-indent-alt: -.05in; line-height: 85%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 35.65pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp; &nbsp; &nbsp;1 - &nbsp;تؤهل الهيئة جهات خبرة في تقويم تعثر مشروعات التطوير العقاري، وإدارة تصحيح مسارها؛ وذلك وفقاً لأفضل ممارسات المجال، وللهيئة الاستعانة بالاستشاريين المتخصصين لمساندتها في التأهيل.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;تطرح منافسة -وفقاً للأنظمة المرعية- لاختيار الجهة المتخصصة بتقويم وتصحيح تعثر المشروعات العقارية لكل مشروع متعثر على حده.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0b525757c3384f25929deb730228a8e9\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تشكل الهيئة لجنة متخصصة للإشراف على معالجة المشروعات العقارية المتأخرة والمتعثرة، ولها الاستعانة بالخبراء لدعم اللجنة بالخبرة اللازمة، ويكون للجنة كامل الاختصاصات المقررة في النظام واللائحة، والدليل الفني لمعالجة المشروعات العقارية المتأخرة والمتعثرة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;تتخذ اللجنة التدابير الواجبة لحماية حقوق ذوي العلاقة لإكمال المشروع العقاري المرخص، ومن ذلك:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; ‌تعيين شخص مؤهل لإدارة العلاقة مع المطور لمعالجة تعثر المشروع العقاري.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; ‌فحص ومتابعة عمل المطور، والمكتب الاستشاري، والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; ‌إلزام المطور باستبدال المتسببين في تعثر المشروع العقاري.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; ‌صرف مبالغ من حساب ضمان المشروع العقاري إذا كان لازماً لتصحيح مسار المشروع.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; ‌إحلال مطور بديل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/411bd50a9c9a496b8e4ec60255c21a9b\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>إذا تعذرت التصفية الرضائية للمشروع العقاري المتعثر؛ فتحيل الهيئة المشروع إلى المحكمة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/27429907113544569bbf16a5031cbb34\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>الأعمال التي يجوز إسنادها إلى القطاع الخاص هي أعمال الإشراف الفني ومنها ما يلي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;الإشراف على المكاتب الاستشارية، والمحاسبين القانونيين، في تنفيذ واجباتهم التعاقدية.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;متابعة تنفيذ المشروعات العقارية بعد ترخيصها؛ وفقاً للالتزامات الإشرافية والتعاقدية، على أن يرفع للهيئة تقارير دورية عنها وأن ينفذ توجيهاتها وفقاً لاختصاصها.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;الرقابة والتفتيش على المشروعات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e66c6a227c8048329b16c05bb4062b65\",\n      \"title\": \"المادة الحادية والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تسند الأعمال إلى القطاع الخاص وفقاً لنظام المنافسات والمشتريات الحكومية، وبناء على عقد ينظم تفصيلاً للالتزامات بما يحقق تنفيذ النظام واللائحة، على أن يتضمن تقسيم الوظائف الأساسية للمهام المسندة إلى القطاع الخاص مما يقتضيه تنفيذ تلك الأعمال، ويجوز أن تسند الأعمال إلى جهات متعددة في القطاع الخاص.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8755e28605a0426a96b80814106c790f\",\n      \"title\": \"المادة الثانية والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يتولى مسؤولو الضبط الذين يصدر تعينهم بقرار من الهيئة، ضبط مخالفات أنشطة البيع أو التأجير على الخارطة وممارساتها، التي لا تتفق مع أحكام النظام واللائحة؛ بموجب محضر، متضمناً الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; ‌‌اسم المخالف وبياناته، واسم المشروع العقاري، ومكان ضبط المخالفة، وزمانها، وتاريخها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; ‌اسم مسؤول الضبط الذي رصد المخالفة، وصفته.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; ‌تحديد نوع وعدد المخالفات المضبوطة، والأدلة والقرائن المستند عليها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; كامل أقوال من تنسب إليه المخالفة، بما في ذلك أوجه دفاعه.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; النتائج التي انتهى إليها مسؤول الضبط.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌و- &nbsp; &nbsp; توقيع المحضر من محرره ومن المخالف، أو من يقوم مقامه، مع بيان صفته، وفي حال رفضه التوقيع يشار إلى ذلك في المحضر.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يجوز استخدام الوسائل الإلكترونية الحديثة عند ممارسة صلاحيات الضبط.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;لمسؤولي الضبط في سبيل تأدية مهامهم البحث والتحري ومتابعة البلاغات والشكاوى عن مخالفات النظام واللائحة، ولهم الاستعانة برجال الضبط الجنائي عند اللزوم؛ لدعمهم في عملهم وضبطهم للمخالفات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d968564d9290470da921f58721752b95\",\n      \"title\": \"المادة الثالثة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>المخالفات الجسيمة لأحكام النظام واللائحة هي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;الأفعال الواردة في المادة (الرابعة والعشرون) من النظام.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;الأفعال المرتبطة بالغش أو التضليل، أو التحايل أو الخيانة، وكانت عن قصد وعمد، أو ترتب عليها ضرر بالغ على صحة الإنسان، أو سلامته، أو الصحة العامة، أو البيئة، أو المرفق العام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f2c79532be5240679b89d5f7317de701\",\n      \"title\": \"المادة الرابعة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنظر لجنة النظر في مخالفات أحكام النظام واللائحة وإيقاع العقوبات، المخالفات المضبوطة، وتكون قواعد عملها وفق الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;تعقد اللجنة اجتماعاتها في المركز الرئيس للهيئة، أو إلكترونياً وفق ما تراه، ولها أن تعقد اجتماعاتها خارج الهيئة متى دعت الحاجة لذلك.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;لا تنعقد اجتماعات اللجنة إلا بحضور أغلبية أعضائها، على أن يكون من بينهم رئيس اللجنة أو نائبه.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;تعد اجتماعات اللجنة ومداولاتها سرية، ولا يجوز حضور غير أعضائها إلا بموافقة رئيس اللجنة.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يعد أمين اللجنة محضراً لكل اجتماع؛ يُدون فيه تاريخ انعقاده، ووقته، ومكانه، والحاضرون فيه، والمخالفات المنظورة، والإجراءات والوقائع المتداولة أثناء الاجتماع، والقرارات الصادرة، ويوقّع من رئيس اللجنة أو نائبه، والأعضاء الحاضرين.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;يجوز تحرير محضر الاجتماع، ورفعه، وتوقيعه إلكترونياً.<br>&nbsp; &nbsp; &nbsp;6 - &nbsp;على رئيس اللجنة تنظيم الأعمال والمهام بين الأعضاء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7724781d2b3d4a93be2cb64e1a88ce83\",\n      \"title\": \"المادة الخامسة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يجب على كل من نسبت إليه المخالفة -والأشخاص ذوي العلاقة- التعاون التام مع اللجنة في الكشف عن أي معلومات أو بيانات تطلبها اللجنة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;للجنة الاطلاع على جميع المعلومات المتعلقة بالمخالفة؛ بما فيها المعلومات السرية.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;تصدر اللجنة قرار إيقاع العقوبة متضمنًا الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; اسم المخالف، وبياناته الأساسية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; النص النظامي الذي تمت مخالفته، ووصف المخالفة المرتكبة، وملخص الوقائع ذات الصلة فيها، والدفوع المؤثرة المقدمة من المخالف، والرد عليها، ومنطوق القرار، وأسبابه.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; رقم القرار وتاريخه، وتوقيع رئيس اللجنة، أو نائبه.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; النص على حق المخالف في الاعتراض على قرار إيقاع العقوبة، وفقًا للإجراءات المنظمة لذلك.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; أي إضافة ترى اللجنة مناسبتها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌و- &nbsp; &nbsp; ويجوز تحرير القرار، ورفعه، وتوقيعه إلكترونيًا.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يعتمد الرئيس التنفيذي للهيئة قرار اللجنة، وتكون القرارات نافذة من تاريخ صدورها، ما لم يصدر أمر من المحكمة الإدارية بوقف تنفيذها.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;تتولى الهيئة من تلقاء نفسها أو بناء على طلب المخالف تصحيح ما يقع في قرارها من أخطاء مادية، وإذا وقع غموض أو إيهام في القرار؛ فإن للمخالف أن يطلب من الهيئة تفسيره.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/96b393e19a494ab2b2f10fbf564e605e\",\n      \"title\": \"المادة السادسة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يصرف لرئيس وأعضاء وأمين اللجنة مكافأة قدرها (2000) ألفي ريال عن كل اجتماع يحضره، على ألا تزيد عن (20.000) عشرين ألف ريال شهرياً لكل عضو.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يشترط لاستحقاق مكافأة اللجنة توفر الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; أن تباشر اللجنة أعمالها خارج وقت الدوام الرسمي.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ب- ألا يكون الرئيس أو العضو متفرغاً لأعمال اللجنة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a0445566f1e543c2821f9574a3302065\",\n      \"title\": \"المادة السابعة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يتحقق الإبلاغ بقرارات الهيئة أو لجنة النظر في المخالفات وإيقاع العقوبات بإحدى الوسائل الآتية:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;الرسائل النصية المرسلة عبر الهاتف المحمول الموثق.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;البريد الإلكتروني.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;أحد الحسابات المسجلة في أي من الأنظمة الآلية الحكومية.</p>\\n<p>&nbsp; &nbsp; &nbsp;4 - &nbsp;البريد المسجل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/03870778426b4c7988c9de0a1cc21b60\",\n      \"title\": \"المادة الثامنة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر المجلس جدولاً للمقابل المالي الذي تتقاضاه الهيئة لما تقدمه من خدمات بناء على أحكام النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/62b4acb46cac4479919914524ff91a9d\",\n      \"title\": \"المادة التاسعة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنشر اللائحة في الجريدة الرسمية</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fb0b635c66d04e91ac44f2e8493a4b41\",\n      \"title\": \"سجل قيد المطورين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b4e1245a274745bda4ca7ad33ef60198\",\n      \"title\": \"ترخيص وتنفيذ مشروعات البيع والتأجير على الخارطة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/582aedb1e7ce422194d9b9492e9cddb2\",\n      \"title\": \"تأخر وتعثر تنفيذ مشروعات البيع والتأجير على الخارطة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8f75845a2cd640019ffec7202f998623\",\n      \"title\": \"الإشراف والتفتيش والضبط\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8f562d2d946045b9ab88c17d7f66bd96\",\n      \"title\": \"أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":"اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة"}},"header":{"Value":{"#cdata-section":"اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة\",\n  \"بيع\",\n  \"بيع وتأجير\",\n  \"مشروعات\",\n  \"نظام بيع وتأجير مشروعات عقارية على الخارطة\",\n  \"اللوائح\",\n  \"الانظمة واللوائح والادلة\",\n  \"الهيئة العامة للعقار\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2024-05-17T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2024-04-29T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"لوائح\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":"اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة"}},"title":{"Value":{"#cdata-section":"اللائحة التنفيذية لنظام بيع وتأجير مشروعات عقارية على الخارطة"}}}}},"IsRoot":true},{"Key":"4a10e25b-d34b-30e1-b49d-810bdda7c1e2","Alias":"تنظيم الهيئة العامة للعقار","Path":"/cbb3c79a-7690-4525-b359-72b95f6baf0d.config","Level":5005,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/cbb3c79a-7690-4525-b359-72b95f6baf0d.config","Node":{"Content":{"@Key":"cbb3c79a-7690-4525-b359-72b95f6baf0d","@Alias":"تنظيم الهيئة العامة للعقار","@Level":"5","Info":{"Parent":{"@Key":"2e83ad93-6ff8-412f-961b-49003de4c4aa","#text":"الانظمة"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-08-05T10:16:04","NodeName":{"@Default":"تنظيم الهيئة العامة للعقار"},"SortOrder":"5","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"6653f60f-0211-4ee0-97da-e916ea1962de\",\n    \"mediaKey\": \"972bafff-fcf7-4be8-a970-87082380fe72\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/a2816cf02a0e41e3b37240e45b41ccbd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d0fb11d477584b689c95119762aa2cfd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/844cb67051c74ecea1e0fa763b1f6cc0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/597f21badaa444eda2c3166cf5049ff9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fe6aeba3f6db43baa342d547f4346a53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0832bbe4f5794729a58b6ddc0f75174c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd7da173c16b49eba1346db5d96837e8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7f96d084f58c4070aaf61872cea1ceed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8f5231fee492460f88613264a3e1ea8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a5e4a2ca9b348a1a34a001359bee2e4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7cd9ca0f4a624d5ea10ff1859dfe1969\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0f5b1855961142418997f989dd1e3a9c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1c1cb5882acb4110a8250d09851d40f4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac0c28264ea24e8b88df682235b85570\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ef8941defc2c499fbd80f449a8f0e106\"\n      },\n      {\n        \"contentUdi\": \"umb://element/67356307a0814eec925b97607270994f\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2816cf02a0e41e3b37240e45b41ccbd\",\n      \"title\": \"المادة الاولى\",\n      \"content\": {\n        \"markup\": \"<p>يقصد بالعبارات والمصطلحات الاتية - اينما وردت في هذا التننظيم- المعاني المبينة امامها، ما لم يقتض السياق خلاف ذلك:</p>\\n<p><strong>الوزير:</strong> وزير الشؤون البلدية والقروية للاسكان</p>\\n<p><strong>الهيئة: </strong>الهيئة العامة للعقار </p>\\n<p><strong>المجلس:</strong> مجلس ادارة الهيئة</p>\\n<p><strong>الرئيس:</strong> رئيس المجلس</p>\\n<p><strong>الرئيس التنفيذي: </strong>الرئيس التنفيذي للهيئة</p>\\n<p><strong>التنظيم:</strong> تنظيم الهيئة</p>\\n<p><strong>الرخصة:</strong> وثيقة تصدرها الهيئة تخول صاحبها مزاولة نشاط او اكثر من الانشكة التجارية</p>\\n<p><strong>الانشطة العقارية:</strong> عمل او مجموعة اعمال تنفذ لتوفير منتجات عقارية محددة، منها التطوير العقاري، والمساهمات العقارية، والبيع على الخارطة، ومزاولة خدمات الوساطة في بيع العقارات او شراؤها او تأجيرها</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d0fb11d477584b689c95119762aa2cfd\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>تتمتع الهيئة بالشخصية الاعتبارية والاستقلال المالي والاداري، وترتبط تنظيميا بالوزير، ويكون مقرها الرئيس في مدينة الرياض، ولها فتح فروع ومكاتب داخل المملكة بحسب الحاجة</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/844cb67051c74ecea1e0fa763b1f6cc0\",\n      \"title\": \"المادة الثالثة \",\n      \"content\": {\n        \"markup\": \"<p>الغرض الاساسي للهيئة هو التسجيل العيني للعقارات في المملكة، والعمل على تنظيم النشاط العقاري غير الحكومي والاشراف عليه وتطويره، لرفع كفايته، وتشجيع الاستثنار فيه بما يتفق مع اهداف التنمية الاقتصادية والاجتماعية. وتتمتع الهيئة - في سبيل تحقيق الغرض الذي أنشئت من اجله بجميع الصلاحيات اللازمة لذلك، ولها على وجه خاص ما يأتي:</p>\\n<p>1. اقتراح الأنظمة واللوائح والسياسات ذات العلاقة بالأنشطة العقارية، والرفع عنها لاستكمال ما يلزم في شأنها</p>\\n<p>2. وضع الخطط اللازمة لممارسة اختصاصها، والأشراف على تنفيذها</p>\\n<p>3. الترخيص للأنشطة العقارية، والأشراف عليها</p>\\n<p>4. وضع الضوابط والمعايير الخاصة بالانشطة العقارية</p>\\n<p>5. تنظيم المعارض العقارية، بالتنسيق مع الجهات ذات العلاقة</p>\\n<p>6. ًانفاذ اعمال التسجيل العيني للعقار، وفق ما هو مقرر نظاما</p>\\n<p>7. وضع اسس تحديد المقابل المالي للأنشطة العقارية بما لا يخل قواعد المنافسة</p>\\n<p>8. تشجيع الاستثمار في الانشطة العقارية، وتوفير البيئة المناسبة للمنافسة العادلة في هذا المجال</p>\\n<p>9. التنسيق مع الاجزة المعنية من أجل ضمان تكامل البنى التحتية للعقارات وتحقيق الأهداف والسياسات والأستراتيجيات الوطنية ذات العلاقة</p>\\n<p>10. عقد المؤتمرات والندوات واللقاءات المتعلقة بمجالات عمل الهيئة وفقا للضوابط المنظمة لذلك، والمشاركة في المعارض الدولية، وذلك بالتنسيق مع الجهات المعنية</p>\\n<p>11. نشر الوعي بأنظمة القطاع العقاري وانشطته</p>\\n<p>12. متابعة تنفيذ الاتفاقيات ذات الصلة بالعلاقة المبرمة بين المملكة والدول الأخرى، وذلك بالتنسيق مع الجهات المعنية</p>\\n<p>13. مراقبة مؤشرات القطاع العقاري بما يحقق له الاستقرار والتوازن</p>\\n<p>14. العمل على توفر التدريب والتأهيل اللازمين للمرخص لهم بمزاولة الانشطة العقارية وللعاملين في هذه الأنشطة</p>\\n<p>15. وضع الضوابط اللازمة لتنظيم الاعلانات العقارية التي تنشر في جميع الوسائل والرقابة عليها، بالنتسيق مع الجهات ذات العلاقة</p>\\n<p>16. اجراء البحوث والدراسات والاحصاءات في مجال الأنشطة العقارية</p>\\n<p>17. انشاء بوابة الكترونية تحتوي على قواعد للمعلومات العقارية اللازمة للأنشطة العقارية، سواء المتوافرة لدى الهيئة او الجهات الاخرى المعنية، مع تحديثها دورياً، واتاحتها للمعنيين</p>\\n<p>18. التنسيق مع الوزارة في شأن تمثيل المملكة في المنظمات والمنتديات الدولية والاقليمية ذات العلاقة باختصاصها، وذلك بحسب الأجراءات المتبعة</p>\\n<p>19. انشاء مراكز تدريب ذات صلة باختصاصاتها، وفقا للاجراءات النظامية</p>\\n<p>20. اسناد بعض الخدمات التي تقدمها الى القطاع الخاص، وفقاً للأجراءات النظامية</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/597f21badaa444eda2c3166cf5049ff9\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>يكون للهيئة مجلس ادارة برئاسة الوزير زعضوية كل من:\\n<ol>\\n<li>الرئيس التفيذي</li>\\n<li>ممثل من وزارة الشؤون البلدية والقروية والاسكان</li>\\n<li>ممثل من وزارة العدل</li>\\n<li>ممثل من وزارة المالية</li>\\n<li>ممثل من وزارة الاقتصاد والتخطيط</li>\\n<li>ممثل من وزارة الاستثمار</li>\\n<li>ممثل عن وزارة الصناعة والثروة المعدنية</li>\\n<li>ممثل من الهيئة العامة لعقارات الدولة</li>\\n<li>ممثل من الهيئة العامة للمساحات والمعلومات الجيومكانية</li>\\n<li>ثلاثة من القطاع الخاصذي العلاقة بنشاط الهيئة، يعينون بقرار من مجلس الوزراء بناء على اقتراح الوزير.</li>\\n</ol>\\n</li>\\n<li>يجب الا تقل مرتبة ممثلي الاجهزة الحكومية عن المرتبة (الرابعة عشرة) او ما يعادلها</li>\\n<li>اختيار الرئيس نائبا له من ممثلي الجهات الحكومية في المجلس</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fe6aeba3f6db43baa342d547f4346a53\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>المجلس هو السلطة العليا للهيئة، ويختص بالاشراف على شؤونها وادارتها وتصريف امورها، وله اتخاذ ما يلزم من قرارات واجراءات لتحقيق اغراضها في حدود احكام التنظيم، وله بصفة خاصة الصلاحيات والاختصاصات التالية:</p>\\n<ol>\\n<li>الاشراف على تنفيذ الهيئة للمهمات المنوطة بها</li>\\n<li>وضع السياسات التي تسير عليها الهيئة لتحقيق اغراضها، واعتماد الخطط والبرامج اللازمة لذلك، والاشراف على تنفيذها</li>\\n<li>اقرار اللوائح الادارية والمالية وغيرها من اللوائح الداخلية التي تسير عليها الهيئة، على ان يكون اقرار اللوائح الادارية بالاتفاق مع وزارة الموارد البشرية والتنمية الاجتماعية، واللوائح المالية والاحكام ذات الاثر المالي في اللوائح الادارية بالاتفاق مع وزارة المالية</li>\\n<li>اقرار الهيكل التنظيمي للهيئة</li>\\n<li>اقرار المقابل المالي للرخص التي تصدرها الهيئة، بالاتفاق مع وزارة المالية ومركز تنمية الايرادات غير النفطية</li>\\n<li>دون الاخلال بالاحكام النظامية ذات الصلة، يكون اقرار المقابل المالي الذي تتقاضاه الهيئة عن الاعمال والخدمات التي تقدمها، بالاتفاق مع وزارة المالية ومرك تنمية الايرادات غير النفطية</li>\\n<li>الموافقة على فتح فروع ومكاتب للهيئة داخل المملكة </li>\\n<li>الموافقة على توظيف اموال الهيئة بما يحقق اغراضها، واستثمار العقارات واستئجارها وفقاً للانظمة المتبعة</li>\\n<li>اقرار مشروع ميزانية الهيئة، وحسابها الختامي، وتقرير مراجع الحسابات، والتقرير السنوي، ورفع ما يلزم اعتماده بحيب الاجراءات النظامية المتبعة</li>\\n<li>قبول الهبات والاعانات والتبرعات والمنح والوصايا والاوقاف وفقا للانظمة المتبعة</li>\\n<li>الموافقة على ابرام الاتفاقيات والبروتوكولات والعقود وتفويض الرئيس التنفيذي بالتوقيع عليها بحسب الاجراءات المتبعة</li>\\n<li>النظر في التقارير الدورية التي تقدم سير العمل في الهيئة ومركزها المالي </li>\\n<li>اقرار قواعد منح المكافآت لمن يكفله المجلس </li>\\n<li>تعيين مراجع حسابات خارجي، ومراقب مالي داخلي</li>\\n<li>وضع برنامج لتحفيز التسجيل العيني للعقار</li>\\n</ol>\\n<p>وللمجلس تفويض رئيسه اونائبه او من يراه من اهضائه في بعض صلاحياته</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0832bbe4f5794729a58b6ddc0f75174c\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>تعقد اجتماعات المجلس في مقر الهيئة بدعوة من الرئيس، ويجوز عند الاقتضاء عقدها في مكان اخر داخل المملكة</li>\\n<li>يعقد المجلس اجتماعاته بصفة دورية اربع مرات في السنة، وللرئيس دعوته للاجتماع متى دعت الحاجة الى ذلك او متى طلب ذلك ثلاثة اعضاء على الاقل</li>\\n<li>يكون اجتماع المجلس صحيحا ذا حضره اغلبية الاعضاء بمن فيهم الرئيس او نائبه، وتصدر القرارات باغلبية اصوات الاعضاء الحاضرين، وفي حال تساوي الاصوات يرجح الجانب الذي صوت معه رئيس الاجتماع</li>\\n<li>تثبت مداولات المجلس وقراراته في محاضر يوقعها رئيس الاجتماع والاعضاء الحاضرون</li>\\n<li>‏لا يجوز لعضو المجلس الامتناع عن التصويت أو تفويض عضو آخر بالتصويت عنه عند غيابه ولالعضو المعترض تسجيل اعتراضه وأسباب به ضمن محضر اجتماع المجلس</li>\\n<li>‏لا يجوز للعضو أن يفشي شيئاً مما وقف عليه من أسرار الهيئة بسبب عضويته في المجلس</li>\\n<li>‏للمجلس دعوة من يرى الاستعانة بهم من المختصين والمستشارين لحضور اجتماعاته دون أن يكون لهم حق التصويت</li>\\n<li>‏يكون للمجلس أمين من بين منسوبي الهيئة يختاره الرئيس بناء على ترشيح الرئيس التنفيذي، يتولى أمانة المجلس والإعداد للاجتماعات وتسجيل المداولات والقرارات</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dd7da173c16b49eba1346db5d96837e8\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>‏للمجلس أن يشكل لجانا دائما أو مؤقته من بين أعضائه أو من غيرهم، ويعهد إليها بما يراه من مهمات، ويحدد في قرار تشكيل كل لجنة رئيسها وأع أعضاؤها واختصاصاتها، ويكون لها الإستعانه بمن تراه لتأدية المهمات المكلفة بها</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7f96d084f58c4070aaf61872cea1ceed\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>‏يكون للهيئة رئيس تنفيذي يعين ويعفى بقرار من المجلس بناء على ترشيح من الرئيس، ويحدد القرار أجره ومزايا المالية الأخرى</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8f5231fee492460f88613264a3e1ea8b\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>‏يكون الرئيس التنفيذي المسؤول عن إدارة الهيئة، ‏وتترك مسؤولياته في حدود ما ينص عليه التنظيم وما يقرره المجلس، ويمارس بوجه خاص الصلاحيات والمهمات الآتية:</p>\\n<ol>\\n<li>الإشراف على سير العمل في الهيئة من خلال اللوائح والخطط والبرامج المعتمدة.</li>\\n<li><span><span lang=\\\"AR-SA\\\">اقتراح السياسات العامة للهيئة، المتعلقة بأنشطتها، والخطط والبرامج اللازمة لتنفيذ ذلك، ورفعها إلى المجلس</span>.</span></li>\\n<li><span>إعداد مشروع ميزانية الهيئة السنوية ومشروع حسابها الختامي، ورفعهما إلى المجلس.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الموافقة على إصدار الرخص التي تدخل في اختصاص الهيئة</span>.</span></li>\\n<li><span>تمثيل الهيئة لدى الجهات الحكومية والمؤسسات والهيئات الأخرى ذات العلاقة وغيرها من الجهات داخل المملكة وخارجها وأمام القضاء.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الصرف من الميزانية المعتمدة، واتخاذ جميع الإجراءات المالية وفقاً للأنظمة واللوائح المقرة والصلاحيات التي منحها إياه المجلس</span>.</span></li>\\n<li><span>إعداد التقارير الخاصة بتنفيذ خطط الهيئة وبرامجها، ودراستها، وعرضها على المجلس.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">إعداد التقرير السنوي عن نشاط الهيئة والعقبات التي واجهتها واقتراح الحلول المناسبة لها، وتقديمه إلى المجلس للنظر فيه ورفعه إلى الجهات المختصة بعد اعتماده من المجلس</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">التوقيع على الاتفاقيات والبروتوكولات والعقود بعد موافقة المجلس بحسب الإجراءات المتبعة</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">تنظيم مشاركة الهيئة في المؤتمرات والندوات واللقاءات والمعارض المتعلقة بمجالات عمل الهيئة محليًّا وإقليميًّا ودوليًّا</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">إصدار القرارات اللازمة لتنفيذ أحكام التنظيم واللوائح الصادرة بناءً عليه والقواعد والإجراءات المعتمدة، بحسب الصلاحيات المخولة له</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">تشكيل لجان عمل داخلية (دائمة أو مؤقتة) وفقاً لما تقضي به اللوائح والإجراءات المعتمدة لدى الهيئة</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الاستعانة بالخبراء والمستشارين المتخصصين الذين تحتاج إليهم الهيئة</span>.<br><!--[endif]--></span>\\n<p style=\\\"line-height: 150%; direction: rtl; unicode-bidi: embed; text-align: right;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وللرئيس التنفيذي أن يفوض بعض اختصاصاته إلى من يراه من منسوبي الهيئة</p>\\n</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a5e4a2ca9b348a1a34a001359bee2e4\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>تنشأ - بموافقة المجلس - مراكز للخدمة الشاملة في مقر الهيئة وفروعها التي ترى الهيئة ضرورة إنشاء تلك المراكز فيها.</li>\\n<li>تقوم جميع الجهات الحكومية وغير الحكومية التي يتطلب الأمر تمثيلها في تلك المراكز بتحديد من يمثلها للعمل في تلك المراكز، وعلى تلك الجهات تفويض ممثليها بممارسة الصلاحيات التي تضمن سرعة تقديم الخدمات بما في ذلك إصدار الشهادات والتصاريح والتراخيص للأنشطة التي تدخل ضمن اختصاص تلك الجهات.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7cd9ca0f4a624d5ea10ff1859dfe1969\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- تتكون موارد الهيئة المالية مما يأتي:</p>\\n<p>أ - ما يخصص لها في الميزانية العامة للدولة.<br>ب - المقابل المالي للرخص التي تصدرها.<br>ج - المقابل المالي الذي تتقاضاه عن الخدمات والأعمال التي تقدمها للغير مما يدخل ضمن اختصاصها، وفقاً للأنظمة، واللوائح والقرارات التي يعتمدها المجلس.</p>\\n<p>د - الإيرادات المتحصلة من عوائد استغلال واستثمار أصولها وأموالها.<br>هـ - ما يقبله المجلس من هبات وإعانات وتبرعات ومنح ووصايا وأوقاف.<br>و - أي مورد آخر يقره المجلس.</p>\\n<p>2- تودع أموال الهيئة في حساب خاص بها في مؤسسة النقد العربي السعودي، وللهيئة عند الحاجة فتح حسابات في البنوك المرخص لها بالعمل في المملكة، ويصرف من هذه الأموال وفق ميزانية الهيئة المعتمدة.</p>\\n<p>3- تؤول الأموال الفائضة عن حاجة الهيئة خلال السنة المالية إلى الخزينة العامة للدولة لحساب جاري وزارة المالية، وذلك بعد اقتطاع جميع النفقات الجارية ونفقات رأس المال وغيرها من المصروفات التي تحتاج إليها الهيئة، وما تحتاج إليه لتمويل مشروعاتها المستقبلية المقرة في ميزانيتها السنوية وللوفاء بالتزاماتها النظامية، وذلك دون الإخلال بشرط الواقف فيما يتعلق بالأوقاف.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0f5b1855961142418997f989dd1e3a9c\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تعامل الهيئة من حيث إعفاء مستورداتها من الرسوم الجمركية بحسب القواعد المتبعة في شأن مستوردات المؤسسات العامة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1c1cb5882acb4110a8250d09851d40f4\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li class=\\\"MsoNormal\\\" style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\">&nbsp;تكون للهيئة ميزانية سنوية مستقلة، تصدر وفقاً لترتيبات إصدار الميزانية العامة للدولة.</li>\\n<li class=\\\"MsoNormal\\\" style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\">السنة المالية للهيئة هي السنة المالية للدولة، واستثناءً من ذلك تبدأ السنة المالية الأولى من تاريخ نفاذ التنظيم، وتنتهي بنهاية السنة المالية التالية للدولة.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ef8941defc2c499fbd80f449a8f0e106\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع عدم الإخلال باختصاص ديوان المراقبة العامة بالرقابة على حسابات الهيئة وعملياتها، يعين المجلس مراجع حسابات خارجيًّا (أو أكثر) من المرخص لهم بالعمل في المملكة، لتدقيق حسابات الهيئة ومعاملاتها وبياناتها وميزانيتها السنوية وحسابها الختامي، ويحدد المجلس أتعابه. ويرفع تقرير مراجع الحسابات إلى المجلس، ويزود ديوان المراقبة العامة بنسخة منه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/67356307a0814eec925b97607270994f\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ينشر التنظيم في الجريدة الرسمية، ويعمل به من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac0c28264ea24e8b88df682235b85570\",\n      \"title\": \"المادة الثالثة عشرة مكرر\",\n      \"content\": {\n        \"markup\": \"<p>يخضع منسوبو الهيئة لاحكام نظام العمل ونظام التأمينات الاجتماعية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"header":{"Value":{"#cdata-section":"تنظيم الهيئة العامة للعقار"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"تنظيم\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"الانظمة واللوائح والادلة\",\n  \"الانظمة\",\n  \"تنظيم الهيئة العامة للعقار\"\n]"}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"تنظيم الهيئة العامة للعقار"}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2017-02-03T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2017-01-23T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"أنظمة\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"subContent":{"Value":{"#cdata-section":"تنظيم الهيئة العامة للعقار"}},"title":{"Value":{"#cdata-section":"تنظيم الهيئة العامة للعقار"}}}}},"IsRoot":true},{"Key":"96f7e638-bed0-3832-9bc5-b0d595a9cdca","Alias":"اللائحة التنفيذية لنظام ملكية الوحدات العقارية وفرزها وإدارتها","Path":"/5e06fdb9-5435-41a4-b482-14f9831a44f6.config","Level":5006,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/5e06fdb9-5435-41a4-b482-14f9831a44f6.config","Node":{"Content":{"@Key":"5e06fdb9-5435-41a4-b482-14f9831a44f6","@Alias":"اللائحة التنفيذية لنظام ملكية الوحدات العقارية وفرزها وإدارتها","@Level":"5","Info":{"Parent":{"@Key":"c332c79b-387d-428b-9194-0910837a19e6","#text":"اللوائح"},"Path":"/////","Trashed":"false","ContentType":"regulationsItem","CreateDate":"2024-08-04T18:02:49","NodeName":{"@Default":"اللائحة التنفيذية لنظام ملكية الوحدات العقارية وفرزها وإدارتها"},"SortOrder":"6","Published":{"@Default":"false"},"Schedule":null,"Template":{"@Key":"eaee8fab-a8e4-4571-bdf1-b6f5703a397f","#text":"RegulationsItem"}},"Properties":{"attachedFile":{"Value":{"#cdata-section":"[\n  {\n    \"key\": \"665dbeb2-8d07-4fc0-85e2-21f84eda04bc\",\n    \"mediaKey\": \"967b3ab8-b5bf-4ee0-92e8-4c2a8495b896\"\n  }\n]"}},"contentItems":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/d6935561819b44a189e1e35d07948cda\"\n      },\n      {\n        \"contentUdi\": \"umb://element/abf37e98567c4a848c50fcf334d49b1c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0589f844c69e4310bc89461552d536e3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4404aceff2c34711afa8f42eb4890fee\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6fffb44728324bc7b48988147dba7742\"\n      },\n      {\n        \"contentUdi\": \"umb://element/544052da8c224198b3e2204faa80927d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/eb7a93f7be014cd1a8ed6cf672cbc937\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e0cf7292f4754e8a879b6bd60d1679c0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f45823499de04d4bbaf3cbe719a73c83\"\n      },\n      {\n        \"contentUdi\": \"umb://element/82d59ad32a894ab19306f8eddd8e5df6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aaf0d2843345414c8d9388e433e554bc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4d7544172442414c98063b29fe4c0524\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b3443891c4d84603a25552148fb17eb1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2e1bb879faf04fc9a69e094256e73afc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/683e930b02a04f92b98ba7910d02839a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/959674a7df4c47228cb68764412a030a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3c8865292987477a8bc13d1d49906b1f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/def99987884046068183b13d1dbc56c1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ff59834158654a52b9bf77595fdc64d0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/82befcd6577949a5a82ea7b133a0dd8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/caaa5b842a134e578860ee054065e983\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0659fb2f782e40a492ceaeca5248029f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73cc710f309649b996faa5951bb0abea\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9d7bc83e7c6f4cbaa2665d2f7b98279d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/de6f2e3006024112a2f408c6f9731b4f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/705ddfcf52cf48c8a8e5166bab4544a5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ece882b49ca54a5798034d6f99555dc2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7cdbe896706e4ad89a97f585fdbbcc78\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ebd99b59bc164675b2318e850ebc2753\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5ca4d44595b34fc5b6b3cb8d3905f9e7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ff41d628344a4131af0cde729eb70627\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d349cc5dcd2b4cd6b0ed3851487eaeb8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d0228e63d9d742f4b8ef556e0797343f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4f60cd0a74374a28aa35bb14c4ac5434\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d717102ba23d47c89d5527115605eeeb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/df16a21e3f424e40b1cc21c0b1d9ab92\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ab342b01320e4799a50f1f6c4f482479\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8b328983d89c49d8b9b765fcc7e7c1c4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e87cbd3e4511484fb6460c11e2b705f4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0d65d49f7f694371926db0a1ecb1ae69\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6ad6e48abadf46e4bf5db177fe9aba80\"\n      },\n      {\n        \"contentUdi\": \"umb://element/980b2f3ff2084d84bad6d9eb37aac3d9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/569cfa84031e42dd863bd53430f3a325\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5cec6a75371c43d4ad2e343a55570df8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/49114118e5c3499f874f93b77f3d2906\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dc8ddb964cc54b5b862a5344db643aa5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d0979854b6a34dd6a11578ad912c6df4\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/abf37e98567c4a848c50fcf334d49b1c\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>1- يكون للكلمات والعبارات الواردة في هذه اللائحة المعاني المبينة أمام كل منها في المادة (الأولى) من نظام ملكية الوحدات العقارية وفرزها وإدارتها، الصادر بالمرسوم الملكي رقم (م/85) وتاريخ 2/7/1441ه، ما لم يقتض السياق غير ذلك.</p>\\n<p>2- يقصد بالكلمات والعبارات الآتية -أينما وردت في اللائحة- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\n<p><strong>النظام الأساسي:</strong> النظام الأساسي لجمعية الملاك أو النظام الأساسي لجمعية المجمع أو كلاهما؛ بحسب السياق.</p>\\n<p><strong>الجمعية العامة:</strong> الجمعية العامة لجمعية الملاك أو الجمعية العامة لجمعية المجمع أو كلاهما؛ بحسب السياق.</p>\\n<p><strong>إعادة الفرز:</strong> إجراء بموجبه يتم تقسيم الوحدة أو الوحدات العقارية المفرزة أو العقار المشترك أو المجمع العقاري أو أي جزء من أي منها. سواءً كان التقسيم بالتجزئة أو الدمج أو الإضافة أو غيرها.</p>\\n<p><strong>البيع أو التأجير على الخارطة:</strong> بيع أو تأجير وحدة عقارية مفرزة قبل استكمال تشييدها.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4404aceff2c34711afa8f42eb4890fee\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>1- تُميز العقارات المشتركة من خلال عنوانها الوطني المعتمد من الجهة المختصة.</p>\\n<p>2- تُميز الوحدات العقارية المفرزة من خلال رقم تسلسلي، وفقاً لنماذج تعتمدها الهيئة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6fffb44728324bc7b48988147dba7742\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بحق المتضرر في اللجوء إلى المحكمة المختصة، تستمر إجراءات إعادة فرز العقار المشترك أو المجمع العقاري أو جزء منهما أو تغيير استعمالاتهما ما لم يصدر بذلك أمر إيقاف من المحكمة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/544052da8c224198b3e2204faa80927d\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>1- يشترط في الفرز أو إعادة الفرز توفر ما يلي:</p>\\n<p>أ- صك الملكية، مستوف للمتطلبات الشرعية والنظامية، وما يتبعه من حقوق والتزامات.</p>\\n<p>ب- بيانات العقار أو العقار المشترك أو المجمع العقاري أو الجزء من العقار المشترك أو المجمع العقاري -بحسب الأحوال- بما في ذلك: عنوانه، ومساحته، ومرافقه إن وجدت، وأي بيانات أخرى تطلبها الهيئة.</p>\\n<p>ج- الرخص والتراخيص والفسوحات؛ الصادرة من الجهات المختصة.</p>\\n<p>د- تقرير مساحي من مكتب هندسي مرخص، ومعتمد من الهيئة؛ يتضمن تحديد ما يخص كل وحدة عقارية مفرزة من الأرض والأجزاء المشتركة، بناءً على نسبة مساحة كل وحدة عقارية مفرزة إلى إجمالي مساحة الوحدات العقارية المفرزة، أو قيمة تلك الوحدة ومساحتها إلى إجمالي قيمة الوحدات العقارية المفرزة ومساحتها، بحسب الأحوال.</p>\\n<p>هـ- ما يثبت موافقة الملاك أو جمعية الملاك أو جمعية المجمع -بحسب الأحوال- على تقرير المكتب الهندسي المشار إليه في الفقرة (1/د) من هذه المادة.</p>\\n<p>و- ما يثبت موافقة المرتهن، إن وجد.</p>\\n<p>ز- ما يثبت موافقة مالك الوحدة العقارية المفرزة إذا تضمن إعادة الفرز تغيراً في مساحة وحدته أو نسبته من الأجزاء المشتركة أو مساحته المشاعة من الأرض.</p>\\n<p>ولمجلس إدارة الهيئة بقرار منه أن يعدل بعض المتطلبات المشار إليها في هذه الفقرة.</p>\\n<p>2- على الجهة المختصة بالفرز أو إعادة الفرز البت في الطلب المشار إليه في الفقرة رقم (1) من هذه المادة خلال (عشرة) أيام من تاريخ استكمال المتطلبات المشار إليها في الفقرة نفسها.</p>\\n<p>3- في حال الموافقة على الطلب المشار إليه في الفقرة رقم (1) من هذه المادة؛ تعتمد الهيئة - أو من تسند له ذلك - الفرز وإعادة الفرز، وتصدر وثيقة بذلك تتضمن البيانات التي تحددها الهيئة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/eb7a93f7be014cd1a8ed6cf672cbc937\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>ينسق رئيس مجلس إدارة الهيئة مع وزير العدل لوضع آلية لاعتماد البيانات الواردة في وثيقة الفرز ووثيقة إعادة الفرز ووثائق الأجزاء المشتركة في صك ملكية العقار المشترك أو المجمع العقاري أو الوحدة العقارية المفرزة، بحسب الأحوال.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e0cf7292f4754e8a879b6bd60d1679c0\",\n      \"title\": \" المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الهيئة دليلاً فنياً يتضمن المواصفات والمعايير الفنية لفرز وإعادة فرز العقارات والوحدات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/82d59ad32a894ab19306f8eddd8e5df6\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>1- يجب أن يتضمن بيان الإفصاح -المشار إليه في المادة (السادسة) من النظام- جميع المعلومات الخاصة بمواصفات الوحدة العقارية المفرزة وملاحقها، وجميع حقوق المالك والتزاماته المرتبطة بها، ووصفاً كافياً للعقار المشترك والمجمع العقاري الذي تقع فيهما تلك الوحدة، ومحتوياتهما وإدارتهما وتنظيم ملكيتهما؛ ومن تلك المعلومات الآتي:</p>\\n<p>أ- عنوان الوحدة.</p>\\n<p>ب- مساحة الوحدة.</p>\\n<p>ج- مخطط الوحدة.</p>\\n<p>د- حصة الوحدة في الأجزاء المشتركة.</p>\\n<p>ه- ملاحق الوحدة، إن وجدت.</p>\\n<p>و- المحتويات الثابتة والمنقولة للوحدة.</p>\\n<p>ز- نسخة من النظام الأساسي لجمعية الملاك، ومن النظام الأساسي لجمعية المجمع، ومن قرارات الجمعية العامة؛ إن وجدت.</p>\\n<p>ح- عقود الرهن، أو الانتفاع بما في ذلك الإيجار؛ الخاصة بالوحدة أو بالعقار المشترك أو بالمجمع العقاري، إن وجدت.</p>\\n<p>ط- القيود على استخدام أي من الأجزاء المشتركة.</p>\\n<p>ي- العيوب الخاصة بالوحدة أو بالعقار المشترك أو بالمجمع العقاري، إن وجدت.</p>\\n<p>ك- التاريخ المتوقع لبدء تشييد المشروع والانتهاء منه، في حالة البيع أو التأجير على الخارطة.</p>\\n<p>ويتم إشعار الراغب بالشراء بأي تغيير قد يطرأ على تلك المعلومات بالوسيلة وعلى العنوان الذين يتم الاتفاق عليهما بينه وبين المالك.</p>\\n<p>2- يعد بيان الإفصاح المشار إليه في الفقرة (1) من هذه المادة جزءاً لا يتجزأ من عقد البيع المدون لدى جهة التوثيق المختصة.</p>\\n<p>3- تعد الهيئة نماذج لبيان الإفصاح المشار إليه في الفقرة (1) من هذه المادة.</p>\\n<p>4- يكون النظر في حق المشتري في الفسخ الوارد في المادة (السادسة/2) من النظام من اختصاص المحكمة المختصة وفق المدة المنصوص عليها.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aaf0d2843345414c8d9388e433e554bc\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يعد من الأجزاء المشتركة -وفقاً لأحكام النظام واللائحة- الآتي:</p>\\n<p>1- أي عناصر إنشائية تمر من خلال وحدة عقارية مفرزة.</p>\\n<p>2- الأنظمة الميكانيكية والكهربائية والكهروميكانيكية ونحوها الواقعة ضمن الوحدة العقارية المفرزة، أو المشتركة مع وحدات عقارية أخرى</p>\\n<p>3- أي جزء من البنية التحتية للخدمات العامة الواقعة في العقار المشترك أو المجمع العقاري، ما لم يكن ذلك الجزء عائد نظاماً أو تعاقداً إلى مقدم خدمة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b3443891c4d84603a25552148fb17eb1\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1- للملاك في العقارات المشتركة التي تقع ضمن مجمع عقاري إنشاء جمعية للمجمع لغرض إدارة جميع شؤون ذلك المجمع الواقعة خارج نطاق اختصاص جمعيات الملاك، وذلك وفقاً لأحكام النظام واللائحة والنظام الأساسي.</p>\\n<p>2- يكون لجمعية المجمع نظام أساسي لضمان حسن الانتفاع بالمجمع العقاري وحسن إدارته بما لا يتعارض مع أحكام النظام واللائحة، ويعد توافره شرطاً لتسجيل الجمعية.</p>\\n<p>3- لا يؤثر انقضاء جمعية المجمع في مسؤوليتها عن ديونها والتزاماتها السابقة لتاريخ انقضائها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2e1bb879faf04fc9a69e094256e73afc\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- على ملاك الوحدات العقارية المفرزة في عقار مشترك -أو من يمثلهم- التقدم إلى الهيئة - أو من تسند له ذلك - بطلب تسجيل جمعية الملاك حال تأسيسها وفقاً لأحكام النظام واللائحة، خلال (ثلاثين) يوماً من تاريخ التأسيس، وإلا جاز لأي منهم التقدم بطلب التسجيل.</p>\\n<p>2- على الملاك في المجمع العقاري -أو من يمثلهم- التقدم إلى الهيئة - أو من تسند له ذلك - بطلب تسجيل جمعية المجمع حال إنشائها وفقاً لأحكام النظام واللائحة.</p>\\n<p>3- يشترط لتسجيل جمعية الملاك أو جمعية المجمع توافر المتطلبات الآتية:</p>\\n<p>أ- بيانات ملاك الوحدات العقارية المفرزة في العقارات المشتركة ومن يمثلهم إن وجدوا؛ التي تحددها الهيئة.</p>\\n<p>ب- بيانات العقار المشترك أو المجمع العقاري -بحسب الأحوال- التي تحددها الهيئة، بما في ذلك العنوان الوطني ورقم صك الملكية.</p>\\n<p>ج- النظام الأساسي.</p>\\n<p>د- أسماء أعضاء الجمعية العامة وقت التسجيل.</p>\\n<p>ه- أي متطلب آخر تحدده الهيئة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/683e930b02a04f92b98ba7910d02839a\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تعد الهيئة سجلاً خاصاً لقيد جمعيات الملاك وجمعيات المجمع. وفيما عدا ذلك، للهيئة إسناد إجراءات التسجيل إلى القطاع الخاص. ولا تكتسب تلك الجمعيات الشخصية المعنوية المستقلة إلا بعد تسجيلها وفقاً لأحكام النظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/959674a7df4c47228cb68764412a030a\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تتولى الهيئة -في حدود اختصاصاتها- تنظيم أعمال وشؤون جمعيات الملاك وجمعيات المجمع دون إخلال بأحكام النظام واللائحة، ولها في سبيل ذلك القيام بالآتي:</p>\\n<p>1- إصدار الترتيبات والقرارات اللازمة لحوكمة جمعيات الملاك وجمعيات المجمع، وتكون تلك القرارات والترتيبات ملزمة لتلك الجمعيات.</p>\\n<p>2- تقديم الدعم والمشورة لجمعيات الملاك وجمعيات المجمع.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3c8865292987477a8bc13d1d49906b1f\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>على جمعيات الملاك وجمعيات المجمع تزويد الهيئة بأي معلومات تطلبها في حدود اختصاصاتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/def99987884046068183b13d1dbc56c1\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>على جمعيات الملاك وجمعيات المجمع تزويد الهيئة بأي معلومات تطلبها في حدود اختصاصاتها.</p>\\n<p>مع مراعاة ما ورد في الفقرة (4) من المادة (الثانية عشرة) من النظام، يجب أن يشتمل النظام الأساسي -دون إخلال بأحكام النظام- الأحكام الآتية:</p>\\n<p>1- اختصاصات الجمعية العامة وقواعد عملها.</p>\\n<p>2- إجراءات الدعوة إلى اجتماعات الجمعية العامة، وتحديد النصاب اللازم لصحة انعقادها ولاتخاذ القرارات.</p>\\n<p>3- الشروط اللازم توافرها في المدير، وقواعد تعيينه، وتحديد صلاحياته، وطريقة عمله، وأجره إن وجد.</p>\\n<p>4- قواعد التوقيع على العقود وغيرها من الالتزامات المالية.</p>\\n<p>5- إجراءات إبراء ذمة المدير.</p>\\n<p>6- الأحكام المتعلقة باستعمال الأجزاء المشتركة وإدارتها.</p>\\n<p>7- قواعد السلوك العام في العقار المشترك أو المجمع العقاري.</p>\\n<p>8- قواعد تحديد مبلغ اشتراكات الملاك وآلية سدادها.</p>\\n<p>9- تحديد بداية السنة المالية للجمعية ونهايتها، وقواعد الصرف من ميزانية الجمعية، وأساليب المراقبة المالية.</p>\\n<p>10- حكماً يشترط موافقة مالك الوحدة العقارية المفرزة لصحة قرار الجمعية العامة بإعادة الفرز في حال ترتب عليه إعادة فرز وحدته.</p>\\n<p>11- القواعد والإجراءات التي تحكم استثمار أموال جمعية الملاك وجمعية المجمع والأجزاء المشتركة القابلة للاستثمار.</p>\\n<p>12- القواعد التي تتبع عند انقضاء الجمعية، وإجراءات تصفيتها.</p>\\n<p>13- إجراءات تعديل النظام الأساسي.</p>\\n<p>ويجوز لجمعية الملاك وجمعية المجمع -بحسب الأحوال- تضمين النظام الأساسي أحكاماً إضافية، بما لا يتعارض مع أحكام النظام واللائحة والقرارات الصادرة من الهيئة تنفيذاً لهما.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ff59834158654a52b9bf77595fdc64d0\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- على من تقدم بطلب تسجيل جمعية الملاك أو جمعية المجمع -بحسب الأحوال- دعوة جميع الأعضاء في الجمعية العامة خلال (خمسة) أيام من تاريخ تسجيل الجمعية، وذلك وفقاً للأحكام المنظمة لعقد الاجتماعات في النظام الأساسي، على ألا تقل المدة بين تاريخ الدعوة وتاريخ الانعقاد عن (خمسة) أيام.</p>\\n<p>2- تنظر الجمعية العامة وتتخذ القرارات اللازمة في اجتماعها الأول حيال الموضوعات الآتية:</p>\\n<p>أ- النظام الأساسي.</p>\\n<p>ب- انتخاب رئيس الجمعية.</p>\\n<p>ج- تعيين المدير ما لم يتم الاتفاق على تأجيل التعيين للاجتماع الثاني.</p>\\n<p>د- الأعمال والنفقات التي اقتضاها تأسيس أو إنشاء الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/82befcd6577949a5a82ea7b133a0dd8b\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تعد جمعية المجمع ممثلةً للملاك فيما يتعلق بالتصرفات التي تنشأ على الأجزاء المشتركة في المجمع العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/caaa5b842a134e578860ee054065e983\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بحكم المادة (السادسة) من النظام وحكم المادة (السابعة) من اللائحة، يعد امتلاك وحدة عقارية مفرزة في عقار مشترك واقع ضمن مجمع عقاري -مؤسسة له جمعية مجمع- قبولاً من المالك بالنظام الأساسي لجمعية المجمع، والتزاماً منه بالقرارات التي تصدرها الجمعية العامة لتلك الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0659fb2f782e40a492ceaeca5248029f\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ليس لجمعية المجمع أن تحد أو أن تقيد من حقوق أو اختصاصات أي من الملاك أو جمعيات الملاك الأعضاء فيها في حدود ما لهم بموجب النظام أو اللائحة أو النظام الأساسي لجمعية الملاك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73cc710f309649b996faa5951bb0abea\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تكون لجمعية المجمع جمعية عامة تضم ممثلاً أو أكثر عن جمعية الملاك في كل عقار مشترك يقع ضمن المجمع العقاري، أو عن الملاك إذا لم يكن أنشئ للعقار المشترك جمعية ملاك؛ وذلك وفق آلية يحددها النظام الأساسي.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9d7bc83e7c6f4cbaa2665d2f7b98279d\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>للهيئة -في حدود اختصاصاتها- اتخاذ ما تراه حال عدم تمكن الجمعية العامة من الانعقاد أو إصدار القرارات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/de6f2e3006024112a2f408c6f9731b4f\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- يتولى إدارة المجمع العقاري مدير من الملاك أو من غيرهم، وفقاً للأحكام المنصوص عليها في النظام الأساسي.</p>\\n<p>2- تلتزم جمعية المجمع بكل تصرف يجريه المدير باسم الجمعية وفي حدود أغراضها.</p>\\n<p>3- للمدير بقرار مكتوب منه أن يفوض بعض صلاحيته إلى غيره في مباشرة عمل أو أعمال محددة.</p>\\n<p>4- يكون المدير مسؤولاً عن تعويض جمعية المجمع عن الضرر الذي ينشأ عن مخالفته أحكام النظام أو اللائحة أو النظام الأساسي. وتقع المسؤولية على جميع المديرين<br>-في حال تعددوا- إذا نشأ ذلك الضرر بسبب قرار صدر بإجماعهم. أما القرارات التي تصدر بأغلبية الآراء، فلا يسأل عنها المديرون المعارضون متى أثبتوا اعتراضهم صراحة في محضر الاجتماع الذي صدر فيه القرار. ولا يعد الغياب عن حضور الاجتماع سبباً للإعفاء من المسؤولية إلا إذا ثبت عدم علم المدير الغائب بالقرار أو عدم تمكنه من الاعتراض عليه بعد علمه به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/705ddfcf52cf48c8a8e5166bab4544a5\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>للمالك الذي بنى العقار المشترك الانفراد بتعيين المدير، على أن يلتزم بالمحافظة على ملكية نسبة لا تقل عن (10%) عشرة في المائة من عدد الوحدات العقارية المفرزة في العقار المشترك، بالإضافة إلى الآتي:</p>\\n<p>1- ألا تقل عدد الوحدات العقارية المفرزة في العقار المشترك عن (100) مائة وحدة.</p>\\n<p>2- أي شروط أخرى تضعها الهيئة.</p>\\n<p>ويعد من بنى العقار - في حكم هذه المادة - المالك الذي تقدم لأول مرة بطلب فرز العقار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ece882b49ca54a5798034d6f99555dc2\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأحكام النظام واللائحة، ومع مراعاة ما يتضمنه النظام الأساسي وما يصدر من الجمعية العامة من قرارات؛ يتخذ المدير ما يلزم لإدارة العقار المشترك أو المجمع العقاري -بحسب الأحوال- وله بصفة خاصة الصلاحيات الآتية:</p>\\n<p>1- توفير المواد والخدمات والأعمال اللازمة للعقار المشترك أو للمجمع العقاري ولصيانتهما، والإشراف على التنفيذ وعلى العاملين والمقاولين المتعاقد معهم لتقديمها.</p>\\n<p>2- تحصيل اشتراكات الملاك وغيرها من موارد الجمعية المقرة نظاماً.</p>\\n<p>3- الصرف من الميزانية المعتمدة، واتخاذ جميع الإجراءات المالية وفقاً للصلاحيات الممنوحة له.</p>\\n<p>4- التنسيق مع رئيس الجمعية العامة للدعوة لاجتماعاتها.</p>\\n<p>5- تمثيل جمعية الملاك أو جمعية المجمع -بحسب الأحوال- لدى الجهات الحكومية أو الخاصة أو لدى الغير.</p>\\n<p>6- أي مهمات أخرى تكلفه بها الجمعية العامة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7cdbe896706e4ad89a97f585fdbbcc78\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تعتمد الهيئة قرارات المدير وعقود التعاملات التي يبرمها، المشار إليها في المادة (الحادية والعشرين) من النظام، وفق الضوابط والإجراءات الآتية:</p>\\n<p>1- ألا يكون هو أو أحد أقربائه حتى الدرجة (الرابعة) له مصلحة مباشرة في القرارات أو العقود.</p>\\n<p>2- أن تكون القرارات والعقود في حدود الصلاحيات المخولة له بموجب النظام أو اللائحة أو النظام الأساسي.</p>\\n<p>3- أي ضابط أو إجراء آخر تضعه الهيئة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ebd99b59bc164675b2318e850ebc2753\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن يؤدي المدير أعماله بأمانة وإخلاص، وأن يراعي مصالح العقار المشترك أو المجمع العقاري -بحسب الأحوال- وألا يترتب على تلك الأعمال تعارض في المصالح.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5ca4d44595b34fc5b6b3cb8d3905f9e7\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- للهيئة إخطار المدير في حال تبين لها تقصير من قبله، وطلب معالجة التقصير خلال مدة تحددها.</p>\\n<p>2- إذا لم تتم معالجة التقصير خلال المدة المحددة في الفقرة (1) من هذه المادة؛ للهيئة -في حدود اختصاصاتها- اتخاذ التدابير اللازمة التي تراها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ff41d628344a4131af0cde729eb70627\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>- على جمعية الملاك وجمعية المجمع -بحسب الأحوال- تعيين مراجع حسابات مرخص له بالعمل في المملكة في الحالتين الآتيتين:</p>\\n<p>أ- إذا كان العقار المشترك أو المجمع العقاري يتضمن (100) مائة وحدة عقارية مفرزة فأكثر.</p>\\n<p>ب- إذا كان حجم موجودات جمعية الملاك أو جمعية المجمع يتجاوز (1.000.000) مليون ريال.</p>\\n<p>2- لا يجوز الجمع بين عمل مراجع الحسابات وعضوية الجمعية العامة أو أي عمل آخر متصل بالعقار المشترك أو بالمجمع العقاري، أو أن يكون شريكاً لأحد أعضاء الجمعية العامة أو عاملاً لديه أو قريباً له حتى الدرجة (الرابعة).</p>\\n<p>3- لمراجع الحسابات -في أيّ وقت- الاطلاع على دفاتر الجمعية وسجلاتها وغير ذلك من الوثائق، وله كذلك طلب البيانات والإيضاحات التي يرى ضرورة الحصول عليها؛ ذات الصلة بعمله. وعلى المدير أن يمكنه من أداء واجبه، وإذا صادف مراجع الحسابات صعوبة في هذا الشأن أثبت ذلك في تقرير يقدمه إلى الجمعية العامة.</p>\\n<p>4- يعد مراجع الحسابات تقريراً سنوياً وفق معايير المراجعة المتعارف عليها ويعرضه على الجمعية العامة، على أن يتضمن ما تبين له من مخالفات لأحكام النظام أو اللائحة أو النظام الأساسي، إن وجدت.</p>\\n<p>5- لا يجوز لمراجع الحسابات أن يفشي للغير، أو للملاك في غير الجمعية العامة، ما وقف عليه من أسرار الجمعية بسبب قيامه بعمله.</p>\\n<p>6- يكون مراجع الحسابات مسؤولاً عن الأضرار التي تصيب الجمعية العامة بسبب الأخطاء التي تقع منه أثناء ممارسته اختصاصاته نتيجة إهماله أو تقصيره.</p>\\n<p>7- يعد قرار الجمعية العامة باعتماد تقرير المدير والقوائم المالية -المقدمة منه- دون الاطلاع على تقرير مراجع الحسابات؛ باطلاً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d349cc5dcd2b4cd6b0ed3851487eaeb8\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- دون إخلال بأحكام الأنظمة والأوامر والقرارات والتعليمات ذات العلاقة، لجمعية الملاك وجمعية المجمع قبول التبرعات والهبات والوصايا والأوقاف، وفق الضوابط الآتية:</p>\\n<p>أ- ألا تتعارض مع النظام أو اللائحة أو النظام الأساسي، أو تكون مشروطةً بتحقيق مصلحة خاصة.</p>\\n<p>ب- ألا تتضمن تقديم ميزات مالية أو عينية للمدير أو أي من تابعيه.</p>\\n<p>2- دون إخلال بشرط الواقف، يتم التصرف في التبرعات والهبات والوصايا والأوقاف -النقدية منها أو العينية- وفقاً للقواعد والإجراءات المالية التي تحكم عمل الجمعية.</p>\\n<p>3- تعد الجمعية سجلاً لقيد ما يرد لها من تبرعات أو هبات أو وصايا أو أوقاف، يشتمل على معلومات مقدميها وأوجه صرفها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d0228e63d9d742f4b8ef556e0797343f\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأحكام الأنظمة والأوامر والقرارات والتعليمات ذات العلاقة، لجمعية الملاك وجمعية المجمع استثمار أموالهما في مختلف المجالات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4f60cd0a74374a28aa35bb14c4ac5434\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>للجمعية العامة أن تقرر تكوين مبلغ احتياطي بغرض مواجهة أي تكاليف تتجاوز قيمتها ميزانية الجمعية المعتمدة، بحسب ما يحدده النظام الأساسي، وللملاك كذلك الاتفاق على تكوين ذلك المبلغ.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d717102ba23d47c89d5527115605eeeb\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تفتح الجمعية حساباً مصرفياً باسمها -وفقاً للإجراءات النظامية- في أحد البنوك المرخص لها بالعمل داخل المملكة، وتودع جميع أموال الجمعية فيه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/df16a21e3f424e40b1cc21c0b1d9ab92\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>على الجمعية العامة الاحتفاظ بمحاضر اجتماعاتها ودفاتر حسابات مفصلة للمبالغ المستحقة على الملاك والغير؛ في سجلات تخصص لذلك. ويحق لكل مالك -أو من يمثله- طلب الاطلاع على تلك الدفاتر.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ab342b01320e4799a50f1f6c4f482479\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تكون جميع العناوين والمراسلات والإشعارات والمكاتبات والبيانات والتقارير التي توجهها الجمعية العامة باللغة العربية، ويجوز اختيار لغة أخرى بالإضافة إلى اللغة العربية، وترسل أو تسلم بحسب ما اُتفق عليه.&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e87cbd3e4511484fb6460c11e2b705f4\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يشترك الملاك المستفيدون حصراً من بعض الأجزاء المشتركة في تكاليف صيانتها وإدارتها كل بقدر نسبة مساحة الجزء المفرز الذي يملكه إلى إجمالي مساحة الأجزاء المفرزة المستفيدة من تلك الأجزاء المشتركة، ما لم يتفق على غير ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0d65d49f7f694371926db0a1ecb1ae69\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>لا تعد أي تحسينات يجريها أي من الملاك على نفقته على أي من الأجزاء المشتركة أو أي جزء منها -وفقاً لحكم الفقرة (2) من المادة (السادسة والعشرين) من النظام- سبباً لاكتسابه ملكيتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6ad6e48abadf46e4bf5db177fe9aba80\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يكون إجراء الأعمال داخل أي وحدة عقارية مفرزة حفظاً لسلامة العقار المشترك أو المجمع العقاري أو لتحسين الانتفاع بالأجزاء المشتركة أو صيانتها؛ إذا دعت الضرورة ذلك، وفق الأحكام الآتية:</p>\\n<p>1- إشعار مالك الوحدة قبل البدء بالأعمال بمدة كافية، على أن يتضمن الإشعار نوع الأعمال والمدة المحددة لإنجازها.</p>\\n<p>2- أن تكون إعادة الحال في الوحدة إلى ما كانت عليه فور انتهاء الأعمال، وخلال المدة المحددة في الإشعار.</p>\\n<p>3- دون إخلال بالتزامات مالك الوحدة المقررة في النظام واللائحة والنظام الأساسي، لا يتحمل مالك الوحدة أي تكاليف إضافية ناشئة عن تنفيذ تلك الأعمال، إلا بالقدر الذي يكون فيه مسؤولاً عن الضرر الذي لحق بالعقار المشترك أو بالمجمع العقاري.</p>\\n<p>4- مع مراعاة حكم الفقرة (3) من هذه المادة، يعوض مالك الوحدة -إذا تطلب الأمر- عن الضرر الناتج عن إخلائه الوحدة وقت تنفيذ الأعمال، وذلك وفقاً للأحكام الآتية:</p>\\n<p>أ- أن يتلاءم التعويض مع أجرة المثل لتلك الوحدة.</p>\\n<p>ب- أن يشمل التعويض أي تكاليف إضافية تحملها مالك الوحدة أو شاغلها خلال الإقامة في مكان بديل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/980b2f3ff2084d84bad6d9eb37aac3d9\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>في حال وجود عدادات مشتركة لأي من الخدمات العامة بين وحدات عقارية مفرزة أو أجزاء مشتركة؛ يلتزم كل مالك بسداد القيمة التي تحددها الجمعية العامة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/569cfa84031e42dd863bd53430f3a325\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- تُنقل إلى جمعية الملاك أو جمعية المجمع -عند تأسيسها أو إنشائها، وبحسب الأحوال- أي ضمانات تتصل بإنشاءات العقار المشترك أو المجمع العقاري أو تشغيلهما.</p>\\n<p>2- على فارز العقار تصحيح جميع العيوب فيه إلى أن يتم نقل جميع الضمانات السارية المتصلة بإنشائه أو تشغيله. ولا يؤثر ذلك النقل على المسؤولية التعاقدية أو النظامية لمن فرز العقار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/49114118e5c3499f874f93b77f3d2906\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر مجلس إدارة الهيئة القرارات والإجراءات اللازمة لتنفيذ اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dc8ddb964cc54b5b862a5344db643aa5\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تلغي اللائحة كل ما يتعارض معها من أحكام</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d0979854b6a34dd6a11578ad912c6df4\",\n      \"title\": \"المادة الحادية والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنشر اللائحة في الجريدة الرسمية ويعمل بها من تاريخ نفاذ النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6935561819b44a189e1e35d07948cda\",\n      \"title\": \"الفصل الأول: تعريفات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0589f844c69e4310bc89461552d536e3\",\n      \"title\": \"الفصل الثاني: فرز العقار\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f45823499de04d4bbaf3cbe719a73c83\",\n      \"title\": \"الفصل الثالث: أحكام الملكية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4d7544172442414c98063b29fe4c0524\",\n      \"title\": \" الفصل الرابع: جمعية الملاك وجمعية المجمع\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8b328983d89c49d8b9b765fcc7e7c1c4\",\n      \"title\": \"الفصل الخامس: الإدارة والصيانة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5cec6a75371c43d4ad2e343a55570df8\",\n      \"title\": \"الفصل السادس: أحكام ختامية \",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"header":{"Value":{"#cdata-section":"اللائحة التنفيذية لنظام ملكية الوحدات العقارية وفرزها وإدارتها"}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"legislationDocuments":{"Value":{"#cdata-section":"[]"}},"legislationType":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"publishDate":{"Value":{"#cdata-section":"2020-06-26T00:00:00"}},"regaulationLinkFromOtherSite":{"Value":{"#cdata-section":""}},"releaseDate":{"Value":{"#cdata-section":"2020-06-14T00:00:00"}},"ruleStatus":{"Value":{"#cdata-section":"[\n  \"ساري\"\n]"}},"ruleType":{"Value":{"#cdata-section":"[\n  \"أنظمة\"\n]"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"subContent":{"Value":{"#cdata-section":"اللائحة التنفيذية لنظام ملكية الوحدات العقارية وفرزها وإدارتها"}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true}]