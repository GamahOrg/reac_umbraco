",\n            \"udi\": \"umb://element/69ef30b2597a40daaf4453553e4ae59a\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Beneficiary service\",\n            \"text\": \"Service channels\",\n            \"link\": \"\",\n            \"icon\": \"umb://media/ca2c1ae6f86049dab9448ce572f3663c\",\n            \"items\": \"\",\n            \"titleFirst\": \"0\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - title (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"إيجار","change":"Update"},{"success":true,"name":"Property - title (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"EJAR","change":"Update"}],"key":"59071c62-4f3a-4e53-9784-68963286266a"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/6218a02f-9895-4aed-a87b-65580ff81940.config","name":"بيع وتأجير مشروعات عقارية على الخارطة","path":"/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Template","path":"/Info/Template","oldValue":"(Blank)","newValue":"ServicesDetails","change":"Update"},{"success":true,"name":"Property - buttonText (ar-jo)","path":"/Properties/*/Value","oldValue":"الانتقال الى الخدمة","newValue":"بدء الخدمة","change":"Update"},{"success":true,"name":"Property - description (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه","change":"Update"},{"success":true,"name":"Property - description (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Wafi is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.","change":"Update"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"بيع\",\n  \"تأجير\",\n  \"تراخيص\",\n  \"ترخصي\",\n  \"الخدمات الالكترونية\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"wafi","newValue":"بيع وتأجير مشروعات عقارية على الخارطة","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Wafi – Off-Plan Sales & Lease","change":"Update"},{"success":true,"name":"Property - serviceFeature (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"3ba4a362-5015-41be-b87c-f57c199f1265\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\\"markup\\\":\\\"<p>تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه، تهدف إلى أتمتة خدمات قطاع التطوير العقاري، تحت إشراف الهيئة العامة للعقار، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم (196) وتاريخ 1445/03/04هـ.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"cec460cf-9431-4812-9a76-7739d64a4ef3\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/2d60419ed1954a2d90581e33b729900d\",\n    \"featureTabTitle\": \"التأهيل\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\\"markup\\\":\\\"<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">تتيح هذه الخدمة طلب التأهيل للراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة والمهن المتربطة بها، باعتباره متطلب أساسي للحصول على الترخيص، وفقاً للنظام واللائحة التنفيذية لبيع وتأجير مشروعات عقارية على الخارطة.</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/05dc2f225bef4b16a41894d4369a41ba}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص اعتباري/ منشأة)\\\\\\\">المطور العقاري (شخص اعتباري/ منشأة)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/62663e1acf024536a87ca36d360f276f}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص طبيعي/فرد)\\\\\\\">المطور العقاري (شخص طبيعي/فرد)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/1e66c8906f48454a9937f23aadc06fde}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"الاستشاري الهندسي\\\\\\\">الاستشاري الهندسي</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/70b22a18e7ce43eeb16e93af8d6aefbe}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المحاسب القانوني\\\\\\\">المحاسب القانوني</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">للتقدم بطلب التأهيل:</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"منصة الخدمة\\\\\\\">منصة الخدمة</a></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"a26f40f8-7f62-4f0b-9bd4-4cdc0f8530f3\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a2fab649a0c74f1c8c1ca6eb11260385\",\n    \"featureTabTitle\": \"الترخيص \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\\"markup\\\":\\\"<p><strong>متطلبات رخصة بيع وتأجير مشروعات عقارية على الخارطة :</strong></p>\\\\n<p>&nbsp;</p>\\\\n<ol>\\\\n<li>نسخة من السجل التجاري ساري المفعول، الذي يسمح له بمزاولة التطوير العقاري.</li>\\\\n<li>شهادة عضوية الغرفة التجارية.</li>\\\\n<li>نسخة من السجل الائتماني من شركة مرخص لها كم الجهة المختصة بالخدمات الائتمانية. من تاتا.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بينه وبين مالك الارض أو مالك منفعتها بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي - إن وجد- بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>التصاميم المعمارية والمخططات الهندسية التي اعتمدتها الجهات المختصة.</li>\\\\n<li>نسخة من العقد المبرم بينه وبين المكتب الاستشاري، بما يتفق مع أحكام النظام واللائحة</li>\\\\n<li>&nbsp;نسخة من العقد المبرم بينه وبين المحاسب القانوني، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>دراسة الجدوى الاقتصادية للمشروع العقاري من مكتب استشاري تتضمن: تكاليف المشروع العقاري التقديرية، وأوجه الصرف اللازمة عليه، والتدقيق النقدي له، والمدة المتوقعة لتنفيذه.</li>\\\\n<li>تعهد منه ببدء الأعمال الإنشائية للمشروع العقاري خلال (سته) أشهر من تاريخ حصوله على الترخيص .</li>\\\\n<li>نموذج عقد بيع بينه وبين المشتري ومواعيد تسليم البيع محددة باليوم بما يتفق مع أحكام النظام واللائحة وغير متعارضة مع أجكام الشريعة الإسلامية.</li>\\\\n<li>اتفاقية فتح حساب ضمان بينه وبين بنك مرخص له في المملكة، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقًا لنظام ملكية الوحدات العقارية وفرزها وإدارتها.</li>\\\\n<li>يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري إلا إذا كانت مسجلة عينيًا.</li>\\\\n</ol>\\\\n<p>&nbsp;</p>\\\\n<p><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\\n<p>&nbsp;</p>\\\\n<p>&nbsp;</p>\\\\n<p><strong>متطلبات رخصة تسويق مشروعات عقارية على الخارطة</strong></p>\\\\n<ol style=\\\\\\\"text-align: right;\\\\\\\">\\\\n<li><em><span style=\\\\\\\"font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span></em>رقم صك تسجيل ملكية العقار.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp;</span><!--[endif]-->رقم عقد التسويق بين الوسيط العقاري والمطور-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span><!--[endif]-->نسخة عقد التطوير بين المطور ومالك الأرض-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">.</span><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; </span><!--[endif]-->التصاميم المعمارية والمخططات الهندسية</li>\\\\n</ol>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">وفي حال رغبة المطور استلام مبلغ حجز وحدات عقارية من المشتري أو المستأجر خلال مدة ( ترخيص تسويق المشروع العقاري ) الالتزام بالتالي :</p>\\\\n<ul>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- الإفصاح عن حالة المشروع والمخططات المستقبلية&nbsp;</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- عدم استلام أكثر من (5%) من قيمة الوحدة العقارية.</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- إيداع جميع مبالغ الحجز المستلمة في حساب الضمان المخصص لذلك.&nbsp;</li>\\\\n</ul>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"165d0496-a0a2-47d3-ae7a-fa3b7057cc75\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/8c9e8204df264a3f86aa60047aa52ab9\",\n    \"featureTabTitle\": \"الدعم والتمكين\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\\"markup\\\":\\\"<p>الدعم والاستفسارات:</p>\\\\n<p> </p>\\\\n<p> البريد الإلكتروني:  <a href=\\\\\\\"mailto:wafi@rega.gov.sa\\\\\\\">wafi@rega.gov.sa </a></p>\\\\n<p>الرقم الموحد 199011</p>\\\\n<p><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/%D8%A7%D9%84%D9%85%D8%B1%D9%83%D8%B2-%D8%A7%D9%84%D8%A7%D8%B9%D9%84%D8%A7%D9%85%D9%8A/%D8%A8%D9%88%D8%A7%D8%A8%D8%A9-%D9%86%D9%81%D8%A7%D8%B0/\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"البلاغات\\\\\\\">البلاغات</a></p>\\\\n<p> </p>\\\\n<p> </p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"8a7777f9-d3f7-4103-95d3-34ab62a595ef\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/15ed04d585fb4fb0983a4abead7a229c\",\n    \"featureTabTitle\": \"المشاريع المرخصة\",\n    \"featureTitle\": \"المشاريع المرخصة\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\\"Wafi Projects\\\"]\",\n    \"linkedToPage\": \"umb://document/c750cd59703d4f54ae24cc40fbcb9f54\"\n  },\n  {\n    \"key\": \"4b277b10-b562-4078-9458-99d1204118a8\",\n    \"name\": \"Item 6\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/e3a68052de4c4d5faaa99c213a1f36b0\",\n    \"featureTabTitle\": \"الشركات المؤهلة\",\n    \"featureTitle\": \"الشركات المؤهلة\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\\"Wafi Developers\\\"]\",\n    \"linkedToPage\": \"\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"3ba4a362-5015-41be-b87c-f57c199f1265\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه، تهدف إلى أتمتة خدمات قطاع التطوير العقاري، تحت إشراف الهيئة العامة للعقار، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم (196) وتاريخ 1445/03/04هـ.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"cec460cf-9431-4812-9a76-7739d64a4ef3\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/2d60419ed1954a2d90581e33b729900d\",\n    \"featureTabTitle\": \"التأهيل\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">تتيح هذه الخدمة طلب التأهيل للراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة والمهن المتربطة بها، باعتباره متطلب أساسي للحصول على الترخيص، وفقاً للنظام واللائحة التنفيذية لبيع وتأجير مشروعات عقارية على الخارطة.</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/05dc2f225bef4b16a41894d4369a41ba}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص اعتباري/ منشأة)\\\\\\\">المطور العقاري (شخص اعتباري/ منشأة)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/62663e1acf024536a87ca36d360f276f}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص طبيعي/فرد)\\\\\\\">المطور العقاري (شخص طبيعي/فرد)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/1e66c8906f48454a9937f23aadc06fde}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"الاستشاري الهندسي\\\\\\\">الاستشاري الهندسي</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/70b22a18e7ce43eeb16e93af8d6aefbe}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المحاسب القانوني\\\\\\\">المحاسب القانوني</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">للتقدم بطلب التأهيل:</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"منصة الخدمة\\\\\\\">منصة الخدمة</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"a26f40f8-7f62-4f0b-9bd4-4cdc0f8530f3\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a2fab649a0c74f1c8c1ca6eb11260385\",\n    \"featureTabTitle\": \"الترخيص \",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p><strong>متطلبات رخصة بيع وتأجير مشروعات عقارية على الخارطة :</strong></p>\\\\n<p>&nbsp;</p>\\\\n<ol>\\\\n<li>نسخة من السجل التجاري ساري المفعول، الذي يسمح له بمزاولة التطوير العقاري.</li>\\\\n<li>شهادة عضوية الغرفة التجارية.</li>\\\\n<li>نسخة من السجل الائتماني من شركة مرخص لها كم الجهة المختصة بالخدمات الائتمانية. من تاتا.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بينه وبين مالك الارض أو مالك منفعتها بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي - إن وجد- بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>التصاميم المعمارية والمخططات الهندسية التي اعتمدتها الجهات المختصة.</li>\\\\n<li>نسخة من العقد المبرم بينه وبين المكتب الاستشاري، بما يتفق مع أحكام النظام واللائحة</li>\\\\n<li>&nbsp;نسخة من العقد المبرم بينه وبين المحاسب القانوني، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>دراسة الجدوى الاقتصادية للمشروع العقاري من مكتب استشاري تتضمن: تكاليف المشروع العقاري التقديرية، وأوجه الصرف اللازمة عليه، والتدقيق النقدي له، والمدة المتوقعة لتنفيذه.</li>\\\\n<li>تعهد منه ببدء الأعمال الإنشائية للمشروع العقاري خلال (سته) أشهر من تاريخ حصوله على الترخيص .</li>\\\\n<li>نموذج عقد بيع بينه وبين المشتري ومواعيد تسليم البيع محددة باليوم بما يتفق مع أحكام النظام واللائحة وغير متعارضة مع أجكام الشريعة الإسلامية.</li>\\\\n<li>اتفاقية فتح حساب ضمان بينه وبين بنك مرخص له في المملكة، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقًا لنظام ملكية الوحدات العقارية وفرزها وإدارتها.</li>\\\\n<li>يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري إلا إذا كانت مسجلة عينيًا.</li>\\\\n</ol>\\\\n<p>&nbsp;</p>\\\\n<p><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\\n<p>&nbsp;</p>\\\\n<p>&nbsp;</p>\\\\n<p><strong>متطلبات رخصة تسويق مشروعات عقارية على الخارطة</strong></p>\\\\n<ol style=\\\\\\\"text-align: right;\\\\\\\">\\\\n<li><em><span style=\\\\\\\"font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span></em>رقم صك تسجيل ملكية العقار.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp;</span><!--[endif]-->رقم عقد التسويق بين الوسيط العقاري والمطور-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span><!--[endif]-->نسخة عقد التطوير بين المطور ومالك الأرض-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">.</span><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; </span><!--[endif]-->التصاميم المعمارية والمخططات الهندسية</li>\\\\n</ol>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">وفي حال رغبة المطور استلام مبلغ حجز وحدات عقارية من المشتري أو المستأجر خلال مدة ( ترخيص تسويق المشروع العقاري ) الالتزام بالتالي :</p>\\\\n<ul>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- الإفصاح عن حالة المشروع والمخططات المستقبلية&nbsp;</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- عدم استلام أكثر من (5%) من قيمة الوحدة العقارية.</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- إيداع جميع مبالغ الحجز المستلمة في حساب الضمان المخصص لذلك.&nbsp;</li>\\\\n</ul>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"2ef88132-6afd-4796-813f-4479f679af37\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"المشاريع المرخصة\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Projects\\\"\\n]\",\n    \"linkedToPage\": \"umb://document/b97ea291532645a587fa2257586e22f6\"\n  },\n  {\n    \"key\": \"9c34889b-7541-4c15-ae27-27e5b636b6c6\",\n    \"name\": \"Item 5\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"المطورين المعتمدين\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Developers\\\"\\n]\",\n    \"linkedToPage\": \"\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - serviceFeature (en-us)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"a8f183c3-591c-48e6-b530-82da38973af2\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"Wafi\\\\\\\" is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"a8f183c3-591c-48e6-b530-82da38973af2\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"Wafi\\\\\\\" is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  },\n  {\n    \"key\": \"e881996e-1050-400d-b141-9a9f6cf81866\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"Projects\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Projects\\\"\\n]\",\n    \"linkedToPage\": \"umb://document/b97ea291532645a587fa2257586e22f6\"\n  },\n  {\n    \"key\": \"ca6706f6-fd9f-4bd5-b4e4-04eb9adc2af0\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"\",\n    \"featureTabTitle\": \"Certified Facilities\",\n    \"featureBrief\": \"\",\n    \"customPage\": \"[\\n  \\\"Wafi Developers\\\"\\n]\",\n    \"linkedToPage\": \"\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - support","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/42cefd9b69a84136975415681a475611\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b2c2b1db22dd48828955fd32b996244c\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\",\n      \"udi\": \"umb://element/b2c2b1db22dd48828955fd32b996244c\",\n      \"title\": \"\",\n      \"items\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/986646f4b049429d8f7bc4f9308a379e\"\n            },\n            {\n              \"contentUdi\": \"umb://element/9452e450139b4df7920add46f5ce7652\"\n            },\n            {\n              \"contentUdi\": \"umb://element/307d8a6c33eb440cacea40448f8e5520\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/9452e450139b4df7920add46f5ce7652\",\n            \"type\": [\n              \"Email\"\n            ],\n            \"title\": \"\",\n            \"text\": \"wafi@rega.gov.sa\",\n            \"icon\": \"\",\n            \"link\": \"\",\n            \"items\": \"\",\n            \"titleFirst\": \"1\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/307d8a6c33eb440cacea40448f8e5520\",\n            \"type\": [\n              \"Phone\"\n            ],\n            \"title\": \"\",\n            \"text\": \"\",\n            \"icon\": \"\",\n            \"link\": \"\",\n            \"items\": \"\",\n            \"titleFirst\": \"1\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/986646f4b049429d8f7bc4f9308a379e\",\n            \"type\": [\n              \"Website\"\n            ],\n            \"title\": \"Frequently Asked Questions\",\n            \"text\": \"FAQ's page\",\n            \"link\": \"https://dev-rega.rega.gov.sa/المكتبة/الأسئلة-الشائعة/\",\n            \"icon\": \"\",\n            \"items\": \"\",\n            \"titleFirst\": \"1\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    },\n    {\n      \"contentTypeKey\": \"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\",\n      \"udi\": \"umb://element/42cefd9b69a84136975415681a475611\",\n      \"title\": \"\",\n      \"items\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/7d6537792ce24a2893faf6f794d9c783\"\n            },\n            {\n              \"contentUdi\": \"umb://element/0c22d9bafdc94440ac83beca6df980b6\"\n            },\n            {\n              \"contentUdi\": \"umb://element/d9bb320cb78c40bb83e6fc38238631e9\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/7d6537792ce24a2893faf6f794d9c783\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Target Audience\",\n            \"text\": \"\",\n            \"icon\": \"umb://media/feb8701eeb0f48eb85d8501d4c57976a\",\n            \"items\": [\n              \"Individuals\",\n              \"Real Estate Beneficiary\",\n              \"Property Owner\"\n            ],\n            \"link\": \"\",\n            \"titleFirst\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/0c22d9bafdc94440ac83beca6df980b6\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Service Type\",\n            \"text\": \"\",\n            \"icon\": \"umb://media/a5c812c6c448431aab14c0fc6699a6b5\",\n            \"items\": [\n              \"Support service\"\n            ],\n            \"link\": \"\",\n            \"titleFirst\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/d9bb320cb78c40bb83e6fc38238631e9\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Beneficiary service\",\n            \"text\": \"Service channels\",\n            \"link\": \"\",\n            \"icon\": \"umb://media/ca2c1ae6f86049dab9448ce572f3663c\",\n            \"items