  \"Real Estate Beneficiary\",\n              \"Property Owner\"\n            ],\n            \"link\": \"\",\n            \"titleFirst\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\",\n            \"udi\": \"umb://element/a8bfa3bed0dc41c29e7d2f98f648fff4\",\n            \"type\": [\n              \"Other\"\n            ],\n            \"title\": \"Beneficiary service\",\n            \"text\": \"Service channels\",\n            \"link\": \"\",\n            \"icon\": \"umb://media/ca2c1ae6f86049dab9448ce572f3663c\",\n            \"items\": \"\",\n            \"titleFirst\": \"0\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - title (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"لجنة معالجة أخطاء تسجيل الملكية","change":"Update"},{"success":true,"name":"Property - title (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Mulkia","change":"Update"}],"key":"263a8388-8738-44af-b16e-71f091cf7f25"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"","exception":null,"change":"Delete","fileName":"","name":"ميثاق الخدمات","path":null,"requiresPostProcessing":true,"detailMessage":null,"details":null,"key":"d3a8ab11-a99d-4a28-b0dc-61ddf028f2b6"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/45ba7877-2bde-4dd9-8d40-b226a6d934fb.config","name":"عن البيانات المفتوحة","path":"/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Parent","path":"/Info/Parent","oldValue":"Open Data & KPIs","newValue":"البيانات المفتوحة","change":"Update"},{"success":true,"name":"Path","path":"/Info/Path","oldValue":"//OpenDataKPIs/","newValue":"///","change":"Update"},{"success":true,"name":"Property - bottomFacts (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"8679f8c7-135e-4c7f-bbdb-ba45dfe79708\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"المبادئ الرئيسية لحرية المعلومات\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>الشفافية:</strong> للفرد الحق في معرفة المعلومات المتعلقة بأنشطة الهيئة تعزيزاً لمنظومة النزاهة والشفافية والمساءلة.</li>\\\\n<li><strong>الضرورة والتناسب:</strong> أي قيود على طلب الاطلاع أو الحصول على المعلومات المحمية التي تتلقاها أو تنتجها أو تتعامل معها الهيئة يجب أن تكون مبررة بطريقة واضحة وصريحة.</li>\\\\n<li><strong>الأصل في المعلومات الإفصاح:</strong> لكل فرد الحق في الاطلاع على المعلومات العامة -غير المحمية- وليس بالضرورة أن يتمتع مقدم الطلب بحيثية معينة أو باهتمام معين بهذه المعلومات ليتمكن من الحصول عليها، كما لا يتعرض لأي مساءلة قانونية متعلقة بهذا الحق.</li>\\\\n<li><strong>المساواة:</strong> يتم التعامل مع جميع طلبات الاطلاع أو الحصول على المعلومات العامة على أساس المساواة وعدم التمييز بين الأفراد.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"c93bec4e-ecfe-448e-835f-bfc4abd1df50\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"حقوق الأفراد فيما يتعلق بالوصول الى المعلومات العامة أو الحصول عليها\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>حق الاطلاع والحصول على أي معلومة غير محمية لدى أي جهة عامة.</li>\\\\n<li>الحق في معرفة سبب رفض الاطلاع أو الحصول على المعلومات المطلوبة.</li>\\\\n<li>الحق في التظلم على قرار رفض طلب الاطلاع والحصول على المعلومات المطلوبة.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"c4df8d3e-0a46-443f-b6d3-30802fe85a99\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"الخطوات الرئيسة للوصول الى المعلومات أو الحصول عليها\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>يجب أن يكون الطلب لأغراض الوصول إلى المعلومات العامة أو الحصول عليها.<br />الخطوات الرئيسة لطلب الاطلاع أو الحصول على المعلومات العامة:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>أولاً</strong>: يتم تقديم الطلبات عن طريق ملء نموذج إلكتروني وتقديمه للهيئة <a href=\\\\\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\\\\\" title=\\\\\\\"طلب بيانات مفتوحة\\\\\\\">بالضغط هنا</a>.</li>\\\\n<li><strong>ثانياً</strong>: تقوم الهيئة، باستلام طلب الاطلاع أو الحصول على المعلومات العامة واتخاذ أحد القرارات التالية:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>الموافقة</strong>: في حال تمت موافقة الهيئة على طلب الوصول إلى المعلومات أو الحصول عليها.</li>\\\\n<li><strong>الرفض</strong>: في حال تم رفض طلب الوصول إلى المعلومات أو الحصول عليها، فيجب أن يكون الرفض خطياً أو إلكترونياً على أن يتضمن المعلومات التالية:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>تحديد ما إذا كان رفض الطلب كلياً أو جزئياً.</li>\\\\n<li>أسباب الرفض، إن أمكن.</li>\\\\n<li>الإشعار: في حال كانت المعلومات المطلوبة متاحه على موقع الهيئة، أو ليست من اختصاصها فيجب إشعار الفرد بذلك خطياً أو إلكترونياً.</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\\n</li>\\\\n<li><strong>ثالثاً</strong>: في حالة رغبة الفرد في التظلّم على رفض الطلب من قبل الهيئة، فيمكنه تقديم إشعار خطي أو إلكتروني بالتظلم إلى مكتب إدارة البيانات في الهيئة خلال فترة زمنية لا تتجاوز (5) أيام عمل من استلامه لقرار الهيئة، ويقوم مكتب إدارة البيانات في الهيئة بمراجعة الطلب واتخاذ القرار المناسب.</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"98ce197a-2e2c-4e17-a98e-dbe560e4523f\",\n    \"name\": \"Item 4\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"بيانات  X \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<p><a href=\\\\\\\"/{localLink:umb://media/387668a09593489b901126aa5db7b591}\\\\\\\" title=\\\\\\\"Pdf Test\\\\\\\">&nbsp;البيانات تاليتلعتي&nbsp; &nbsp;&nbsp;</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"c93bec4e-ecfe-448e-835f-bfc4abd1df50\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"حقوق الأفراد فيما يتعلق بالوصول الى المعلومات العامة أو الحصول عليها\",\n    \"shortBrief\": \"{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>حق الاطلاع والحصول على أي معلومة غير محمية لدى أي جهة عامة.</li>\\\\n<li>الحق في معرفة سبب رفض الاطلاع أو الحصول على المعلومات المطلوبة.</li>\\\\n<li>الحق في التظلم على قرار رفض طلب الاطلاع والحصول على المعلومات المطلوبة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"icon\": \"[]\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - bottomFacts (en-us)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"98f46eb6-4685-44c7-90a2-8863a6ee37c6\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"Principle Rights of Freedom of Information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>Transparency: </strong>The individual has the right to know information related to the Authority’s activities to enhance the ecosystem of integrity, transparency, and accountability. </li>\\\\n<li><strong>Necessity and Proportionality: </strong>Any restrictions on obtaining or requesting access to protected information received, produced, or handled by the Authority shall be justified clearly and explicitly. </li>\\\\n<li><strong>Public Information should be Available:</strong> Every applicant has the right to access public – unprotected – information. The applicant does not need to have a particular reason or interest in the information to obtain it, nor be exposed to any legal liability related to this right.</li>\\\\n<li><strong>Equality:</strong> All requests made by individuals to access or receive public information shall be dealt with on an equal and non-discriminatory basis. </li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"fd1831f0-f843-4fd3-8364-cc6bdd132e42\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"The Rights of Individuals to Access and Obtain Public Information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access and obtain any information not protected by any public entity. </li>\\\\n<li>The right to know the reason for refusing to access or obtain the required information. </li>\\\\n<li>The right to appeal against the decision to refuse to access or obtain the required information.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"f4408e78-99b1-4c62-9424-8f8babcb5a98\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"The Main Steps to Access or Obtaining Information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The request must be to access or obtain public information.&nbsp;<br>The main steps to access or obtain public information:&nbsp;<br>\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>First:</strong> Applications must be submitted by filling out an electronic form and submitting it to the Authority by <strong><a href=\\\\\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\\\\\" title=\\\\\\\"Open Data Request\\\\\\\">clicking here.</a>&nbsp;</strong></li>\\\\n<li><strong>Second:</strong> The Authority receives the request to access or obtain public information and makes one of the following decisions:&nbsp;<br>\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>Approval:</strong> If the Authority approves the request to access or obtain public information.</li>\\\\n<li><strong>Rejection:</strong> If the Authority rejects the request to access or obtain public information, the rejection must be in writing or electronically and include the following information:&nbsp;<br>\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Determine whether the application was rejected partially or fully.</li>\\\\n<li>If possible, state the reasons for the rejection.&nbsp;</li>\\\\n</ul>\\\\n</li>\\\\n<li><strong>Notification:</strong> If the required information is available on the Authority’s website or is not under its jurisdiction, the individual must be notified in writing or electronically.&nbsp;&nbsp;</li>\\\\n</ul>\\\\n</li>\\\\n<li><strong>Third:</strong> In case the individual wishes to appeal the Authority’s rejection of the application, the appeal can be submitted, in writing or electronically, to the Data Management Office at the Authority within 5 business days of receiving the Authority’s decision. The Data Management Office at the Authority will review the request and make the appropriate decision.&nbsp;</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"fd1831f0-f843-4fd3-8364-cc6bdd132e42\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"The Rights of Individuals to Access and Obtain Public Information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access and obtain any information not protected by any public entity. </li>\\\\n<li>The right to know the reason for refusing to access or obtain the required information. </li>\\\\n<li>The right to appeal against the decision to refuse to access or obtain the required information.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[]\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - description (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"عن البيانات المفتوحة","change":"Update"},{"success":true,"name":"Property - description (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"About Open Data","change":"Update"},{"success":true,"name":"Property - keyPrinciplesItems (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/4099e57067e749bdbef4abc83890044f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73939d70beee459c994bcb4dcdf136d8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a5090fb06ccc4846adf9721376469f74\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bd2b76cb280e42a3b712d7478862ed13\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/4099e57067e749bdbef4abc83890044f\",\n      \"title\": \"الشفافية\",\n      \"content\": \"للفرد الحق في معرفة المعلومات المتعلقة بأنشطة الهيئة تعزيزاً لمنظومة النزاهة والشفافية والمساءلة.\",\n      \"icon\": [\n        {\n          \"key\": \"232e053c-2113-4264-a59f-2eb4fbd92c48\",\n          \"mediaKey\": \"f7b3357f-3ca9-4560-be12-49ad590f7540\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/73939d70beee459c994bcb4dcdf136d8\",\n      \"title\": \"الضرورة والتناسب\",\n      \"content\": \"أي قيود على طلب الاطلاع أو الحصول على المعلومات المحمية التي تتلقاها أو تنتجها أو تتعامل معها الهيئة يجب أن تكون مبررة بطريقة واضحة وصريحة.\",\n      \"icon\": [\n        {\n          \"key\": \"03aa7750-9598-472e-9012-48b6f7d572b6\",\n          \"mediaKey\": \"e59dc720-73f5-4c85-a769-db1c6aee7c02\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/a5090fb06ccc4846adf9721376469f74\",\n      \"title\": \"الأصل في المعلومات الإفصاح\",\n      \"content\": \"لكل فرد الحق في الاطلاع على المعلومات العامة -غير المحمية- وليس بالضرورة أن يتمتع مقدم الطلب بحيثية معينة أو باهتمام معين بهذه المعلومات ليتمكن من الحصول عليها، كما لا يتعرض لأي مساءلة قانونية متعلقة بهذا الحق.\",\n      \"icon\": [\n        {\n          \"key\": \"8afc0ca2-888e-4b06-8833-cd174ef5e87b\",\n          \"mediaKey\": \"529fb8e3-4611-4cb2-862b-77e06de1d76f\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/bd2b76cb280e42a3b712d7478862ed13\",\n      \"title\": \"المساواة\",\n      \"content\": \"يتم التعامل مع جميع طلبات الاطلاع أو الحصول على المعلومات العامة على أساس المساواة وعدم التمييز بين الأفراد.\",\n      \"icon\": [\n        {\n          \"key\": \"5f4df4e1-b1fd-4ae8-ae87-264201876a23\",\n          \"mediaKey\": \"93fe67dd-48ba-4258-80d5-80cbf43dd31e\"\n        }\n      ]\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - keyPrinciplesItems (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/d21d9c226312415db9658f4bcf7a3832\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5c3a0b4c29124261af0a583e2238696e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8a86fbd070f148e39a58dde9fd25ccec\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c2d239bb73444764b602002b9ee3347d\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/d21d9c226312415db9658f4bcf7a3832\",\n      \"title\": \"Transparency\",\n      \"content\": \"The individual has the right to know information related to the Authority’s activities to enhance the ecosystem of integrity, transparency, and accountability. \",\n      \"icon\": [\n        {\n          \"key\": \"f15bc0b5-0661-4dee-8b5f-0a3583b14e1e\",\n          \"mediaKey\": \"f7b3357f-3ca9-4560-be12-49ad590f7540\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/5c3a0b4c29124261af0a583e2238696e\",\n      \"title\": \"Necessity and Proportionality\",\n      \"content\": \"Any restrictions on obtaining or requesting access to protected information received, produced, or handled by the Authority shall be justified clearly and explicitly. \",\n      \"icon\": [\n        {\n          \"key\": \"54e2d8ad-bc21-4af5-803c-6a4ce188c0b1\",\n          \"mediaKey\": \"e59dc720-73f5-4c85-a769-db1c6aee7c02\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/8a86fbd070f148e39a58dde9fd25ccec\",\n      \"title\": \"Public Information should be Available\",\n      \"content\": \"Every applicant has the right to access public – unprotected – information. The applicant does not need to have a particular reason or interest in the information to obtain it, nor be exposed to any legal liability related to this right.\",\n      \"icon\": [\n        {\n          \"key\": \"90c62487-f2a3-4801-be4c-2d560768c3ac\",\n          \"mediaKey\": \"529fb8e3-4611-4cb2-862b-77e06de1d76f\"\n        }\n      ]\n    },\n    {\n      \"contentTypeKey\": \"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\",\n      \"udi\": \"umb://element/c2d239bb73444764b602002b9ee3347d\",\n      \"title\": \"Equality\",\n      \"content\": \"All requests made by individuals to access or receive public information shall be dealt with on an equal and non-discriminatory basis. \",\n      \"icon\": [\n        {\n          \"key\": \"8b209db6-dca0-475c-9ff2-89d2e8527c1e\",\n          \"mediaKey\": \"93fe67dd-48ba-4258-80d5-80cbf43dd31e\"\n        }\n      ]\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - keyPrinciplesTitle (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"المبادئ الرئيسية لحرية المعلومات","change":"Update"},{"success":true,"name":"Property - keyPrinciplesTitle (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Principle Rights of Freedom of Information: ","change":"Update"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"البيانات المفتوحة\",\n  \"البيانات\",\n  \"open\",\n  \"data\",\n  \"open data\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]","change":"Update"},{"success":true,"name":"Property - openDataContent (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"c1eb1eb3-a408-40a2-966c-d108ef0065f5\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"1972\",\n    \"shortBrief\": {\n      \"markup\": \"<p>أنشأت السلطة</p>\",\n      \"blocks\": {\n        \"contentData\": [],\n        \"settingsData\": []\n      }\n    }\n  },\n  {\n    \"key\": \"141351b4-c7ad-4f2d-bd42-a86b6eb84422\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"2350\",\n    \"shortBrief\": {\n      \"markup\": \"<p>الأعضاء المسجلين</p>\",\n      \"blocks\": {\n        \"contentData\": [],\n        \"settingsData\": []\n      }\n    }\n  }\n]","newValue":"(Blank)","change":"Update"},{"success":true,"name":"Property - openDataTitle (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"markup\": \"<p>هناك حقيقة مثبتة منذ زمن طويل وهي أن المحتوى المقروء لصفحة ما سيلهي القارئ عن التركيز على الشكل الخارجي للنص أو شكل توضع الفقرات في الصفحة التي يقرأها.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}","newValue":"الخطوات الرئيسة للوصول الى المعلومات أو الحصول عليها","change":"Update"},{"success":true,"name":"Property - openDataTitle (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"The Main Steps to Access or Obtaining Information: ","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"About Open Data","newValue":"عن البيانات المفتوحة","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"About Open Data","change":"Update"},{"success":true,"name":"Property - pageTitle (ar-jo)","path":"/Properties/*/Value","oldValue":"عن البيانات المفتوحة","newValue":"البيانات المفتوحة","change":"Update"},{"success":true,"name":"Property - policyItems (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"328a599b-f41c-4dda-8817-17aec6ffed24\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"لا تنطبق أحكام هذه السياسة على المعلومات المحمية:\",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>المعلومات التي يؤدي إفشاؤها إلى الإضرار بالأمن الوطني للدولة أو سياستها أو مصالحها أو حقوقها.</li>\\\\n<li>المعلومات العسكرية والأمنية.</li>\\\\n<li>المعلومات والوثائق التي يتم الحصول عليها بمقتضى اتفاق مع دولة أخرى وتصنف على أنها محمية.</li>\\\\n<li>التحريات والتحقيقات وأعمال الضبط وعمليات التفتيش والمراقبة المتعلقة بجريمة أو مخالفة أو تهديد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>الأبحاث العلمية أو التقنية، أو الحقوق المشتملة على حق من حقوق الملكية الفكرية التي يؤدي الكشف عنها إلى المساس بحق معنوي.</li>\\\\n<li>المعلومات المتعلقة بالمنافسات والعطاءات والمزايدات التي يؤدي الإفصاح عنها إلى الإخلال بعدالة المنافسة.</li>\\\\n<li>المعلومات التي تكون سرية أو شخصية بموجب نظام آخر، أو تتطلب إجراءات نظامية معينة للوصول إليها أو الحصول عليها.</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"328a599b-f41c-4dda-8817-17aec6ffed24\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"لا تنطبق أحكام هذه السياسة على المعلومات المحمية:\",\n    \"shortBrief\": \"{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>المعلومات التي يؤدي إفشاؤها إلى الإضرار بالأمن الوطني للدولة أو سياستها أو مصالحها أو حقوقها.</li>\\\\n<li>المعلومات العسكرية والأمنية.</li>\\\\n<li>المعلومات والوثائق التي يتم الحصول عليها بمقتضى اتفاق مع دولة أخرى وتصنف على أنها محمية.</li>\\\\n<li>التحريات والتحقيقات وأعمال الضبط وعمليات التفتيش والمراقبة المتعلقة بجريمة أو مخالفة أو تهديد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>الأبحاث العلمية أو التقنية، أو الحقوق المشتملة على حق من حقوق الملكية الفكرية التي يؤدي الكشف عنها إلى المساس بحق معنوي.</li>\\\\n<li>المعلومات المتعلقة بالمنافسات والعطاءات والمزايدات التي يؤدي الإفصاح عنها إلى الإخلال بعدالة المنافسة.</li>\\\\n<li>المعلومات التي تكون سرية أو شخصية بموجب نظام آخر، أو تتطلب إجراءات نظامية معينة للوصول إليها أو الحصول عليها.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"8213050e-90f6-4900-b250-48eb10be64d6\\\",\\n    \\\"mediaKey\\\": \\\"a2d49abc-ef31-4423-9acb-c3065aae0986\\\"\\n  }\\n]\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - policyItems (en-us)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"41742057-a80e-40cb-a058-939d170f8a18\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"The provisions of this policy do not apply to protected information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Information that the disclosure of harms the state’s national security, policy, interests, or rights.</li>\\\\n<li>Military and security information.</li>\\\\n<li>Information and documents obtained by an agreement with another country and classified as protected.</li>\\\\n<li>Information that includes investigations, inspections, and surveillance related to a crime, violation, or threat.&nbsp;</li>\\\\n<li>Information that includes recommendations, suggestions, or consultations for the issuance of legislation or government decisions that have not yet been issued.&nbsp;</li>\\\\n<li>Scientific or technical research, or rights that contain an intellectual property that the disclosure of leads to an infringement of moral right.&nbsp;</li>\\\\n<li>Information related to bids and auctions that the disclosure of would lead to biased competition.</li>\\\\n<li>Information that is confidential or personal under another system requires specific legal procedures to access or obtain it.&nbsp;</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"41742057-a80e-40cb-a058-939d170f8a18\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"fact\",\n    \"PropType\": null,\n    \"title\": \"The provisions of this policy do not apply to protected information: \",\n    \"shortBrief\": \"{\\n  \\\"markup\\\": \\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Information that the disclosure of harms the state’s national security, policy, interests, or rights.</li>\\\\n<li>Military and security information.</li>\\\\n<li>Information and documents obtained by an agreement with another country and classified as protected.</li>\\\\n<li>Information that includes investigations, inspections, and surveillance related to a crime, violation, or threat.&nbsp;</li>\\\\n<li>Information that includes recommendations, suggestions, or consultations for the issuance of legislation or government decisions that have not yet been issued.&nbsp;</li>\\\\n<li>Scientific or technical research, or rights that contain an intellectual property that the disclosure of leads to an infringement of moral right.&nbsp;</li>\\\\n<li>Information related to bids and auctions that the disclosure of would lead to biased competition.</li>\\\\n<li>Information that is confidential or personal under another system requires specific legal procedures to access or obtain it.&nbsp;</li>\\\\n</ul>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"icon\": \"[\\n  {\\n    \\\"key\\\": \\\"050e9500-9338-4066-8949-2993ed4733f7\\\",\\n    \\\"mediaKey\\\": \\\"a2d49abc-ef31-4423-9acb-c3065aae0986\\\"\\n  }\\n]\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - requestOpenDataSteps (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/23b1d5d83f4444abb20b0cd87e97bf30\"\n      },\n      {\n        \"contentUdi\": \"umb://element/898d075ae29a415abc2f2c4011ffa838\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1c6a6268c0ae4bb29a3cb343cdc0c777\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9e0b42130dd144da831595e5b4a50fdd\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/23b1d5d83f4444abb20b0cd87e97bf30\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>يتم تقديم الطلبات عن طريق ملء نموذج إلكتروني وتقديمه للهيئة&nbsp;<a href=\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\" title=\\\"طلب بيانات مفتوحة\\\">بالضغط هنا</a>.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/898d075ae29a415abc2f2c4011ffa838\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"تقوم الهيئة، باستلام طلب الاطلاع أو الحصول على المعلومات العامة واتخاذ أحد القرارات التالية:\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/1c6a6268c0ae4bb29a3cb343cdc0c777\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"isTree\": \"1\",\n      \"treeElements\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/94798691125849809e399293c9db07e6\"\n            },\n            {\n              \"contentUdi\": \"umb://element/8a66f1ceb8c24fb58792a21765a417f8\"\n            },\n            {\n              \"contentUdi\": \"umb://element/2210004827414642841f89ad476774fa\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/94798691125849809e399293c9db07e6\",\n            \"title\": \"الموافقة\",\n            \"content\": {\n              \"markup\": \"في حال تمت موافقة الهيئة على طلب الوصول إلى المعلومات أو الحصول عليها\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/8a66f1ceb8c24fb58792a21765a417f8\",\n            \"title\": \"الرفض\",\n            \"content\": {\n              \"markup\": \"<p>في حال تم رفض طلب الوصول إلى المعلومات أو الحصول عليها، فيجب أن يكون الرفض خطياً أو إلكترونياً على أن يتضمن المعلومات التالية:</p>\\n<ul>\\n<li>تحديد ما إذا كان رفض الطلب كلياً أو جزئياً.</li>\\n<li>أسباب الرفض، إن أمكن.</li>\\n</ul>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/2210004827414642841f89ad476774fa\",\n            \"title\": \"الإشعار\",\n            \"content\": {\n              \"markup\": \"<p>في حال كانت المعلومات المطلوبة متاحه على موقع الهيئة، أو ليست من اختصاصها فيجب إشعار الفرد بذلك خطياً أو إلكترونياً.</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/9e0b42130dd144da831595e5b4a50fdd\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>في حالة رغبة الفرد في التظلّم على رفض الطلب من قبل الهيئة، فيمكنه تقديم إشعار خطي أو إلكتروني بالتظلم إلى مكتب إدارة البيانات في الهيئة خلال فترة زمنية لا تتجاوز (5) أيام عمل من استلامه لقرار الهيئة، ويقوم مكتب إدارة البيانات في الهيئة بمراجعة الطلب واتخاذ القرار المناسب.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - requestOpenDataSteps (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/4f7fd3bccd064f4f9e3e66e1c2f56c0f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0d082f2390324bb192282befd7ec25e2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e30ee22884af45819223c8a278d2fd2c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/46aa104b536142848d6b8fa70cf80841\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/4f7fd3bccd064f4f9e3e66e1c2f56c0f\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>Applications must be submitted by filling out an electronic form and submitting it to the Authority by <strong><a href=\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\" title=\\\"Open Data Request\\\">clicking here</a></strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/0d082f2390324bb192282befd7ec25e2\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>The Authority receives the request to access or obtain public information and makes one of the following decisions:</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/e30ee22884af45819223c8a278d2fd2c\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"isTree\": \"1\",\n      \"treeElements\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/2a2aeb6220dc4db7ae4c88ffb0052477\"\n            },\n            {\n              \"contentUdi\": \"umb://element/7de86f07733742fdbc0a8b7d796de463\"\n            },\n            {\n              \"contentUdi\": \"umb://element/1a1839cf0d9c471a94a3ec0c76e2b7d8\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/2a2aeb6220dc4db7ae4c88ffb0052477\",\n            \"title\": \"Approval\",\n            \"content\": {\n              \"markup\": \"<p>If the Authority approves the request to access or obtain public information</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/7de86f07733742fdbc0a8b7d796de463\",\n            \"title\": \"Rejection\",\n            \"content\": {\n              \"markup\": \"<p>If the Authority rejects the request to access or obtain public information, the rejection must be in writing or electronically and include the following information:&nbsp;</p>\\n<ul>\\n<li>Determine whether the application was rejected partially or fully.</li>\\n<li>If possible, state the reasons for the rejection.&nbsp;</li>\\n</ul>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n            \"udi\": \"umb://element/1a1839cf0d9c471a94a3ec0c76e2b7d8\",\n            \"title\": \"Notification\",\n            \"content\": {\n              \"markup\": \"<p>If the required information is available on the Authority’s website or is not under its jurisdiction, the individual must be notified in writing or electronically</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"isTree\": \"0\",\n            \"treeElements\": \"\"\n          }\n        ],\n        \"settingsData\": []\n      }\n    },\n    {\n      \"contentTypeKey\": \"5b417776-2caa-4d20-a88c-bf2e3a230ba0\",\n      \"udi\": \"umb://element/46aa104b536142848d6b8fa70cf80841\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>In case the individual wishes to appeal the Authority’s rejection of the application, the appeal can be submitted, in writing or electronically, to the Data Management Office at the Authority within 5 business days of receiving the Authority’s decision. The Data Management Office at the Authority will review the request and make the appropriate decision</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"isTree\": \"0\",\n      \"treeElements\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - shortBrief (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"markup\": \"<p>هناك حقيقة مثبتة منذ زمن طويل وهي أن المحتوى المقروء لصفحة ما سيلهي القارئ عن التركيز على الشكل الخارجي للنص أو شكل توضع الفقرات في الصفحة التي يقرأها.</p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}","newValue":"(Blank)","change":"Update"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"}],"key":"45ba7877-2bde-4dd9-8d40-b226a6d934fb"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/b1fc40d6-1fc0-45bc-adae-c399ee932318.config","name":"طلب بيانات مفتوحة","path":"/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Parent","path":"/Info/Parent","oldValue":"Open Data & KPIs","newValue":"البيانات المفتوحة","change":"Update"},{"success":true,"name":"Path","path":"/Info/Path","oldValue":"//OpenDataKPIs/","newValue":"///","change":"Update"},{"success":true,"name":"Property - description (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"طلب بيانات مفتوحة","change":"Update"},{"success":true,"name":"Property - description (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Request Open Data","change":"Update"},{"success":true,"name":"Property - formDescription (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"قم بملئ البيانات أدناه للتقدم بطلب للحصول على البيانات المفتوحة.","change":"Update"},{"success":true,"name":"Property - formDescription (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Fill in the information below to apply for open data.","change":"Update"},{"success":true,"name":"Property - formIcon","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[]","change":"Update"},{"success":true,"name":"Property - formRef","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"22cfb8de-c8e0-47f5-b153-f92fca702c32","change":"Update"},{"success":true,"name":"Property - formTitle (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"طلب بيانات مفتوحة","change":"Update"},{"success":true,"name":"Property - formTitle (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Request Open Data","change":"Update"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"open\",\n  \"data\",\n  \"open data\",\n  \"Rega\",\n  \"البيانات\",\n  \"البيانات المفتوحة\",\n  \"المفتوحة\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\"\n]","change":"Update"},{"success":true,"name":"Property - pageDescription (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"markup\": \"<p>الخطوات الرئيسة للوصول الى المعلومات أو الحصول عليها</p>\\n<ul>\\n<li>يجب أن يكون الطلب لأغراض الوصول إلى المعلومات العامة أو الحصول عليها.<br>الخطوات الرئيسة لطلب الاطلاع أو الحصول على المعلومات العامة:\\n<ul style=\\\"list-style-type: disc;\\\">\\n<li><strong>أولاً</strong>: يتم تقديم الطلبات عن طريق ملء نموذج إلكتروني وتقديمه للهيئة.</li>\\n<li><strong>ثانياً</strong>: تقوم الهيئة، باستلام طلب الاطلاع أو الحصول على المعلومات العامة واتخاذ أحد القرارات التالية:\\n<ul style=\\\"list-style-type: disc;\\\">\\n<li><strong>الموافقة</strong>: في حال تمت موافقة الهيئة على طلب الوصول إلى المعلومات أو الحصول عليها.</li>\\n<li><strong>الرفض</strong>: في حال تم رفض طلب الوصول إلى المعلومات أو الحصول عليها، فيجب أن يكون الرفض خطياً أو إلكترونياً على أن يتضمن المعلومات التالية:\\n<ul style=\\\"list-style-type: disc;\\\">\\n<li>تحديد ما إذا كان رفض الطلب كلياً أو جزئياً.</li>\\n<li>أسباب الرفض، إن أمكن.</li>\\n<li>الإشعار: في حال كانت المعلومات المطلوبة متاحه على موقع الهيئة، أو ليست من اختصاصها فيجب إشعار الفرد بذلك خطياً أو إلكترونياً.</li>\\n</ul>\\n</li>\\n</ul>\\n</li>\\n<li><strong>ثالثاً</strong>: في حالة رغبة الفرد في التظلّم على رفض الطلب من قبل الهيئة، فيمكنه تقديم إشعار خطي أو إلكتروني بالتظلم إلى مكتب إدارة البيانات في الهيئة خلال فترة زمنية لا تتجاوز (5) أيام عمل من استلامه لقرار الهيئة، ويقوم مكتب إدارة البيانات في الهيئة بمراجعة الطلب واتخاذ القرار المناسب.</li>\\n</ul>\\n</li>\\n</ul>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}","newValue":"(Blank)","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"Open Data Request","newValue":"طلب بيانات مفتوحة","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Request Open Data","change":"Update"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"}],"key":"b1fc40d6-1fc0-45bc-adae-c399ee932318"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content/5f4c9f15-bfdf-472f-9dd4-ef7c2c373787.config","name":"طلب مشاركة البيانات","path":"/f779b169-c5d2-47ae-ba9f-571be1d3d253/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Parent","path":"/Info/Parent","oldValue":"Open Data & KPIs","newValue":"البيانات المفتوحة","change":"Update"},{"success":true,"name":"Path","path":"/Info/Path","oldValue":"//OpenDataKPIs/","newValue":"///","change":"Update"},{"success":true,"name":"Property - hidePageFromNavigation","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"0","change":"Update"}],"key":"5f4c9f15-bfdf-472f-9dd4-ef7c2c373787"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","me