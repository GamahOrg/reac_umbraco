,"change":"Update"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"العقار\",\n  \"الجيومكانية\",\n  \"بوابة\",\n  \"بوابة العقار الجيومكانية\",\n  \"الهيئة العامة للعقار\",\n  \"الخدمات الالكترونية\",\n  \"Rega\"\n]","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"Geospatial real estate portal","newValue":"بوابة العقار الجيومكانية","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Geospatial Real Estate Portal","change":"Update"},{"success":true,"name":"Property - serviceFeature (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"985748c3-ac35-44b5-be35-4874eacaac58\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"بوابة العقار الجيومكانية\\\\\\\" هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الاهتمام (التعليمية، الدينية، الصحية، مرافق الضيافة) ومشاريع البيع على الخارطة (وافي) ومكاتب الوساطة والمكاتب الهندسية المعتمدة في فرز الوحدات العقارية والمناطق العقارية المعلنة للتسجيل العيني للعقار، بالإضافة إلى خدمة البحث والاستعلام عن البيانات المكانية.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"985748c3-ac35-44b5-be35-4874eacaac58\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"بوابة العقار الجيومكانية\\\\\\\" هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الاهتمام (التعليمية، الدينية، الصحية، مرافق الضيافة) ومشاريع البيع على الخارطة (وافي) ومكاتب الوساطة والمكاتب الهندسية المعتمدة في فرز الوحدات العقارية والمناطق العقارية المعلنة للتسجيل العيني للعقار، بالإضافة إلى خدمة البحث والاستعلام عن البيانات المكانية.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - serviceFeature (en-us)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"9eab370b-0970-4970-bbf9-b270317c653e\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Geospatial Real Estate Portal is an electronic portal that shows important data about the real estate sector. It uses interactive maps to provide detailed information about regions, cities, neighborhoods, plots of land, and points of interest like schools, hospitals, and more. You can also find information about Wafi - Off-Plan Sales projects, brokerage offices, certified engineering offices, and real estate areas available for registration. Plus, you can search and inquire about spatial data right on the portal.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"9eab370b-0970-4970-bbf9-b270317c653e\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>The Geospatial Real Estate Portal is an electronic portal that shows important data about the real estate sector. It uses interactive maps to provide detailed information about regions, cities, neighborhoods, plots of land, and points of interest like schools, hospitals, and more. You can also find information about Wafi - Off-Plan Sales projects, brokerage offices, certified engineering offices, and real estate areas available for registration. Plus, you can search and inquire about spatial data right on the portal.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - support","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/3d48a37e56024f799adf2a05b3e3ac1a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a300e386f5654d3cabad90584707818e\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\",\n      \"udi\": \"umb://element/a300e386f5654d3cabad90584707818e\",\n      \"title\": \"\",\n      \"items\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/58b6041ce6c54d6cb235d48f8430e27e\"\n            },\n            {\n              \"contentUdi\": \"umb://element/2ae5ec58cad348e681ecd7ed5c02e2a3\"\n            },\n            {\n              \"contentUdi\": \"umb://element/da895873b881485381c8a8d843ac4765\"\n           