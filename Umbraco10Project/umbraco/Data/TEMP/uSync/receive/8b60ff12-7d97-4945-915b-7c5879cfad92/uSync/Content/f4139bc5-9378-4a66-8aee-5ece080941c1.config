      <Value Culture="ar-jo"><![CDATA[[
  {
    "key": "9975fd18-59b3-4b99-bc0c-867fe8f3938e",
    "name": "Item 1",
    "ncContentTypeAlias": "mediaItem",
    "PropType": null,
    "mediaType": "[\n  \"PDF\"\n]",
    "brief": "{\n  \"markup\": \"<p>هوية الهيئة العامة للعقار<br>تستعرض هوية الهيئة العامة للعقار رموز الفخر والاعتزازبالهوية الوطنية عبر السيفين والنخلة، إضافة إلى لمسات فنية تعمّق ذلك الاعتزاز وتمثل شكل العمارة السعودية.<br>يتلوها أربعة أشكال تعكس الركائز الإستراتيجية الأربعة للهيئة. وأخيراً يظهر عنصر التشريعات كأساس يعبر عن دور الهيئة في التمكين.<br>تحتضن الركائز وتنطلق منها بروح وطنية مبتكرة<br>نحو قطاع زاخر بالنمو والمنجزات</p>\\n<p>&nbsp;</p>\\n<p><a href=\\\"/{localLink:umb://media/5830416bb6e74b119802b51700f68dc6}\\\" title=\\\"الدليل الإرشادي REGA (1)\\\">لتحميل الهوية البصرية</a></p>\",\n  \"blocks\": {\n    \"contentData\": [],\n    \"settingsData\": []\n  }\n}",
    "date": "2024-07-07T00:00:00",
    "mediaFile": "[\n  {\n    \"key\": \"1a2b4c6c-0954-4788-aa23-ae7dc7327511\",\n    \"mediaKey\": \"5830416b-b6e7-4b11-9802-b51700f68dc6\"\n  }\n]",
    "youTubeLink": "",
    "youTubeImage": "[\n  {\n    \"key\": \"d863c4fe-0a40-407f-8a44-273ff9557246\",\n    \"mediaKey\": \"19fdbef8-630c-4b2f-ae66-634389935ae4\"\n  }\n]"
  }
]]]></Value>
