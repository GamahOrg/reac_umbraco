  <Properties>
    <description>
      <Value Culture="ar-jo"><![CDATA[يهدف المعرض إلى تسليط الضوء على دور القطاع العقاري في التأثير على جهود تنويع مصادر الاستثمار كأحد أهم أهداف رؤية المملكة 2030. كما ينقل التطورات في القطاع العقاري السعودي في المشاريع السكنية والتجارية متعددة الاستخدامات وتوجهاتها.]]></Value>
      <Value Culture="en-us"><![CDATA[]]></Value>
    </description>
    <endDate>
      <Value Culture="ar-jo"><![CDATA[2024-02-21T00:00:00]]></Value>
