ument/8d47302db37544ef9d8f2aa3fcc3e2fe","flags":4512,"change":0},{"name":"مجلس إدارة الهيئة العامة للعقار يستعرض إنجازات الربع الثاني 2018 م","udi":"umb://document/2a9c703e526347dbaa8c310fe7f2c350","flags":4512,"change":0},{"name":"المعهد العقاري السعودي عقد الاجتماع الثاني لمجلس إدارته","udi":"umb://document/42564342db6441f2b594e9681fa32d91","flags":4512,"change":0},{"name":"\"المبارك كشف عن خطط الهيئة في لقاء مفتوح في \"غرفة القصيم","udi":"umb://document/32270fbaa8ef458fb05ba622c3c8130a","flags":4512,"change":0},{"name":"\"هيئة العقار\" تشارك في معرض \"ريستاتكس\".. والمبارك يعرّف بدورها وخططها","udi":"umb://document/e1b239bedc8a4b8986cf00ee348ba742","flags":4512,"change":0},{"name":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الرابع","udi":"umb://document/8e4d9b0d4b234994b8494b1f8f728d16","flags":4512,"change":0},{"name":"مجلس الهيئة العامة للعقار يعقد اجتماعه السادس","udi":"umb://document/84058526c4414d80ac478a8e062620b6","flags":4512,"change":0},{"name":"\"الهيئة العامة للعقار تدشن موقعها الإلكتروني.. وتطلق حسابها في \"تويتر","udi":"umb://document/6a233bc8b4ec410bb2870759687a75a5","flags":4512,"change":0},{"name":"مذكرة تفاهم تجمع المركز السعودي للتحكيم التجاري والهيئة العامة للعقار","udi":"umb://document/972d7af04c374f33aeb863b1200ccd5a","flags":4512,"change":0},{"name":"الهيئة العامة للعقار توقع اتفاقية مع مركز الاتصال الوطني آمر","udi":"umb://document/6c60d39618254f8eb007a0a8c7348fdc","flags":4512,"change":0},{"name":"هيئة العقار تستعرض استراتيجيتها خلال ورشة عمل","udi":"umb://document/2b229008e77f4b1aaf736e010d2fd952","flags":4512,"change":0},{"name":"الحقيل: إنشاء الهيئة العامة للعقار يعزّز أداء القطاع العقاري ويرفع من مساهمته في الناتج المحلي","udi":"umb://document/ecef77f020c8487cbfdf5295a11eb15b","flags":4512,"change":0},{"name":"محافظ الهيئة العامة للعقار يعلن طرح المسودة الأولى من نظام الوساطة العقارية ونظام المساهمات العقارية لطلب مرئيات العموم","udi":"umb://document/5871643367394d72a13cce8e1b268920","flags":4512,"change":0},{"name":"الأمير سعود بن ط