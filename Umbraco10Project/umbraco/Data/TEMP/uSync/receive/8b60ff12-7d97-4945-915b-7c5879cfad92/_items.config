ير مشروعات عقارية على الخارطة","udi":"umb://document/fead8a33833f49b19cd04007210d68f1","flags":4512,"change":0},{"name":"الهيئة العامة للعقار تُعلن عن خمسة أحياء مستفيدة من السجل العقاري في مدينة الرياض ابتداءً من 21 رمضان الحالي","udi":"umb://document/d730977df8fb42a49df14917383736a1","flags":4512,"change":0},{"name":"\"هيئة العقار\" تُعلن عن 8 أحياء مستفيدة من السجل العقاري في مدينة مكة المكرمة ابتداءً من الـ18 من ذي القعدة","udi":"umb://document/3842f7a24d4f46e7a6c3e858ed987ad5","flags":4512,"change":0},{"name":"مجلس إدارة الهيئة العامة للعقار يعقد اجتماعه الـ26","udi":"umb://document/08fd0d366a6b49cf821a3a12f6094c92","flags":4512,"change":0},{"name":"الهيئة العامة للعقار تدعو ملاك العقارات في خمسة أحياء بمدينة الرياض لتسجيل عقاراتهم في \" السجل العقاري\" ابتداءً من اليوم","udi":"umb://document/e500d4c8ed334068a2b4d78637d9eb95","flags":4512,"change":0},{"name":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م","udi":"umb://document/b9c92f83edce4e00a2d1ca8eb7698e2e","flags":4512,"change":0},{"name":"\"هيئة العقار\": أكثر من 46 ألف رخصة (فال العقارية) منذ بدء نظام الوساطة العقارية، منها 11 ألفًا خلال الربع الأول لعام 2024م (1)","udi":"umb://document/e625dbf570264ef0bdb52d3c0ef11028","flags":4512,"change":0},{"name":"الهيئة العامة للعقار تُعلن بدء التسجيل في عشرة أحياء مستفيدة من السجل العقاري في مدينة الرياض","udi":"umb://document/a843a5e9f0c0467d9c11fda68b695fe0","flags":4512,"change":0},{"name":"\"هيئة العقار\" تعلن بدء استقبال طلبات ترخيص المشاريع على الخارطة بالتزامن مع نشر اللائحة التنفيذية للنظام بعد اعتمادها","udi":"umb://document/71cb4b1faaee4b199212c768f8596557","flags":4512,"change":0},{"name":"\" هيئة العقار\":   أكثر من 20 ألف زيارة خلال الربع الأول لعام 2024م لضمان الامتثال بالأنظمة في التعاملات العقارية","udi":"umb://document/21f96464ad744632bcd2b7b7e3b19ef4","flags":4512,"change":0},{"name":"الهيئة العامة للعقار شريك تشريعي في معرض سيريدو العقاري 2024 بجدة","udi":"umb://docum