"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":""}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":""}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"8f05199d-d022-3661-b9b6-82b9b5656919","Alias":"مركز بروتيك السعودية","Path":"/9ba9c31f-1a20-4991-b82f-366f6757f12f.config","Level":3000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/9ba9c31f-1a20-4991-b82f-366f6757f12f.config","Node":{"Content":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","@Alias":"مركز بروتيك السعودية","@Level":"3","Info":{"Parent":{"@Key":"57e2ffd7-7ded-4321-be03-902bb2436ac8","#text":"مركز بروتيك السعودية"},"Path":"///","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-26T15:35:45","NodeName":{"@Default":"مركز بروتيك السعودية"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p><img style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"\\\" alt=\\\"\\\" width=\\\"279\\\" height=\\\"128\\\" data-udi=\\\"umb://media/803b9f26f2de429893517e77b49fcb89\\\"></p>\\n<p>&nbsp;</p>\\n<p>إسهاماً من الهيئة العامة للعقار وإيمانًا منها بدور التقنية في القطاع العقاري وما تمثله من آفاق مستقبلية تسهم في تحقيق مستهدفات رؤية السعودية<span>&nbsp; ٢٠٣٠ التي دعت إلى ضرورة التحول الرقمي ومواصلة توسيع نطاق الخدمات الرقمية، ولما تحظى به التقنيات العقارية \\\"</span>البروبتك\\\" من تمكين كونها تمثل جزءً لا يتجزأ من الحراك التقني والتحول الرقمي الذي<span>&nbsp; تشهده مختلف القطاع الحيوية والاقتصادية بالسعودية </span>، فقد سعت الهيئة لخلق بيئة حاضنة للتقنية العقارية ومجتمع يضم التقنيين العقاريين من خلال إنشاء مركز متكامل لخدمة المهتمين والمتخصصين بالمجال ، مما يسهم في بناء فرص للتواصل مع الجهات المحلية والعالمية، وربط الشركات التقنية ورواد الأعمال بالمستثمرين وأصحاب رؤوس الأموال ، إضافةً إلى تبادل المعرفة وتعزيز الابتكار وتطوير التقنيات العقارية للوصول إلى مستهدفات الاستراتيجية الشاملة للقطاع العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\",\n      \"title\": \"التعريف بالمركز :\",\n      \"content\": {\n        \"markup\": \"<p>مركز بروتيك السعودية مجتمع متكامل لخدمة المهتمين والمتخصصين بالتقنية العقارية محليًا وعالميًا ، ويقدم العديد من الخدمات التي تسهم في تمكين أصحاب العلاقة بما يسهم في تطوير<span>&nbsp; القطاع وتعزيز </span>نموه ورفع كفاءته.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\",\n      \"title\": \"المستفيدون :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li>\\n<p>رواد الأعمال <span>&nbsp;وأصحاب </span>المنشآت الناشئة</p>\\n</li>\\n<li>\\n<p>الشركات المحلية</p>\\n</li>\\n<li>الشركات العالمية</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\",\n      \"title\": \"المبادرات التابعة للمركز:\",\n      \"content\": \"\",\n      \"listOfSubcontent\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/19e5b30a0ac94e6a928590206a37294a\"\n            },\n            {\n              \"contentUdi\": \"umb://element/d625b07075144966b8a697edc2f4d21e\"\n            },\n            {\n              \"contentUdi\": \"umb://element/cc73c50281194e0784500396a04e51e3\"\n            },\n            {\n              \"contentUdi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\",\n            \"title\": \"القمة العالمية للتقنية العقارية\",\n            \"content\": {\n              \"markup\": \"<p>تعزيز مكانة المملكة العربية السعودية في مجال التقنية العقارية وجذب الشركات والخبراء البارزين في هذا المجال.</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/c3395462683542fd8c1378dd0fd2a0db\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/cc73c50281194e0784500396a04e51e3\",\n            \"title\": \"مجلس بروبتيك\",\n            \"content\": {\n              \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطاع التقنية العقارية لتبادل المعرفة والخبرات</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/6bb3663f174746c0b49bc57485392f66\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/19e5b30a0ac94e6a928590206a37294a\",\n            \"title\": \"البيئة التنظيمية التجريبية\",\n            \"content\": {\n              \"markup\": \"<p>إجراء التجارب للتقنيات والمنتجات والخدمات واختبار توافقها مع الأنظمة والتشريعات الحالية أو اقتراح تعديلات عليها ، ويكون ذلك عبر بيئة واقعية<span>&nbsp; </span>و مرنة تختبر فاعلية التقنيات ونماذج الأعمال المبتكرة التي لها صلة بالتقنية العقارية</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/36652cc6eff74f20be3816b554f1146c\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/d625b07075144966b8a697edc2f4d21e\",\n            \"title\": \"مسرعة الاعمال\",\n            \"content\": {\n              \"markup\": \"<p>برنامج متقدم يركز على تسريع نمو وتوسع الشركات الريادية والناشئة في مجال التقنية العقارية</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/a7565298ce4b4bba924efc1dfb9d1411\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          }\n        ],\n        \"settingsData\": []\n      },\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"مركز بروتيك السعودية"}},"pageTitle":{"Value":{"#cdata-section":"مركز بروتيك السعودية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":"مركز بروتيك السعودية"}}}}},"IsRoot":true},{"Key":"df7c2dac-5e70-38fa-b6f5-a79dad9b8091","Alias":"القمة العالمية للبروبتك","Path":"/332fceee-681a-4f0a-8359-9d5a589c8aba.config","Level":3000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/332fceee-681a-4f0a-8359-9d5a589c8aba.config","Node":{"Content":{"@Key":"332fceee-681a-4f0a-8359-9d5a589c8aba","@Alias":"القمة العالمية للبروبتك","@Level":"3","Info":{"Parent":{"@Key":"3b184f5f-42a2-4b95-8b1b-a780b3348e65","#text":"القمة العالمية للبروبتك"},"Path":"///","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-09-09T13:09:10","NodeName":{"@Default":"القمة العالمية للبروبتك"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/7f6e375f509d4b339eec8f5554a5b22e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/32b23fffdfca4f8f842b6aec987bdbc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/af8a9b5bb8774643bceaf65e5fe11a69\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/7f6e375f509d4b339eec8f5554a5b22e\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p dir=\\\"rtl\\\">&nbsp;قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/32b23fffdfca4f8f842b6aec987bdbc8\",\n      \"title\": \"أهداف المبادرة\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز مكانة المملكة العربية السعودية كمركز رائد في التقنية العقارية .</li>\\n<li class=\\\"O0\\\">فتح الفرص للشركات العالمية للاستثمار محلياً في التقنية العقارية.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات التقنية  من خلال استقطاب الخبرات العالمية.</li>\\n<li class=\\\"O0\\\">الارتقاء بريادة الأعمال المحلية.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/af8a9b5bb8774643bceaf65e5fe11a69\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"https://globalproptechsummit.com\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":" قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية."}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":""}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":"[\n  \"القمة العالمية للبروبتيك\",\n  \"بروبتيك\",\n  \"الهيئة العامة للعقار\",\n  \"قمة\",\n  \"القمة\",\n  \"العالمية\"\n]"}},"pageName":{"Value":{"#cdata-section":"القمة العالمية للبروبتك"}},"pageTitle":{"Value":{"#cdata-section":"القمة العالمية للبروبتك"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":"umb://media/ba6d866b399d4d158df62ecef4617b90"}},"title":{"Value":{"#cdata-section":"القمة العالمية للبروبتك"}}}}},"IsRoot":true},{"Key":"191da11f-8b31-3053-80be-dc7ca3d70635","Alias":"مجلس بروبتيك","Path":"/6bb3663f-1747-46c0-b49b-c57485392f66.config","Level":4000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/6bb3663f-1747-46c0-b49b-c57485392f66.config","Node":{"Content":{"@Key":"6bb3663f-1747-46c0-b49b-c57485392f66","@Alias":"مجلس بروبتيك","@Level":"4","Info":{"Parent":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","#text":"مركز بروتيك السعودية"},"Path":"////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-29T13:53:01","NodeName":{"@Default":"مجلس بروبتيك"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطا ع التقنية العقارية لتبادل المعرفة والخبرات و تسليط الضوء على أحدث التطورات في التقنيات العقارية بما يسهم في رفع مستوى الوعي بأهمية التقنيات في تعزيز كفاءة السوق العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\",\n      \"title\": \"أهداف المبادرة :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز المعرفة بالتقنيات العقارية وتسليط الضوء على أحدث التطورات فيها.</li>\\n<li class=\\\"O0\\\">تشجيع التعاون بين الشركات عن طريق بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية.</li>\\n<li class=\\\"O0\\\">نشر الوعي والتثقيف بأهمية التقنيات العقارية الحديثة وكيفية الاستفادة منها لتحسين الأداء وزيادة الكفاءة في السوق العقاري.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات والأفكار عن طريق توفير منصة يشارك فيها المتخصصون تجاربهم وأفكارهم والحلول المبتكرة لمواجهة تحديات القطاع العقاري .</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مجلس <span>&nbsp;بروبتيك؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">جلسات حوارية تجمع الخبرات والعاملين بالقطاع العقاري والتقني</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو الهدف من<span>&nbsp; المجلس؟</span>\\n<ul style=\\\"list-style-type: circle;\\\">\\n<li>تعزيز المعرفة بالتقنيات العقارية</li>\\n<li>تبادل الخبرات والأفكار</li>\\n<li>رفع مستوى الوعي بأهمية التقنيات العقارية الحديثة</li>\\n<li>تحسين الأداء وزيادة الكفاءة في السوق العقاري</li>\\n<li>بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية</li>\\n<li>تعزيز التكامل وتحقيق الفائدة المشتركة</li>\\n</ul>\\n</li>\\n</ul>\\n<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد شهادة للحضور ؟</li>\\n</ul>\\n</div>\\n<div class=\\\"O0\\\" style=\\\"padding-right: 40px; padding-left: 40px;\\\">لا</div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; رواد الأعمال </span>و أصحاب الشركات الناشئة<span>&nbsp; الصغيرة </span>و المتوسطة</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مجلس التقنية العقارية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"db577ddb-0b96-3761-9a6a-6f0012cb41f5","Alias":"تفاصيل عقد الإيجار","Path":"/4ee94b42-b0af-4fd1-a352-34603600827e.config","Level":4000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/4ee94b42-b0af-4fd1-a352-34603600827e.config","Node":{"Content":{"@Key":"4ee94b42-b0af-4fd1-a352-34603600827e","@Alias":"تفاصيل عقد الإيجار","@Level":"4","Info":{"Parent":{"@Key":"e0e48bab-5392-48f6-8fcc-04278108184f","#text":"Result Page"},"Path":"//CentralizedSearch/ResultPage/","Trashed":"false","ContentType":"ejarContractDetails","CreateDate":"2024-12-12T15:34:09","NodeName":{"@Default":"تفاصيل عقد الإيجار"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"d2e1b909-3328-42be-878a-078a0348ecc9","#text":"EjarContractDetails"}},"Properties":{"description":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"0"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":"تفاصيل عقد الإيجار"}},"pageTitle":{"Value":{"#cdata-section":"تفاصيل عقد الإيجار"}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":"تفاصيل عقد الإيجار"}}}}},"IsRoot":true},{"Key":"4504babf-918d-3e11-8ca6-7035187b8695","Alias":"مسرعات الأعمال","Path":"/a7565298-ce4b-4bba-924e-fc1dfb9d1411.config","Level":4001,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/a7565298-ce4b-4bba-924e-fc1dfb9d1411.config","Node":{"Content":{"@Key":"a7565298-ce4b-4bba-924e-fc1dfb9d1411","@Alias":"مسرعات الأعمال","@Level":"4","Info":{"Parent":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","#text":"مركز بروتيك السعودية"},"Path":"////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-29T13:53:30","NodeName":{"@Default":"مسرعات الأعمال"},"SortOrder":"1","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e64f2e78e0c4443c8ba82f92e2827955\"\n      },\n      {\n        \"contentUdi\": \"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\"\n      },\n      {\n        \"contentUdi\": \"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة عن طريق توفير مجموعة شاملة من الخدمات تشمل مساحات العمل المشتركة، والخدمات المتخصصة لتطوير الأعمال، و تتضمن الاستشارات والتوجيه والتدريب، بالإضافة لتيسير الوصول إلى المستثمرين من أجل تسريع تطوّر ونمو الشركات الناشئة والريادية وتوسعها,<span>&nbsp; والعمل على تأسيسها بشكل سليم لتكون داعمة&nbsp; للقطاع العقاري </span>و رفع مساهمته في الناتج المحلي للمملكة العربية السعودية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e64f2e78e0c4443c8ba82f92e2827955\",\n      \"title\": \"اهداف المبادرة:\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>خلق شركات ناشئة<span>&nbsp; على أسس سليمة داعمة للقطاع العقاري </span></li>\\n<li>رفع مساهمة<span>&nbsp; الشركات الناشئة في القطاع العقاري للاقتصاد الوطني </span></li>\\n<li>توسع الشركات في التقنية العقارية محليًا<span>&nbsp; ودوليًا </span></li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\",\n      \"title\": \"النسخة الأولى من برنامج مسرعة التقنية العقارية \",\n      \"content\": {\n        \"markup\": \"<p>تأتي مسرعة التقنية العقارية بنسختها الأولى بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات<span>&nbsp; </span>و نسعد بإعلان فتح<span>&nbsp; التسجيل&nbsp; لبرنامج المسرعة </span>عن طريق مسرعة الأعمال العالمية startup wise guys</p>\\n<p><strong>أخر موعد للتقديم: 15/12/2024</strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"https://startupwiseguys.com/all-programs/proptech-accelerator-program/\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\",\n      \"title\": \"الأسئلة الشائعة \",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul>\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">برامج مكثفة لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة ، و يوفر مجموعة شاملة من الخدمات والموارد، بما في ذلك توفير مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\n<div>\\n<ul>\\n<li>ماذا تقدم المسرعة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">الدعم المعرفي للشركات الناشئة من خلال عدة برامج من ضمنها<span>&nbsp; التدريب&nbsp; </span>و الارشاد و التوجيه بهدف تأسيس شركات على أسس سليمة</p>\\n<div class=\\\"O0\\\">\\n<ul>\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\n</ul>\\n</div>\\n<ul>\\n<li style=\\\"list-style-type: none;\\\">\\n<ul>\\n<li class=\\\"O0\\\">ورش عمل<span>&nbsp; متخصصة في التقنية العقارية&nbsp; .</span></li>\\n<li class=\\\"O0\\\">قصص نجاح من أبرز رواد الاعمال و المؤثرين .</li>\\n<li class=\\\"O0\\\">جلسات استشارية و ارشادية</li>\\n<li class=\\\"O0\\\">الربط مع الجهات التمويلية .</li>\\n</ul>\\n</li>\\n</ul>\\n<div><span></span></div>\\n<div>\\n<ul>\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; مدة البرنامج 6 شهور </span></p>\\n<ul>\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; لا يوجد رسوم</span></p>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"مسرعات الأعمال"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"d8af35c6-0a85-303e-a138-36f5daecbe1a","Alias":"البيئة التنظيمية التجريبية","Path":"/36652cc6-eff7-4f20-be38-16b554f1146c.config","Level":4002,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/36652cc6-eff7-4f20-be38-16b554f1146c.config","Node":{"Content":{"@Key":"36652cc6-eff7-4f20-be38-16b554f1146c","@Alias":"البيئة التنظيمية التجريبية","@Level":"4","Info":{"Parent":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","#text":"مركز بروتيك السعودية"},"Path":"////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-29T13:53:41","NodeName":{"@Default":"البيئة التنظيمية التجريبية"},"SortOrder":"2","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>تتيح هذه المبادرة للشركات والمبتكرين في مجال العقار فرصة تجربة تقنياتهم ومنتجاتهم وتطوير أفكارهم، بالإضافة لتعزيز التفاعل بين القطاعين العام والخاص<span>&nbsp; مما يسهم في تعزيز الابتكار والنمو في القطاع</span> العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\",\n      \"title\": \"أهداف المبادرة \",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز التفاعل والتعاون بين القطاعين العام والخاص.</li>\\n<li class=\\\"O0\\\">تمكين الشركات من اختبار خدماتها وابتكاراتها بشكل عملي.</li>\\n<li class=\\\"O0\\\">تطوير أطر تنظيمية تعكس التقدم التقني وتحقق التوازن بين الابتكار والتنظيم في قطاع العقارات.</li>\\n<li class=\\\"O0\\\">تحقيق توازن فعّال بين الابتكار والامتثال التنظيمي في قطاع العقار.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\",\n      \"title\": \" الفئات المسموح لها بالتقدم\",\n      \"content\": {\n        \"markup\": \"<ul style=\\\"list-style-type: square;\\\">\\n<li>شركات التقنية الناشئة:</li>\\n</ul>\\n<p style=\\\"padding-left: 80px;\\\">شركات مطورة لحلول تقنية جديدة أو خدمات بهدف استخدامها في القطاع العقاري سواءً كانت شركات محلية أو شركات عالمية وصدر أو لم يصدر لها تشريع ينظم عملها.</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>نماذج العمل</li>\\n</ul>\\n<p style=\\\"padding-left: 40px;\\\">نماذج الأعمال التي تتضمن حلول مبتكرة أو تقنيات جديدة وتتعلق بأنشطة العقار صدرت لها لوائح &nbsp;تنظيمية أو تتطلب إصدار لوائح تنظيمية جديدة تتواءم مع طبيعة عملها.</p>\\n<p style=\\\"text-align: center;\\\"><strong>أخر موعد للتقديم: 31/01/2025</strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"umb://document/644430d0b05c4e27babd320927603de8\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي البيئة التنظيمية التجريبية وما الغرض منه؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تمثل بيئة تسمح للشركات والمبتكرين في مجال العقارات بتجربة تقنياتهم ومنتجاتهم بحرية تنظيمية تحت إشراف الهيئة العامة للعقار ، وتهدف إلى تعزيز التفاعل بين القطاعين العام والخاص، مما يتيح للشركات اختبار خدماتها وابتكاراتها بشكل يواءم الأطر القانونية الحالية ، مما يمكن الهيئة العامة للعقار من تقييم الابتكارات وتطوير أطر تنظيمية تعكس التقدم التقني وتحقق توازناً بين الابتكار والتنظيم في قطاع العقارات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لماذا تقدم الهيئة العامة للعقار البيئة التنظيمية التجريبية؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span> </span>توفر البيئة التنظيمية التجريبية للشركات فرصة للتعاون مع الجهات الحكومية لتحديد الإطار التنظيمي الذي من شأنه أن يدعم العمليات التجارية لهذه الشركات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>    رواد الأعمال </span>و أصحاب الشركات الناشئة الصغيرة و المتوسطة<span>  المحلية </span>و الدولية</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل هناك معايير للقبول ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم<span>  ، تقديم عرض </span>و نموذج تفصيلي عن خطة<span>  العمل </span>و يتم دارسته</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>كيف سوف يتم اشعار القبول للبيئة التنظيمية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">عبر البريد الالكتروني</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل تؤدي البيئات التنظيمية التجريبية<span>  إلى تخفيف اللوائح التنظيمية وتقليل </span>و تساهم في خلق أنظمة داعمة؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لمَاذا على الشركات القائمة على الابتكار الالتحاق بالبيئة التنظيمية التجريبية ؟ </li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">لتجربة النموذج المبتكر و هل الأنظمة تساعد على استكمال الإجراءات القانونية و التشريعية من ناحية التراخيص</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي المدة<span>  المستغرقة لاختبار النموذج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">12 شهر</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مفهوم<span>  الاختبار الناجح للخدمات </span>و المنتجات المبتكرة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">يحدد<span>  المتقدمون المعايير الخاصة  بخدماتهم </span>و منتجاتهم المبتكرة وكذلك سيحدد فريق العمل معايير معينة للقبول<span>  </span></p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>في حال نجحت التجارب هل سيتم الحصول على الترخيص بشكل مباشر ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تتم عبر<span>  عدة مراحل وسيتم اخطار المتأهلين حولها</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"البيئة التنظيمية التجريبية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"12bd1fe8-fd34-3d57-b348-a9b72e2a3171","Alias":"القمة العالمية للتقنية العقارية","Path":"/c3395462-6835-42fd-8c13-78dd0fd2a0db.config","Level":4003,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/c3395462-6835-42fd-8c13-78dd0fd2a0db.config","Node":{"Content":{"@Key":"c3395462-6835-42fd-8c13-78dd0fd2a0db","@Alias":"القمة العالمية للتقنية العقارية","@Level":"4","Info":{"Parent":{"@Key":"9ba9c31f-1a20-4991-b82f-366f6757f12f","#text":"مركز بروتيك السعودية"},"Path":"////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-10-22T05:59:06","NodeName":{"@Default":"القمة العالمية للتقنية العقارية"},"SortOrder":"3","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/1952c746e3554815bbda233b9a5b073c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0837774f0a264d5385407454bc632bf7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c32f8bc8d7c04c8d971d68b3c34606c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2c1ada7384da4ee0b37ee0e883974392\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/1952c746e3554815bbda233b9a5b073c\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p><span>&nbsp;</span>قمة تستضيف أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز ريادة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/0837774f0a264d5385407454bc632bf7\",\n      \"title\": \"أهداف المبادرة\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز مكانة المملكة العربية السعودية كمركز رائد في التقنية العقارية .</li>\\n<li class=\\\"O0\\\">فتح الفرص للشركات العالمية للاستثمار محلياً في التقنية العقارية.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات التقنية<span>&nbsp; من خلال استقطاب الخبرات العالمية.</span></li>\\n<li class=\\\"O0\\\">الارتقاء بريادة الأعمال المحلية.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/c32f8bc8d7c04c8d971d68b3c34606c2\",\n      \"title\": \"تاريخ ومكان إقامة الحدث\",\n      \"content\": {\n        \"markup\": \"<p>المكان : <span>&nbsp;( فندق موفنبيك الرياض</span>)</p>\\n<p>التاريخ : 27 – 28 أكتوبر 2024 م<span>&nbsp; </span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/2c1ada7384da4ee0b37ee0e883974392\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>اين تقام القمة العالمية للبروبتك؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">في مدينة الرياض بتاريخ 27 و28 أكتوبر في فندق الموفينبيك</div>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي<span>&nbsp; قمة&nbsp; البروبتيك؟</span></li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\"><span>&nbsp; قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.</span></div>\\n<div style=\\\"padding-right: 40px;\\\"><span></span></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\"><span>رواد الاعمال&nbsp;</span>و أصحاب الشركات الناشئة و المتوسطة<span>&nbsp; المحلية </span>و الدولية<span>&nbsp; </span>و المهتمين في التقنية العقارية</div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يتطلب التسجيل للحضور الى القمة؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\"><span>نعم&nbsp;</span></div>\\n<div style=\\\"padding-right: 40px;\\\"><span></span></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li><span>هل هناك رسوم للمشاركة ؟</span></li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">اذا<span>&nbsp; زائر لا يوجد رسوم ,&nbsp; الرسوم على العارضين </span>و الرعاة</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد جدول للمتحدثين ؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">نعم</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد جدول لورش العمل ؟&nbsp;</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">نعم</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد رسوم لحضور ورش العمل ؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">لا</div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ماهي الجهات المشاركة؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">يمكن مراجعة الموقع الخاص بالحدث <br><a rel=\\\"noopener\\\" href=\\\"https://globalproptechsummit.com\\\" target=\\\"_blank\\\">https://globalproptechsummit.com</a></div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div style=\\\"padding-right: 40px;\\\"></div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>كيف أحصل على اجندة القمة؟</li>\\n</ul>\\n</div>\\n<div style=\\\"padding-right: 40px;\\\">من خلال الرابط الإلكتروني التالي :</div>\\n<div style=\\\"padding-right: 40px;\\\"><a rel=\\\"noopener\\\" href=\\\"https://globalproptechsummit.com\\\" target=\\\"_blank\\\">https://globalproptechsummit.com</a><br><br></div>\\n<div></div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}"}},"description":{"Value":{"#cdata-section":""}},"formDescription":{"Value":{"#cdata-section":""}},"formIcon":{"Value":{"#cdata-section":"[]"}},"formRef":{"Value":{"#cdata-section":""}},"formTitle":{"Value":{"#cdata-section":""}},"headerBackgroundImage":{"Value":{"#cdata-section":""}},"hidePageFromNavigation":{"Value":{"#cdata-section":"1"}},"keywords":{"Value":{"#cdata-section":""}},"pageName":{"Value":{"#cdata-section":""}},"pageTitle":{"Value":{"#cdata-section":"القمة العالمية للتقنية العقارية"}},"protectedByNafath":{"Value":{"#cdata-section":""}},"shortBrief":{"Value":{"#cdata-section":""}},"socialMediaImage":{"Value":{"#cdata-section":""}},"title":{"Value":{"#cdata-section":""}}}}},"IsRoot":true},{"Key":"0b7b4e8c-62b3-379b-bb1a-711d57d9b28c","Alias":"التقديم","Path":"/644430d0-b05c-4e27-babd-320927603de8.config","Level":5000,"FileName":"/Users/alhazmy13/Projects/rega-website/Umbraco10Project/umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/644430d0-b05c-4e27-babd-320927603de8.config","Node":{"Content":{"@Key":"644430d0-b05c-4e27-babd-320927603de8","@Alias":"التقديم","@Level":"5","Info":{"Parent":{"@Key":"36652cc6-eff7-4f20-be38-16b554f1146c","#text":"البيئة التنظيمية التجريبية"},"Path":"/////","Trashed":"false","ContentType":"probtechHubPage","CreateDate":"2024-08-29T13:54:16","NodeName":{"@Default":"التقديم"},"SortOrder":"0","Published":{"@Default":"true"},"Schedule":null,"Template":{"@Key":"36642e28-d780-41b3-a063-fd94af0ac5a1","#text":"ProbtechHubPage"}},"Properties":{"content":{"Value":{"#cdata-section":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/bbc82cafdac8