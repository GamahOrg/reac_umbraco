عة التقنية العقارية \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تأتي مسرعة التقنية العقارية بنسختها الأولى بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات<span>&nbsp; </span>و نسعد بإعلان فتح<span>&nbsp; التسجيل&nbsp; لبرنامج المسرعة </span>عن طريق مسرعة الأعمال العالمية startup wise guys</p>\\\\\\\\n<p><strong>أخر موعد للتقديم: 15/12/2024</strong></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":\\\"https://startupwiseguys.com/all-programs/proptech-accelerator-program/\\\"},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\\\",\\\"title\\\":\\\"الأسئلة الشائعة \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">برامج مكثفة لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة ، و يوفر مجموعة شاملة من الخدمات والموارد، بما في ذلك توفير مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\\\\\\\n<div>\\\\\\\\n<ul>\\\\\\\\n<li>ماذا تقدم المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">الدعم المعرفي للشركات الناشئة من خلال عدة برامج من ضمنها<span>&nbsp; التدريب&nbsp; </span>و الارشاد و التوجيه بهدف تأسيس شركات على أسس سليمة</p>\\\\\\\\n<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<ul>\\\\\\\\n<li style=\\\\\\\\\\\\\\\"list-style-type: none;\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">ورش عمل<span>&nbsp; متخصصة في التقنية العقارية&nbsp; .</span></li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">قصص نجاح من أبرز رواد الاعمال و المؤثرين .</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">جلسات استشارية و ارشادية</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">الربط مع الجهات التمويلية .</li>\\\\\\\\n</ul>\\\\\\\\n</li>\\\\\\\\n</ul>\\\\\\\\n<div><span></span></div>\\\\\\\\n<div>\\\\\\\\n<ul>\\\\\\\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; مدة البرنامج 6 شهور </span></p>\\\\\\\\n<ul>\\\\\\\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; لا يوجد رسوم</span></p>\\\\\\\\n<p dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"formIcon","path":"Property/formIcon","oldValue":"null","newValue":"\"[]\"","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"0","newValue":"\"1\"","change":"Update"}],"key":"a7565298-ce4b-4bba-924e-fc1dfb9d1411"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/36652cc6-eff7-4f20-be38-16b554f1146c.config","name":"البيئة التنظيمية التجريبية","path":"/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"content","path":"Property/content","oldValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\\\"},{\\\"contentUdi\\\":\\\"umb://element/d1f2a3498cb94495a00fbece98d8665c\\\"},{\\\"contentUdi\\\":\\\"umb://element/ef20fcceac074210b144cdbca86fe1db\\\"},{\\\"contentUdi\\\":\\\"umb://element/b3ffe468fcce44dbb4f374b37a37d178\\\"},{\\\"contentUdi\\\":\\\"umb://element/b84dcc857c914adb99ab9b32adc66977\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تتيح هذه المبادرة للشركات والمبتكرين في مجال العقار فرصة تجربة تقنياتهم ومنتجاتهم وتطوير أفكارهم، بالإضافة لتعزيز التفاعل بين القطاعين العام والخاص<span>&nbsp; مما يسهم في تعزيز الابتكار والنمو في القطاع</span> العقاري.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/d1f2a3498cb94495a00fbece98d8665c\\\",\\\"title\\\":\\\"أهداف المبادرة \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<ul>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تعزيز التفاعل والتعاون بين القطاعين العام والخاص.</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تمكين الشركات من اختبار خدماتها وابتكاراتها بشكل عملي.</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تطوير أطر تنظيمية تعكس التقدم التقني وتحقق التوازن بين الابتكار والتنظيم في قطاع العقارات.</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تحقيق توازن فعّال بين الابتكار والامتثال التنظيمي في قطاع العقار.</li>\\\\\\\\n</ul>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/ef20fcceac074210b144cdbca86fe1db\\\",\\\"title\\\":\\\" الفئات المسموح لها بالتقدم\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>شركات التقنية الناشئة:</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\">شركات مطورة لحلول تقنية جديدة أو خدمات بهدف استخدامها في القطاع العقاري سواءً كانت شركات محلية أو شركات عالمية وصدر أو لم يصدر لها تشريع ينظم عملها.</div>\\\\\\\\n</div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>نماذج العمل</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\">نماذج الأعمال التي تتضمن حلول مبتكرة أو تقنيات جديدة وتتعلق بأنشطة العقار صدرت لها لوائح&nbsp; تنظيمية أو تتطلب إصدار لوائح تنظيمية جديدة تتواءم مع طبيعة عملها.</p>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li><strong>أخر موعد للتقديم: 31/01/2025</strong></li>\\\\\\\\n</ul>\\\\\\\\n<div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\">\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\">\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\">\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n</div>\\\\\\\\n</div>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":\\\"\\\",\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/b3ffe468fcce44dbb4f374b37a37d178\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"listOfSubcontent\\\":null,\\\"button\\\":\\\"umb://document/644430d0b05c4e27babd320927603de8\\\",\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/b84dcc857c914adb99ab9b32adc66977\\\",\\\"title\\\":\\\"الأسئلة الشائعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما هي البيئة التنظيمية التجريبية وما الغرض منه؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">تمثل بيئة تسمح للشركات والمبتكرين في مجال العقارات بتجربة تقنياتهم ومنتجاتهم بحرية تنظيمية تحت إشراف الهيئة العامة للعقار ، وتهدف إلى تعزيز التفاعل بين القطاعين العام والخاص، مما يتيح للشركات اختبار خدماتها وابتكاراتها بشكل يواءم الأطر القانونية الحالية ، مما يمكن الهيئة العامة للعقار من تقييم الابتكارات وتطوير أطر تنظيمية تعكس التقدم التقني وتحقق توازناً بين الابتكار والتنظيم في قطاع العقارات.</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>لماذا تقدم الهيئة العامة للعقار البيئة التنظيمية التجريبية؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span> </span>توفر البيئة التنظيمية التجريبية للشركات فرصة للتعاون مع الجهات الحكومية لتحديد الإطار التنظيمي الذي من شأنه أن يدعم العمليات التجارية لهذه الشركات.</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>من هي الفئة المستهدفة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>    رواد الأعمال </span>و أصحاب الشركات الناشئة الصغيرة و المتوسطة<span>  المحلية </span>و الدولية</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل هناك معايير للقبول ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">نعم<span>  ، تقديم عرض </span>و نموذج تفصيلي عن خطة<span>  العمل </span>و يتم دارسته</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>كيف سوف يتم اشعار القبول للبيئة التنظيمية ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">عبر البريد الالكتروني</p>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل تؤدي البيئات التنظيمية التجريبية<span>  إلى تخفيف اللوائح التنظيمية وتقليل </span>و تساهم في خلق أنظمة داعمة؟</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">نعم</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>لمَاذا على الشركات القائمة على الابتكار الالتحاق بالبيئة التنظيمية التجريبية ؟ </li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">لتجربة النموذج المبتكر و هل الأنظمة تساعد على استكمال الإجراءات القانونية و التشريعية من ناحية التراخيص</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما هي المدة<span>  المستغرقة لاختبار النموذج ؟</span></li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">12 شهر</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما هو مفهوم<span>  الاختبار الناجح للخدمات </span>و المنتجات المبتكرة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">يحدد<span>  المتقدمون المعايير الخاصة  بخدماتهم </span>و منتجاتهم المبتكرة وكذلك سيحدد فريق العمل معايير معينة للقبول<span>  </span></p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>في حال نجحت التجارب هل سيتم الحصول على الترخيص بشكل مباشر ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">تتم عبر<span>  عدة مراحل وسيتم اخطار المتأهلين حولها</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null}],\\\"settingsData\\\":[]}\"","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\\\"},{\\\"contentUdi\\\":\\\"umb://element/d1f2a3498cb94495a00fbece98d8665c\\\"},{\\\"contentUdi\\\":\\\"umb://element/ef20fcceac074210b144cdbca86fe1db\\\"},{\\\"contentUdi\\\":\\\"umb://element/b84dcc857c914adb99ab9b32adc66977\\\"},{\\\"contentUdi\\\":\\\"umb://element/b3ffe468fcce44dbb4f374b37a37d178\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تتيح هذه المبادرة للشركات والمبتكرين في مجال العقار فرصة تجربة تقنياتهم ومنتجاتهم وتطوير أفكارهم، بالإضافة لتعزيز التفاعل بين القطاعين العام والخاص<span>&nbsp; مما يسهم في تعزيز الابتكار والنمو في القطاع</span> العقاري.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/d1f2a3498cb94495a00fbece98d8665c\\\",\\\"title\\\":\\\"أهداف المبادرة \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<ul>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تعزيز التفاعل والتعاون بين القطاعين العام والخاص.</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تمكين الشركات من اختبار خدماتها وابتكاراتها بشكل عملي.</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تطوير أطر تنظيمية تعكس التقدم التقني وتحقق التوازن بين الابتكار والتنظيم في قطاع العقارات.</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">تحقيق توازن فعّال بين الابتكار والامتثال التنظيمي في قطاع العقار.</li>\\\\\\\\n</ul>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/ef20fcceac074210b144cdbca86fe1db\\\",\\\"title\\\":\\\" الفئات المسموح لها بالتقدم\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>شركات التقنية الناشئة:</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\">شركات مطورة لحلول تقنية جديدة أو خدمات بهدف استخدامها في القطاع العقاري سواءً كانت شركات محلية أو شركات عالمية وصدر أو لم يصدر لها تشريع ينظم عملها.</p>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>نماذج العمل</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px;\\\\\\\\\\\\\\\">نماذج الأعمال التي تتضمن حلول مبتكرة أو تقنيات جديدة وتتعلق بأنشطة العقار صدرت لها لوائح &nbsp;تنظيمية أو تتطلب إصدار لوائح تنظيمية جديدة تتواءم مع طبيعة عملها.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: center;\\\\\\\\\\\\\\\"><strong>أخر موعد للتقديم: 31/01/2025</strong></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/b3ffe468fcce44dbb4f374b37a37d178\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"listOfSubcontent\\\":null,\\\"button\\\":\\\"umb://document/644430d0b05c4e27babd320927603de8\\\",\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/b84dcc857c914adb99ab9b32adc66977\\\",\\\"title\\\":\\\"الأسئلة الشائعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما هي البيئة التنظيمية التجريبية وما الغرض منه؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">تمثل بيئة تسمح للشركات والمبتكرين في مجال العقارات بتجربة تقنياتهم ومنتجاتهم بحرية تنظيمية تحت إشراف الهيئة العامة للعقار ، وتهدف إلى تعزيز التفاعل بين القطاعين العام والخاص، مما يتيح للشركات اختبار خدماتها وابتكاراتها بشكل يواءم الأطر القانونية الحالية ، مما يمكن الهيئة العامة للعقار من تقييم الابتكارات وتطوير أطر تنظيمية تعكس التقدم التقني وتحقق توازناً بين الابتكار والتنظيم في قطاع العقارات.</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>لماذا تقدم الهيئة العامة للعقار البيئة التنظيمية التجريبية؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span> </span>توفر البيئة التنظيمية التجريبية للشركات فرصة للتعاون مع الجهات الحكومية لتحديد الإطار التنظيمي الذي من شأنه أن يدعم العمليات التجارية لهذه الشركات.</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>من هي الفئة المستهدفة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>    رواد الأعمال </span>و أصحاب الشركات الناشئة الصغيرة و المتوسطة<span>  المحلية </span>و الدولية</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل هناك معايير للقبول ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">نعم<span>  ، تقديم عرض </span>و نموذج تفصيلي عن خطة<span>  العمل </span>و يتم دارسته</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>كيف سوف يتم اشعار القبول للبيئة التنظيمية ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">عبر البريد الالكتروني</p>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل تؤدي البيئات التنظيمية التجريبية<span>  إلى تخفيف اللوائح التنظيمية وتقليل </span>و تساهم في خلق أنظمة داعمة؟</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">نعم</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>لمَاذا على الشركات القائمة على الابتكار الالتحاق بالبيئة التنظيمية التجريبية ؟ </li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">لتجربة النموذج المبتكر و هل الأنظمة تساعد على استكمال الإجراءات القانونية و التشريعية من ناحية التراخيص</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما هي المدة<span>  المستغرقة لاختبار النموذج ؟</span></li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">12 شهر</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما هو مفهوم<span>  الاختبار الناجح للخدمات </span>و المنتجات المبتكرة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">يحدد<span>  المتقدمون المعايير الخاصة  بخدماتهم </span>و منتجاتهم المبتكرة وكذلك سيحدد فريق العمل معايير معينة للقبول<span>  </span></p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>في حال نجحت التجارب هل سيتم الحصول على الترخيص بشكل مباشر ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">تتم عبر<span>  عدة مراحل وسيتم اخطار المتأهلين حولها</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"formIcon","path":"Property/formIcon","oldValue":"null","newValue":"\"[]\"","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"0","newValue":"\"1\"","change":"Update"}],"key":"36652cc6-eff7-4f20-be38-16b554f1146c"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/c3395462-6835-42fd-8c13-78dd0fd2a0db.config","name":"القمة العالمية للتقنية العقارية","path":"/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"formIcon","path":"Property/formIcon","oldValue":"null","newValue":"\"[]\"","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"0","newValue":"\"1\"","change":"Update"}],"key":"c3395462-6835-42fd-8c13-78dd0fd2a0db"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content/644430d0-b05c-4e27-babd-320927603de8.config","name":"التقديم","path":"/9a652156-44fb-44c3-ace9-7996d9225b94/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"formDescription","path":"Property/formDescription","oldValue":"null","newValue":"\"قم بملئ النموذج بالاسفل للتقديم على البيئة التنظمية التجريبية\"","change":"Update"},{"success":true,"name":"formIcon","path":"Property/formIcon","oldValue":"null","newValue":"\"[]\"","change":"Update"},{"success":true,"name":"formRef","path":"Property/formRef","oldValue":"null","newValue":"\"2d81ae6f-da31-40fa-8f7f-27de428de336\"","change":"Update"},{"success":true,"name":"formTitle","path":"Property/formTitle","oldValue":"null","newValue":"\"البيئة التنظيمية التجريبية\"","change":"Update"}],"key":"644430d0-b05c-4e27-babd-320927603de8"}]