BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/3dc9564a6b2946d5a515d2847d4a54fd\\\"},{\\\"contentUdi\\\":\\\"umb://element/d6cb74584c604db8a128ea78b0ef11ea\\\"},{\\\"contentUdi\\\":\\\"umb://element/2d33906455e945389877ffacdd95265b\\\"},{\\\"contentUdi\\\":\\\"umb://element/405d8a144cfb40b6a832ad39363216f5\\\"},{\\\"contentUdi\\\":\\\"umb://element/63d3d769aae746a997c951b2cd8f48ff\\\"},{\\\"contentUdi\\\":\\\"umb://element/a476db87d6384322b554f61d8e0082ea\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/3dc9564a6b2946d5a515d2847d4a54fd\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة عن طريق توفير مجموعة شاملة من الخدمات تشمل مساحات العمل المشتركة، والخدمات المتخصصة لتطوير الأعمال تتضمن الاستشارات والتوجيه والتدريب، بالإضافة لتيسير الوصول إلى المستثمرين من أجل تسريع تطوّر ونمو الشركات الناشئة والريادية وتوسعها,<span>&nbsp;والعمل على تأسيسها بشكل سليم لتكون داعمة&nbsp; للقطاع العقاري </span>و رفع مساهمته في الناتج المحلي للمملكة العربية السعودية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/d6cb74584c604db8a128ea78b0ef11ea\\\",\\\"title\\\":\\\"أهداف البرنامج :\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<ol>\\\\\\\\n<li>خلق شركات ناشئة<span>&nbsp; على أسس سليمة داعمة للقطاع العقاري </span></li>\\\\\\\\n<li>رفع مساهمة<span>&nbsp; الشركات الناشئة في القطاع العقاري للاقتصاد الوطني </span></li>\\\\\\\\n<li>توسع الشركات في التقنية العقارية محليًا<span>&nbsp; ودوليًا</span></li>\\\\\\\\n</ol>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/a476db87d6384322b554f61d8e0082ea\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":\\\"https://startupwiseguys.com/all-programs/sustainable-real-estate-tech-accelerator/\\\"},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/63d3d769aae746a997c951b2cd8f48ff\\\",\\\"title\\\":\\\"الأسئلة الشائعة : \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة ذات المجالات في التقنية العقارية خلال فترة زمنية محددة، و يوفر مجموعة شاملة من الخدمات والموارد ، بما في ذلك مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 80px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ماذا تقدم المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px; padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">تقدم الدعم للشركات الناشئة من خلال عدة برامج تدريبية وتوجيهية واستشارية بهدف تأسيس شركات على أسس سليمة</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<ul>\\\\\\\\n<li style=\\\\\\\\\\\\\\\"list-style-type: none;\\\\\\\\\\\\\\\">\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: circle;\\\\\\\\\\\\\\\">\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">ورش عمل<span>&nbsp; مختصة .</span></li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">جلسات استشارية و ارشادية</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">الربط مع الجهات التمويلية .</li>\\\\\\\\n</ul>\\\\\\\\n</li>\\\\\\\\n</ul>\\\\\\\\n<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px; padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>مدة البرنامج 6&nbsp;</span>أشهر</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px; padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>لا يوجد رسوم</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل يوجد مقر للمسرعة؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-left: 40px; padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">نعم</p>\\\\\\\\n</div>\\\\\\\