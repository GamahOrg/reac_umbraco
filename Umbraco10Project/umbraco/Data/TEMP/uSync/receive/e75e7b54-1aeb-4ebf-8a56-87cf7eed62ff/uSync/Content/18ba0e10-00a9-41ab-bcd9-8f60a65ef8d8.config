    <shortBrief>
      <Value Culture="ar-jo"><![CDATA[{
  "markup": "<p style=\"text-align: right;\">هي خدمة تتيح للمستفيدين من الاستعلام عن شرعية الإعلانات العقارية، والوصول إلى تفاصيل الترخيص، ودعم الامتثال التنظيمي لبيئة سوق آمنة.</p>",
  "blocks": {
    "contentData": [],
    "settingsData": []
  }
}]]></Value>
      <Value Culture="en-us"><![CDATA[{
  "markup": "<p style=\"text-align: right;\">It is a service that allows to inquire about the legitimacy of real estate advertisements, access license details, and support regulatory compliance for a secure market environment.</p>",
  "blocks": {
    "contentData": [],
    "settingsData": []
  }
}]]></Value>
    </shortBrief>
