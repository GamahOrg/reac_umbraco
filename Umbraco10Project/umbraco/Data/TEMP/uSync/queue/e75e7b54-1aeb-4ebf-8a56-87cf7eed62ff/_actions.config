uccess":true,"name":"Published (Default)","path":"/Info/Published","oldValue":"","newValue":"","change":"Create"},{"success":true,"name":"Property - content","path":"/Properties/*/Value","oldValue":"","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/7f6e375f509d4b339eec8f5554a5b22e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/32b23fffdfca4f8f842b6aec987bdbc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/af8a9b5bb8774643bceaf65e5fe11a69\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/7f6e375f509d4b339eec8f5554a5b22e\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p dir=\\\"rtl\\\">&nbsp;قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/32b23fffdfca4f8f842b6aec987bdbc8\",\n      \"title\": \"أهداف المبادرة\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز مكانة المملكة العربية السعودية كمركز رائد في التقنية العقارية .</li>\\n<li class=\\\"O0\\\">فتح الفرص للشركات العالمية للاستثمار محلياً في التقنية العقارية.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات التقنية  من خلال استقطاب الخبرات العالمية.</li>\\n<li class=\\\"O0\\\">الارتقاء بريادة الأعمال المحلية.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/af8a9b5bb8774643bceaf65e5fe11a69\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"https://globalproptechsummit.com\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Create"},{"success":true,"name":"Property - description","path":"/Properties/*/Value","oldValue":"","newValue":" قمة تستقطب أبرز الخبراء والشركات العالمية الرائدة في مجال التقنية العقارية، لتعزيز مكانة المملكة العربية السعودية في هذا المجال، كما تستعرض أبرز الفرص المحفزة للشركات للاستثمار في هذا المجال، تماشياً مع رؤية المملكة 2030 في توطين أحدث التقنيات ودعم رواد الأعمال وتعزيز النمو المستدام للشركات المحلية والتنمية الاقتصادية.","change":"Create"},{"success":true,"name":"Property - formDescription","path":"/Properties/*/Value","oldValue":"","newValue":"","change":"Create"},{"success":true,"name":"Property - formIcon","path":"/Properties/*/Value","oldValue":"","newValue":"","change":"Create"},{"success":true,"name":"Property - formRef","path":"/Properties/*/Value","oldValue":"","newValue":"","change":"Create"},{"success":true,"name":"Property - formTitle","path":"/Properties/*/Value","oldValue":"","newValue":"","change":"Create"},{"success":true,"name":"Property - headerBackgroundImage","path":"/Properties/*/Value","oldValue":"","newValue":"","change":"Create"},{"success":true,"name":"Property - hidePageFromNavigation","path":"/Properties/*/Value","oldValue":"","newValue":"0","change":"Create"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"","newValue":"[\n  \"القمة العالمية للبر