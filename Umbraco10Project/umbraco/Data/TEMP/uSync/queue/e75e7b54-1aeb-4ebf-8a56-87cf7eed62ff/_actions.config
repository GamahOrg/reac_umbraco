41ccbd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d0fb11d477584b689c95119762aa2cfd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/844cb67051c74ecea1e0fa763b1f6cc0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/597f21badaa444eda2c3166cf5049ff9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fe6aeba3f6db43baa342d547f4346a53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0832bbe4f5794729a58b6ddc0f75174c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd7da173c16b49eba1346db5d96837e8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7f96d084f58c4070aaf61872cea1ceed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8f5231fee492460f88613264a3e1ea8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a5e4a2ca9b348a1a34a001359bee2e4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7cd9ca0f4a624d5ea10ff1859dfe1969\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0f5b1855961142418997f989dd1e3a9c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1c1cb5882acb4110a8250d09851d40f4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac0c28264ea24e8b88df682235b85570\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ef8941defc2c499fbd80f449a8f0e106\"\n      },\n      {\n        \"contentUdi\": \"umb://element/67356307a0814eec925b97607270994f\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2816cf02a0e41e3b37240e45b41ccbd\",\n      \"title\": \"المادة الاولى\",\n      \"content\": {\n        \"markup\": \"<p>يقصد بالعبارات والمصطلحات الاتية - اينما وردت في هذا التننظيم- المعاني المبينة امامها، ما لم يقتض السياق خلاف ذلك:</p>\\n<p><strong>الوزير:</strong> وزير الشؤون البلدية والقروية للاسكان</p>\\n<p><strong>الهيئة: </strong>الهيئة العامة للعقار </p>\\n<p><strong>المجلس:</strong> مجلس ادارة الهيئة</p>\\n<p><strong>الرئيس:</strong> رئيس المجلس</p>\\n<p><strong>الرئيس التنفيذي: </strong>الرئيس التنفيذي للهيئة</p>\\n<p><strong>التنظيم:</strong> تنظيم الهيئة</p>\\n<p><strong>الرخصة:</strong> وثيقة تصدرها الهيئة تخول صاحبها مزاولة نشاط او اكثر من الانشكة التجارية</p>\\n<p><strong>الانشطة العقارية:</strong> عمل او مجموعة اعمال تنفذ لتوفير منتجات عقارية محددة، منها التطوير العقاري، والمساهمات العقارية، والبيع على الخارطة، ومزاولة خدمات الوساطة في بيع العقارات او شراؤها او تأجيرها</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d0fb11d477584b689c95119762aa2cfd\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>تتمتع الهيئة بالشخصية الاعتبارية والاستقلال المالي والاداري، وترتبط تنظيميا بالوزير، ويكون مقرها الرئيس في مدينة الرياض، ولها فتح فروع ومكاتب داخل المملكة بحسب الحاجة</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/844cb67051c74ecea1e0fa763b1f6cc0\",\n      \"title\": \"المادة الثالثة \",\n      \"content\": {\n        \"markup\": \"<p>الغرض الاساسي للهيئة هو التسجيل العيني للعقارات في المملكة، والعمل على تنظيم النشاط العقاري غير الحكومي والاشراف عليه وتطويره، لرفع كفايته، وتشجيع الاستثنار فيه بما يتفق مع اهداف التنمية الاقتصادية والاجتماعية. وتتمتع الهيئة - في سبيل تحقيق الغرض الذي أنشئت من اجله بجميع الصلاحيات اللازمة لذلك، ولها على وجه خاص ما يأتي:</p>\\n<p>1. اقتراح الأنظمة واللوائح والسياسات ذات العلاقة بالأنشطة العقارية، والرفع عنها لاستكمال ما يلزم في شأنها</p>\\n<p>2. وضع الخطط اللازمة لممارسة اختصاصها، والأشراف على تنفيذها</p>\\n<p>3. الترخيص للأنشطة العقارية، والأشراف عليها</p>\\n<p>4. وضع الضوابط والمعايير الخاصة بالانشطة العقارية</p>\\n<p>5. تنظيم المعارض العقارية، بالتنسيق مع الجهات ذات العلاقة</p>\\n<p>6. ًانفاذ اعمال التسجيل العيني للعقار، وفق ما هو مقرر نظاما</p>\\n<p>7. وضع اسس تحديد المقابل المالي للأنشطة العقارية بما لا يخل قواعد المنافسة</p>\\n<p>8. تشجيع الاستثمار في الانشطة العقارية، وتوفير البيئة المناسبة للمنافسة العادلة في هذا المجال</p>\\n<p>9. التنسيق مع الاجزة المعنية من أجل ضمان تكامل البنى التحتية للعقارات وتحقيق الأهداف والسياسات والأستراتيجيات الوطنية ذات العلاقة</p>\\n<p>10. عقد المؤتمرات والندوات واللقاءات المتعلقة بمجالات عمل الهيئة وفقا للضوابط المنظمة لذلك، والمشاركة في المعارض الدولية، وذلك بالتنسيق مع الجهات المعنية</p>\\n<p>11. نشر الوعي بأنظمة القطاع العقاري وانشطته</p>\\n<p>12. متابعة تنفيذ الاتفاقيات ذات الصلة بالعلاقة المبرمة بين المملكة والدول الأخرى، وذلك بالتنسيق مع الجهات المعنية</p>\\n<p>13. مراقبة مؤشرات القطاع العقاري بما يحقق له الاستقرار والتوازن</p>\\n<p>14. العمل على توفر التدريب والتأهيل اللازمين للمرخص لهم بمزاولة الانشطة العقارية وللعاملين في هذه الأنشطة</p>\\n<p>15. وضع الضوابط اللازمة لتنظيم الاعلانات العقارية التي تنشر في جميع الوسائل والرقابة عليها، بالنتسيق مع الجهات ذات العلاقة</p>\\n<p>16. اجراء البحوث والدراسات والاحصاءات في مجال الأنشطة العقارية</p>\\n<p>17. انشاء بوابة الكترونية تحتوي على قواعد للمعلومات العقارية اللازمة للأنشطة العقارية، سواء المتوافرة لدى الهيئة او الجهات الاخرى المعنية، مع تحديثها دورياً، واتاحتها للمعنيين</p>\\n<p>18. التنسيق مع الوزارة في شأن تمثيل المملكة في المنظمات والمنتديات الدولية والاقليمية ذات العلاقة باختصاصها، وذلك بحسب الأجراءات المتبعة</p>\\n<p>19. انشاء مراكز تدريب ذات صلة باختصاصاتها، وفقا للاجراءات النظامية</p>\\n<p>20. اسناد بعض الخدمات التي تقدمها الى القطاع الخاص، وفقاً للأجراءات النظامية</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/597f21badaa444eda2c3166cf5049ff9\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>يكون للهيئة مجلس ادارة برئاسة الوزير زعضوية كل من:\\n<ol>\\n<li>الرئيس التفيذي</li>\\n<li>ممثل من وزارة الشؤون البلدية والقروية والاسكان</li>\\n<li>ممثل من وزارة العدل</li>\\n<li>ممثل من وزارة المالية</li>\\n<li>ممثل من وزارة الاقتصاد والتخطيط</li>\\n<li>ممثل من وزارة الاستثمار</li>\\n<li>ممثل عن وزارة الصناعة والثروة المعدنية</li>\\n<li>ممثل من الهيئة العامة لعقارات الدولة</li>\\n<li>ممثل من الهيئة العامة للمساحات والمعلومات الجيومكانية</li>\\n<li>ثلاثة من القطاع الخاصذي العلاقة بنشاط الهيئة، يعينون بقرار من مجلس الوزراء بناء على اقتراح الوزير.</li>\\n</ol>\\n</li>\\n<li>يجب الا تقل مرتبة ممثلي الاجهزة الحكومية عن المرتبة (الرابعة عشرة) او ما يعادلها</li>\\n<li>اختيار الرئيس نائبا له من ممثلي الجهات الحكومية في المجلس</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fe6aeba3f6db43baa342d547f4346a53\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>المجلس هو السلطة العليا للهيئة، ويختص بالاشراف على شؤونها وادارتها وتصريف امورها، وله اتخاذ ما يلزم من قرارات واجراءات لتحقيق اغراضها في حدود احكام التنظيم، وله بصفة خاصة الصلاحيات والاختصاصات التالية:</p>\\n<ol>\\n<li>الاشراف على تنفيذ الهيئة للمهمات المنوطة بها</li>\\n<li>وضع السياسات التي تسير عليها الهيئة لتحقيق اغراضها، واعتماد الخطط والبرامج اللازمة لذلك، والاشراف على تنفيذها</li>\\n<li>اقرار اللوائح الادارية والمالية وغيرها من اللوائح الداخلية التي تسير عليها الهيئة، على ان يكون اقرار اللوائح الادارية بالاتفاق مع وزارة الموارد البشرية والتنمية الاجتماعية، واللوائح المالية والاحكام ذات الاثر المالي في اللوائح الادارية بالاتفاق مع وزارة المالية</li>\\n<li>اقرار الهيكل التنظيمي للهيئة</li>\\n<li>اقرار المقابل المالي للرخص التي تصدرها الهيئة، بالاتفاق مع وزارة المالية ومركز تنمية الايرادات غير النفطية</li>\\n<li>دون الاخلال بالاحكام النظامية ذات الصلة، يكون اقرار المقابل المالي الذي تتقاضاه الهيئة عن الاعمال والخدمات التي تقدمها، بالاتفاق مع وزارة المالية ومرك تنمية الايرادات غير النفطية</li>\\n<li>الموافقة على فتح فروع ومكاتب للهيئة داخل المملكة </li>\\n<li>الموافقة على توظيف اموال الهيئة بما يحقق اغراضها، واستثمار العقارات واستئجارها وفقاً للانظمة المتبعة</li>\\n<li>اقرار مشروع ميزانية الهيئة، وحسابها الختامي، وتقرير مراجع الحسابات، والتقرير السنوي، ورفع ما يلزم اعتماده بحيب الاجراءات النظامية المتبعة</li>\\n<li>قبول الهبات والاعانات والتبرعات والمنح والوصايا والاوقاف وفقا للانظمة المتبعة</li>\\n<li>الموافقة على ابرام الاتفاقيات والبروتوكولات والعقود وتفويض الرئيس التنفيذي بالتوقيع عليها بحسب الاجراءات المتبعة</li>\\n<li>النظر في التقارير الدورية التي تقدم سير العمل في الهيئة ومركزها المالي </li>\\n<li>اقرار قواعد منح المكافآت لمن يكفله المجلس </li>\\n<li>تعيين مراجع حسابات خارجي، ومراقب مالي داخلي</li>\\n<li>وضع برنامج لتحفيز التسجيل العيني للعقار</li>\\n</ol>\\n<p>وللمجلس تفويض رئيسه اونائبه او من يراه من اهضائه في بعض صلاحياته</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0832bbe4f5794729a58b6ddc0f75174c\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>تعقد اجتماعات المجلس في مقر الهيئة بدعوة من الرئيس، ويجوز عند الاقتضاء عقدها في مكان اخر داخل المملكة</li>\\n<li>يعقد المجلس اجتماعاته بصفة دورية اربع مرات في السنة، وللرئيس دعوته للاجتماع متى دعت الحاجة الى ذلك او متى طلب ذلك ثلاثة اعضاء على الاقل</li>\\n<li>يكون اجتماع المجلس صحيحا ذا حضره اغلبية الاعضاء بمن فيهم الرئيس او نائبه، وتصدر القرارات باغلبية اصوات الاعضاء الحاضرين، وفي حال تساوي الاصوات يرجح الجانب الذي صوت معه رئيس الاجتماع</li>\\n<li>تثبت مداولات المجلس وقراراته في محاضر يوقعها رئيس الاجتماع والاعضاء الحاضرون</li>\\n<li>‏لا يجوز لعضو المجلس الامتناع عن التصويت أو تفويض عضو آخر بالتصويت عنه عند غيابه ولالعضو المعترض تسجيل اعتراضه وأسباب به ضمن محضر اجتماع المجلس</li>\\n<li>‏لا يجوز للعضو أن يفشي شيئاً مما وقف عليه من أسرار الهيئة بسبب عضويته في المجلس</li>\\n<li>‏للمجلس دعوة من يرى الاستعانة بهم من المختصين والمستشارين لحضور اجتماعاته دون أن يكون لهم حق التصويت</li>\\n<li>‏يكون للمجلس أمين من بين منسوبي الهيئة يختاره الرئيس بناء على ترشيح الرئيس التنفيذي، يتولى أمانة المجلس والإعداد للاجتماعات وتسجيل المداولات والقرارات</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dd7da173c16b49eba1346db5d96837e8\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>‏للمجلس أن يشكل لجانا دائما أو مؤقته من بين أعضائه أو من غيرهم، ويعهد إليها بما يراه من مهمات، ويحدد في قرار تشكيل كل لجنة رئيسها وأع أعضاؤها واختصاصاتها، ويكون لها الإستعانه بمن تراه لتأدية المهمات المكلفة بها</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7f96d084f58c4070aaf61872cea1ceed\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>‏يكون للهيئة رئيس تنفيذي يعين ويعفى بقرار من المجلس بناء على ترشيح من الرئيس، ويحدد القرار أجره ومزايا المالية الأخرى</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8f5231fee492460f88613264a3e1ea8b\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>‏يكون الرئيس التنفيذي المسؤول عن إدارة الهيئة، ‏وتترك مسؤولياته في حدود ما ينص عليه التنظيم وما يقرره المجلس، ويمارس بوجه خاص الصلاحيات والمهمات الآتية:</p>\\n<ol>\\n<li>الإشراف على سير العمل في الهيئة من خلال اللوائح والخطط والبرامج المعتمدة.</li>\\n<li><span><span lang=\\\"AR-SA\\\">اقتراح السياسات العامة للهيئة، المتعلقة بأنشطتها، والخطط والبرامج اللازمة لتنفيذ ذلك، ورفعها إلى المجلس</span>.</span></li>\\n<li><span>إعداد مشروع ميزانية الهيئة السنوية ومشروع حسابها الختامي، ورفعهما إلى المجلس.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الموافقة على إصدار الرخص التي تدخل في اختصاص الهيئة</span>.</span></li>\\n<li><span>تمثيل الهيئة لدى الجهات الحكومية والمؤسسات والهيئات الأخرى ذات العلاقة وغيرها من الجهات داخل المملكة وخارجها وأمام القضاء.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الصرف من الميزانية المعتمدة، واتخاذ جميع الإجراءات المالية وفقاً للأنظمة واللوائح المقرة والصلاحيات التي منحها إياه المجلس</span>.</span></li>\\n<li><span>إعداد التقارير الخاصة بتنفيذ خطط الهيئة وبرامجها، ودراستها، وعرضها على المجلس.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">إعداد التقرير السنوي عن نشاط الهيئة والعقبات التي واجهتها واقتراح الحلول المناسبة لها، وتقديمه إلى المجلس للنظر فيه ورفعه إلى الجهات المختصة بعد اعتماده من المجلس</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">التوقيع على الاتفاقيات والبروتوكولات والعقود بعد موافقة المجلس بحسب الإجراءات المتبعة</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">تنظيم مشاركة الهيئة في المؤتمرات والندوات واللقاءات والمعارض المتعلقة بمجالات عمل الهيئة محليًّا وإقليميًّا ودوليًّا</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">إصدار القرارات اللازمة لتنفيذ أحكام التنظيم واللوائح الصادرة بناءً عليه والقواعد والإجراءات المعتمدة، بحسب الصلاحيات المخولة له</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">تشكيل لجان عمل داخلية (دائمة أو مؤقتة) وفقاً لما تقضي به اللوائح والإجراءات المعتمدة لدى الهيئة</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الاستعانة بالخبراء والمستشارين المتخصصين الذين تحتاج إليهم الهيئة</span>.<br><!--[endif]--></span>\\n<p style=\\\"line-height: 150%; direction: rtl; unicode-bidi: embed; text-align: right;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وللرئيس التنفيذي أن يفوض بعض اختصاصاته إلى من يراه من منسوبي الهيئة</p>\\n</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a5e4a2ca9b348a1a34a001359bee2e4\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>تنشأ - بموافقة المجلس - مراكز للخدمة الشاملة في مقر الهيئة وفروعها التي ترى الهيئة ضرورة إنشاء تلك المراكز فيها.</li>\\n<li>تقوم جميع الجهات الحكومية وغير الحكومية التي يتطلب الأمر تمثيلها في تلك المراكز بتحديد من يمثلها للعمل في تلك المراكز، وعلى تلك الجهات تفويض ممثليها بممارسة الصلاحيات التي تضمن سرعة تقديم الخدمات بما في ذلك إصدار الشهادات والتصاريح والتراخيص للأنشطة التي تدخل ضمن اختصاص تلك الجهات.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7cd9ca0f4a624d5ea10ff1859dfe1969\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- تتكون موارد الهيئة المالية مما يأتي:</p>\\n<p>أ - ما يخصص لها في الميزانية العامة للدولة.<br>ب - المقابل المالي للرخص التي تصدرها.<br>ج - المقابل المالي الذي تتقاضاه عن الخدمات والأعمال التي تقدمها للغير مما يدخل ضمن اختصاصها، وفقاً للأنظمة، واللوائح والقرارات التي يعتمدها المجلس.</p>\\n<p>د - الإيرادات المتحصلة من عوائد استغلال واستثمار أصولها وأموالها.<br>هـ - ما يقبله المجلس من هبات وإعانات وتبرعات ومنح ووصايا وأوقاف.<br>و - أي مورد آخر يقره المجلس.</p>\\n<p>2- تودع أموال الهيئة في حساب خاص بها في مؤسسة النقد العربي السعودي، وللهيئة عند الحاجة فتح حسابات في البنوك المرخص لها بالعمل في المملكة، ويصرف من هذه الأموال وفق ميزانية الهيئة المعتمدة.</p>\\n<p>3- تؤول الأموال الفائضة عن حاجة الهيئة خلال السنة المالية إلى الخزينة العامة للدولة لحساب جاري وزارة المالية، وذلك بعد اقتطاع جميع النفقات الجارية ونفقات رأس المال وغيرها من المصروفات التي تحتاج إليها الهيئة، وما تحتاج إليه لتمويل مشروعاتها المستقبلية المقرة في ميزانيتها السنوية وللوفاء بالتزاماتها النظامية، وذلك دون الإخلال بشرط الواقف فيما يتعلق بالأوقاف.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0f5b1855961142418997f989dd1e3a9c\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تعامل الهيئة من حيث إعفاء مستورداتها من الرسوم الجمركية بحسب القواعد المتبعة في شأن مستوردات المؤسسات العامة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1c1cb5882acb4110a8250d09851d40f4\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li class=\\\"MsoNormal\\\" style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\">&nbsp;تكون للهيئة ميزانية سنوية مستقلة، تصدر وفقاً لترتيبات إصدار الميزانية العامة للدولة.</li>\\n<li class=\\\"MsoNormal\\\" style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\">السنة المالية للهيئة هي السنة المالية للدولة، واستثناءً من ذلك تبدأ السنة المالية الأولى من تاريخ نفاذ التنظيم، وتنتهي بنهاية السنة المالية التالية للدولة.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ef8941defc2c499fbd80f449a8f0e106\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع عدم الإخلال باختصاص ديوان المراقبة العامة بالرقابة على حسابات الهيئة وعملياتها، يعين المجلس مراجع حسابات خارجيًّا (أو أكثر) من المرخص لهم بالعمل في المملكة، لتدقيق حسابات الهيئة ومعاملاتها وبياناتها وميزانيتها السنوية وحسابها الختامي، ويحدد المجلس أتعابه. ويرفع تقرير مراجع الحسابات إلى المجلس، ويزود ديوان المراقبة العامة بنسخة منه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/67356307a0814eec925b97607270994f\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ينشر التنظيم في الجريدة الرسمية، ويعمل به من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac0c28264ea24e8b88df682235b85570\",\n      \"title\": \"المادة الثالثة عشرة مكرر\",\n      \"content\": {\n        \"markup\": \"<p>يخضع منسوبو الهيئة لاحكام نظام العمل ونظام التأمينات الاجتماعية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (en-us)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/a2816cf02a0e41e3b37240e45b41ccbd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d0fb11d477584b689c95119762aa2cfd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/844cb67051c74ecea1e0fa763b1f6cc0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/597f21badaa444eda2c3166cf5049ff9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fe6aeba3f6db43baa342d547f4346a53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0832bbe4f5794729a58b6ddc0f75174c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd7da173c16b49eba1346db5d96837e8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7f96d084f58c4070aaf61872cea1ceed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8f5231fee492460f88613264a3e1ea8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a5e4a2ca9b348a1a34a001359bee2e4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7cd9ca0f4a624d5ea10ff1859dfe1969\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0f5b1855961142418997f989dd1e3a9c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1c1cb5882acb4110a8250d09851d40f4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac0c28264ea24e8b88df682235b85570\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ef8941defc2c499fbd80f449a8f0e106\"\n      },\n      {\n        \"contentUdi\": \"umb://element/67356307a0814eec925b97607270994f\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2816cf02a0e41e3b37240e45b41ccbd\",\n      \"title\": \"المادة الاولى\",\n      \"content\": {\n        \"markup\": \"<p>يقصد بالعبارات والمصطلحات الاتية - اينما وردت في هذا التننظيم- المعاني المبينة امامها، ما لم يقتض السياق خلاف ذلك:</p>\\n<p>الوزير: وزير الشؤون البلدية والقروية للاسكان</p>\\n<p>الهيئة: الهيئة العامة للعقار </p>\\n<p>المجلي: مجلس ادارة الهيئة</p>\\n<p>الرئيس: رئيس المجلس</p>\\n<p>الرئس التنفيذي: الرئيس التنفيذي للهيئة</p>\\n<p>التنظيم: تنظيم الهيئة</p>\\n<p>الرخصة: وثيقة تصدرها الهيئة تخول صاحبها مزاولة نشاط او اكثر من الانشكة التجارية</p>\\n<p>الانشطة العقارية: عمل او مجموعة اعمال تنفذ لتوفير منتجات عقارية محددة، منها التطوير العقاري، والمساهمات العقارية، والبيع على الخارطة، ومزاولة خدمات الوساطة في بيع العقارات او شراؤها او تأجيرها</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d0fb11d477584b689c95119762aa2cfd\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>تتمتع الهيئة بالشخصية الاعتبارية والاستقلال المالي والاداري، وترتبط تنظيميا بالوزير، ويكون مقرها الرئيس في مدينة الرياض، ولها فتح فروع ومكاتب داخل المملكة بحسب الحاجة</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/844cb67051c74ecea1e0fa763b1f6cc0\",\n      \"title\": \"المادة الثالثة \",\n      \"content\": {\n        \"markup\": \"<p>الغرض الاساسي للهيئة هو التسجيل العيني للعقارات في المملكة، والعمل على تنظيم النشاط العقاري غير الحكومي والاشراف عليه وتطويره، لرفع كفايته، وتشجيع الاستثنار فيه بما يتفق مع اهداف التنمية الاقتصادية والاجتماعية. وتتمتع الهيئة - في سبيل تحقيق الغرض الذي أنشئت من اجله بجميع الصلاحيات اللازمة لذلك، ولها على وجه خاص ما يأتي:</p>\\n<p>1. اقتراح الانظمة واللوائح والسياسات ذات العلاقة بالانشطة العقارية، والرفع عنها لاستكمال ما يلزم في شأنها</p>\\n<p>2. وضع الخطط اللازمة لممارسة اختصاصها، والاشراف على تنفيذها</p>\\n<p>3. الترخيص للانشطة العقارية، والاشراف عليها</p>\\n<p>4. وضع الضوابط والمعايير الخاصة بالانشطة العقارية</p>\\n<p>5. تنظيم المعارض العقارية، بالتنسيق مع الجهات ذات العلاقة</p>\\n<p>6. انفاذ اعمال التسجيل العيني للعقار، وفق ما هو مقرر نظاما</p>\\n<p>7. وضع اسس تحديد المقابل المالي للأنشطة العقارية بما لا يخل قواعد المنافسة</p>\\n<p>8. تشجيع الاستثمار في الانشطة العقارية، وتوفير البيئة المناسبة للمنافسة العادلة في هذا المجال</p>\\n<p>9. التنسيق مع الاجزة المعنية من اجل ضمان تكامل البنى التحتية للعقارات وتحقيق الاهداف والسياسات والاستراتيجيات الوطنية ذات العلاقة</p>\\n<p>10. عقد المؤتمرات والندوات واللقاءات المتعلقة بمجالات عمل الهيئة وفقا للضوابط المنظمة لذلك، والمشاركة في المعارض الدولية، وذلك بالتنسيق مع الجهات المعنية</p>\\n<p>11. نشر الوعي بأنظمة القطاع العقاري وانشطته</p>\\n<p>12. متابعة تنفيذ الاتفاقيات ذات الصلة بالعلاقة المبرمة بين المملكة والدول الاخرى، وذلك بالتنسيق مع الجهات المعنية</p>\\n<p>13. مراقبة مؤشرات القطاع العقاري بما يحقق له الاستقرار والتوازن</p>\\n<p>14. العمل على توفر التدريب والتأهيل اللازمين للمرخص لهم بمزاولة الانشطة العقارية وللعاملين فب هذه الانشطة</p>\\n<p>15. وضع الضوابط اللازمة لتنظيم الاعلانات العقاريةالتي تنشر في جميع الوسائل والرقابة عليها، بالنتسيق مع الجهات ذات العلاقة</p>\\n<p>16. اجراء البحوث والدراسات والاحصاءات في مجال الانشطة العقارية</p>\\n<p>17. انشاء بوابة الكترونية تحتوي على قواعد للمعلومات العقارية اللازمة للانشطة العقارية، سواء المتوافرة لدى الهيئة او الجهات الاخرى المعنية، مع تحديثها دوريا، واتاحتها للمعنيين</p>\\n<p>18. التنسيق مع الوزارة في شأن تمثيل المملكة في المنظمات زالمنتديات الدولية والاقليمية ذات العلاقة باختصاصها، وذلك بحسب الاجراءات المتبعة</p>\\n<p>19. انشاء مراكز تدريب ذات صلة باختصاصاتها، وفقا للاجراءات النظامية</p>\\n<p>20. اسناد بعض الخدمات التي تقدمها الى القطاع الخاص، وفقا للاجراءات النظامية</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/597f21badaa444eda2c3166cf5049ff9\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>يكون للهيئة مجلس ادارة برئاسة الوزير زعضوية كل من:\\n<ol>\\n<li>الرئيس التفيذي</li>\\n<li>ممثل من وزارة الشؤون البلدية والقروية والاسكان</li>\\n<li>ممثل من وزارة العدل</li>\\n<li>ممثل من وزارة المالية</li>\\n<li>ممثل من وزارة الاقتصاد والتخطيط</li>\\n<li>ممثل من وزارة الاستثمار</li>\\n<li>ممثل عن وزارة الصناعة والثروة المعدنية</li>\\n<li>ممثل من الهيئة العامة لعقارات الدولة</li>\\n<li>ممثل من الهيئة العامة للمساحات والمعلومات الجيومكانية</li>\\n<li>ثلاثة من القطاع الخاصذي العلاقة بنشاط الهيئة، يعينون بقرار من مجلس الوزراء بناء على اقتراح الوزير.</li>\\n</ol>\\n</li>\\n<li>يجب الا تقل مرتبة ممثلي الاجهزة الحكومية عن المرتبة (الرابعة عشرة) او ما يعادلها</li>\\n<li>اختيار الرئيس نائبا له من ممثلي الجهات الحكومية في المجلس</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fe6aeba3f6db43baa342d547f4346a53\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>المجلس هو السلطة العليا للهيئة، ويختص بالاشراف على شؤونها وادارتها وتصريف امورها، وله اتخاذ ما يلزم من قرارات واجراءات لتحقيق اغراضها في حدود احكام التنظيم، وله بصفة خاصة الصلاحيات والاختصاصات التالية:</p>\\n<ol>\\n<li>الاشراف على تنفيذ الهيئة للمهمات المنوطة بها</li>\\n<li>وضع السياسات التي تسير عليها الهيئة لتحقيق اغراضها، واعتماد الخطط والبرامج اللازمة لذلك، والاشراف على تنفيذها</li>\\n<li>اقرار اللوائح الادارية والمالية وغيرها من اللوائح الداخلية التي تسير عليها الهيئة، على ان يكون اقرار اللوائح الادارية بالاتفاق مع وزارة الموارد البشرية والتنمية الاجتماعية، واللوائح المالية والاحكام ذات الاثر المالي في اللوائح الادارية بالاتفاق مع وزارة المالية</li>\\n<li>اقرار الهيكل التنظيمي للهيئة</li>\\n<li>اقرار المقابل المالي للرخص التي تصدرها الهيئة، بالاتفاق مع وزارة المالية زمركز تنمية الايرادات غير النفطية</li>\\n<li>دون الاخلال بالاحكام النظامية ذات الصلة، يكون اقرار المقابل المالي الذي تتقاضاه الهيئة عن الاعمال والخدمات التي تقدمها، بالاتفاق مع وزارة المالية ومرك تنمية الايرادات غير النفطية</li>\\n<li>الموافقة على فتح فروع وكماتب للهيئة داخل المملكة </li>\\n<li>الموافقة على توظيف اموال الهيئة بما يحقق اغراضها، واستثمار العقارات واستئجارها وفقا للانظمة المتبعة</li>\\n<li>اقرار مشروع ميزانية الهيئة، وحسابها الختامي، وتقرير مراجع الحسابات، والتقرير السنوي، ورفع ما يلزم اعتماده بحيب الاجراءات النظامية المتبعة</li>\\n<li>قبول الهبات والاعانات والتبرعات والمنح والوصايا والاوقاف وفقا للانظمة المتبعة</li>\\n<li>الموافقة على ابرام الاتفاقيات والبروتوكولات والعقود وتفويض الرئيس التنفيذي بالتوقيع عليها بحسب الاجراءات المتبعة</li>\\n<li>النظر في التقارير الدورية التي تقدم سير العمل في الهيئة ومركزها المالي </li>\\n<li>اقرار قواعد منح المكافآت لمن يكفله المجلس </li>\\n<li>تعيين مراجع حسابات خارجي، ومراقب مالي داخلي</li>\\n<li>وضع برنامج لتحفيز التسجيل العيني للعقار</li>\\n</ol>\\n<p>وللمجلس تفويض رئيسه اونائبه او من يراه من اهضائه في بعض صلاحياته</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0832bbe4f5794729a58b6ddc0f75174c\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>تعقد اجتماعات المجلس في مقر الهيئة بدعوة من الرئيس، ويجوز عند الاقتضاء عقدهافي مكان اخر داخل المملكة</li>\\n<li>يعقد المجلس اجتماعاته بصفة دورية اربع مرات في السنة، وللرئيس دعوته للاجتماع متى دعت الحاجة الى ذلك او متى طلب ذلك ثلاثة اعضاء على الاقل</li>\\n<li>يكون اجتماع المجلس صحيحا ذا حضره اغلبية الاعضاء بمن فيهم الرئيس او نائبه، وتصدر القرارات باغلبية اصوات الاعضاء الحاضرين، وفي حال تساوي الاصوات يرجح الجانب الذي صوت معه رئيس الاجتماع</li>\\n<li>تثبت مداولات المجلس وقراراته في محاضر يوقعها رئيس الاجتماع والاعضاء الحاضرون</li>\\n<li>‏لا يجوز لعضو المجلس الامتناع عن التصويت أو تفويض عضو آخر بالتصويت عنه عند غيابه ولالعضو المعترض تسجيل اعتراضه وأسباب به ضمن محضر اجتماع المجلس</li>\\n<li>‏لا يجوز للعضو أن يفشي شيئا مما وقف عليه من أسرار الهيئة بسبب عضويته في المجلس</li>\\n<li>‏للمجلس دعوة من يرى الاستعانة بهم من المختصين والمستشارين لحضور اجتماعاته دون أن يكون لهم حق التصويت</li>\\n<li>‏يكون للمجلس أمين من بين منسوبي الهيئة يختاره الرئيس بناء على ترشيح الرئيس التنفيذي، يتولى أمانة المجلس والإعداد للاجتماعات وتسجيل المداولات والقرارات</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dd7da173c16b49eba1346db5d96837e8\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>‏للمجلس أن يشكل لجانا دائما أو مؤقته من بين أعضائه أو من غيرهم، ويعهد إليها بما يراه من مهمات، ويحدد في قرار تشكيل كل لجنة رئيسها وأع أعضاؤها واختصاصاتها، ويكون لها الإستعانه بمن تراه لتأدية المهمات المكلفة بها</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7f96d084f58c4070aaf61872cea1ceed\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>‏يكون للهيئة رئيس تنفيذي يعين ويعفى بقرار من المجلس بناء على ترشيح من الرئيس، ويحدد القرار أجره ومزايا المالية الأخرى</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8f5231fee492460f88613264a3e1ea8b\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>‏يكون الرئيس التنفيذي المسؤول عن إدارة الهيئة، ‏وتترك مسؤولياته في حدود ما ينص عليه التنظيم وما يقرره المجلس، ويمارس بوجه خاص الصلاحيات والمهمات الآتية:</p>\\n<ol>\\n<li>الإشراف على سير العمل في الهيئة من خلال اللوائح والخطط والبرامج المعتمدة.</li>\\n<li><span><span lang=\\\"AR-SA\\\">اقتراح السياسات العامة للهيئة، المتعلقة بأنشطتها، والخطط والبرامج اللازمة لتنفيذ ذلك، ورفعها إلى المجلس</span>.</span></li>\\n<li><span>إعداد مشروع ميزانية الهيئة السنوية ومشروع حسابها الختامي، ورفعهما إلى المجلس.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الموافقة على إصدار الرخص التي تدخل في اختصاص الهيئة</span>.</span></li>\\n<li><span>تمثيل الهيئة لدى الجهات الحكومية والمؤسسات والهيئات الأخرى ذات العلاقة وغيرها من الجهات داخل المملكة وخارجها وأمام القضاء.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الصرف من الميزانية المعتمدة، واتخاذ جميع الإجراءات المالية وفقاً للأنظمة واللوائح المقرة والصلاحيات التي منحها إياه المجلس</span>.</span></li>\\n<li><span>إعداد التقارير الخاصة بتنفيذ خطط الهيئة وبرامجها، ودراستها، وعرضها على المجلس.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">إعداد التقرير السنوي عن نشاط الهيئة والعقبات التي واجهتها واقتراح الحلول المناسبة لها، وتقديمه إلى المجلس للنظر فيه ورفعه إلى الجهات المختصة بعد اعتماده من المجلس</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">التوقيع على الاتفاقيات والبروتوكولات والعقود بعد موافقة المجلس بحسب الإجراءات المتبعة</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">تنظيم مشاركة الهيئة في المؤتمرات والندوات واللقاءات والمعارض المتعلقة بمجالات عمل الهيئة محليًّا وإقليميًّا ودوليًّا</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">إصدار القرارات اللازمة لتنفيذ أحكام التنظيم واللوائح الصادرة بناءً عليه والقواعد والإجراءات المعتمدة، بحسب الصلاحيات المخولة له</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">تشكيل لجان عمل داخلية (دائمة أو مؤقتة) وفقاً لما تقضي به اللوائح والإجراءات المعتمدة لدى الهيئة</span>.</span></li>\\n<li><span><span lang=\\\"AR-SA\\\">الاستعانة بالخبراء والمستشارين المتخصصين الذين تحتاج إليهم الهيئة</span>.<br><!-- [if !supportLineBreakNewLine]--><br><!--[endif]--></span>\\n<p style=\\\"line-height: 150%; direction: rtl; unicode-bidi: embed; text-align: right;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">وللرئيس التنفيذي أن يفوض بعض اختصاصاته إلى من يراه من منسوبي الهيئة</p>\\n</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a5e4a2ca9b348a1a34a001359bee2e4\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>تنشأ - بموافقة المجلس - مراكز للخدمة الشاملة في مقر الهيئة وفروعها التي ترى الهيئة ضرورة إنشاء تلك المراكز فيها.</li>\\n<li>تقوم جميع الجهات الحكومية وغير الحكومية التي يتطلب الأمر تمثيلها في تلك المراكز بتحديد من يمثلها للعمل في تلك المراكز، وعلى تلك الجهات تفويض ممثليها بممارسة الصلاحيات التي تضمن سرعة تقديم الخدمات بما في ذلك إصدار الشهادات والتصاريح والتراخيص للأنشطة التي تدخل ضمن اختصاص تلك الجهات.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7cd9ca0f4a624d5ea10ff1859dfe1969\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- تتكون موارد الهيئة المالية مما يأتي:</p>\\n<p>أ - ما يخصص لها في الميزانية العامة للدولة.<br>ب - المقابل المالي للرخص التي تصدرها.<br>ج - المقابل المالي الذي تتقاضاه عن الخدمات والأعمال التي تقدمها للغير مما يدخل ضمن اختصاصها، وفقاً للأنظمة، واللوائح والقرارات التي يعتمدها المجلس.</p>\\n<p>د - الإيرادات المتحصلة من عوائد استغلال واستثمار أصولها وأموالها.<br>هـ - ما يقبله المجلس من هبات وإعانات وتبرعات ومنح ووصايا وأوقاف.<br>و - أي مورد آخر يقره المجلس.</p>\\n<p>2- تودع أموال الهيئة في حساب خاص بها في مؤسسة النقد العربي السعودي، وللهيئة عند الحاجة فتح حسابات في البنوك المرخص لها بالعمل في المملكة، ويصرف من هذه الأموال وفق ميزانية الهيئة المعتمدة.</p>\\n<p>-3 - تؤول الأموال الفائضة عن حاجة الهيئة خلال السنة المالية إلى الخزينة العامة للدولة لحساب جاري وزارة المالية، وذلك بعد اقتطاع جميع النفقات الجارية ونفقات رأس المال وغيرها من المصروفات التي تحتاج إليها الهيئة، وما تحتاج إليه لتمويل مشروعاتها المستقبلية المقرة في ميزانيتها السنوية وللوفاء بالتزاماتها النظامية، وذلك دون الإخلال بشرط الواقف فيما يتعلق بالأوقاف.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0f5b1855961142418997f989dd1e3a9c\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تعامل الهيئة من حيث إعفاء مستورداتها من الرسوم الجمركية بحسب القواعد المتبعة في شأن مستوردات المؤسسات العامة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1c1cb5882acb4110a8250d09851d40f4\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li class=\\\"MsoNormal\\\" style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\">&nbsp;تكون للهيئة ميزانية سنوية مستقلة، تصدر وفقاً لترتيبات إصدار الميزانية العامة للدولة.</li>\\n<li class=\\\"MsoNormal\\\" style=\\\"text-align: right; line-height: 150%; direction: rtl; unicode-bidi: embed;\\\">السنة المالية للهيئة هي السنة المالية للدولة، واستثناءً من ذلك تبدأ السنة المالية الأولى من تاريخ نفاذ التنظيم، وتنتهي بنهاية السنة المالية التالية للدولة.</li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ef8941defc2c499fbd80f449a8f0e106\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع عدم الإخلال باختصاص ديوان المراقبة العامة بالرقابة على حسابات الهيئة وعملياتها، يعين المجلس مراجع حسابات خارجيًّا (أو أكثر) من المرخص لهم بالعمل في المملكة، لتدقيق حسابات الهيئة ومعاملاتها وبياناتها وميزانيتها السنوية وحسابها الختامي، ويحدد المجلس أتعابه. ويرفع تقرير مراجع الحسابات إلى المجلس، ويزود ديوان المراقبة العامة بنسخة منه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/67356307a0814eec925b97607270994f\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ينشر التنظيم في الجريدة الرسمية، ويعمل به من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac0c28264ea24e8b88df682235b85570\",\n      \"title\": \"المادة الثالثة عشرة مكررة\",\n      \"content\": {\n        \"markup\": \"<p>يخضع منسوبو الهيئة لاحكام نظام العمل ونظام التأمينات الاجتماعية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - header (ar-jo)","path":"/Properties/*/Value","oldValue":"تنظيم الهيئة العامة للعقار","newValue":"","change":"Delete"},{"success":true,"name":"Property - header (en-us)","path":"/Properties/*/Value","oldValue":"تنظيم الهيئة العامة للعقار","newValue":"","change":"Delete"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"تنظيم\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"الانظمة واللوائح والادلة\",\n  \"الانظمة\",\n  \"تنظيم الهيئة العامة للعقار\"\n]","change":"Update"},{"success":true,"name":"Property - legislationDocuments (ar-jo)","path":"/Properties/*/Value","oldValue":"[]","new