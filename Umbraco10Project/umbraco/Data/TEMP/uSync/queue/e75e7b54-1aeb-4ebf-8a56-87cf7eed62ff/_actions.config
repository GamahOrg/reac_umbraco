-94c2-a2ef393c65e1.config","name":"الأستاذ عجلان بن عبدالعزيز العجلان","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"0f6e238c-d246-43ad-94c2-a2ef393c65e1"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"","exception":null,"change":"NoChange","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/4f611201-1937-4119-8a1b-445c0c1c7fee.config","name":"الأستاذ عبدالعزيز بن محمد السبيعي","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"4f611201-1937-4119-8a1b-445c0c1c7fee"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"","exception":null,"change":"NoChange","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/32362959-5a76-42a0-8ed1-7a704e6e904d.config","name":"الدكتور بدر بن إبراهيم بن سعيدان","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"32362959-5a76-42a0-8ed1-7a704e6e904d"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/7193daa5-2b19-4ccc-8148-9ded81b9f7e5.config","name":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - attachedFile (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"612a1aab-ff1b-410f-a988-5d90faccd2e9\",\n    \"mediaKey\": \"23f630b6-6cbe-4ff6-b706-7ad816ce2dad\"\n  }\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - attachedFile (en-us)","path":"/Properties/*/Value","oldValue":"/media/ge1hg4gf/اللائحة-التنظيمية-للاستشارات-والتحليلات-العقارية.pdf","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/c6804aab6efd46efbedfd13985a0ca6d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2fb4a582ebae4d07939d448d5ae79055\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0309d266208c45b1bc796c9490bc685b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c5826f46f78f4e59a39781af862a49b9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b714de54fe2b4f639ec2a9cf67013632\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e3a08a957dc74901b40a49be4f7570c1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d93bad38592d4f69bf23d0346e81e18c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/81702182288e4457b88f0181a1ea9cc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f1f0dbcfa3104f74b5471cc53895fa6d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/056e771e4b694fbaac3a5d560840c20b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6da4afa568734764983da3f155bd27a1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e01367fc892d430e8bfa527b4e5f0c53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c9b0c2257fa4415aa40ed1641153b2e7\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c6804aab6efd46efbedfd13985a0ca6d\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; يكون للألفاظ والمصطلحات الواردة في هذه اللائحة المعاني المُبينة أمام كل منها في المادة (الأولى) من نظام الوساطة العقارية الصادر بالمرسوم الملكي رقم: (م/130) في 30/11/1443هـ، ولائحته التنفيذية ما لم يقتض السياق خلاف ذلك.<br>2- &nbsp; يُقصد بالألفاظ والمصطلحات التالية -أينما وردت- في هذه اللائحة المعاني المُبينة أمام كل منها، ما لم يقتض السياق خلاف ذلك:<br><strong>الاستشارات العقارية:</strong> التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري، التي تقدم للمستفيد كتابة.<br><strong>التحليلات العقارية:</strong> الرأي أو التحليل المتصل بالقطاع العقاري، الذي يقدم للعموم عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها.<br><strong>المستفيد:</strong> طالب خدمة الاستشارة العقارية من المرخص له.<br><strong>المرخص له:</strong> شخص طبيعي أو اعتباري مرخص له بممارسة خدمة الاستشارات والتحليلات العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0309d266208c45b1bc796c9490bc685b\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يشترط للترخيص لممارسة خدمة الاستشارات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية – للأفراد الممارسين التابعين للأشخاص الاعتباريين (المنشآت)، أو الأشخاص الطبيعيين (الأفراد)، الحصول على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (3) سنوات في ممارسة أي من الأنشطة العقارية، وللهيئة الإعفاء من اشتراط المؤهل بناء على معايير تضعها في هذا الشأن، وتعتمد من المجلس.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c5826f46f78f4e59a39781af862a49b9\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط للترخيص لممارسة خدمة التحليلات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية – للأفراد الممارسين التابعين للأشخاص الاعتباريين (المنشآت)، أو الأشخاص الطبيعيين (الأفراد)، الحصول على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (10) سنوات في ممارسة أي من الأنشطة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e3a08a957dc74901b40a49be4f7570c1\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية -إضافة للأحكام الواردة في نظام الوساطة العقارية ولائحته التنفيذية -، الالتزام بما يأتي:<br>1-    التحلي بالنزاهة والإخلاص، وبذل العناية المهنية والتعامل بحياد وموضوعية مع المستفيدين أو المتلقين.<br>2-    التأكد من دقة وصحة المعلومات التي يقدمها، وعدم تضمينها أي معلومات أو بيانات مضللة، أو غير متوافقة مع البيانات والمعلومات العقارية الصادرة من الجهات الرسمية أو الجهات المرخص لها، عند تقديم الاستشارة العقارية.<br>3-    الحصول على ترخيص المقيمين المعتمدين عند ممارسة الخدمة المتضمنة تقييماً العقارات.<br>4-    تزويد الهيئة بأي معلومات أو بيانات تطلبها خلال المدة المحددة في الطلب.<br>5-    ممارسة الخدمة من قبل الأفراد الممارسين التابعين للمنشأة والمسجلين لدى الهيئة.<br>6-    الالتزام بما تقضي به الأنظمة والتعليمات في ممارسة الخدمة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d93bad38592d4f69bf23d0346e81e18c\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>يحظر على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية الآتي:<br>1- &nbsp; &nbsp;إنتاج أو ترويج ما من شأنه المساس باستقرار السوق العقاري أو الإضرار به، أو إرباك العموم.<br>2- &nbsp; &nbsp;تقديم الخدمة إذا كانت تؤدي إلى تحقيق مصلحة شخصية له أو لآخرين؛ أو الإضرار بالغير، وتمت بطريقة تنطوي على غش أو خداع أو تضليل.<br>3- &nbsp; &nbsp;تقديم الخدمة بناء على معلومات غير رسمية إذا كانت نتيجتها التأثير على السوق العقاري سلباً أو إيجاباً.<br>4- &nbsp; &nbsp;إفشاء أي معلومات ذات طابع سري بشأن الخدمة.<br>5- &nbsp; &nbsp;إعطاء أي مقارنات أو إشارات تسيء للآخرين.<br>6- &nbsp; &nbsp;ممارسة الخدمة عبر اسم مستعار في وسائل التواصل الاجتماعي أو أي وسيلة إعلامية.<br>7- &nbsp; &nbsp;استخدام اسم وشعار الهيئة في أي استشارة أو تحليل عقاري.<br>8- &nbsp; &nbsp;ممارسة خدمة التحليلات العقارية بناء على إعلان مدفوع.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/81702182288e4457b88f0181a1ea9cc8\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>على المرخص له عند إبرام عقد وساطة مع المستفيد لتقديم الاستشارات العقارية، أن يتم تقديمها كتابة –خلال مدة سريان العقد-، وتضمين الاستشارة البيانات التالية:<br>1- &nbsp; &nbsp;رقم عقد الوساطة.<br>2- &nbsp; &nbsp;اسم المرخص له ورقم ترخيصه.<br>3- &nbsp; &nbsp;تاريخ تقديم الاستشارة.<br>4- &nbsp; &nbsp;المعلومات الجوهرية والبيانات التي بنيت عليها الاستشارة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f1f0dbcfa3104f74b5471cc53895fa6d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية حال تقديم معلومات أو بيانات غير صحيحة أو ارتكاب مخالفة، تصحيح ذلك في ذات الوسيلة، بناء على طلب من المستفيد أو من الهيئة، دون أن يترتب على ذلك إعفاء مقدمها عن أي مسؤولية ناتجة عنها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/056e771e4b694fbaac3a5d560840c20b\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يعاقب كل من يخالف الأحكام النظامية بالعقوبات الواردة في جدول تصنيف المخالفات والعقوبات المقررة لها باللائحة التنفيذية.</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e01367fc892d430e8bfa527b4e5f0c53\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; line-height: 90%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تقيد بيانات المرخص لهم في سجل خاص بالمنصة الإلكترونية بالهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c9b0c2257fa4415aa40ed1641153b2e7\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; line-height: 90%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تُنشر هذه اللائحة في الجريدة الرسمية، ويُعمل بها من تاريخ نشرها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2fb4a582ebae4d07939d448d5ae79055\",\n      \"title\": \"أحكام وشروط الترخيص\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b714de54fe2b4f639ec2a9cf67013632\",\n      \"title\": \"التزامات ومحظورات المرخص له\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6da4afa568734764983da3f155bd27a1\",\n      \"title\": \"أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (en-us)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/c6804aab6efd46efbedfd13985a0ca6d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0309d266208c45b1bc796c9490bc685b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c5826f46f78f4e59a39781af862a49b9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e3a08a957dc74901b40a49be4f7570c1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d93bad38592d4f69bf23d0346e81e18c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/81702182288e4457b88f0181a1ea9cc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f1f0dbcfa3104f74b5471cc53895fa6d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/056e771e4b694fbaac3a5d560840c20b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e01367fc892d430e8bfa527b4e5f0c53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c9b0c2257fa4415aa40ed1641153b2e7\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c6804aab6efd46efbedfd13985a0ca6d\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; يكون للألفاظ والمصطلحات الواردة في هذه اللائحة المعاني المُبينة أمام كل منها في المادة (الأولى) من نظام الوساطة العقارية الصادر بالمرسوم الملكي رقم: (م/130) في 30/11/1443هـ، ولائحته التنفيذية ما لم يقتض السياق خلاف ذلك.<br>2- &nbsp; يُقصد بالألفاظ والمصطلحات التالية -أينما وردت- في هذه اللائحة المعاني المُبينة أمام كل منها، ما لم يقتض السياق خلاف ذلك:<br>الاستشارات العقارية: التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري، التي تقدم للمستفيد كتابة.<br>التحليلات العقارية: الرأي أو التحليل المتصل بالقطاع العقاري، الذي يقدم للعموم عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها.<br>المستفيد: طالب خدمة الاستشارة العقارية من المرخص له.<br>المرخص له: شخص طبيعي أو اعتباري مرخص له بممارسة خدمة الاستشارات والتحليلات العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0309d266208c45b1bc796c9490bc685b\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يشترط للترخيص لممارسة خدمة الاستشارات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية – للأفراد الممارسين التابعين للأشخاص الاعتباريين (المنشآت)، أو الأشخاص الطبيعيين (الأفراد)، الحصول على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (3) سنوات في ممارسة أي من الأنشطة العقارية، وللهيئة الإعفاء من اشتراط المؤهل بناء على معايير تضعها في هذا الشأن، وتعتمد من المجلس.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c5826f46f78f4e59a39781af862a49b9\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط للترخيص لممارسة خدمة التحليلات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية – للأفراد الممارسين التابعين للأشخاص الاعتباريين (المنشآت)، أو الأشخاص الطبيعيين (الأفراد)، الحصول على شهادة جامعية في التخصصات ذات العلاقة ومنها على سبيل المثال (الاقتصاد – الهندسة – المالية –إدارة الأعمال) ونحوها، وخبرة لا تقل عن (10) سنوات في ممارسة أي من الأنشطة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e3a08a957dc74901b40a49be4f7570c1\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية -إضافة للأحكام الواردة في نظام الوساطة العقارية ولائحته التنفيذية -، الالتزام بما يأتي:<br>1-    التحلي بالنزاهة والإخلاص، وبذل العناية المهنية والتعامل بحياد وموضوعية مع المستفيدين أو المتلقين.<br>2-    التأكد من دقة وصحة المعلومات التي يقدمها، وعدم تضمينها أي معلومات أو بيانات مضللة، أو غير متوافقة مع البيانات والمعلومات العقارية الصادرة من الجهات الرسمية أو الجهات المرخص لها، عند تقديم الاستشارة العقارية.<br>3-    الحصول على ترخيص المقيمين المعتمدين عند ممارسة الخدمة المتضمنة تقييماً العقارات.<br>4-    تزويد الهيئة بأي معلومات أو بيانات تطلبها خلال المدة المحددة في الطلب.<br>5-    ممارسة الخدمة من قبل الأفراد الممارسين التابعين للمنشأة والمسجلين لدى الهيئة.<br>6-    الالتزام بما تقضي به الأنظمة والتعليمات في ممارسة الخدمة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d93bad38592d4f69bf23d0346e81e18c\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>يحظر على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية الآتي:<br>1- &nbsp; &nbsp;إنتاج أو ترويج ما من شأنه المساس باستقرار السوق العقاري أو الإضرار به، أو إرباك العموم.<br>2- &nbsp; &nbsp;تقديم الخدمة إذا كانت تؤدي إلى تحقيق مصلحة شخصية له أو لآخرين؛ أو الإضرار بالغير، وتمت بطريقة تنطوي على غش أو خداع أو تضليل.<br>3- &nbsp; &nbsp;تقديم الخدمة بناء على معلومات غير رسمية إذا كانت نتيجتها التأثير على السوق العقاري سلباً أو إيجاباً.<br>4- &nbsp; &nbsp;إفشاء أي معلومات ذات طابع سري بشأن الخدمة.<br>5- &nbsp; &nbsp;إعطاء أي مقارنات أو إشارات تسيء للآخرين.<br>6- &nbsp; &nbsp;ممارسة الخدمة عبر اسم مستعار في وسائل التواصل الاجتماعي أو أي وسيلة إعلامية.<br>7- &nbsp; &nbsp;استخدام اسم وشعار الهيئة في أي استشارة أو تحليل عقاري.<br>8- &nbsp; &nbsp;ممارسة خدمة التحليلات العقارية بناء على إعلان مدفوع.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/81702182288e4457b88f0181a1ea9cc8\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>على المرخص له عند إبرام عقد وساطة مع المستفيد لتقديم الاستشارات العقارية، أن يتم تقديمها كتابة –خلال مدة سريان العقد-، وتضمين الاستشارة البيانات التالية:<br>1- &nbsp; &nbsp;رقم عقد الوساطة.<br>2- &nbsp; &nbsp;اسم المرخص له ورقم ترخيصه.<br>3- &nbsp; &nbsp;تاريخ تقديم الاستشارة.<br>4- &nbsp; &nbsp;المعلومات الجوهرية والبيانات التي بنيت عليها الاستشارة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f1f0dbcfa3104f74b5471cc53895fa6d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>على المرخص له بممارسة خدمة الاستشارات والتحليلات العقارية حال تقديم معلومات أو بيانات غير صحيحة أو ارتكاب مخالفة، تصحيح ذلك في ذات الوسيلة، بناء على طلب من المستفيد أو من الهيئة، دون أن يترتب على ذلك إعفاء مقدمها عن أي مسؤولية ناتجة عنها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/056e771e4b694fbaac3a5d560840c20b\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يعاقب كل من يخالف الأحكام النظامية بالعقوبات الواردة في جدول تصنيف المخالفات والعقوبات المقررة لها باللائحة التنفيذية.</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e01367fc892d430e8bfa527b4e5f0c53\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; line-height: 90%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تقيد بيانات المرخص لهم في سجل خاص بالمنصة الإلكترونية بالهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c9b0c2257fa4415aa40ed1641153b2e7\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin-bottom: 0in; text-align: justify; line-height: 90%; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تُنشر هذه اللائحة في الجريدة الرسمية، ويُعمل بها من تاريخ نشرها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - description","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","change":"Update"},{"success":true,"name":"Property - header (ar-jo)","path":"/Properties/*/Value","oldValue":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - header (en-us)","path":"/Properties/*/Value","oldValue":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"اللائحة التنظيمية للاستشارات والتحليلات العقارية\",\n  \"التحليلات\",\n  \"العقارية\",\n  \"الانظمة واللوائح والادلة\",\n  \"لوائح\",\n  \"الهيئة العامة للعقار\"\n]","change":"Update"},{"success":true,"name":"Property - legislationDocuments (ar-jo)","path":"/Properties/*/Value","oldValue":"[]","newValue":"","change":"Delete"},{"success":true,"name":"Property - pageName","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","change":"Update"},{"success":true,"name":"Property - publishDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2023-12-22T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - publishDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2023-12-03T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (en-us)","path":"/Properties/*/Value","oldValue":"2022-06-29T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"ساري\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Active\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"أنظمة\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Regulations\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - subContent (ar-jo)","path":"/Properties/*/Value","oldValue":"الرأي أو التحليل المتصل بالقطاع العقاري، الذي يقدم للعموم عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها","newValue":"","change":"Delete"},{"success":true,"name":"Property - subContent (en-us)","path":"/Properties/*/Value","oldValue":"الرأي أو التحليل المتصل بالقطاع العقاري، الذي يقدم للعموم عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها","newValue":"","change":"Delete"},{"success":true,"name":"Property - title","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللائحة التنظيمية للاستشارات والتحليلات العقارية","change":"Update"}],"key":"7193daa5-2b19-4ccc-8148-9ded81b9f7e5"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/644430d0-b05c-4e27-babd-320927603de8.config","name":"التقديم","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - formDescription","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"قم بملئ النمو