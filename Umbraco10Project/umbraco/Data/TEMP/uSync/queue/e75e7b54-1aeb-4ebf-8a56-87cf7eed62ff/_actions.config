",\n  \"فال\",\n  \"الهيئة العامة للعقار\",\n  \"Rega\"\n]","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"Real estate brokerage","newValue":"الوساطة العقارية","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"FAL – Real Estate Brokerage","change":"Update"},{"success":true,"name":"Property - serviceFeature (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"bc77edf1-894c-41c4-a893-8e53e29da42e\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>صفحة الخدمات الإلكترونية للوساطة العقارية، تقدم للأفراد والمنشآت العقارية تراخيص \\\\\\\"فال \\\\\\\" لممارسة الأنشطة العقارية، بالإضافة إلى خدمات الوساطة المبتكرة، سعيًا لتنظيم وتحسين الخدمات المقدمة في السوق العقاري، وحماية المستفيدين، ورفع الثقة في السوق وتحفيز النشاط العقاري.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"014ded59-4cc1-4e7a-bf07-f565a0a891ed\",\n    \"name\": \"Item 2\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/889279a4914246a9b2db42f9b22a4b68\",\n    \"featureTabTitle\": \"الاستعلامات\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>إمكانية البحث والتحقق من الأفراد والمنشآت العقارية، بالإضافة إلى التحقق من صلاحية الإعلان العقاري.</p>\\\\n<p>&nbsp;</p>\\\\n<p><a href=\\\\\\\"https://eservicesredp.rega.gov.sa/auth/queries\\\\\\\">الاستعلامات</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  },\n  {\n    \"key\": \"a0b90090-73f3-430e-b9e2-eba9f5073d72\",\n    \"name\": \"Item 3\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"المنصات العقارية المرخصة\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">يُتاح للأفراد إمكانية استعراض جميع المنصات العقارية الإلكترونية المرخصة من الهيئة العامة للعقار برخصة فال للوساطة والتسويق العقاري.</p>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">&nbsp;</span></p>\\\\n<div>\\\\n<table border=\\\\\\\"0\\\\\\\" cellspacing=\\\\\\\"0\\\\\\\" cellpadding=\\\\\\\"0\\\\\\\" width=\\\\\\\"95%\\\\\\\" class=\\\\\\\"MsoNormalTable\\\\\\\" style=\\\\\\\"width: 95.84%; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0cm 0cm 0cm 0cm; mso-table-dir: bidi;\\\\\\\" dir=\\\\\\\"rtl\\\\\\\">\\\\n<tbody>\\\\n<tr style=\\\\\\\"mso-yfti-irow: 0; mso-yfti-firstrow: yes;\\\\\\\">\\\\n<td width=\\\\\\\"16%\\\\\\\" valign=\\\\\\\"top\\\\\\\" style=\\\\\\\"width: 16.86%; border: solid windowtext 1.0pt; padding: 0cm 5.4pt 0cm 5.4pt;\\\\\\\">\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: center; tab-stops: 88.5pt;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"center\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: center; tab-stops: 88.5pt;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"center\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; m