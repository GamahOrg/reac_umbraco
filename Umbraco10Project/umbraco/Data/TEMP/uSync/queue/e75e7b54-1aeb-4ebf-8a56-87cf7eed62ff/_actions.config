tails":[{"success":true,"name":"Property - content","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطا ع التقنية العقارية لتبادل المعرفة والخبرات و تسليط الضوء على أحدث التطورات في التقنيات العقارية بما يسهم في رفع مستوى الوعي بأهمية التقنيات في تعزيز كفاءة السوق العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\",\n      \"title\": \"أهداف المبادرة :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز المعرفة بالتقنيات العقارية وتسليط الضوء على أحدث التطورات فيها.</li>\\n<li class=\\\"O0\\\">تشجيع التعاون بين الشركات عن طريق بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية.</li>\\n<li class=\\\"O0\\\">نشر الوعي والتثقيف بأهمية التقنيات العقارية الحديثة وكيفية الاستفادة منها لتحسين الأداء وزيادة الكفاءة في السوق العقاري.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات والأفكار عن طريق توفير منصة يشارك فيها المتخصصون تجاربهم وأفكارهم والحلول المبتكرة لمواجهة تحديات القطاع العقاري .</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مجلس <span>&nbsp;بروبتيك؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">جلسات حوارية تجمع الخبرات والعاملين بالقطاع العقاري والتقني</p>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو الهدف من<span>&nbsp; المجلس؟</span>\\n<ul style=\\\"list-style-type: circle;\\\">\\n<li>تعزيز المعرفة بالتقنيات العقارية</li>\\n<li>تبادل الخبرات والأفكار</li>\\n<li>رفع مستوى الوعي بأهمية التقنيات العقارية الحديثة</li>\\n<li>تحسين الأداء وزيادة الكفاءة في السوق العقاري</li>\\n<li>بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية</li>\\n<li>تعزيز التكامل وتحقيق الفائدة المشتركة</li>\\n</ul>\\n</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;</span></p>\\n<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد شهادة للحضور ؟</li>\\n</ul>\\n</div>\\n<div class=\\\"O0\\\" style=\\\"padding-right: 40px; padding-left: 40px;\\\">لا</div>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; رواد الأعمال </span>و أصحاب الشركات الناشئة<span>&nbsp; الصغيرة </span>و المتوسطة</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/feab73ac8c3746bca6a57438fba3ff82\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطا ع التقنية العقارية لتبادل المعرفة والخبرات و تسليط الضوء على أحدث التطورات في التقنيات العقارية بما يسهم في رفع مستوى الوعي بأهمية التقنيات في تعزيز كفاءة السوق العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/f8132ba58b494091b17b8ee592f484d1\",\n      \"title\": \"أهداف المبادرة :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز المعرفة بالتقنيات العقارية وتسليط الضوء على أحدث التطورات فيها.</li>\\n<li class=\\\"O0\\\">تشجيع التعاون بين الشركات عن طريق بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية.</li>\\n<li class=\\\"O0\\\">نشر الوعي والتثقيف بأهمية التقنيات العقارية الحديثة وكيفية الاستفادة منها لتحسين الأداء وزيادة الكفاءة في السوق العقاري.</li>\\n<li class=\\\"O0\\\">تبادل الخبرات والأفكار عن طريق توفير منصة يشارك فيها المتخصصون تجاربهم وأفكارهم والحلول المبتكرة لمواجهة تحديات القطاع العقاري .</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/9a88d5e0826e4f0dbd16e5798050e7af\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مجلس <span>&nbsp;بروبتيك؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">جلسات حوارية تجمع الخبرات والعاملين بالقطاع العقاري والتقني</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو الهدف من<span>&nbsp; المجلس؟</span>\\n<ul style=\\\"list-style-type: circle;\\\">\\n<li>تعزيز المعرفة بالتقنيات العقارية</li>\\n<li>تبادل الخبرات والأفكار</li>\\n<li>رفع مستوى الوعي بأهمية التقنيات العقارية الحديثة</li>\\n<li>تحسين الأداء وزيادة الكفاءة في السوق العقاري</li>\\n<li>بناء علاقات تعاون وشراكات بين الجهات المختلفة المعنية بالتقنيات العقارية</li>\\n<li>تعزيز التكامل وتحقيق الفائدة المشتركة</li>\\n</ul>\\n</li>\\n</ul>\\n<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل يوجد شهادة للحضور ؟</li>\\n</ul>\\n</div>\\n<div class=\\\"O0\\\" style=\\\"padding-right: 40px; padding-left: 40px;\\\">لا</div>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; رواد الأعمال </span>و أصحاب الشركات الناشئة<span>&nbsp; الصغيرة </span>و المتوسطة</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []