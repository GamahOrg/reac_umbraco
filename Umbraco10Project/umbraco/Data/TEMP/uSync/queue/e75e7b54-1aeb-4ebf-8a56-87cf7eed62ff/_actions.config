:"Delete"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - subContent (ar-jo)","path":"/Properties/*/Value","oldValue":"اللائحة التنفيذية لنظام التسجيل العيني للعقار","newValue":"","change":"Delete"},{"success":true,"name":"Property - subContent (en-us)","path":"/Properties/*/Value","oldValue":"اللائحة التنفيذية لنظام التسجيل العيني للعقار","newValue":"","change":"Delete"},{"success":true,"name":"Property - title","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللائحة التنفيذية لنظام التسجيل العيني للعقار","change":"Update"}],"key":"5c9bebe3-8715-4a67-be6c-5a7a678b3521"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/6169d0a4-cb3a-4b45-89e6-48464b02c7d7.config","name":"نظام التسجيل العيني للعقار","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - attachedFile (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"2aea38ea-7f7e-4426-a9cb-c207a9d9fd65\",\n    \"mediaKey\": \"ae7bbfa0-80af-4b85-9a95-07f55798df2a\"\n  }\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - attachedFile (en-us)","path":"/Properties/*/Value","oldValue":"/media/ga4js0hg/نظام-التسجيل-العيني.pdf","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/41afd6cd459449b5a157d8c164d0decc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\"\n      },\n      {\n        \"contentUdi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5b704638459e4a72b3d96c3d1fb20439\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b353f481cedf4159b317178e95c565b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fd189eec716d497ebef259ade307e988\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6fd6d89056954026a99b1a1c884226ac\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\"\n      },\n      {\n        \"contentUdi\": \"umb://element/342fba226d1941d095e68538643ed3de\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d6c032e25ef44373874c00965e284330\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\"\n      },\n      {\n        \"contentUdi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5335c4abccd1432085427142b20f971a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b371a42c33134857bcc242df90c35a88\"\n      },\n      {\n        \"contentUdi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1366bc6855484252aa606d86d6420e02\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/84752c5033a24474bd325242a0bfa204\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8b6bd1715d84484fb92035e624052563\"\n      },\n      {\n        \"contentUdi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\"\n      },\n      {\n        \"contentUdi\": \"umb://element/13404ff744484e4bb1effaac223f115f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a2111fc87afb4e9a83e417a7a38826bc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd04e28aeea94a41a276d4ea396a07fe\"\n      },\n      {\n        \"contentUdi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0405884f68a7490bbb84d74f3b042946\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1a25d4098f9447b7892ee35140689550\"\n      },\n      {\n        \"contentUdi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>يقصد بالكلمات والعبارات الآتية -أينما وردت في هذا النظام- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\n<p><strong>النظام:</strong> نظام التسجيل العيني للعقار.</p>\\n<p><strong>الجهة المختصة:</strong> الجهة التي يصدر بتحديدها قرار من مجلس الوزراء.</p>\\n<p><strong>المسؤول الأول: </strong>المسؤول الأول، أو مجلس الإدارة، في الجهة المختصة؛ بحسب الأحوال.</p>\\n<p><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.</p>\\n<p><strong>العقار: </strong>قطعة من الأرض وما تحتها وما فوقها -ويستثنى من ذلك الثروات الطبيعية، والعلو غير المأذون بعمارته واستغلاله- وما عليها من بناء أو ملحقات ثابتة أو مزروعات أو مصانع أو منشآت أخرى كالموانئ والمطارات وخطوط الكهرباء والأنابيب وغيرها.</p>\\n<p><strong>الحق العقاري:</strong> سلطة مباشرة مقرة نظاماً لشخص -ذي صفة طبيعية أو اعتبارية- أو أكثر على عقار معين تخوله التصرف فيه أو الاستئثار بمنافعه أو ببعضها.&nbsp;</p>\\n<p><strong>السجل العقاري: </strong>مجموعة وثائق تبين أوصاف العقار وموقعه وحالته المادية والنظامية، وما يتبعه من حقوق والتزامات، والتعديلات التي تطرأ على ذلك، في ضوء الوثائق المعتبرة نظاماً.</p>\\n<p><strong>التسجيل العيني:</strong> جعل العقار محل الحق العقاري أساساً لقيد الحق.&nbsp;</p>\\n<p><strong>التسجيل العيني الأول:</strong> تسجيل العقار باسم مالكه لأول مرة في السجل العقاري، وفقاً للإجراءات الواردة في النظام واللائحة.</p>\\n<p><strong>المسجِّل العقاري:</strong> من يقوم بتوثيق التسجيل العيني الأول، وما يرد على العقار من تصرفات أو تغييرات في وصفه، وفقاً لأحكام النظام واللائحة.</p>\\n<p><strong>المنطقة العقارية:</strong> موقع أرض يحدده قرار صادر من الجهة المختصة، يكون خاضعاً لأحكام النظام واللائحة.</p>\\n<p><strong>صك تسجيل الملكية:</strong> وثيقة صادرة عن السجل العقاري لإثبات بيانات عقار مطابقة للسجل، وفقاً للنموذج الذي تحدده اللائحة، تتضمن: موقع العقار، وحدوده، ووصفه، واستعماله، وما يتبعه من حقوق والتزامات، وبيانات مالكه، وأي بيانات أخرى تحددها اللائحة.</p>\\n<p><strong>الخارطة:</strong> رسم هندسي مساحي مبني على نظام إحداثيات وطني، يبين: موقع العقار، وحدوده، ومعالمه، وأرقامه، ومساحته، وأي بيانات رقمية وتصويرية أخرى.</p>\\n<p><strong>المالك:</strong> شخص ذو صفة طبيعية أو اعتبارية يثبت السجل العقاري حق ملكية عقار له.</p>\\n<p><strong>المقابل المالي: </strong>مبلغ مستحق مقابل خدمات التسجيل العيني وفقا للنظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يسري النظام على جميع العقارات الواقعة في إقليم المملكة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b353f481cedf4159b317178e95c565b2\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>1-تختص الجهة المختصة بالتسجيل العيني، ولها الاستعانة بالجهات الحكومية أو الإسناد إلى الجهات الخاصة لأداء ما تراه من اختصاصاتها المتعلقة بذلك؛ وفقاً للشروط والضوابط التي تضعها.<br>2- تنشئ الجهة المختصة السجل العقاري وتشرف على كل ما يخصه، وتقوم بجميع الإجراءات المتعلقة به.<br>3- تضمن الجهة المختصة صحة معلومات وبيانات العقار ودقّتها، وما يتبعه من حقوق والتزامات، الواردة في السجل العقاري وما ينشأ عنه من صكوك ووثائق.<br>4-تقوم الجهة المختصة بأعمال المساحة المتعلقة بإجراءات التسجيل العيني، وفقاً للائحة والمعايير الجيومكانية الوطنية المعتمدة من جهة الاختصاص، ويمكن -دون إخلال بالأنظمة والتنظيمات ذات العلاقة- استخدام وسائل المساحة الحديثة -بما فيها التصوير الجوي والفضائي وغيرها من التقنيات- عند تنفيذ تلك الأعمال. وتحدد اللائحة إجراءات ذلك.<br>5-تملك الجهة المختصة حصرياً السجل العقاري وبياناته، ولها استثمار بيانات السجل بأنواع الاستغلال التجاري، وإتاحتها للمستفيدين بأسعار عادلة تدعم التنمية، على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون للسجل العقاري الحجية المطلقة في الإثبات وفقاً لأحكام النظام، ويعمل بمضمونه أمام القضاء والجهات كافة بلا بينة إضافية، ولا يجوز الطعن فيه إلا إذا كان الطعن بسبب خطأ كتابي أو تزوير.<br>2-يجب أن يحتوي السجل العقاري على أوصاف العقار، وجميع الحقوق العينية التي ترد عليه والالتزامات التي تتبعه، وأي تعديلات تطرأ على ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fd189eec716d497ebef259ade307e988\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>1- لا تعدل بيانات السجل العقاري ولا يجرى أي تغيير عليه، إلا وفقاً لأحكام النظام واللائحة.<br>2-تصحح الجهة المختصة الأخطاء الكتابية والمادية البحتة بناءً على طلب من أي ذي مصلحة أو من تلقاء نفسها، مع إشعار ذوي الشأن بذلك بالوسيلة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>يكون الاطلاع على بيانات السجل العقاري متاحاً للكافة، وذلك وفقا لما يحدده النظام واللائحة، ويستثنى من ذلك العقارات التي تحدد الجهات المعنية أنها سرية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>1-تحدد المنطقة العقارية بقرار يصدر عن الجهة المختصة، على أن يتضمن القرار تحديداً دقيقاً وبمعالم واضحة للمنطقة والمدة المحددة لاستقبال طلبات التسجيل العيني الأول، ويعلن عنها بأي وسيلة مناسبة يحددها القرار.<br>2-تختص الجهة المختصة بالتسجيل العيني الأول لكل عقار واقع في المنطقة العقارية وتسجيل أي تصرفات لاحقة ترد عليه.&nbsp;<br>3-توثق التصرفات العقارية التي تقع على العقار الواقع في المنطقة العقارية، والتي تجري خلال فترة إجراءات التسجيل العيني الأول، وفقاً للإجراءات التي تحددها اللائحة.&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/342fba226d1941d095e68538643ed3de\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>1-يشترط للتسجيل العيني الأول الآتي:<br>أ- أن يكون للعقار -ما عدا العقارات المملوكة للدولة- صك ملكية مستوفٍ للمتطلبات النظامية.</p>\\n<p>ب- أن يكون العقار مكتمل البيانات الجيومكانية.</p>\\n<p>وتحدد اللائحة إجراءات التسجيل العيني الأول.</p>\\n<p>2-على كل من تطلب منه الجهة المختصة، الإفصاح عن أي مستندات أو بيانات لازمة لصحة وسلامة التسجيل العيني الأول.<br>3تجري الجهة المختصة الأعمال المساحية اللازمة للتسجيل العيني الأول، ولها -دون أن تجري تلك الأعمال- استخدام البيانات المتعلقة بالأعمال المساحية المعتمدة من جهة الاختصاص في حال توفرها وفق ما تحدده اللائحة.<br>4-يصدر صك تسجيل الملكية للعقار بعد استكمال الإجراءات اللازمة، وفقاً لأحكام النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1-تعد الجهة المختصة قوائم للملاك بناء على صكوك تسجيل الملكية الصادرة بناء على أحكام النظام، على أن تشمل تلك القوائم بيانات الصكوك التي تحددها اللائحة.<br>2-تنشر الجهة المختصة قوائم الملاك -المشار إليها في الفقرة (1) من هذه المادة- بالوسائل المناسبة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6c032e25ef44373874c00965e284330\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>لكل ذي مصلحة الاعتراض على التسجيل العيني الأول أمام المحكمة المختصة ما لم يكتسب التسجيل الحجية المطلقة وفقاً لأحكام النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1-في حال قيد دعوى قضائية تتعلق بالتسجيل العيني الأول وفق ما أشير إليه في المادة (العاشرة) من النظام، فيتم التأشير بها في السجل العقاري وقوائم الملاك، ويضمن في السجل مضمون الحكم النهائي الصادر في شأن الدعوى.<br>وتحدد اللائحة إجراءات وأحكام التأشير في السجل العقاري، وفي قوائم الملاك.</p>\\n<p>2-يكتسب التسجيل العيني الأول الحجية المطلقة بعد انقضاء سنة من تاريخ نشر قوائم الملاك، وللمتضرر من التسجيل العيني الأول بعد اكتسابه الحجية المطلقة حق اللجوء إلى المحكمة المختصة وطلب التعويض من المتسبب دون الحق في طلب إلغاء التسجيل العيني الأول أو تعديل بياناته أو الحقوق الواردة فيه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; mso-outline-level: 3; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">لملاك العقارات طلب تسجيل عقاراتهم -الواقعة خارج نطاق المنطقة العقارية- في السجل العقاري وفقاً للشروط والضوابط التي تحددها اللائحة.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تسجل في السجل العقاري جميع التصرفات اللاحقة للتسجيل العيني الأول للعقار، والتي من شأنها إنشاء أي من الحقوق العينية الأصلية أو التبعية أو نقله أو تغييره أو زواله، أو تعديل بيانات العقار، وكذلك الأحكام النهائية المثبتة لشيء من ذلك، ولا تكون تلك الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل. ويدخل في تلك التصرفات القسمة العقارية والوصية والوقف والإرث والرهن والمنح ونحوها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بجميع عقود الإيجار والالتزامات الموثقة نظاماً التي ترد على منفعة العقار إذا كانت مدتها (عشر) سنوات فأكثر، والأحكام النهائية المثبتة لشيء من ذلك، في السجل العقاري، ولا تكون هذه الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التأشير.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تقوم الجهات المعنية -وفق آلية تتفق عليها الجهة المختصة مع كل منها- بتزويد السجل العقاري بوقائع وفاة ملاك العقارات وصكوك حصر ورثتهم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بالدعاوى المتعلقة بحق عيني عقاري أو بتصرف من التصرفات الواجب تسجيلها، في السجل العقاري، متى تضمنت هذه الدعاوى إجراء تغيير في بيانات السجل، ولا تُسمع الدعوى إلا بعد تقديم ما يثبت حصول التأشير بمضمون الدعوى في السجل.</p>\\n<p>ولكل ذي مصلحة أن يقدم طلباً إلى المحكمة المختصة بصفة مستعجلة لمحو التأشير المشار إليه أعلاه، وتأمر المحكمة بمحوه متى تبين لها أن الدعوى التي تم التأشير بها كيدية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يترتب على التأشير بالدعاوى -المشار إليها في المادة (السادسة عشرة) من النظام- أن يكون أي حق تقرر بحكم نهائي في هذه الدعاوى حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بإعلان الرغبة في الأخذ بالشفعة في السجل العقاري، ويترتب على ذلك أن يكون حق الشفيع إذا تقرر بحكم نهائي حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تحدد اللائحة آليات تسجيل الأحكام المشار إليها في المادتين (السابعة عشرة) و(الثامنة عشرة) من النظام في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5335c4abccd1432085427142b20f971a\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>1-يقدم ذو الشأن طلب التسجيل أو التأشير في السجل العقاري إلى الجهة المختصة، ويرفق بالطلب المستندات المؤيدة له التي تحددها اللائحة، وعلى الجهة المختصة تدوين الطلب وفقًا لتاريخ تقديمه وساعته على النحو الذي تحدده اللائحة، ويعد طلب التسجيل كأن لم يكن إذا لم يقدم ذو الشأن تلك المستندات خلال (ثلاثين) يوماً من تاريخ تقديم الطلب، ولا يجوز إجراء أي تسجيل إذا تضمن السجل العقاري قيوداً تمنع التصرف في العقار.<br>2-مع مراعاة ما ورد في الفقرة (1) من هذه المادة، إذا قدم إلى الجهة المختصة أكثر من طلب لتسجيل التصرفات أو التأشير بها في شأن العقار ذاته؛ وجب بحثها وفقًا لأسبقية تسجيل الطلب، وذلك على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b371a42c33134857bcc242df90c35a88\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لمن أُبلغ برفض طلبه بالتسجيل أو التأشير في السجل العقاري، أو بسقوط أسبقيته، أو بوقف الإجراءات؛ أن يتظلم أمام الجهة المختصة خلال (ثلاثين) يوماً من تاريخ الإبلاغ، وعليها البت في التظلم خلال (ثلاثين) يوماً من تقديمه، فإذا قبلت تظلمه أمرت بالتسجيل أو التأشير. أما إن رفضته أو لم تتخذ قرارًا في شأنه خلال تلك المدة، فلمقدمه التظلم أمام المحكمة المختصة خلال (ثلاثين) يوماً من تاريخ إبلاغه برفض تظلمه أمام الجهة المختصة أو من تاريخ انتهاء المدة المحددة لاتخاذ القرار بشأن التظلم دون اتخاذه، أيهما أسبق، ويوقف النظر في الطلبات اللاحقة إلى حين الفصل في التظلم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة ما تضمنته المادة (العشرون) من النظام، يسجل مضمون المحررات الموثقة نظاماً الواردة من الجهات المعنية في السجل العقاري طبقاً لترتيب ورودها إلى الجهة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1366bc6855484252aa606d86d6420e02\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على الجهات المعنية بإصدار رخص متعلقة بالعقارات واستعمالاتها إشعار الجهة المختصة بالرخص التي تصدرها أو تلغيها للعقارات الواقعة في المنطقة العقارية؛ للتأشير بها في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجب على مالك العقار إبلاغ الجهة المختصة بأي تغيير يطرأ على وصف العقار بسبب إنشاء مبانٍ أو إضافتها أو تعديلها أو إزالتها، خلال (تسعين) يومًا من تاريخ حدوث التغيير، وتتخذ الجهة المختصة الإجراءات اللازمة لتحديث بيانات السجل العقاري بما يتوافق مع ذلك على النحو الذي تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>للجهة المختصة -من تلقاء نفسها- أن تتخذ الإجراءات اللازمة لتحديث بيانات السجل العقاري بإضافة أي تغيير مرخص به على عقار قائم على الطبيعة غير مثبت في السجل. وتقوم الجهة المختصة بإشعار ذوي الشأن بهذا التحديث.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>للمتضرر من تسجيل التصرفات العقارية حق التقدم للمحكمة المختصة بطلب التعويض من المتسبب فيه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/84752c5033a24474bd325242a0bfa204\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لصاحب حق الانتفاع على العقار تسجيل التصرف فيه في السجل العقاري دون إذن مالك العقار، ما لم يُتفق على غير ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون لكل وحدة عقارية مفرزة واقعة في عقار مشترك، صك تسجيل ملكية خاص بها.<br>2-يجب تسجيل وثائق الملكية المشتركة التي تحددها اللائحة في السجل العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنشئ الجهة المختصة سجلاً للعقارات الموصوفة على الخارطة مرتبطاً بالسجل العقاري، وتحدد اللائحة إجراءات ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُسجل جميع التصرفات التي ترد على العقارات الموصوفة على الخارطة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام، وتحدد اللائحة إجراءات التسجيل، ويُصدر السجل شهادة بذلك، ولا تكون هذه التصرفات نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/13404ff744484e4bb1effaac223f115f\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-على مالك العقار خلال (ثلاثين) يوماً من اكتمال إنجاز العقار الموصوف على الخارطة تقديم طلب لتحويل بياناته الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.<br>2-يجوز -بناء على قرار صادر من الجهة المعنية بإصدار ترخيص التصرف في العقار الموصوف على الخارطة- اتخاذ الإجراءات اللازمة لتحويل بيانات العقار الموصوف على الخارطة الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط فيمن يمارس الأعمال المساحية المتعلقة بالتسجيل العيني أن يكون مرخصاً من الجهة ذات الاختصاص، ومقيداً في سجل تعده الجهة المختصة لهذا الغرض. وتحدد اللائحة الإجراءات والشروط اللازمة للقيد في هذا السجل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون فرز العقار أو دمجه في السجل العقاري بعد موافقة الجهة المعنية بالفرز أو الدمج، ووفقاً للإجراءات التي تحددها اللائحة.<br>2-إذا تم فرز العقار المحمل بحق عقاري إلى عقارين أو أكثر، يعد كل عقار جديد محملاً بذلك الحق كاملاً، ما لم يتفق ذوو الشأن على غير ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بمجانية إجراءات التسجيل العيني الأول، وما تضمنته الفقرة (5) من المادة (الثالثة) من النظام، يُحصل مقابل مالي لخدمات التسجيل العيني وفقاً لجدول تعده الجهة المختصة لهذا الغرض يعتمد بقرار من مجلس الوزراء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأي عقوبة أشد ينص عليها أي نظام آخر، يعاقب بغرامة لا تتجاوز مائة ألف ريال كل من:</p>\\n<p>1-امتنع عن الإفصاح -المشار إليه في الفقرة (2) من المادة (الثامنة)- عن أي مستندات أو بيانات لازمة لصحة وسلامة إجراءات التسجيل العيني الأول.<br>2-عاق عمل الجهة المختصة المتعلق بإجراءات التسجيل العيني.<br>3-تخلف عن الإبلاغ المشار إليه في المادة (الرابعة والعشرين) من النظام.<br>4-تخلف عن تقديم الطلب المشار إليه في الفقرة (1) من المادة (الحادية والثلاثين) من النظام خلال المدة المحددة في الفقرة.<br>5-تخلف عن تقديم طلب التسجيل العيني الأول لعقاره خلال المدة المحددة لتقديم الطلبات المشار إليها في الفقرة (1) من المادة (السابعة) من النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-تُشكّل بقرار من المسؤول الأول لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة، يكون أحدهم حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-تختص اللجنة بالنظر في المخالفات وإيقاع العقوبة المنصوص عليها في المادة (الخامسة والثلاثين) من النظام.<br>3-تحدد قواعد وإجراءات عمل اللجنة ومكافآت أعضائها بقرار من المسؤول الأول.<br>4-يجوز الاعتراض على قرارات اللجنة أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ العلم بها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المسجل العقاري الآتي:</p>\\n<p>1-أن يكون حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-ألا يكون سبق أن حُكم عليه بجريمة مخلة بالشرف والأمانة ولو رد إليه اعتباره.<br>3-أن يجتاز دورة تأهيلية في نظام التسجيل العيني للعقار على النحو الذي تحدده اللائحة.<br>4-أي شرط آخر تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1a25d4098f9447b7892ee35140689550\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الجهة المختصة اللائحة –بالاتفاق مع وزارة العدل- خلال (تسعين) يوماً من تاريخ نشر النظام في الجريدة الرسمية، ويعمل بها مع نفاذه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يحل النظام محل نظام التسجيل العيني للعقار الصادر بالمرسوم الملكي رقم ( م / 6 ) وتاريخ 11/ 2 / 1423هـ، ويُلغى كل ما يتعارض معه من أحكام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يعمل بالنظام بعد (تسعين) يوماً من تاريخ نشره في الجريدة الرسمية</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\",\n      \"title\": \"الفصل الثامن: رسوم التسجيل والمقابل المالي للخدمات المضافة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dd04e28aeea94a41a276d4ea396a07fe\",\n      \"title\": \"الفصل التاسع: العقوبات\",\n      \"content\": {\n        \"markup\": \"<p>.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0405884f68a7490bbb84d74f3b042946\",\n      \"title\": \"الفصل العاشر: الأحكام الختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/41afd6cd459449b5a157d8c164d0decc\",\n      \"title\": \"الفصل الأول: الأحكام العامة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5b704638459e4a72b3d96c3d1fb20439\",\n      \"title\": \"الفصل الثاني: اختصاص الجهة المختصة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\",\n      \"title\": \"الفصل الثالث: السجل العقاري\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6fd6d89056954026a99b1a1c884226ac\",\n      \"title\": \"الفصل الرابع: التسجيل العيني الأول\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\",\n      \"title\": \"الفصل الخامس: تسجيل التصرفات العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8b6bd1715d84484fb92035e624052563\",\n      \"title\": \"الفصل السادس: سجل التصرف في العقار الموصوف على الخارطة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2111fc87afb4e9a83e417a7a38826bc\",\n      \"title\": \"الفصل السابع: أعمال المساحة والفرز\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/41afd6cd459449b5a157d8c164d0decc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\"\n      },\n      {\n        \"contentUdi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5b704638459e4a72b3d96c3d1fb20439\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b353f481cedf4159b317178e95c565b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fd189eec716d497ebef259ade307e988\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6fd6d89056954026a99b1a1c884226ac\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\"\n      },\n      {\n        \"contentUdi\": \"umb://element/342fba226d1941d095e68538643ed3de\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d6c032e25ef44373874c00965e284330\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\"\n      },\n      {\n        \"contentUdi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5335c4abccd1432085427142b20f971a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b371a42c33134857bcc242df90c35a88\"\n      },\n      {\n        \"contentUdi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1366bc6855484252aa606d86d6420e02\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/84752c5033a24474bd325242a0bfa204\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8b6bd1715d84484fb92035e624052563\"\n      },\n      {\n        \"contentUdi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\"\n      },\n      {\n        \"contentUdi\": \"umb://element/13404ff744484e4bb1effaac223f115f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a2111fc87afb4e9a83e417a7a38826bc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd04e28aeea94a41a276d4ea396a07fe\"\n      },\n      {\n        \"contentUdi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0405884f68a7490bbb84d74f3b042946\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1a25d4098f9447b7892ee35140689550\"\n      },\n      {\n        \"contentUdi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>يقصد بالكلمات والعبارات الآتية -أينما وردت في هذا النظام- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\n<p><strong>النظام:</strong> نظام التسجيل العيني للعقار.</p>\\n<p><strong>الجهة المختصة:</strong> الجهة التي يصدر بتحديدها قرار من مجلس الوزراء.</p>\\n<p><strong>المسؤول الأول: </strong>المسؤول الأول، أو مجلس الإدارة، في الجهة المختصة؛ بحسب الأحوال.</p>\\n<p><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.</p>\\n<p><strong>العقار: </strong>قطعة من الأرض وما تحتها وما فوقها -ويستثنى من ذلك الثروات الطبيعية، والعلو غير المأذون بعمارته واستغلاله- وما عليها من بناء أو ملحقات ثابتة أو مزروعات أو مصانع أو منشآت أخرى كالموانئ والمطارات وخطوط الكهرباء والأنابيب وغيرها.</p>\\n<p><strong>الحق العقاري:</strong> سلطة مباشرة مقرة نظاماً لشخص -ذي صفة طبيعية أو اعتبارية- أو أكثر على عقار معين تخوله التصرف فيه أو الاستئثار بمنافعه أو ببعضها.&nbsp;</p>\\n<p><strong>السجل العقاري: </strong>مجموعة وثائق تبين أوصاف العقار وموقعه وحالته المادية والنظامية، وما يتبعه من حقوق والتزامات، والتعديلات التي تطرأ على ذلك، في ضوء الوثائق المعتبرة نظاماً.</p>\\n<p><strong>التسجيل العيني:</strong> جعل العقار محل الحق العقاري أساساً لقيد الحق.&nbsp;</p>\\n<p><strong>التسجيل العيني الأول:</strong> تسجيل العقار باسم مالكه لأول مرة في السجل العقاري، وفقاً للإجراءات الواردة في النظام واللائحة.</p>\\n<p><strong>المسجِّل العقاري:</strong> من يقوم بتوثيق التسجيل العيني الأول، وما يرد على العقار من تصرفات أو تغييرات في وصفه، وفقاً لأحكام النظام واللائحة.</p>\\n<p><strong>المنطقة العقارية:</strong> موقع أرض يحدده قرار صادر من الجهة المختصة، يكون خاضعاً لأحكام النظام واللائحة.</p>\\n<p><strong>صك تسجيل الملكية:</strong> وثيقة صادرة عن السجل العقاري لإثبات بيانات عقار مطابقة للسجل، وفقاً للنموذج الذي تحدده اللائحة، تتضمن: موقع العقار، وحدوده، ووصفه، واستعماله، وما يتبعه من حقوق والتزامات، وبيانات مالكه، وأي بيانات أخرى تحددها اللائحة.</p>\\n<p><strong>الخارطة:</strong> رسم هندسي مساحي مبني على نظام إحداثيات وطني، يبين: موقع العقار، وحدوده، ومعالمه، وأرقامه، ومساحته، وأي بيانات رقمية وتصويرية أخرى.</p>\\n<p><strong>المالك:</strong> شخص ذو صفة طبيعية أو اعتبارية يثبت السجل العقاري حق ملكية عقار له.</p>\\n<p><strong>المقابل المالي: </strong>مبلغ مستحق مقابل خدمات التسجيل العيني وفقا للنظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يسري النظام على جميع العقارات الواقعة في إقليم المملكة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b353f481cedf4159b317178e95c565b2\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>1-تختص الجهة المختصة بالتسجيل العيني، ولها الاستعانة بالجهات الحكومية أو الإسناد إلى الجهات الخاصة لأداء ما تراه من اختصاصاتها المتعلقة بذلك؛ وفقاً للشروط والضوابط التي تضعها.<br>2- تنشئ الجهة المختصة السجل العقاري وتشرف على كل ما يخصه، وتقوم بجميع الإجراءات المتعلقة به.<br>3- تضمن الجهة المختصة صحة معلومات وبيانات العقار ودقّتها، وما يتبعه من حقوق والتزامات، الواردة في السجل العقاري وما ينشأ عنه من صكوك ووثائق.<br>4-تقوم الجهة المختصة بأعمال المساحة المتعلقة بإجراءات التسجيل العيني، وفقاً للائحة والمعايير الجيومكانية الوطنية المعتمدة من جهة الاختصاص، ويمكن -دون إخلال بالأنظمة والتنظيمات ذات العلاقة- استخدام وسائل المساحة الحديثة -بما فيها التصوير الجوي والفضائي وغيرها من التقنيات- عند تنفيذ تلك الأعمال. وتحدد اللائحة إجراءات ذلك.<br>5-تملك الجهة المختصة حصرياً السجل العقاري وبياناته، ولها استثمار بيانات السجل بأنواع الاستغلال التجاري، وإتاحتها للمستفيدين بأسعار عادلة تدعم التنمية، على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون للسجل العقاري الحجية المطلقة في الإثبات وفقاً لأحكام النظام، ويعمل بمضمونه أمام القضاء والجهات كافة بلا بينة إضافية، ولا يجوز الطعن فيه إلا إذا كان الطعن بسبب خطأ كتابي أو تزوير.<br>2-يجب أن يحتوي السجل العقاري على أوصاف العقار، وجميع الحقوق العينية التي ترد عليه والالتزامات التي تتبعه، وأي تعديلات تطرأ على ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fd189eec716d497ebef259ade307e988\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>1- لا تعدل بيانات السجل العقاري ولا يجرى أي تغيير عليه، إلا وفقاً لأحكام النظام واللائحة.<br>2-تصحح الجهة المختصة الأخطاء الكتابية والمادية البحتة بناءً على طلب من أي ذي مصلحة أو من تلقاء نفسها، مع إشعار ذوي الشأن بذلك بالوسيلة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>يكون الاطلاع على بيانات السجل العقاري متاحاً للكافة، وذلك وفقا لما يحدده النظام واللائحة، ويستثنى من ذلك العقارات التي تحدد الجهات المعنية أنها سرية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>1-تحدد المنطقة العقارية بقرار يصدر عن الجهة المختصة، على أن يتضمن القرار تحديداً دقيقاً وبمعالم واضحة للمنطقة والمدة المحددة لاستقبال طلبات التسجيل العيني الأول، ويعلن عنها بأي وسيلة مناسبة يحددها القرار.<br>2-تختص الجهة المختصة بالتسجيل العيني الأول لكل عقار واقع في المنطقة العقارية وتسجيل أي تصرفات لاحقة ترد عليه.&nbsp;<br>3-توثق التصرفات العقارية التي تقع على العقار الواقع في المنطقة العقارية، والتي تجري خلال فترة إجراءات التسجيل العيني الأول، وفقاً للإجراءات التي تحددها اللائحة.&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/342fba226d1941d095e68538643ed3de\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>1-يشترط للتسجيل العيني الأول الآتي:<br>أ- أن يكون للعقار -ما عدا العقارات المملوكة للدولة- صك ملكية مستوفٍ للمتطلبات النظامية.</p>\\n<p>ب- أن يكون العقار مكتمل البيانات الجيومكانية.</p>\\n<p>وتحدد اللائحة إجراءات التسجيل العيني الأول.</p>\\n<p>2-على كل من تطلب منه الجهة المختصة، الإفصاح عن أي مستندات أو بيانات لازمة لصحة وسلامة التسجيل العيني الأول.<br>3تجري الجهة المختصة الأعمال المساحية اللازمة للتسجيل العيني الأول، ولها -دون أن تجري تلك الأعمال- استخدام البيانات المتعلقة بالأعمال المساحية المعتمدة من جهة الاختصاص في حال توفرها وفق ما تحدده اللائحة.<br>4-يصدر صك تسجيل الملكية للعقار بعد استكمال الإجراءات اللازمة، وفقاً لأحكام النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1-تعد الجهة المختصة قوائم للملاك بناء على صكوك تسجيل الملكية الصادرة بناء على أحكام النظام، على أن تشمل تلك القوائم بيانات الصكوك التي تحددها اللائحة.<br>2-تنشر الجهة المختصة قوائم الملاك -المشار إليها في الفقرة (1) من هذه المادة- بالوسائل المناسبة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6c032e25ef44373874c00965e284330\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>لكل ذي مصلحة الاعتراض على التسجيل العيني الأول أمام المحكمة المختصة ما لم يكتسب التسجيل الحجية المطلقة وفقاً لأحكام النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1-في حال قيد دعوى قضائية تتعلق بالتسجيل العيني الأول وفق ما أشير إليه في المادة (العاشرة) من النظام، فيتم التأشير بها في السجل العقاري وقوائم الملاك، ويضمن في السجل مضمون الحكم النهائي الصادر في شأن الدعوى.<br>وتحدد اللائحة إجراءات وأحكام التأشير في السجل العقاري، وفي قوائم الملاك.</p>\\n<p>2-يكتسب التسجيل العيني الأول الحجية المطلقة بعد انقضاء سنة من تاريخ نشر قوائم الملاك، وللمتضرر من التسجيل العيني الأول بعد اكتسابه الحجية المطلقة حق اللجوء إلى المحكمة المختصة وطلب التعويض من المتسبب دون الحق في طلب إلغاء التسجيل العيني الأول أو تعديل بياناته أو الحقوق الواردة فيه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; mso-outline-level: 3; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">لملاك العقارات طلب تسجيل عقاراتهم -الواقعة خارج نطاق المنطقة العقارية- في السجل العقاري وفقاً للشروط والضوابط التي تحددها اللائحة.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تسجل في السجل العقاري جميع التصرفات اللاحقة للتسجيل العيني الأول للعقار، والتي من شأنها إنشاء أي من الحقوق العينية الأصلية أو التبعية أو نقله أو تغييره أو زواله، أو تعديل بيانات العقار، وكذلك الأحكام النهائية المثبتة لشيء من ذلك، ولا تكون تلك الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل. ويدخل في تلك التصرفات القسمة العقارية والوصية والوقف والإرث والرهن والمنح ونحوها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بجميع عقود الإيجار والالتزامات الموثقة نظاماً التي ترد على منفعة العقار إذا كانت مدتها (عشر) سنوات فأكثر، والأحكام النهائية المثبتة لشيء من ذلك، في السجل العقاري، ولا تكون هذه الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التأشير.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تقوم الجهات المعنية -وفق آلية تتفق عليها الجهة المختصة مع كل منها- بتزويد السجل العقاري بوقائع وفاة ملاك العقارات وصكوك حصر ورثتهم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بالدعاوى المتعلقة بحق عيني عقاري أو بتصرف من التصرفات الواجب تسجيلها، في السجل العقاري، متى تضمنت هذه الدعاوى إجراء تغيير في بيانات السجل، ولا تُسمع الدعوى إلا بعد تقديم ما يثبت حصول التأشير بمضمون الدعوى في السجل.</p>\\n<p>ولكل ذي مصلحة أن يقدم طلباً إلى المحكمة المختصة بصفة مستعجلة لمحو التأشير المشار إليه أعلاه، وتأمر المحكمة بمحوه متى تبين لها أن الدعوى التي تم التأشير بها كيدية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يترتب على التأشير بالدعاوى -المشار إليها في المادة (السادسة عشرة) من النظام- أن يكون أي حق تقرر بحكم نهائي في هذه الدعاوى حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بإعلان الرغبة في الأخذ بالشفعة في السجل العقاري، ويترتب على ذلك أن يكون حق الشفيع إذا تقرر بحكم نهائي حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تحدد اللائحة آليات تسجيل الأحكام المشار إليها في المادتين (السابعة عشرة) و(الثامنة عشرة) من النظام في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5335c4abccd1432085427142b20f971a\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>1-يقدم ذو الشأن طلب التسجيل أو التأشير في السجل العقاري إلى الجهة المختصة، ويرفق بالطلب المستندات المؤيدة له التي تحددها اللائحة، وعلى الجهة المختصة تدوين الطلب وفقًا لتاريخ تقديمه وساعته على النحو الذي تحدده اللائحة، ويعد طلب التسجيل كأن لم يكن إذا لم يقدم ذو الشأن تلك المستندات خلال (ثلاثين) يوماً من تاريخ تقديم الطلب، ولا يجوز إجراء أي تسجيل إذا تضمن السجل العقاري قيوداً تمنع التصرف في العقار.<br>2-مع مراعاة ما ورد في الفقرة (1) من هذه المادة، إذا قدم إلى الجهة المختصة أكثر من طلب لتسجيل التصرفات أو التأشير بها في شأن العقار ذاته؛ وجب بحثها وفقًا لأسبقية تسجيل الطلب، وذلك على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b371a42c33134857bcc242df90c35a88\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لمن أُبلغ برفض طلبه بالتسجيل أو التأشير في السجل العقاري، أو بسقوط أسبقيته، أو بوقف الإجراءات؛ أن يتظلم أمام الجهة المختصة خلال (ثلاثين) يوماً من تاريخ الإبلاغ، وعليها البت في التظلم خلال (ثلاثين) يوماً من تقديمه، فإذا قبلت تظلمه أمرت بالتسجيل أو التأشير. أما إن رفضته أو لم تتخذ قرارًا في شأنه خلال تلك المدة، فلمقدمه التظلم أمام المحكمة المختصة خلال (ثلاثين) يوماً من تاريخ إبلاغه برفض تظلمه أمام الجهة المختصة أو من تاريخ انتهاء المدة المحددة لاتخاذ القرار بشأن التظلم دون اتخاذه، أيهما أسبق، ويوقف النظر في الطلبات اللاحقة إلى حين الفصل في التظلم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة ما تضمنته المادة (العشرون) من النظام، يسجل مضمون المحررات الموثقة نظاماً الواردة من الجهات المعنية في السجل العقاري طبقاً لترتيب ورودها إلى الجهة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1366bc6855484252aa606d86d6420e02\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على الجهات المعنية بإصدار رخص متعلقة بالعقارات واستعمالاتها إشعار الجهة المختصة بالرخص التي تصدرها أو تلغيها للعقارات الواقعة في المنطقة العقارية؛ للتأشير بها في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجب على مالك العقار إبلاغ الجهة المختصة بأي تغيير يطرأ على وصف العقار بسبب إنشاء مبانٍ أو إضافتها أو تعديلها أو إزالتها، خلال (تسعين) يومًا من تاريخ حدوث التغيير، وتتخذ الجهة المختصة الإجراءات اللازمة لتحديث بيانات السجل العقاري بما يتوافق مع ذلك على النحو الذي تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>للجهة المختصة -من تلقاء نفسها- أن تتخذ الإجراءات اللازمة لتحديث بيانات السجل العقاري بإضافة أي تغيير مرخص به على عقار قائم على الطبيعة غير مثبت في السجل. وتقوم الجهة المختصة بإشعار ذوي الشأن بهذا التحديث.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>للمتضرر من تسجيل التصرفات العقارية حق التقدم للمحكمة المختصة بطلب التعويض من المتسبب فيه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/84752c5033a24474bd325242a0bfa204\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لصاحب حق الانتفاع على العقار تسجيل التصرف فيه في السجل العقاري دون إذن مالك العقار، ما لم يُتفق على غير ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون لكل وحدة عقارية مفرزة واقعة في عقار مشترك، صك تسجيل ملكية خاص بها.<br>2-يجب تسجيل وثائق الملكية المشتركة التي تحددها اللائحة في السجل العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنشئ الجهة المختصة سجلاً للعقارات الموصوفة على الخارطة مرتبطاً بالسجل العقاري، وتحدد اللائحة إجراءات ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُسجل جميع التصرفات التي ترد على العقارات الموصوفة على الخارطة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام، وتحدد اللائحة إجراءات التسجيل، ويُصدر السجل شهادة بذلك، ولا تكون هذه التصرفات نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/13404ff744484e4bb1effaac223f115f\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-على مالك العقار خلال (ثلاثين) يوماً من اكتمال إنجاز العقار الموصوف على الخارطة تقديم طلب لتحويل بياناته الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.<br>2-يجوز -بناء على قرار صادر من الجهة المعنية بإصدار ترخيص التصرف في العقار الموصوف على الخارطة- اتخاذ الإجراءات اللازمة لتحويل بيانات العقار الموصوف على الخارطة الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط فيمن يمارس الأعمال المساحية المتعلقة بالتسجيل العيني أن يكون مرخصاً من الجهة ذات الاختصاص، ومقيداً في سجل تعده الجهة المختصة لهذا الغرض. وتحدد اللائحة الإجراءات والشروط اللازمة للقيد في هذا السجل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون فرز العقار أو دمجه في السجل العقاري بعد موافقة الجهة المعنية بالفرز أو الدمج، ووفقاً للإجراءات التي تحددها اللائحة.<br>2-إذا تم فرز العقار المحمل بحق عقاري إلى عقارين أو أكثر، يعد كل عقار جديد محملاً بذلك الحق كاملاً، ما لم يتفق ذوو الشأن على غير ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بمجانية إجراءات التسجيل العيني الأول، وما تضمنته الفقرة (5) من المادة (الثالثة) من النظام، يُحصل مقابل مالي لخدمات التسجيل العيني وفقاً لجدول تعده الجهة المختصة لهذا الغرض يعتمد بقرار من مجلس الوزراء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأي عقوبة أشد ينص عليها أي نظام آخر، يعاقب بغرامة لا تتجاوز مائة ألف ريال كل من:</p>\\n<p>1-امتنع عن الإفصاح -المشار إليه في الفقرة (2) من المادة (الثامنة)- عن أي مستندات أو بيانات لازمة لصحة وسلامة إجراءات التسجيل العيني الأول.<br>2-عاق عمل الجهة المختصة المتعلق بإجراءات التسجيل العيني.<br>3-تخلف عن الإبلاغ المشار إليه في المادة (الرابعة والعشرين) من النظام.<br>4-تخلف عن تقديم الطلب المشار إليه في الفقرة (1) من المادة (الحادية والثلاثين) من النظام خلال المدة المحددة في الفقرة.<br>5-تخلف عن تقديم طلب التسجيل العيني الأول لعقاره خلال المدة المحددة لتقديم الطلبات المشار إليها في الفقرة (1) من المادة (السابعة) من النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-تُشكّل بقرار من المسؤول الأول لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة، يكون أحدهم حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-تختص اللجنة بالنظر في المخالفات وإيقاع العقوبة المنصوص عليها في المادة (الخامسة والثلاثين) من النظام.<br>3-تحدد قواعد وإجراءات عمل اللجنة ومكافآت أعضائها بقرار من المسؤول الأول.<br>4-يجوز الاعتراض على قرارات اللجنة أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ العلم بها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المسجل العقاري الآتي:</p>\\n<p>1-أن يكون حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-ألا يكون سبق أن حُكم عليه بجريمة مخلة بالشرف والأمانة ولو رد إليه اعتباره.<br>3-أن يجتاز دورة تأهيلية في نظام التسجيل العيني للعقار على النحو الذي تحدده اللائحة.<br>4-أي شرط آخر تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1a25d4098f9447b7892ee35140689550\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الجهة المختصة اللائحة –بالاتفاق مع وزارة العدل- خلال (تسعين) يوماً من تاريخ نشر النظام في الجريدة الرسمية، ويعمل بها مع نفاذه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يحل النظام محل نظام التسجيل العيني للعقار الصادر بالمرسوم الملكي رقم ( م / 6 ) وتاريخ 11/ 2 / 1423هـ، ويُلغى كل ما يتعارض معه من أحكام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يعمل بالنظام بعد (تسعين) يوماً من تاريخ نشره في الجريدة الرسمية</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\",\n      \"title\": \"الفصل الثامن: رسوم التسجيل والمقابل المالي للخدمات المضافة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dd04e28aeea94a41a276d4ea396a07fe\",\n      \"title\": \"الفصل التاسع: العقوبات\",\n      \"content\": {\n        \"markup\": \"<p>.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0405884f68a7490bbb84d74f3b042946\",\n      \"title\": \"الفصل العاشر: الأحكام الختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/41afd6cd459449b5a157d8c164d0decc\",\n      \"title\": \"الفصل الأول: الأحكام العامة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5b704638459e4a72b3d96c3d1fb20439\",\n      \"title\": \"الفصل الثاني: اختصاص الجهة المختصة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\",\n      \"title\": \"الفصل الثالث: السجل العقاري\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6fd6d89056954026a99b1a1c884226ac\",\n      \"title\": \"الفصل الرابع: التسجيل العيني الأول\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\",\n      \"title\": \"الفصل الخامس: تسجيل التصرفات العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8b6bd1715d84484fb92035e624052563\",\n      \"title\": \"الفصل السادس: سجل التصرف في العقار الموصوف على الخارطة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2111fc87afb4e9a83e417a7a38826bc\",\n      \"title\": \"الفصل السابع: أعمال المساحة والفرز\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - contentItems (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/41afd6cd459449b5a157d8c164d0decc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\"\n      },\n      {\n        \"contentUdi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5b704638459e4a72b3d96c3d1fb20439\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b353f481cedf4159b317178e95c565b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fd189eec716d497ebef259ade307e988\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6fd6d89056954026a99b1a1c884226ac\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\"\n      },\n      {\n        \"contentUdi\": \"umb://element/342fba226d1941d095e68538643ed3de\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d6c032e25ef44373874c00965e284330\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\"\n      },\n      {\n        \"contentUdi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5335c4abccd1432085427142b20f971a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b371a42c33134857bcc242df90c35a88\"\n      },\n      {\n        \"contentUdi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1366bc6855484252aa606d86d6420e02\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/84752c5033a24474bd325242a0bfa204\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8b6bd1715d84484fb92035e624052563\"\n      },\n      {\n        \"contentUdi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\"\n      },\n      {\n        \"contentUdi\": \"umb://element/13404ff744484e4bb1effaac223f115f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a2111fc87afb4e9a83e417a7a38826bc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dd04e28aeea94a41a276d4ea396a07fe\"\n      },\n      {\n        \"contentUdi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0405884f68a7490bbb84d74f3b042946\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1a25d4098f9447b7892ee35140689550\"\n      },\n      {\n        \"contentUdi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>يقصد بالكلمات والعبارات الآتية -أينما وردت في هذا النظام- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\n<p><strong>النظام:</strong> نظام التسجيل العيني للعقار.</p>\\n<p><strong>الجهة المختصة:</strong> الجهة التي يصدر بتحديدها قرار من مجلس الوزراء.</p>\\n<p><strong>المسؤول الأول: </strong>المسؤول الأول، أو مجلس الإدارة، في الجهة المختصة؛ بحسب الأحوال.</p>\\n<p><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.</p>\\n<p><strong>العقار: </strong>قطعة من الأرض وما تحتها وما فوقها -ويستثنى من ذلك الثروات الطبيعية، والعلو غير المأذون بعمارته واستغلاله- وما عليها من بناء أو ملحقات ثابتة أو مزروعات أو مصانع أو منشآت أخرى كالموانئ والمطارات وخطوط الكهرباء والأنابيب وغيرها.</p>\\n<p><strong>الحق العقاري:</strong> سلطة مباشرة مقرة نظاماً لشخص -ذي صفة طبيعية أو اعتبارية- أو أكثر على عقار معين تخوله التصرف فيه أو الاستئثار بمنافعه أو ببعضها.&nbsp;</p>\\n<p><strong>السجل العقاري: </strong>مجموعة وثائق تبين أوصاف العقار وموقعه وحالته المادية والنظامية، وما يتبعه من حقوق والتزامات، والتعديلات التي تطرأ على ذلك، في ضوء الوثائق المعتبرة نظاماً.</p>\\n<p><strong>التسجيل العيني:</strong> جعل العقار محل الحق العقاري أساساً لقيد الحق.&nbsp;</p>\\n<p><strong>التسجيل العيني الأول:</strong> تسجيل العقار باسم مالكه لأول مرة في السجل العقاري، وفقاً للإجراءات الواردة في النظام واللائحة.</p>\\n<p><strong>المسجِّل العقاري:</strong> من يقوم بتوثيق التسجيل العيني الأول، وما يرد على العقار من تصرفات أو تغييرات في وصفه، وفقاً لأحكام النظام واللائحة.</p>\\n<p><strong>المنطقة العقارية:</strong> موقع أرض يحدده قرار صادر من الجهة المختصة، يكون خاضعاً لأحكام النظام واللائحة.</p>\\n<p><strong>صك تسجيل الملكية:</strong> وثيقة صادرة عن السجل العقاري لإثبات بيانات عقار مطابقة للسجل، وفقاً للنموذج الذي تحدده اللائحة، تتضمن: موقع العقار، وحدوده، ووصفه، واستعماله، وما يتبعه من حقوق والتزامات، وبيانات مالكه، وأي بيانات أخرى تحددها اللائحة.</p>\\n<p><strong>الخارطة:</strong> رسم هندسي مساحي مبني على نظام إحداثيات وطني، يبين: موقع العقار، وحدوده، ومعالمه، وأرقامه، ومساحته، وأي بيانات رقمية وتصويرية أخرى.</p>\\n<p><strong>المالك:</strong> شخص ذو صفة طبيعية أو اعتبارية يثبت السجل العقاري حق ملكية عقار له.</p>\\n<p><strong>المقابل المالي: </strong>مبلغ مستحق مقابل خدمات التسجيل العيني وفقا للنظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يسري النظام على جميع العقارات الواقعة في إقليم المملكة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b353f481cedf4159b317178e95c565b2\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>1-تختص الجهة المختصة بالتسجيل العيني، ولها الاستعانة بالجهات الحكومية أو الإسناد إلى الجهات الخاصة لأداء ما تراه من اختصاصاتها المتعلقة بذلك؛ وفقاً للشروط والضوابط التي تضعها.<br>2- تنشئ الجهة المختصة السجل العقاري وتشرف على كل ما يخصه، وتقوم بجميع الإجراءات المتعلقة به.<br>3- تضمن الجهة المختصة صحة معلومات وبيانات العقار ودقّتها، وما يتبعه من حقوق والتزامات، الواردة في السجل العقاري وما ينشأ عنه من صكوك ووثائق.<br>4-تقوم الجهة المختصة بأعمال المساحة المتعلقة بإجراءات التسجيل العيني، وفقاً للائحة والمعايير الجيومكانية الوطنية المعتمدة من جهة الاختصاص، ويمكن -دون إخلال بالأنظمة والتنظيمات ذات العلاقة- استخدام وسائل المساحة الحديثة -بما فيها التصوير الجوي والفضائي وغيرها من التقنيات- عند تنفيذ تلك الأعمال. وتحدد اللائحة إجراءات ذلك.<br>5-تملك الجهة المختصة حصرياً السجل العقاري وبياناته، ولها استثمار بيانات السجل بأنواع الاستغلال التجاري، وإتاحتها للمستفيدين بأسعار عادلة تدعم التنمية، على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون للسجل العقاري الحجية المطلقة في الإثبات وفقاً لأحكام النظام، ويعمل بمضمونه أمام القضاء والجهات كافة بلا بينة إضافية، ولا يجوز الطعن فيه إلا إذا كان الطعن بسبب خطأ كتابي أو تزوير.<br>2-يجب أن يحتوي السجل العقاري على أوصاف العقار، وجميع الحقوق العينية التي ترد عليه والالتزامات التي تتبعه، وأي تعديلات تطرأ على ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fd189eec716d497ebef259ade307e988\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>1- لا تعدل بيانات السجل العقاري ولا يجرى أي تغيير عليه، إلا وفقاً لأحكام النظام واللائحة.<br>2-تصحح الجهة المختصة الأخطاء الكتابية والمادية البحتة بناءً على طلب من أي ذي مصلحة أو من تلقاء نفسها، مع إشعار ذوي الشأن بذلك بالوسيلة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>يكون الاطلاع على بيانات السجل العقاري متاحاً للكافة، وذلك وفقا لما يحدده النظام واللائحة، ويستثنى من ذلك العقارات التي تحدد الجهات المعنية أنها سرية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>1-تحدد المنطقة العقارية بقرار يصدر عن الجهة المختصة، على أن يتضمن القرار تحديداً دقيقاً وبمعالم واضحة للمنطقة والمدة المحددة لاستقبال طلبات التسجيل العيني الأول، ويعلن عنها بأي وسيلة مناسبة يحددها القرار.<br>2-تختص الجهة المختصة بالتسجيل العيني الأول لكل عقار واقع في المنطقة العقارية وتسجيل أي تصرفات لاحقة ترد عليه.&nbsp;<br>3-توثق التصرفات العقارية التي تقع على العقار الواقع في المنطقة العقارية، والتي تجري خلال فترة إجراءات التسجيل العيني الأول، وفقاً للإجراءات التي تحددها اللائحة.&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/342fba226d1941d095e68538643ed3de\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>1-يشترط للتسجيل العيني الأول الآتي:<br>أ- أن يكون للعقار -ما عدا العقارات المملوكة للدولة- صك ملكية مستوفٍ للمتطلبات النظامية.</p>\\n<p>ب- أن يكون العقار مكتمل البيانات الجيومكانية.</p>\\n<p>وتحدد اللائحة إجراءات التسجيل العيني الأول.</p>\\n<p>2-على كل من تطلب منه الجهة المختصة، الإفصاح عن أي مستندات أو بيانات لازمة لصحة وسلامة التسجيل العيني الأول.<br>3تجري الجهة المختصة الأعمال المساحية اللازمة للتسجيل العيني الأول، ولها -دون أن تجري تلك الأعمال- استخدام البيانات المتعلقة بالأعمال المساحية المعتمدة من جهة الاختصاص في حال توفرها وفق ما تحدده اللائحة.<br>4-يصدر صك تسجيل الملكية للعقار بعد استكمال الإجراءات اللازمة، وفقاً لأحكام النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1-تعد الجهة المختصة قوائم للملاك بناء على صكوك تسجيل الملكية الصادرة بناء على أحكام النظام، على أن تشمل تلك القوائم بيانات الصكوك التي تحددها اللائحة.<br>2-تنشر الجهة المختصة قوائم الملاك -المشار إليها في الفقرة (1) من هذه المادة- بالوسائل المناسبة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6c032e25ef44373874c00965e284330\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>لكل ذي مصلحة الاعتراض على التسجيل العيني الأول أمام المحكمة المختصة ما لم يكتسب التسجيل الحجية المطلقة وفقاً لأحكام النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1-في حال قيد دعوى قضائية تتعلق بالتسجيل العيني الأول وفق ما أشير إليه في المادة (العاشرة) من النظام، فيتم التأشير بها في السجل العقاري وقوائم الملاك، ويضمن في السجل مضمون الحكم النهائي الصادر في شأن الدعوى.<br>وتحدد اللائحة إجراءات وأحكام التأشير في السجل العقاري، وفي قوائم الملاك.</p>\\n<p>2-يكتسب التسجيل العيني الأول الحجية المطلقة بعد انقضاء سنة من تاريخ نشر قوائم الملاك، وللمتضرر من التسجيل العيني الأول بعد اكتسابه الحجية المطلقة حق اللجوء إلى المحكمة المختصة وطلب التعويض من المتسبب دون الحق في طلب إلغاء التسجيل العيني الأول أو تعديل بياناته أو الحقوق الواردة فيه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; mso-outline-level: 3; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\" lang=\\\"AR-SA\\\">لملاك العقارات طلب تسجيل عقاراتهم -الواقعة خارج نطاق المنطقة العقارية- في السجل العقاري وفقاً للشروط والضوابط التي تحددها اللائحة.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تسجل في السجل العقاري جميع التصرفات اللاحقة للتسجيل العيني الأول للعقار، والتي من شأنها إنشاء أي من الحقوق العينية الأصلية أو التبعية أو نقله أو تغييره أو زواله، أو تعديل بيانات العقار، وكذلك الأحكام النهائية المثبتة لشيء من ذلك، ولا تكون تلك الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل. ويدخل في تلك التصرفات القسمة العقارية والوصية والوقف والإرث والرهن والمنح ونحوها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بجميع عقود الإيجار والالتزامات الموثقة نظاماً التي ترد على منفعة العقار إذا كانت مدتها (عشر) سنوات فأكثر، والأحكام النهائية المثبتة لشيء من ذلك، في السجل العقاري، ولا تكون هذه الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التأشير.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تقوم الجهات المعنية -وفق آلية تتفق عليها الجهة المختصة مع كل منها- بتزويد السجل العقاري بوقائع وفاة ملاك العقارات وصكوك حصر ورثتهم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بالدعاوى المتعلقة بحق عيني عقاري أو بتصرف من التصرفات الواجب تسجيلها، في السجل العقاري، متى تضمنت هذه الدعاوى إجراء تغيير في بيانات السجل، ولا تُسمع الدعوى إلا بعد تقديم ما يثبت حصول التأشير بمضمون الدعوى في السجل.</p>\\n<p>ولكل ذي مصلحة أن يقدم طلباً إلى المحكمة المختصة بصفة مستعجلة لمحو التأشير المشار إليه أعلاه، وتأمر المحكمة بمحوه متى تبين لها أن الدعوى التي تم التأشير بها كيدية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يترتب على التأشير بالدعاوى -المشار إليها في المادة (السادسة عشرة) من النظام- أن يكون أي حق تقرر بحكم نهائي في هذه الدعاوى حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب التأشير بإعلان الرغبة في الأخذ بالشفعة في السجل العقاري، ويترتب على ذلك أن يكون حق الشفيع إذا تقرر بحكم نهائي حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تحدد اللائحة آليات تسجيل الأحكام المشار إليها في المادتين (السابعة عشرة) و(الثامنة عشرة) من النظام في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5335c4abccd1432085427142b20f971a\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>1-يقدم ذو الشأن طلب التسجيل أو التأشير في السجل العقاري إلى الجهة المختصة، ويرفق بالطلب المستندات المؤيدة له التي تحددها اللائحة، وعلى الجهة المختصة تدوين الطلب وفقًا لتاريخ تقديمه وساعته على النحو الذي تحدده اللائحة، ويعد طلب التسجيل كأن لم يكن إذا لم يقدم ذو الشأن تلك المستندات خلال (ثلاثين) يوماً من تاريخ تقديم الطلب، ولا يجوز إجراء أي تسجيل إذا تضمن السجل العقاري قيوداً تمنع التصرف في العقار.<br>2-مع مراعاة ما ورد في الفقرة (1) من هذه المادة، إذا قدم إلى الجهة المختصة أكثر من طلب لتسجيل التصرفات أو التأشير بها في شأن العقار ذاته؛ وجب بحثها وفقًا لأسبقية تسجيل الطلب، وذلك على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b371a42c33134857bcc242df90c35a88\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لمن أُبلغ برفض طلبه بالتسجيل أو التأشير في السجل العقاري، أو بسقوط أسبقيته، أو بوقف الإجراءات؛ أن يتظلم أمام الجهة المختصة خلال (ثلاثين) يوماً من تاريخ الإبلاغ، وعليها البت في التظلم خلال (ثلاثين) يوماً من تقديمه، فإذا قبلت تظلمه أمرت بالتسجيل أو التأشير. أما إن رفضته أو لم تتخذ قرارًا في شأنه خلال تلك المدة، فلمقدمه التظلم أمام المحكمة المختصة خلال (ثلاثين) يوماً من تاريخ إبلاغه برفض تظلمه أمام الجهة المختصة أو من تاريخ انتهاء المدة المحددة لاتخاذ القرار بشأن التظلم دون اتخاذه، أيهما أسبق، ويوقف النظر في الطلبات اللاحقة إلى حين الفصل في التظلم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة ما تضمنته المادة (العشرون) من النظام، يسجل مضمون المحررات الموثقة نظاماً الواردة من الجهات المعنية في السجل العقاري طبقاً لترتيب ورودها إلى الجهة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1366bc6855484252aa606d86d6420e02\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على الجهات المعنية بإصدار رخص متعلقة بالعقارات واستعمالاتها إشعار الجهة المختصة بالرخص التي تصدرها أو تلغيها للعقارات الواقعة في المنطقة العقارية؛ للتأشير بها في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجب على مالك العقار إبلاغ الجهة المختصة بأي تغيير يطرأ على وصف العقار بسبب إنشاء مبانٍ أو إضافتها أو تعديلها أو إزالتها، خلال (تسعين) يومًا من تاريخ حدوث التغيير، وتتخذ الجهة المختصة الإجراءات اللازمة لتحديث بيانات السجل العقاري بما يتوافق مع ذلك على النحو الذي تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>للجهة المختصة -من تلقاء نفسها- أن تتخذ الإجراءات اللازمة لتحديث بيانات السجل العقاري بإضافة أي تغيير مرخص به على عقار قائم على الطبيعة غير مثبت في السجل. وتقوم الجهة المختصة بإشعار ذوي الشأن بهذا التحديث.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>للمتضرر من تسجيل التصرفات العقارية حق التقدم للمحكمة المختصة بطلب التعويض من المتسبب فيه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/84752c5033a24474bd325242a0bfa204\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لصاحب حق الانتفاع على العقار تسجيل التصرف فيه في السجل العقاري دون إذن مالك العقار، ما لم يُتفق على غير ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون لكل وحدة عقارية مفرزة واقعة في عقار مشترك، صك تسجيل ملكية خاص بها.<br>2-يجب تسجيل وثائق الملكية المشتركة التي تحددها اللائحة في السجل العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنشئ الجهة المختصة سجلاً للعقارات الموصوفة على الخارطة مرتبطاً بالسجل العقاري، وتحدد اللائحة إجراءات ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُسجل جميع التصرفات التي ترد على العقارات الموصوفة على الخارطة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام، وتحدد اللائحة إجراءات التسجيل، ويُصدر السجل شهادة بذلك، ولا تكون هذه التصرفات نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/13404ff744484e4bb1effaac223f115f\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-على مالك العقار خلال (ثلاثين) يوماً من اكتمال إنجاز العقار الموصوف على الخارطة تقديم طلب لتحويل بياناته الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.<br>2-يجوز -بناء على قرار صادر من الجهة المعنية بإصدار ترخيص التصرف في العقار الموصوف على الخارطة- اتخاذ الإجراءات اللازمة لتحويل بيانات العقار الموصوف على الخارطة الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط فيمن يمارس الأعمال المساحية المتعلقة بالتسجيل العيني أن يكون مرخصاً من الجهة ذات الاختصاص، ومقيداً في سجل تعده الجهة المختصة لهذا الغرض. وتحدد اللائحة الإجراءات والشروط اللازمة للقيد في هذا السجل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-يكون فرز العقار أو دمجه في السجل العقاري بعد موافقة الجهة المعنية بالفرز أو الدمج، ووفقاً للإجراءات التي تحددها اللائحة.<br>2-إذا تم فرز العقار المحمل بحق عقاري إلى عقارين أو أكثر، يعد كل عقار جديد محملاً بذلك الحق كاملاً، ما لم يتفق ذوو الشأن على غير ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بمجانية إجراءات التسجيل العيني الأول، وما تضمنته الفقرة (5) من المادة (الثالثة) من النظام، يُحصل مقابل مالي لخدمات التسجيل العيني وفقاً لجدول تعده الجهة المختصة لهذا الغرض يعتمد بقرار من مجلس الوزراء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأي عقوبة أشد ينص عليها أي نظام آخر، يعاقب بغرامة لا تتجاوز مائة ألف ريال كل من:</p>\\n<p>1-امتنع عن الإفصاح -المشار إليه في الفقرة (2) من المادة (الثامنة)- عن أي مستندات أو بيانات لازمة لصحة وسلامة إجراءات التسجيل العيني الأول.<br>2-عاق عمل الجهة المختصة المتعلق بإجراءات التسجيل العيني.<br>3-تخلف عن الإبلاغ المشار إليه في المادة (الرابعة والعشرين) من النظام.<br>4-تخلف عن تقديم الطلب المشار إليه في الفقرة (1) من المادة (الحادية والثلاثين) من النظام خلال المدة المحددة في الفقرة.<br>5-تخلف عن تقديم طلب التسجيل العيني الأول لعقاره خلال المدة المحددة لتقديم الطلبات المشار إليها في الفقرة (1) من المادة (السابعة) من النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1-تُشكّل بقرار من المسؤول الأول لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة، يكون أحدهم حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-تختص اللجنة بالنظر في المخالفات وإيقاع العقوبة المنصوص عليها في المادة (الخامسة والثلاثين) من النظام.<br>3-تحدد قواعد وإجراءات عمل اللجنة ومكافآت أعضائها بقرار من المسؤول الأول.<br>4-يجوز الاعتراض على قرارات اللجنة أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ العلم بها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المسجل العقاري الآتي:</p>\\n<p>1-أن يكون حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-ألا يكون سبق أن حُكم عليه بجريمة مخلة بالشرف والأمانة ولو رد إليه اعتباره.<br>3-أن يجتاز دورة تأهيلية في نظام التسجيل العيني للعقار على النحو الذي تحدده اللائحة.<br>4-أي شرط آخر تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1a25d4098f9447b7892ee35140689550\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الجهة المختصة اللائحة –بالاتفاق مع وزارة العدل- خلال (تسعين) يوماً من تاريخ نشر النظام في الجريدة الرسمية، ويعمل بها مع نفاذه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يحل النظام محل نظام التسجيل العيني للعقار الصادر بالمرسوم الملكي رقم ( م / 6 ) وتاريخ 11/ 2 / 1423هـ، ويُلغى كل ما يتعارض معه من أحكام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يعمل بالنظام بعد (تسعين) يوماً من تاريخ نشره في الجريدة الرسمية</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\",\n      \"title\": \"الفصل الثامن: رسوم التسجيل والمقابل المالي للخدمات المضافة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dd04e28aeea94a41a276d4ea396a07fe\",\n      \"title\": \"الفصل التاسع: العقوبات\",\n      \"content\": {\n        \"markup\": \"<p>.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0405884f68a7490bbb84d74f3b042946\",\n      \"title\": \"الفصل العاشر: الأحكام الختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/41afd6cd459449b5a157d8c164d0decc\",\n      \"title\": \"الفصل الأول: الأحكام العامة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5b704638459e4a72b3d96c3d1fb20439\",\n      \"title\": \"الفصل الثاني: اختصاص الجهة المختصة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\",\n      \"title\": \"الفصل الثالث: السجل العقاري\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6fd6d89056954026a99b1a1c884226ac\",\n      \"title\": \"الفصل الرابع: التسجيل العيني الأول\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\",\n      \"title\": \"الفصل الخامس: تسجيل التصرفات العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8b6bd1715d84484fb92035e624052563\",\n      \"title\": \"الفصل السادس: سجل التصرف في العقار الموصوف على الخارطة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2111fc87afb4e9a83e417a7a38826bc\",\n      \"title\": \"الفصل السابع: أعمال المساحة والفرز\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (en-us)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\"\n      },\n      {\n        \"contentUdi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b353f481cedf4159b317178e95c565b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fd189eec716d497ebef259ade307e988\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\"\n      },\n      {\n        \"contentUdi\": \"umb://element/342fba226d1941d095e68538643ed3de\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d6c032e25ef44373874c00965e284330\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5335c4abccd1432085427142b20f971a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b371a42c33134857bcc242df90c35a88\"\n      },\n      {\n        \"contentUdi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1366bc6855484252aa606d86d6420e02\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/84752c5033a24474bd325242a0bfa204\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\"\n      },\n      {\n        \"contentUdi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\"\n      },\n      {\n        \"contentUdi\": \"umb://element/13404ff744484e4bb1effaac223f115f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\"\n      },\n      {\n        \"contentUdi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1a25d4098f9447b7892ee35140689550\"\n      },\n      {\n        \"contentUdi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يقصد بالكلمات والعبارات الآتية -أينما وردت في هذا النظام- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\n<p>النظام: نظام التسجيل العيني للعقار.</p>\\n<p>الجهة المختصة: الجهة التي يصدر بتحديدها قرار من مجلس الوزراء.</p>\\n<p>المسؤول الأول: المسؤول الأول، أو مجلس الإدارة، في الجهة المختصة؛ بحسب الأحوال.</p>\\n<p>اللائحة: اللائحة التنفيذية للنظام.</p>\\n<p>العقار: قطعة من الأرض وما تحتها وما فوقها -ويستثنى من ذلك الثروات الطبيعية، والعلو غير المأذون بعمارته واستغلاله- وما عليها من بناء أو ملحقات ثابتة أو مزروعات أو مصانع أو منشآت أخرى كالموانئ والمطارات وخطوط الكهرباء والأنابيب وغيرها.</p>\\n<p>الحق العقاري: سلطة مباشرة مقرة نظاماً لشخص -ذي صفة طبيعية أو اعتبارية- أو أكثر على عقار معين تخوله التصرف فيه أو الاستئثار بمنافعه أو ببعضها.&nbsp;</p>\\n<p>السجل العقاري: مجموعة وثائق تبين أوصاف العقار وموقعه وحالته المادية والنظامية، وما يتبعه من حقوق والتزامات، والتعديلات التي تطرأ على ذلك، في ضوء الوثائق المعتبرة نظاماً.</p>\\n<p>التسجيل العيني: جعل العقار محل الحق العقاري أساساً لقيد الحق.&nbsp;</p>\\n<p>التسجيل العيني الأول: تسجيل العقار باسم مالكه لأول مرة في السجل العقاري، وفقاً للإجراءات الواردة في النظام واللائحة.</p>\\n<p>المسجِّل العقاري: من يقوم بتوثيق التسجيل العيني الأول، وما يرد على العقار من تصرفات أو تغييرات في وصفه، وفقاً لأحكام النظام واللائحة.</p>\\n<p>المنطقة العقارية: موقع أرض يحدده قرار صادر من الجهة المختصة، يكون خاضعاً لأحكام النظام واللائحة.</p>\\n<p>صك تسجيل الملكية: وثيقة صادرة عن السجل العقاري لإثبات بيانات عقار مطابقة للسجل، وفقاً للنموذج الذي تحدده اللائحة، تتضمن: موقع العقار، وحدوده، ووصفه، واستعماله، وما يتبعه من حقوق والتزامات، وبيانات مالكه، وأي بيانات أخرى تحددها اللائحة.</p>\\n<p>الخارطة: رسم هندسي مساحي مبني على نظام إحداثيات وطني، يبين: موقع العقار، وحدوده، ومعالمه، وأرقامه، ومساحته، وأي بيانات رقمية وتصويرية أخرى.</p>\\n<p>المالك: شخص ذو صفة طبيعية أو اعتبارية يثبت السجل العقاري حق ملكية عقار له.</p>\\n<p>المقابل المالي: مبلغ مستحق مقابل خدمات التسجيل العيني وفقا للنظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/11bf4e8d99214b5785ae09cb55f733ab\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يسري النظام على جميع العقارات الواقعة في إقليم المملكة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b353f481cedf4159b317178e95c565b2\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -.5in; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .75in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">1- &nbsp; &nbsp; &nbsp; &nbsp; تختص الجهة المختصة بالتسجيل العيني، ولها الاستعانة بالجهات الحكومية أو الإسناد إلى الجهات الخاصة لأداء ما تراه من اختصاصاتها المتعلقة بذلك؛ وفقاً للشروط والضوابط التي تضعها.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; تنشئ الجهة المختصة السجل العقاري وتشرف على كل ما يخصه، وتقوم بجميع الإجراءات المتعلقة به.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; تضمن الجهة المختصة صحة معلومات وبيانات العقار ودقّتها، وما يتبعه من حقوق والتزامات، الواردة في السجل العقاري وما ينشأ عنه من صكوك ووثائق.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; تقوم الجهة المختصة بأعمال المساحة المتعلقة بإجراءات التسجيل العيني، وفقاً للائحة والمعايير الجيومكانية الوطنية المعتمدة من جهة الاختصاص، ويمكن -دون إخلال بالأنظمة والتنظيمات ذات العلاقة- استخدام وسائل المساحة الحديثة -بما فيها التصوير الجوي والفضائي وغيرها من التقنيات- عند تنفيذ تلك الأعمال. وتحدد اللائحة إجراءات ذلك.<br>5- &nbsp; &nbsp; &nbsp; &nbsp; تملك الجهة المختصة حصرياً السجل العقاري وبياناته، ولها استثمار بيانات السجل بأنواع الاستغلال التجاري، وإتاحتها للمستفيدين بأسعار عادلة تدعم التنمية، على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/dbbd47dec7a643b686723e3a5ae76b66\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; يكون للسجل العقاري الحجية المطلقة في الإثبات وفقاً لأحكام النظام، ويعمل بمضمونه أمام القضاء والجهات كافة بلا بينة إضافية، ولا يجوز الطعن فيه إلا إذا كان الطعن بسبب خطأ كتابي أو تزوير.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; يجب أن يحتوي السجل العقاري على أوصاف العقار، وجميع الحقوق العينية التي ترد عليه والالتزامات التي تتبعه، وأي تعديلات تطرأ على ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fd189eec716d497ebef259ade307e988\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; لا تعدل بيانات السجل العقاري ولا يجرى أي تغيير عليه، إلا وفقاً لأحكام النظام واللائحة.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; تصحح الجهة المختصة الأخطاء الكتابية والمادية البحتة بناءً على طلب من أي ذي مصلحة أو من تلقاء نفسها، مع إشعار ذوي الشأن بذلك بالوسيلة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e74a587eaf754f2d88fc2620a5531af5\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يكون الاطلاع على بيانات السجل العقاري متاحاً للكافة، وذلك وفقا لما يحدده النظام واللائحة، ويستثنى من ذلك العقارات التي تحدد الجهات المعنية أنها سرية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0a6278b33648411eb7b02d115f67e040\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; تحدد المنطقة العقارية بقرار يصدر عن الجهة المختصة، على أن يتضمن القرار تحديداً دقيقاً وبمعالم واضحة للمنطقة والمدة المحددة لاستقبال طلبات التسجيل العيني الأول، ويعلن عنها بأي وسيلة مناسبة يحددها القرار.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; تختص الجهة المختصة بالتسجيل العيني الأول لكل عقار واقع في المنطقة العقارية وتسجيل أي تصرفات لاحقة ترد عليه.&nbsp;<br>3- &nbsp; &nbsp; &nbsp; &nbsp; توثق التصرفات العقارية التي تقع على العقار الواقع في المنطقة العقارية، والتي تجري خلال فترة إجراءات التسجيل العيني الأول، وفقاً للإجراءات التي تحددها اللائحة.&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/342fba226d1941d095e68538643ed3de\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; يشترط للتسجيل العيني الأول الآتي:<br>أ- أن يكون للعقار -ما عدا العقارات المملوكة للدولة- صك ملكية مستوفٍ للمتطلبات النظامية.</p>\\n<p>ب- أن يكون العقار مكتمل البيانات الجيومكانية.</p>\\n<p>وتحدد اللائحة إجراءات التسجيل العيني الأول.</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; على كل من تطلب منه الجهة المختصة، الإفصاح عن أي مستندات أو بيانات لازمة لصحة وسلامة التسجيل العيني الأول.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; تجري الجهة المختصة الأعمال المساحية اللازمة للتسجيل العيني الأول، ولها -دون أن تجري تلك الأعمال- استخدام البيانات المتعلقة بالأعمال المساحية المعتمدة من جهة الاختصاص في حال توفرها وفق ما تحدده اللائحة.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; يصدر صك تسجيل الملكية للعقار بعد استكمال الإجراءات اللازمة، وفقاً لأحكام النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b931d7fa4c084b83b59da67c466b257b\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; تعد الجهة المختصة قوائم للملاك بناء على صكوك تسجيل الملكية الصادرة بناء على أحكام النظام، على أن تشمل تلك القوائم بيانات الصكوك التي تحددها اللائحة.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; تنشر الجهة المختصة قوائم الملاك -المشار إليها في الفقرة (1) من هذه المادة- بالوسائل المناسبة التي تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6c032e25ef44373874c00965e284330\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>لكل ذي مصلحة الاعتراض على التسجيل العيني الأول أمام المحكمة المختصة ما لم يكتسب التسجيل الحجية المطلقة وفقاً لأحكام النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; في حال قيد دعوى قضائية تتعلق بالتسجيل العيني الأول وفق ما أشير إليه في المادة (العاشرة) من النظام، فيتم التأشير بها في السجل العقاري وقوائم الملاك، ويضمن في السجل مضمون الحكم النهائي الصادر في شأن الدعوى.<br>وتحدد اللائحة إجراءات وأحكام التأشير في السجل العقاري، وفي قوائم الملاك.</p>\\n<p>2- &nbsp; &nbsp; &nbsp; &nbsp; يكتسب التسجيل العيني الأول الحجية المطلقة بعد انقضاء سنة من تاريخ نشر قوائم الملاك، وللمتضرر من التسجيل العيني الأول بعد اكتسابه الحجية المطلقة حق اللجوء إلى المحكمة المختصة وطلب التعويض من المتسبب دون الحق في طلب إلغاء التسجيل العيني الأول أو تعديل بياناته أو الحقوق الواردة فيه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/674a2b32805941c2b0373e34362dbb7d\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"> </p>\\n<p style=\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"font-size: 22.0pt; font-family: 'Traditional Arabic',serif; mso-font-kerning: 0pt; mso-ligatures: none;\\\" lang=\\\"AR-SA\\\">لملاك العقارات طلب تسجيل عقاراتهم -الواقعة خارج نطاق المنطقة العقارية- في السجل العقاري وفقاً للشروط والضوابط التي تحددها اللائحة</span><span style=\\\"font-size: 22.0pt; font-family: 'Traditional Arabic',serif; mso-font-kerning: 0pt; mso-ligatures: none;\\\">.</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/40406dc0b63b4099949a586a0c82a6c6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تسجل في السجل العقاري جميع التصرفات اللاحقة للتسجيل العيني الأول للعقار، والتي من شأنها إنشاء أي من الحقوق العينية الأصلية أو التبعية أو نقله أو تغييره أو زواله، أو تعديل بيانات العقار، وكذلك الأحكام النهائية المثبتة لشيء من ذلك، ولا تكون تلك الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل. ويدخل في تلك التصرفات القسمة العقارية والوصية والوقف والإرث والرهن والمنح ونحوها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cc1c02eb03f647548b12b005d8f43746\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجب التأشير بجميع عقود الإيجار والالتزامات الموثقة نظاماً التي ترد على منفعة العقار إذا كانت مدتها (عشر) سنوات فأكثر، والأحكام النهائية المثبتة لشيء من ذلك، في السجل العقاري، ولا تكون هذه الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التأشير.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e1c348807837435489a5eb1211f5ba61\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تقوم الجهات المعنية -وفق آلية تتفق عليها الجهة المختصة مع كل منها- بتزويد السجل العقاري بوقائع وفاة ملاك العقارات وصكوك حصر ورثتهم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجب التأشير بالدعاوى المتعلقة بحق عيني عقاري أو بتصرف من التصرفات الواجب تسجيلها، في السجل العقاري، متى تضمنت هذه الدعاوى إجراء تغيير في بيانات السجل، ولا تُسمع الدعوى إلا بعد تقديم ما يثبت حصول التأشير بمضمون الدعوى في السجل.</p>\\n<p>ولكل ذي مصلحة أن يقدم طلباً إلى المحكمة المختصة بصفة مستعجلة لمحو التأشير المشار إليه أعلاه، وتأمر المحكمة بمحوه متى تبين لها أن الدعوى التي تم التأشير بها كيدية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d612cfe14bf14cb7ab652defcbebdb38\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p> </p>\\n<p>يترتب على التأشير بالدعاوى -المشار إليها في المادة (السادسة عشرة) من النظام- أن يكون أي حق تقرر بحكم نهائي في هذه الدعاوى حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55057c1b63e4368ba259bd73b71e28b\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجب التأشير بإعلان الرغبة في الأخذ بالشفعة في السجل العقاري، ويترتب على ذلك أن يكون حق الشفيع إذا تقرر بحكم نهائي حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تحدد اللائحة آليات تسجيل الأحكام المشار إليها في المادتين (السابعة عشرة) و(الثامنة عشرة) من النظام في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5335c4abccd1432085427142b20f971a\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; يقدم ذو الشأن طلب التسجيل أو التأشير في السجل العقاري إلى الجهة المختصة، ويرفق بالطلب المستندات المؤيدة له التي تحددها اللائحة، وعلى الجهة المختصة تدوين الطلب وفقًا لتاريخ تقديمه وساعته على النحو الذي تحدده اللائحة، ويعد طلب التسجيل كأن لم يكن إذا لم يقدم ذو الشأن تلك المستندات خلال (ثلاثين) يوماً من تاريخ تقديم الطلب، ولا يجوز إجراء أي تسجيل إذا تضمن السجل العقاري قيوداً تمنع التصرف في العقار.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; مع مراعاة ما ورد في الفقرة (1) من هذه المادة، إذا قدم إلى الجهة المختصة أكثر من طلب لتسجيل التصرفات أو التأشير بها في شأن العقار ذاته؛ وجب بحثها وفقًا لأسبقية تسجيل الطلب، وذلك على النحو الذي تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b371a42c33134857bcc242df90c35a88\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>لمن أُبلغ برفض طلبه بالتسجيل أو التأشير في السجل العقاري، أو بسقوط أسبقيته، أو بوقف الإجراءات؛ أن يتظلم أمام الجهة المختصة خلال (ثلاثين) يوماً من تاريخ الإبلاغ، وعليها البت في التظلم خلال (ثلاثين) يوماً من تقديمه، فإذا قبلت تظلمه أمرت بالتسجيل أو التأشير. أما إن رفضته أو لم تتخذ قرارًا في شأنه خلال تلك المدة، فلمقدمه التظلم أمام المحكمة المختصة خلال (ثلاثين) يوماً من تاريخ إبلاغه برفض تظلمه أمام الجهة المختصة أو من تاريخ انتهاء المدة المحددة لاتخاذ القرار بشأن التظلم دون اتخاذه، أيهما أسبق، ويوقف النظر في الطلبات اللاحقة إلى حين الفصل في التظلم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/147331097a0e43858e1a75cdc7f7121e\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>مع مراعاة ما تضمنته المادة (العشرون) من النظام، يسجل مضمون المحررات الموثقة نظاماً الواردة من الجهات المعنية في السجل العقاري طبقاً لترتيب ورودها إلى الجهة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1366bc6855484252aa606d86d6420e02\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>على الجهات المعنية بإصدار رخص متعلقة بالعقارات واستعمالاتها إشعار الجهة المختصة بالرخص التي تصدرها أو تلغيها للعقارات الواقعة في المنطقة العقارية؛ للتأشير بها في السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجب على مالك العقار إبلاغ الجهة المختصة بأي تغيير يطرأ على وصف العقار بسبب إنشاء مبانٍ أو إضافتها أو تعديلها أو إزالتها، خلال (تسعين) يومًا من تاريخ حدوث التغيير، وتتخذ الجهة المختصة الإجراءات اللازمة لتحديث بيانات السجل العقاري بما يتوافق مع ذلك على النحو الذي تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b774c422073c4e5a8dc8b615a83522ce\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>للجهة المختصة -من تلقاء نفسها- أن تتخذ الإجراءات اللازمة لتحديث بيانات السجل العقاري بإضافة أي تغيير مرخص به على عقار قائم على الطبيعة غير مثبت في السجل. وتقوم الجهة المختصة بإشعار ذوي الشأن بهذا التحديث.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ca216527e91f48169265efcb0d9c370e\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>للمتضرر من تسجيل التصرفات العقارية حق التقدم للمحكمة المختصة بطلب التعويض من المتسبب فيه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/84752c5033a24474bd325242a0bfa204\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>لصاحب حق الانتفاع على العقار تسجيل التصرف فيه في السجل العقاري دون إذن مالك العقار، ما لم يُتفق على غير ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9883a7f483ce46358a9fa6663cdd1c55\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; يكون لكل وحدة عقارية مفرزة واقعة في عقار مشترك، صك تسجيل ملكية خاص بها.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; يجب تسجيل وثائق الملكية المشتركة التي تحددها اللائحة في السجل العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/21acca51fd7f4c8da3c05137408e4b5e\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تنشئ الجهة المختصة سجلاً للعقارات الموصوفة على الخارطة مرتبطاً بالسجل العقاري، وتحدد اللائحة إجراءات ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4e1d9e14705b424aa9d41dd63b21f843\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تُسجل جميع التصرفات التي ترد على العقارات الموصوفة على الخارطة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام، وتحدد اللائحة إجراءات التسجيل، ويُصدر السجل شهادة بذلك، ولا تكون هذه التصرفات نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/13404ff744484e4bb1effaac223f115f\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; على مالك العقار خلال (ثلاثين) يوماً من اكتمال إنجاز العقار الموصوف على الخارطة تقديم طلب لتحويل بياناته الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; يجوز -بناء على قرار صادر من الجهة المعنية بإصدار ترخيص التصرف في العقار الموصوف على الخارطة- اتخاذ الإجراءات اللازمة لتحويل بيانات العقار الموصوف على الخارطة الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7d03602ad865430c99c9918bd6fbdc56\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يشترط فيمن يمارس الأعمال المساحية المتعلقة بالتسجيل العيني أن يكون مرخصاً من الجهة ذات الاختصاص، ومقيداً في سجل تعده الجهة المختصة لهذا الغرض. وتحدد اللائحة الإجراءات والشروط اللازمة للقيد في هذا السجل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/916f04b4c1e6429cbd0a0883f719fc08\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; يكون فرز العقار أو دمجه في السجل العقاري بعد موافقة الجهة المعنية بالفرز أو الدمج، ووفقاً للإجراءات التي تحددها اللائحة.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; إذا تم فرز العقار المحمل بحق عقاري إلى عقارين أو أكثر، يعد كل عقار جديد محملاً بذلك الحق كاملاً، ما لم يتفق ذوو الشأن على غير ذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>دون إخلال بمجانية إجراءات التسجيل العيني الأول، وما تضمنته الفقرة (5) من المادة (الثالثة) من النظام، يُحصل مقابل مالي لخدمات التسجيل العيني وفقاً لجدول تعده الجهة المختصة لهذا الغرض يعتمد بقرار من مجلس الوزراء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/50f928cc58d44dca9ec37f82ac5ea034\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>دون إخلال بأي عقوبة أشد ينص عليها أي نظام آخر، يعاقب بغرامة لا تتجاوز مائة ألف ريال كل من:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; امتنع عن الإفصاح -المشار إليه في الفقرة (2) من المادة (الثامنة)- عن أي مستندات أو بيانات لازمة لصحة وسلامة إجراءات التسجيل العيني الأول.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; عاق عمل الجهة المختصة المتعلق بإجراءات التسجيل العيني.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; تخلف عن الإبلاغ المشار إليه في المادة (الرابعة والعشرين) من النظام.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; تخلف عن تقديم الطلب المشار إليه في الفقرة (1) من المادة (الحادية والثلاثين) من النظام خلال المدة المحددة في الفقرة.<br>5- &nbsp; &nbsp; &nbsp; &nbsp; تخلف عن تقديم طلب التسجيل العيني الأول لعقاره خلال المدة المحددة لتقديم الطلبات المشار إليها في الفقرة (1) من المادة (السابعة) من النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7569c1f0c6144484944ee6521cfdfa22\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; تُشكّل بقرار من المسؤول الأول لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة، يكون أحدهم حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; تختص اللجنة بالنظر في المخالفات وإيقاع العقوبة المنصوص عليها في المادة (الخامسة والثلاثين) من النظام.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; تحدد قواعد وإجراءات عمل اللجنة ومكافآت أعضائها بقرار من المسؤول الأول.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; يجوز الاعتراض على قرارات اللجنة أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ العلم بها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4ed52ae5a0a241739d21eed54d35f741\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يشترط في المسجل العقاري الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; أن يكون حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; ألا يكون سبق أن حُكم عليه بجريمة مخلة بالشرف والأمانة ولو رد إليه اعتباره.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; أن يجتاز دورة تأهيلية في نظام التسجيل العيني للعقار على النحو الذي تحدده اللائحة.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; أي شرط آخر تحدده اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1a25d4098f9447b7892ee35140689550\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>تصدر الجهة المختصة اللائحة –بالاتفاق مع وزارة العدل- خلال (تسعين) يوماً من تاريخ نشر النظام في الجريدة الرسمية، ويعمل بها مع نفاذه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يحل النظام محل نظام التسجيل العيني للعقار الصادر بالمرسوم الملكي رقم ( م / 6 ) وتاريخ 11/ 2 / 1423هـ، ويُلغى كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b2e332fab7644d97a4838a65e92697b9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يعمل بالنظام بعد (تسعين) يوماً من تاريخ نشره في الجريدة الرسمية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - description","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام التسجيل العيني للعقار","change":"Update"},{"success":true,"name":"Property - header (ar-jo)","path":"/Properties/*/Value","oldValue":"نظام التسجيل العيني للعقار","newValue":"","change":"Delete"},{"success":true,"name":"Property - header (en-us)","path":"/Properties/*/Value","oldValue":"نظام التسجيل العيني للعقار","newValue":"","change":"Delete"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"نظام التسجيل العيني للعقار\",\n  \"التسجيل العيني\",\n  \"للعقار\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"الانظمة\",\n  \"نظام\"\n]","change":"Update"},{"success":true,"name":"Property - legislationDocuments (ar-jo)","path":"/Properties/*/Value","oldValue":"[]","newValue":"","change":"Delete"},{"success":true,"name":"Property - pageName","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام التسجيل العيني للعقار","change":"Update"},{"success":true,"name":"Property - publishDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2022-05-13T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - publishDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2022-04-20T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (en-us)","path":"/Properties/*/Value","oldValue":"2022-04-24T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"ساري\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Active\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"أنظمة\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Laws\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - subContent","path":"/Properties/*/Value","oldValue":"جعل العقار محل الحق العقاري أساساً لقيد الحق","newValue":"(Blank)","change":"Update"},{"success":true,"name":"Property - subContent (ar-jo)","path":"/Properties/*/Value","oldValue":"جعل العقار محل الحق العقاري أساساً لقيد الحق","newValue":"","change":"Delete"},{"success":true,"name":"Property - subContent (en-us)","path":"/Properties/*/Value","oldValue":"جعل العقار محل الحق العقاري أساساً لقيد الحق","newValue":"","change":"Delete"},{"success":true,"name":"Property - title","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام التسجيل العيني للعقار","change":"Update"}],"key":"6169d0a4-cb3a-4b45-89e6-48464b02c7d7"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/5afa2097-16b3-4705-ac6c-a74821fa53dc.config","name":"اللائحة التنفيذية لنظام المساهمات العقارية","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - attachedFile (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"b1c4c468-787b-4da3-96e7-db9a8ccd317c\",\n    \"mediaKey\": \"3c5b3333-1964-4ce0-b86a-5cea1cf8f365\"\n  }\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - attachedFile (en-us)","path":"/Properties/*/Value","oldValue":"/media/apgbuu1p/اللاي-حة-التنفيذية-لنظام-المساهمات-العقارية.pdf","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/584815b7178c4757a721596c4b81bf91\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8ee0e734748542ca959cc362bb265511\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f52bb5b1336483589c712fe2d16a455\"\n      },\n      {\n        \"contentUdi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a5139383e19a415baed15739b7798ae0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88b4081d4b044448871679abfd101bdf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\"\n      },\n      {\n        \"contentUdi\": \"umb://element/222af533409c404f8c484caab1a44ff3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\"\n      },\n      {\n        \"contentUdi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5c928964c4974d8a9435f5b54642aa48\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac1d9fef0896413a928384f679a04556\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/be5ee7bc8267405fb0e827895294c97c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74e1c64f17984584866f3a47653d9529\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\"\n      },\n      {\n        \"contentUdi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>تنطبق معاني الألفاظ والعبارات المنصوص عليها في المادة (الأولى) من النظام على اللائحة، يُقصد بالعبارات الاتية – أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها، مالم يقتض السياق غير ذلك:</p>\\n<p><strong>طالب الترخيص:</strong> المطور العقاري المتقدم بطلب ترخيص المساهمة العقارية.</p>\\n<p><strong>رأس مال المساهمة العقارية:</strong> الحصص النقدية والعينية المقدمة للمساهمة العقارية والمقسمة الى قيم متساوية.</p>\\n<p><strong>اتفاقية المساهمة: </strong>وثيقة بين المرخص له والمساهمين لأغراض المساهمة العقارية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/584815b7178c4757a721596c4b81bf91\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يكون مشروع التطوير العقاري -والمشار إليه في المادة (الأولى) من النظام- خاضعاً للترخيص في حال اشترك فيه خمسة أشخاص فأكثر.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>تصنف المساهمات العقارية حسب الحجم وفق الآتي:</p>\\n<p>أ‌- مساهمة صغيرة يقل رأس مالها عن خمسين مليون ريال.<br>ب‌- مساهمة متوسطة لا يقل رأس مالها عن خمسين مليون ريال ولا يزيد عن ثلاث مئة مليون ريال.<br>ت‌- مساهمة كبيرة يتجاوز رأس مالها ثلاث مئة مليون ريال.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز الترخيص لعدة مساهمات عقارية على ذات العقار خلال فترة واحدة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; يجب أن يتخذ العقار محل المساهمة العقارية إحدى الصورتين الآتيتين:</p>\\n<p>&nbsp;1- أن يكون حصة عينية مسجلة في المساهمة العقارية.<br>&nbsp;2- أن يكون مشترى لمصلحة المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8ee0e734748542ca959cc362bb265511\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;1- إذا كان العقار سيُشترى لمصلحة المساهمة العقارية، فيشترط إبرام اتفاقية مع مالك العقار متضمنة التزامه بنقل ملكية العقار للمساهمة العقارية بعد صدور الترخيص.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;2-يجب على مالك العقار نقل ملكية العقار محل المساهمة العقارية إلى المساهمة العقارية بعد صدور الترخيص وقبل الطرح وجمع الأموال، وينص في ضبط المبايعة على أن البيع معلق على شرط سداد المبلغ في الوقت المحدد.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- يجوز الاشتراك في المساهمة العقارية بحصة عينية، بعقار يكون محلاًّ لها، ويشترط في الحصة العينية الآتي:<br>&nbsp; &nbsp; &nbsp;‌أ- أن تكون مملوكة للمساهم وقت تقديمها.<br>&nbsp; &nbsp; ‌ب- أن تُضمّن في اتفاقية المساهمة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">4-&nbsp; يجب على المساهم نقل ملكية العقار إلى المساهمة العقارية بعد حصولها على الترخيص، خلال مدة لا تتجاوز (خمسة) أيام عملل</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">5- في حال عدم اكتمال طرح المساهمة وجمع الأموال فتعاد ملكية العقار إلى مالكه الأساس وفق خطاب من الهيئة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">6- يجب أن يحتفظ المساهم بالحصة العينية في السنة الأولى بكامل حصصه، ويجوز أن يتصرف في السنة الثانية -وحتى انقضاء المساهمة العقارية- بما لا يزيد على (50%) من حصته في المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>تُنظَّم أحكام جمع الأموال للمساهمات العقارية، وإصدار شهاداتها، وتنظيم سجل المساهمين الخاص بها، وفقًا لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يُقدَّم طلب الترخيص إلى الهيئة وفقًا للنموذج الذي تعده الهيئة لهذا الغرض، مرفقًا به الآتي:</p>\\n<p>1-شهادة من جهة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب الترخيص، على ألاّ يتجاوز تاريخ إصدار الشهادة (ثلاثة أشهر) من تاريخ تقديم الطلب.<br>2- رقم السجل العقاري أو وثيقة تملك العقار محل المساهمة العقارية سارية المفعول ثابتة سلامتها، قابلة للتصرف بناء على إفادة من الجهة التي أصدرتها.<br>3- الموافقات النظامية -بحسب الأحوال- من وزارة الشؤون البلدية والقروية والإسكان أو وزارة الطاقة أو الهيئة، أو غيرها من الجهات المختصة وفق أنظمتها.<br>4- دراسة جدوى اقتصادية للمساهمة العقارية باللغة العربية معتمدة من مكتب مرخص في المملكة، متضمنة البيانات المالية والإنشائية والتسويقية المقدرة، والمصاريف المالية والإدارية المتوقعة لجميع تكاليف التطوير لمشروع المساهمة، والمدة المتوقعة لإتمامه، ومراحل التنفيذ، ومصادر التمويل المتوقعة، وحالات إضافة المبلغ الاحتياطي.<br>5- وصف محل المساهمة العقارية.<br>6- تحديد رأس مال المساهمة العقارية.<br>7- تعبئة نموذج اتفاقية المساهمة.<br>8- الاتفاقية مع الاستشاري الهندسي على أن تشمل الالتزامات والمهام المناطة به.<br>9- الاتفاقية مع المحاسب القانوني على أن تشمل الالتزامات والمهام المناطة به.<br>10- الاتفاقية مع مدير المساهمة العقارية.<br>11- الاتفاقية المبرمة مع مالك العقار وفق المادة (السادسة) من اللائحة، إن وجدت.<br>12- تقييم العقار محل المساهمة العقارية من ثلاثة مقيمين معتمدين.<br>13- تعيين مؤسسة سوق مالية وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1- تدرس الهيئة طلب الترخيص خلال مدة لا تتجاوز (عشرة) أيام عمل ولها عند الحاجة لأي بيانات أو مستندات إضافية ترى ضرورتها، إشعار طالب الترخيص، وعليه استكمال ما يلزم خلال مدة لا تتجاوز (ستين) يوما من تاريخ إبلاغه بذلك، وللهيئة تمديدها لمدة (ثلاثين) يوماً إضافية، وإلا عدّ الطلب مرفوضا.<br>2- تصدر الهيئة موافقة مشروطة على طلب الترخيص باستكمال إجراءات الترخيص، أو ترفض الطلب مع ذكر مسببات الرفض.<br>3- يستكمل طالب الترخيص – بعد الحصول على الموافقة المشروطة على طلب الترخيص - إجراءات طرح شهادات المساهمة العقارية وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة من هيئة السوق المالية.<br>4- تصدر الهيئة الترخيص -بعد استكمال ما ورد في الفقرتين (2) و(3) من هذه المادة-متضمنًا البيانات التالية:<br>‌أ- رقم الترخيص.<br>‌ب- اسم المرخص له.<br>‌ج- مدة الترخيص.<br>‌د- اسم المساهمة العقارية والبيانات المالية والتخطيطية للعقار.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>تضع الهيئة نموذجاً لاتفاقية المساهمة، على أن يتضمن -بحد أدنى- البيانات الآتية:</p>\\n<p>1- بيانات أطراف الاتفاقية.<br>2- اسم المساهمة العقارية، ومقرها، وعنوان التواصل.<br>3- وصف محل المساهمة العقارية.<br>4- مدة المساهمة العقارية وآلية تمديدها.<br>5- مقدار رأس مال المساهمة العقارية.<br>6- المصاريف المالية للمساهمة العقارية.<br>7- اقتراح المبلغ الاحتياطي لرأس مال المساهمة العقارية، إن وجد.<br>8- مقدار الحصص النقدية والعينية.<br>9- آليات تصرف المساهمين بحصصهم.<br>10- الأحكام المنظّمة للاقتراض بضمان أموال المساهمة العقارية وأصولها.<br>11- عمولة المرخص له نظير أتعابه.<br>12- إعداد القوائم المالية والإفصاحات الدورية للمساهمين بشكل نصف سنوي، ومراجعتها بشكل سنوي.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز -بناءً على طلب المرخص له قبل طرح المساهمة العقارية- تعديل الترخيص باتّباع الإجراءات المنصوص عليها في النظام واللائحة وتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية، أو إلغاء الترخيص نهائياً؛ دون إخلال بالحقوق المترتبة قبل الإلغاء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>في حال اشترطت الهيئة إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية -وفقًا لما قضت به المادة (السابعة) من النظام-؛ فيكون التصرف بذلك المبلغ وفقًا للشروط الآتية:</p>\\n<p>1- أن يكون بموافقة الجمعية.<br>2- أن يكون الغرض من التصرف هو التعامل مع مصاريف غير متوقعة وقت تحديد رأس مال المساهمة العقارية.<br>3- إبلاغ الهيئة بالتصرف، ومقداره، خلال مدة لا تتجاوز (5) أيام عمل من تاريخ موافقة الجمعية على التصرف.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- في حال عدم التصرف في المبلغ الاحتياطي المشار إليه في المادة (السابعة) من النظام، أو تم التصرف بجزء منه، فتكون إعادته إلى المساهمين -بعد انقضاء المساهمة العقارية- وفقًا لحصة كل منهم في المبلغ الاحتياطي.<br>2- على المرخص له -قبل التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية لمواجهة أي مصاريف إضافية غير متوقعة- عرض ذلك على الجمعية للتصويت في شأنها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>للمساهم التصرف بحصته في المساهمة العقارية وفق الشروط الآتية:</p>\\n<p>1- أن تضمن اتفاقية المساهمة آلية التصرف.<br>2- أن يقيّد التصرف وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز للمرخص له الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق الشروط الآتية:</p>\\n<p>1- أن تتضمن اتفاقية المساهمة إمكان الاقتراض بضمان أموال المساهمة العقارية أو أصولها.<br>2- موافقة الجمعية على الاقتراض.</p>\\n<p>3- ألا يتجاوز مبلغ الاقتراض نصف رأس مال المساهمة العقارية.<br>4- أن تخصّص الأموال المقترضة؛ لأغراض المساهمة العقارية.<br>5- أن تحوَّل الأموال المقترضة إلى حساب الضمان مباشرة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن (5%) منها، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ممارسو نشاط المساهمات العقارية هم الآتي:</p>\\n<p>1- المرخص له.<br>2- مدير المساهمة العقارية.<br>3- الاستشاري الهندسي.<br>4- المحاسب القانوني<br>5- المقيم المعتمد.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88b4081d4b044448871679abfd101bdf\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الهيئة -بقرار من المجلس- الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في مدير المساهمة العقارية الآتي:</p>\\n<p>1- أن يتمتع بالخبرة اللازمة لإدارة المساهمة العقارية.<br>2- ألا يكون قد سبق أن أدين بجريمة مخلة بالشرف أو الأمانة.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في الاستشاري الهندسي الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمهندسين. &nbsp;<br>2- أن يكون لديه خبرة في مجال البناء والتشييد وإدارة المشاريع لا تقل مدتها عن (ثلاث) سنوات.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المحاسب القانوني الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمراجعين والمحاسبين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.<br>3- أن يكون مسجلا لدى هيئة السوق المالية في حال طرح شهادات المساهمات العقارية طرحاً عاماً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المقيم المعتمد الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمقيمين المعتمدين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp;تعتمد الهيئة متوسط القيمة بين تقارير تقييم العقار المعدة من المقيمين المعتمدين.<br>2- &nbsp; &nbsp; &nbsp;يستبدل التقييم الذي يتجاوز فيه الاختلاف عن التقريرين الآخرين ما نسبته (10%) زيادةً أو نقصاً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يختص المرخص له بالآتي:</p>\\n<p>1- تجهيز كل ما يلزم من متطلبات وموافقات لإصدار الترخيص وفق اشتراطات النظام واللائحة.<br>2- تعيين مدير المساهمة العقارية، والإشراف على أعماله، وتمكينه من القيام بواجباته.<br>3- تعيين محاسب قانوني واستشاري هندسي للمساهمة العقارية.<br>4- فتح حساب ضمان باسم المساهمة العقارية في أحد البنوك المرخص لها.<br>5- تنفيذ الصرف من حساب الضمان وإدارته؛ بناءً على إجراءات الصرف.<br>6- إبرام العقود اللازمة لمصلحة المساهمة العقارية.<br>7- الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق أحكام النظام واللائحة.<br>8- بيع أصول المساهمة العقارية وفق أحكام النظام واللائحة.<br>9- ترؤّس الجمعية أو تعيين من يمثله في رئاستها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المرخص له بالآتي:</p>\\n<p>1- تعيين مؤسسة سوق مالية مرخص لها؛ وذلك وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.<br>2- الإفصاح للمساهمين دون تأخير عن أي تطورات جوهرية في عمليات المساهمة العقارية، أو وضعها المالي، أو كيانها التنظيمي، أو ملكيتها.<br>3-&nbsp; عدم تلقي أي مبلغ ذي صلة بالمساهمة العقارية سواءً بشكل نقدي أو بإيداع في حساب مصرفي خاص. وأن تكون جميع الإيداعات في حساب الضمان فقط.<br>4- تقديم تقارير دورية للمساهمين والهيئة، بما في ذلك التقارير الفنية والمالية وأي تقارير إضافية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/222af533409c404f8c484caab1a44ff3\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على الاستشاري الهندسي أن يؤدي عمله في الإشراف على المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- الإشراف والمتابعة لأعمال المساهمة العقارية وفقًا للمواصفات والمعايير الهندسية والمتطلبات النظامية والتصاميم الهندسية، ووفق ما نص عليه العقد المبرم معه.<br>2- التدقيق والمصادقة على وثيقة الصرف.<br>3- إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على المحاسب القانوني أن يؤدي عمله في المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- مراجعة المستندات المالية اللازمة لعمليات الصرف على المساهمة العقارية، وتدقيقها.<br>2- التحقق من البيانات المالية الخاصة بالمساهمة العقارية، والتأكّد من أن جميع أموال المساهمة العقارية أودعت في حساب الضمان.<br>3- التدقيق والمصادقة على وثيقة الصرف.<br>4- أي مهمة أخرى تتصل باختصاصاته وفقًا لما تصدره الهيئة من تعليمات.<br>5-إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>اختصاصات مدير المساهمة العقارية ومسؤولياته هي:</p>\\n<p>1- التحقق من إيداع جميع العوائد في حساب الضمان.<br>2- توزيع أرباح المساهمة العقارية وفق أحكام النظام واللائحة.<br>3- إبلاغ المرخص له والهيئة عن أي حدث أو تطور جوهري قد يؤثر على المساهمة العقارية.<br>4- مراجعة التقارير عن أعمال المقاول والاستشاري الهندسي والمحاسب القانوني في المساهمة العقارية، وأرشفتها.<br>5- الدعوة لعقد اجتماعات الجمعية.<br>6- تنفيذ عمليات بيع أصول المساهمة العقارية بناء على تفويض المرخص له وبحسب الإجراءات المنصوص عليها في اللائحة.<br>7- رفع التقارير الدورية لكل الأطراف المعنية، إلى كل من (الهيئة، والجمعية، والمرخص له).<br>8- مخاطبة الجهات فيما يتعلق بالمساهمة العقارية.<br>9- أي مهمة أخرى يكلفه بها المرخص له في حدود أعمال المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">1- يجوز للمرخص له أو الجمعية عزل مدير المساهمة العقارية إن أساء استخدام صلاحياته أو أخلّ بتنفيذ التزاماته؛ وفق الإجراءات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; أ‌- رفع طلب عزله إلى الهيئة مرفقاً به الأسباب الداعية إلى ذلك<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ب‌- تبت الهيئة في الطلب خلال مدة لا تتجاوز (خمسة) أيام عمل<br>2- يجوز للهيئة أن تعزل مدير المساهمة العقارية إن ثبتت مخالفته لأحكام النظام أو اللائحة، وتبلغ المرخص له بذلك.<br>3- على المرخص له تعيين مدير للمساهمة خلال (خمسة) أيام عمل من تاريخ تبليغه بقرار الهيئة بالموافقة على عزل مدير المساهمة السابق.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- يجب على كل ممارسي نشاط المساهمات العقارية، الإفصاح للجمعية عن أي مصلحة مباشرة أو غير مباشرة، أو التي تنطوي على تعارض مصالح قائم أو محتمل لهم أو لأي من أقاربهم حتى الدرجة الرابعة في أي مشروع أو اتفاق يعقد مع المساهمة العقارية، ويكون باطلاً أي تصرف مخالف لأحكام هذه المادة.<br>2- لا يجوز للمرخص له ومدير المساهمة العقارية الاشتراك في التصويت على قرارات الجمعية، التي لأي منهما فيها مصلحة مباشرة أو غير مباشرة أو التي تنطوي على تعارض مصالح قائم أو محتمل.<br>3- يجوز لكل ممارسي نشاط المساهمات العقارية -بعد الحصول على موافقة الجمعية- إكمال الإجراءات التي تنطوي على مصلحة أو تعارض مصالح.<br>4- يكون كلّ ممارس نشاط المساهمات العقارية -بحسب الأحوال - مسؤولاً عن الآثار المترتبة على التعارض بين مصالحه الخاصة ومصالح المساهمة العقارية؛ إذا لم يفصح للجمعية عنه، ولا يخلّ ذلك بأي عقوبة أشد يقضي بها نظام آخر.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac1d9fef0896413a928384f679a04556\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تختص الجمعية بالآتي:</p>\\n<p>1- الموافقة على إلغاء الترخيص وتصفية المساهمة العقارية أو بيعها.<br>2- الموافقة على تعديل اتفاقية المساهمة.<br>3- اعتماد القوائم المالية للمساهمة العقارية.<br>4- التصويت على عزل مدير المساهمة العقارية.<br>5- الموافقة على التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية.<br>6- الموافقة على الاقتراض بضمان أموال المساهمة العقارية أو أصولها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>وسائل التقنية الحديثة لحضور اجتماعات هي كل وسيلة اتصال معتمدة وفق (نظام التعاملات الإلكترونية) الصادر بالمرسوم الملكي رقم م/18 وتاريخ 08/03/1428هـ وتعديلاته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب -عند الدعوة إلى عقد اجتماع الجمعية- وضع الإجراءات اللازمة للتحقق من هوية المساهم الذي يصوت من خلال وسائل التقنية الحديثة والمساهم الحاضر في اجتماع الجمعية، وعن أحقيته في التصويت على أيٍّ من بنود الاجتماع، ومن ذلك الدخول من خلال منصة النفاذ الوطني.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">1-تتكون الأرباح القابلة للتوزيع من صافي دخل المساهمة مخصوماً منه جميع المبالغ التي يتم تجنيبها إلى الاحتياطي المخصص لأغراض محددة في اتفاقية المساهمة - إن وجد -.<br>2-يجوز للمساهمة العقارية توزيع أرباح مرحلية ناتجة عن متحصلات البيع على مساهميها بشكل نصف سنوي أو ربع سنوي -إذا نصت اتفاقية المساهمة على جواز ذلك- بعد استيفاء المتطلبات الآتية:<br>                                 ‌أ- موافقة جمعية المساهمين<br>                          ‌ب- أن تكون المساهمة ذات ربحية جيدة ومنتظمة<br>                            ‌ج- أن يتوافر لديها سيولة معقولة، وتستطيع أن تتوقع بدرجة معقولة مستوى أرباحها<br>                               ‌د- أن يتوفر لدى المساهمة أرباح قابلة للتوزيع وفقاً لآخر قوائم مالية مراجعة، كافية لتغطية الأرباح المقترح توزيعها.<br>3-يجب على مدير المساهمة أن يفصح للهيئة والمساهمين فوراً ومن دون تأخير عند اتخاذ قرار توزيع الأرباح.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74e1c64f17984584866f3a47653d9529\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>في تنفيذ أحكام المادة (السابعة والعشرون) من النظام، تسري الأحكام الآتية:</p>\\n<p>1- يجب تقييم أصول المساهمة العقارية من ثلاثة مقيمين مستقلين عن المرخص له، ومعتمدين وفقاً لنظام المقيمين المعتمدين.<br>2- يجب عرض التقييم على الجمعية، للحصول على موافقتها. وللجمعية طلب إعادة التقييم بما لا يتجاوز مرتين.<br>3- ألا تتجاوز المدة بين تقرير التقييم وتاريخ البيع؛ (ثلاثة) أشهر.<br>4- تكون إجراءات البيع من خلال المرخص له أو مدير المساهمة العقارية، بحسب ما تنص عليه اتفاقية المساهمة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>لمسؤول الضبط -في سبيل القيام بأعمال التفتيش- اتخاذ أي من الإجراءات الآتية:</p>\\n<p>1- فحص مقر المرخص له والوثائق والمشاريع المتعلقة بالأنشطة المشمولة بالنظام، وأيٍّ من المستندات والوثائق والبيانات والسجلات والمرافق المتعلقة بالمساهمة العقارية.<br>2- الحصول على نُسَخ من أي ترخيص أو تصريح أو شهادة أو سجل أو وثيقة أو غيرها.<br>3- التحفظ على الوثائق والسجلات ونحوها.<br>4- التصوير بأي من الوسائل المتاحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>على مسؤول الضبط -عند ضبط مخالفة- إعداد محضر متضمّنًا ما يأتي:</p>\\n<p>1- المعلومات والبيانات بما يشمل بيانات مسؤول الضبط وتاريخ التفتيش ووقته ومكانه.<br>2- بيانات المرخص له.<br>3- الوقائع بما يشمل ملخص ما قام به مسؤول الضبط.<br>4- رصد وقائع المخالفات ووصفها.<br>5- قائمة بما تم ضبطه أو التحفظ عليه من أصول أو مستندات أو معلومات وغيرها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يحيل مسؤول الضبط محضر ضبط المخالفة إلى لجنة النظر في مخالفات أحكام النظام المنصوص عليها في المادة (الثالثة والثلاثين) من النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصرف لمسؤول الضبط مكافأة قدرها ثلاثة رواتب أساسية مرتبطة بتقييم الأداء.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنشر اللائحة في الجريدة الرسمية، ويعمل بها من تاريخ نشرها</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f52bb5b1336483589c712fe2d16a455\",\n      \"title\": \"إجراءات الترخيص\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\",\n      \"title\": \"أحكام رأس مال المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a5139383e19a415baed15739b7798ae0\",\n      \"title\": \"ممارسو نشاط المساهمات العقارية واختصاصتهم\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5c928964c4974d8a9435f5b54642aa48\",\n      \"title\": \"جمعية المساهمين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/be5ee7bc8267405fb0e827895294c97c\",\n      \"title\": \"توزيع الأرباح وتصفية المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\",\n      \"title\": \"الرقابة والتفتيش والضبط\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/584815b7178c4757a721596c4b81bf91\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8ee0e734748542ca959cc362bb265511\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f52bb5b1336483589c712fe2d16a455\"\n      },\n      {\n        \"contentUdi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a5139383e19a415baed15739b7798ae0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88b4081d4b044448871679abfd101bdf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\"\n      },\n      {\n        \"contentUdi\": \"umb://element/222af533409c404f8c484caab1a44ff3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\"\n      },\n      {\n        \"contentUdi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5c928964c4974d8a9435f5b54642aa48\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac1d9fef0896413a928384f679a04556\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/be5ee7bc8267405fb0e827895294c97c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74e1c64f17984584866f3a47653d9529\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\"\n      },\n      {\n        \"contentUdi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>تنطبق معاني الألفاظ والعبارات المنصوص عليها في المادة (الأولى) من النظام على اللائحة، يُقصد بالعبارات الاتية – أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها، مالم يقتض السياق غير ذلك:</p>\\n<p><strong>طالب الترخيص:</strong> المطور العقاري المتقدم بطلب ترخيص المساهمة العقارية.</p>\\n<p><strong>رأس مال المساهمة العقارية:</strong> الحصص النقدية والعينية المقدمة للمساهمة العقارية والمقسمة الى قيم متساوية.</p>\\n<p><strong>اتفاقية المساهمة: </strong>وثيقة بين المرخص له والمساهمين لأغراض المساهمة العقارية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/584815b7178c4757a721596c4b81bf91\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يكون مشروع التطوير العقاري -والمشار إليه في المادة (الأولى) من النظام- خاضعاً للترخيص في حال اشترك فيه خمسة أشخاص فأكثر.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>تصنف المساهمات العقارية حسب الحجم وفق الآتي:</p>\\n<p>أ‌- مساهمة صغيرة يقل رأس مالها عن خمسين مليون ريال.<br>ب‌- مساهمة متوسطة لا يقل رأس مالها عن خمسين مليون ريال ولا يزيد عن ثلاث مئة مليون ريال.<br>ت‌- مساهمة كبيرة يتجاوز رأس مالها ثلاث مئة مليون ريال.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز الترخيص لعدة مساهمات عقارية على ذات العقار خلال فترة واحدة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; يجب أن يتخذ العقار محل المساهمة العقارية إحدى الصورتين الآتيتين:</p>\\n<p>&nbsp;1- أن يكون حصة عينية مسجلة في المساهمة العقارية.<br>&nbsp;2- أن يكون مشترى لمصلحة المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8ee0e734748542ca959cc362bb265511\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;1- إذا كان العقار سيُشترى لمصلحة المساهمة العقارية، فيشترط إبرام اتفاقية مع مالك العقار متضمنة التزامه بنقل ملكية العقار للمساهمة العقارية بعد صدور الترخيص.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;2-يجب على مالك العقار نقل ملكية العقار محل المساهمة العقارية إلى المساهمة العقارية بعد صدور الترخيص وقبل الطرح وجمع الأموال، وينص في ضبط المبايعة على أن البيع معلق على شرط سداد المبلغ في الوقت المحدد.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- يجوز الاشتراك في المساهمة العقارية بحصة عينية، بعقار يكون محلاًّ لها، ويشترط في الحصة العينية الآتي:<br>&nbsp; &nbsp; &nbsp;‌أ- أن تكون مملوكة للمساهم وقت تقديمها.<br>&nbsp; &nbsp; ‌ب- أن تُضمّن في اتفاقية المساهمة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">4-&nbsp; يجب على المساهم نقل ملكية العقار إلى المساهمة العقارية بعد حصولها على الترخيص، خلال مدة لا تتجاوز (خمسة) أيام عملل</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">5- في حال عدم اكتمال طرح المساهمة وجمع الأموال فتعاد ملكية العقار إلى مالكه الأساس وفق خطاب من الهيئة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">6- يجب أن يحتفظ المساهم بالحصة العينية في السنة الأولى بكامل حصصه، ويجوز أن يتصرف في السنة الثانية -وحتى انقضاء المساهمة العقارية- بما لا يزيد على (50%) من حصته في المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>تُنظَّم أحكام جمع الأموال للمساهمات العقارية، وإصدار شهاداتها، وتنظيم سجل المساهمين الخاص بها، وفقًا لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يُقدَّم طلب الترخيص إلى الهيئة وفقًا للنموذج الذي تعده الهيئة لهذا الغرض، مرفقًا به الآتي:</p>\\n<p>1-شهادة من جهة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب الترخيص، على ألاّ يتجاوز تاريخ إصدار الشهادة (ثلاثة أشهر) من تاريخ تقديم الطلب.<br>2- رقم السجل العقاري أو وثيقة تملك العقار محل المساهمة العقارية سارية المفعول ثابتة سلامتها، قابلة للتصرف بناء على إفادة من الجهة التي أصدرتها.<br>3- الموافقات النظامية -بحسب الأحوال- من وزارة الشؤون البلدية والقروية والإسكان أو وزارة الطاقة أو الهيئة، أو غيرها من الجهات المختصة وفق أنظمتها.<br>4- دراسة جدوى اقتصادية للمساهمة العقارية باللغة العربية معتمدة من مكتب مرخص في المملكة، متضمنة البيانات المالية والإنشائية والتسويقية المقدرة، والمصاريف المالية والإدارية المتوقعة لجميع تكاليف التطوير لمشروع المساهمة، والمدة المتوقعة لإتمامه، ومراحل التنفيذ، ومصادر التمويل المتوقعة، وحالات إضافة المبلغ الاحتياطي.<br>5- وصف محل المساهمة العقارية.<br>6- تحديد رأس مال المساهمة العقارية.<br>7- تعبئة نموذج اتفاقية المساهمة.<br>8- الاتفاقية مع الاستشاري الهندسي على أن تشمل الالتزامات والمهام المناطة به.<br>9- الاتفاقية مع المحاسب القانوني على أن تشمل الالتزامات والمهام المناطة به.<br>10- الاتفاقية مع مدير المساهمة العقارية.<br>11- الاتفاقية المبرمة مع مالك العقار وفق المادة (السادسة) من اللائحة، إن وجدت.<br>12- تقييم العقار محل المساهمة العقارية من ثلاثة مقيمين معتمدين.<br>13- تعيين مؤسسة سوق مالية وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1- تدرس الهيئة طلب الترخيص خلال مدة لا تتجاوز (عشرة) أيام عمل ولها عند الحاجة لأي بيانات أو مستندات إضافية ترى ضرورتها، إشعار طالب الترخيص، وعليه استكمال ما يلزم خلال مدة لا تتجاوز (ستين) يوما من تاريخ إبلاغه بذلك، وللهيئة تمديدها لمدة (ثلاثين) يوماً إضافية، وإلا عدّ الطلب مرفوضا.<br>2- تصدر الهيئة موافقة مشروطة على طلب الترخيص باستكمال إجراءات الترخيص، أو ترفض الطلب مع ذكر مسببات الرفض.<br>3- يستكمل طالب الترخيص – بعد الحصول على الموافقة المشروطة على طلب الترخيص - إجراءات طرح شهادات المساهمة العقارية وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة من هيئة السوق المالية.<br>4- تصدر الهيئة الترخيص -بعد استكمال ما ورد في الفقرتين (2) و(3) من هذه المادة-متضمنًا البيانات التالية:<br>‌أ- رقم الترخيص.<br>‌ب- اسم المرخص له.<br>‌ج- مدة الترخيص.<br>‌د- اسم المساهمة العقارية والبيانات المالية والتخطيطية للعقار.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>تضع الهيئة نموذجاً لاتفاقية المساهمة، على أن يتضمن -بحد أدنى- البيانات الآتية:</p>\\n<p>1- بيانات أطراف الاتفاقية.<br>2- اسم المساهمة العقارية، ومقرها، وعنوان التواصل.<br>3- وصف محل المساهمة العقارية.<br>4- مدة المساهمة العقارية وآلية تمديدها.<br>5- مقدار رأس مال المساهمة العقارية.<br>6- المصاريف المالية للمساهمة العقارية.<br>7- اقتراح المبلغ الاحتياطي لرأس مال المساهمة العقارية، إن وجد.<br>8- مقدار الحصص النقدية والعينية.<br>9- آليات تصرف المساهمين بحصصهم.<br>10- الأحكام المنظّمة للاقتراض بضمان أموال المساهمة العقارية وأصولها.<br>11- عمولة المرخص له نظير أتعابه.<br>12- إعداد القوائم المالية والإفصاحات الدورية للمساهمين بشكل نصف سنوي، ومراجعتها بشكل سنوي.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز -بناءً على طلب المرخص له قبل طرح المساهمة العقارية- تعديل الترخيص باتّباع الإجراءات المنصوص عليها في النظام واللائحة وتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية، أو إلغاء الترخيص نهائياً؛ دون إخلال بالحقوق المترتبة قبل الإلغاء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>في حال اشترطت الهيئة إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية -وفقًا لما قضت به المادة (السابعة) من النظام-؛ فيكون التصرف بذلك المبلغ وفقًا للشروط الآتية:</p>\\n<p>1- أن يكون بموافقة الجمعية.<br>2- أن يكون الغرض من التصرف هو التعامل مع مصاريف غير متوقعة وقت تحديد رأس مال المساهمة العقارية.<br>3- إبلاغ الهيئة بالتصرف، ومقداره، خلال مدة لا تتجاوز (5) أيام عمل من تاريخ موافقة الجمعية على التصرف.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- في حال عدم التصرف في المبلغ الاحتياطي المشار إليه في المادة (السابعة) من النظام، أو تم التصرف بجزء منه، فتكون إعادته إلى المساهمين -بعد انقضاء المساهمة العقارية- وفقًا لحصة كل منهم في المبلغ الاحتياطي.<br>2- على المرخص له -قبل التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية لمواجهة أي مصاريف إضافية غير متوقعة- عرض ذلك على الجمعية للتصويت في شأنها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>للمساهم التصرف بحصته في المساهمة العقارية وفق الشروط الآتية:</p>\\n<p>1- أن تضمن اتفاقية المساهمة آلية التصرف.<br>2- أن يقيّد التصرف وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز للمرخص له الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق الشروط الآتية:</p>\\n<p>1- أن تتضمن اتفاقية المساهمة إمكان الاقتراض بضمان أموال المساهمة العقارية أو أصولها.<br>2- موافقة الجمعية على الاقتراض.</p>\\n<p>3- ألا يتجاوز مبلغ الاقتراض نصف رأس مال المساهمة العقارية.<br>4- أن تخصّص الأموال المقترضة؛ لأغراض المساهمة العقارية.<br>5- أن تحوَّل الأموال المقترضة إلى حساب الضمان مباشرة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن (5%) منها، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ممارسو نشاط المساهمات العقارية هم الآتي:</p>\\n<p>1- المرخص له.<br>2- مدير المساهمة العقارية.<br>3- الاستشاري الهندسي.<br>4- المحاسب القانوني<br>5- المقيم المعتمد.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88b4081d4b044448871679abfd101bdf\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الهيئة -بقرار من المجلس- الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في مدير المساهمة العقارية الآتي:</p>\\n<p>1- أن يتمتع بالخبرة اللازمة لإدارة المساهمة العقارية.<br>2- ألا يكون قد سبق أن أدين بجريمة مخلة بالشرف أو الأمانة.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في الاستشاري الهندسي الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمهندسين. &nbsp;<br>2- أن يكون لديه خبرة في مجال البناء والتشييد وإدارة المشاريع لا تقل مدتها عن (ثلاث) سنوات.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المحاسب القانوني الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمراجعين والمحاسبين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.<br>3- أن يكون مسجلا لدى هيئة السوق المالية في حال طرح شهادات المساهمات العقارية طرحاً عاماً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المقيم المعتمد الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمقيمين المعتمدين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp;تعتمد الهيئة متوسط القيمة بين تقارير تقييم العقار المعدة من المقيمين المعتمدين.<br>2- &nbsp; &nbsp; &nbsp;يستبدل التقييم الذي يتجاوز فيه الاختلاف عن التقريرين الآخرين ما نسبته (10%) زيادةً أو نقصاً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يختص المرخص له بالآتي:</p>\\n<p>1- تجهيز كل ما يلزم من متطلبات وموافقات لإصدار الترخيص وفق اشتراطات النظام واللائحة.<br>2- تعيين مدير المساهمة العقارية، والإشراف على أعماله، وتمكينه من القيام بواجباته.<br>3- تعيين محاسب قانوني واستشاري هندسي للمساهمة العقارية.<br>4- فتح حساب ضمان باسم المساهمة العقارية في أحد البنوك المرخص لها.<br>5- تنفيذ الصرف من حساب الضمان وإدارته؛ بناءً على إجراءات الصرف.<br>6- إبرام العقود اللازمة لمصلحة المساهمة العقارية.<br>7- الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق أحكام النظام واللائحة.<br>8- بيع أصول المساهمة العقارية وفق أحكام النظام واللائحة.<br>9- ترؤّس الجمعية أو تعيين من يمثله في رئاستها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المرخص له بالآتي:</p>\\n<p>1- تعيين مؤسسة سوق مالية مرخص لها؛ وذلك وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.<br>2- الإفصاح للمساهمين دون تأخير عن أي تطورات جوهرية في عمليات المساهمة العقارية، أو وضعها المالي، أو كيانها التنظيمي، أو ملكيتها.<br>3-&nbsp; عدم تلقي أي مبلغ ذي صلة بالمساهمة العقارية سواءً بشكل نقدي أو بإيداع في حساب مصرفي خاص. وأن تكون جميع الإيداعات في حساب الضمان فقط.<br>4- تقديم تقارير دورية للمساهمين والهيئة، بما في ذلك التقارير الفنية والمالية وأي تقارير إضافية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/222af533409c404f8c484caab1a44ff3\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على الاستشاري الهندسي أن يؤدي عمله في الإشراف على المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- الإشراف والمتابعة لأعمال المساهمة العقارية وفقًا للمواصفات والمعايير الهندسية والمتطلبات النظامية والتصاميم الهندسية، ووفق ما نص عليه العقد المبرم معه.<br>2- التدقيق والمصادقة على وثيقة الصرف.<br>3- إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على المحاسب القانوني أن يؤدي عمله في المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- مراجعة المستندات المالية اللازمة لعمليات الصرف على المساهمة العقارية، وتدقيقها.<br>2- التحقق من البيانات المالية الخاصة بالمساهمة العقارية، والتأكّد من أن جميع أموال المساهمة العقارية أودعت في حساب الضمان.<br>3- التدقيق والمصادقة على وثيقة الصرف.<br>4- أي مهمة أخرى تتصل باختصاصاته وفقًا لما تصدره الهيئة من تعليمات.<br>5-إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>اختصاصات مدير المساهمة العقارية ومسؤولياته هي:</p>\\n<p>1- التحقق من إيداع جميع العوائد في حساب الضمان.<br>2- توزيع أرباح المساهمة العقارية وفق أحكام النظام واللائحة.<br>3- إبلاغ المرخص له والهيئة عن أي حدث أو تطور جوهري قد يؤثر على المساهمة العقارية.<br>4- مراجعة التقارير عن أعمال المقاول والاستشاري الهندسي والمحاسب القانوني في المساهمة العقارية، وأرشفتها.<br>5- الدعوة لعقد اجتماعات الجمعية.<br>6- تنفيذ عمليات بيع أصول المساهمة العقارية بناء على تفويض المرخص له وبحسب الإجراءات المنصوص عليها في اللائحة.<br>7- رفع التقارير الدورية لكل الأطراف المعنية، إلى كل من (الهيئة، والجمعية، والمرخص له).<br>8- مخاطبة الجهات فيما يتعلق بالمساهمة العقارية.<br>9- أي مهمة أخرى يكلفه بها المرخص له في حدود أعمال المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">1- يجوز للمرخص له أو الجمعية عزل مدير المساهمة العقارية إن أساء استخدام صلاحياته أو أخلّ بتنفيذ التزاماته؛ وفق الإجراءات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; أ‌- رفع طلب عزله إلى الهيئة مرفقاً به الأسباب الداعية إلى ذلك<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ب‌- تبت الهيئة في الطلب خلال مدة لا تتجاوز (خمسة) أيام عمل<br>2- يجوز للهيئة أن تعزل مدير المساهمة العقارية إن ثبتت مخالفته لأحكام النظام أو اللائحة، وتبلغ المرخص له بذلك.<br>3- على المرخص له تعيين مدير للمساهمة خلال (خمسة) أيام عمل من تاريخ تبليغه بقرار الهيئة بالموافقة على عزل مدير المساهمة السابق.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- يجب على كل ممارسي نشاط المساهمات العقارية، الإفصاح للجمعية عن أي مصلحة مباشرة أو غير مباشرة، أو التي تنطوي على تعارض مصالح قائم أو محتمل لهم أو لأي من أقاربهم حتى الدرجة الرابعة في أي مشروع أو اتفاق يعقد مع المساهمة العقارية، ويكون باطلاً أي تصرف مخالف لأحكام هذه المادة.<br>2- لا يجوز للمرخص له ومدير المساهمة العقارية الاشتراك في التصويت على قرارات الجمعية، التي لأي منهما فيها مصلحة مباشرة أو غير مباشرة أو التي تنطوي على تعارض مصالح قائم أو محتمل.<br>3- يجوز لكل ممارسي نشاط المساهمات العقارية -بعد الحصول على موافقة الجمعية- إكمال الإجراءات التي تنطوي على مصلحة أو تعارض مصالح.<br>4- يكون كلّ ممارس نشاط المساهمات العقارية -بحسب الأحوال - مسؤولاً عن الآثار المترتبة على التعارض بين مصالحه الخاصة ومصالح المساهمة العقارية؛ إذا لم يفصح للجمعية عنه، ولا يخلّ ذلك بأي عقوبة أشد يقضي بها نظام آخر.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac1d9fef0896413a928384f679a04556\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تختص الجمعية بالآتي:</p>\\n<p>1- الموافقة على إلغاء الترخيص وتصفية المساهمة العقارية أو بيعها.<br>2- الموافقة على تعديل اتفاقية المساهمة.<br>3- اعتماد القوائم المالية للمساهمة العقارية.<br>4- التصويت على عزل مدير المساهمة العقارية.<br>5- الموافقة على التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية.<br>6- الموافقة على الاقتراض بضمان أموال المساهمة العقارية أو أصولها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>وسائل التقنية الحديثة لحضور اجتماعات هي كل وسيلة اتصال معتمدة وفق (نظام التعاملات الإلكترونية) الصادر بالمرسوم الملكي رقم م/18 وتاريخ 08/03/1428هـ وتعديلاته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب -عند الدعوة إلى عقد اجتماع الجمعية- وضع الإجراءات اللازمة للتحقق من هوية المساهم الذي يصوت من خلال وسائل التقنية الحديثة والمساهم الحاضر في اجتماع الجمعية، وعن أحقيته في التصويت على أيٍّ من بنود الاجتماع، ومن ذلك الدخول من خلال منصة النفاذ الوطني.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">1-تتكون الأرباح القابلة للتوزيع من صافي دخل المساهمة مخصوماً منه جميع المبالغ التي يتم تجنيبها إلى الاحتياطي المخصص لأغراض محددة في اتفاقية المساهمة - إن وجد -.<br>2-يجوز للمساهمة العقارية توزيع أرباح مرحلية ناتجة عن متحصلات البيع على مساهميها بشكل نصف سنوي أو ربع سنوي -إذا نصت اتفاقية المساهمة على جواز ذلك- بعد استيفاء المتطلبات الآتية:<br>                                 ‌أ- موافقة جمعية المساهمين<br>                          ‌ب- أن تكون المساهمة ذات ربحية جيدة ومنتظمة<br>                            ‌ج- أن يتوافر لديها سيولة معقولة، وتستطيع أن تتوقع بدرجة معقولة مستوى أرباحها<br>                               ‌د- أن يتوفر لدى المساهمة أرباح قابلة للتوزيع وفقاً لآخر قوائم مالية مراجعة، كافية لتغطية الأرباح المقترح توزيعها.<br>3-يجب على مدير المساهمة أن يفصح للهيئة والمساهمين فوراً ومن دون تأخير عند اتخاذ قرار توزيع الأرباح.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74e1c64f17984584866f3a47653d9529\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>في تنفيذ أحكام المادة (السابعة والعشرون) من النظام، تسري الأحكام الآتية:</p>\\n<p>1- يجب تقييم أصول المساهمة العقارية من ثلاثة مقيمين مستقلين عن المرخص له، ومعتمدين وفقاً لنظام المقيمين المعتمدين.<br>2- يجب عرض التقييم على الجمعية، للحصول على موافقتها. وللجمعية طلب إعادة التقييم بما لا يتجاوز مرتين.<br>3- ألا تتجاوز المدة بين تقرير التقييم وتاريخ البيع؛ (ثلاثة) أشهر.<br>4- تكون إجراءات البيع من خلال المرخص له أو مدير المساهمة العقارية، بحسب ما تنص عليه اتفاقية المساهمة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>لمسؤول الضبط -في سبيل القيام بأعمال التفتيش- اتخاذ أي من الإجراءات الآتية:</p>\\n<p>1- فحص مقر المرخص له والوثائق والمشاريع المتعلقة بالأنشطة المشمولة بالنظام، وأيٍّ من المستندات والوثائق والبيانات والسجلات والمرافق المتعلقة بالمساهمة العقارية.<br>2- الحصول على نُسَخ من أي ترخيص أو تصريح أو شهادة أو سجل أو وثيقة أو غيرها.<br>3- التحفظ على الوثائق والسجلات ونحوها.<br>4- التصوير بأي من الوسائل المتاحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>على مسؤول الضبط -عند ضبط مخالفة- إعداد محضر متضمّنًا ما يأتي:</p>\\n<p>1- المعلومات والبيانات بما يشمل بيانات مسؤول الضبط وتاريخ التفتيش ووقته ومكانه.<br>2- بيانات المرخص له.<br>3- الوقائع بما يشمل ملخص ما قام به مسؤول الضبط.<br>4- رصد وقائع المخالفات ووصفها.<br>5- قائمة بما تم ضبطه أو التحفظ عليه من أصول أو مستندات أو معلومات وغيرها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يحيل مسؤول الضبط محضر ضبط المخالفة إلى لجنة النظر في مخالفات أحكام النظام المنصوص عليها في المادة (الثالثة والثلاثين) من النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصرف لمسؤول الضبط مكافأة قدرها ثلاثة رواتب أساسية مرتبطة بتقييم الأداء.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنشر اللائحة في الجريدة الرسمية، ويعمل بها من تاريخ نشرها</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f52bb5b1336483589c712fe2d16a455\",\n      \"title\": \"إجراءات الترخيص\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\",\n      \"title\": \"أحكام رأس مال المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a5139383e19a415baed15739b7798ae0\",\n      \"title\": \"ممارسو نشاط المساهمات العقارية واختصاصتهم\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5c928964c4974d8a9435f5b54642aa48\",\n      \"title\": \"جمعية المساهمين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/be5ee7bc8267405fb0e827895294c97c\",\n      \"title\": \"توزيع الأرباح وتصفية المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\",\n      \"title\": \"الرقابة والتفتيش والضبط\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - contentItems (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/584815b7178c4757a721596c4b81bf91\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8ee0e734748542ca959cc362bb265511\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f52bb5b1336483589c712fe2d16a455\"\n      },\n      {\n        \"contentUdi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a5139383e19a415baed15739b7798ae0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88b4081d4b044448871679abfd101bdf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\"\n      },\n      {\n        \"contentUdi\": \"umb://element/222af533409c404f8c484caab1a44ff3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\"\n      },\n      {\n        \"contentUdi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5c928964c4974d8a9435f5b54642aa48\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac1d9fef0896413a928384f679a04556\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/be5ee7bc8267405fb0e827895294c97c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74e1c64f17984584866f3a47653d9529\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\"\n      },\n      {\n        \"contentUdi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>تنطبق معاني الألفاظ والعبارات المنصوص عليها في المادة (الأولى) من النظام على اللائحة، يُقصد بالعبارات الاتية – أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها، مالم يقتض السياق غير ذلك:</p>\\n<p><strong>طالب الترخيص:</strong> المطور العقاري المتقدم بطلب ترخيص المساهمة العقارية.</p>\\n<p><strong>رأس مال المساهمة العقارية:</strong> الحصص النقدية والعينية المقدمة للمساهمة العقارية والمقسمة الى قيم متساوية.</p>\\n<p><strong>اتفاقية المساهمة: </strong>وثيقة بين المرخص له والمساهمين لأغراض المساهمة العقارية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/584815b7178c4757a721596c4b81bf91\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يكون مشروع التطوير العقاري -والمشار إليه في المادة (الأولى) من النظام- خاضعاً للترخيص في حال اشترك فيه خمسة أشخاص فأكثر.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>تصنف المساهمات العقارية حسب الحجم وفق الآتي:</p>\\n<p>أ‌- مساهمة صغيرة يقل رأس مالها عن خمسين مليون ريال.<br>ب‌- مساهمة متوسطة لا يقل رأس مالها عن خمسين مليون ريال ولا يزيد عن ثلاث مئة مليون ريال.<br>ت‌- مساهمة كبيرة يتجاوز رأس مالها ثلاث مئة مليون ريال.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز الترخيص لعدة مساهمات عقارية على ذات العقار خلال فترة واحدة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; يجب أن يتخذ العقار محل المساهمة العقارية إحدى الصورتين الآتيتين:</p>\\n<p>&nbsp;1- أن يكون حصة عينية مسجلة في المساهمة العقارية.<br>&nbsp;2- أن يكون مشترى لمصلحة المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8ee0e734748542ca959cc362bb265511\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;1- إذا كان العقار سيُشترى لمصلحة المساهمة العقارية، فيشترط إبرام اتفاقية مع مالك العقار متضمنة التزامه بنقل ملكية العقار للمساهمة العقارية بعد صدور الترخيص.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;2-يجب على مالك العقار نقل ملكية العقار محل المساهمة العقارية إلى المساهمة العقارية بعد صدور الترخيص وقبل الطرح وجمع الأموال، وينص في ضبط المبايعة على أن البيع معلق على شرط سداد المبلغ في الوقت المحدد.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">3- يجوز الاشتراك في المساهمة العقارية بحصة عينية، بعقار يكون محلاًّ لها، ويشترط في الحصة العينية الآتي:<br>&nbsp; &nbsp; &nbsp;‌أ- أن تكون مملوكة للمساهم وقت تقديمها.<br>&nbsp; &nbsp; ‌ب- أن تُضمّن في اتفاقية المساهمة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">4-&nbsp; يجب على المساهم نقل ملكية العقار إلى المساهمة العقارية بعد حصولها على الترخيص، خلال مدة لا تتجاوز (خمسة) أيام عملل</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">5- في حال عدم اكتمال طرح المساهمة وجمع الأموال فتعاد ملكية العقار إلى مالكه الأساس وفق خطاب من الهيئة.</p>\\n<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">6- يجب أن يحتفظ المساهم بالحصة العينية في السنة الأولى بكامل حصصه، ويجوز أن يتصرف في السنة الثانية -وحتى انقضاء المساهمة العقارية- بما لا يزيد على (50%) من حصته في المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>تُنظَّم أحكام جمع الأموال للمساهمات العقارية، وإصدار شهاداتها، وتنظيم سجل المساهمين الخاص بها، وفقًا لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يُقدَّم طلب الترخيص إلى الهيئة وفقًا للنموذج الذي تعده الهيئة لهذا الغرض، مرفقًا به الآتي:</p>\\n<p>1-شهادة من جهة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب الترخيص، على ألاّ يتجاوز تاريخ إصدار الشهادة (ثلاثة أشهر) من تاريخ تقديم الطلب.<br>2- رقم السجل العقاري أو وثيقة تملك العقار محل المساهمة العقارية سارية المفعول ثابتة سلامتها، قابلة للتصرف بناء على إفادة من الجهة التي أصدرتها.<br>3- الموافقات النظامية -بحسب الأحوال- من وزارة الشؤون البلدية والقروية والإسكان أو وزارة الطاقة أو الهيئة، أو غيرها من الجهات المختصة وفق أنظمتها.<br>4- دراسة جدوى اقتصادية للمساهمة العقارية باللغة العربية معتمدة من مكتب مرخص في المملكة، متضمنة البيانات المالية والإنشائية والتسويقية المقدرة، والمصاريف المالية والإدارية المتوقعة لجميع تكاليف التطوير لمشروع المساهمة، والمدة المتوقعة لإتمامه، ومراحل التنفيذ، ومصادر التمويل المتوقعة، وحالات إضافة المبلغ الاحتياطي.<br>5- وصف محل المساهمة العقارية.<br>6- تحديد رأس مال المساهمة العقارية.<br>7- تعبئة نموذج اتفاقية المساهمة.<br>8- الاتفاقية مع الاستشاري الهندسي على أن تشمل الالتزامات والمهام المناطة به.<br>9- الاتفاقية مع المحاسب القانوني على أن تشمل الالتزامات والمهام المناطة به.<br>10- الاتفاقية مع مدير المساهمة العقارية.<br>11- الاتفاقية المبرمة مع مالك العقار وفق المادة (السادسة) من اللائحة، إن وجدت.<br>12- تقييم العقار محل المساهمة العقارية من ثلاثة مقيمين معتمدين.<br>13- تعيين مؤسسة سوق مالية وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1- تدرس الهيئة طلب الترخيص خلال مدة لا تتجاوز (عشرة) أيام عمل ولها عند الحاجة لأي بيانات أو مستندات إضافية ترى ضرورتها، إشعار طالب الترخيص، وعليه استكمال ما يلزم خلال مدة لا تتجاوز (ستين) يوما من تاريخ إبلاغه بذلك، وللهيئة تمديدها لمدة (ثلاثين) يوماً إضافية، وإلا عدّ الطلب مرفوضا.<br>2- تصدر الهيئة موافقة مشروطة على طلب الترخيص باستكمال إجراءات الترخيص، أو ترفض الطلب مع ذكر مسببات الرفض.<br>3- يستكمل طالب الترخيص – بعد الحصول على الموافقة المشروطة على طلب الترخيص - إجراءات طرح شهادات المساهمة العقارية وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة من هيئة السوق المالية.<br>4- تصدر الهيئة الترخيص -بعد استكمال ما ورد في الفقرتين (2) و(3) من هذه المادة-متضمنًا البيانات التالية:<br>‌أ- رقم الترخيص.<br>‌ب- اسم المرخص له.<br>‌ج- مدة الترخيص.<br>‌د- اسم المساهمة العقارية والبيانات المالية والتخطيطية للعقار.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>تضع الهيئة نموذجاً لاتفاقية المساهمة، على أن يتضمن -بحد أدنى- البيانات الآتية:</p>\\n<p>1- بيانات أطراف الاتفاقية.<br>2- اسم المساهمة العقارية، ومقرها، وعنوان التواصل.<br>3- وصف محل المساهمة العقارية.<br>4- مدة المساهمة العقارية وآلية تمديدها.<br>5- مقدار رأس مال المساهمة العقارية.<br>6- المصاريف المالية للمساهمة العقارية.<br>7- اقتراح المبلغ الاحتياطي لرأس مال المساهمة العقارية، إن وجد.<br>8- مقدار الحصص النقدية والعينية.<br>9- آليات تصرف المساهمين بحصصهم.<br>10- الأحكام المنظّمة للاقتراض بضمان أموال المساهمة العقارية وأصولها.<br>11- عمولة المرخص له نظير أتعابه.<br>12- إعداد القوائم المالية والإفصاحات الدورية للمساهمين بشكل نصف سنوي، ومراجعتها بشكل سنوي.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز -بناءً على طلب المرخص له قبل طرح المساهمة العقارية- تعديل الترخيص باتّباع الإجراءات المنصوص عليها في النظام واللائحة وتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية، أو إلغاء الترخيص نهائياً؛ دون إخلال بالحقوق المترتبة قبل الإلغاء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>في حال اشترطت الهيئة إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية -وفقًا لما قضت به المادة (السابعة) من النظام-؛ فيكون التصرف بذلك المبلغ وفقًا للشروط الآتية:</p>\\n<p>1- أن يكون بموافقة الجمعية.<br>2- أن يكون الغرض من التصرف هو التعامل مع مصاريف غير متوقعة وقت تحديد رأس مال المساهمة العقارية.<br>3- إبلاغ الهيئة بالتصرف، ومقداره، خلال مدة لا تتجاوز (5) أيام عمل من تاريخ موافقة الجمعية على التصرف.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- في حال عدم التصرف في المبلغ الاحتياطي المشار إليه في المادة (السابعة) من النظام، أو تم التصرف بجزء منه، فتكون إعادته إلى المساهمين -بعد انقضاء المساهمة العقارية- وفقًا لحصة كل منهم في المبلغ الاحتياطي.<br>2- على المرخص له -قبل التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية لمواجهة أي مصاريف إضافية غير متوقعة- عرض ذلك على الجمعية للتصويت في شأنها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>للمساهم التصرف بحصته في المساهمة العقارية وفق الشروط الآتية:</p>\\n<p>1- أن تضمن اتفاقية المساهمة آلية التصرف.<br>2- أن يقيّد التصرف وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز للمرخص له الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق الشروط الآتية:</p>\\n<p>1- أن تتضمن اتفاقية المساهمة إمكان الاقتراض بضمان أموال المساهمة العقارية أو أصولها.<br>2- موافقة الجمعية على الاقتراض.</p>\\n<p>3- ألا يتجاوز مبلغ الاقتراض نصف رأس مال المساهمة العقارية.<br>4- أن تخصّص الأموال المقترضة؛ لأغراض المساهمة العقارية.<br>5- أن تحوَّل الأموال المقترضة إلى حساب الضمان مباشرة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن (5%) منها، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ممارسو نشاط المساهمات العقارية هم الآتي:</p>\\n<p>1- المرخص له.<br>2- مدير المساهمة العقارية.<br>3- الاستشاري الهندسي.<br>4- المحاسب القانوني<br>5- المقيم المعتمد.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88b4081d4b044448871679abfd101bdf\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الهيئة -بقرار من المجلس- الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في مدير المساهمة العقارية الآتي:</p>\\n<p>1- أن يتمتع بالخبرة اللازمة لإدارة المساهمة العقارية.<br>2- ألا يكون قد سبق أن أدين بجريمة مخلة بالشرف أو الأمانة.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في الاستشاري الهندسي الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمهندسين. &nbsp;<br>2- أن يكون لديه خبرة في مجال البناء والتشييد وإدارة المشاريع لا تقل مدتها عن (ثلاث) سنوات.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المحاسب القانوني الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمراجعين والمحاسبين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.<br>3- أن يكون مسجلا لدى هيئة السوق المالية في حال طرح شهادات المساهمات العقارية طرحاً عاماً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المقيم المعتمد الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمقيمين المعتمدين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp;تعتمد الهيئة متوسط القيمة بين تقارير تقييم العقار المعدة من المقيمين المعتمدين.<br>2- &nbsp; &nbsp; &nbsp;يستبدل التقييم الذي يتجاوز فيه الاختلاف عن التقريرين الآخرين ما نسبته (10%) زيادةً أو نقصاً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يختص المرخص له بالآتي:</p>\\n<p>1- تجهيز كل ما يلزم من متطلبات وموافقات لإصدار الترخيص وفق اشتراطات النظام واللائحة.<br>2- تعيين مدير المساهمة العقارية، والإشراف على أعماله، وتمكينه من القيام بواجباته.<br>3- تعيين محاسب قانوني واستشاري هندسي للمساهمة العقارية.<br>4- فتح حساب ضمان باسم المساهمة العقارية في أحد البنوك المرخص لها.<br>5- تنفيذ الصرف من حساب الضمان وإدارته؛ بناءً على إجراءات الصرف.<br>6- إبرام العقود اللازمة لمصلحة المساهمة العقارية.<br>7- الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق أحكام النظام واللائحة.<br>8- بيع أصول المساهمة العقارية وفق أحكام النظام واللائحة.<br>9- ترؤّس الجمعية أو تعيين من يمثله في رئاستها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المرخص له بالآتي:</p>\\n<p>1- تعيين مؤسسة سوق مالية مرخص لها؛ وذلك وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.<br>2- الإفصاح للمساهمين دون تأخير عن أي تطورات جوهرية في عمليات المساهمة العقارية، أو وضعها المالي، أو كيانها التنظيمي، أو ملكيتها.<br>3-&nbsp; عدم تلقي أي مبلغ ذي صلة بالمساهمة العقارية سواءً بشكل نقدي أو بإيداع في حساب مصرفي خاص. وأن تكون جميع الإيداعات في حساب الضمان فقط.<br>4- تقديم تقارير دورية للمساهمين والهيئة، بما في ذلك التقارير الفنية والمالية وأي تقارير إضافية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/222af533409c404f8c484caab1a44ff3\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على الاستشاري الهندسي أن يؤدي عمله في الإشراف على المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- الإشراف والمتابعة لأعمال المساهمة العقارية وفقًا للمواصفات والمعايير الهندسية والمتطلبات النظامية والتصاميم الهندسية، ووفق ما نص عليه العقد المبرم معه.<br>2- التدقيق والمصادقة على وثيقة الصرف.<br>3- إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على المحاسب القانوني أن يؤدي عمله في المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- مراجعة المستندات المالية اللازمة لعمليات الصرف على المساهمة العقارية، وتدقيقها.<br>2- التحقق من البيانات المالية الخاصة بالمساهمة العقارية، والتأكّد من أن جميع أموال المساهمة العقارية أودعت في حساب الضمان.<br>3- التدقيق والمصادقة على وثيقة الصرف.<br>4- أي مهمة أخرى تتصل باختصاصاته وفقًا لما تصدره الهيئة من تعليمات.<br>5-إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>اختصاصات مدير المساهمة العقارية ومسؤولياته هي:</p>\\n<p>1- التحقق من إيداع جميع العوائد في حساب الضمان.<br>2- توزيع أرباح المساهمة العقارية وفق أحكام النظام واللائحة.<br>3- إبلاغ المرخص له والهيئة عن أي حدث أو تطور جوهري قد يؤثر على المساهمة العقارية.<br>4- مراجعة التقارير عن أعمال المقاول والاستشاري الهندسي والمحاسب القانوني في المساهمة العقارية، وأرشفتها.<br>5- الدعوة لعقد اجتماعات الجمعية.<br>6- تنفيذ عمليات بيع أصول المساهمة العقارية بناء على تفويض المرخص له وبحسب الإجراءات المنصوص عليها في اللائحة.<br>7- رفع التقارير الدورية لكل الأطراف المعنية، إلى كل من (الهيئة، والجمعية، والمرخص له).<br>8- مخاطبة الجهات فيما يتعلق بالمساهمة العقارية.<br>9- أي مهمة أخرى يكلفه بها المرخص له في حدود أعمال المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">1- يجوز للمرخص له أو الجمعية عزل مدير المساهمة العقارية إن أساء استخدام صلاحياته أو أخلّ بتنفيذ التزاماته؛ وفق الإجراءات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; أ‌- رفع طلب عزله إلى الهيئة مرفقاً به الأسباب الداعية إلى ذلك<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ب‌- تبت الهيئة في الطلب خلال مدة لا تتجاوز (خمسة) أيام عمل<br>2- يجوز للهيئة أن تعزل مدير المساهمة العقارية إن ثبتت مخالفته لأحكام النظام أو اللائحة، وتبلغ المرخص له بذلك.<br>3- على المرخص له تعيين مدير للمساهمة خلال (خمسة) أيام عمل من تاريخ تبليغه بقرار الهيئة بالموافقة على عزل مدير المساهمة السابق.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- يجب على كل ممارسي نشاط المساهمات العقارية، الإفصاح للجمعية عن أي مصلحة مباشرة أو غير مباشرة، أو التي تنطوي على تعارض مصالح قائم أو محتمل لهم أو لأي من أقاربهم حتى الدرجة الرابعة في أي مشروع أو اتفاق يعقد مع المساهمة العقارية، ويكون باطلاً أي تصرف مخالف لأحكام هذه المادة.<br>2- لا يجوز للمرخص له ومدير المساهمة العقارية الاشتراك في التصويت على قرارات الجمعية، التي لأي منهما فيها مصلحة مباشرة أو غير مباشرة أو التي تنطوي على تعارض مصالح قائم أو محتمل.<br>3- يجوز لكل ممارسي نشاط المساهمات العقارية -بعد الحصول على موافقة الجمعية- إكمال الإجراءات التي تنطوي على مصلحة أو تعارض مصالح.<br>4- يكون كلّ ممارس نشاط المساهمات العقارية -بحسب الأحوال - مسؤولاً عن الآثار المترتبة على التعارض بين مصالحه الخاصة ومصالح المساهمة العقارية؛ إذا لم يفصح للجمعية عنه، ولا يخلّ ذلك بأي عقوبة أشد يقضي بها نظام آخر.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac1d9fef0896413a928384f679a04556\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تختص الجمعية بالآتي:</p>\\n<p>1- الموافقة على إلغاء الترخيص وتصفية المساهمة العقارية أو بيعها.<br>2- الموافقة على تعديل اتفاقية المساهمة.<br>3- اعتماد القوائم المالية للمساهمة العقارية.<br>4- التصويت على عزل مدير المساهمة العقارية.<br>5- الموافقة على التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية.<br>6- الموافقة على الاقتراض بضمان أموال المساهمة العقارية أو أصولها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>وسائل التقنية الحديثة لحضور اجتماعات هي كل وسيلة اتصال معتمدة وفق (نظام التعاملات الإلكترونية) الصادر بالمرسوم الملكي رقم م/18 وتاريخ 08/03/1428هـ وتعديلاته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب -عند الدعوة إلى عقد اجتماع الجمعية- وضع الإجراءات اللازمة للتحقق من هوية المساهم الذي يصوت من خلال وسائل التقنية الحديثة والمساهم الحاضر في اجتماع الجمعية، وعن أحقيته في التصويت على أيٍّ من بنود الاجتماع، ومن ذلك الدخول من خلال منصة النفاذ الوطني.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">1-تتكون الأرباح القابلة للتوزيع من صافي دخل المساهمة مخصوماً منه جميع المبالغ التي يتم تجنيبها إلى الاحتياطي المخصص لأغراض محددة في اتفاقية المساهمة - إن وجد -.<br>2-يجوز للمساهمة العقارية توزيع أرباح مرحلية ناتجة عن متحصلات البيع على مساهميها بشكل نصف سنوي أو ربع سنوي -إذا نصت اتفاقية المساهمة على جواز ذلك- بعد استيفاء المتطلبات الآتية:<br>                                 ‌أ- موافقة جمعية المساهمين<br>                          ‌ب- أن تكون المساهمة ذات ربحية جيدة ومنتظمة<br>                            ‌ج- أن يتوافر لديها سيولة معقولة، وتستطيع أن تتوقع بدرجة معقولة مستوى أرباحها<br>                               ‌د- أن يتوفر لدى المساهمة أرباح قابلة للتوزيع وفقاً لآخر قوائم مالية مراجعة، كافية لتغطية الأرباح المقترح توزيعها.<br>3-يجب على مدير المساهمة أن يفصح للهيئة والمساهمين فوراً ومن دون تأخير عند اتخاذ قرار توزيع الأرباح.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74e1c64f17984584866f3a47653d9529\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>في تنفيذ أحكام المادة (السابعة والعشرون) من النظام، تسري الأحكام الآتية:</p>\\n<p>1- يجب تقييم أصول المساهمة العقارية من ثلاثة مقيمين مستقلين عن المرخص له، ومعتمدين وفقاً لنظام المقيمين المعتمدين.<br>2- يجب عرض التقييم على الجمعية، للحصول على موافقتها. وللجمعية طلب إعادة التقييم بما لا يتجاوز مرتين.<br>3- ألا تتجاوز المدة بين تقرير التقييم وتاريخ البيع؛ (ثلاثة) أشهر.<br>4- تكون إجراءات البيع من خلال المرخص له أو مدير المساهمة العقارية، بحسب ما تنص عليه اتفاقية المساهمة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>لمسؤول الضبط -في سبيل القيام بأعمال التفتيش- اتخاذ أي من الإجراءات الآتية:</p>\\n<p>1- فحص مقر المرخص له والوثائق والمشاريع المتعلقة بالأنشطة المشمولة بالنظام، وأيٍّ من المستندات والوثائق والبيانات والسجلات والمرافق المتعلقة بالمساهمة العقارية.<br>2- الحصول على نُسَخ من أي ترخيص أو تصريح أو شهادة أو سجل أو وثيقة أو غيرها.<br>3- التحفظ على الوثائق والسجلات ونحوها.<br>4- التصوير بأي من الوسائل المتاحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>على مسؤول الضبط -عند ضبط مخالفة- إعداد محضر متضمّنًا ما يأتي:</p>\\n<p>1- المعلومات والبيانات بما يشمل بيانات مسؤول الضبط وتاريخ التفتيش ووقته ومكانه.<br>2- بيانات المرخص له.<br>3- الوقائع بما يشمل ملخص ما قام به مسؤول الضبط.<br>4- رصد وقائع المخالفات ووصفها.<br>5- قائمة بما تم ضبطه أو التحفظ عليه من أصول أو مستندات أو معلومات وغيرها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يحيل مسؤول الضبط محضر ضبط المخالفة إلى لجنة النظر في مخالفات أحكام النظام المنصوص عليها في المادة (الثالثة والثلاثين) من النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصرف لمسؤول الضبط مكافأة قدرها ثلاثة رواتب أساسية مرتبطة بتقييم الأداء.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنشر اللائحة في الجريدة الرسمية، ويعمل بها من تاريخ نشرها</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f52bb5b1336483589c712fe2d16a455\",\n      \"title\": \"إجراءات الترخيص\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\",\n      \"title\": \"أحكام رأس مال المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a5139383e19a415baed15739b7798ae0\",\n      \"title\": \"ممارسو نشاط المساهمات العقارية واختصاصتهم\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5c928964c4974d8a9435f5b54642aa48\",\n      \"title\": \"جمعية المساهمين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/be5ee7bc8267405fb0e827895294c97c\",\n      \"title\": \"توزيع الأرباح وتصفية المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\",\n      \"title\": \"الرقابة والتفتيش والضبط\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (en-us)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/584815b7178c4757a721596c4b81bf91\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8ee0e734748542ca959cc362bb265511\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\"\n      },\n      {\n        \"contentUdi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/88b4081d4b044448871679abfd101bdf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\"\n      },\n      {\n        \"contentUdi\": \"umb://element/222af533409c404f8c484caab1a44ff3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\"\n      },\n      {\n        \"contentUdi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ac1d9fef0896413a928384f679a04556\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74e1c64f17984584866f3a47653d9529\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\"\n      },\n      {\n        \"contentUdi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2a955894f526414f8ff2b44360f8fa56\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>تنطبق معاني الألفاظ والعبارات المنصوص عليها في المادة (الأولى) من النظام على اللائحة، يُقصد بالعبارات الاتية – أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها، مالم يقتض السياق غير ذلك:</p>\\n<p>طالب الترخيص: المطور العقاري المتقدم بطلب ترخيص المساهمة العقارية.</p>\\n<p>رأس مال المساهمة العقارية: الحصص النقدية والعينية المقدمة للمساهمة العقارية والمقسمة الى قيم متساوية.</p>\\n<p>اتفاقية المساهمة: وثيقة بين المرخص له والمساهمين لأغراض المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/584815b7178c4757a721596c4b81bf91\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يكون مشروع التطوير العقاري -والمشار إليه في المادة (الأولى) من النظام- خاضعاً للترخيص في حال اشترك فيه خمسة أشخاص فأكثر.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>تصنف المساهمات العقارية حسب الحجم وفق الآتي:</p>\\n<p>أ‌-          مساهمة صغيرة يقل رأس مالها عن خمسين مليون ريال.<br>ب‌-   مساهمة متوسطة لا يقل رأس مالها عن خمسين مليون ريال ولا يزيد عن ثلاث مئة مليون ريال.<br>ت‌-   مساهمة كبيرة يتجاوز رأس مالها ثلاث مئة مليون ريال.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/81fd88a41ccc4f22a35dd17975651756\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز الترخيص لعدة مساهمات عقارية على ذات العقار خلال فترة واحدة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aea4801aab33450a9c85f9fafd0e5abf\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; يجب أن يتخذ العقار محل المساهمة العقارية إحدى الصورتين الآتيتين:</p>\\n<p>&nbsp;1 - &nbsp; &nbsp; أن يكون حصة عينية مسجلة في المساهمة العقارية.<br>&nbsp;2 - &nbsp; &nbsp; أن يكون مشترى لمصلحة المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8ee0e734748542ca959cc362bb265511\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp;1 - &nbsp; &nbsp; إذا كان العقار سيُشترى لمصلحة المساهمة العقارية، فيشترط إبرام اتفاقية مع مالك العقار متضمنة التزامه بنقل ملكية العقار للمساهمة العقارية بعد صدور الترخيص.<br>&nbsp;2 - &nbsp; &nbsp; يجب على مالك العقار نقل ملكية العقار محل المساهمة العقارية إلى المساهمة العقارية بعد صدور الترخيص وقبل الطرح وجمع الأموال، وينص في ضبط المبايعة على أن البيع معلق على شرط سداد المبلغ في الوقت المحدد.<br>&nbsp;3 - &nbsp; &nbsp; يجوز الاشتراك في المساهمة العقارية بحصة عينية، بعقار يكون محلاًّ لها، ويشترط في الحصة العينية الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌أ- &nbsp; &nbsp; &nbsp;أن تكون مملوكة للمساهم وقت تقديمها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ب- &nbsp; &nbsp; أن تُضمّن في اتفاقية المساهمة.<br>&nbsp;4 - &nbsp; &nbsp; يجب على المساهم نقل ملكية العقار إلى المساهمة العقارية بعد حصولها على الترخيص، خلال مدة لا تتجاوز (خمسة) أيام عمل.<br>&nbsp;5 - &nbsp; &nbsp; في حال عدم اكتمال طرح المساهمة وجمع الأموال فتعاد ملكية العقار إلى مالكه الأساس وفق خطاب من الهيئة.<br>&nbsp;6 - &nbsp; &nbsp; يجب أن يحتفظ المساهم بالحصة العينية في السنة الأولى بكامل حصصه، ويجوز أن يتصرف في السنة الثانية -وحتى انقضاء المساهمة العقارية- بما لا يزيد على (50%) من حصته في المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>تُنظَّم أحكام جمع الأموال للمساهمات العقارية، وإصدار شهاداتها، وتنظيم سجل المساهمين الخاص بها، وفقًا لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/99440ad5396e43ceb17276eb477067bb\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يُقدَّم طلب الترخيص إلى الهيئة وفقًا للنموذج الذي تعده الهيئة لهذا الغرض، مرفقًا به الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp;شهادة من جهة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب الترخيص، على ألاّ يتجاوز تاريخ إصدار الشهادة (ثلاثة أشهر) من تاريخ تقديم الطلب.<br>2- &nbsp; &nbsp; &nbsp;رقم السجل العقاري أو وثيقة تملك العقار محل المساهمة العقارية سارية المفعول ثابتة سلامتها، قابلة للتصرف بناء على إفادة من الجهة التي أصدرتها.<br>3- &nbsp; &nbsp; &nbsp;الموافقات النظامية -بحسب الأحوال- من وزارة الشؤون البلدية والقروية والإسكان أو وزارة الطاقة أو الهيئة، أو غيرها من الجهات المختصة وفق أنظمتها.<br>4- &nbsp; &nbsp; &nbsp;دراسة جدوى اقتصادية للمساهمة العقارية باللغة العربية معتمدة من مكتب مرخص في المملكة، متضمنة البيانات المالية والإنشائية والتسويقية المقدرة، والمصاريف المالية والإدارية المتوقعة لجميع تكاليف التطوير لمشروع المساهمة، والمدة المتوقعة لإتمامه، ومراحل التنفيذ، ومصادر التمويل المتوقعة، وحالات إضافة المبلغ الاحتياطي.<br>5- &nbsp; &nbsp; &nbsp;وصف محل المساهمة العقارية.<br>6- &nbsp; &nbsp; &nbsp;تحديد رأس مال المساهمة العقارية.<br>7- &nbsp; &nbsp; &nbsp;تعبئة نموذج اتفاقية المساهمة.<br>8- &nbsp; &nbsp; &nbsp;الاتفاقية مع الاستشاري الهندسي على أن تشمل الالتزامات والمهام المناطة به.<br>9- &nbsp; &nbsp; &nbsp;الاتفاقية مع المحاسب القانوني على أن تشمل الالتزامات والمهام المناطة به.<br>10- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;الاتفاقية مع مدير المساهمة العقارية.<br>11- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;الاتفاقية المبرمة مع مالك العقار وفق المادة (السادسة) من اللائحة، إن وجدت.<br>12- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;تقييم العقار محل المساهمة العقارية من ثلاثة مقيمين معتمدين.<br>13- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;تعيين مؤسسة سوق مالية وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp;تدرس الهيئة طلب الترخيص خلال مدة لا تتجاوز (عشرة) أيام عمل ولها عند الحاجة لأي بيانات أو مستندات إضافية ترى ضرورتها، إشعار طالب الترخيص، وعليه استكمال ما يلزم خلال مدة لا تتجاوز (ستين) يوما من تاريخ إبلاغه بذلك، وللهيئة تمديدها لمدة (ثلاثين) يوماً إضافية، وإلا عدّ الطلب مرفوضا.<br>2- &nbsp; &nbsp; &nbsp;تصدر الهيئة موافقة مشروطة على طلب الترخيص باستكمال إجراءات الترخيص، أو ترفض الطلب مع ذكر مسببات الرفض.<br>3- &nbsp; &nbsp; &nbsp;يستكمل طالب الترخيص – بعد الحصول على الموافقة المشروطة على طلب الترخيص - إجراءات طرح شهادات المساهمة العقارية وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة من هيئة السوق المالية.<br>4- &nbsp; &nbsp; &nbsp;تصدر الهيئة الترخيص -بعد استكمال ما ورد في الفقرتين (2) و(3) من هذه المادة-متضمنًا البيانات التالية:<br>‌أ- &nbsp; &nbsp; رقم الترخيص.<br>‌ب- &nbsp;اسم المرخص له.<br>‌ج- &nbsp; &nbsp;مدة الترخيص.<br>‌د- &nbsp; &nbsp; &nbsp; اسم المساهمة العقارية والبيانات المالية والتخطيطية للعقار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5c97f7415b84597ba1c9703d381ab1e\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>تضع الهيئة نموذجاً لاتفاقية المساهمة، على أن يتضمن -بحد أدنى- البيانات الآتية:</p>\\n<p>1- &nbsp; &nbsp; &nbsp;بيانات أطراف الاتفاقية.<br>2- &nbsp; &nbsp; &nbsp;اسم المساهمة العقارية، ومقرها، وعنوان التواصل.<br>3- &nbsp; &nbsp; &nbsp;وصف محل المساهمة العقارية.<br>4- &nbsp; &nbsp; &nbsp;مدة المساهمة العقارية وآلية تمديدها.<br>5- &nbsp; &nbsp; &nbsp;مقدار رأس مال المساهمة العقارية.<br>6- &nbsp; &nbsp; &nbsp;المصاريف المالية للمساهمة العقارية.<br>7- &nbsp; &nbsp; &nbsp;اقتراح المبلغ الاحتياطي لرأس مال المساهمة العقارية، إن وجد.<br>8- &nbsp; &nbsp; &nbsp;مقدار الحصص النقدية والعينية.<br>9- &nbsp; &nbsp; &nbsp;آليات تصرف المساهمين بحصصهم.<br>10- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;الأحكام المنظّمة للاقتراض بضمان أموال المساهمة العقارية وأصولها.<br>11- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;عمولة المرخص له نظير أتعابه.<br>12- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;إعداد القوائم المالية والإفصاحات الدورية للمساهمين بشكل نصف سنوي، ومراجعتها بشكل سنوي.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6c1b3f691dbd4461838724587ee88c23\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز -بناءً على طلب المرخص له قبل طرح المساهمة العقارية- تعديل الترخيص باتّباع الإجراءات المنصوص عليها في النظام واللائحة وتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية، أو إلغاء الترخيص نهائياً؛ دون إخلال بالحقوق المترتبة قبل الإلغاء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/03d6e5355c774f8c89fbbb72b793de3f\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>في حال اشترطت الهيئة إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية -وفقًا لما قضت به المادة (السابعة) من النظام-؛ فيكون التصرف بذلك المبلغ وفقًا للشروط الآتية:</p>\\n<p>1- &nbsp; &nbsp; &nbsp;أن يكون بموافقة الجمعية.<br>2- &nbsp; &nbsp; &nbsp;أن يكون الغرض من التصرف هو التعامل مع مصاريف غير متوقعة وقت تحديد رأس مال المساهمة العقارية.<br>3- &nbsp; &nbsp; &nbsp;إبلاغ الهيئة بالتصرف، ومقداره، خلال مدة لا تتجاوز (5) أيام عمل من تاريخ موافقة الجمعية على التصرف.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9f3827dd753f45ab83e29f9cff379c72\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp;في حال عدم التصرف في المبلغ الاحتياطي المشار إليه في المادة (السابعة) من النظام، أو تم التصرف بجزء منه، فتكون إعادته إلى المساهمين -بعد انقضاء المساهمة العقارية- وفقًا لحصة كل منهم في المبلغ الاحتياطي.<br>2- &nbsp; &nbsp; &nbsp;على المرخص له -قبل التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية لمواجهة أي مصاريف إضافية غير متوقعة- عرض ذلك على الجمعية للتصويت في شأنها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>للمساهم التصرف بحصته في المساهمة العقارية وفق الشروط الآتية:</p>\\n<p>1- &nbsp; &nbsp; &nbsp;أن تضمن اتفاقية المساهمة آلية التصرف.<br>2- &nbsp; &nbsp; &nbsp;أن يقيّد التصرف وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bccc4814637241c0b80f4c3935c12df0\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز للمرخص له الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق الشروط الآتية:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;أن تتضمن اتفاقية المساهمة إمكان الاقتراض بضمان أموال المساهمة العقارية أو أصولها.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;موافقة الجمعية على الاقتراض.</p>\\n<p>3- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ألا يتجاوز مبلغ الاقتراض نصف رأس مال المساهمة العقارية.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;أن تخصّص الأموال المقترضة؛ لأغراض المساهمة العقارية.<br>5- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;أن تحوَّل الأموال المقترضة إلى حساب الضمان مباشرة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7aadf2e0b674736a0fb64e580f70adb\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن (5%) منها، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f390cd7ac2d049ad923d19753d61a41f\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>ممارسو نشاط المساهمات العقارية هم الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;المرخص له.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;مدير المساهمة العقارية.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;الاستشاري الهندسي.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;المحاسب القانوني<br>5- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;المقيم المعتمد.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/88b4081d4b044448871679abfd101bdf\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تصدر الهيئة -بقرار من المجلس- الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f9e9737107d94adfa0f27df275544b3b\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في مدير المساهمة العقارية الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; أن يتمتع بالخبرة اللازمة لإدارة المساهمة العقارية.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; ألا يكون قد سبق أن أدين بجريمة مخلة بالشرف أو الأمانة.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في الاستشاري الهندسي الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; أن يكون معتمدًا من الهيئة السعودية للمهندسين. &nbsp;<br>2- &nbsp; &nbsp; &nbsp; &nbsp; أن يكون لديه خبرة في مجال البناء والتشييد وإدارة المشاريع لا تقل مدتها عن (ثلاث) سنوات.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f05091b7ed446fa97e1b16e7dba7885\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المحاسب القانوني الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; أن يكون معتمدًا من الهيئة السعودية للمراجعين والمحاسبين.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; أن يكون مسجلا لدى هيئة السوق المالية في حال طرح شهادات المساهمات العقارية طرحاً عاماً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3b3f07435f31480d8a2182d2e576c4e6\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يشترط في المقيم المعتمد الممارس لنشاط المساهمات العقارية الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; أن يكون معتمدًا من الهيئة السعودية للمقيمين المعتمدين.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e366bd869b6444e78e18abb746f94b95\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp;تعتمد الهيئة متوسط القيمة بين تقارير تقييم العقار المعدة من المقيمين المعتمدين.<br>2- &nbsp; &nbsp; &nbsp;يستبدل التقييم الذي يتجاوز فيه الاختلاف عن التقريرين الآخرين ما نسبته (10%) زيادةً أو نقصاً.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يختص المرخص له بالآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;تجهيز كل ما يلزم من متطلبات وموافقات لإصدار الترخيص وفق اشتراطات النظام واللائحة.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;تعيين مدير المساهمة العقارية، والإشراف على أعماله، وتمكينه من القيام بواجباته.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;تعيين محاسب قانوني واستشاري هندسي للمساهمة العقارية.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;فتح حساب ضمان باسم المساهمة العقارية في أحد البنوك المرخص لها.<br>5- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;تنفيذ الصرف من حساب الضمان وإدارته؛ بناءً على إجراءات الصرف.<br>6- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;إبرام العقود اللازمة لمصلحة المساهمة العقارية.<br>7- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق أحكام النظام واللائحة.<br>8- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;بيع أصول المساهمة العقارية وفق أحكام النظام واللائحة.<br>9- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ترؤّس الجمعية أو تعيين من يمثله في رئاستها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/89fb47adaae6494b9ad9789d93ec24ac\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المرخص له بالآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; تعيين مؤسسة سوق مالية مرخص لها؛ وذلك وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; الإفصاح للمساهمين دون تأخير عن أي تطورات جوهرية في عمليات المساهمة العقارية، أو وضعها المالي، أو كيانها التنظيمي، أو ملكيتها.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;عدم تلقي أي مبلغ ذي صلة بالمساهمة العقارية سواءً بشكل نقدي أو بإيداع في حساب مصرفي خاص. وأن تكون جميع الإيداعات في حساب الضمان فقط.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; تقديم تقارير دورية للمساهمين والهيئة، بما في ذلك التقارير الفنية والمالية وأي تقارير إضافية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/222af533409c404f8c484caab1a44ff3\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على الاستشاري الهندسي أن يؤدي عمله في الإشراف على المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; الإشراف والمتابعة لأعمال المساهمة العقارية وفقًا للمواصفات والمعايير الهندسية والمتطلبات النظامية والتصاميم الهندسية، ووفق ما نص عليه العقد المبرم معه.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; التدقيق والمصادقة على وثيقة الصرف.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/51896ee0a6654e408445aced5b9a7483\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>على المحاسب القانوني أن يؤدي عمله في المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; مراجعة المستندات المالية اللازمة لعمليات الصرف على المساهمة العقارية، وتدقيقها.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; التحقق من البيانات المالية الخاصة بالمساهمة العقارية، والتأكّد من أن جميع أموال المساهمة العقارية أودعت في حساب الضمان.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; التدقيق والمصادقة على وثيقة الصرف.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; أي مهمة أخرى تتصل باختصاصاته وفقًا لما تصدره الهيئة من تعليمات.<br>5- &nbsp; &nbsp; &nbsp; &nbsp; إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/353af6e717a045148f8176e5e5e7eb0d\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>اختصاصات مدير المساهمة العقارية ومسؤولياته هي:</p>\\n<p>1- &nbsp; &nbsp; &nbsp; &nbsp; التحقق من إيداع جميع العوائد في حساب الضمان.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; توزيع أرباح المساهمة العقارية وفق أحكام النظام واللائحة.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; إبلاغ المرخص له والهيئة عن أي حدث أو تطور جوهري قد يؤثر على المساهمة العقارية.<br>4- &nbsp; &nbsp; &nbsp; &nbsp; مراجعة التقارير عن أعمال المقاول والاستشاري الهندسي والمحاسب القانوني في المساهمة العقارية، وأرشفتها.<br>5- &nbsp; &nbsp; &nbsp; &nbsp; الدعوة لعقد اجتماعات الجمعية.<br>6- &nbsp; &nbsp; &nbsp; &nbsp; تنفيذ عمليات بيع أصول المساهمة العقارية بناء على تفويض المرخص له وبحسب الإجراءات المنصوص عليها في اللائحة.<br>7- &nbsp; &nbsp; &nbsp; &nbsp; رفع التقارير الدورية لكل الأطراف المعنية، إلى كل من (الهيئة، والجمعية، والمرخص له).<br>8- &nbsp; &nbsp; &nbsp; &nbsp; مخاطبة الجهات فيما يتعلق بالمساهمة العقارية.<br>9- &nbsp; &nbsp; &nbsp; &nbsp; أي مهمة أخرى يكلفه بها المرخص له في حدود أعمال المساهمة العقارية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp; &nbsp; يجوز للمرخص له أو الجمعية عزل مدير المساهمة العقارية إن أساء استخدام صلاحياته أو أخلّ بتنفيذ التزاماته؛ وفق الإجراءات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; أ‌- &nbsp; &nbsp; &nbsp; &nbsp; رفع طلب عزله إلى الهيئة مرفقاً به الأسباب الداعية إلى ذلك.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ب‌- &nbsp; &nbsp; &nbsp;تبت الهيئة في الطلب خلال مدة لا تتجاوز (خمسة) أيام عمل.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; يجوز للهيئة أن تعزل مدير المساهمة العقارية إن ثبتت مخالفته لأحكام النظام أو اللائحة، وتبلغ المرخص له بذلك.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; على المرخص له تعيين مدير للمساهمة خلال (خمسة) أيام عمل من تاريخ تبليغه بقرار الهيئة بالموافقة على عزل مدير المساهمة السابق.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp; &nbsp; يجب على كل ممارسي نشاط المساهمات العقارية، الإفصاح للجمعية عن أي مصلحة مباشرة أو غير مباشرة، أو التي تنطوي على تعارض مصالح قائم أو محتمل لهم أو لأي من أقاربهم حتى الدرجة الرابعة في أي مشروع أو اتفاق يعقد مع المساهمة العقارية، ويكون باطلاً أي تصرف مخالف لأحكام هذه المادة.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;لا يجوز للمرخص له ومدير المساهمة العقارية الاشتراك في التصويت على قرارات الجمعية، التي لأي منهما فيها مصلحة مباشرة أو غير مباشرة أو التي تنطوي على تعارض مصالح قائم أو محتمل.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; يجوز لكل ممارسي نشاط المساهمات العقارية -بعد الحصول على موافقة الجمعية- إكمال الإجراءات التي تنطوي على مصلحة أو تعارض مصالح.<br>4- &nbsp; &nbsp; &nbsp;يكون كلّ ممارس نشاط المساهمات العقارية -بحسب الأحوال - مسؤولاً عن الآثار المترتبة على التعارض بين مصالحه الخاصة ومصالح المساهمة العقارية؛ إذا لم يفصح للجمعية عنه، ولا يخلّ ذلك بأي عقوبة أشد يقضي بها نظام آخر.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ac1d9fef0896413a928384f679a04556\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تختص الجمعية بالآتي:</p>\\n<p>1- الموافقة على إلغاء الترخيص وتصفية المساهمة العقارية أو بيعها.<br>2- الموافقة على تعديل اتفاقية المساهمة.<br>3- اعتماد القوائم المالية للمساهمة العقارية.<br>4- التصويت على عزل مدير المساهمة العقارية.<br>5- الموافقة على التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية.<br>6- الموافقة على الاقتراض بضمان أموال المساهمة العقارية أو أصولها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d2caee046ae240a880eefce919a1dca1\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>وسائل التقنية الحديثة لحضور اجتماعات هي كل وسيلة اتصال معتمدة وفق (نظام التعاملات الإلكترونية) الصادر بالمرسوم الملكي رقم م/18 وتاريخ 08/03/1428هـ وتعديلاته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب -عند الدعوة إلى عقد اجتماع الجمعية- وضع الإجراءات اللازمة للتحقق من هوية المساهم الذي يصوت من خلال وسائل التقنية الحديثة والمساهم الحاضر في اجتماع الجمعية، وعن أحقيته في التصويت على أيٍّ من بنود الاجتماع، ومن ذلك الدخول من خلال منصة النفاذ الوطني.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9a547251dbc94a448b0b8d28f8c99112\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>1- &nbsp; &nbsp; &nbsp; &nbsp; تتكون الأرباح القابلة للتوزيع من صافي دخل المساهمة مخصوماً منه جميع المبالغ التي يتم تجنيبها إلى الاحتياطي المخصص لأغراض محددة في اتفاقية المساهمة - إن وجد -.<br>2- &nbsp; &nbsp; &nbsp; &nbsp; يجوز للمساهمة العقارية توزيع أرباح مرحلية ناتجة عن متحصلات البيع على مساهميها بشكل نصف سنوي أو ربع سنوي -إذا نصت اتفاقية المساهمة على جواز ذلك- بعد استيفاء المتطلبات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; &nbsp; &nbsp;موافقة جمعية المساهمين.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ب- &nbsp; &nbsp; &nbsp; &nbsp;أن تكون المساهمة ذات ربحية جيدة ومنتظمة.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ج- &nbsp; &nbsp; &nbsp; &nbsp;أن يتوافر لديها سيولة معقولة، وتستطيع أن تتوقع بدرجة معقولة مستوى أرباحها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; &nbsp; &nbsp;أن يتوفر لدى المساهمة أرباح قابلة للتوزيع وفقاً لآخر قوائم مالية مراجعة، كافية لتغطية الأرباح المقترح توزيعها.<br>3- &nbsp; &nbsp; &nbsp; &nbsp; يجب على مدير المساهمة أن يفصح للهيئة والمساهمين فوراً ومن دون تأخير عند اتخاذ قرار توزيع الأرباح.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74e1c64f17984584866f3a47653d9529\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>في تنفيذ أحكام المادة (السابعة والعشرون) من النظام، تسري الأحكام الآتية:</p>\\n<p>1- يجب تقييم أصول المساهمة العقارية من ثلاثة مقيمين مستقلين عن المرخص له، ومعتمدين وفقاً لنظام المقيمين المعتمدين.<br>2- يجب عرض التقييم على الجمعية، للحصول على موافقتها. وللجمعية طلب إعادة التقييم بما لا يتجاوز مرتين.<br>3- ألا تتجاوز المدة بين تقرير التقييم وتاريخ البيع؛ (ثلاثة) أشهر.<br>4- تكون إجراءات البيع من خلال المرخص له أو مدير المساهمة العقارية، بحسب ما تنص عليه اتفاقية المساهمة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>لمسؤول الضبط -في سبيل القيام بأعمال التفتيش- اتخاذ أي من الإجراءات الآتية:</p>\\n<p>1- فحص مقر المرخص له والوثائق والمشاريع المتعلقة بالأنشطة المشمولة بالنظام، وأيٍّ من المستندات والوثائق والبيانات والسجلات والمرافق المتعلقة بالمساهمة العقارية.<br>2- الحصول على نُسَخ من أي ترخيص أو تصريح أو شهادة أو سجل أو وثيقة أو غيرها.<br>3- التحفظ على الوثائق والسجلات ونحوها.<br>4- التصوير بأي من الوسائل المتاحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>على مسؤول الضبط -عند ضبط مخالفة- إعداد محضر متضمّنًا ما يأتي:</p>\\n<p>1- المعلومات والبيانات بما يشمل بيانات مسؤول الضبط وتاريخ التفتيش ووقته ومكانه.<br>2- بيانات المرخص له.<br>3- الوقائع بما يشمل ملخص ما قام به مسؤول الضبط.<br>4- رصد وقائع المخالفات ووصفها.<br>5- قائمة بما تم ضبطه أو التحفظ عليه من أصول أو مستندات أو معلومات وغيرها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b7ed236ea16e4232838d9119affa6117\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يحيل مسؤول الضبط محضر ضبط المخالفة إلى لجنة النظر في مخالفات أحكام النظام المنصوص عليها في المادة (الثالثة والثلاثين) من النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصرف لمسؤول الضبط مكافأة قدرها ثلاثة رواتب أساسية مرتبطة بتقييم الأداء.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1775e6f489ab4ac99f9f698b176435e9\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنشر اللائحة في الجريدة الرسمية، ويعمل بها من تاريخ نشرها</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - description","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللائحة التنفيذية لنظام المساهمات العقارية","change":"Update"},{"success":true,"name":"Property - header (ar-jo)","path":"/Properties/*/Value","oldValue":"اللائحة التنفيذية لنظام المساهمات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - header (en-us)","path":"/Properties/*/Value","oldValue":"اللائحة التنفيذية لنظام المساهمات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"اللائحة التنفيذية لنظام المساهمات العقارية\",\n  \"المساهمات\",\n  \"المساهمات العقارية\",\n  \"نظام المساهمات العقارية\",\n  \"الانظمة واللوائح والادلة\",\n  \"لوائح\",\n  \"الهيئة العامة للعقار\"\n]","change":"Update"},{"success":true,"name":"Property - legislationDocuments (ar-jo)","path":"/Properties/*/Value","oldValue":"[]","newValue":"","change":"Delete"},{"success":true,"name":"Property - pageName","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللائحة التنفيذية لنظام المساهمات العقارية","change":"Update"},{"success":true,"name":"Property - publishDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2024-02-16T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - publishDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2024-01-30T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"ساري\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Active\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"لوائح\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Regulations\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - subContent (ar-jo)","path":"/Properties/*/Value","oldValue":"اللائحة التنفيذية لنظام المساهمات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - subContent (en-us)","path":"/Properties/*/Value","oldValue":"اللائحة التنفيذية لنظام المساهمات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - title","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللائحة التنفيذية لنظام المساهمات العقارية","change":"Update"}],"key":"5afa2097-16b3-4705-ac6c-a74821fa53dc"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/7a3f9cb7-04ad-4097-9eb3-f2a3ab9a1887.config","name":"نظام المساهمات العقارية","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - attachedFile (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"73142430-2e20-403b-91d0-ce2377094b6a\",\n    \"mediaKey\": \"e1ade3a0-0077-4578-bae0-c6f4e950f597\"\n  }\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - attachedFile (en-us)","path":"/Properties/*/Value","oldValue":"/media/enyn421r/نظام-المساهمات-العقارية.pdf","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74b2e03476784f1099788370cb1f3819\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0634a93087934125849f2c1562659acd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a4765edf58f94b149dc6823b994db0ec\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf03dadf375a415194ac546207572432\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73a6312ad353471497af7e65011352c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f0c60f03f2f046389ced0ad80ae03515\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\"\n      },\n      {\n        \"contentUdi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/02043207856849d88a17fb9cac04ee19\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5b47943a0da243708f9a63813597b7bd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f805d1db2913488e9976b144d12d7913\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\"\n      },\n      {\n        \"contentUdi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c405c6afde7845949307128e5e606799\"\n      },\n      {\n        \"contentUdi\": \"umb://element/461d601e6ba9465fba581a92214b17ff\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\"\n      },\n      {\n        \"contentUdi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4560312fc1c340179a9a421185571bf3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p> لغرض تطبيق هذا النظام، يقصد بالعبارات والألفاظ الآتية -أينما وردت فيه- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br><strong>النظام:</strong> نظام المساهمات العقارية.<br><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المجلس:</strong> مجلس إدارة الهيئة.<br><strong>الرئيس:</strong> الرئيس التنفيذي للهيئة.<br><strong>المساهمة العقارية:</strong> مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقارية.<br><strong>المساهم:</strong> الشخص الذي يملك حصة مشاعة في المساهمة العقارية.<br><strong>الترخيص:</strong> ترخيص مساهمة عقارية يصدر من الهيئة.<br><strong>المرخص له:</strong> الشخص الحاصل على الترخيص.<br><strong>مدير المساهمة العقارية:</strong> الشخص المعين لإدارة المساهمة العقارية.<br><strong>حساب الضمان:</strong> الحساب المصرفي الخاص بالمساهمة العقارية.<br><strong>سجل المساهمين:</strong> سجل تقيد فيه أسماء المساهمين وحصصهم وأي تغيير يحدث في ملكية حصصهم.<br><strong>الجمعية: </strong>جمعية المساهمين.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يهدف النظام إلى تنظيم نشاط المساهمات العقارية، وإلى رفع مستوى الشفافية والإفصاح فيه، وإلى حماية حقوق جميع أطراف المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74b2e03476784f1099788370cb1f3819\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;دون إخلال باختصاصات الجهات الحكومية الأخرى، تتولى الهيئة تنظيم نشاط المساهمات العقارية وفقاً لما يحدده النظام واللائحة، ولها على وجه خاص ما يأتي:</p>\\n<p>1. إصدار الترخيص وتعديله وإلغاؤه. وتحدد اللائحة الشروط والمتطلبات والإجراءات اللازمة لذلك.</p>\\n<p>2. تصنيف المساهمات العقارية بحسب الحجم أو النوع أو الموقع، ووضع الشروط والمتطلبات الملائمة والمدد الزمنية للمساهمة العقارية بحسب تصنيفها.</p>\\n<p>3. وضع شروط تأهيل وتصنيف المطورين العقاريين لغرض طرح المساهمات العقارية.</p>\\n<p>4. وضع شروط تأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p>5. وضع أسس تحدد استحقاقات المرخص له نظير أتعابه، وما يتقاضاه من عمولات.</p>\\n<p>6. الرقابة والإشراف على المساهمات العقارية.<br>وللهيئة الاستعانة بأي جهة حكومية أخرى أو بالقطاع الخاص؛ للقيام بأي مهمة مسندة إليها بموجب النظام أو اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0634a93087934125849f2c1562659acd\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;لا يجوز طرح المساهمة العقارية ولا الإعلان عنها ولا تسويقها ولا جمع الأموال لها إلا بعد موافقة هيئة السوق المالية والحصول على ترخيص من الهيئة -وفقاً لأحكام النظام واللائحة- وذلك بعد التحقق مما يأتي:</p>\\n<p>1. أن يكون العقار محل المساهمة العقارية مملوكاً بموجب صك ملكية ساري المفعول، ثابتة سلامته، بناءً على إفادة من الجهة التي أصدرته.</p>\\n<p>2. أن يكون العقار محل المساهمة العقارية حاصلاً على الموافقات اللازمة لتطويره من الجهات المختصة وذلك وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf03dadf375a415194ac546207572432\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن يكون المرخص له مؤهلاً ومصنفاً من الهيئة لممارسة نشاط المساهمات العقارية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>يحدد رأس مال المساهمة العقارية، الذي على أساسه يُحتسب عدد الحصص ومقدارها من خلال التكلفة التقديرية من قبل جهة تقييمية مرخصة، بعد موافقة الهيئة وهيئة السوق المالية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>للهيئة اشتراط إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية بما لا يتجاوز (15%) من تكلفتها التقديرية، وذلك لمقابلة أي مصاريف إضافية غير متوقعة. ويكون التصرف بالمبلغ الاحتياطي بموافقة الجمعية. وتحدد اللائحة الشروط اللازمة لذلك، وكيفية إعادته للمساهمين في حال عدم التصرف به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يحق للمساهم الاشتراك في المساهمة العقارية، بحصة عينية أو نقدية. وتحدد اللائحة نوع الحصة العينية والشروط الواجب توافرها فيها.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1. يقسم رأس مال المساهمة العقارية إلى حصص متساوية القيمة والحقوق، وتكون مسؤولية المساهمين في حدود ما يملكون من حصص في المساهمة العقارية.</p>\\n<p>2. تقوم هيئة السوق المالية بتنظيم سجل المساهمين الخاص بالمساهمة العقارية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز الإقراض من رأس مال المساهمة العقارية، ويجوز الاقتراض بضمان أموال أو أصول المساهمة العقارية على أن يتم تضمين اتفاقية المساهمة ذلك، وتحدد اللائحة الاشتراطات المنظمة لذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يكون صافي أصول المساهمة العقارية من أصول ثابتة نقدية وعينية أو حقوق لدى الغير؛ مملوكة للمساهمة العقارية. وليس لدائني المساهمين أو المرخص له أو مدير المساهمة العقارية أي حق في أموال المساهمة العقارية أو أصولها عدا ما يملكونه من الحصص في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73a6312ad353471497af7e65011352c2\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1.يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن النسبة التي تحددها اللائحة، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>2.يجوز لبقية المساهمين في المساهمة العقارية التصرف بحصصهم وفق الشروط التي تحددها اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يكون المرخص له هو المسؤول عن جميع ما يتعلق بالمساهمة العقارية تجاه المساهم والهيئة وهيئة السوق المالية وأي من الجهات الحكومية ذات العلاقة والغير. وتحدد اللائحة اختصاصات المرخص له، وحدود مسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة ما نصت عليه المادة (التاسعة عشرة) من النظام، على المرخص له الالتزام بالإشراف على أعمال مدير المساهمة العقارية، وتمكينه من القيام بواجباته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يفتح المرخص له حساب ضمان في أحد البنوك المرخص لها باسم المساهمة العقارية. وتضع الهيئة بالتنسيق مع البنك المركزي السعودي الضوابط اللازمة لحساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تقوم هيئة السوق المالية بتنظيم إصدار شهادة المساهمة العقارية التي تثبت تملك المساهم حصة في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تكتسب المساهمة العقارية الشخصية الاعتبارية بصدور الترخيص من قبل الهيئة، وتكون خاضعة لأحكام النظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المرخص له تعيين محاسب قانوني واستشاري هندسي لكل مساهمة عقارية. وتحدد اللائحة شروط ومتطلبات ومسؤوليات ومهمات وآلية عمل كل منهما وما يترتب عليه، فيما يتعلق بالمساهمات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يدير المساهمة العقارية مدير المساهمة العقارية الذي يُعيّنه المرخص له. وتحدد اللائحة اشتراطات ومتطلبات مدير المساهمة العقارية وصلاحياته ومهماته ومسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/02043207856849d88a17fb9cac04ee19\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يحق للمرخص له وللهيئة وللجمعية عزل مدير المساهمة العقارية وفق ما تحدده اللائحة في حال إساءته استخدام صلاحياته أو إخلاله بتنفيذ التزاماته، ولا يخل ذلك بأي عقوبة قد تفرض عليه جراء ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الرابعة عشرة) من النظام، لا يجوز للمرخص له ولا لمدير المساهمة العقارية اتخاذ أي قرار أو إجراء إذا كان هناك تعارض مصالح قائم أو محتمل في هذا القرار أو الإجراء. وتحدد اللائحة طريقة التعامل مع حالات تعارض المصالح.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون للمساهمة العقارية جمعية تتشكل من جميع المساهمين المسجلين في سجل المساهمة العقارية. وتحدد اللائحة اختصاصات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنعقد اجتماعات الجمعية بدعوة من المرخص له أو مدير المساهمة العقارية أو مساهمين يمثلون (10%) من رأس مال المساهمة العقارية أو بطلب من الهيئة، ويحدد في الدعوة للاجتماع مكان انعقاده.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يرأس المرخص له -أو من يمثله- الجمعية، ويحق لجميع المساهمين حضور اجتماعات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;لا يكون اجتماع الجمعية (الأول) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (ثلثي) رأس مال المساهمة العقارية، وإذا لم يتوافر النصاب اللازم لعقد اجتماع الجمعية (الأول)، وجهت الدعوة إلى اجتماع (ثانٍ) يعقد خلال الأيام الـــ(خمسة عشر) التالية للاجتماع (الأول)، ولا يكون الاجتماع (الثاني) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (نصف) رأس مال المساهمة العقارية. وتصدر قرارات الجمعية في الاجتماعين (الأول) و(الثاني) بأغلبية الحصص الممثلة في الاجتماع، وفي حال تساوي الأصوات يعاد التصويت مرة أخرى. وإذا لم يتوافر النصاب اللازم في الاجتماع (الثاني)، وجهت الدعوة إلى اجتماع (ثالث) يعقد خلال الأيام الـــــ(سبعة) التالية للاجتماع (الثاني)، ويكون الاجتماع صحيحا أيًّا كانت نسبة الحصص الممثلة فيه بشرط ألا يقل عدد الحضور عن (ثلاثة) أشخاص، وتصدر قرارات الجمعية بأغلبية حصص الممثلين في الاجتماع.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز عقد اجتماعات الجمعية والتصويت على قراراتها؛ بواسطة وسائل التقنية الحديثة التي تحددها اللائحة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز بيع أصول المساهمة العقارية إلا بعد تقييم الأصول من مقيمين معتمدين وفقاً لنظام المقيمين المعتمدين، ووفقاً لما تحدده اللائحة من إجراءات. ويعد باطلاً أي تصرف ينطوي على إخلال بما نصت عليه هذه المادة</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون بيع أصول المساهمة العقارية بإحدى الطرق الآتية:&nbsp;</p>\\n<p>1. البيع بمزاد علني.&nbsp;</p>\\n<p>2. البيع المباشر لكامل أو لجزء من المساهمة العقارية.&nbsp;</p>\\n<p>3. أي طريقة أخرى تحددها اللائحة. &nbsp;&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (السابعة عشرة) من النظام، تحتفظ المساهمة العقارية بالشخصية الاعتبارية بالقدر اللازم لتصفيتها، وتنقضي بإحدى الحالات الآتية:</p>\\n<p>1. بيعها وفقاً لأحكام النظام واللائحة.</p>\\n<p>2. انقضاء المدة المحددة لها ما لم تمدد وفقاً لأحكام النظام واللائحة.</p>\\n<p>3. استحالة تحقق الغرض الذي أسست من أجله.</p>\\n<p>4. إلغاؤها وفقاً لأحكام النظام واللائحة.</p>\\n<p>5. صدور حكم قضائي نهائي بتصفيتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c405c6afde7845949307128e5e606799\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن تودع جميع العوائد المالية المتعلقة بالمساهمة العقارية مباشرة في حساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يتولى ضبط ما يقع من مخالفات لأحكام النظام أو اللائحة موظفون من الهيئة ومن أي جهة أخرى ترى الهيئة الاستعانة بموظفيها، يصدر بتعيينهم قرار من الرئيس بعد موافقة جهاتهم. ولمسؤولي الضبط دخول المواقع والمشاريع المتعلقة بالأنشطة المشمولة بالنظام بما فيها مقر المرخص له، وعليهم ضبط المخالفات والتحفظ على المستندات والوثائق والأدلة المتعلقة بها وفقاً لإجراءات الضبط الصادرة عن الهيئة ويكونون تحت إشراف الهيئة، ولهم الاستعانة بالجهات الأمنية عند الحاجة. وتحدد اللائحة طريقة عملهم، وصلاحياتهم، ومكافآتهم.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الخامسة والثلاثون) من النظام، يعاقب كل من يخالف أيًّا من أحكام النظام أو اللائحة بواحدة أو أكثر من العقوبات الآتية:</p>\\n<p>1. الإنذار.</p>\\n<p>2. إيقاف الترخيص مدة لا تزيد على (سنة).</p>\\n<p>3. إلغاء الترخيص.&nbsp;</p>\\n<p>4. غرامة لا تزيد على (10,000,000) عشرة ملايين ريال.</p>\\n<p>5. منع المرخص له أو مدير المساهمة العقارية من القيام -مستقبلاً- بأي عمل مرتبط بالمساهمات العقارية لمدة لا تتجاوز (10) عشر سنوات.<br>ويصدر المجلس جدولاً يتضمن تصنيفاً للمخالفات والعقوبات المقررة لها بناءً على ما نصت عليه هذه المادة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُكوّن بقرار من رئيس الهيئة لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة ويسمى أحدهم رئيساً، ويكون من بينهم مستشار شرعي أو نظامي؛ تتولى النظر في المخالفات وإيقاع العقوبات المنصوص عليها في المادة (الثانية والثلاثين) من النظام، وذلك بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها، ويعتمد قرار اللجنة من رئيس الهيئة أو من يفوضه بذلك. ويصدر الرئيس قواعد عمل اللجنة وتحديد مكافآت أعضائها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز التظلم من قرار اللجنة المنصوص عليها في المادة (الثالثة والثلاثين) من النظام أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ الإبلاغ بالقرار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأي عقوبة منصوص عليها في أي نظام آخر، يعاقب بالسجن مدة لا تزيد على (ثلاث) سنوات، كل من يخالف أيًّا من أحكام المواد الآتية: (الرابعة)، و(الحادية والعشرون)، و(السابعة والعشرون)، و(الثلاثون)، من النظام، وتحال إلى النيابة العامة؛ للتحقيق فيها، والادعاء فيها أمام المحكمة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال باختصاصات الهيئة، تنظم هيئة السوق المالية بالاتفاق مع الهيئة ما يتعلق بجمع الأموال لغرض طرح المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر المجلس اللائحة بالاتفاق مع هيئة السوق المالية، وذلك خلال (مائة وعشرين) يوماً من تاريخ صدور النظام، ويعمل بها من تاريخ العمل به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>ينشر النظام في الجريدة الرسمية، ويعمل به بعد (مائة وعشرين) يوماً من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4560312fc1c340179a9a421185571bf3\",\n      \"title\": \"الفصل السابع: أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/461d601e6ba9465fba581a92214b17ff\",\n      \"title\": \"الفصل السادس: المخالفات والعقوبات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f805d1db2913488e9976b144d12d7913\",\n      \"title\": \"الفصل الخامس: انقضاء المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5b47943a0da243708f9a63813597b7bd\",\n      \"title\": \"الفصل الرابع: جمعية المساهمين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f0c60f03f2f046389ced0ad80ae03515\",\n      \"title\": \"الفصل الثالث: إدارة المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a4765edf58f94b149dc6823b994db0ec\",\n      \"title\": \"الفصل الثاني: الترخيص والإشتراكات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\",\n      \"title\": \"الفصل الأول: تعريفات وأحكام عامة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74b2e03476784f1099788370cb1f3819\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0634a93087934125849f2c1562659acd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a4765edf58f94b149dc6823b994db0ec\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf03dadf375a415194ac546207572432\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73a6312ad353471497af7e65011352c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f0c60f03f2f046389ced0ad80ae03515\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\"\n      },\n      {\n        \"contentUdi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/02043207856849d88a17fb9cac04ee19\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5b47943a0da243708f9a63813597b7bd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f805d1db2913488e9976b144d12d7913\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\"\n      },\n      {\n        \"contentUdi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c405c6afde7845949307128e5e606799\"\n      },\n      {\n        \"contentUdi\": \"umb://element/461d601e6ba9465fba581a92214b17ff\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\"\n      },\n      {\n        \"contentUdi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4560312fc1c340179a9a421185571bf3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p> لغرض تطبيق هذا النظام، يقصد بالعبارات والألفاظ الآتية -أينما وردت فيه- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br><strong>النظام:</strong> نظام المساهمات العقارية.<br><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المجلس:</strong> مجلس إدارة الهيئة.<br><strong>الرئيس:</strong> الرئيس التنفيذي للهيئة.<br><strong>المساهمة العقارية:</strong> مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقارية.<br><strong>المساهم:</strong> الشخص الذي يملك حصة مشاعة في المساهمة العقارية.<br><strong>الترخيص:</strong> ترخيص مساهمة عقارية يصدر من الهيئة.<br><strong>المرخص له:</strong> الشخص الحاصل على الترخيص.<br><strong>مدير المساهمة العقارية:</strong> الشخص المعين لإدارة المساهمة العقارية.<br><strong>حساب الضمان:</strong> الحساب المصرفي الخاص بالمساهمة العقارية.<br><strong>سجل المساهمين:</strong> سجل تقيد فيه أسماء المساهمين وحصصهم وأي تغيير يحدث في ملكية حصصهم.<br><strong>الجمعية: </strong>جمعية المساهمين.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يهدف النظام إلى تنظيم نشاط المساهمات العقارية، وإلى رفع مستوى الشفافية والإفصاح فيه، وإلى حماية حقوق جميع أطراف المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74b2e03476784f1099788370cb1f3819\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;دون إخلال باختصاصات الجهات الحكومية الأخرى، تتولى الهيئة تنظيم نشاط المساهمات العقارية وفقاً لما يحدده النظام واللائحة، ولها على وجه خاص ما يأتي:</p>\\n<p>1. إصدار الترخيص وتعديله وإلغاؤه. وتحدد اللائحة الشروط والمتطلبات والإجراءات اللازمة لذلك.</p>\\n<p>2. تصنيف المساهمات العقارية بحسب الحجم أو النوع أو الموقع، ووضع الشروط والمتطلبات الملائمة والمدد الزمنية للمساهمة العقارية بحسب تصنيفها.</p>\\n<p>3. وضع شروط تأهيل وتصنيف المطورين العقاريين لغرض طرح المساهمات العقارية.</p>\\n<p>4. وضع شروط تأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p>5. وضع أسس تحدد استحقاقات المرخص له نظير أتعابه، وما يتقاضاه من عمولات.</p>\\n<p>6. الرقابة والإشراف على المساهمات العقارية.<br>وللهيئة الاستعانة بأي جهة حكومية أخرى أو بالقطاع الخاص؛ للقيام بأي مهمة مسندة إليها بموجب النظام أو اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0634a93087934125849f2c1562659acd\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;لا يجوز طرح المساهمة العقارية ولا الإعلان عنها ولا تسويقها ولا جمع الأموال لها إلا بعد موافقة هيئة السوق المالية والحصول على ترخيص من الهيئة -وفقاً لأحكام النظام واللائحة- وذلك بعد التحقق مما يأتي:</p>\\n<p>1. أن يكون العقار محل المساهمة العقارية مملوكاً بموجب صك ملكية ساري المفعول، ثابتة سلامته، بناءً على إفادة من الجهة التي أصدرته.</p>\\n<p>2. أن يكون العقار محل المساهمة العقارية حاصلاً على الموافقات اللازمة لتطويره من الجهات المختصة وذلك وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf03dadf375a415194ac546207572432\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن يكون المرخص له مؤهلاً ومصنفاً من الهيئة لممارسة نشاط المساهمات العقارية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>يحدد رأس مال المساهمة العقارية، الذي على أساسه يُحتسب عدد الحصص ومقدارها من خلال التكلفة التقديرية من قبل جهة تقييمية مرخصة، بعد موافقة الهيئة وهيئة السوق المالية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>للهيئة اشتراط إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية بما لا يتجاوز (15%) من تكلفتها التقديرية، وذلك لمقابلة أي مصاريف إضافية غير متوقعة. ويكون التصرف بالمبلغ الاحتياطي بموافقة الجمعية. وتحدد اللائحة الشروط اللازمة لذلك، وكيفية إعادته للمساهمين في حال عدم التصرف به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يحق للمساهم الاشتراك في المساهمة العقارية، بحصة عينية أو نقدية. وتحدد اللائحة نوع الحصة العينية والشروط الواجب توافرها فيها.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1. يقسم رأس مال المساهمة العقارية إلى حصص متساوية القيمة والحقوق، وتكون مسؤولية المساهمين في حدود ما يملكون من حصص في المساهمة العقارية.</p>\\n<p>2. تقوم هيئة السوق المالية بتنظيم سجل المساهمين الخاص بالمساهمة العقارية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز الإقراض من رأس مال المساهمة العقارية، ويجوز الاقتراض بضمان أموال أو أصول المساهمة العقارية على أن يتم تضمين اتفاقية المساهمة ذلك، وتحدد اللائحة الاشتراطات المنظمة لذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يكون صافي أصول المساهمة العقارية من أصول ثابتة نقدية وعينية أو حقوق لدى الغير؛ مملوكة للمساهمة العقارية. وليس لدائني المساهمين أو المرخص له أو مدير المساهمة العقارية أي حق في أموال المساهمة العقارية أو أصولها عدا ما يملكونه من الحصص في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73a6312ad353471497af7e65011352c2\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1.يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن النسبة التي تحددها اللائحة، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>2.يجوز لبقية المساهمين في المساهمة العقارية التصرف بحصصهم وفق الشروط التي تحددها اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يكون المرخص له هو المسؤول عن جميع ما يتعلق بالمساهمة العقارية تجاه المساهم والهيئة وهيئة السوق المالية وأي من الجهات الحكومية ذات العلاقة والغير. وتحدد اللائحة اختصاصات المرخص له، وحدود مسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة ما نصت عليه المادة (التاسعة عشرة) من النظام، على المرخص له الالتزام بالإشراف على أعمال مدير المساهمة العقارية، وتمكينه من القيام بواجباته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يفتح المرخص له حساب ضمان في أحد البنوك المرخص لها باسم المساهمة العقارية. وتضع الهيئة بالتنسيق مع البنك المركزي السعودي الضوابط اللازمة لحساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تقوم هيئة السوق المالية بتنظيم إصدار شهادة المساهمة العقارية التي تثبت تملك المساهم حصة في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تكتسب المساهمة العقارية الشخصية الاعتبارية بصدور الترخيص من قبل الهيئة، وتكون خاضعة لأحكام النظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المرخص له تعيين محاسب قانوني واستشاري هندسي لكل مساهمة عقارية. وتحدد اللائحة شروط ومتطلبات ومسؤوليات ومهمات وآلية عمل كل منهما وما يترتب عليه، فيما يتعلق بالمساهمات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يدير المساهمة العقارية مدير المساهمة العقارية الذي يُعيّنه المرخص له. وتحدد اللائحة اشتراطات ومتطلبات مدير المساهمة العقارية وصلاحياته ومهماته ومسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/02043207856849d88a17fb9cac04ee19\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يحق للمرخص له وللهيئة وللجمعية عزل مدير المساهمة العقارية وفق ما تحدده اللائحة في حال إساءته استخدام صلاحياته أو إخلاله بتنفيذ التزاماته، ولا يخل ذلك بأي عقوبة قد تفرض عليه جراء ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الرابعة عشرة) من النظام، لا يجوز للمرخص له ولا لمدير المساهمة العقارية اتخاذ أي قرار أو إجراء إذا كان هناك تعارض مصالح قائم أو محتمل في هذا القرار أو الإجراء. وتحدد اللائحة طريقة التعامل مع حالات تعارض المصالح.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون للمساهمة العقارية جمعية تتشكل من جميع المساهمين المسجلين في سجل المساهمة العقارية. وتحدد اللائحة اختصاصات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنعقد اجتماعات الجمعية بدعوة من المرخص له أو مدير المساهمة العقارية أو مساهمين يمثلون (10%) من رأس مال المساهمة العقارية أو بطلب من الهيئة، ويحدد في الدعوة للاجتماع مكان انعقاده.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يرأس المرخص له -أو من يمثله- الجمعية، ويحق لجميع المساهمين حضور اجتماعات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;لا يكون اجتماع الجمعية (الأول) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (ثلثي) رأس مال المساهمة العقارية، وإذا لم يتوافر النصاب اللازم لعقد اجتماع الجمعية (الأول)، وجهت الدعوة إلى اجتماع (ثانٍ) يعقد خلال الأيام الـــ(خمسة عشر) التالية للاجتماع (الأول)، ولا يكون الاجتماع (الثاني) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (نصف) رأس مال المساهمة العقارية. وتصدر قرارات الجمعية في الاجتماعين (الأول) و(الثاني) بأغلبية الحصص الممثلة في الاجتماع، وفي حال تساوي الأصوات يعاد التصويت مرة أخرى. وإذا لم يتوافر النصاب اللازم في الاجتماع (الثاني)، وجهت الدعوة إلى اجتماع (ثالث) يعقد خلال الأيام الـــــ(سبعة) التالية للاجتماع (الثاني)، ويكون الاجتماع صحيحا أيًّا كانت نسبة الحصص الممثلة فيه بشرط ألا يقل عدد الحضور عن (ثلاثة) أشخاص، وتصدر قرارات الجمعية بأغلبية حصص الممثلين في الاجتماع.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز عقد اجتماعات الجمعية والتصويت على قراراتها؛ بواسطة وسائل التقنية الحديثة التي تحددها اللائحة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز بيع أصول المساهمة العقارية إلا بعد تقييم الأصول من مقيمين معتمدين وفقاً لنظام المقيمين المعتمدين، ووفقاً لما تحدده اللائحة من إجراءات. ويعد باطلاً أي تصرف ينطوي على إخلال بما نصت عليه هذه المادة</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون بيع أصول المساهمة العقارية بإحدى الطرق الآتية:&nbsp;</p>\\n<p>1. البيع بمزاد علني.&nbsp;</p>\\n<p>2. البيع المباشر لكامل أو لجزء من المساهمة العقارية.&nbsp;</p>\\n<p>3. أي طريقة أخرى تحددها اللائحة. &nbsp;&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (السابعة عشرة) من النظام، تحتفظ المساهمة العقارية بالشخصية الاعتبارية بالقدر اللازم لتصفيتها، وتنقضي بإحدى الحالات الآتية:</p>\\n<p>1. بيعها وفقاً لأحكام النظام واللائحة.</p>\\n<p>2. انقضاء المدة المحددة لها ما لم تمدد وفقاً لأحكام النظام واللائحة.</p>\\n<p>3. استحالة تحقق الغرض الذي أسست من أجله.</p>\\n<p>4. إلغاؤها وفقاً لأحكام النظام واللائحة.</p>\\n<p>5. صدور حكم قضائي نهائي بتصفيتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c405c6afde7845949307128e5e606799\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن تودع جميع العوائد المالية المتعلقة بالمساهمة العقارية مباشرة في حساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يتولى ضبط ما يقع من مخالفات لأحكام النظام أو اللائحة موظفون من الهيئة ومن أي جهة أخرى ترى الهيئة الاستعانة بموظفيها، يصدر بتعيينهم قرار من الرئيس بعد موافقة جهاتهم. ولمسؤولي الضبط دخول المواقع والمشاريع المتعلقة بالأنشطة المشمولة بالنظام بما فيها مقر المرخص له، وعليهم ضبط المخالفات والتحفظ على المستندات والوثائق والأدلة المتعلقة بها وفقاً لإجراءات الضبط الصادرة عن الهيئة ويكونون تحت إشراف الهيئة، ولهم الاستعانة بالجهات الأمنية عند الحاجة. وتحدد اللائحة طريقة عملهم، وصلاحياتهم، ومكافآتهم.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الخامسة والثلاثون) من النظام، يعاقب كل من يخالف أيًّا من أحكام النظام أو اللائحة بواحدة أو أكثر من العقوبات الآتية:</p>\\n<p>1. الإنذار.</p>\\n<p>2. إيقاف الترخيص مدة لا تزيد على (سنة).</p>\\n<p>3. إلغاء الترخيص.&nbsp;</p>\\n<p>4. غرامة لا تزيد على (10,000,000) عشرة ملايين ريال.</p>\\n<p>5. منع المرخص له أو مدير المساهمة العقارية من القيام -مستقبلاً- بأي عمل مرتبط بالمساهمات العقارية لمدة لا تتجاوز (10) عشر سنوات.<br>ويصدر المجلس جدولاً يتضمن تصنيفاً للمخالفات والعقوبات المقررة لها بناءً على ما نصت عليه هذه المادة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُكوّن بقرار من رئيس الهيئة لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة ويسمى أحدهم رئيساً، ويكون من بينهم مستشار شرعي أو نظامي؛ تتولى النظر في المخالفات وإيقاع العقوبات المنصوص عليها في المادة (الثانية والثلاثين) من النظام، وذلك بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها، ويعتمد قرار اللجنة من رئيس الهيئة أو من يفوضه بذلك. ويصدر الرئيس قواعد عمل اللجنة وتحديد مكافآت أعضائها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز التظلم من قرار اللجنة المنصوص عليها في المادة (الثالثة والثلاثين) من النظام أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ الإبلاغ بالقرار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأي عقوبة منصوص عليها في أي نظام آخر، يعاقب بالسجن مدة لا تزيد على (ثلاث) سنوات، كل من يخالف أيًّا من أحكام المواد الآتية: (الرابعة)، و(الحادية والعشرون)، و(السابعة والعشرون)، و(الثلاثون)، من النظام، وتحال إلى النيابة العامة؛ للتحقيق فيها، والادعاء فيها أمام المحكمة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال باختصاصات الهيئة، تنظم هيئة السوق المالية بالاتفاق مع الهيئة ما يتعلق بجمع الأموال لغرض طرح المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر المجلس اللائحة بالاتفاق مع هيئة السوق المالية، وذلك خلال (مائة وعشرين) يوماً من تاريخ صدور النظام، ويعمل بها من تاريخ العمل به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>ينشر النظام في الجريدة الرسمية، ويعمل به بعد (مائة وعشرين) يوماً من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4560312fc1c340179a9a421185571bf3\",\n      \"title\": \"الفصل السابع: أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/461d601e6ba9465fba581a92214b17ff\",\n      \"title\": \"الفصل السادس: المخالفات والعقوبات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f805d1db2913488e9976b144d12d7913\",\n      \"title\": \"الفصل الخامس: انقضاء المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5b47943a0da243708f9a63813597b7bd\",\n      \"title\": \"الفصل الرابع: جمعية المساهمين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f0c60f03f2f046389ced0ad80ae03515\",\n      \"title\": \"الفصل الثالث: إدارة المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a4765edf58f94b149dc6823b994db0ec\",\n      \"title\": \"الفصل الثاني: الترخيص والإشتراكات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\",\n      \"title\": \"الفصل الأول: تعريفات وأحكام عامة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - contentItems (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74b2e03476784f1099788370cb1f3819\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0634a93087934125849f2c1562659acd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a4765edf58f94b149dc6823b994db0ec\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf03dadf375a415194ac546207572432\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73a6312ad353471497af7e65011352c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f0c60f03f2f046389ced0ad80ae03515\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\"\n      },\n      {\n        \"contentUdi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/02043207856849d88a17fb9cac04ee19\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5b47943a0da243708f9a63813597b7bd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f805d1db2913488e9976b144d12d7913\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\"\n      },\n      {\n        \"contentUdi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c405c6afde7845949307128e5e606799\"\n      },\n      {\n        \"contentUdi\": \"umb://element/461d601e6ba9465fba581a92214b17ff\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\"\n      },\n      {\n        \"contentUdi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/4560312fc1c340179a9a421185571bf3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p> لغرض تطبيق هذا النظام، يقصد بالعبارات والألفاظ الآتية -أينما وردت فيه- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br><strong>النظام:</strong> نظام المساهمات العقارية.<br><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المجلس:</strong> مجلس إدارة الهيئة.<br><strong>الرئيس:</strong> الرئيس التنفيذي للهيئة.<br><strong>المساهمة العقارية:</strong> مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقارية.<br><strong>المساهم:</strong> الشخص الذي يملك حصة مشاعة في المساهمة العقارية.<br><strong>الترخيص:</strong> ترخيص مساهمة عقارية يصدر من الهيئة.<br><strong>المرخص له:</strong> الشخص الحاصل على الترخيص.<br><strong>مدير المساهمة العقارية:</strong> الشخص المعين لإدارة المساهمة العقارية.<br><strong>حساب الضمان:</strong> الحساب المصرفي الخاص بالمساهمة العقارية.<br><strong>سجل المساهمين:</strong> سجل تقيد فيه أسماء المساهمين وحصصهم وأي تغيير يحدث في ملكية حصصهم.<br><strong>الجمعية: </strong>جمعية المساهمين.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>يهدف النظام إلى تنظيم نشاط المساهمات العقارية، وإلى رفع مستوى الشفافية والإفصاح فيه، وإلى حماية حقوق جميع أطراف المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74b2e03476784f1099788370cb1f3819\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;دون إخلال باختصاصات الجهات الحكومية الأخرى، تتولى الهيئة تنظيم نشاط المساهمات العقارية وفقاً لما يحدده النظام واللائحة، ولها على وجه خاص ما يأتي:</p>\\n<p>1. إصدار الترخيص وتعديله وإلغاؤه. وتحدد اللائحة الشروط والمتطلبات والإجراءات اللازمة لذلك.</p>\\n<p>2. تصنيف المساهمات العقارية بحسب الحجم أو النوع أو الموقع، ووضع الشروط والمتطلبات الملائمة والمدد الزمنية للمساهمة العقارية بحسب تصنيفها.</p>\\n<p>3. وضع شروط تأهيل وتصنيف المطورين العقاريين لغرض طرح المساهمات العقارية.</p>\\n<p>4. وضع شروط تأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p>5. وضع أسس تحدد استحقاقات المرخص له نظير أتعابه، وما يتقاضاه من عمولات.</p>\\n<p>6. الرقابة والإشراف على المساهمات العقارية.<br>وللهيئة الاستعانة بأي جهة حكومية أخرى أو بالقطاع الخاص؛ للقيام بأي مهمة مسندة إليها بموجب النظام أو اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0634a93087934125849f2c1562659acd\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;لا يجوز طرح المساهمة العقارية ولا الإعلان عنها ولا تسويقها ولا جمع الأموال لها إلا بعد موافقة هيئة السوق المالية والحصول على ترخيص من الهيئة -وفقاً لأحكام النظام واللائحة- وذلك بعد التحقق مما يأتي:</p>\\n<p>1. أن يكون العقار محل المساهمة العقارية مملوكاً بموجب صك ملكية ساري المفعول، ثابتة سلامته، بناءً على إفادة من الجهة التي أصدرته.</p>\\n<p>2. أن يكون العقار محل المساهمة العقارية حاصلاً على الموافقات اللازمة لتطويره من الجهات المختصة وذلك وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf03dadf375a415194ac546207572432\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن يكون المرخص له مؤهلاً ومصنفاً من الهيئة لممارسة نشاط المساهمات العقارية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>يحدد رأس مال المساهمة العقارية، الذي على أساسه يُحتسب عدد الحصص ومقدارها من خلال التكلفة التقديرية من قبل جهة تقييمية مرخصة، بعد موافقة الهيئة وهيئة السوق المالية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>للهيئة اشتراط إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية بما لا يتجاوز (15%) من تكلفتها التقديرية، وذلك لمقابلة أي مصاريف إضافية غير متوقعة. ويكون التصرف بالمبلغ الاحتياطي بموافقة الجمعية. وتحدد اللائحة الشروط اللازمة لذلك، وكيفية إعادته للمساهمين في حال عدم التصرف به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>يحق للمساهم الاشتراك في المساهمة العقارية، بحصة عينية أو نقدية. وتحدد اللائحة نوع الحصة العينية والشروط الواجب توافرها فيها.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>1. يقسم رأس مال المساهمة العقارية إلى حصص متساوية القيمة والحقوق، وتكون مسؤولية المساهمين في حدود ما يملكون من حصص في المساهمة العقارية.</p>\\n<p>2. تقوم هيئة السوق المالية بتنظيم سجل المساهمين الخاص بالمساهمة العقارية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز الإقراض من رأس مال المساهمة العقارية، ويجوز الاقتراض بضمان أموال أو أصول المساهمة العقارية على أن يتم تضمين اتفاقية المساهمة ذلك، وتحدد اللائحة الاشتراطات المنظمة لذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يكون صافي أصول المساهمة العقارية من أصول ثابتة نقدية وعينية أو حقوق لدى الغير؛ مملوكة للمساهمة العقارية. وليس لدائني المساهمين أو المرخص له أو مدير المساهمة العقارية أي حق في أموال المساهمة العقارية أو أصولها عدا ما يملكونه من الحصص في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73a6312ad353471497af7e65011352c2\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>1.يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن النسبة التي تحددها اللائحة، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>2.يجوز لبقية المساهمين في المساهمة العقارية التصرف بحصصهم وفق الشروط التي تحددها اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يكون المرخص له هو المسؤول عن جميع ما يتعلق بالمساهمة العقارية تجاه المساهم والهيئة وهيئة السوق المالية وأي من الجهات الحكومية ذات العلاقة والغير. وتحدد اللائحة اختصاصات المرخص له، وحدود مسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة ما نصت عليه المادة (التاسعة عشرة) من النظام، على المرخص له الالتزام بالإشراف على أعمال مدير المساهمة العقارية، وتمكينه من القيام بواجباته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يفتح المرخص له حساب ضمان في أحد البنوك المرخص لها باسم المساهمة العقارية. وتضع الهيئة بالتنسيق مع البنك المركزي السعودي الضوابط اللازمة لحساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تقوم هيئة السوق المالية بتنظيم إصدار شهادة المساهمة العقارية التي تثبت تملك المساهم حصة في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تكتسب المساهمة العقارية الشخصية الاعتبارية بصدور الترخيص من قبل الهيئة، وتكون خاضعة لأحكام النظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المرخص له تعيين محاسب قانوني واستشاري هندسي لكل مساهمة عقارية. وتحدد اللائحة شروط ومتطلبات ومسؤوليات ومهمات وآلية عمل كل منهما وما يترتب عليه، فيما يتعلق بالمساهمات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يدير المساهمة العقارية مدير المساهمة العقارية الذي يُعيّنه المرخص له. وتحدد اللائحة اشتراطات ومتطلبات مدير المساهمة العقارية وصلاحياته ومهماته ومسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/02043207856849d88a17fb9cac04ee19\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يحق للمرخص له وللهيئة وللجمعية عزل مدير المساهمة العقارية وفق ما تحدده اللائحة في حال إساءته استخدام صلاحياته أو إخلاله بتنفيذ التزاماته، ولا يخل ذلك بأي عقوبة قد تفرض عليه جراء ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الرابعة عشرة) من النظام، لا يجوز للمرخص له ولا لمدير المساهمة العقارية اتخاذ أي قرار أو إجراء إذا كان هناك تعارض مصالح قائم أو محتمل في هذا القرار أو الإجراء. وتحدد اللائحة طريقة التعامل مع حالات تعارض المصالح.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون للمساهمة العقارية جمعية تتشكل من جميع المساهمين المسجلين في سجل المساهمة العقارية. وتحدد اللائحة اختصاصات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنعقد اجتماعات الجمعية بدعوة من المرخص له أو مدير المساهمة العقارية أو مساهمين يمثلون (10%) من رأس مال المساهمة العقارية أو بطلب من الهيئة، ويحدد في الدعوة للاجتماع مكان انعقاده.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يرأس المرخص له -أو من يمثله- الجمعية، ويحق لجميع المساهمين حضور اجتماعات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;لا يكون اجتماع الجمعية (الأول) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (ثلثي) رأس مال المساهمة العقارية، وإذا لم يتوافر النصاب اللازم لعقد اجتماع الجمعية (الأول)، وجهت الدعوة إلى اجتماع (ثانٍ) يعقد خلال الأيام الـــ(خمسة عشر) التالية للاجتماع (الأول)، ولا يكون الاجتماع (الثاني) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (نصف) رأس مال المساهمة العقارية. وتصدر قرارات الجمعية في الاجتماعين (الأول) و(الثاني) بأغلبية الحصص الممثلة في الاجتماع، وفي حال تساوي الأصوات يعاد التصويت مرة أخرى. وإذا لم يتوافر النصاب اللازم في الاجتماع (الثاني)، وجهت الدعوة إلى اجتماع (ثالث) يعقد خلال الأيام الـــــ(سبعة) التالية للاجتماع (الثاني)، ويكون الاجتماع صحيحا أيًّا كانت نسبة الحصص الممثلة فيه بشرط ألا يقل عدد الحضور عن (ثلاثة) أشخاص، وتصدر قرارات الجمعية بأغلبية حصص الممثلين في الاجتماع.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز عقد اجتماعات الجمعية والتصويت على قراراتها؛ بواسطة وسائل التقنية الحديثة التي تحددها اللائحة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز بيع أصول المساهمة العقارية إلا بعد تقييم الأصول من مقيمين معتمدين وفقاً لنظام المقيمين المعتمدين، ووفقاً لما تحدده اللائحة من إجراءات. ويعد باطلاً أي تصرف ينطوي على إخلال بما نصت عليه هذه المادة</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون بيع أصول المساهمة العقارية بإحدى الطرق الآتية:&nbsp;</p>\\n<p>1. البيع بمزاد علني.&nbsp;</p>\\n<p>2. البيع المباشر لكامل أو لجزء من المساهمة العقارية.&nbsp;</p>\\n<p>3. أي طريقة أخرى تحددها اللائحة. &nbsp;&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (السابعة عشرة) من النظام، تحتفظ المساهمة العقارية بالشخصية الاعتبارية بالقدر اللازم لتصفيتها، وتنقضي بإحدى الحالات الآتية:</p>\\n<p>1. بيعها وفقاً لأحكام النظام واللائحة.</p>\\n<p>2. انقضاء المدة المحددة لها ما لم تمدد وفقاً لأحكام النظام واللائحة.</p>\\n<p>3. استحالة تحقق الغرض الذي أسست من أجله.</p>\\n<p>4. إلغاؤها وفقاً لأحكام النظام واللائحة.</p>\\n<p>5. صدور حكم قضائي نهائي بتصفيتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c405c6afde7845949307128e5e606799\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن تودع جميع العوائد المالية المتعلقة بالمساهمة العقارية مباشرة في حساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يتولى ضبط ما يقع من مخالفات لأحكام النظام أو اللائحة موظفون من الهيئة ومن أي جهة أخرى ترى الهيئة الاستعانة بموظفيها، يصدر بتعيينهم قرار من الرئيس بعد موافقة جهاتهم. ولمسؤولي الضبط دخول المواقع والمشاريع المتعلقة بالأنشطة المشمولة بالنظام بما فيها مقر المرخص له، وعليهم ضبط المخالفات والتحفظ على المستندات والوثائق والأدلة المتعلقة بها وفقاً لإجراءات الضبط الصادرة عن الهيئة ويكونون تحت إشراف الهيئة، ولهم الاستعانة بالجهات الأمنية عند الحاجة. وتحدد اللائحة طريقة عملهم، وصلاحياتهم، ومكافآتهم.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الخامسة والثلاثون) من النظام، يعاقب كل من يخالف أيًّا من أحكام النظام أو اللائحة بواحدة أو أكثر من العقوبات الآتية:</p>\\n<p>1. الإنذار.</p>\\n<p>2. إيقاف الترخيص مدة لا تزيد على (سنة).</p>\\n<p>3. إلغاء الترخيص.&nbsp;</p>\\n<p>4. غرامة لا تزيد على (10,000,000) عشرة ملايين ريال.</p>\\n<p>5. منع المرخص له أو مدير المساهمة العقارية من القيام -مستقبلاً- بأي عمل مرتبط بالمساهمات العقارية لمدة لا تتجاوز (10) عشر سنوات.<br>ويصدر المجلس جدولاً يتضمن تصنيفاً للمخالفات والعقوبات المقررة لها بناءً على ما نصت عليه هذه المادة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُكوّن بقرار من رئيس الهيئة لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة ويسمى أحدهم رئيساً، ويكون من بينهم مستشار شرعي أو نظامي؛ تتولى النظر في المخالفات وإيقاع العقوبات المنصوص عليها في المادة (الثانية والثلاثين) من النظام، وذلك بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها، ويعتمد قرار اللجنة من رئيس الهيئة أو من يفوضه بذلك. ويصدر الرئيس قواعد عمل اللجنة وتحديد مكافآت أعضائها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز التظلم من قرار اللجنة المنصوص عليها في المادة (الثالثة والثلاثين) من النظام أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ الإبلاغ بالقرار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأي عقوبة منصوص عليها في أي نظام آخر، يعاقب بالسجن مدة لا تزيد على (ثلاث) سنوات، كل من يخالف أيًّا من أحكام المواد الآتية: (الرابعة)، و(الحادية والعشرون)، و(السابعة والعشرون)، و(الثلاثون)، من النظام، وتحال إلى النيابة العامة؛ للتحقيق فيها، والادعاء فيها أمام المحكمة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال باختصاصات الهيئة، تنظم هيئة السوق المالية بالاتفاق مع الهيئة ما يتعلق بجمع الأموال لغرض طرح المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر المجلس اللائحة بالاتفاق مع هيئة السوق المالية، وذلك خلال (مائة وعشرين) يوماً من تاريخ صدور النظام، ويعمل بها من تاريخ العمل به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>ينشر النظام في الجريدة الرسمية، ويعمل به بعد (مائة وعشرين) يوماً من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/4560312fc1c340179a9a421185571bf3\",\n      \"title\": \"الفصل السابع: أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/461d601e6ba9465fba581a92214b17ff\",\n      \"title\": \"الفصل السادس: المخالفات والعقوبات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f805d1db2913488e9976b144d12d7913\",\n      \"title\": \"الفصل الخامس: انقضاء المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5b47943a0da243708f9a63813597b7bd\",\n      \"title\": \"الفصل الرابع: جمعية المساهمين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f0c60f03f2f046389ced0ad80ae03515\",\n      \"title\": \"الفصل الثالث: إدارة المساهمة العقارية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a4765edf58f94b149dc6823b994db0ec\",\n      \"title\": \"الفصل الثاني: الترخيص والإشتراكات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\",\n      \"title\": \"الفصل الأول: تعريفات وأحكام عامة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (en-us)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\"\n      },\n      {\n        \"contentUdi\": \"umb://element/74b2e03476784f1099788370cb1f3819\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0634a93087934125849f2c1562659acd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cf03dadf375a415194ac546207572432\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73a6312ad353471497af7e65011352c2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\"\n      },\n      {\n        \"contentUdi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/02043207856849d88a17fb9cac04ee19\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\"\n      },\n      {\n        \"contentUdi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c405c6afde7845949307128e5e606799\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\"\n      },\n      {\n        \"contentUdi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/55e0fd24d41945b0b9a5c119eadab387\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>&nbsp; &nbsp; لغرض تطبيق هذا النظام، يقصد بالعبارات والألفاظ الآتية -أينما وردت فيه- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br>النظام: نظام المساهمات العقارية.<br>اللائحة: اللائحة التنفيذية للنظام.<br>الهيئة: الهيئة العامة للعقار.<br>المجلس: مجلس إدارة الهيئة.<br>الرئيس: الرئيس التنفيذي للهيئة.<br>المساهمة العقارية: مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقارية.<br>المساهم: الشخص الذي يملك حصة مشاعة في المساهمة العقارية.<br>الترخيص: ترخيص مساهمة عقارية يصدر من الهيئة.<br>المرخص له: الشخص الحاصل على الترخيص.<br>مدير المساهمة العقارية: الشخص المعين لإدارة المساهمة العقارية.<br>حساب الضمان: الحساب المصرفي الخاص بالمساهمة العقارية.<br>سجل المساهمين: سجل تقيد فيه أسماء المساهمين وحصصهم وأي تغيير يحدث في ملكية حصصهم.<br>الجمعية: جمعية المساهمين.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c671b0d4696e40b2847abfcabf3b0f70\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يهدف النظام إلى تنظيم نشاط المساهمات العقارية، وإلى رفع مستوى الشفافية والإفصاح فيه، وإلى حماية حقوق جميع أطراف المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/74b2e03476784f1099788370cb1f3819\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>&nbsp; &nbsp; &nbsp;دون إخلال باختصاصات الجهات الحكومية الأخرى، تتولى الهيئة تنظيم نشاط المساهمات العقارية وفقاً لما يحدده النظام واللائحة، ولها على وجه خاص ما يأتي:</p>\\n<p>1. إصدار الترخيص وتعديله وإلغاؤه. وتحدد اللائحة الشروط والمتطلبات والإجراءات اللازمة لذلك.</p>\\n<p>2. تصنيف المساهمات العقارية بحسب الحجم أو النوع أو الموقع، ووضع الشروط والمتطلبات الملائمة والمدد الزمنية للمساهمة العقارية بحسب تصنيفها.</p>\\n<p>3. وضع شروط تأهيل وتصنيف المطورين العقاريين لغرض طرح المساهمات العقارية.</p>\\n<p>4. وضع شروط تأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\n<p>5. وضع أسس تحدد استحقاقات المرخص له نظير أتعابه، وما يتقاضاه من عمولات.</p>\\n<p>6. الرقابة والإشراف على المساهمات العقارية.<br>وللهيئة الاستعانة بأي جهة حكومية أخرى أو بالقطاع الخاص؛ للقيام بأي مهمة مسندة إليها بموجب النظام أو اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0634a93087934125849f2c1562659acd\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>&nbsp; &nbsp; &nbsp;لا يجوز طرح المساهمة العقارية ولا الإعلان عنها ولا تسويقها ولا جمع الأموال لها إلا بعد موافقة هيئة السوق المالية والحصول على ترخيص من الهيئة -وفقاً لأحكام النظام واللائحة- وذلك بعد التحقق مما يأتي:</p>\\n<p>1. أن يكون العقار محل المساهمة العقارية مملوكاً بموجب صك ملكية ساري المفعول، ثابتة سلامته، بناءً على إفادة من الجهة التي أصدرته.</p>\\n<p>2. أن يكون العقار محل المساهمة العقارية حاصلاً على الموافقات اللازمة لتطويره من الجهات المختصة وذلك وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cf03dadf375a415194ac546207572432\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجب أن يكون المرخص له مؤهلاً ومصنفاً من الهيئة لممارسة نشاط المساهمات العقارية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يحدد رأس مال المساهمة العقارية، الذي على أساسه يُحتسب عدد الحصص ومقدارها من خلال التكلفة التقديرية من قبل جهة تقييمية مرخصة، بعد موافقة الهيئة وهيئة السوق المالية وفقاً لما تحدده اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>للهيئة اشتراط إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية بما لا يتجاوز (15%) من تكلفتها التقديرية، وذلك لمقابلة أي مصاريف إضافية غير متوقعة. ويكون التصرف بالمبلغ الاحتياطي بموافقة الجمعية. وتحدد اللائحة الشروط اللازمة لذلك، وكيفية إعادته للمساهمين في حال عدم التصرف به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f1444ea00c1a4bc9b50257a28d85744a\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يحق للمساهم الاشتراك في المساهمة العقارية، بحصة عينية أو نقدية. وتحدد اللائحة نوع الحصة العينية والشروط الواجب توافرها فيها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/aff6bb9b068a41d4b076a8025bf584d7\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>1. يقسم رأس مال المساهمة العقارية إلى حصص متساوية القيمة والحقوق، وتكون مسؤولية المساهمين في حدود ما يملكون من حصص في المساهمة العقارية.</p>\\n<p>تقوم هيئة السوق المالية بتنظيم سجل المساهمين الخاص بالمساهمة العقارية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/19c16ae7c831488aa0d478accbf7c206\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>لا يجوز الإقراض من رأس مال المساهمة العقارية، ويجوز الاقتراض بضمان أموال أو أصول المساهمة العقارية على أن يتم تضمين اتفاقية المساهمة ذلك، وتحدد اللائحة الاشتراطات المنظمة لذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e406eb0ab60b43c1a21015db6158bf6b\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يكون صافي أصول المساهمة العقارية من أصول ثابتة نقدية وعينية أو حقوق لدى الغير؛ مملوكة للمساهمة العقارية. وليس لدائني المساهمين أو المرخص له أو مدير المساهمة العقارية أي حق في أموال المساهمة العقارية أو أصولها عدا ما يملكونه من الحصص في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73a6312ad353471497af7e65011352c2\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن النسبة التي تحددها اللائحة، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\n<p>يجوز لبقية المساهمين في المساهمة العقارية التصرف بحصصهم وفق الشروط التي تحددها اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7085830f68494aa8b1741e1179df92a6\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<p>يكون المرخص له هو المسؤول عن جميع ما يتعلق بالمساهمة العقارية تجاه المساهم والهيئة وهيئة السوق المالية وأي من الجهات الحكومية ذات العلاقة والغير. وتحدد اللائحة اختصاصات المرخص له، وحدود مسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9507d21d02b24b3b8c640fa248d37171\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة ما نصت عليه المادة (التاسعة عشرة) من النظام، على المرخص له الالتزام بالإشراف على أعمال مدير المساهمة العقارية، وتمكينه من القيام بواجباته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/eeb906fad1e3419194edfe984372ee60\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يفتح المرخص له حساب ضمان في أحد البنوك المرخص لها باسم المساهمة العقارية. وتضع الهيئة بالتنسيق مع البنك المركزي السعودي الضوابط اللازمة لحساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2724d265a2704eaf90b248fa69977d00\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تقوم هيئة السوق المالية بتنظيم إصدار شهادة المساهمة العقارية التي تثبت تملك المساهم حصة في المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fa8b050afc8c4649b501c4090fdd23db\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>تكتسب المساهمة العقارية الشخصية الاعتبارية بصدور الترخيص من قبل الهيئة، وتكون خاضعة لأحكام النظام واللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d5927ffb482a4be398fac3cab6aa33b8\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المرخص له تعيين محاسب قانوني واستشاري هندسي لكل مساهمة عقارية. وتحدد اللائحة شروط ومتطلبات ومسؤوليات ومهمات وآلية عمل كل منهما وما يترتب عليه، فيما يتعلق بالمساهمات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يدير المساهمة العقارية مدير المساهمة العقارية الذي يُعيّنه المرخص له. وتحدد اللائحة اشتراطات ومتطلبات مدير المساهمة العقارية وصلاحياته ومهماته ومسؤولياته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/02043207856849d88a17fb9cac04ee19\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>يحق للمرخص له وللهيئة وللجمعية عزل مدير المساهمة العقارية وفق ما تحدده اللائحة في حال إساءته استخدام صلاحياته أو إخلاله بتنفيذ التزاماته، ولا يخل ذلك بأي عقوبة قد تفرض عليه جراء ذلك.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الرابعة عشرة) من النظام، لا يجوز للمرخص له ولا لمدير المساهمة العقارية اتخاذ أي قرار أو إجراء إذا كان هناك تعارض مصالح قائم أو محتمل في هذا القرار أو الإجراء. وتحدد اللائحة طريقة التعامل مع حالات تعارض المصالح.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbdab9611094c9896d29c6f2374cd89\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون للمساهمة العقارية جمعية تتشكل من جميع المساهمين المسجلين في سجل المساهمة العقارية. وتحدد اللائحة اختصاصات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنعقد اجتماعات الجمعية بدعوة من المرخص له أو مدير المساهمة العقارية أو مساهمين يمثلون (10%) من رأس مال المساهمة العقارية أو بطلب من الهيئة، ويحدد في الدعوة للاجتماع مكان انعقاده.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f77ddd2526bc494cbcc71d525b49ae56\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يرأس المرخص له -أو من يمثله- الجمعية، ويحق لجميع المساهمين حضور اجتماعات الجمعية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3d3e88078540401c85b1e001455a1bef\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;لا يكون اجتماع الجمعية (الأول) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (ثلثي) رأس مال المساهمة العقارية، وإذا لم يتوافر النصاب اللازم لعقد اجتماع الجمعية (الأول)، وجهت الدعوة إلى اجتماع (ثانٍ) يعقد خلال الأيام الـــ(خمسة عشر) التالية للاجتماع (الأول)، ولا يكون الاجتماع (الثاني) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (نصف) رأس مال المساهمة العقارية. وتصدر قرارات الجمعية في الاجتماعين (الأول) و(الثاني) بأغلبية الحصص الممثلة في الاجتماع، وفي حال تساوي الأصوات يعاد التصويت مرة أخرى. وإذا لم يتوافر النصاب اللازم في الاجتماع (الثاني)، وجهت الدعوة إلى اجتماع (ثالث) يعقد خلال الأيام الـــــ(سبعة) التالية للاجتماع (الثاني)، ويكون الاجتماع صحيحا أيًّا كانت نسبة الحصص الممثلة فيه بشرط ألا يقل عدد الحضور عن (ثلاثة) أشخاص، وتصدر قرارات الجمعية بأغلبية حصص الممثلين في الاجتماع.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/843bb38e3e6242d787db8defeb8e1b53\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز عقد اجتماعات الجمعية والتصويت على قراراتها؛ بواسطة وسائل التقنية الحديثة التي تحددها اللائحة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a898e814eaea4e80a258195c552fb70b\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز بيع أصول المساهمة العقارية إلا بعد تقييم الأصول من مقيمين معتمدين وفقاً لنظام المقيمين المعتمدين، ووفقاً لما تحدده اللائحة من إجراءات. ويعد باطلاً أي تصرف ينطوي على إخلال بما نصت عليه هذه المادة</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يكون بيع أصول المساهمة العقارية بإحدى الطرق الآتية:&nbsp;</p>\\n<p>1. البيع بمزاد علني.&nbsp;</p>\\n<p>2. البيع المباشر لكامل أو لجزء من المساهمة العقارية.&nbsp;</p>\\n<p>3. أي طريقة أخرى تحددها اللائحة. &nbsp;&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (السابعة عشرة) من النظام، تحتفظ المساهمة العقارية بالشخصية الاعتبارية بالقدر اللازم لتصفيتها، وتنقضي بإحدى الحالات الآتية:</p>\\n<p>1. بيعها وفقاً لأحكام النظام واللائحة.</p>\\n<p>2. انقضاء المدة المحددة لها ما لم تمدد وفقاً لأحكام النظام واللائحة.</p>\\n<p>3. استحالة تحقق الغرض الذي أسست من أجله.</p>\\n<p>4. إلغاؤها وفقاً لأحكام النظام واللائحة.</p>\\n<p>5. صدور حكم قضائي نهائي بتصفيتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c405c6afde7845949307128e5e606799\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب أن تودع جميع العوائد المالية المتعلقة بالمساهمة العقارية مباشرة في حساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9332cee318c7428db9321e6a2c6f6e09\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يتولى ضبط ما يقع من مخالفات لأحكام النظام أو اللائحة موظفون من الهيئة ومن أي جهة أخرى ترى الهيئة الاستعانة بموظفيها، يصدر بتعيينهم قرار من الرئيس بعد موافقة جهاتهم. ولمسؤولي الضبط دخول المواقع والمشاريع المتعلقة بالأنشطة المشمولة بالنظام بما فيها مقر المرخص له، وعليهم ضبط المخالفات والتحفظ على المستندات والوثائق والأدلة المتعلقة بها وفقاً لإجراءات الضبط الصادرة عن الهيئة ويكونون تحت إشراف الهيئة، ولهم الاستعانة بالجهات الأمنية عند الحاجة. وتحدد اللائحة طريقة عملهم، وصلاحياتهم، ومكافآتهم.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/31ee9c8b6dde44149082ef7899105498\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بما نصت عليه المادة (الخامسة والثلاثون) من النظام، يعاقب كل من يخالف أيًّا من أحكام النظام أو اللائحة بواحدة أو أكثر من العقوبات الآتية:</p>\\n<p>1. الإنذار.</p>\\n<p>2. إيقاف الترخيص مدة لا تزيد على (سنة).</p>\\n<p>3. إلغاء الترخيص.&nbsp;</p>\\n<p>4. غرامة لا تزيد على (10,000,000) عشرة ملايين ريال.</p>\\n<p>5. منع المرخص له أو مدير المساهمة العقارية من القيام -مستقبلاً- بأي عمل مرتبط بالمساهمات العقارية لمدة لا تتجاوز (10) عشر سنوات.<br>ويصدر المجلس جدولاً يتضمن تصنيفاً للمخالفات والعقوبات المقررة لها بناءً على ما نصت عليه هذه المادة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5a5abd23215c493c9012794253fc4cca\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>تُكوّن بقرار من رئيس الهيئة لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة ويسمى أحدهم رئيساً، ويكون من بينهم مستشار شرعي أو نظامي؛ تتولى النظر في المخالفات وإيقاع العقوبات المنصوص عليها في المادة (الثانية والثلاثين) من النظام، وذلك بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها، ويعتمد قرار اللجنة من رئيس الهيئة أو من يفوضه بذلك. ويصدر الرئيس قواعد عمل اللجنة وتحديد مكافآت أعضائها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ccce849536754853bd86c23ce8fd1ad6\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجوز التظلم من قرار اللجنة المنصوص عليها في المادة (الثالثة والثلاثين) من النظام أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ الإبلاغ بالقرار.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال بأي عقوبة منصوص عليها في أي نظام آخر، يعاقب بالسجن مدة لا تزيد على (ثلاث) سنوات، كل من يخالف أيًّا من أحكام المواد الآتية: (الرابعة)، و(الحادية والعشرون)، و(السابعة والعشرون)، و(الثلاثون)، من النظام، وتحال إلى النيابة العامة؛ للتحقيق فيها، والادعاء فيها أمام المحكمة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>دون إخلال باختصاصات الهيئة، تنظم هيئة السوق المالية بالاتفاق مع الهيئة ما يتعلق بجمع الأموال لغرض طرح المساهمة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\",\n      \"title\": \"المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر المجلس اللائحة بالاتفاق مع هيئة السوق المالية، وذلك خلال (مائة وعشرين) يوماً من تاريخ صدور النظام، ويعمل بها من تاريخ العمل به.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bcc8ff0ae01e4220a1730b4f97160416\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>ينشر النظام في الجريدة الرسمية، ويعمل به بعد (مائة وعشرين) يوماً من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - description","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقاري","change":"Update"},{"success":true,"name":"Property - header (ar-jo)","path":"/Properties/*/Value","oldValue":"نظام المساهمات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - header (en-us)","path":"/Properties/*/Value","oldValue":"نظام المساهمات العقارية","newValue":"","change":"Delete"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"نظام المساهمات العقارية\",\n  \"المساهمات العقارية\",\n  \"نظام\",\n  \"الانظمة\",\n  \"الانظمة واللوائح والادلة\",\n  \"الهيئة العامة للعقار\"\n]","change":"Update"},{"success":true,"name":"Property - legislationDocuments (ar-jo)","path":"/Properties/*/Value","oldValue":"[]","newValue":"","change":"Delete"},{"success":true,"name":"Property - pageName","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام المساهمات العقارية","change":"Update"},{"success":true,"name":"Property - publishDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2023-07-21T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - publishDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2023-07-16T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"ساري\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Active\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"أنظمة\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Laws\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - subContent (ar-jo)","path":"/Properties/*/Value","oldValue":"مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقاري","newValue":"","change":"Delete"},{"success":true,"name":"Property - subContent (en-us)","path":"/Properties/*/Value","oldValue":"مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقاري","newValue":"","change":"Delete"},{"success":true,"name":"Property - title","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام المساهمات العقارية","change":"Update"}],"key":"7a3f9cb7-04ad-4097-9eb3-f2a3ab9a1887"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/a010cf32-b4ff-4cbc-b7b8-6ca30de18589.config","name":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - attachedFile (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"c488a367-2362-4f0f-8e91-217df626ef2d\",\n    \"mediaKey\": \"054d0862-7f66-4af0-ad36-151c4102b2d4\"\n  }\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - attachedFile (en-us)","path":"/Properties/*/Value","oldValue":"/media/uyrobkjd/نظام-ملكية-الوحدات-العقارية-وفرزها-وإدارتها.pdf","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (ar-jo)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/ef52df2871644db7a045d05b90dd4ddf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fb9d086ddb4641d98ba071c274162055\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ed4e6f3b764f431d9e3869347cd29c93\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f76987b38c4041ef80447cfc67b24e45\"\n      },\n      {\n        \"contentUdi\": \"umb://element/30648c2fd7034649a763e9bcb0cc8638\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a2f3452c49bc49e88d39fb76d67e570b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b9cb6cd5c8954466be491c3461789f51\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0940da9751c8407c99734d7bd7ff63f2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/270f57015bb14105a3c3e9d9221c6a6c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a8419db0eb3407c92cea9cd4994175e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/db7126b48f5449b38d5cf5ed6ea56561\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d6767541d33346daadddc3ab06f5e3bc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ff275c97c6d54383b5c8c4f673abf020\"\n      },\n      {\n        \"contentUdi\": \"umb://element/12a7dd97c5a0441cbc43cd195aaca44b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bd17e769f9504bdc9ab5f880062a66bf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a609c85777394cdb982218cca21e0fde\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73ce149393254a39ab62b593067884d1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/226742f0f64845a999896b9e8cde5449\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1970f3f8f34e4a3399e85ee73ff465eb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/52e225e43d8b43fa8a30c4df451e3f12\"\n      },\n      {\n        \"contentUdi\": \"umb://element/18a95d9e41814fc184498429952e0a2a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cdd9ef6a10934836ae35964ab2ccfaa1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/005d9e7e09894ef2b44d2d7ce6b4af2d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3a57f986343a4a6fa377cf36b5ebb673\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0f4c5e596a154bf48092cd1453f4aeb2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73a597672122447ca4f556f7bfadea20\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cec38f04baf8452cadd72ef8543c05c4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1f03fdc5a160409a9fbab941eb0eaf07\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2457ff68755b4901a2bfb4c5ee91d218\"\n      },\n      {\n        \"contentUdi\": \"umb://element/714570c756204add87d9919d11a4776d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/19a04e84e11d4063b2fb1e96e59b2cea\"\n      },\n      {\n        \"contentUdi\": \"umb://element/753656c4f7ae4e9fac52e678cecfb84c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c513c133ea5e4adaa7f58354ab580224\"\n      },\n      {\n        \"contentUdi\": \"umb://element/460fdc8d47f64fd0b41633584be6585b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/13f67891c4724f189afeaacddde41106\"\n      },\n      {\n        \"contentUdi\": \"umb://element/39091c6fbf6144d5baa54e9f8e9248b7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/65cf170c5e564fdda444da08f65cd4dd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8979de2f75a044f38992cf2f7427f145\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5906093d053f441e98f719a1277ce7a4\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fb9d086ddb4641d98ba071c274162055\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">يقصد بالكلمات والعبارات الآتية - أينما وردت في هذا النظام - المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br><strong>النظام:</strong> نظام ملكية الوحدات العقارية وفرزها وإدارتها.<br><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.<br><strong>الهيئة: </strong>الهيئة العامة للعقار.<br><strong>المالك:</strong> الشخص ذو الصفة الطبيعية أو المعنوية الذي يمتلك وحدة أو أكثر من الوحدات العقارية المفرزة.<br><strong>الأرض: </strong>العقار المخصص لتشييد بناء أو أكثر عليه بمرافقه وخدماته، ومستكملة فيه الإجراءات النظامية المعتمدة.<br><strong>الفرز:</strong> إجراء بموجبه يتم تقسيم العقار المقام عليه بناء إلى وحدات مستقلة لغرض التصرف في كل وحدة على حدة.<br><strong>الوحدة العقارية المفرزة:</strong> الجزء المحدد في العقار المشترك الذي يخول مالكه الانتفاع به والتصرف فيه مستقلاً عن أجزاء العقار الأخرى، ويشمل ذلك المنزل أو الشقة أو الطبقة أو المحل التجاري أو المرآب (كراج)، أو أي جزء من العقار المشترك أو المجمع العقاري يمكن تملكه أو الانتفاع به أو التصرف فيه؛ بشكل مستقل.<br><strong>الأجزاء المشتركة:</strong> أجزاء من العقار المشترك أو المجمع العقاري معدة للاستعمال المشترك، أو التي تقتضي طبيعتها اشتراك ملكيتها بين ملاك الوحدات العقارية المفرزة، وتشمل: الأرض، والمداخل، والممرات، والمواقف، والخزانات، والقنوات، والخدمات، والمسابح، والحدائق، والساحات، والمصاعد، ونحوها.<br><strong>العقار المشترك:</strong> عقار مكون من وحدات عقارية مفرزة وأجزاء مشتركة.<br><strong>المجمع العقاري:</strong> مجموعة من العقارات المشتركة ذات الاستعمال الواحد أو متعددة الاستعمالات التي تقع ضمن مساحة جغرافية محددة، وترتبط ببعضها من خلال أجزاء مشتركة.<br><strong>جمعية الملاك: </strong>كيان يؤسسه الملاك - أو من يمثلهم - في عقار مشترك لغرض إدارة جميع شؤون ذلك العقار، وفقاً لأحكام النظام والنظام الأساسي.<br><strong>النظام الأساسي: </strong>النظام الأساسي لجمعية الملاك.<br><strong>الميزانية:</strong> ميزانية جمعية الملاك السنوية لإدارة العقار المشترك.<br><strong>الجمعية العامة: </strong>الجمعية العامة لجمعية الملاك.<br><strong>المدير:</strong> الشخص أو الأشخاص ذوو الصفة الطبيعية أو المعنوية المعينون لإدارة العقار المشترك أو المجمع العقاري.<br><strong>الصيانة:</strong> الأعمال اللازمة لحفظ العقار المشترك أو المجمع العقاري وحفظ منفعتهما.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f76987b38c4041ef80447cfc67b24e45\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- لكل مالك أرض بصك مستوفٍ للمتطلبات الشرعية والنظامية أن يبني عليها بناءً ويفرزه إلى وحدات مستقلة، وله إصدار صك ملكية لكل وحدة عقارية مفرزة، وذلك بحسب الإجراءات النظامية المعتمدة.<br>2- ترقم الوحدات العقارية المفرزة في العقار المشترك ترقيماً تسلسلياً بحيث لا يتكرر رقم واحد لوحدتين مفرزتين في العقار المشترك نفسه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/30648c2fd7034649a763e9bcb0cc8638\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يجوز إعادة فرز العقار المشترك أو جزء منه أو تغيير استعمالاته؛ بعد موافقة الجمعية العامة، وموافقة المرتهن إن وجد. ولا يخل ذلك بحق المتضرر في اللجوء إلى المحكمة المختصة.<br>2- يجب تعديل مخطط العقار المشترك بما يتفق مع إعادة الفرز أو تغيير استعماله، وموافقة الجهات المختصة على ذلك.<br>3- إذا طرأ أي تغيير على العقار المشترك، فيعد الملاك شركاء فيما ينتج عن هذا التغيير كل بنسبة مساحة وحدته العقارية المفرزة إلى إجمالي مساحة الوحدات العقارية المفرزة المحددة في الوثيقة الصادرة عن الهيئة باعتماد الفرز. ويجوز الاتفاق على الأخذ في الاعتبار قيمة الوحدة العقارية المفرزة ومساحتها، عند تحديد حصة كل مالك فيما ينتج عن هذا التغيير.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2f3452c49bc49e88d39fb76d67e570b\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تعتمد الهيئة الفرز وإعادة الفرز، وتحدد اللائحة الإجراءات اللازمة لذلك، وللهيئة إسناد بعض أنشطتها في هذا الخصوص إلى القطاع الخاص.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0940da9751c8407c99734d7bd7ff63f2\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على الشركاء عند بناء عقار مشترك تضمين عقد الشراكة أسماء أصحاب الحصص العينية وأصحاب الحصص النقدية، وأوصاف الأرض المعدة للبناء، ورقم صك الملكية وتاريخه ومصدره، والتزامات الشركاء وحقوقهم.<br>2- للشركاء في عقار مشترك أن يتقاسموا حصصهم المشاعة فيه، ويختص كل منهم بوحدة عقارية مفرزة أو أكثر، فإن لم يتفقوا على القسمة فلطالبها اللجوء إلى المحكمة المختصة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/270f57015bb14105a3c3e9d9221c6a6c\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><br>1- على المالك أن يفصح - في بيان - لمن يرغب في شراء وحدته العقارية المفرزة عن جميع المعلومات الخاصة بمواصفاتها وملاحقها، وجميع حقوقه والتزاماته المرتبطة بها، وأن يضمِّن البيان وصفاً كافياً للعقار المشترك، ومحتوياته وإدارته وتنظيم ملكيته، ويجب إشعار الراغب في الشراء بأي تغيير قد يطرأ على تلك المعلومات قبل إبرام عقد البيع. وتعد هذه المعلومات جزءاً لا يتجزأ من عقد البيع. وتحدد اللائحة الأحكام الخاصة بذلك.<br>2- إذا لم يشتمل بيان الإفصاح على المعلومات الواجب الإفصاح عنها بناءً على الفقرة (1) من هذه المادة، فللمشتري الحق في فسخ عقد البيع خلال (ثلاثين) يوماً تبدأ من تاريخ توقيعه، أو من تاريخ العلم بتلك المعلومات إذا كانت جوهرية وترتب على إخفائها إلحاق ضرر به أو عدم صلاحية الوحدة العقارية المفرزة للانتفاع بها في الغرض الذي اشتريت من أجله. ولا يتحمل المشتري أي تكاليف ناشئة عن فسخ العقد.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a8419db0eb3407c92cea9cd4994175e\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يكون ملاك الوحدات العقارية المفرزة في عقار مشترك واحد شركاء في الأجزاء المشتركة، وإذا تعدد ملاك وحدة عقارية مفرزة فإنهم يعدون جميعاً شركاء على الشيوع في ملكية الأجزاء المشتركة. وفي جميع الأحوال للملاك الاتفاق على غير ذلك.<br>2- تكون ملكية الحواجز الجانبية، والحيطان، والأرضيات، والأسقف، بين وحدتين عقاريتين مفرزتين متلاصقتين مشتركة بين ملاكها ما لم يكن بينهما فاصل إنشائي، وما لم يثبت غير ذلك، ولا يحق لأي من الملاك استعمال الجزء المخصص له فيما يلحق ضرراً بالآخر أو بباقي الملاك.<br>3- تكون الأجزاء المشتركة التي تقتصر منفعتها على بعض المالكين ملكاً مشتركاً بينهم، ما لم يتفق على غير ذلك.<br>4- تكون حصة كل مالك في الأجزاء المشتركة - فيما لا يقبل القسمة - جزءاً مشاعاً، وتلحق بوحدته العقارية المفرزة إلحاقاً تاماً في جميع التصرفات النظامية الواقعة على الوحدة، ما لم يتفق على غير ذلك.<br>5- تكون حصة كل مالك في الأجزاء المشتركة بما يعادل نسبة مساحة وحدته العقارية المفرزة إلى إجمالي مساحة الوحدات العقارية المفرزة في الوثيقة الصادرة عن الهيئة باعتماد الفرز أو في رخصة بناء العقار المشترك في حالة بيع الوحدات العقارية المفرزة على الخارطة. ويجوز الاتفاق على الأخذ في الاعتبار قيمة الوحدة المفرزة، ومساحتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/db7126b48f5449b38d5cf5ed6ea56561\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يكون التصرف في جميع الوحدات العقارية المفرزة أو بعضها باعتبار كل وحدة منها مستقلة عن الأخرى.<br>2- لكل مالك الحق في أن ينتفع بوحدته العقارية المفرزة، بما لا يتعارض مع الاستعمال المخصص لها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6767541d33346daadddc3ab06f5e3bc\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على كل مالك وفقاً لأحكام النظام، ألا يغلو في استعمال حقه في الانتفاع بوحدته العقارية المفرزة أو بالأجزاء المشتركة إلى الحد الذي يضر بجاره، وليس للجار أن يرجع على جاره في مضار الجوار المألوفة التي لا يمكن تجنبها، وإنما له أن يطلب إزالة هذه المضار إذا تجاوزت المألوف، على أن يراعي في ذلك الآداب العامة والعرف وطبيعة العقار وموقع كل وحدة عقارية مفرزة بالنسبة إلى الأخرى والغرض الذي خصصت له كل وحدة.<br>2- لا يحق لأي مالك القيام بعمل من شأنه الإضرار بالهيكل الإنشائي أو التأثير على الواجهات، ولا يجوز له استخدام الأجزاء المشتركة إلا فيما خصصت له، ولا يجوز إشغالها بأي عوائق تؤثر في هذا الاستخدام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ff275c97c6d54383b5c8c4f673abf020\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">دون إخلال بما تقضي به الأنظمة ذات الصلة، إذا اقتضت المصلحة العامة نزع ملكية العقار المشترك أو جزء منه، يكون التعويض لكل مالك بقدر نسبة قيمة ما يملكه من العقار المشترك، ويكون التعويض لصاحب الجزء المنزوع في حال كان المنزوع جزءاً مفرزاً من العقار المشترك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/12a7dd97c5a0441cbc43cd195aaca44b\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تتم إجراءات نقل الملكية أمام الجهات المختصة بتوثيق العقود والإقرارات وإصدار الصكوك المتعلقة بها، وفقاً للإجراءات النظامية المعتمدة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a609c85777394cdb982218cca21e0fde\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- إذا بلغ عدد ملاك الوحدات العقارية المفرزة في عقار مشترك ثلاثة فأكثر؛ فعليهم أن يؤسسوا جمعية بينهم لإدارة شؤون ذلك العقار، وتسجيل تلك الجمعية لدى الهيئة، وإذا كان بيع الوحدة العقارية المفرزة على الخارطة فيكون تسجيل جمعية الملاك اعتباراً من تاريخ البدء في تسليم ثاني وحدة عقارية مفرزة.<br>2- تتمتع جمعية الملاك بالشخصية المعنوية المستقلة - بعد تسجيلها وفق أحكام النظام - وتكون لها ذمة مالية مستقلة.<br>3- تتولى الهيئة تسجيل جمعيات الملاك، وتنظيم أعمالها، وتحدد اللائحة الإجراءات اللازمة لذلك. وللهيئة إسناد بعض أنشطتها في هذا الخصوص إلى القطاع الخاص.<br>4- يكون لكل جمعية ملاك نظام أساسي لضمان حسن الانتفاع بالعقار المشترك وحسن إدارته بما لا يتعارض مع أحكام النظام، ويعد توافره شرطاً لتسجيل الجمعية. وتحدد اللائحة الأحكام الواجب توافرها فيه، على أن تشمل تلك الأحكام ما يلي:<br>أ- قواعد عمل الجمعية العامة والمدير.<br>ب- الأحكام المتعلقة باستعمال الأجزاء المشتركة وإدارتها.<br>ج- قواعد تحديد مبلغ اشتراكات الملاك المطلوب سدادها لإدارة العقار المشترك وصيانة الأجزاء المشتركة.<br>د- تحديد بداية السنة المالية لجمعية الملاك ونهايتها، وقواعد الصرف من ميزانية الجمعية، وأساليب المراقبة المالية.<br>هـ- القواعد التي تتبع عند انقضاء جمعية الملاك، وإجراءات تصفيتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73ce149393254a39ab62b593067884d1\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- للملاك في العقارات المشتركة التي تقع ضمن مجمع عقاري إنشاء جمعية ذات شخصية معنوية مستقلة تسمى (جمعية المجمع)، تضم ممثلاً أو أكثر عن جمعية الملاك في كل عقار مشترك يقع ضمن المجمع العقاري، أو عن الملاك إذا لم يكن أنشئ للعقار المشترك جمعية ملاك.<br>2- تسري على (جمعية المجمع) الأحكام الخاصة بجمعية الملاك، وذلك في حدود ما يتفق مع طبيعتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/226742f0f64845a999896b9e8cde5449\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تعد جمعية الملاك ممثلةً للملاك فيما يتعلق بالتصرفات التي تنشأ على الأجزاء المشتركة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1970f3f8f34e4a3399e85ee73ff465eb\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">دون إخلال بحكم المادة (السادسة) من النظام، يعد امتلاك وحدة عقارية مفرزة في عقار مشترك - مؤسسة له جمعية ملاك - قبولاً من المالك بالنظام الأساسي، والتزاماً منه بالقرارات التي تصدرها الجمعية العامة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/52e225e43d8b43fa8a30c4df451e3f12\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">ليس لجمعية الملاك أن تحد أو أن تقيد من حقوق المالك في التصرف بوحدته العقارية المفرزة، أو في الانتفاع بها، أو بالأجزاء المشتركة في حدود الأغراض التي أعدت من أجلها، وبما لا يضر بباقي الملاك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/18a95d9e41814fc184498429952e0a2a\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">إذا تعدد ملاك الوحدة العقارية المفرزة، وجب عليهم أن يختاروا من بينهم من يمثلهم في الجمعية العامة، وتعد قرارات الجمعية العامة ملزمة لجميع الشركاء في الوحدة العقارية المفرزة الواحدة، كل بحسب حصته في ملكية تلك الوحدة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cdd9ef6a10934836ae35964ab2ccfaa1\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- تكون لجمعية الملاك جمعية عامة تتكون من جميع الملاك.<br>2- تختص الجمعية العامة بجميع الأمور المتعلقة بجمعية الملاك، ولها على وجه الخصوص الآتي:<br>أ- الاطلاع على تقرير المدير المتعلق بإدارة العقار المشترك وجمعية الملاك ومركزها المالي خلال السنة المالية، وتقرير مراجع الحسابات إن وجد، واعتمادهما.<br>ب- مناقشة الميزانية السنوية لجمعية الملاك واعتمادها.<br>ج- تعيين المدير ومراجع الحسابات، وتحديد أجورهما.<br>د- إبراء ذمة المدير.<br>هـ- تعديل النظام الأساسي.<br>3- تنتخب الجمعية العامة رئيساً لها من بين أعضائها يتولى رئاسة اجتماعاتها ومتابعة قراراتها، وتكون مدة رئاسته (ثلاث) سنوات قابلة للتجديد.<br>4- تعقد الجمعية العامة بدعوة من رئيسها وفقاً للقواعد التي يحددها النظام الأساسي، على أن تعقد مرة على الأقل في السنة خلال الشهور (الثلاثة) التالية لنهاية السنة المالية لجمعية الملاك.<br>5- يجوز دعوة الجمعية العامة للانعقاد في أي وقت بناءً على طلب المدير أو مراجع الحسابات - إن وجد - أو عدد من الملاك يمثل نصف إجمالي عدد الوحدات العقارية المفرزة في العقار المشترك على الأقل.<br>6- تكون قرارات الجمعية العامة صحيحة إذا وافق عليها عدد من الملاك تمثل نسبة ملكيتهم (ثلاثة أرباع) إجمالي مساحة الوحدات العقارية المفرزة على الأقل، ما لم ينص النظام الأساسي على نسبة أعلى من ذلك. وفي حال كانت مساحة حصة أحد الملاك تزيد على النصف، أنقص عدد ما له من أصوات إلى ما يساوي النصف.<br>7- للهيئة أن توفد مندوباً - أو أكثر - لحضور اجتماعات الجمعيات العامة؛ للتأكد من تطبيق أحكام النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/005d9e7e09894ef2b44d2d7ce6b4af2d\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يتولى إدارة العقار المشترك مدير من الملاك أو من غيرهم، ويحدد النظام الأساسي قواعد تعيينه وطريقة عمله.<br>2- مع مراعاة الاختصاصات المقررة للجمعية العامة، يحدد النظام الأساسي صلاحيات المدير في إدارة العقار المشترك، وتلتزم جمعية الملاك بكل تصرف يجريه المدير باسم الجمعية وفي حدود أغراضها.<br>3- للمدير بقرار مكتوب أن يفوض بعض صلاحياته إلى غيره في مباشرة عمل أو أعمال محددة.<br>4- للمالك الذي بنى العقار المشترك الانفراد بتعيين المدير، على أن يلتزم بالآتي:<br>أ- المحافظة على ملكية نسبة لا تقل عن عشرة في المائة (10 %) من عدد الوحدات العقارية المفرزة في العقار المشترك.<br>ب- الشروط التي تحددها اللائحة.<br>5- يكون المدير مسؤولاً عن تعويض جمعية الملاك أو الملاك عن الضرر الذي ينشأ عن مخالفته أحكام النظام أو النظام الأساسي. وتقع المسؤولية على جميع المديرين - في حال تعددوا - إذا نشأ ذلك الضرر بسبب قرار صدر بإجماعهم. أما القرارات التي تصدر بأغلبية الآراء، فلا يسأل عنها المديرون المعارضون متى أثبتوا اعتراضهم صراحة في محضر الاجتماع الذي صدر فيه القرار. ولا يعد الغياب عن حضور هذا الاجتماع سبباً للإعفاء من المسؤولية إلا إذا ثبت عدم علم المدير الغائب بالقرار أو عدم تمكنه من الاعتراض عليه بعد علمه به.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3a57f986343a4a6fa377cf36b5ebb673\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يعد المدير مشروع ميزانية سنوية لجمعية الملاك يتضمن تكاليف إدارة العقار المشترك وصيانة الأجزاء المشتركة، تمهيداً لعرضه على الجمعية العامة لاعتماده.<br>2- تكون السنة المالية لجمعية الملاك (اثني عشر) شهراً تحدد في نظامها الأساسي. واستثناءً من ذلك يمكن أن تحدد السنة المالية الأولى بما لا يقل عن (ستة) أشهر ولا يزيد على (ثمانية عشر) شهراً بدءاً من تاريخ تسجيل الجمعية.<br>3- أ- يُعِد المدير عن كل سنة مالية قوائم مالية لجمعية الملاك وتقريراً عن نشاطها ومركزها المالي، وذلك خلال (ثلاثة) أشهر من نهاية السنة المالية للجمعية. ويضع المدير تلك الوثائق تحت تصرف مراجع الحسابات - إن وجد - قبل الموعد المحدد لانعقاد الجمعية العامة بـ(خمسة وأربعين) يوماً على الأقل.<br>ب- على المدير أن يزود الهيئة وكل مالك بنسخة من الوثائق المشار إليها في الفقرة (3/أ) من هذه المادة ونسخة من تقرير مراجع الحسابات - إن وجد - وذلك خلال (شهر) من تاريخ إعدادها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0f4c5e596a154bf48092cd1453f4aeb2\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">دون إخلال بما تقضي به الأنظمة ذات الصلة، تكون قرارات المدير وعقود التعاملات التي يبرمها - وفقاً للصلاحيات المخولة له بموجب النظام - المتعلقة بالعقار المشترك أو المجمع العقاري بعد اعتمادها من الهيئة؛ سنداً تنفيذياً في مواجهة الملاك وفقاً لأحكام نظام التنفيذ. وتحدد اللائحة الإجراءات اللازمة لذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73a597672122447ca4f556f7bfadea20\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على جمعية الملاك في الحالات التي تحددها اللائحة تعيين مراجع حسابات مرخص له بالعمل في المملكة.<br>2- لمراجع الحسابات - في أيّ وقت - حق الاطلاع على دفاتر جمعية الملاك وسجلاتها وغير ذلك من الوثائق، وله أيضاً طلب البيانات والإيضاحات التي يرى ضرورة الحصول عليها، وإذا صادف مراجع الحسابات صعوبة في هذا الشأن أثبت ذلك في تقرير يقدمه إلى الجمعية العامة.<br>3- يعد مراجع الحسابات تقريراً سنوياً وفق معايير المراجعة المتعارف عليها ويعرضه على الجمعية العامة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cec38f04baf8452cadd72ef8543c05c4\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- في حالة تأجير الوحدة العقارية المفرزة، يظل المالك ملزماً أمام جمعية الملاك والغير بجميع الحقوق والواجبات المتعلقة بالوحدة العقارية المفرزة وبالأجزاء المشتركة، ما لم يتفق مع المستأجر على غير ذلك.<br>2- يجوز للمستأجرين في عقار مملوك لمالك واحد، وتزيد عقود تأجيرهم على (خمس) سنوات، الاتفاق مع المالك على تأسيس جمعية ملاك وفقاً لأحكام هذا الفصل، وإدارته وصيانته وفقاً لأحكام الفصل (الخامس) من النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1f03fdc5a160409a9fbab941eb0eaf07\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- تتكون موارد جمعية الملاك مما يأتي:<br>أ- اشتراكات الملاك.<br>ب- التبرعات والهبات والوصايا والأوقاف.<br>ج- عوائد استثمار أموال جمعية الملاك والأجزاء المشتركة القابلة للاستثمار.<br>وتحدد اللائحة الأحكام المنظمة للفقرتين (1/ب) و(1/ج) من هذه المادة.<br>2- تصرف أموال جمعية الملاك لأغراض إدارة العقار المشترك وصيانة الأجزاء المشتركة.<br>3- على كل مالك دفع مبلغ اشتراكه في تكاليف إدارة العقار المشترك وصيانة الأجزاء المشتركة، وليس لأي مالك التخلي عن حصته في الأجزاء المشتركة بغية التخلص من الاشتراك في تكاليف حفظها أو صيانتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2457ff68755b4901a2bfb4c5ee91d218\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تنقضي جمعية الملاك إذا انخفض عدد الملاك عن العدد اللازم لتأسيسها، ما لم يرغب من تبقى من الملاك في استمرار الجمعية وفقاً لأحكام النظام. ولا يؤثر انقضاء الجمعية في مسؤوليتها عن ديونها والتزاماتها السابقة لتاريخ انقضائها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/19a04e84e11d4063b2fb1e96e59b2cea\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يشترك كل مالك في تكاليف صيانة الأجزاء المشتركة وإدارتها؛ كلٌّ بقدر نسبة مساحة الجزء المفرز الذي يملكه إلى إجمالي مساحة الأجزاء المفرزة في العقار المشترك. ويجوز أن تختلف قيمة مساهمة المالك في تلك التكاليف باختلاف نوع استعمال الوحدة العقارية المفرزة إذا كانت ضمن عقار مشترك متعدد الاستعمالات.<br>2- لأي مالك - بعد موافقة جمعية الملاك - أن يحسّن على نفقته الانتفاع بالأجزاء المشتركة أو جزء منها دون أن يغير من نوع استعمالها أو يلحق الضرر بالآخرين.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/753656c4f7ae4e9fac52e678cecfb84c\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على المالك القيام بالصيانة اللازمة لوحدته العقارية المفرزة ولو لم يكن ينتفع بها، لمنع إلحاق ضرر بالعقار المشترك، ويلتزم بألاَّ يحدث في وحدته العقارية المفرزة ما يضر بالعقار المشترك.<br>2- إذا دعت الضرورة إجراء بعض الأعمال داخل أي وحدة عقارية مفرزة؛ حفظاً لسلامة العقار المشترك أو لتحسين الانتفاع بالأجزاء المشتركة أو صيانتها، فليس لمالك تلك الوحدة المعارضة في ذلك، على أن تعاد الحال في هذه الوحدة إلى ما كانت عليه فور انتهاء الأعمال اللازمة، ولا يتحمل مالكها أي تكاليف ناشئة عن ذلك، وتحدد اللائحة الأحكام الخاصة بذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c513c133ea5e4adaa7f58354ab580224\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تلتزم جمعية الملاك بإدارة العقار المشترك، وفق معايير تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/460fdc8d47f64fd0b41633584be6585b\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- إذا تضرر العقار المشترك تضرراً جزئيًّا، فعلى الملاك إصلاحه بحسب ما تقرره الجمعية العامة، ما لم يتفق على غير ذلك.<br>2- إذا انهدم العقار المشترك تقرر الجمعية العامة ما تراه، وفي حال الاختلاف يرفع الأمر إلى المحكمة المختصة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/13f67891c4724f189afeaacddde41106\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- لا يجوز إجراء أي تعديل في الشكل الخارجي للعقار المشترك إلا بعد موافقة الجمعية العامة.<br>2- يشترط موافقة الجمعية العامة قبل إجراء أي عمل يترتب عليه زيادة في قيمة العقار المشترك كله أو بعضه، وذلك على نفقة من يطلبه من الملاك وبما تضعه الجمعية من شروط وما تفرضه من تعويضات والتزامات أخرى لمصلحة الملاك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/65cf170c5e564fdda444da08f65cd4dd\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">يقترح مجلس إدارة الهيئة اللائحة وتصدر بقرار من وزير الإسكان خلال (مائة وثمانين) يوماً من تاريخ صدور النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8979de2f75a044f38992cf2f7427f145\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">يحل النظام محل نظام ملكية الوحدات العقارية وفرزها، الصادر بالمرسوم الملكي<br>رقم (م/5) والتاريخ 11/2/1423هـــ، ويلغي كل ما يتعارض معه من أحكام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5906093d053f441e98f719a1277ce7a4\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يعمل بالنظام بعد (مائة وثمانين) يوماً من تاريخ نشره في الجريدة الرسمية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ef52df2871644db7a045d05b90dd4ddf\",\n      \"title\": \"الفصل الأول: تعريفات\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ed4e6f3b764f431d9e3869347cd29c93\",\n      \"title\": \"الفصل الثاني: فرز العقار\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b9cb6cd5c8954466be491c3461789f51\",\n      \"title\": \"الفصل الثالث: أحكام الملكية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bd17e769f9504bdc9ab5f880062a66bf\",\n      \"title\": \"الفصل الرابع: جمعية الملاك\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/714570c756204add87d9919d11a4776d\",\n      \"title\": \"الفصل الخامس: الإدارة والصيانة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/39091c6fbf6144d5baa54e9f8e9248b7\",\n      \"title\": \"الفصل السادس: أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (en-us)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/fb9d086ddb4641d98ba071c274162055\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f76987b38c4041ef80447cfc67b24e45\"\n      },\n      {\n        \"contentUdi\": \"umb://element/30648c2fd7034649a763e9bcb0cc8638\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a2f3452c49bc49e88d39fb76d67e570b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0940da9751c8407c99734d7bd7ff63f2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/270f57015bb14105a3c3e9d9221c6a6c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7a8419db0eb3407c92cea9cd4994175e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/db7126b48f5449b38d5cf5ed6ea56561\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d6767541d33346daadddc3ab06f5e3bc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ff275c97c6d54383b5c8c4f673abf020\"\n      },\n      {\n        \"contentUdi\": \"umb://element/12a7dd97c5a0441cbc43cd195aaca44b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a609c85777394cdb982218cca21e0fde\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73ce149393254a39ab62b593067884d1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/226742f0f64845a999896b9e8cde5449\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1970f3f8f34e4a3399e85ee73ff465eb\"\n      },\n      {\n        \"contentUdi\": \"umb://element/52e225e43d8b43fa8a30c4df451e3f12\"\n      },\n      {\n        \"contentUdi\": \"umb://element/18a95d9e41814fc184498429952e0a2a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cdd9ef6a10934836ae35964ab2ccfaa1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/005d9e7e09894ef2b44d2d7ce6b4af2d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3a57f986343a4a6fa377cf36b5ebb673\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0f4c5e596a154bf48092cd1453f4aeb2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/73a597672122447ca4f556f7bfadea20\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cec38f04baf8452cadd72ef8543c05c4\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1f03fdc5a160409a9fbab941eb0eaf07\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2457ff68755b4901a2bfb4c5ee91d218\"\n      },\n      {\n        \"contentUdi\": \"umb://element/19a04e84e11d4063b2fb1e96e59b2cea\"\n      },\n      {\n        \"contentUdi\": \"umb://element/753656c4f7ae4e9fac52e678cecfb84c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c513c133ea5e4adaa7f58354ab580224\"\n      },\n      {\n        \"contentUdi\": \"umb://element/460fdc8d47f64fd0b41633584be6585b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/13f67891c4724f189afeaacddde41106\"\n      },\n      {\n        \"contentUdi\": \"umb://element/65cf170c5e564fdda444da08f65cd4dd\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8979de2f75a044f38992cf2f7427f145\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5906093d053f441e98f719a1277ce7a4\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fb9d086ddb4641d98ba071c274162055\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">يقصد بالكلمات والعبارات الآتية - أينما وردت في هذا النظام - المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br>النظام: نظام ملكية الوحدات العقارية وفرزها وإدارتها.<br>اللائحة: اللائحة التنفيذية للنظام.<br>الهيئة: الهيئة العامة للعقار.<br>المالك: الشخص ذو الصفة الطبيعية أو المعنوية الذي يمتلك وحدة أو أكثر من الوحدات العقارية المفرزة.<br>الأرض: العقار المخصص لتشييد بناء أو أكثر عليه بمرافقه وخدماته، ومستكملة فيه الإجراءات النظامية المعتمدة.<br>الفرز: إجراء بموجبه يتم تقسيم العقار المقام عليه بناء إلى وحدات مستقلة لغرض التصرف في كل وحدة على حدة.<br>الوحدة العقارية المفرزة: الجزء المحدد في العقار المشترك الذي يخول مالكه الانتفاع به والتصرف فيه مستقلاً عن أجزاء العقار الأخرى، ويشمل ذلك المنزل أو الشقة أو الطبقة أو المحل التجاري أو المرآب (كراج)، أو أي جزء من العقار المشترك أو المجمع العقاري يمكن تملكه أو الانتفاع به أو التصرف فيه؛ بشكل مستقل.<br>الأجزاء المشتركة: أجزاء من العقار المشترك أو المجمع العقاري معدة للاستعمال المشترك، أو التي تقتضي طبيعتها اشتراك ملكيتها بين ملاك الوحدات العقارية المفرزة، وتشمل: الأرض، والمداخل، والممرات، والمواقف، والخزانات، والقنوات، والخدمات، والمسابح، والحدائق، والساحات، والمصاعد، ونحوها.<br>العقار المشترك: عقار مكون من وحدات عقارية مفرزة وأجزاء مشتركة.<br>المجمع العقاري: مجموعة من العقارات المشتركة ذات الاستعمال الواحد أو متعددة الاستعمالات التي تقع ضمن مساحة جغرافية محددة، وترتبط ببعضها من خلال أجزاء مشتركة.<br>جمعية الملاك: كيان يؤسسه الملاك - أو من يمثلهم - في عقار مشترك لغرض إدارة جميع شؤون ذلك العقار، وفقاً لأحكام النظام والنظام الأساسي.<br>النظام الأساسي: النظام الأساسي لجمعية الملاك.<br>الميزانية: ميزانية جمعية الملاك السنوية لإدارة العقار المشترك.<br>الجمعية العامة: الجمعية العامة لجمعية الملاك.<br>المدير: الشخص أو الأشخاص ذوو الصفة الطبيعية أو المعنوية المعينون لإدارة العقار المشترك أو المجمع العقاري.<br>الصيانة: الأعمال اللازمة لحفظ العقار المشترك أو المجمع العقاري وحفظ منفعتهما.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f76987b38c4041ef80447cfc67b24e45\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- لكل مالك أرض بصك مستوفٍ للمتطلبات الشرعية والنظامية أن يبني عليها بناءً ويفرزه إلى وحدات مستقلة، وله إصدار صك ملكية لكل وحدة عقارية مفرزة، وذلك بحسب الإجراءات النظامية المعتمدة.<br>2- ترقم الوحدات العقارية المفرزة في العقار المشترك ترقيماً تسلسلياً بحيث لا يتكرر رقم واحد لوحدتين مفرزتين في العقار المشترك نفسه.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/30648c2fd7034649a763e9bcb0cc8638\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يجوز إعادة فرز العقار المشترك أو جزء منه أو تغيير استعمالاته؛ بعد موافقة الجمعية العامة، وموافقة المرتهن إن وجد. ولا يخل ذلك بحق المتضرر في اللجوء إلى المحكمة المختصة.<br>2- يجب تعديل مخطط العقار المشترك بما يتفق مع إعادة الفرز أو تغيير استعماله، وموافقة الجهات المختصة على ذلك.<br>3- إذا طرأ أي تغيير على العقار المشترك، فيعد الملاك شركاء فيما ينتج عن هذا التغيير كل بنسبة مساحة وحدته العقارية المفرزة إلى إجمالي مساحة الوحدات العقارية المفرزة المحددة في الوثيقة الصادرة عن الهيئة باعتماد الفرز. ويجوز الاتفاق على الأخذ في الاعتبار قيمة الوحدة العقارية المفرزة ومساحتها، عند تحديد حصة كل مالك فيما ينتج عن هذا التغيير.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a2f3452c49bc49e88d39fb76d67e570b\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تعتمد الهيئة الفرز وإعادة الفرز، وتحدد اللائحة الإجراءات اللازمة لذلك، وللهيئة إسناد بعض أنشطتها في هذا الخصوص إلى القطاع الخاص.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0940da9751c8407c99734d7bd7ff63f2\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على الشركاء عند بناء عقار مشترك تضمين عقد الشراكة أسماء أصحاب الحصص العينية وأصحاب الحصص النقدية، وأوصاف الأرض المعدة للبناء، ورقم صك الملكية وتاريخه ومصدره، والتزامات الشركاء وحقوقهم.<br>2- للشركاء في عقار مشترك أن يتقاسموا حصصهم المشاعة فيه، ويختص كل منهم بوحدة عقارية مفرزة أو أكثر، فإن لم يتفقوا على القسمة فلطالبها اللجوء إلى المحكمة المختصة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/270f57015bb14105a3c3e9d9221c6a6c\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\"><br>1- على المالك أن يفصح - في بيان - لمن يرغب في شراء وحدته العقارية المفرزة عن جميع المعلومات الخاصة بمواصفاتها وملاحقها، وجميع حقوقه والتزاماته المرتبطة بها، وأن يضمِّن البيان وصفاً كافياً للعقار المشترك، ومحتوياته وإدارته وتنظيم ملكيته، ويجب إشعار الراغب في الشراء بأي تغيير قد يطرأ على تلك المعلومات قبل إبرام عقد البيع. وتعد هذه المعلومات جزءاً لا يتجزأ من عقد البيع. وتحدد اللائحة الأحكام الخاصة بذلك.<br>2- إذا لم يشتمل بيان الإفصاح على المعلومات الواجب الإفصاح عنها بناءً على الفقرة (1) من هذه المادة، فللمشتري الحق في فسخ عقد البيع خلال (ثلاثين) يوماً تبدأ من تاريخ توقيعه، أو من تاريخ العلم بتلك المعلومات إذا كانت جوهرية وترتب على إخفائها إلحاق ضرر به أو عدم صلاحية الوحدة العقارية المفرزة للانتفاع بها في الغرض الذي اشتريت من أجله. ولا يتحمل المشتري أي تكاليف ناشئة عن فسخ العقد.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7a8419db0eb3407c92cea9cd4994175e\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يكون ملاك الوحدات العقارية المفرزة في عقار مشترك واحد شركاء في الأجزاء المشتركة، وإذا تعدد ملاك وحدة عقارية مفرزة فإنهم يعدون جميعاً شركاء على الشيوع في ملكية الأجزاء المشتركة. وفي جميع الأحوال للملاك الاتفاق على غير ذلك.<br>2- تكون ملكية الحواجز الجانبية، والحيطان، والأرضيات، والأسقف، بين وحدتين عقاريتين مفرزتين متلاصقتين مشتركة بين ملاكها ما لم يكن بينهما فاصل إنشائي، وما لم يثبت غير ذلك، ولا يحق لأي من الملاك استعمال الجزء المخصص له فيما يلحق ضرراً بالآخر أو بباقي الملاك.<br>3- تكون الأجزاء المشتركة التي تقتصر منفعتها على بعض المالكين ملكاً مشتركاً بينهم، ما لم يتفق على غير ذلك.<br>4- تكون حصة كل مالك في الأجزاء المشتركة - فيما لا يقبل القسمة - جزءاً مشاعاً، وتلحق بوحدته العقارية المفرزة إلحاقاً تاماً في جميع التصرفات النظامية الواقعة على الوحدة، ما لم يتفق على غير ذلك.<br>5- تكون حصة كل مالك في الأجزاء المشتركة بما يعادل نسبة مساحة وحدته العقارية المفرزة إلى إجمالي مساحة الوحدات العقارية المفرزة في الوثيقة الصادرة عن الهيئة باعتماد الفرز أو في رخصة بناء العقار المشترك في حالة بيع الوحدات العقارية المفرزة على الخارطة. ويجوز الاتفاق على الأخذ في الاعتبار قيمة الوحدة المفرزة، ومساحتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/db7126b48f5449b38d5cf5ed6ea56561\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يكون التصرف في جميع الوحدات العقارية المفرزة أو بعضها باعتبار كل وحدة منها مستقلة عن الأخرى.<br>2- لكل مالك الحق في أن ينتفع بوحدته العقارية المفرزة، بما لا يتعارض مع الاستعمال المخصص لها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d6767541d33346daadddc3ab06f5e3bc\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على كل مالك وفقاً لأحكام النظام، ألا يغلو في استعمال حقه في الانتفاع بوحدته العقارية المفرزة أو بالأجزاء المشتركة إلى الحد الذي يضر بجاره، وليس للجار أن يرجع على جاره في مضار الجوار المألوفة التي لا يمكن تجنبها، وإنما له أن يطلب إزالة هذه المضار إذا تجاوزت المألوف، على أن يراعي في ذلك الآداب العامة والعرف وطبيعة العقار وموقع كل وحدة عقارية مفرزة بالنسبة إلى الأخرى والغرض الذي خصصت له كل وحدة.<br>2- لا يحق لأي مالك القيام بعمل من شأنه الإضرار بالهيكل الإنشائي أو التأثير على الواجهات، ولا يجوز له استخدام الأجزاء المشتركة إلا فيما خصصت له، ولا يجوز إشغالها بأي عوائق تؤثر في هذا الاستخدام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ff275c97c6d54383b5c8c4f673abf020\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">دون إخلال بما تقضي به الأنظمة ذات الصلة، إذا اقتضت المصلحة العامة نزع ملكية العقار المشترك أو جزء منه، يكون التعويض لكل مالك بقدر نسبة قيمة ما يملكه من العقار المشترك، ويكون التعويض لصاحب الجزء المنزوع في حال كان المنزوع جزءاً مفرزاً من العقار المشترك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/12a7dd97c5a0441cbc43cd195aaca44b\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تتم إجراءات نقل الملكية أمام الجهات المختصة بتوثيق العقود والإقرارات وإصدار الصكوك المتعلقة بها، وفقاً للإجراءات النظامية المعتمدة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a609c85777394cdb982218cca21e0fde\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- إذا بلغ عدد ملاك الوحدات العقارية المفرزة في عقار مشترك ثلاثة فأكثر؛ فعليهم أن يؤسسوا جمعية بينهم لإدارة شؤون ذلك العقار، وتسجيل تلك الجمعية لدى الهيئة، وإذا كان بيع الوحدة العقارية المفرزة على الخارطة فيكون تسجيل جمعية الملاك اعتباراً من تاريخ البدء في تسليم ثاني وحدة عقارية مفرزة.<br>2- تتمتع جمعية الملاك بالشخصية المعنوية المستقلة - بعد تسجيلها وفق أحكام النظام - وتكون لها ذمة مالية مستقلة.<br>3- تتولى الهيئة تسجيل جمعيات الملاك، وتنظيم أعمالها، وتحدد اللائحة الإجراءات اللازمة لذلك. وللهيئة إسناد بعض أنشطتها في هذا الخصوص إلى القطاع الخاص.<br>4- يكون لكل جمعية ملاك نظام أساسي لضمان حسن الانتفاع بالعقار المشترك وحسن إدارته بما لا يتعارض مع أحكام النظام، ويعد توافره شرطاً لتسجيل الجمعية. وتحدد اللائحة الأحكام الواجب توافرها فيه، على أن تشمل تلك الأحكام ما يلي:<br>أ- قواعد عمل الجمعية العامة والمدير.<br>ب- الأحكام المتعلقة باستعمال الأجزاء المشتركة وإدارتها.<br>ج- قواعد تحديد مبلغ اشتراكات الملاك المطلوب سدادها لإدارة العقار المشترك وصيانة الأجزاء المشتركة.<br>د- تحديد بداية السنة المالية لجمعية الملاك ونهايتها، وقواعد الصرف من ميزانية الجمعية، وأساليب المراقبة المالية.<br>هـ- القواعد التي تتبع عند انقضاء جمعية الملاك، وإجراءات تصفيتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73ce149393254a39ab62b593067884d1\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- للملاك في العقارات المشتركة التي تقع ضمن مجمع عقاري إنشاء جمعية ذات شخصية معنوية مستقلة تسمى (جمعية المجمع)، تضم ممثلاً أو أكثر عن جمعية الملاك في كل عقار مشترك يقع ضمن المجمع العقاري، أو عن الملاك إذا لم يكن أنشئ للعقار المشترك جمعية ملاك.<br>2- تسري على (جمعية المجمع) الأحكام الخاصة بجمعية الملاك، وذلك في حدود ما يتفق مع طبيعتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/226742f0f64845a999896b9e8cde5449\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تعد جمعية الملاك ممثلةً للملاك فيما يتعلق بالتصرفات التي تنشأ على الأجزاء المشتركة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1970f3f8f34e4a3399e85ee73ff465eb\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">دون إخلال بحكم المادة (السادسة) من النظام، يعد امتلاك وحدة عقارية مفرزة في عقار مشترك - مؤسسة له جمعية ملاك - قبولاً من المالك بالنظام الأساسي، والتزاماً منه بالقرارات التي تصدرها الجمعية العامة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/52e225e43d8b43fa8a30c4df451e3f12\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">ليس لجمعية الملاك أن تحد أو أن تقيد من حقوق المالك في التصرف بوحدته العقارية المفرزة، أو في الانتفاع بها، أو بالأجزاء المشتركة في حدود الأغراض التي أعدت من أجلها، وبما لا يضر بباقي الملاك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/18a95d9e41814fc184498429952e0a2a\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">إذا تعدد ملاك الوحدة العقارية المفرزة، وجب عليهم أن يختاروا من بينهم من يمثلهم في الجمعية العامة، وتعد قرارات الجمعية العامة ملزمة لجميع الشركاء في الوحدة العقارية المفرزة الواحدة، كل بحسب حصته في ملكية تلك الوحدة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cdd9ef6a10934836ae35964ab2ccfaa1\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- تكون لجمعية الملاك جمعية عامة تتكون من جميع الملاك.<br>2- تختص الجمعية العامة بجميع الأمور المتعلقة بجمعية الملاك، ولها على وجه الخصوص الآتي:<br>أ- الاطلاع على تقرير المدير المتعلق بإدارة العقار المشترك وجمعية الملاك ومركزها المالي خلال السنة المالية، وتقرير مراجع الحسابات إن وجد، واعتمادهما.<br>ب- مناقشة الميزانية السنوية لجمعية الملاك واعتمادها.<br>ج- تعيين المدير ومراجع الحسابات، وتحديد أجورهما.<br>د- إبراء ذمة المدير.<br>هـ- تعديل النظام الأساسي.<br>3- تنتخب الجمعية العامة رئيساً لها من بين أعضائها يتولى رئاسة اجتماعاتها ومتابعة قراراتها، وتكون مدة رئاسته (ثلاث) سنوات قابلة للتجديد.<br>4- تعقد الجمعية العامة بدعوة من رئيسها وفقاً للقواعد التي يحددها النظام الأساسي، على أن تعقد مرة على الأقل في السنة خلال الشهور (الثلاثة) التالية لنهاية السنة المالية لجمعية الملاك.<br>5- يجوز دعوة الجمعية العامة للانعقاد في أي وقت بناءً على طلب المدير أو مراجع الحسابات - إن وجد - أو عدد من الملاك يمثل نصف إجمالي عدد الوحدات العقارية المفرزة في العقار المشترك على الأقل.<br>6- تكون قرارات الجمعية العامة صحيحة إذا وافق عليها عدد من الملاك تمثل نسبة ملكيتهم (ثلاثة أرباع) إجمالي مساحة الوحدات العقارية المفرزة على الأقل، ما لم ينص النظام الأساسي على نسبة أعلى من ذلك. وفي حال كانت مساحة حصة أحد الملاك تزيد على النصف، أنقص عدد ما له من أصوات إلى ما يساوي النصف.<br>7- للهيئة أن توفد مندوباً - أو أكثر - لحضور اجتماعات الجمعيات العامة؛ للتأكد من تطبيق أحكام النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/005d9e7e09894ef2b44d2d7ce6b4af2d\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يتولى إدارة العقار المشترك مدير من الملاك أو من غيرهم، ويحدد النظام الأساسي قواعد تعيينه وطريقة عمله.<br>2- مع مراعاة الاختصاصات المقررة للجمعية العامة، يحدد النظام الأساسي صلاحيات المدير في إدارة العقار المشترك، وتلتزم جمعية الملاك بكل تصرف يجريه المدير باسم الجمعية وفي حدود أغراضها.<br>3- للمدير بقرار مكتوب أن يفوض بعض صلاحياته إلى غيره في مباشرة عمل أو أعمال محددة.<br>4- للمالك الذي بنى العقار المشترك الانفراد بتعيين المدير، على أن يلتزم بالآتي:<br>أ- المحافظة على ملكية نسبة لا تقل عن عشرة في المائة (10 %) من عدد الوحدات العقارية المفرزة في العقار المشترك.<br>ب- الشروط التي تحددها اللائحة.<br>5- يكون المدير مسؤولاً عن تعويض جمعية الملاك أو الملاك عن الضرر الذي ينشأ عن مخالفته أحكام النظام أو النظام الأساسي. وتقع المسؤولية على جميع المديرين - في حال تعددوا - إذا نشأ ذلك الضرر بسبب قرار صدر بإجماعهم. أما القرارات التي تصدر بأغلبية الآراء، فلا يسأل عنها المديرون المعارضون متى أثبتوا اعتراضهم صراحة في محضر الاجتماع الذي صدر فيه القرار. ولا يعد الغياب عن حضور هذا الاجتماع سبباً للإعفاء من المسؤولية إلا إذا ثبت عدم علم المدير الغائب بالقرار أو عدم تمكنه من الاعتراض عليه بعد علمه به.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/3a57f986343a4a6fa377cf36b5ebb673\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يعد المدير مشروع ميزانية سنوية لجمعية الملاك يتضمن تكاليف إدارة العقار المشترك وصيانة الأجزاء المشتركة، تمهيداً لعرضه على الجمعية العامة لاعتماده.<br>2- تكون السنة المالية لجمعية الملاك (اثني عشر) شهراً تحدد في نظامها الأساسي. واستثناءً من ذلك يمكن أن تحدد السنة المالية الأولى بما لا يقل عن (ستة) أشهر ولا يزيد على (ثمانية عشر) شهراً بدءاً من تاريخ تسجيل الجمعية.<br>3- أ- يُعِد المدير عن كل سنة مالية قوائم مالية لجمعية الملاك وتقريراً عن نشاطها ومركزها المالي، وذلك خلال (ثلاثة) أشهر من نهاية السنة المالية للجمعية. ويضع المدير تلك الوثائق تحت تصرف مراجع الحسابات - إن وجد - قبل الموعد المحدد لانعقاد الجمعية العامة بـ(خمسة وأربعين) يوماً على الأقل.<br>ب- على المدير أن يزود الهيئة وكل مالك بنسخة من الوثائق المشار إليها في الفقرة (3/أ) من هذه المادة ونسخة من تقرير مراجع الحسابات - إن وجد - وذلك خلال (شهر) من تاريخ إعدادها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0f4c5e596a154bf48092cd1453f4aeb2\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">دون إخلال بما تقضي به الأنظمة ذات الصلة، تكون قرارات المدير وعقود التعاملات التي يبرمها - وفقاً للصلاحيات المخولة له بموجب النظام - المتعلقة بالعقار المشترك أو المجمع العقاري بعد اعتمادها من الهيئة؛ سنداً تنفيذياً في مواجهة الملاك وفقاً لأحكام نظام التنفيذ. وتحدد اللائحة الإجراءات اللازمة لذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/73a597672122447ca4f556f7bfadea20\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على جمعية الملاك في الحالات التي تحددها اللائحة تعيين مراجع حسابات مرخص له بالعمل في المملكة.<br>2- لمراجع الحسابات - في أيّ وقت - حق الاطلاع على دفاتر جمعية الملاك وسجلاتها وغير ذلك من الوثائق، وله أيضاً طلب البيانات والإيضاحات التي يرى ضرورة الحصول عليها، وإذا صادف مراجع الحسابات صعوبة في هذا الشأن أثبت ذلك في تقرير يقدمه إلى الجمعية العامة.<br>3- يعد مراجع الحسابات تقريراً سنوياً وفق معايير المراجعة المتعارف عليها ويعرضه على الجمعية العامة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/cec38f04baf8452cadd72ef8543c05c4\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- في حالة تأجير الوحدة العقارية المفرزة، يظل المالك ملزماً أمام جمعية الملاك والغير بجميع الحقوق والواجبات المتعلقة بالوحدة العقارية المفرزة وبالأجزاء المشتركة، ما لم يتفق مع المستأجر على غير ذلك.<br>2- يجوز للمستأجرين في عقار مملوك لمالك واحد، وتزيد عقود تأجيرهم على (خمس) سنوات، الاتفاق مع المالك على تأسيس جمعية ملاك وفقاً لأحكام هذا الفصل، وإدارته وصيانته وفقاً لأحكام الفصل (الخامس) من النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1f03fdc5a160409a9fbab941eb0eaf07\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- تتكون موارد جمعية الملاك مما يأتي:<br>أ- اشتراكات الملاك.<br>ب- التبرعات والهبات والوصايا والأوقاف.<br>ج- عوائد استثمار أموال جمعية الملاك والأجزاء المشتركة القابلة للاستثمار.<br>وتحدد اللائحة الأحكام المنظمة للفقرتين (1/ب) و(1/ج) من هذه المادة.<br>2- تصرف أموال جمعية الملاك لأغراض إدارة العقار المشترك وصيانة الأجزاء المشتركة.<br>3- على كل مالك دفع مبلغ اشتراكه في تكاليف إدارة العقار المشترك وصيانة الأجزاء المشتركة، وليس لأي مالك التخلي عن حصته في الأجزاء المشتركة بغية التخلص من الاشتراك في تكاليف حفظها أو صيانتها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2457ff68755b4901a2bfb4c5ee91d218\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تنقضي جمعية الملاك إذا انخفض عدد الملاك عن العدد اللازم لتأسيسها، ما لم يرغب من تبقى من الملاك في استمرار الجمعية وفقاً لأحكام النظام. ولا يؤثر انقضاء الجمعية في مسؤوليتها عن ديونها والتزاماتها السابقة لتاريخ انقضائها.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/19a04e84e11d4063b2fb1e96e59b2cea\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- يشترك كل مالك في تكاليف صيانة الأجزاء المشتركة وإدارتها؛ كلٌّ بقدر نسبة مساحة الجزء المفرز الذي يملكه إلى إجمالي مساحة الأجزاء المفرزة في العقار المشترك. ويجوز أن تختلف قيمة مساهمة المالك في تلك التكاليف باختلاف نوع استعمال الوحدة العقارية المفرزة إذا كانت ضمن عقار مشترك متعدد الاستعمالات.<br>2- لأي مالك - بعد موافقة جمعية الملاك - أن يحسّن على نفقته الانتفاع بالأجزاء المشتركة أو جزء منها دون أن يغير من نوع استعمالها أو يلحق الضرر بالآخرين.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/753656c4f7ae4e9fac52e678cecfb84c\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- على المالك القيام بالصيانة اللازمة لوحدته العقارية المفرزة ولو لم يكن ينتفع بها، لمنع إلحاق ضرر بالعقار المشترك، ويلتزم بألاَّ يحدث في وحدته العقارية المفرزة ما يضر بالعقار المشترك.<br>2- إذا دعت الضرورة إجراء بعض الأعمال داخل أي وحدة عقارية مفرزة؛ حفظاً لسلامة العقار المشترك أو لتحسين الانتفاع بالأجزاء المشتركة أو صيانتها، فليس لمالك تلك الوحدة المعارضة في ذلك، على أن تعاد الحال في هذه الوحدة إلى ما كانت عليه فور انتهاء الأعمال اللازمة، ولا يتحمل مالكها أي تكاليف ناشئة عن ذلك، وتحدد اللائحة الأحكام الخاصة بذلك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c513c133ea5e4adaa7f58354ab580224\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">تلتزم جمعية الملاك بإدارة العقار المشترك، وفق معايير تحددها اللائحة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/460fdc8d47f64fd0b41633584be6585b\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- إذا تضرر العقار المشترك تضرراً جزئيًّا، فعلى الملاك إصلاحه بحسب ما تقرره الجمعية العامة، ما لم يتفق على غير ذلك.<br>2- إذا انهدم العقار المشترك تقرر الجمعية العامة ما تراه، وفي حال الاختلاف يرفع الأمر إلى المحكمة المختصة.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/13f67891c4724f189afeaacddde41106\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">1- لا يجوز إجراء أي تعديل في الشكل الخارجي للعقار المشترك إلا بعد موافقة الجمعية العامة.<br>2- يشترط موافقة الجمعية العامة قبل إجراء أي عمل يترتب عليه زيادة في قيمة العقار المشترك كله أو بعضه، وذلك على نفقة من يطلبه من الملاك وبما تضعه الجمعية من شروط وما تفرضه من تعويضات والتزامات أخرى لمصلحة الملاك.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/65cf170c5e564fdda444da08f65cd4dd\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">يقترح مجلس إدارة الهيئة اللائحة وتصدر بقرار من وزير الإسكان خلال (مائة وثمانين) يوماً من تاريخ صدور النظام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8979de2f75a044f38992cf2f7427f145\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"margin: 0in; text-align: right; background: white; direction: rtl; unicode-bidi: embed;\\\" dir=\\\"RTL\\\">يحل النظام محل نظام ملكية الوحدات العقارية وفرزها، الصادر بالمرسوم الملكي<br>رقم (م/5) والتاريخ 11/2/1423هـــ، ويلغي كل ما يتعارض معه من أحكام.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5906093d053f441e98f719a1277ce7a4\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يعمل بالنظام بعد (مائة وثمانين) يوماً من تاريخ نشره في الجريدة الرسمية</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - description","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","change":"Update"},{"success":true,"name":"Property - header (ar-jo)","path":"/Properties/*/Value","oldValue":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","newValue":"","change":"Delete"},{"success":true,"name":"Property - header (en-us)","path":"/Properties/*/Value","oldValue":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","newValue":"","change":"Delete"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"نظام ملكية الوحدات العقارية وفرزها وإدارتها\",\n  \"ملكية الوحدات\",\n  \"نظام\",\n  \"الهيئة\",\n  \"الهيئة العامة للعقار\",\n  \"الانظمة واللوائح والادلة\",\n  \"الانظمة\"\n]","change":"Update"},{"success":true,"name":"Property - legislationDocuments (ar-jo)","path":"/Properties/*/Value","oldValue":"[]","newValue":"","change":"Delete"},{"success":true,"name":"Property - pageName","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","change":"Update"},{"success":true,"name":"Property - publishDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2020-03-13T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - publishDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (ar-jo)","path":"/Properties/*/Value","oldValue":"2020-02-26T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - releaseDate (en-us)","path":"/Properties/*/Value","oldValue":"2024-08-05T00:00:00","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"ساري\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleStatus (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Active\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  \"أنظمة\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - ruleType (en-us)","path":"/Properties/*/Value","oldValue":"[\n  \"Laws\"\n]","newValue":"","change":"Delete"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - subContent (ar-jo)","path":"/Properties/*/Value","oldValue":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","newValue":"","change":"Delete"},{"success":true,"name":"Property - subContent (en-us)","path":"/Properties/*/Value","oldValue":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","newValue":"","change":"Delete"},{"success":true,"name":"Property - title","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"نظام ملكية الوحدات العقارية وفرزها وإدارتها","change":"Update"}],"key":"a010cf32-b4ff-4cbc-b7b8-6ca30de18589"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/71e5ff4f-e763-47ee-ab56-3bb7cb2b1f44.config","name":"اللائحة التنفيذية لنظام الوساطة","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Published (Default)","path":"/Info/Published","oldValue":"true","newValue":"false","change":"Update"}],"key":"71e5ff4f-e763-47ee-ab56-3bb7cb2b1f44"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/