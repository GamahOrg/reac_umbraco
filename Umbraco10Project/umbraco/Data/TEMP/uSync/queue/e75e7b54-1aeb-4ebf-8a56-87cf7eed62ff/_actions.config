etailMessage":null,"details":[{"success":true,"name":"Template","path":"/Info/Template","oldValue":"(Blank)","newValue":"ServicesDetails","change":"Update"},{"success":true,"name":"Property - buttonText (ar-jo)","path":"/Properties/*/Value","oldValue":"الانتقال الى الخدمة","newValue":"بدء الخدمة","change":"Update"},{"success":true,"name":"Property - description (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"فرز برنامج يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديد مساحات وحقوق كل وحدة في المباني والمجمعات العقارية وحدود الأجزاء المشتركة لتعزيز العلاقات بين مُلاك الوحدات","change":"Update"},{"success":true,"name":"Property - description (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Subdivision is a program that manages the mechanism of sorting real estate units technically and legally through (the system of ownership, sorting, and management of real estate units) which contributes to determining the unit’s square meter and the rights of every unit in apartment buildings and real estate compounds","change":"Update"},{"success":true,"name":"Property - keywords","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[\n  \"فرز\",\n  \"الوحدات العقارية\",\n  \"ملكية\",\n  \"الهيئة العامة للعقار\",\n  \"الخدمات الالكترونية\",\n  \"Rega\"\n]","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"Sorting real estate units","newValue":"فرز الوحدات العقارية","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Sorting Real Estate Units – Subdivision","change":"Update"},{"success":true,"name":"Property - serviceFeature (ar-jo)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"f97b5fe6-c921-453e-ad96-bd975d955389\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"فرز\\\\\\\" برنامج يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديد مساحات وحقوق كل وحدة في المباني والمجمعات العقارية وحدود الأجزاء المشتركة لتعزيز العلاقات بين مُلاك الوحدات وتسهيل الإجراءات والخدمات اللازمة، والمحافظة على الأصول العقارية واستدامة القطاع، وتعزيز بيئة سكنية آمنة.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"f97b5fe6-c921-453e-ad96-bd975d955389\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"عن الخدمة\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>\\\\\\\"فرز\\\\\\\" برنامج يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديد مساحات وحقوق كل وحدة في المباني والمجمعات العقارية وحدود الأجزاء المشتركة لتعزيز العلاقات بين مُلاك الوحدات وتسهيل الإجراءات والخدمات اللازمة، والمحافظة على الأصول العقارية واستدامة القطاع، وتعزيز بيئة سكنية آمنة.</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - serviceFeature (en-us)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"41a41d7c-2506-40ee-8e37-9f112d993372\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>“Subdivision” is a program that manages the mechanism of sorting real estate units technically and legally through (the system of ownership, sorting, and management of real estate units) which contributes to determining the unit’s square meter and the rights of every unit in apartment buildings and real estate compounds. Additionally, the program determines the boundaries of common and public areas to enhance landlords’ relations and facilitate the necessary services and procedures, preserve real estate assets, and foster safe residential environments to sustain the real estate sector. &nbsp; &nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"41a41d7c-2506-40ee-8e37-9f112d993372\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service \",\n    \"featureTitle\": null,\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p>“Subdivision” is a program that manages the mechanism of sorting real estate units technically and legally through (the system of ownership, sorting, and management of real estate units) which contributes to determining the unit’s square meter and the rights of every unit in apartment buildings and real estate compounds. Additionally, the program determines the boundaries of common and public areas to enhance landlords’ relations and facilitate the necessary services and procedures, preserve real estate assets, and foster safe residential environments to sustain the real estate sector. &nbsp; &nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties