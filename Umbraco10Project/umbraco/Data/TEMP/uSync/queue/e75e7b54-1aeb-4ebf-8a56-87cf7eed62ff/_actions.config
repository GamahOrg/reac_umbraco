icates.pdf#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf\\\\\\\" data-anchor=\\\\\\\"#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf#https://rega.gov.sa/media/5lrntbnx/instructions-on-the-offering-of-real-estate-contrbutions-certificates.pdf#/media/i3upagav/%D8%AA%D8%B9%D9%84%D9%8A%D9%85%D8%A7%D8%AA-%D8%B7%D8%B1%D8%AD-%D8%B4%D9%87%D8%A7%D8%AF%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA-%D8%A7%D9%84%D8%B9%D9%82%D8%A7%D8%B1%D9%8A%D8%A9.pdf\\\\\\\">Instructions on the Offering of Real Estate Contributions Certificates</a></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a href=\\\\\\\"/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf#https://rega.gov.sa/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\" title=\\\\\\\"https://rega.gov.sa/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\" data-anchor=\\\\\\\"#https://rega.gov.sa/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\">الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية</a></p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\",\n    \"customPage\": \"\",\n    \"linkedToPage\": \"\"\n  }\n]","change":"Update"},{"success":true,"name":"Property - serviceFeature (en-us)","path":"/Properties/*/Value","oldValue":"[\n  {\n    \"key\": \"03e13ec8-3ab0-43fb-aaa7-d6348a181249\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service\",\n    \"featureTitle\": \"Real Estate Contributions\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically.</p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a href=\\\\\\\"/{localLink:umb://media/d1a990f293224fb893216d0576c151e9}\\\\\\\" title=\\\\\\\"Mosahamat\\\\\\\">Real Estate Contributions Regulations</a><br><a href=\\\\\\\"/{localLink:umb://media/18e069691e154040a9941f4395c47d47}\\\\\\\" title=\\\\\\\"تعليمات طرح شهادات المساهمات العقارية\\\\\\\">Executive Regulations of the Real Estate Contributions System</a><br><a href=\\\\\\\"/{localLink:umb://media/18615bbd6b53432a873add1f1f10eb2c}\\\\\\\" title=\\\\\\\"ضوابط حساب الضمان للمساهمات العقارية\\\\\\\">Guidelines for the Real Estate Contributors' Guarantee Account</a><br><a href=\\\\\\\"/{localLink:umb://media/85d9e3d439b74a84864e2f0c8dcfae31}\\\\\\\" title=\\\\\\\"Instructions On The Offering Of Real Estate Contrbutions Certificates\\\\\\\">Instructions for Issuing Real Estate Contribution Certificates</a></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\",\\n  \\\"blocks\\\": {\\n    \\\"contentData\\\": [],\\n    \\\"settingsData\\\": []\\n  }\\n}\"\n  }\n]","newValue":"[\n  {\n    \"key\": \"03e13ec8-3ab0-43fb-aaa7-d6348a181249\",\n    \"name\": \"Item 1\",\n    \"ncContentTypeAlias\": \"servicesFeatures\",\n    \"PropType\": null,\n    \"icon\": \"umb://media/a0df66c37ac6423084eb3fe30c460542\",\n    \"featureTabTitle\": \"About the Service\",\n    \"featureBrief\": \"{\\n  \\\"markup\\\": \\\"<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically.</p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a href=\\\\\\\"/{localLink:umb://media/d1a990f293224fb893216d0576c151e9}\\\\\\\" title=\\\\\\\"Mosahamat\\\\\\\">Real Estate Contributions Regulations</a><br><a href=\\\\\\\"/{localLink:umb://media/18e069691e154040a9941f4395c47d47}\\\\\\\" title=\\\\\\\"تعليمات طرح شهادات المساهمات العقارية\\\\\\\">Executive Regulations of the Real Estate Contributions System</a><br><a href=\\\\\\\"/{localLink:umb://media/18615bbd6b53432a873add1f1f10eb2c}\\\\\\\" title=\\\\\\\"ضوابط حساب الضمان للمساهمات العقارية\\\\\\\">Guidelines for the Real Estate Contributors' Guarantee Account</a><br><a href=\\\\\\\"/{localLink:umb://media/85d9e3d439b74a84864e2f0c8dcfae31}\\\\\\\" title=\\\\\\\"Instructions On The Offering Of Real Estate Contrbutions Certificates\\\\\\\