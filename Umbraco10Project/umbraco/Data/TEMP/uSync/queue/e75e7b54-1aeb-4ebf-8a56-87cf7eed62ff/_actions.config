//element/349d7f2ed6bb4c63b9ab03fc04fe39d2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c34a049e08d54238b60c63e11079e1b7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/540cd24918ca4a8fa65b90c1f32719ea\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f03189a5dbe4a2097b3e7dd82f9ab0b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8b565ffe76894538835511184bb154cc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/404beca320b64f59992fb3f755c0392b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f2d0f6625974744953da269b3ccf2b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f2cbc8939abb4914bfac964e96b9fd71\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b98b5755a1544462b9402d15bab0fd6b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6035652ded5b4df6998631fdd5d3b505\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e7fc3b4f90c840389de3845879f6d7f3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/895a552b924541ea97866220614ca031\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7ab170665cce4c6b93567d09853bed75\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b497fabec85d4bfeafcbe2ae5b29f9cf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a606f7f6bc04024a6db372a0de0eace\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5e0bda6081f34600adfd0ac69da31b49\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f77204d0b3054ebe9b052dd0460b8f39\"\n      },\n      {\n        \"contentUdi\": \"umb://element/76815f474507461ea1140bf4d4d3e07e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1adf9545aecc435eb3e2ceaf7162b46d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9773996d955248578f6384b392b2d8a8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ad68673dc37d4356860d8c81762e9526\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b5c77a3c94c74f7ba56817f529cc3b2f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa63cfc675ea4404a0c3c9c2cf3db6e3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e0e68a96affd4a6ea310ea3e66926059\"\n      },\n      {\n        \"contentUdi\": \"umb://element/582aedb1e7ce422194d9b9492e9cddb2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c31e8cd000e24240a01f90119d44ac95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/61f3906ad2774dbe9227e0ae6d4f06ef\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d25be1c92e0642b7991840866f466e7a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/733458372d904fd2a1a380bef36b038d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0b525757c3384f25929deb730228a8e9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/411bd50a9c9a496b8e4ec60255c21a9b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8f75845a2cd640019ffec7202f998623\"\n      },\n      {\n        \"contentUdi\": \"umb://element/27429907113544569bbf16a5031cbb34\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e66c6a227c8048329b16c05bb4062b65\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8755e28605a0426a96b80814106c790f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d968564d9290470da921f58721752b95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f2c79532be5240679b89d5f7317de701\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7724781d2b3d4a93be2cb64e1a88ce83\"\n      },\n      {\n        \"contentUdi\": \"umb://element/96b393e19a494ab2b2f10fbf564e605e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8f562d2d946045b9ab88c17d7f66bd96\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a0445566f1e543c2821f9574a3302065\"\n      },\n      {\n        \"contentUdi\": \"umb://element/03870778426b4c7988c9de0a1cc21b60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/62b4acb46cac4479919914524ff91a9d\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/18df720ad3b145a6a9453abda1e98ae1\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>يكون للألفاظ والعبارات الواردة في اللائحة معاني الألفاظ والعبارات الواردة في النظام، ما لم يقتضِ السياق خلاف ذلك، ويُقصد بالعبارات الآتية -أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها:<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المجلس:</strong> مجلس إدارة الهيئة العامة للعقار.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5ed06469a002401a9024770771fa926d\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة أحكام المادة (الرابعة) من النظام تختص الهيئة بالإشراف على تنظيم بيع وتأجير مشروعات عقارية على الخارطة، بما في ذلك:<br>1 - &nbsp;إصدار الدليل الاجرائي لبيع وتأجير مشروعات عقارية على الخارطة، وفقًا للنظام واللائحة.<br>2 - &nbsp;إصدار القرارات التنفيذية لممارستها الاختصاصات وفقاً للنظام واللائحة.<br>3 - &nbsp;قيد المطورين العقاريين؛ وفقاً للنظام واللائحة.<br>4 - &nbsp;ترخيص المشروعات العقارية؛ وفقًا للنظام واللائحة.<br>5 - &nbsp;الرقابة والتفتيش على سائر أعمال النشاط.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/05f16d0bc41a4e4887eef872102f299f\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"text-align: right;\\\">     1 -  يشترط لقيد الشخص الاعتباري في سجل قيد المطورين الآتي:</p>\\n<p style=\\\"text-align: right;\\\"> ‌أ- سجل تجاري ساري المفعول<br> ‌ب- الحصول على (خمسة وثلاثين) نقطة من (مئة) نقطة كحدٍ أدنى وفقاً للجدول في المادة (الخامسة) من        اللائحة.<br>     2 -  يشترط لقيد الشخص الطبيعي -عند الاقتضاء- في سجل قيد المطورين الحصول على (خمسة وثلاثين) نقطة من (خمسة وخمسين) نقطة كحدٍ أدنى وفقاً للجدول في المادة (الخامسة) من اللائحة.<br>     3 -  يجوز للمطور طلب رفع نقاط تقييمه في سجل قيد المطورين إذا تغيرت قدراته بعد قيده.<br>     4 -  يعلق قيد المطور إذا فقد الحد الأدنى من معايير التقييم ويعطى مهلة تصحيحية مدتها (ثلاثة) أشهر، ويشطب قيده إذا لم يصحح وضعه خلال هذه المدة.<br>     5 -  لا يؤثر التعليق أو الشطب وفق هذه المادة على المشروعات التي صدرت لها تراخيص للبيع أو التأجير على الخارطة.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/56ae3a144276416eb254b259683d679c\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>يضمّن سجل قيد المطورين الآتي:<br>1 -  ‌اسم المطور، وبيانات السجل التجاري ورأس ماله، وعنوانه الوطني، وبيانات الاتصال بممثله النظامي.<br>2 -  ‌الهيكل التنظيمي للمطور، شاملًا للوظائف الأساسية.<br>3 -  ‌أسماء المشروعات العقارية المنفذة أو القائمة، وقيمتها.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c801e726dd304835a549bfa9cdc0370f\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>     1 -  تكون معايير تقييم قدرات الشخص الاعتباري للقيد في سجل المطورين الآتي:</span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"> </p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" width=\\\"100%\\\" class=\\\"MsoTableGrid\\\" style=\\\"border-collapse: collapse; width: 100%; border-spacing: 0px; border: medium solid currentcolor;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المعيار</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المتطلبات</strong></p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>طريقة التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>وزن التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>النوع</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"5\\\" width=\\\"100%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">أولاً: القدرات المالية</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">قوائم مالية من محاسب قانوني معتمد</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">1/البيان المالي للمنشآت الحديثة أقل من سنة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">2/قوائم مالية لسنة مالية، للمنشآت التي أنشئت من سنة ولا تزيد عن سنتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">3/قوائم مالية لسنتين متتاليتين للمنشآت التي أنشئت منذ سنتين وأكثر.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><strong>*</strong>القوائم: الأصول المتداولة- الالتزامات النقدية- الأرباح والخسائر.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات أقل من 20% من حجم الأصول: 20 نقطة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات أكبر من 20% وأقل من 80% من حجم الأصول: 15 نقطة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات أكبر من 80% وأقل من 100% من حجم الأصول: 10 نقاط.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">الالتزامات (أكبر من/تساوي) حجم الأصول: 5 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">20</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>شهادة سلامة السجل الائتماني</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة من شركة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب التأهيل، على ألا يتجاوز تاريخ إصدار الشهادة (ثلاثة) أشهر من تاريخ تقديم الطلب.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">-  عدم وجود قضايا: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">-  عدم وجود شيكات مرتجعة: 4 نقاط.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">-  عدم وجود مبالغ متعثرة: 4 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"5\\\" width=\\\"100%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">ثانياً: القدرات الفنية</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">بيان بالمشروعات المنفذة وإرفاق ما يثبت تنفيذها</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">مشروعات تطوير عقارية: وهي المشروعات الانشائية بحسب نوعها وفق الآتي:</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">السكنية: أن تكون بحد أدنى (10) وحدات سكنية للمشروع الواحد.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">غير السكنية (صناعية، تجارية، مكتبية، ...): أن يكون مسطح بناء المشروع (2000) متر مربع فأكثر.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">تطوير بنية تحتية: أن يكون بمساحة (50.000) متر مربع فأكثر.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">كل مشروع تطوير عقاري منفذ خلال (10) سنوات ماضية: 10نقاط</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">30</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">المنهج المتبع لأحد المشروعات المنفذة</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">توضيح المنهج المتبع للمشروعات وفق الآتي:</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">1/نبذه عن المشروع وبياناته، توضح مساحته وأنواعه والغرض من انشاء المشروع ومخطط المشروع. </p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">2/برامج تقنية تستخدم في إدارة المشروعات لمراقبة تقدم المشروع على سبيل المثال لا الحصر (مايكروسوفت، بروجكت، بريمافيرا) وغيرها.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">3/ملخص دراسة الجدوى للمشروع تتضمن (التكاليف والايرادات).</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">4/هيكل فريق المشروع.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">5/الجدول الزمني للمشروع.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">كل فقرة في المتطلبات: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">استكمال المتطلبات: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"5\\\" width=\\\"100%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">ثالثاً: القدرات المؤسسية والموارد البشرية</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الهيكل التنظيمي</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الهيكل التنظيمي المعتمد للمنشأة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الهيكل التنظيمي المعتمد: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">1</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>لائحة تنظيم العمل</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">لائحة تنظيم العمل معتمدة من وزارة الموارد البشرية والتنمية الاجتماعية</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">لائحة تنظيم العمل: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>لائحة إدارة السلامة والصحة المهنية</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">معتمدة من صاحب الصلاحية في المنشأة أو شهادة ايزو 45001</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة ايزو 45001 أو معتمدة من صاحب الصلاحية في المنشأة: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>نطاق السعودة</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة التوطين الصادرة من الجهة المختصة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة التوطين: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">2</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادات التأمينات الاجتماعية وقائمة المشتركين على رأس العمل.</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادات التسجيل الصادرة من المؤسسة العامة للتأمينات الاجتماعية</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">عدد الموظفين من 1 الى 5: نقطة واحدة.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">عدد الموظفين من 6 الى 49: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">عدد الموظفين 50 فأكثر: ثلاث نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اجتياز البرنامج التأهيلي المعتمد من الهيئة</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اجتياز مالك المنشأة أو المدير أو الموظفين المدرجين في قائمة المشتركين على رأس العمل</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شخص واحد: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">3</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة من هيئة الزكاة والضريبة والجمارك</p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة (إقرار زكوي) سارية المفعول</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مطابقة رقم السجل التجاري مع شهادة التسجيل السارية: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>عدد المهندسين العاملين في المنشأة</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">المهندسين المعتمدين من الهيئة السعودية للمهندسين العاملين في المنشأة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">المهندسين من 1 إلى 2: نقطتين.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">المهندسين من 3 إلى 9: 3 نقاط.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">المهندسين من 10 فأكثر: 5 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"17%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>برامج المسؤولية الاجتماعية</strong></p>\\n</td>\\n<td width=\\\"35%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">معتمدة من المنشأة</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">برنامج معتمد: النقاط كاملة</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr>\\n<td colspan=\\\"2\\\" width=\\\"52%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span> </span></p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المجموع</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>100</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"> </p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span> </span></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">     2 -  تكون معايير تقييم قدرات الشخص الطبيعي للقيد في سجل المطورين الآتي:</p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" width=\\\"100%\\\" class=\\\"MsoTableGrid\\\" align=\\\"right\\\" style=\\\"border-collapse: collapse; width: 100%; border-width: 1px; border-spacing: 0px; border-style: solid;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المعيار</strong></p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المتطلبات</strong></p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>طريقة التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>وزن التقييم</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>النوع</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اجتياز البرنامج التأهيلي للمطور العقاري</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة اجتياز البرنامج التدريبي المعتمد من المعهد العقاري</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة الاجتياز: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">بيان بالمشروعات التي قام بتنفيذها الشخص الطبيعي وارفاق ما يثبت تنفيذها.</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">مشروعات تطوير عقارية: وهي المشروعات الانشائية بحسب نوعها وفق الآتي:</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">1/السكنية: بحد أدنى (3) وحدات سكنية للمشروع الواحد.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">2/ غير السكنية (صناعية، تجارية، مكتبية، ...): أن يكون مسطح بناء المشروع غير سكني (1000) متر مربع فأكثر.</p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">3/تطوير بنية تحتية: أن يكون بمساحة (50.000) متر مربع فأكثر.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">كل مشروع تطوير عقاري منفذ خلال (10) سنوات ماضية: 10 نقاط.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">30</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة سلامة السجل الائتماني للأفراد</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة من شركة مرخص لها بتقديم الخدمات الائتمانية على ألا يتجاوز تاريخ إصدار الشهادة شهرين من تاريخ تقديمها.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">خلو السجل الائتماني من القضايا والمرافعات والشيكات المرتجعة: النقاط كاملة.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">شهادة تسجيل في ضريبة القيمة المضافة للأفراد</p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة تسجيل سارية المفعول مطابقة لرقم السجل المدني.</p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\">شهادة تسجيل سارية صادرة من هيئة الزكاة والضريبة والجمارك للشخص الطبيعي.</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">5</p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"19%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span> </span></p>\\n</td>\\n<td width=\\\"32%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"> </p>\\n</td>\\n<td width=\\\"30%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المجموع</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>55</strong></p>\\n</td>\\n<td width=\\\"8%\\\" style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"> </p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span> </span></p>\\n<p class=\\\"MsoNormal\\\"> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d75a51d9717c4c398bb9f818511938b9\",\n      \"title\": \"المادة السادسة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة الأحكام الواردة في المادة (السادسة) من النظام يرخص للمشروع العقاري على الخارطة بعد استيفاء الآتي:<br>&nbsp; &nbsp; &nbsp; 1 - &nbsp;تقديم دراسة جدوى المشروع مشتملة -بالإضافة لما ورد في الفقرة (ك) من (1) من المادة السادسة من النظام- على البيانات المالية، والانشائية، والتسويقية المقدرة للمشروع، والمصاريف المالية والإدارية المتوقعة، ومدة تسليم الوحدات ومصادر التمويل المتوقعة.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;خطاب من (مركز خدمات المطورين \\\"إتمام\\\" أو أي جهة مختصة بتراخيص البناء) يفيد بمطابقة المشروع العقاري للمتطلبات النظامية لرخص البناء، والمخططات الهندسية، والتصاميم المعمارية، ويكتفى به عن المتطلبات الواردة في الفقرتين (د) و (ح) من المادة السادسة من النظام.<br>&nbsp; &nbsp; &nbsp; 3 - &nbsp;إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقاً لنظام ملكية الوحدات العقارية وفرزها وإدارتها.<br>&nbsp; &nbsp; &nbsp; 4 - &nbsp;فيما عدا العقارات المسجلة عينياً؛ يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري.</p>\\n<p>&nbsp; &nbsp; &nbsp; 5 - &nbsp;حصول المطور العقاري على نقاط التقييم وفقاً للجدول الآتي:</p>\\n<p>&nbsp;</p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" class=\\\"MsoTableGrid\\\" style=\\\"width: 100%; border-collapse: collapse; border-spacing: 0px; border: medium solid currentcolor;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td width=\\\"54%\\\" style=\\\"border-width: medium 1pt 1pt; border-style: solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>درجة شهادة تصنيف مقدمي خدمات المدن</strong></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong><span>\\\"بلدي\\\"</span></strong></p>\\n</td>\\n<td width=\\\"45%\\\" style=\\\"border-width: medium 1pt 1pt; border-style: solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الحد الأعلى لقيمة المشروع الواحد</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الأولى</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">غير محددة.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الثانية</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مليار ريال.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الثالثة</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">خمس مئة مليون ريال.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الرابعة</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مئتين وخمسون مليون ريال.</p>\\n</td>\\n</tr>\\n<tr>\\n<td width=\\\"54%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>الخامسة</strong></p>\\n</td>\\n<td width=\\\"45%\\\" valign=\\\"top\\\" style=\\\"border-width: medium 1pt 1pt; border-style: none solid solid; border-color: currentcolor windowtext windowtext; height: 2.8pt;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مئة مليون ريال.</p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<div></div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/379b0ca59edf42cb8132be03b4216ed1\",\n      \"title\": \"المادة السابعة\",\n      \"content\": {\n        \"markup\": \"<p>يشترط لاعتماد المحاسب القانوني للمشروع العقاري الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;سجل تجاري ساري المفعول.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;أن يكون مرخصاً من الهيئة السعودية للمراجعين والمحاسبين.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;اجتياز (10%) أو (4) من محاسبي المكتب البرنامج التأهيلي المعتمد من الهيئة، أيهما أقل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/bf6d867e45c54baaa3c0704c1d98b76e\",\n      \"title\": \"المادة الثامنة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يجوز للمطور طلب (ترخيص تسويق المشروع العقاري) قبل ترخيص المشروع العقاري على الخارطة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يقدم المطور المستندات والبيانات لترخيص تسويق المشروع وفق الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; رقم صك تسجيل ملكية العقار.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; رقم عقد التسويق بين الوسيط العقاري والمطور- إن وجد-.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; نسخة عقد التطوير بين المطور ومالك الأرض-إن وجد-.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; التصاميم المعمارية والمخططات الهندسية.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;تبت الهيئة في طلب (ترخيص تسويق المشروع العقاري) خلال (عشرة) أيام عمل من تاريخ اكتمال الطلب، وفي حال الرفض فيجب أن يكون القرار مسبباً.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;تكون مدة (ترخيص تسويق المشروع العقاري) بما لا يتجاوز (مئة وثمانين يوماً) ويجوز تمديدها للمشروعات التي لا تتطلب استلام أموال حجز الوحدات العقارية من المشترين أو المستأجرين، لمدة أو مدد مماثلة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5f2f0840905c4814a4ddf1ee3e238884\",\n      \"title\": \"المادة التاسعة\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم الوسيط العقاري في تسويقه للمشروعات العقارية على الخارطة، لأحكام نظام الوساطة العقارية ولوائحه.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/349d7f2ed6bb4c63b9ab03fc04fe39d2\",\n      \"title\": \"المادة العاشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يجب على المطور في حال رغبته باستلام مبلغ حجز وحدات عقارية من المشتري أو المستأجر خلال مدة (ترخيص تسويق المشروع العقاري) الالتزام بالآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; الإفصاح عن حالة المشروع والمخططات المستقبلية له.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; عدم استلام أكثر من (5%) من قيمة الوحدة العقارية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; إيداع جميع مبالغ الحجز المستلمة في حساب الضمان المخصص لذلك.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;إذا انتهت المدة المحددة في ترخيص تسويق المشروع العقاري، ولم يستكمل المطور ترخيص المشروع، فتعيد الهيئة المبالغ المودعة في حساب الضمان إلى أصحابها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c34a049e08d54238b60c63e11079e1b7\",\n      \"title\": \"المادة الحادية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة الأحكام الواردة في المادة (السادسة) من النظام يرخص للمشروع العقاري على الخارطة بعد استيفاء الآتي:<br>      1 -  تقديم دراسة جدوى المشروع مشتملة -بالإضافة لما ورد في الفقرة (ك) من (1) من المادة السادسة من النظام- على البيانات المالية، والانشائية، والتسويقية المقدرة للمشروع، والمصاريف المالية والإدارية المتوقعة، ومدة تسليم الوحدات ومصادر التمويل المتوقعة.<br>      2 -  خطاب من (مركز خدمات المطورين \\\"إتمام\\\" أو أي جهة مختصة بتراخيص البناء) يفيد بمطابقة المشروع العقاري للمتطلبات النظامية لرخص البناء، والمخططات الهندسية، والتصاميم المعمارية، ويكتفى به عن المتطلبات الواردة في الفقرتين (د) و (ح) من المادة السادسة من النظام.<br>      3 -  إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقاً لنظام ملكية الوحدات العقارية وفرزها وإدارتها.<br>      4 -  فيما عدا العقارات المسجلة عينياً؛ يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري.</p>\\n<p>      5 -  حصول المطور العقاري على نقاط التقييم وفقاً للجدول الآتي:</p>\\n<p> </p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" class=\\\"MsoTableGrid\\\" style=\\\"width: 100%; border-collapse: collapse; border-spacing: 0px; border: medium solid currentcolor;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>مساحة المشروع العقاري</strong></p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>النقاط المطلوبة</strong></p>\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>وفق المادة الخامسة من اللائحة</strong></p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور الفرد</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">35 نقطة فأكثر</p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور –شخص اعتباري-، التي تقل مسطحات البناء عن 15,000م2</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">35 نقطة فأكثر</p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور –شخص اعتباري-، التي تقل مسطحات البناء عن 25,000م2</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">45 نقطة فأكثر</p>\\n</td>\\n</tr>\\n<tr>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">مشروع المطور –شخص اعتباري-، التي تزيد مسطحات البناء عن 25,000م2</p>\\n</td>\\n<td style=\\\"border-width: 1pt medium 1pt 1pt; border-style: solid; border-color: windowtext currentcolor windowtext windowtext;\\\">\\n<p dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">55 نقطة فأكثر</p>\\n</td>\\n</tr>\\n</tbody>\\n</table>\\n</div>\\n<div></div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/540cd24918ca4a8fa65b90c1f32719ea\",\n      \"title\": \"المادة الثانية عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يُشترط لترخيص المشروع العقاري للشخص الطبيعي الآتي:<br>&nbsp; &nbsp; &nbsp; 1 - &nbsp;ألا يتجاوز مسطح البناء في المشروع عن (5000) متر مربع.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;ألا تزيد مدة تنفيذ المشروع على (ثلاث سنوات).<br>&nbsp; &nbsp; &nbsp; 3 - &nbsp;ألا تتجاوز عدد المشروعات العقارية التي يسمح بتنفيذها سنوياً عن (ثلاثة) مشروعات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f03189a5dbe4a2097b3e7dd82f9ab0b\",\n      \"title\": \"المادة الثالثة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp; 1 - &nbsp;يجوز للهيئة تقسيم المشروع العقاري إلى عدة نطاقات.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;يشترط في تقسيم المشروع العقاري إلى عدة نطاقات الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; موافقة الهيئة على البدء في النطاق.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; أن يكون لكل نطاق حساب ضمان مستقل.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; أن يكون لكل نطاق تقارير هندسية ومالية مستقلة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8b565ffe76894538835511184bb154cc\",\n      \"title\": \"المادة الرابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المطور العقاري بالآتي:<br>&nbsp; &nbsp; &nbsp; 1 - &nbsp;تقديم قوائم مالية عند نهاية المشروع العقاري –معدة من المحاسب القانوني- للهيئة، أو عند طلبها.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;تزويد المشتري أو المستأجر بجميع المخططات الفعلية للوحدة العقارية والمنفذة على الطبيعة.</p>\\n<p>&nbsp; &nbsp; &nbsp; 3 - &nbsp;تنفيذ المشروع حسب المواصفات المتفق عليها في العقود ودراسة الجدوى.</p>\\n<p>&nbsp; &nbsp; &nbsp; 4 - &nbsp;إيداع المبالغ من المشترين أو المستأجرين في حساب الضمان مباشرة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/404beca320b64f59992fb3f755c0392b\",\n      \"title\": \"المادة الخامسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المحاسب القانوني بالآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;متابعة وتدقيق البيانات المالية الخاصة بقيمة الوحدات العقارية المتعاقد عليها، والتأكد من أنها أودعت في حساب الضمان.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;إعداد تقارير العمليات المالية والمحاسبية لحساب الضمان، وقائمة المركز المالي للمشروع، وأوجه الصرف من حساب الضمان مرفقًا بها المستندات اللازمة، أو عند طلب الهيئة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/2f2d0f6625974744953da269b3ccf2b8\",\n      \"title\": \"المادة السادسة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>إذا كان عقار المشروع مسجلاً عينياً وفقاً لنظام التسجيل العيني للعقار؛ فيجب توثيق جميع العقود والتصرفات في (سجل البيع على الخارطة) لدى السجل العقاري.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f2cbc8939abb4914bfac964e96b9fd71\",\n      \"title\": \"المادة السابعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;فيما عدا العقارات المسجلة عينياً وفقاً لنظام التسجيل العيني للعقار؛ يؤشر على صك ملكية العقار -محل المشروع العقاري- لدى الجهة المختصة بالتوثيق بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري، أو إلى أن يسجل العقار لدى السجل العقاري، وإصدار وثيقة التسجيل وفق نظام التسجيل العيني للعقار ولائحته.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يشترط للتأشير على صك تسجيل الملكية للعقار المرهون، موافقة المرتهن.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b98b5755a1544462b9402d15bab0fd6b\",\n      \"title\": \"المادة الثامنة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>يجوز رفع التأشير بعدم التصرف عن صك تسجيل الملكية للعقار المراد تطويره قبل استكمال المشروع العقاري، بعد موافقة الهيئة في الحالات الآتية:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;المشروعات المقامة على أراضٍ حكومية.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;استكمال إجراءات الفرز، أو الدمج، أو التعديل، أو نقل الملكية.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;الإفراغ للمشتري قبل إنجاز الوحدة العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6035652ded5b4df6998631fdd5d3b505\",\n      \"title\": \"المادة التاسعة عشرة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تعد الهيئة نموذجاً استرشادياً للاتفاقية المبرمة بين المطور العقاري وبين مالك الأرض أو مالك منفعتها، على أن تتضمن الاتفاقية مسؤولية المطور العقاري والمالك والتزامهم أمام المشتري أو المستأجر.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;تعد الهيئة نموذجاً استرشادياً للاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي-إن وجد- ونموذجاً للاتفاقيات بين المطور وبين المكتب الاستشاري، والمحاسب القانوني، والوسيط العقاري -إن وجد-.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e7fc3b4f90c840389de3845879f6d7f3\",\n      \"title\": \"المادة العشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تعد الهيئة عقداً نموذجياً للبيع بين مالك الأرض والمطور وبين المشتري أو المستأجر -وذلك فيما عدا العقارات المسجلة عينياً وفق نظام التسجيل العيني للعقار-، يتضمن ما يلي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; جدول الدفعات المالية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; الأحكام المترتبة على تأخر المشتري أو المستأجر في سداد الدفعات المالية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; الأحكام المتعلقة بالتعويض وأجرة المثل عند تأخر المطور في تسليم الأرض أو الوحدة العقارية، بما في ذلك أحكام فسخ العقد.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; مدة تنفيذ المشروع بما في ذلك المدد الإضافية التي يجوز منحها للمطور.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; أحكام الملكية المشتركة، وفق ما ورد في نظام ملكية الوحدات العقارية وفرزها وإدارتها ولائحته.<br>ويجوز للمطور تعديل هذا العقد بعد موافقة الهيئة.&nbsp;</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;تضمن البيانات الواردة في الفقرة رقم (1) من هذه المادة في توثيق التصرف في العقار الموصوف على الخارطة بين أطرافه، وفقاً لنظام التسجيل العيني للعقار ولائحته.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;يجب أن يتضمن عقد مالك الأرض والمطور مع المشتري والمستأجر الإقرار بأن للهيئة إحلال مطور بديل في الحالات التي تقتضيها ظروف تعثر المشروع العقاري، طبقًا للنظام واللائحة وأفضل الممارسات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/895a552b924541ea97866220614ca031\",\n      \"title\": \"المادة الحادية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تكون ملكية الأجزاء المشتركة في المشروع العقاري والتصرف فيها، وفقاً لأحكام نظام ملكية الوحدات العقارية وفرزها وإدارتها ولائحته.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7ab170665cce4c6b93567d09853bed75\",\n      \"title\": \"المادة الثانية والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يتيح المطور لكل مشترٍ ومستأجر، أو من ينوب عنهما؛ الاطلاع على السجل المحاسبي لوحدته العقارية، بناء على طلب يقدّم للمطور.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;على المطور تزويد المشتري أو المستأجر بنسخة من السجل المحاسبي لوحدته خلال (عشرة أيام) عمل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b497fabec85d4bfeafcbe2ae5b29f9cf\",\n      \"title\": \"المادة الثالثة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تنشئ الهيئة قاعدة بيانات للمشروعات العقارية على الخارطة، وعلى المطور أن يضيف فيها ما يلي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;أسماء المقاولين والمكتب الاستشاري والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;بيانات ومواصفات تنفيذ المشروع.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;التقارير الصادرة من المكتب الاستشاري، والمحاسب القانوني، والبنك، وشهادات الانجاز.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;محاضر تعديل المخططات التنفيذية، ونسخاً من المخططات المنفذة فعلياً.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;بيانات الموردين وشهادات الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/6a606f7f6bc04024a6db372a0de0eace\",\n      \"title\": \"المادة الرابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تتيح الهيئة –من قاعدة البيانات- لاطلاع العموم ما يلي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;اسم المشروع العقاري، وبيانات صك تسجيل الملكية، والمخطط المعتمد، وموقعه، ومساحته، وعدد وحداته، ونوعها، ومكونات وحداتها، وبيانات الموردين، وبيانات ومواصفات تنفيذ المشروع، وتقارير سير العمل، وتقارير المكتب الاستشاري، والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;اسم المطور، وتصنيفه.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;اسم المكتب الاستشاري، والمحاسب القانوني، والبنك، والمسوق أو الوسيط العقاري-إن وجد-.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;مدة المشروع العقاري، وتاريخ البدء والتسليم.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;استطلاع آراء المشترين أو المستأجرين بشأن الخدمات المقدمة من المطور.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5e0bda6081f34600adfd0ac69da31b49\",\n      \"title\": \"المادة الخامسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;للهيئة طلب تقرير سير المشروع العقاري من المكتب الاستشاري، أو المحاسب القانوني، أو البنك، كل (شهر) في الحالات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; إذا تجاوزت مسطحات البناء للمشروع العقاري (5000) متر مربع، أو إذا تجاوزت عدد الوحدات العقارية في المشروع العقاري (ثلاثين) وحدة.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; إذا كان المشروع العقاري من المشروعات الحكومية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; إذا كان المشروع واقع في المناطق الخاضعة للتطوير الحكومي.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; أي حالة أخرى تحددها الهيئة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;فيما عدا الحالات الواردة في الفقرة رقم (1) من هذه المادة؛ للهيئة طلب تقرير سير المشروع العقاري من المكتب الاستشاري، أو المحاسب القانوني، أو البنك، كل (ثلاثة) أشهر.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f77204d0b3054ebe9b052dd0460b8f39\",\n      \"title\": \"المادة السادسة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>تضمن اتفاقية فتح حساب الضمان بين المطور وبين البنك الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;أن يكون لكل مشروع حساب ضمان مستقل، ويكون له رقماً موحداً يعد مرجعًا للإيداع.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;أن يكون حساب الضمان (بالريال السعودي).</p>\\n<p>&nbsp; &nbsp; &nbsp;3 - &nbsp;التزام المطور بعدم الصرف من الحساب إلا للأغراض الخاصة بالمشروع.</p>\\n<p>&nbsp; &nbsp; &nbsp;4 - &nbsp;شروط وإجراءات الصرف من حساب الضمان بما يتفق مع أحكام النظام واللائحة.</p>\\n<p>&nbsp; &nbsp; &nbsp;5 - &nbsp;أن يقتصر الصرف من حساب الضمان من خلال شيكات أو حوالات فقط.</p>\\n<p>&nbsp; &nbsp; &nbsp;6 - &nbsp;أن يكون لكل عملية إيداع رقم مرجع مذكور فيه رقم الوحدة العقارية، بناء على عقد المطور مع المشتري أو المستأجر.</p>\\n<p>&nbsp; &nbsp; &nbsp;7 - &nbsp;عدم إسناد مهام البنك المبنية على الاتفاق مع المطور، إلى طرف ثالث أثناء فترة تنفيذ المشروع لأي سبب.</p>\\n<p>&nbsp; &nbsp; &nbsp;8 - &nbsp;أن تزوّد الهيئة -عند طلبها- بكشف حساب الضمان.</p>\\n<p>&nbsp; &nbsp; &nbsp;9 - &nbsp;عدم إغلاق حساب الضمان بالاتفاق مع المطور إلا بعد موافقة الهيئة.</p>\\n<p>10 - &nbsp;عدم إصدار بطاقات صرف آلي أو بطاقات ائتمان على حساب الضمان.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/76815f474507461ea1140bf4d4d3e07e\",\n      \"title\": \"المادة السابعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يتم الصرف من حساب الضمان بموجب وثيقة الصرف المقدمة من المطور إلى البنك على أن تكون مصادقة من المكتب الاستشاري والمحاسب القانوني ومتضمنة المبالغ ومبررات الصرف، ويجوز أن تكون وثائق الصرف من خلال وسائل التقنية الآمنة.<br>&nbsp; &nbsp; &nbsp; 2 - &nbsp;على المطور والمكتب الاستشاري والمحاسب القانوني تحديد المفوض من قبل كل منهم للمصادقة على وثيقة الصرف، وتزويد البنك بتواقيعهم.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/1adf9545aecc435eb3e2ceaf7162b46d\",\n      \"title\": \"المادة الثامنة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة المادة الحادية عشرة من النظام يجوز بطلب من الهيئة الصرف من حساب الضمان في الحالات الآتية:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;سداد المستحقات المالية للجهات الحكومية.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;إعادة المبالغ للمشترين أو المستأجرين.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;صرف مستحقات أطراف المشروع حال استحقاقها وعدم تعاون المطور.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;تحويل موجودات حساب الضمان لحساب الضمان للمطور البديل.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;إصلاح العيوب في المشروع وفق ما ورد في الفقرة رقم (3) من المادة (الحادية والثلاثون) من اللائحة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/9773996d955248578f6384b392b2d8a8\",\n      \"title\": \"المادة التاسعة والعشرون\",\n      \"content\": {\n        \"markup\": \"<p>يعد من المصاريف غير الانشائية للمشروع المرخص له الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;سداد قيمة الأرض للمالك.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;سداد مبالغ التمويل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/ad68673dc37d4356860d8c81762e9526\",\n      \"title\": \"المادة الثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;إذا رغب المطور سحب ما يفيض عن التكلفة الفعلية، فيرفع تقريراً مالياً لإنهاء المشروع إلى الهيئة، متضمناً تكلفة المشروع الفعلية على أن تكون مبنية على عقود مع الموردين والمقاولين ومقدمي الخدمات، ومصادقًا عليها من المكتب الاستشاري والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;إذا أجازت الهيئة التقرير؛ أصدرت إذنًا للمكتب الاستشاري والمحاسب القانوني بالتوقيع على أوامر الصرف للمبالغ الفائضة إلى المطور، ولا يعفي ذلك عن مسؤولية المطور والمكتب الاستشاري والمحاسب القانوني في أي مرحلة.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;للهيئة منع صرف الفائض إذا رأت تأخر المطور في مراحل العمل، أو عند الإخلال بالجودة المتعاقد عليها.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يجوز للهيئة تحديد الصرف بجزء من المبلغ الفائض، وفقاً لتقديرها وملاءة المطور وسجل مشروعاته العقارية السابقة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b5c77a3c94c74f7ba56817f529cc3b2f\",\n      \"title\": \"المادة الحادية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;مع مراعاة المادة (الرابعة عشرة) من النظام يحظر على المحاسب القانوني صرف المبلغ المحتفظ به في حساب الضمان، إذا تبين للمكتب الاستشاري، أو المشتري، أو المستأجر، وجود عيوب في الإنشاءات أو التشطيب، بموجب تقرير من خبير مرخص نظاماً، وتُصدر الهيئة قراراً بإصلاح العيوب.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;للهيئة تمديد الاحتفاظ بالمبلغ، أو تطلب تمديد الضمان البنكي -بحسب الأحوال- لمدة (ستة) أشهر، تبدأ بعد صدور قرار إصلاح العيوب.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;إذا أشعرت الهيئة المطور العقاري بالعيوب، ولم يقم بالبدء بإصلاحها خلال (خمسة أيام) من تاريخ إبلاغه فيجوز للهيئة التصرف بالمبلغ المحجوز لإصلاح العيوب، أو مصادرة مبلغ الضمان البنكي، في حدود التكلفة التقديرية للإصلاح.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يجوز صرف المبلغ المحتفظ به في حساب الضمان وإعادة مبلغ الضمان البنكي للمطور قبل انقضاء المدة المحددة في المادة (الرابعة عشرة) من النظام إذا قدم وثيقة تأمين على العيوب الخفية للمباني والإنشاءات معتمدة من هيئة التأمين، على ألا تقل مدتها عن (سنة).</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fa63cfc675ea4404a0c3c9c2cf3db6e3\",\n      \"title\": \"المادة الثانية والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>لا يجوز للمطور تعديل المخططات التنفيذية المعتمدة إلا بعد موافقة الهيئة والمشترين أو المستأجرين.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e0e68a96affd4a6ea310ea3e66926059\",\n      \"title\": \"المادة الثالثة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يجب على المكتب الاستشاري، والمحاسب القانوني، -كل فيما يخصه- إبلاغ الهيئة عن أي مخالفة لأحكام النظام واللائحة، أو الإخلال بالالتزامات التعاقدية للمطور تجاه المشترين والمستأجرين، خلال مدة لا تزيد عن (خمسة) أيام عمل من تاريخ العلم بها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c31e8cd000e24240a01f90119d44ac95\",\n      \"title\": \"المادة الرابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يعد المطور متأخراً عن تنفيذ المشروع إذا لم ينجز المشروع بعد انتهاء مدته دون سبب خارج عن إرادته.</p>\\n<p>&nbsp; &nbsp; &nbsp;2 - &nbsp;يجوز أن تمنح الهيئة مدة إضافية لتنفيذ المشروع بعد انتهاء مدته، على ألا تزيد عن (سنة).</p>\\n<p>&nbsp; &nbsp; &nbsp;3 - &nbsp;يعد المطور متعثراً عن تنفيذ المشروع في الحالات الآتية:</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; &nbsp; إذا لم ينجز المشروع بعد انتهاء مدته بما في ذلك المدة الإضافية الممنوحة له.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ‌ب- &nbsp; &nbsp;إذا توقفت أعمال التنفيذ لمدة تزيد عن (مئة وثمانين) يوماً في أي مرحلة من مراحل المشروع.<br>ما لم يقدم المطور سبباً مشروعاً تقبله الهيئة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/61f3906ad2774dbe9227e0ae6d4f06ef\",\n      \"title\": \"المادة الخامسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>يلتزم المطور عند تأخره عن تسليم الأرض أو الوحدة العقارية في الموعد المحدد لإنجازه -دون سبب خارج عن إرادته- بدفع تعويض مادي للمشتري أو المستأجر وفق الآتي:<br>     1 -  إذا كان المشروع أرضاً مطورة؛ فيكون التعويض بناء على اتفاق الأطراف على ألا يقل عن نسبة 2% من قيمة البيع تحتسب على أساس سنوي.</p>\\n<p>     2 -  إذا كان المشروع وحدة عقارية؛ فيكون التعويض بناء على اتفاق الأطراف على ألا يقل عن أجرة المثل للوحدة من مقيم معتمد.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d25be1c92e0642b7991840866f466e7a\",\n      \"title\": \"المادة السادسة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تصدر الهيئة دليلًا فنياً لمعالجة المشروعات العقارية المتأخرة والمتعثرة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يجب أن يتضمن الدليل الفني جميع البيانات اللازمة فنياً وفقاً لأفضل الممارسات، ومنها:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; ‌وصف أنواع تأخر وتعثر المشروعات العقارية ودرجاتها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; ‌الطرق والأساليب والإجراءات الواجب اتباعها لمعالجة التأخر أو التعثر، بما في ذلك خطط إدارة تصحيح إنجازها، وتقرير التغييرات اللازمة لاستكمالها، بما في ذلك تغيير تابعي المطور، وتعديل المواصفات، دون إخلال بحقوق المشترين أو المستأجرين.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; أدوات التدخل الرئيسة لمعالجة التأخر أو التعثر.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; ‌إعادة الهيكلة المالية بما في ذلك خيارات سد فجوات التمويل حال وجودها، وخيارات التمويل في حال اقتضى تأخر أو تعثر المشروع العقاري تمويلاً إضافياً.</p>\\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; آليات منح المدد الإضافية للمشروعات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/733458372d904fd2a1a380bef36b038d\",\n      \"title\": \" المادة السابعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -35.65pt; mso-text-indent-alt: -.05in; line-height: 85%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in 35.65pt .0001pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraphCxSpFirst\\\">&nbsp; &nbsp; &nbsp;1 - &nbsp;تؤهل الهيئة جهات خبرة في تقويم تعثر مشروعات التطوير العقاري، وإدارة تصحيح مسارها؛ وذلك وفقاً لأفضل ممارسات المجال، وللهيئة الاستعانة بالاستشاريين المتخصصين لمساندتها في التأهيل.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;تطرح منافسة -وفقاً للأنظمة المرعية- لاختيار الجهة المتخصصة بتقويم وتصحيح تعثر المشروعات العقارية لكل مشروع متعثر على حده.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/0b525757c3384f25929deb730228a8e9\",\n      \"title\": \"المادة الثامنة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;تشكل الهيئة لجنة متخصصة للإشراف على معالجة المشروعات العقارية المتأخرة والمتعثرة، ولها الاستعانة بالخبراء لدعم اللجنة بالخبرة اللازمة، ويكون للجنة كامل الاختصاصات المقررة في النظام واللائحة، والدليل الفني لمعالجة المشروعات العقارية المتأخرة والمتعثرة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;تتخذ اللجنة التدابير الواجبة لحماية حقوق ذوي العلاقة لإكمال المشروع العقاري المرخص، ومن ذلك:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; ‌تعيين شخص مؤهل لإدارة العلاقة مع المطور لمعالجة تعثر المشروع العقاري.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; ‌فحص ومتابعة عمل المطور، والمكتب الاستشاري، والمحاسب القانوني.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; ‌إلزام المطور باستبدال المتسببين في تعثر المشروع العقاري.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; ‌صرف مبالغ من حساب ضمان المشروع العقاري إذا كان لازماً لتصحيح مسار المشروع.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; ‌إحلال مطور بديل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/411bd50a9c9a496b8e4ec60255c21a9b\",\n      \"title\": \"المادة التاسعة والثلاثون\",\n      \"content\": {\n        \"markup\": \"<p>إذا تعذرت التصفية الرضائية للمشروع العقاري المتعثر؛ فتحيل الهيئة المشروع إلى المحكمة المختصة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/27429907113544569bbf16a5031cbb34\",\n      \"title\": \"المادة الأربعون\",\n      \"content\": {\n        \"markup\": \"<p>الأعمال التي يجوز إسنادها إلى القطاع الخاص هي أعمال الإشراف الفني ومنها ما يلي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;الإشراف على المكاتب الاستشارية، والمحاسبين القانونيين، في تنفيذ واجباتهم التعاقدية.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;متابعة تنفيذ المشروعات العقارية بعد ترخيصها؛ وفقاً للالتزامات الإشرافية والتعاقدية، على أن يرفع للهيئة تقارير دورية عنها وأن ينفذ توجيهاتها وفقاً لاختصاصها.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;الرقابة والتفتيش على المشروعات العقارية.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/e66c6a227c8048329b16c05bb4062b65\",\n      \"title\": \"المادة الحادية والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تسند الأعمال إلى القطاع الخاص وفقاً لنظام المنافسات والمشتريات الحكومية، وبناء على عقد ينظم تفصيلاً للالتزامات بما يحقق تنفيذ النظام واللائحة، على أن يتضمن تقسيم الوظائف الأساسية للمهام المسندة إلى القطاع الخاص مما يقتضيه تنفيذ تلك الأعمال، ويجوز أن تسند الأعمال إلى جهات متعددة في القطاع الخاص.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8755e28605a0426a96b80814106c790f\",\n      \"title\": \"المادة الثانية والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يتولى مسؤولو الضبط الذين يصدر تعينهم بقرار من الهيئة، ضبط مخالفات أنشطة البيع أو التأجير على الخارطة وممارساتها، التي لا تتفق مع أحكام النظام واللائحة؛ بموجب محضر، متضمناً الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; ‌‌اسم المخالف وبياناته، واسم المشروع العقاري، ومكان ضبط المخالفة، وزمانها، وتاريخها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; ‌اسم مسؤول الضبط الذي رصد المخالفة، وصفته.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; ‌تحديد نوع وعدد المخالفات المضبوطة، والأدلة والقرائن المستند عليها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; كامل أقوال من تنسب إليه المخالفة، بما في ذلك أوجه دفاعه.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; النتائج التي انتهى إليها مسؤول الضبط.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌و- &nbsp; &nbsp; توقيع المحضر من محرره ومن المخالف، أو من يقوم مقامه، مع بيان صفته، وفي حال رفضه التوقيع يشار إلى ذلك في المحضر.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يجوز استخدام الوسائل الإلكترونية الحديثة عند ممارسة صلاحيات الضبط.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;لمسؤولي الضبط في سبيل تأدية مهامهم البحث والتحري ومتابعة البلاغات والشكاوى عن مخالفات النظام واللائحة، ولهم الاستعانة برجال الضبط الجنائي عند اللزوم؛ لدعمهم في عملهم وضبطهم للمخالفات.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/d968564d9290470da921f58721752b95\",\n      \"title\": \"المادة الثالثة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>المخالفات الجسيمة لأحكام النظام واللائحة هي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;الأفعال الواردة في المادة (الرابعة والعشرون) من النظام.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;الأفعال المرتبطة بالغش أو التضليل، أو التحايل أو الخيانة، وكانت عن قصد وعمد، أو ترتب عليها ضرر بالغ على صحة الإنسان، أو سلامته، أو الصحة العامة، أو البيئة، أو المرفق العام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/f2c79532be5240679b89d5f7317de701\",\n      \"title\": \"المادة الرابعة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنظر لجنة النظر في مخالفات أحكام النظام واللائحة وإيقاع العقوبات، المخالفات المضبوطة، وتكون قواعد عملها وفق الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;تعقد اللجنة اجتماعاتها في المركز الرئيس للهيئة، أو إلكترونياً وفق ما تراه، ولها أن تعقد اجتماعاتها خارج الهيئة متى دعت الحاجة لذلك.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;لا تنعقد اجتماعات اللجنة إلا بحضور أغلبية أعضائها، على أن يكون من بينهم رئيس اللجنة أو نائبه.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;تعد اجتماعات اللجنة ومداولاتها سرية، ولا يجوز حضور غير أعضائها إلا بموافقة رئيس اللجنة.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يعد أمين اللجنة محضراً لكل اجتماع؛ يُدون فيه تاريخ انعقاده، ووقته، ومكانه، والحاضرون فيه، والمخالفات المنظورة، والإجراءات والوقائع المتداولة أثناء الاجتماع، والقرارات الصادرة، ويوقّع من رئيس اللجنة أو نائبه، والأعضاء الحاضرين.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;يجوز تحرير محضر الاجتماع، ورفعه، وتوقيعه إلكترونياً.<br>&nbsp; &nbsp; &nbsp;6 - &nbsp;على رئيس اللجنة تنظيم الأعمال والمهام بين الأعضاء.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/7724781d2b3d4a93be2cb64e1a88ce83\",\n      \"title\": \"المادة الخامسة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يجب على كل من نسبت إليه المخالفة -والأشخاص ذوي العلاقة- التعاون التام مع اللجنة في الكشف عن أي معلومات أو بيانات تطلبها اللجنة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;للجنة الاطلاع على جميع المعلومات المتعلقة بالمخالفة؛ بما فيها المعلومات السرية.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;تصدر اللجنة قرار إيقاع العقوبة متضمنًا الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; اسم المخالف، وبياناته الأساسية.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; النص النظامي الذي تمت مخالفته، ووصف المخالفة المرتكبة، وملخص الوقائع ذات الصلة فيها، والدفوع المؤثرة المقدمة من المخالف، والرد عليها، ومنطوق القرار، وأسبابه.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ج- &nbsp; &nbsp; رقم القرار وتاريخه، وتوقيع رئيس اللجنة، أو نائبه.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌د- &nbsp; &nbsp; النص على حق المخالف في الاعتراض على قرار إيقاع العقوبة، وفقًا للإجراءات المنظمة لذلك.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ه- &nbsp; &nbsp; أي إضافة ترى اللجنة مناسبتها.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌و- &nbsp; &nbsp; ويجوز تحرير القرار، ورفعه، وتوقيعه إلكترونيًا.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يعتمد الرئيس التنفيذي للهيئة قرار اللجنة، وتكون القرارات نافذة من تاريخ صدورها، ما لم يصدر أمر من المحكمة الإدارية بوقف تنفيذها.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;تتولى الهيئة من تلقاء نفسها أو بناء على طلب المخالف تصحيح ما يقع في قرارها من أخطاء مادية، وإذا وقع غموض أو إيهام في القرار؛ فإن للمخالف أن يطلب من الهيئة تفسيره.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/96b393e19a494ab2b2f10fbf564e605e\",\n      \"title\": \"المادة السادسة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يصرف لرئيس وأعضاء وأمين اللجنة مكافأة قدرها (2000) ألفي ريال عن كل اجتماع يحضره، على ألا تزيد عن (20.000) عشرين ألف ريال شهرياً لكل عضو.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يشترط لاستحقاق مكافأة اللجنة توفر الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; أن تباشر اللجنة أعمالها خارج وقت الدوام الرسمي.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ب- ألا يكون الرئيس أو العضو متفرغاً لأعمال اللجنة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/a0445566f1e543c2821f9574a3302065\",\n      \"title\": \"المادة السابعة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يتحقق الإبلاغ بقرارات الهيئة أو لجنة النظر في المخالفات وإيقاع العقوبات بإحدى الوسائل الآتية:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;الرسائل النصية المرسلة عبر الهاتف المحمول الموثق.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;البريد الإلكتروني.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;أحد الحسابات المسجلة في أي من الأنظمة الآلية الحكومية.</p>\\n<p>&nbsp; &nbsp; &nbsp;4 - &nbsp;البريد المسجل.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/03870778426b4c7988c9de0a1cc21b60\",\n      \"title\": \"المادة الثامنة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>يصدر المجلس جدولاً للمقابل المالي الذي تتقاضاه الهيئة لما تقدمه من خدمات بناء على أحكام النظام.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/62b4acb46cac4479919914524ff91a9d\",\n      \"title\": \"المادة التاسعة والأربعون\",\n      \"content\": {\n        \"markup\": \"<p>تنشر اللائحة في الجريدة الرسمية</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"0\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/fb0b635c66d04e91ac44f2e8493a4b41\",\n      \"title\": \"سجل قيد المطورين\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/b4e1245a274745bda4ca7ad33ef60198\",\n      \"title\": \"ترخيص وتنفيذ مشروعات البيع والتأجير على الخارطة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/582aedb1e7ce422194d9b9492e9cddb2\",\n      \"title\": \"تأخر وتعثر تنفيذ مشروعات البيع والتأجير على الخارطة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8f75845a2cd640019ffec7202f998623\",\n      \"title\": \"الإشراف والتفتيش والضبط\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/8f562d2d946045b9ab88c17d7f66bd96\",\n      \"title\": \"أحكام ختامية\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"header\": \"1\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentItems (en-us)","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/18df720ad3b145a6a9453abda1e98ae1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5ed06469a002401a9024770771fa926d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/05f16d0bc41a4e4887eef872102f299f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/56ae3a144276416eb254b259683d679c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c801e726dd304835a549bfa9cdc0370f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d75a51d9717c4c398bb9f818511938b9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/379b0ca59edf42cb8132be03b4216ed1\"\n      },\n      {\n        \"contentUdi\": \"umb://element/bf6d867e45c54baaa3c0704c1d98b76e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5f2f0840905c4814a4ddf1ee3e238884\"\n      },\n      {\n        \"contentUdi\": \"umb://element/349d7f2ed6bb4c63b9ab03fc04fe39d2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c34a049e08d54238b60c63e11079e1b7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/540cd24918ca4a8fa65b90c1f32719ea\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f03189a5dbe4a2097b3e7dd82f9ab0b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8b565ffe76894538835511184bb154cc\"\n      },\n      {\n        \"contentUdi\": \"umb://element/404beca320b64f59992fb3f755c0392b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/2f2d0f6625974744953da269b3ccf2b8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f2cbc8939abb4914bfac964e96b9fd71\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b98b5755a1544462b9402d15bab0fd6b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6035652ded5b4df6998631fdd5d3b505\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e7fc3b4f90c840389de3845879f6d7f3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/895a552b924541ea97866220614ca031\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7ab170665cce4c6b93567d09853bed75\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b497fabec85d4bfeafcbe2ae5b29f9cf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a606f7f6bc04024a6db372a0de0eace\"\n      },\n      {\n        \"contentUdi\": \"umb://element/5e0bda6081f34600adfd0ac69da31b49\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f77204d0b3054ebe9b052dd0460b8f39\"\n      },\n      {\n        \"contentUdi\": \"umb://element/76815f474507461ea1140bf4d4d3e07e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/1adf9545aecc435eb3e2ceaf7162b46d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/9773996d955248578f6384b392b2d8a8\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ad68673dc37d4356860d8c81762e9526\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b5c77a3c94c74f7ba56817f529cc3b2f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/fa63cfc675ea4404a0c3c9c2cf3db6e3\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e0e68a96affd4a6ea310ea3e66926059\"\n      },\n      {\n        \"contentUdi\": \"umb://element/c31e8cd000e24240a01f90119d44ac95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/61f3906ad2774dbe9227e0ae6d4f06ef\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d25be1c92e0642b7991840866f466e7a\"\n      },\n      {\n        \"contentUdi\": \"umb://element/733458372d904fd2a1a380bef36b038d\"\n      },\n      {\n        \"contentUdi\": \"umb://element/0b525757c3384f25929deb730228a8e9\"\n      },\n      {\n        \"contentUdi\": \"umb://element/411bd50a9c9a496b8e4ec60255c21a9b\"\n      },\n      {\n        \"contentUdi\": \"umb://element/27429907113544569bbf16a5031cbb34\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e66c6a227c8048329b16c05bb4062b65\"\n      },\n      {\n        \"contentUdi\": \"umb://element/8755e28605a0426a96b80814106c790f\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d968564d9290470da921f58721752b95\"\n      },\n      {\n        \"contentUdi\": \"umb://element/f2c79532be5240679b89d5f7317de701\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7724781d2b3d4a93be2cb64e1a88ce83\"\n      },\n      {\n        \"contentUdi\": \"umb://element/96b393e19a494ab2b2f10fbf564e605e\"\n      },\n      {\n        \"contentUdi\": \"umb://element/a0445566f1e543c2821f9574a3302065\"\n      },\n      {\n        \"contentUdi\": \"umb://element/03870778426b4c7988c9de0a1cc21b60\"\n      },\n      {\n        \"contentUdi\": \"umb://element/62b4acb46cac4479919914524ff91a9d\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/18df720ad3b145a6a9453abda1e98ae1\",\n      \"title\": \"المادة الأولى\",\n      \"content\": {\n        \"markup\": \"<p>يكون للألفاظ والعبارات الواردة في اللائحة معاني الألفاظ والعبارات الواردة في النظام، ما لم يقتضِ السياق خلاف ذلك، ويُقصد بالعبارات الآتية -أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها:<br>الهيئة: الهيئة العامة للعقار.<br>المجلس: مجلس إدارة الهيئة العامة للعقار.</p>\\n<p> </p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/5ed06469a002401a9024770771fa926d\",\n      \"title\": \"المادة الثانية\",\n      \"content\": {\n        \"markup\": \"<p>مع مراعاة أحكام المادة (الرابعة) من النظام تختص الهيئة بالإشراف على تنظيم بيع وتأجير مشروعات عقارية على الخارطة، بما في ذلك:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;إصدار الدليل الاجرائي لبيع وتأجير مشروعات عقارية على الخارطة، وفقًا للنظام واللائحة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;إصدار القرارات التنفيذية لممارستها الاختصاصات وفقاً للنظام واللائحة.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;قيد المطورين العقاريين؛ وفقاً للنظام واللائحة.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;ترخيص المشروعات العقارية؛ وفقًا للنظام واللائحة.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;الرقابة والتفتيش على سائر أعمال النشاط.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/05f16d0bc41a4e4887eef872102f299f\",\n      \"title\": \"المادة الثالثة\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp; &nbsp; &nbsp;1 - &nbsp;يشترط لقيد الشخص الاعتباري في سجل قيد المطورين الآتي:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌أ- &nbsp; &nbsp; سجل تجاري ساري المفعول.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;‌ب- &nbsp; &nbsp; الحصول على (خمسة وثلاثين) نقطة من (مئة) نقطة كحدٍ أدنى وفقاً للجدول في المادة (الخامسة) من اللائحة.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;يشترط لقيد الشخص الطبيعي -عند الاقتضاء- في سجل قيد المطورين الحصول على (خمسة وثلاثين) نقطة من (خمسة وخمسين) نقطة كحدٍ أدنى وفقاً للجدول في المادة (الخامسة) من اللائحة.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;يجوز للمطور طلب رفع نقاط تقييمه في سجل قيد المطورين إذا تغيرت قدراته بعد قيده.<br>&nbsp; &nbsp; &nbsp;4 - &nbsp;يعلق قيد المطور إذا فقد الحد الأدنى من معايير التقييم ويعطى مهلة تصحيحية مدتها (ثلاثة) أشهر، ويشطب قيده إذا لم يصحح وضعه خلال هذه المدة.<br>&nbsp; &nbsp; &nbsp;5 - &nbsp;لا يؤثر التعليق أو الشطب وفق هذه المادة على المشروعات التي صدرت لها تراخيص للبيع أو التأجير على الخارطة.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/56ae3a144276416eb254b259683d679c\",\n      \"title\": \"المادة الرابعة\",\n      \"content\": {\n        \"markup\": \"<p>يضمّن سجل قيد المطورين الآتي:<br>&nbsp; &nbsp; &nbsp;1 - &nbsp;‌اسم المطور، وبيانات السجل التجاري ورأس ماله، وعنوانه الوطني، وبيانات الاتصال بممثله النظامي.<br>&nbsp; &nbsp; &nbsp;2 - &nbsp;‌الهيكل التنظيمي للمطور، شاملًا للوظائف الأساسية.<br>&nbsp; &nbsp; &nbsp;3 - &nbsp;‌أسماء المشروعات العقارية المنفذة أو القائمة، وقيمتها.</p>\\n<p>&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      }\n    },\n    {\n      \"contentTypeKey\": \"2acf2487-14ef-411a-a9b2-bb4c58ec9392\",\n      \"udi\": \"umb://element/c801e726dd304835a549bfa9cdc0370f\",\n      \"title\": \"المادة الخامسة\",\n      \"content\": {\n        \"markup\": \"<p style=\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -35.65pt; mso-text-indent-alt: -.05in; line-height: 85%; mso-list: l0 level1 lfo2; direction: rtl; unicode-bidi: embed; margin: 0in 35.65pt 12.0pt 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoListParagraph\\\"><!-- [if !supportLists]--><span style=\\\"font-size: 20.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Traditional Arabic';\\\"><span style=\\\"mso-list: Ignore;\\\">&nbsp;&nbsp;&nbsp;&nbsp; 1 -&nbsp; </span></span><!--[endif]--><span style=\\\"font-size: 20.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif;\\\" lang=\\\"AR-SA\\\">تكون معايير تقييم قدرات الشخص الاعتباري للقيد في سجل المطورين الآتي:</span></p>\\n<div>\\n<table border=\\\"1\\\" cellspacing=\\\"0\\\" cellpadding=\\\"0\\\" width=\\\"674\\\" class=\\\"1\\\" style=\\\"width: 505.4pt; border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt; mso-table-dir: bidi;\\\" dir=\\\"rtl\\\">\\n<tbody>\\n<tr style=\\\"mso-yfti-irow: 0; mso-yfti-firstrow: yes;\\\">\\n<td width=\\\"117\\\" style=\\\"width: 87.65pt; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; background: #002060; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المعيار</strong></p>\\n</td>\\n<td width=\\\"239\\\" style=\\\"width: 179.35pt; border: solid windowtext 1.0pt; border-right: none; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #002060; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>المتطلبات</strong></p>\\n</td>\\n<td width=\\\"204\\\" style=\\\"width: 153.2pt; border: solid windowtext 1.0pt; border-right: none; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #002060; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>طريقة التقييم</strong></p>\\n</td>\\n<td width=\\\"60\\\" style=\\\"width: 44.8pt; border: solid windowtext 1.0pt; border-right: none; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #002060; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>وزن التقييم</strong></p>\\n</td>\\n<td width=\\\"54\\\" style=\\\"width: 40.4pt; border: solid windowtext 1.0pt; border-right: none; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #002060; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>النوع</strong></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 1;\\\">\\n<td colspan=\\\"5\\\" width=\\\"674\\\" style=\\\"width: 505.4pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">أولاً: القدرات المالية</span></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 2;\\\">\\n<td width=\\\"117\\\" style=\\\"width: 87.65pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">قوائم مالية من محاسب قانوني معتمد</span></p>\\n</td>\\n<td width=\\\"239\\\" style=\\\"width: 179.35pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">1/البيان المالي للمنشآت الحديثة أقل من سنة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>2/قوائم مالية لسنة مالية، للمنشآت التي أنشئت من سنة ولا تزيد عن سنتين.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">3/قوائم مالية لسنتين متتاليتين للمنشآت التي أنشئت منذ سنتين وأكثر.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><strong>*</strong><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">القوائم: الأصول المتداولة- الالتزامات النقدية- الأرباح والخسائر.</span></p>\\n</td>\\n<td width=\\\"204\\\" style=\\\"width: 153.2pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: right; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"left\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">الالتزامات أقل من 20% من حجم الأصول: 20 نقطة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: right; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"left\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">الالتزامات أكبر من 20% وأقل من 80% من حجم الأصول: 15 نقطة.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: right; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"left\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">الالتزامات أكبر من 80% وأقل من 100% من حجم الأصول: 10 نقاط.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: right; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"left\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">الالتزامات (أكبر من/تساوي) حجم الأصول: 5 نقاط.</span></p>\\n</td>\\n<td width=\\\"60\\\" style=\\\"width: 44.8pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">20</p>\\n</td>\\n<td width=\\\"54\\\" style=\\\"width: 40.4pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">الزامي</p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 3;\\\">\\n<td width=\\\"117\\\" style=\\\"width: 87.65pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><strong>شهادة سلامة السجل الائتماني</strong></p>\\n</td>\\n<td width=\\\"239\\\" style=\\\"width: 179.35pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">شهادة من شركة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب التأهيل، على ألا يتجاوز تاريخ إصدار الشهادة (ثلاثة) أشهر من تاريخ تقديم الطلب.</span></p>\\n</td>\\n<td width=\\\"204\\\" valign=\\\"top\\\" style=\\\"width: 153.2pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -10.0pt; line-height: 85%; mso-pagination: widow-orphan; mso-list: l1 level1 lfo1; margin: 0in 10.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"left\\\"><!-- [if !supportLists]--><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Traditional Arabic'; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\">-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">&nbsp; </span></span><!--[endif]-->عدم وجود قضايا: نقطتين.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -10.0pt; line-height: 85%; mso-pagination: widow-orphan; mso-list: l1 level1 lfo1; margin: 0in 10.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"left\\\"><!-- [if !supportLists]--><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Traditional Arabic'; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\">-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">&nbsp; </span></span><!--[endif]-->عدم وجود شيكات مرتجعة: 4 نقاط.</p>\\n<p style=\\\"mso-add-space: auto; text-align: right; text-indent: -10.0pt; line-height: 85%; mso-pagination: widow-orphan; mso-list: l1 level1 lfo1; margin: 0in 10.0pt 0in 0in;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"left\\\"><!-- [if !supportLists]--><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: 'Traditional Arabic'; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\">-<span style=\\\"font: 7.0pt 'Times New Roman';\\\">&nbsp; </span></span><!--[endif]-->عدم وجود مبالغ متعثرة: 4 نقاط.</p>\\n</td>\\n<td width=\\\"60\\\" style=\\\"width: 44.8pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">10</p>\\n</td>\\n<td width=\\\"54\\\" style=\\\"width: 40.4pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #D9E2F3; mso-background-themecolor: accent1; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">إلزامي</p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 4; height: 39.9pt;\\\">\\n<td colspan=\\\"5\\\" width=\\\"674\\\" style=\\\"width: 505.4pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">ثانياً: القدرات الفنية</span></p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 5; height: 39.9pt;\\\">\\n<td width=\\\"117\\\" style=\\\"width: 87.65pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">بيان بالمشروعات المنفذة وإرفاق ما يثبت تنفيذها</span></p>\\n</td>\\n<td width=\\\"239\\\" style=\\\"width: 179.35pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">مشروعات تطوير عقارية: وهي المشروعات الانشائية بحسب نوعها وفق الآتي:</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">السكنية: أن تكون بحد أدنى (10) وحدات سكنية للمشروع الواحد.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">غير السكنية (صناعية، تجارية، مكتبية، ...): أن يكون مسطح بناء المشروع (2000) متر مربع فأكثر.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">تطوير بنية تحتية: أن يكون بمساحة (50.000) متر مربع فأكثر.</span></p>\\n</td>\\n<td width=\\\"204\\\" style=\\\"width: 153.2pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">كل مشروع تطوير عقاري منفذ خلال (10) سنوات ماضية: </span><span>10</span><span> نقاط</span></p>\\n</td>\\n<td width=\\\"60\\\" style=\\\"width: 44.8pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">30</p>\\n</td>\\n<td width=\\\"54\\\" style=\\\"width: 40.4pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\">اختياري</p>\\n</td>\\n</tr>\\n<tr style=\\\"mso-yfti-irow: 6; height: 39.9pt;\\\">\\n<td width=\\\"117\\\" style=\\\"width: 87.65pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: center; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\" align=\\\"center\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">المنهج المتبع لأحد المشروعات المنفذة</span></p>\\n</td>\\n<td width=\\\"239\\\" style=\\\"width: 179.35pt; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-top-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; background: #EDEDED; mso-background-themecolor: accent3; mso-background-themetint: 51; padding: 0in 5.4pt 0in 5.4pt; height: 39.9pt;\\\">\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span style=\\\"mso-bidi-font-size: 15.0pt; line-height: 85%; font-family: 'Traditional Arabic',serif; mso-fareast-font-family: Calibri; color: black; mso-color-alt: windowtext; mso-font-kerning: 1.0pt; mso-ligatures: standardcontextual;\\\" lang=\\\"AR-SA\\\">توضيح المنهج المتبع للمشروعات وفق الآتي:</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>1/نبذه عن المشروع وبياناته، توضح مساحته وأنواعه والغرض من انشاء المشروع ومخطط المشروع. </span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>2/برامج تقنية تستخدم في إدارة المشروعات&nbsp;لمراقبة تقدم المشروع على سبيل المثال لا الحصر (مايكروسوفت، بروجكت، بريمافيرا) وغيرها.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>3/ملخص دراسة الجدوى للمشروع تتضمن (التكاليف والايرادات).</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 85%; mso-pagination: widow-orphan;\\\" dir=\\\"RTL\\\" class=\\\"MsoNormal\\\"><span>4/هيكل فريق المشروع.</span></p>\\n<p style=\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-