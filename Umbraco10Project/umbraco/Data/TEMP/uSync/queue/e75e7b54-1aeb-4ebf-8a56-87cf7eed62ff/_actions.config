,"oldValue":"","newValue":"","change":"Create"},{"success":true,"name":"Property - title","path":"/Properties/*/Value","oldValue":"","newValue":"","change":"Create"}],"key":"2bce819f-bf46-48b9-aabf-a08b209cbdfa"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/9ba9c31f-1a20-4991-b82f-366f6757f12f.config","name":"مركز بروتيك السعودية","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - content","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p><img style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"\\\" alt=\\\"\\\" width=\\\"279\\\" height=\\\"128\\\" data-udi=\\\"umb://media/803b9f26f2de429893517e77b49fcb89\\\"></p>\\n<p>&nbsp;</p>\\n<p>إسهاماً من الهيئة العامة للعقار وإيمانًا منها بدور التقنية في القطاع العقاري وما تمثله من آفاق مستقبلية تسهم في تحقيق مستهدفات رؤية السعودية<span>&nbsp; ٢٠٣٠ التي دعت إلى ضرورة التحول الرقمي ومواصلة توسيع نطاق الخدمات الرقمية، ولما تحظى به التقنيات العقارية \\\"</span>البروبتك\\\" من تمكين كونها تمثل جزءً لا يتجزأ من الحراك التقني والتحول الرقمي الذي<span>&nbsp; تشهده مختلف القطاع الحيوية والاقتصادية بالسعودية </span>، فقد سعت الهيئة لخلق بيئة حاضنة للتقنية العقارية ومجتمع يضم التقنيين العقاريين من خلال إنشاء مركز متكامل لخدمة المهتمين والمتخصصين بالمجال ، مما يسهم في بناء فرص للتواصل مع الجهات المحلية والعالمية، وربط الشركات التقنية ورواد الأعمال بالمستثمرين وأصحاب رؤوس الأموال ، إضافةً إلى تبادل المعرفة وتعزيز الابتكار وتطوير التقنيات العقارية للوصول إلى مستهدفات الاستراتيجية الشاملة للقطاع العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\",\n      \"title\": \"التعريف بالمركز :\",\n      \"content\": {\n        \"markup\": \"<p>مركز بروتيك السعودية مجتمع متكامل لخدمة المهتمين والمتخصصين بالتقنية العقارية محليًا وعالميًا ، ويقدم العديد من الخدمات التي تسهم في تمكين أصحاب العلاقة بما يسهم في تطوير<span>&nbsp; القطاع وتعزيز </span>نموه ورفع كفاءته.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\",\n      \"title\": \"المستفيدون :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li>\\n<p>رواد الأعمال <span>&nbsp;وأصحاب </span>المنشآت الناشئة</p>\\n</li>\\n<li>الشركات المحلية</li>\\n<li>الشركات العالمية</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\",\n      \"title\": \"المبادرات التابعة للمركز\",\n      \"content\": \"\",\n      \"listOfSubcontent\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/19e5b30a0ac94e6a928590206a37294a\"\n            },\n            {\n              \"contentUdi\": \"umb://element/d625b07075144966b8a697edc2f4d21e\"\n            },\n            {\n              \"contentUdi\": \"umb://element/cc73c50281194e0784500396a04e51e3\"\n            },\n            {\n              \"contentUdi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\",\n            \"title\": \"القمة العالمية للتقنية العقارية\",\n            \"content\": {\n              \"markup\": \"<p>تعزيز مكانة المملكة العربية السعودية في مجال التقنية العقارية وجذب الشركات والخبراء البارزين في هذا المجال.</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/c3395462683542fd8c1378dd0fd2a0db\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/cc73c50281194e0784500396a04e51e3\",\n            \"title\": \"مجلس بروبتيك\",\n            \"content\": {\n              \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطاع التقنية العقارية لتبادل المعرفة والخبرات</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/6bb3663f174746c0b49bc57485392f66\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/19e5b30a0ac94e6a928590206a37294a\",\n            \"title\": \"البيئة التنظيمية التجريبية\",\n            \"content\": {\n              \"markup\": \"<p>إجراء التجارب للتقنيات والمنتجات والخدمات واختبار توافقها مع الأنظمة والتشريعات الحالية أو اقتراح تعديلات عليها ، ويكون ذلك عبر بيئة واقعية<span>&nbsp; </span>و مرنة تختبر فاعلية التقنيات ونماذج الأعمال المبتكرة التي لها صلة بالتقنية العقارية</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/36652cc6eff74f20be3816b554f1146c\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/d625b07075144966b8a697edc2f4d21e\",\n            \"title\": \"مسرعة الاعمال\",\n            \"content\": {\n              \"markup\": \"<p>برنامج متقدم يركز على تسريع نمو وتوسع الشركات الريادية والناشئة في مجال التقنية العقارية</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/a7565298ce4b4bba924efc1dfb9d1411\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          }\n        ],\n        \"settingsData\": []\n      },\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\"\n      },\n      {\n        \"contentUdi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\"\n      },\n      {\n        \"contentUdi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\"\n      },\n      {\n        \"contentUdi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e655cbe2900b4a21ac1e767a5d412d10\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p><img style=\\\"display: block; margin-left: auto; margin-right: auto;\\\" src=\\\"\\\" alt=\\\"\\\" width=\\\"279\\\" height=\\\"128\\\" data-udi=\\\"umb://media/803b9f26f2de429893517e77b49fcb89\\\"></p>\\n<p>&nbsp;</p>\\n<p>إسهاماً من الهيئة العامة للعقار وإيمانًا منها بدور التقنية في القطاع العقاري وما تمثله من آفاق مستقبلية تسهم في تحقيق مستهدفات رؤية السعودية<span>&nbsp; ٢٠٣٠ التي دعت إلى ضرورة التحول الرقمي ومواصلة توسيع نطاق الخدمات الرقمية، ولما تحظى به التقنيات العقارية \\\"</span>البروبتك\\\" من تمكين كونها تمثل جزءً لا يتجزأ من الحراك التقني والتحول الرقمي الذي<span>&nbsp; تشهده مختلف القطاع الحيوية والاقتصادية بالسعودية </span>، فقد سعت الهيئة لخلق بيئة حاضنة للتقنية العقارية ومجتمع يضم التقنيين العقاريين من خلال إنشاء مركز متكامل لخدمة المهتمين والمتخصصين بالمجال ، مما يسهم في بناء فرص للتواصل مع الجهات المحلية والعالمية، وربط الشركات التقنية ورواد الأعمال بالمستثمرين وأصحاب رؤوس الأموال ، إضافةً إلى تبادل المعرفة وتعزيز الابتكار وتطوير التقنيات العقارية للوصول إلى مستهدفات الاستراتيجية الشاملة للقطاع العقاري .</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/6a1ef2008d65472896a98219ca4382b2\",\n      \"title\": \"التعريف بالمركز :\",\n      \"content\": {\n        \"markup\": \"<p>مركز بروتيك السعودية مجتمع متكامل لخدمة المهتمين والمتخصصين بالتقنية العقارية محليًا وعالميًا ، ويقدم العديد من الخدمات التي تسهم في تمكين أصحاب العلاقة بما يسهم في تطوير<span>&nbsp; القطاع وتعزيز </span>نموه ورفع كفاءته.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\",\n      \"title\": \"المستفيدون :\",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li>\\n<p>رواد الأعمال <span>&nbsp;وأصحاب </span>المنشآت الناشئة</p>\\n</li>\\n<li>\\n<p>الشركات المحلية</p>\\n</li>\\n<li>الشركات العالمية</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\",\n      \"title\": \"المبادرات التابعة للمركز:\",\n      \"content\": \"\",\n      \"listOfSubcontent\": {\n        \"layout\": {\n          \"Umbraco.BlockList\": [\n            {\n              \"contentUdi\": \"umb://element/19e5b30a0ac94e6a928590206a37294a\"\n            },\n            {\n              \"contentUdi\": \"umb://element/d625b07075144966b8a697edc2f4d21e\"\n            },\n            {\n              \"contentUdi\": \"umb://element/cc73c50281194e0784500396a04e51e3\"\n            },\n            {\n              \"contentUdi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\"\n            }\n          ]\n        },\n        \"contentData\": [\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\",\n            \"title\": \"القمة العالمية للتقنية العقارية\",\n            \"content\": {\n              \"markup\": \"<p>تعزيز مكانة المملكة العربية السعودية في مجال التقنية العقارية وجذب الشركات والخبراء البارزين في هذا المجال.</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/c3395462683542fd8c1378dd0fd2a0db\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/cc73c50281194e0784500396a04e51e3\",\n            \"title\": \"مجلس بروبتيك\",\n            \"content\": {\n              \"markup\": \"<p>جلسات حوارية تجمع الخبراء العاملين في قطاع التقنية العقارية لتبادل المعرفة والخبرات</p>\",\n              \"blocks\": {\n                \"contentData\": [],\n                \"settingsData\": []\n              }\n            },\n            \"listOfSubcontent\": \"\",\n            \"button\": \"\",\n            \"linkToPage\": \"umb://document/6bb3663f174746c0b49bc57485392f66\",\n            \"form\": \"\",\n            \"buttonToURL\": \"\"\n          },\n          {\n            \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n            \"udi\": \"umb://element/19e5b30a0ac94e6a9285