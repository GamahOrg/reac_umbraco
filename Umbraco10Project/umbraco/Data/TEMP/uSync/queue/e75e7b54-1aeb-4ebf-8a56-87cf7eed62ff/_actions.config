egulations","newValue":"","change":"Delete"},{"success":true,"name":"Property - description (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللوائح","change":"Update"},{"success":true,"name":"Property - description (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Regulations","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللوائح","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Regulations","change":"Update"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - title (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"اللوائح","change":"Update"},{"success":true,"name":"Property - title (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Regulations","change":"Update"}],"key":"c332c79b-387d-428b-9194-0910837a19e6"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/a7565298-ce4b-4bba-924e-fc1dfb9d1411.config","name":"مسرعات الأعمال","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - content","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e64f2e78e0c4443c8ba82f92e2827955\"\n      },\n      {\n        \"contentUdi\": \"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\"\n      },\n      {\n        \"contentUdi\": \"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة عن طريق توفير مجموعة شاملة من الخدمات تشمل مساحات العمل المشتركة، والخدمات المتخصصة لتطوير الأعمال، و تتضمن الاستشارات والتوجيه والتدريب، بالإضافة لتيسير الوصول إلى المستثمرين من أجل تسريع تطوّر ونمو الشركات الناشئة والريادية وتوسعها,<span>&nbsp; والعمل على تأسيسها بشكل سليم لتكون داعمة&nbsp; للقطاع العقاري </span>و رفع مساهمته في الناتج المحلي للمملكة العربية السعودية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e64f2e78e0c4443c8ba82f92e2827955\",\n      \"title\": \"اهداف المبادرة:\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>خلق شركات ناشئة<span>&nbsp; على أسس سليمة داعمة للقطاع العقاري </span></li>\\n<li>رفع مساهمة<span>&nbsp; الشركات الناشئة في القطاع العقاري للاقتصاد الوطني </span></li>\\n<li>توسع الشركات في التقنية العقارية محليًا<span>&nbsp; ودوليًا </span></li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\",\n      \"title\": \"النسخة الأولى من برنامج مسرعة التقنية العقارية \",\n      \"content\": {\n        \"markup\": \"<p>تأتي مسرعة التقنية العقارية بنسختها الأولى بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات<span>&nbsp; </span>و نسعد بإعلان فتح<span>&nbsp; التسجيل&nbsp; لبرنامج المسرعة </span>عن طريق مسرعة الأعمال العالمية startup wise guys</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"https://startupwiseguys.com/all-programs/proptech-accelerator-program/\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\",\n      \"title\": \"الأسئلة الشائعة \",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul>\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">برامج مكثفة لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة ، و يوفر مجموعة شاملة من الخدمات والموارد، بما في ذلك توفير مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\n<div>\\n<ul>\\n<li>ماذا تقدم المسرعة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">الدعم المعرفي للشركات الناشئة من خلال عدة برامج من ضمنها<span>&nbsp; التدريب&nbsp; </span>و الارشاد و التوجيه بهدف تأسيس شركات على أسس سليمة</p>\\n<div class=\\\"O0\\\">\\n<ul>\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\n</ul>\\n</div>\\n<ul>\\n<li style=\\\"list-style-type: none;\\\">\\n<ul>\\n<li class=\\\"O0\\\">ورش عمل<span>&nbsp; متخصصة في التقنية العقارية&nbsp; .</span></li>\\n<li class=\\\"O0\\\">قصص نجاح من أبرز رواد الاعمال و المؤثرين .</li>\\n<li class=\\\"O0\\\">جلسات استشارية و ارشادية</li>\\n<li class=\\\"O0\\\">الربط مع الجهات التمويلية .</li>\\n</ul>\\n</li>\\n</ul>\\n<div><span></span></div>\\n<div>\\n<ul>\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; مدة البرنامج 6 شهور </span></p>\\n<ul>\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; لا يوجد رسوم</span></p>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\"\n      },\n      {\n        \"contentUdi\": \"umb://element/e64f2e78e0c4443c8ba82f92e2827955\"\n      },\n      {\n        \"contentUdi\": \"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\"\n      },\n      {\n        \"contentUdi\": \"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\"\n      },\n      {\n        \"contentUdi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة عن طريق توفير مجموعة شاملة من الخدمات تشمل مساحات العمل المشتركة، والخدمات المتخصصة لتطوير الأعمال، و تتضمن الاستشارات والتوجيه والتدريب، بالإضافة لتيسير الوصول إلى المستثمرين من أجل تسريع تطوّر ونمو الشركات الناشئة والريادية وتوسعها,<span>&nbsp; والعمل على تأسيسها بشكل سليم لتكون داعمة&nbsp; للقطاع العقاري </span>و رفع مساهمته في الناتج المحلي للمملكة العربية السعودية.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/e64f2e78e0c4443c8ba82f92e2827955\",\n      \"title\": \"اهداف المبادرة:\",\n      \"content\": {\n        \"markup\": \"<ol>\\n<li>خلق شركات ناشئة<span>&nbsp; على أسس سليمة داعمة للقطاع العقاري </span></li>\\n<li>رفع مساهمة<span>&nbsp; الشركات الناشئة في القطاع العقاري للاقتصاد الوطني </span></li>\\n<li>توسع الشركات في التقنية العقارية محليًا<span>&nbsp; ودوليًا </span></li>\\n</ol>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\",\n      \"title\": \"النسخة الأولى من برنامج مسرعة التقنية العقارية \",\n      \"content\": {\n        \"markup\": \"<p>تأتي مسرعة التقنية العقارية بنسختها الأولى بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات<span>&nbsp; </span>و نسعد بإعلان فتح<span>&nbsp; التسجيل&nbsp; لبرنامج المسرعة </span>عن طريق مسرعة الأعمال العالمية startup wise guys</p>\\n<p><strong>أخر موعد للتقديم: 15/12/2024</strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"https://startupwiseguys.com/all-programs/proptech-accelerator-program/\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\",\n      \"title\": \"الأسئلة الشائعة \",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul>\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">برامج مكثفة لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة ، و يوفر مجموعة شاملة من الخدمات والموارد، بما في ذلك توفير مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\n<div>\\n<ul>\\n<li>ماذا تقدم المسرعة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">الدعم المعرفي للشركات الناشئة من خلال عدة برامج من ضمنها<span>&nbsp; التدريب&nbsp; </span>و الارشاد و التوجيه بهدف تأسيس شركات على أسس سليمة</p>\\n<div class=\\\"O0\\\">\\n<ul>\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\n</ul>\\n</div>\\n<ul>\\n<li style=\\\"list-style-type: none;\\\">\\n<ul>\\n<li class=\\\"O0\\\">ورش عمل<span>&nbsp; متخصصة في التقنية العقارية&nbsp; .</span></li>\\n<li class=\\\"O0\\\">قصص نجاح من أبرز رواد الاعمال و المؤثرين .</li>\\n<li class=\\\"O0\\\">جلسات استشارية و ارشادية</li>\\n<li class=\\\"O0\\\">الربط مع الجهات التمويلية .</li>\\n</ul>\\n</li>\\n</ul>\\n<div><span></span></div>\\n<div>\\n<ul>\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; مدة البرنامج 6 شهور </span></p>\\n<ul>\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; لا يوجد رسوم</span></p>\\n<p dir=\\\"rtl\\\">&nbsp;</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - formIcon","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[]","change":"Update"},{"success":true,"name":"Property - hidePageFromNavigation","path":"/Properties/*/Value","oldValue":"0","newValue":"1","change":"Update"}],"key":"a7565298-ce4b-4bba-924e-fc1dfb9d1411"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"","exception":null,"change":"NoChange","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/ff302e1a-ad49-40a8-b2fd-2fab53b92e4e.config","name":"المهندس عبدالله بن سعود الحماد","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"ff302e1a-ad49-40a8-b2fd-2fab53b92e4e"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/b1541832-8002-4ee2-bd82-b0a10330477e.config","name":"الادلة","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - contentBrief (ar-jo)","path":"/Properties/*/Value","oldValue":"الادلة","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentBrief (en-us)","path":"/Properties/*/Value","oldValue":"Guidelines","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentTitle (ar-jo)","path":"/Properties/*/Value","oldValue":"الادلة","newValue":"","change":"Delete"},{"success":true,"name":"Property - contentTitle (en-us)","path":"/Properties/*/Value","oldValue":"Guidelines","newValue":"","change":"Delete"},{"success":true,"name":"Property - description (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"الادلة","change":"Update"},{"success":true,"name":"Property - description (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Guidelines","change":"Update"},{"success":true,"name":"Property - pageName (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"الادلة","change":"Update"},{"success":true,"name":"Property - pageName (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Guidelines","change":"Update"},{"success":true,"name":"Property - socialMediaImage","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"umb://media/ba6d866b399d4d158df62ecef4617b90","change":"Update"},{"success":true,"name":"Property - title (ar-jo)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"الادلة","change":"Update"},{"success":true,"name":"Property - title (en-us)","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"Guidelines","change":"Update"}],"key":"b1541832-8002-4ee2-bd82-b0a10330477e"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"","exception":null,"change":"NoChange","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/aca28aa2-3460-4d24-9233-345c22ed840d.config","name":"الدكتور محمد بن يحيى آل صايل","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"aca28aa2-3460-4d24-9233-345c22ed840d"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/36652cc6-eff7-4f20-be38-16b554f1146c.config","name":"البيئة التنظيمية التجريبية","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":true,"name":"Property - content","path":"/Properties/*/Value","oldValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>تتيح هذه المبادرة للشركات والمبتكرين في مجال العقار فرصة تجربة تقنياتهم ومنتجاتهم وتطوير أفكارهم، بالإضافة لتعزيز التفاعل بين القطاعين العام والخاص<span>&nbsp; مما يسهم في تعزيز الابتكار والنمو في القطاع</span> العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\",\n      \"title\": \"أهداف المبادرة \",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز التفاعل والتعاون بين القطاعين العام والخاص.</li>\\n<li class=\\\"O0\\\">تمكين الشركات من اختبار خدماتها وابتكاراتها بشكل عملي.</li>\\n<li class=\\\"O0\\\">تطوير أطر تنظيمية تعكس التقدم التقني وتحقق التوازن بين الابتكار والتنظيم في قطاع العقارات.</li>\\n<li class=\\\"O0\\\">تحقيق توازن فعّال بين الابتكار والامتثال التنظيمي في قطاع العقار.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\",\n      \"title\": \" الفئات المسموح لها بالتقدم\",\n      \"content\": {\n        \"markup\": \"<p>&nbsp;</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>شركات التقنية الناشئة:</li>\\n</ul>\\n</div>\\n<div>\\n<div style=\\\"padding-left: 80px;\\\">شركات مطورة لحلول تقنية جديدة أو خدمات بهدف استخدامها في القطاع العقاري سواءً كانت شركات محلية أو شركات عالمية وصدر أو لم يصدر لها تشريع ينظم عملها.</div>\\n</div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>نماذج العمل</li>\\n</ul>\\n<div>\\n<div style=\\\"padding-left: 80px;\\\">نماذج الأعمال التي تتضمن حلول مبتكرة أو تقنيات جديدة وتتعلق بأنشطة العقار صدرت لها لوائح<span>&nbsp; تنظيمية أو تتطلب إصدار لوائح </span>تنظيمية جديدة تتواءم مع طبيعة عملها.</div>\\n</div>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"umb://document/644430d0b05c4e27babd320927603de8\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي البيئة التنظيمية التجريبية وما الغرض منه؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تمثل بيئة تسمح للشركات والمبتكرين في مجال العقارات بتجربة تقنياتهم ومنتجاتهم بحرية تنظيمية تحت إشراف الهيئة العامة للعقار ، وتهدف إلى تعزيز التفاعل بين القطاعين العام والخاص، مما يتيح للشركات اختبار خدماتها وابتكاراتها بشكل يواءم الأطر القانونية الحالية ، مما يمكن الهيئة العامة للعقار من تقييم الابتكارات وتطوير أطر تنظيمية تعكس التقدم التقني وتحقق توازناً بين الابتكار والتنظيم في قطاع العقارات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لماذا تقدم الهيئة العامة للعقار البيئة التنظيمية التجريبية؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span> </span>توفر البيئة التنظيمية التجريبية للشركات فرصة للتعاون مع الجهات الحكومية لتحديد الإطار التنظيمي الذي من شأنه أن يدعم العمليات التجارية لهذه الشركات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>    رواد الأعمال </span>و أصحاب الشركات الناشئة الصغيرة و المتوسطة<span>  المحلية </span>و الدولية</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل هناك معايير للقبول ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم<span>  ، تقديم عرض </span>و نموذج تفصيلي عن خطة<span>  العمل </span>و يتم دارسته</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>كيف سوف يتم اشعار القبول للبيئة التنظيمية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">عبر البريد الالكتروني</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل تؤدي البيئات التنظيمية التجريبية<span>  إلى تخفيف اللوائح التنظيمية وتقليل </span>و تساهم في خلق أنظمة داعمة؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لمَاذا على الشركات القائمة على الابتكار الالتحاق بالبيئة التنظيمية التجريبية ؟ </li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">لتجربة النموذج المبتكر و هل الأنظمة تساعد على استكمال الإجراءات القانونية و التشريعية من ناحية التراخيص</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي المدة<span>  المستغرقة لاختبار النموذج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">12 شهر</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مفهوم<span>  الاختبار الناجح للخدمات </span>و المنتجات المبتكرة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">يحدد<span>  المتقدمون المعايير الخاصة  بخدماتهم </span>و منتجاتهم المبتكرة وكذلك سيحدد فريق العمل معايير معينة للقبول<span>  </span></p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>في حال نجحت التجارب هل سيتم الحصول على الترخيص بشكل مباشر ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تتم عبر<span>  عدة مراحل وسيتم اخطار المتأهلين حولها</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","newValue":"{\n  \"layout\": {\n    \"Umbraco.BlockList\": [\n      {\n        \"contentUdi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\"\n      },\n      {\n        \"contentUdi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\"\n      },\n      {\n        \"contentUdi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\"\n      },\n      {\n        \"contentUdi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\"\n      }\n    ]\n  },\n  \"contentData\": [\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/3de7ec7b8edb435da26550a9ac3cbf93\",\n      \"title\": \"\",\n      \"content\": {\n        \"markup\": \"<p>تتيح هذه المبادرة للشركات والمبتكرين في مجال العقار فرصة تجربة تقنياتهم ومنتجاتهم وتطوير أفكارهم، بالإضافة لتعزيز التفاعل بين القطاعين العام والخاص<span>&nbsp; مما يسهم في تعزيز الابتكار والنمو في القطاع</span> العقاري.</p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/d1f2a3498cb94495a00fbece98d8665c\",\n      \"title\": \"أهداف المبادرة \",\n      \"content\": {\n        \"markup\": \"<ul>\\n<li class=\\\"O0\\\">تعزيز التفاعل والتعاون بين القطاعين العام والخاص.</li>\\n<li class=\\\"O0\\\">تمكين الشركات من اختبار خدماتها وابتكاراتها بشكل عملي.</li>\\n<li class=\\\"O0\\\">تطوير أطر تنظيمية تعكس التقدم التقني وتحقق التوازن بين الابتكار والتنظيم في قطاع العقارات.</li>\\n<li class=\\\"O0\\\">تحقيق توازن فعّال بين الابتكار والامتثال التنظيمي في قطاع العقار.</li>\\n</ul>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/ef20fcceac074210b144cdbca86fe1db\",\n      \"title\": \" الفئات المسموح لها بالتقدم\",\n      \"content\": {\n        \"markup\": \"<ul style=\\\"list-style-type: square;\\\">\\n<li>شركات التقنية الناشئة:</li>\\n</ul>\\n<p style=\\\"padding-left: 80px;\\\">شركات مطورة لحلول تقنية جديدة أو خدمات بهدف استخدامها في القطاع العقاري سواءً كانت شركات محلية أو شركات عالمية وصدر أو لم يصدر لها تشريع ينظم عملها.</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>نماذج العمل</li>\\n</ul>\\n<p style=\\\"padding-left: 40px;\\\">نماذج الأعمال التي تتضمن حلول مبتكرة أو تقنيات جديدة وتتعلق بأنشطة العقار صدرت لها لوائح &nbsp;تنظيمية أو تتطلب إصدار لوائح تنظيمية جديدة تتواءم مع طبيعة عملها.</p>\\n<p style=\\\"text-align: center;\\\"><strong>أخر موعد للتقديم: 31/01/2025</strong></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b3ffe468fcce44dbb4f374b37a37d178\",\n      \"title\": \"\",\n      \"content\": \"\",\n      \"listOfSubcontent\": \"\",\n      \"button\": \"umb://document/644430d0b05c4e27babd320927603de8\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    },\n    {\n      \"contentTypeKey\": \"0ec714a9-23ee-4f17-a692-ea7f9735ff70\",\n      \"udi\": \"umb://element/b84dcc857c914adb99ab9b32adc66977\",\n      \"title\": \"الأسئلة الشائعة\",\n      \"content\": {\n        \"markup\": \"<div class=\\\"O0\\\">\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي البيئة التنظيمية التجريبية وما الغرض منه؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تمثل بيئة تسمح للشركات والمبتكرين في مجال العقارات بتجربة تقنياتهم ومنتجاتهم بحرية تنظيمية تحت إشراف الهيئة العامة للعقار ، وتهدف إلى تعزيز التفاعل بين القطاعين العام والخاص، مما يتيح للشركات اختبار خدماتها وابتكاراتها بشكل يواءم الأطر القانونية الحالية ، مما يمكن الهيئة العامة للعقار من تقييم الابتكارات وتطوير أطر تنظيمية تعكس التقدم التقني وتحقق توازناً بين الابتكار والتنظيم في قطاع العقارات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لماذا تقدم الهيئة العامة للعقار البيئة التنظيمية التجريبية؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span> </span>توفر البيئة التنظيمية التجريبية للشركات فرصة للتعاون مع الجهات الحكومية لتحديد الإطار التنظيمي الذي من شأنه أن يدعم العمليات التجارية لهذه الشركات.</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>من هي الفئة المستهدفة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\"><span>    رواد الأعمال </span>و أصحاب الشركات الناشئة الصغيرة و المتوسطة<span>  المحلية </span>و الدولية</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل هناك معايير للقبول ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم<span>  ، تقديم عرض </span>و نموذج تفصيلي عن خطة<span>  العمل </span>و يتم دارسته</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>كيف سوف يتم اشعار القبول للبيئة التنظيمية ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">عبر البريد الالكتروني</p>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>هل تؤدي البيئات التنظيمية التجريبية<span>  إلى تخفيف اللوائح التنظيمية وتقليل </span>و تساهم في خلق أنظمة داعمة؟</li>\\n</ul>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">نعم</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>لمَاذا على الشركات القائمة على الابتكار الالتحاق بالبيئة التنظيمية التجريبية ؟ </li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">لتجربة النموذج المبتكر و هل الأنظمة تساعد على استكمال الإجراءات القانونية و التشريعية من ناحية التراخيص</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هي المدة<span>  المستغرقة لاختبار النموذج ؟</span></li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">12 شهر</p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>ما هو مفهوم<span>  الاختبار الناجح للخدمات </span>و المنتجات المبتكرة ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">يحدد<span>  المتقدمون المعايير الخاصة  بخدماتهم </span>و منتجاتهم المبتكرة وكذلك سيحدد فريق العمل معايير معينة للقبول<span>  </span></p>\\n<div>\\n<ul style=\\\"list-style-type: square;\\\">\\n<li>في حال نجحت التجارب هل سيتم الحصول على الترخيص بشكل مباشر ؟</li>\\n</ul>\\n</div>\\n<p style=\\\"padding-right: 40px;\\\" dir=\\\"rtl\\\">تتم عبر<span>  عدة مراحل وسيتم اخطار المتأهلين حولها</span></p>\",\n        \"blocks\": {\n          \"contentData\": [],\n          \"settingsData\": []\n        }\n      },\n      \"listOfSubcontent\": \"\",\n      \"button\": \"\",\n      \"linkToPage\": \"\",\n      \"form\": \"\",\n      \"buttonToURL\": \"\"\n    }\n  ],\n  \"settingsData\": []\n}","change":"Update"},{"success":true,"name":"Property - formIcon","path":"/Properties/*/Value","oldValue":"(Blank)","newValue":"[]","change":"Update"},{"success":true,"name":"Property - hidePageFromNavigation","path":"/Properties/*/Value","oldValue":"0","newValue":"1","change":"Update"}],"key":"36652cc6-eff7-4f20-be38-16b554f1146c"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Update","exception":null,"change":"Update","fileName":"umbraco/Data/TEMP/uSync/receive/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content/c3395462-6835-42fd-8c13-78dd0fd2a0db.config","name":"القمة العالمية للتقنية العقارية","path":"/e75e7b54-1aeb-4ebf-8a56-87cf7eed62ff/uSync/Content","requiresPostProcessing":false,"detailMessage":null,"details":[{"success":t