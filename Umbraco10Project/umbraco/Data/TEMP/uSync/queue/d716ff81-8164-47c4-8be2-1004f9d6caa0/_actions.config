\\\\"titleFirst\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/28e5c358d93545528084b4bb12327ea6\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Other\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Target Audience\\\\\\\",\\\\\\\"text\\\\\\\":null,\\\\\\\"icon\\\\\\\":\\\\\\\"umb://media/feb8701eeb0f48eb85d8501d4c57976a\\\\\\\",\\\\\\\"items\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Individuals\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Real Estate Beneficiary\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"link\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/6f21cc883545449599394453bd743af3\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Other\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Beneficiary service\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"Service channels\\\\\\\",\\\\\\\"link\\\\\\\":null,\\\\\\\"icon\\\\\\\":\\\\\\\"umb://media/ca2c1ae6f86049dab9448ce572f3663c\\\\\\\",\\\\\\\"items\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":\\\\\\\"0\\\\\\\"}],\\\\\\\"settingsData\\\\\\\":[]}\\\"}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"\"الخدمات الإلكترونية | الوساطة العقارية \"","newValue":"\"الوساطة العقارية\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"FAL – Real Estate Brokerage\"","change":"Update"}],"key":"919833c5-6fef-41d8-a738-e5a276acb43e"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/5db6ce1d-ea3d-48f0-8c68-f1a3c39d8ce1.config","name":"التقارير السنوية","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"التقارير السنوية\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"Annual Reports\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"تقارير\\\",\\n  \\\"سنوية\\\",\\n  \\\"التقارير\\\",\\n  \\\"السنوية\\\",\\n  \\\"الهيئة\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"العقار\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"التقارير السنوية\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"Annual Reports\"","change":"Update"},{"success":true,"name":"pageTitle","path":"Property/pageTitle","oldValue":"null","newValue":"\"التقارير السنوية\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"التقارير السنوية\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"Annual Reports\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"2","newValue":"1","change":"Update"}],"key":"5db6ce1d-ea3d-48f0-8c68-f1a3c39d8ce1"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/45ba7877-2bde-4dd9-8d40-b226a6d934fb.config","name":"عن البيانات المفتوحة","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"bottomFacts","path":"Property/bottomFacts","oldValue":"\"[{\\\"key\\\":\\\"8679f8c7-135e-4c7f-bbdb-ba45dfe79708\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"المبادئ الرئيسية لحرية المعلومات\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>الشفافية:</strong> للفرد الحق في معرفة المعلومات المتعلقة بأنشطة الهيئة تعزيزاً لمنظومة النزاهة والشفافية والمساءلة.</li>\\\\n<li><strong>الضرورة والتناسب:</strong> أي قيود على طلب الاطلاع أو الحصول على المعلومات المحمية التي تتلقاها أو تنتجها أو تتعامل معها الهيئة يجب أن تكون مبررة بطريقة واضحة وصريحة.</li>\\\\n<li><strong>الأصل في المعلومات الإفصاح:</strong> لكل فرد الحق في الاطلاع على المعلومات العامة -غير المحمية- وليس بالضرورة أن يتمتع مقدم الطلب بحيثية معينة أو باهتمام معين بهذه المعلومات ليتمكن من الحصول عليها، كما لا يتعرض لأي مساءلة قانونية متعلقة بهذا الحق.</li>\\\\n<li><strong>المساواة:</strong> يتم التعامل مع جميع طلبات الاطلاع أو الحصول على المعلومات العامة على أساس المساواة وعدم التمييز بين الأفراد.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"c93bec4e-ecfe-448e-835f-bfc4abd1df50\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"حقوق الأفراد فيما يتعلق بالوصول الى المعلومات العامة أو الحصول عليها\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>حق الاطلاع والحصول على أي معلومة غير محمية لدى أي جهة عامة.</li>\\\\n<li>الحق في معرفة سبب رفض الاطلاع أو الحصول على المعلومات المطلوبة.</li>\\\\n<li>الحق في التظلم على قرار رفض طلب الاطلاع والحصول على المعلومات المطلوبة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"c4df8d3e-0a46-443f-b6d3-30802fe85a99\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"الخطوات الرئيسة للوصول الى المعلومات أو الحصول عليها\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>يجب أن يكون الطلب لأغراض الوصول إلى المعلومات العامة أو الحصول عليها.<br />الخطوات الرئيسة لطلب الاطلاع أو الحصول على المعلومات العامة:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>أولاً</strong>: يتم تقديم الطلبات عن طريق ملء نموذج إلكتروني وتقديمه للهيئة <a href=\\\\\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\\\\\" title=\\\\\\\"طلب بيانات مفتوحة\\\\\\\">بالضغط هنا</a>.</li>\\\\n<li><strong>ثانياً</strong>: تقوم الهيئة، باستلام طلب الاطلاع أو الحصول على المعلومات العامة واتخاذ أحد القرارات التالية:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>الموافقة</strong>: في حال تمت موافقة الهيئة على طلب الوصول إلى المعلومات أو الحصول عليها.</li>\\\\n<li><strong>الرفض</strong>: في حال تم رفض طلب الوصول إلى المعلومات أو الحصول عليها، فيجب أن يكون الرفض خطياً أو إلكترونياً على أن يتضمن المعلومات التالية:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>تحديد ما إذا كان رفض الطلب كلياً أو جزئياً.</li>\\\\n<li>أسباب الرفض، إن أمكن.</li>\\\\n<li>الإشعار: في حال كانت المعلومات المطلوبة متاحه على موقع الهيئة، أو ليست من اختصاصها فيجب إشعار الفرد بذلك خطياً أو إلكترونياً.</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\\n</li>\\\\n<li><strong>ثالثاً</strong>: في حالة رغبة الفرد في التظلّم على رفض الطلب من قبل الهيئة، فيمكنه تقديم إشعار خطي أو إلكتروني بالتظلم إلى مكتب إدارة البيانات في الهيئة خلال فترة زمنية لا تتجاوز (5) أيام عمل من استلامه لقرار الهيئة، ويقوم مكتب إدارة البيانات في الهيئة بمراجعة الطلب واتخاذ القرار المناسب.</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"98ce197a-2e2c-4e17-a98e-dbe560e4523f\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"بيانات  X \\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<p><a href=\\\\\\\"/{localLink:umb://media/387668a09593489b901126aa5db7b591}\\\\\\\" title=\\\\\\\"Pdf Test\\\\\\\">&nbsp;البيانات تاليتلعتي&nbsp; &nbsp;&nbsp;</a></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"c93bec4e-ecfe-448e-835f-bfc4abd1df50\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"حقوق الأفراد فيما يتعلق بالوصول الى المعلومات العامة أو الحصول عليها\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>حق الاطلاع والحصول على أي معلومة غير محمية لدى أي جهة عامة.</li>\\\\n<li>الحق في معرفة سبب رفض الاطلاع أو الحصول على المعلومات المطلوبة.</li>\\\\n<li>الحق في التظلم على قرار رفض طلب الاطلاع والحصول على المعلومات المطلوبة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"icon\\\":[]}]\"","change":"Update"},{"success":true,"name":"bottomFacts","path":"Property/bottomFacts","oldValue":"\"[{\\\"key\\\":\\\"98f46eb6-4685-44c7-90a2-8863a6ee37c6\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"Principle Rights of Freedom of Information: \\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>Transparency: </strong>The individual has the right to know information related to the Authority’s activities to enhance the ecosystem of integrity, transparency, and accountability. </li>\\\\n<li><strong>Necessity and Proportionality: </strong>Any restrictions on obtaining or requesting access to protected information received, produced, or handled by the Authority shall be justified clearly and explicitly. </li>\\\\n<li><strong>Public Information should be Available:</strong> Every applicant has the right to access public – unprotected – information. The applicant does not need to have a particular reason or interest in the information to obtain it, nor be exposed to any legal liability related to this right.</li>\\\\n<li><strong>Equality:</strong> All requests made by individuals to access or receive public information shall be dealt with on an equal and non-discriminatory basis. </li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"fd1831f0-f843-4fd3-8364-cc6bdd132e42\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The Rights of Individuals to Access and Obtain Public Information: \\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access and obtain any information not protected by any public entity. </li>\\\\n<li>The right to know the reason for refusing to access or obtain the required information. </li>\\\\n<li>The right to appeal against the decision to refuse to access or obtain the required information.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"f4408e78-99b1-4c62-9424-8f8babcb5a98\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The Main Steps to Access or Obtaining Information: \\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The request must be to access or obtain public information.&nbsp;<br>The main steps to access or obtain public information:&nbsp;<br>\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>First:</strong> Applications must be submitted by filling out an electronic form and submitting it to the Authority by <strong><a href=\\\\\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\\\\\" title=\\\\\\\"Open Data Request\\\\\\\">clicking here.</a>&nbsp;</strong></li>\\\\n<li><strong>Second:</strong> The Authority receives the request to access or obtain public information and makes one of the following decisions:&nbsp;<br>\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>Approval:</strong> If the Authority approves the request to access or obtain public information.</li>\\\\n<li><strong>Rejection:</strong> If the Authority rejects the request to access or obtain public information, the rejection must be in writing or electronically and include the following information:&nbsp;<br>\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Determine whether the application was rejected partially or fully.</li>\\\\n<li>If possible, state the reasons for the rejection.&nbsp;</li>\\\\n</ul>\\\\n</li>\\\\n<li><strong>Notification:</strong> If the required information is available on the Authority’s website or is not under its jurisdiction, the individual must be notified in writing or electronically.&nbsp;&nbsp;</li>\\\\n</ul>\\\\n</li>\\\\n<li><strong>Third:</strong> In case the individual wishes to appeal the Authority’s rejection of the application, the appeal can be submitted, in writing or electronically, to the Data Management Office at the Authority within 5 business days of receiving the Authority’s decision. The Data Management Office at the Authority will review the request and make the appropriate decision.&nbsp;</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"fd1831f0-f843-4fd3-8364-cc6bdd132e42\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The Rights of Individuals to Access and Obtain Public Information: \\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access and obtain any information not protected by any public entity. </li>\\\\n<li>The right to know the reason for refusing to access or obtain the required information. </li>\\\\n<li>The right to appeal against the decision to refuse to access or obtain the required information.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"icon\\\":[]}]\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"عن البيانات المفتوحة\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"About Open Data\"","change":"Update"},{"success":true,"name":"keyPrinciplesItems","path":"Property/keyPrinciplesItems","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/4099e57067e749bdbef4abc83890044f\\\"},{\\\"contentUdi\\\":\\\"umb://element/73939d70beee459c994bcb4dcdf136d8\\\"},{\\\"contentUdi\\\":\\\"umb://element/a5090fb06ccc4846adf9721376469f74\\\"},{\\\"contentUdi\\\":\\\"umb://element/bd2b76cb280e42a3b712d7478862ed13\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/4099e57067e749bdbef4abc83890044f\\\",\\\"title\\\":\\\"الشفافية\\\",\\\"content\\\":\\\"للفرد الحق في معرفة المعلومات المتعلقة بأنشطة الهيئة تعزيزاً لمنظومة النزاهة والشفافية والمساءلة.\\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"232e053c-2113-4264-a59f-2eb4fbd92c48\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"f7b3357f-3ca9-4560-be12-49ad590f7540\\\\\\\"}]\\\"},{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/73939d70beee459c994bcb4dcdf136d8\\\",\\\"title\\\":\\\"الضرورة والتناسب\\\",\\\"content\\\":\\\"أي قيود على طلب الاطلاع أو الحصول على المعلومات المحمية التي تتلقاها أو تنتجها أو تتعامل معها الهيئة يجب أن تكون مبررة بطريقة واضحة وصريحة.\\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"03aa7750-9598-472e-9012-48b6f7d572b6\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"e59dc720-73f5-4c85-a769-db1c6aee7c02\\\\\\\"}]\\\"},{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/a5090fb06ccc4846adf9721376469f74\\\",\\\"title\\\":\\\"الأصل في المعلومات الإفصاح\\\",\\\"content\\\":\\\"لكل فرد الحق في الاطلاع على المعلومات العامة -غير المحمية- وليس بالضرورة أن يتمتع مقدم الطلب بحيثية معينة أو باهتمام معين بهذه المعلومات ليتمكن من الحصول عليها، كما لا يتعرض لأي مساءلة قانونية متعلقة بهذا الحق.\\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"8afc0ca2-888e-4b06-8833-cd174ef5e87b\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"529fb8e3-4611-4cb2-862b-77e06de1d76f\\\\\\\"}]\\\"},{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/bd2b76cb280e42a3b712d7478862ed13\\\",\\\"title\\\":\\\"المساواة\\\",\\\"content\\\":\\\"يتم التعامل مع جميع طلبات الاطلاع أو الحصول على المعلومات العامة على أساس المساواة وعدم التمييز بين الأفراد.\\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"5f4df4e1-b1fd-4ae8-ae87-264201876a23\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"93fe67dd-48ba-4258-80d5-80cbf43dd31e\\\\\\\"}]\\\"}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"keyPrinciplesItems","path":"Property/keyPrinciplesItems","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/d21d9c226312415db9658f4bcf7a3832\\\"},{\\\"contentUdi\\\":\\\"umb://element/5c3a0b4c29124261af0a583e2238696e\\\"},{\\\"contentUdi\\\":\\\"umb://element/8a86fbd070f148e39a58dde9fd25ccec\\\"},{\\\"contentUdi\\\":\\\"umb://element/c2d239bb73444764b602002b9ee3347d\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/d21d9c226312415db9658f4bcf7a3832\\\",\\\"title\\\":\\\"Transparency\\\",\\\"content\\\":\\\"The individual has the right to know information related to the Authority’s activities to enhance the ecosystem of integrity, transparency, and accountability. \\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"f15bc0b5-0661-4dee-8b5f-0a3583b14e1e\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"f7b3357f-3ca9-4560-be12-49ad590f7540\\\\\\\"}]\\\"},{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/5c3a0b4c29124261af0a583e2238696e\\\",\\\"title\\\":\\\"Necessity and Proportionality\\\",\\\"content\\\":\\\"Any restrictions on obtaining or requesting access to protected information received, produced, or handled by the Authority shall be justified clearly and explicitly. \\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"54e2d8ad-bc21-4af5-803c-6a4ce188c0b1\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"e59dc720-73f5-4c85-a769-db1c6aee7c02\\\\\\\"}]\\\"},{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/8a86fbd070f148e39a58dde9fd25ccec\\\",\\\"title\\\":\\\"Public Information should be Available\\\",\\\"content\\\":\\\"Every applicant has the right to access public – unprotected – information. The applicant does not need to have a particular reason or interest in the information to obtain it, nor be exposed to any legal liability related to this right.\\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"90c62487-f2a3-4801-be4c-2d560768c3ac\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"529fb8e3-4611-4cb2-862b-77e06de1d76f\\\\\\\"}]\\\"},{\\\"contentTypeKey\\\":\\\"7fff1495-08c4-40c0-af8a-0af8f0b9a4a7\\\",\\\"udi\\\":\\\"umb://element/c2d239bb73444764b602002b9ee3347d\\\",\\\"title\\\":\\\"Equality\\\",\\\"content\\\":\\\"All requests made by individuals to access or receive public information shall be dealt with on an equal and non-discriminatory basis. \\\",\\\"icon\\\":\\\"[{\\\\\\\"key\\\\\\\":\\\\\\\"8b209db6-dca0-475c-9ff2-89d2e8527c1e\\\\\\\",\\\\\\\"mediaKey\\\\\\\":\\\\\\\"93fe67dd-48ba-4258-80d5-80cbf43dd31e\\\\\\\"}]\\\"}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"keyPrinciplesTitle","path":"Property/keyPrinciplesTitle","oldValue":"null","newValue":"\"المبادئ الرئيسية لحرية المعلومات\"","change":"Update"},{"success":true,"name":"keyPrinciplesTitle","path":"Property/keyPrinciplesTitle","oldValue":"null","newValue":"\"Principle Rights of Freedom of Information: \"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"البيانات المفتوحة\\\",\\n  \\\"البيانات\\\",\\n  \\\"open\\\",\\n  \\\"data\\\",\\n  \\\"open data\\\",\\n  \\\"الهيئة\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"Rega\\\"\\n]\"","change":"Update"},{"success":true,"name":"openDataContent","path":"Property/openDataContent","oldValue":"\"[{\\\"key\\\":\\\"c1eb1eb3-a408-40a2-966c-d108ef0065f5\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"1972\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<p>أنشأت السلطة</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"141351b4-c7ad-4f2d-bd42-a86b6eb84422\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"2350\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<p>الأعضاء المسجلين</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"null","change":"Update"},{"success":true,"name":"openDataTitle","path":"Property/openDataTitle","oldValue":"\"{\\\"markup\\\":\\\"<p>هناك حقيقة مثبتة منذ زمن طويل وهي أن المحتوى المقروء لصفحة ما سيلهي القارئ عن التركيز على الشكل الخارجي للنص أو شكل توضع الفقرات في الصفحة التي يقرأها.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","newValue":"\"الخطوات الرئيسة للوصول الى المعلومات أو الحصول عليها\"","change":"Update"},{"success":true,"name":"openDataTitle","path":"Property/openDataTitle","oldValue":"null","newValue":"\"The Main Steps to Access or Obtaining Information: \"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"\"About Open Data\"","newValue":"\"عن البيانات المفتوحة\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"About Open Data\"","change":"Update"},{"success":true,"name":"pageTitle","path":"Property/pageTitle","oldValue":"\"عن البيانات المفتوحة\"","newValue":"\"البيانات المفتوحة\"","change":"Update"},{"success":true,"name":"policyItems","path":"Property/policyItems","oldValue":"\"[{\\\"key\\\":\\\"328a599b-f41c-4dda-8817-17aec6ffed24\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"لا تنطبق أحكام هذه السياسة على المعلومات المحمية:\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>المعلومات التي يؤدي إفشاؤها إلى الإضرار بالأمن الوطني للدولة أو سياستها أو مصالحها أو حقوقها.</li>\\\\n<li>المعلومات العسكرية والأمنية.</li>\\\\n<li>المعلومات والوثائق التي يتم الحصول عليها بمقتضى اتفاق مع دولة أخرى وتصنف على أنها محمية.</li>\\\\n<li>التحريات والتحقيقات وأعمال الضبط وعمليات التفتيش والمراقبة المتعلقة بجريمة أو مخالفة أو تهديد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>الأبحاث العلمية أو التقنية، أو الحقوق المشتملة على حق من حقوق الملكية الفكرية التي يؤدي الكشف عنها إلى المساس بحق معنوي.</li>\\\\n<li>المعلومات المتعلقة بالمنافسات والعطاءات والمزايدات التي يؤدي الإفصاح عنها إلى الإخلال بعدالة المنافسة.</li>\\\\n<li>المعلومات التي تكون سرية أو شخصية بموجب نظام آخر، أو تتطلب إجراءات نظامية معينة للوصول إليها أو الحصول عليها.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"328a599b-f41c-4dda-8817-17aec6ffed24\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"لا تنطبق أحكام هذه السياسة على المعلومات المحمية:\\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>المعلومات التي يؤدي إفشاؤها إلى الإضرار بالأمن الوطني للدولة أو سياستها أو مصالحها أو حقوقها.</li>\\\\n<li>المعلومات العسكرية والأمنية.</li>\\\\n<li>المعلومات والوثائق التي يتم الحصول عليها بمقتضى اتفاق مع دولة أخرى وتصنف على أنها محمية.</li>\\\\n<li>التحريات والتحقيقات وأعمال الضبط وعمليات التفتيش والمراقبة المتعلقة بجريمة أو مخالفة أو تهديد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>المعلومات التي تتضمن توصيات أو اقتراحات أو استشارات من أجل إصدار تشريع أو قرار حكومي لم يصدر بعد.</li>\\\\n<li>الأبحاث العلمية أو التقنية، أو الحقوق المشتملة على حق من حقوق الملكية الفكرية التي يؤدي الكشف عنها إلى المساس بحق معنوي.</li>\\\\n<li>المعلومات المتعلقة بالمنافسات والعطاءات والمزايدات التي يؤدي الإفصاح عنها إلى الإخلال بعدالة المنافسة.</li>\\\\n<li>المعلومات التي تكون سرية أو شخصية بموجب نظام آخر، أو تتطلب إجراءات نظامية معينة للوصول إليها أو الحصول عليها.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"icon\\\":[{\\\"key\\\":\\\"8213050e-90f6-4900-b250-48eb10be64d6\\\",\\\"mediaKey\\\":\\\"a2d49abc-ef31-4423-9acb-c3065aae0986\\\"}]}]\"","change":"Update"},{"success":true,"name":"policyItems","path":"Property/policyItems","oldValue":"\"[{\\\"key\\\":\\\"41742057-a80e-40cb-a058-939d170f8a18\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The provisions of this policy do not apply to protected information: \\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Information that the disclosure of harms the state’s national security, policy, interests, or rights.</li>\\\\n<li>Military and security information.</li>\\\\n<li>Information and documents obtained by an agreement with another country and classified as protected.</li>\\\\n<li>Information that includes investigations, inspections, and surveillance related to a crime, violation, or threat.&nbsp;</li>\\\\n<li>Information that includes recommendations, suggestions, or consultations for the issuance of legislation or government decisions that have not yet been issued.&nbsp;</li>\\\\n<li>Scientific or technical research, or rights that contain an intellectual property that the disclosure of leads to an infringement of moral right.&nbsp;</li>\\\\n<li>Information related to bids and auctions that the disclosure of would lead to biased competition.</li>\\\\n<li>Information that is confidential or personal under another system requires specific legal procedures to access or obtain it.&nbsp;</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"41742057-a80e-40cb-a058-939d170f8a18\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fact\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The provisions of this policy do not apply to protected information: \\\",\\\"shortBrief\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Information that the disclosure of harms the state’s national security, policy, interests, or rights.</li>\\\\n<li>Military and security information.</li>\\\\n<li>Information and documents obtained by an agreement with another country and classified as protected.</li>\\\\n<li>Information that includes investigations, inspections, and surveillance related to a crime, violation, or threat.&nbsp;</li>\\\\n<li>Information that includes recommendations, suggestions, or consultations for the issuance of legislation or government decisions that have not yet been issued.&nbsp;</li>\\\\n<li>Scientific or technical research, or rights that contain an intellectual property that the disclosure of leads to an infringement of moral right.&nbsp;</li>\\\\n<li>Information related to bids and auctions that the disclosure of would lead to biased competition.</li>\\\\n<li>Information that is confidential or personal under another system requires specific legal procedures to access or obtain it.&nbsp;</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"icon\\\":[{\\\"key\\\":\\\"050e9500-9338-4066-8949-2993ed4733f7\\\",\\\"mediaKey\\\":\\\"a2d49abc-ef31-4423-9acb-c3065aae0986\\\"}]}]\"","change":"Update"},{"success":true,"name":"requestOpenDataSteps","path":"Property/requestOpenDataSteps","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/23b1d5d83f4444abb20b0cd87e97bf30\\\"},{\\\"contentUdi\\\":\\\"umb://element/898d075ae29a415abc2f2c4011ffa838\\\"},{\\\"contentUdi\\\":\\\"umb://element/1c6a6268c0ae4bb29a3cb343cdc0c777\\\"},{\\\"contentUdi\\\":\\\"umb://element/9e0b42130dd144da831595e5b4a50fdd\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/23b1d5d83f4444abb20b0cd87e97bf30\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يتم تقديم الطلبات عن طريق ملء نموذج إلكتروني وتقديمه للهيئة&nbsp;<a href=\\\\\\\\\\\\\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"طلب بيانات مفتوحة\\\\\\\\\\\\\\\">بالضغط هنا</a>.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"isTree\\\":\\\"0\\\",\\\"treeElements\\\":null},{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/898d075ae29a415abc2f2c4011ffa838\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"تقوم الهيئة، باستلام طلب الاطلاع أو الحصول على المعلومات العامة واتخاذ أحد القرارات التالية:\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"isTree\\\":\\\"0\\\",\\\"treeElements\\\":null},{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/1c6a6268c0ae4bb29a3cb343cdc0c777\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"isTree\\\":\\\"1\\\",\\\"treeElements\\\":\\\"{\\\\\\\"layout\\\\\\\":{\\\\\\\"Umbraco.BlockList\\\\\\\":[{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/94798691125849809e399293c9db07e6\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/8a66f1ceb8c24fb58792a21765a417f8\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/2210004827414642841f89ad476774fa\\\\\\\"}]},\\\\\\\"contentData\\\\\\\":[{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/94798691125849809e399293c9db07e6\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"الموافقة\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"في حال تمت موافقة الهيئة على طلب الوصول إلى المعلومات أو الحصول عليها\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"isTree\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"treeElements\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/8a66f1ceb8c24fb58792a21765a417f8\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"الرفض\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>في حال تم رفض طلب الوصول إلى المعلومات أو الحصول عليها، فيجب أن يكون الرفض خطياً أو إلكترونياً على أن يتضمن المعلومات التالية:</p>\\\\\\\\\\\\\\\\n<ul>\\\\\\\\\\\\\\\\n<li>تحديد ما إذا كان رفض الطلب كلياً أو جزئياً.</li>\\\\\\\\\\\\\\\\n<li>أسباب الرفض، إن أمكن.</li>\\\\\\\\\\\\\\\\n</ul>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"isTree\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"treeElements\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/2210004827414642841f89ad476774fa\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"الإشعار\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>في حال كانت المعلومات المطلوبة متاحه على موقع الهيئة، أو ليست من اختصاصها فيجب إشعار الفرد بذلك خطياً أو إلكترونياً.</p>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"isTree\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"treeElements\\\\\\\":null}],\\\\\\\"settingsData\\\\\\\":[]}\\\"},{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/9e0b42130dd144da831595e5b4a50fdd\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>في حالة رغبة الفرد في التظلّم على رفض الطلب من قبل الهيئة، فيمكنه تقديم إشعار خطي أو إلكتروني بالتظلم إلى مكتب إدارة البيانات في الهيئة خلال فترة زمنية لا تتجاوز (5) أيام عمل من استلامه لقرار الهيئة، ويقوم مكتب إدارة البيانات في الهيئة بمراجعة الطلب واتخاذ القرار المناسب.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"isTree\\\":\\\"0\\\",\\\"treeElements\\\":null}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"requestOpenDataSteps","path":"Property/requestOpenDataSteps","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/4f7fd3bccd064f4f9e3e66e1c2f56c0f\\\"},{\\\"contentUdi\\\":\\\"umb://element/0d082f2390324bb192282befd7ec25e2\\\"},{\\\"contentUdi\\\":\\\"umb://element/e30ee22884af45819223c8a278d2fd2c\\\"},{\\\"contentUdi\\\":\\\"umb://element/46aa104b536142848d6b8fa70cf80841\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/4f7fd3bccd064f4f9e3e66e1c2f56c0f\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>Applications must be submitted by filling out an electronic form and submitting it to the Authority by <strong><a href=\\\\\\\\\\\\\\\"/{localLink:umb://document/b1fc40d61fc045bcadaec399ee932318}\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"Open Data Request\\\\\\\\\\\\\\\">clicking here</a></strong></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"isTree\\\":\\\"0\\\",\\\"treeElements\\\":null},{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/0d082f2390324bb192282befd7ec25e2\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>The Authority receives the request to access or obtain public information and makes one of the following decisions:</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"isTree\\\":\\\"0\\\",\\\"treeElements\\\":null},{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/e30ee22884af45819223c8a278d2fd2c\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"isTree\\\":\\\"1\\\",\\\"treeElements\\\":\\\"{\\\\\\\"layout\\\\\\\":{\\\\\\\"Umbraco.BlockList\\\\\\\":[{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/2a2aeb6220dc4db7ae4c88ffb0052477\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/7de86f07733742fdbc0a8b7d796de463\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/1a1839cf0d9c471a94a3ec0c76e2b7d8\\\\\\\"}]},\\\\\\\"contentData\\\\\\\":[{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/2a2aeb6220dc4db7ae4c88ffb0052477\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Approval\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>If the Authority approves the request to access or obtain public information</p>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"isTree\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"treeElements\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/7de86f07733742fdbc0a8b7d796de463\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Rejection\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>If the Authority rejects the request to access or obtain public information, the rejection must be in writing or electronically and include the following information:&nbsp;</p>\\\\\\\\\\\\\\\\n<ul>\\\\\\\\\\\\\\\\n<li>Determine whether the application was rejected partially or fully.</li>\\\\\\\\\\\\\\\\n<li>If possible, state the reasons for the rejection.&nbsp;</li>\\\\\\\\\\\\\\\\n</ul>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"isTree\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"treeElements\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/1a1839cf0d9c471a94a3ec0c76e2b7d8\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Notification\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>If the required information is available on the Authority’s website or is not under its jurisdiction, the individual must be notified in writing or electronically</p>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"isTree\\\\\\\":\\\\\\\"0\\\\\\\",\\\\\\\"treeElements\\\\\\\":null}],\\\\\\\"settingsData\\\\\\\":[]}\\\"},{\\\"contentTypeKey\\\":\\\"5b417776-2caa-4d20-a88c-bf2e3a230ba0\\\",\\\"udi\\\":\\\"umb://element/46aa104b536142848d6b8fa70cf80841\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>In case the individual wishes to appeal the Authority’s rejection of the application, the appeal can be submitted, in writing or electronically, to the Data Management Office at the Authority within 5 business days of receiving the Authority’s decision. The Data Management Office at the Authority will review the request and make the appropriate decision</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"isTree\\\":\\\"0\\\",\\\"treeElements\\\":null}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"shortBrief","path":"Property/shortBrief","oldValue":"\"{\\\"markup\\\":\\\"<p>هناك حقيقة مثبتة منذ زمن طويل وهي أن المحتوى المقروء لصفحة ما سيلهي القارئ عن التركيز على الشكل الخارجي للنص أو شكل توضع الفقرات في الصفحة التي يقرأها.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","newValue":"null","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"}],"key":"45ba7877-2bde-4dd9-8d40-b226a6d934fb"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/b9cde657-cb4e-453c-99d1-8052b1dfa53c.config","name":"الأسئلة الشائعة","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"الأسئلة الشائعة\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"Frequently Asked Questions\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"الاسئلة\\\",\\n  \\\"الشائعة\\\",\\n  \\\"الاسئلة الشائعة\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"Rega\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"الأسئلة الشائعة\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"Frequently Asked Questions\"","change":"Update"},{"success":true,"name":"questions","path":"Property/questions","oldValue":"\"[{\\\"key\\\":\\\"3545da36-7acd-4e01-84d2-975fad1be94a\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي الهيئة العامة للعقار؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>تعتبر الهيئة العامة للعقار الجهة المُشرعة للقطاع العقاري والمُشرفة عليه ، والمسؤولة عن &nbsp;تنظيم النشاط العقاري غير الحكومي &nbsp;وتطويره ، وتشجيع الاستثمار إضافة إلى مسؤوليتها عن التسجيل العيني للعقارات في المملكة .&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"2087bd36-ce92-4be4-9acf-ec49e80e208d\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما دور الهيئة في القطاع العقاري؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>تعتبر الهيئة العامة للعقار هي الجهة المُشرعة للقطاع العقاري والمُشرفة عليه ، والمسؤولة عن &nbsp;تنظيم النشاط العقاري غير الحكومي &nbsp;وتطويره ، وتشجيع الاستثمار إضافة إلى مسؤوليتها عن التسجيل العيني للعقارات في المملكة .&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"b16926a9-a2b5-4990-8b40-d432cc5d1566\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام التسجيل العيني للعقار؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم ملكي رقم (م/91) وتاريخ 1443/9/19هـ، تشرف عليه الهيئة العامة للعقار، يجعل النظام العقار محورًا أساسيًا في عملية تسجيل الملكيات والتصرفات العقارية الأخرى المترتبة عليه، يتم بالتعاون مع ملاك العقارات بالمملكة أو من ينوب عنهم عبر المنصة الإلكترونية للسجل العقاري، ويهدف لبناء سجل متكامل للقطاع العقاري كأول خطوة تحولية تهدف لتحسين المشهد العقاري بالمملكة.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/0dc279a2be544b2795534e0e9c483617}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a> .</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"b49fdd4a-c340-44e1-98fd-77506ae951ad\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام الوساطة العقارية و ماهي الخدمات العقارية الخاضعة للنظام ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم مرسوم ملكي رقم (م/130) وتاريخ 1443/11/30هـ وتشرف عليه الهيئة العامة للعقار، ويهدف إلى تنظيم الوساطة العقارية والخدمات العقارية، وتسعى الهيئة من خلال النظام إلى تحسين السوق العقاري، وحماية المستفيدين، وضمان نزاهة الممارسين، مع تعزيز الثقة في السوق وتحفيز النشاط العقاري. ويشمل الوساطة العقارية نشاط الوساطة والتسويق والإعلانات العقارية، وتتضمن الخدمات الخاضعة للنظام الاستشارات والتحليلات العقارية والأنشطة المتعلقة بالعقار من إدارته وبيعه وبيع منفعته وتأجيره، ومن ذلك: إدارة الأملاك، وإدارة المرافق، والمزادات العقارية.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/92ba0fb329d549c2b99e522a10db9d05}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a> .</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"9a296cad-55b3-4335-9ee1-adaa860a3982\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي الأنشطة العقارية المتاحة للأفراد؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>وفق نظام الوساطة العقارية يتاح للأفراد ممارسة الأنشطة والخدمات التالية:<br>-الوساطة العقارية.<br>-التسويق العقاري.<br>الإعلان العقاري.<br>الاستشارات والتحليلات العقارية.<br>ويُشترط للترخيص لممارسة الوساطة العقارية أو الخدمات العقارية للأشخاص الطبيعيين (الأفراد) توافر الشروط التالية: <br>1-    بلوغ سن الـ (18) عامًا. <br>2-    أن يكون طالب الترخيص كامل الأهلية، غير محكومٍ عليه في جريمة مُخِلَّة بالشرف أو الأمانة ما لم يكن قد رُد إليه اعتباره.<br>3-    اجتياز البرنامج التأهيلي لكل نشاط.<br>4-    استيفاء المقابل المالي للترخيص باستثناء ترخيص ممارسة التسويق والإعلانات العقارية.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"الوساطة العقارية\\\\\\\">منصة الوساطة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"af6fccbe-d0a4-48f5-b973-901809b6c4d1\\\",\\\"name\\\":\\\"Item 6\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما هي رخصة فال للوساطة العقارية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>رخصة فال وثيقة رسمية  تخوّل الأفراد والمنشآت ممارسة النشاط العقاري المحدّد في الرخصة؛ حيث تخوّل رخصة فال للوساطة والتسويق العقاري الأفراد والمنشآت ممارسة أنشطة التوسّط في إتمام صفقة عقارية بين طرفيها مقابل عمولة،  والتسويق للعقار سواء عن طريق الوسائل الإعلانية أو التسويق المباشر في المكاتب والمعارض وغيرها ، أما رخصة فال لإدارة الأملاك فهي رخصة خاصة بالمُنشآت تخوّل المنشأة تولّي إدارة الشؤون المالية والإدارية للعقار نيابةً عن الغير ، وكذلك رخصة فال لإدارة المرافق فهي  رخصة خاصة بالمُنشآت تخوّل المنشأة تولي إدارة الشؤون الفنية للعقار نيابةً عن الغير ، إضافة إلى أنَّ رخصة فال لإدارة وتنظيم المزادات  تختص بالمُنشآت ، وهي رخصة تخوّل المنشأة تولّي مهام عرض العقارات لبيعها بالمزادات العلنية ، ويشمل المزادات العقارية الإلكترونية ، أما رخصة فال للاستشارات والتحليل العقاري فهي رخصة تخوّل المُنشآت والأفراد من تقديم التحليلات والاستشارات العقارية والرأي المتصل بالقطاع العقاري للعموم عبر أي وسيلة إعلامية أو لجهة مستفيدة من الخدمة. وترخيص فال للإعلان العقاري هو ترخيص لنشر الإعلانات المرئية والمسموعة والمقروءة والإلكترونية لغرض التصرف في العقار، سواء عن طريق التلفزيون أو الإذاعة أو الطرق أو الصحف المطبوعة أو في المنصات الإلكترونية أو في وسائل التواصل الاجتماعي وغيرها من الوسائل.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"الوساطة العقارية\\\\\\\">منصة الوساطة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"fb4abf48-a5ea-4403-82d0-d8052ee1e0e2\\\",\\\"name\\\":\\\"Item 7\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام المساهمات العقارية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم ملكي رقم (م/203) وتاريخ 1444/12/28هـ تشرف عليه الهيئة العامة للعقار، يهدف النظام إلى تعزيز ثقة المستثمرين في القطاع العقاري في المملكة من خلال ما تضمنَه من قواعد وأحكام تحفظ الحقوق لكافة الأطراف وسيقضي على ممارسة المساهمات العقارية العشوائية وغير النظامية، وحوكمة أعمال الرقابة والامتثال. كما أنَّ النظام سيتيح خلق فرص استثمارية واعدة للمُنشآت الصغيرة أو المتوسطة في السوق العقاري، ويوفر وعاء استثماري عقاري جديد وموثوق.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/0dc279a2be544b2795534e0e9c483617}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"c97e5331-54af-4ea7-a5a2-83cfc93e390e\\\",\\\"name\\\":\\\"Item 8\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام ملكية الوحدات العقارية وإدارتها وفرزها؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم ملكي رقم (440) بتاريخ 1441\\\\\\\\7\\\\\\\\1هـ ، وتشرف عليه الهيئة العامة للعقار، يعمل النظام على تنظيم علاقة الملاك فيما بينهم في إدارة شؤون العقار المشترك.و يهدف النظام إلى تحسين أداء القطاع العقاري وتنظيمه وحوكمة العلاقة بين جميع أطراف العلاقة في المجمعات السكنية والتجارية ذات الملكية المشتركة.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/0dc279a2be544b2795534e0e9c483617}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"134d1031-3053-415a-a850-7a636fe1a056\\\",\\\"name\\\":\\\"Item 9\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو المعهد العقاري السعودي، و ماذا يقدم؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>المعهد العقاري السعودي أول كيان تعليمي متخصص في مجال العلوم العقارية في المملكة،  يقدم خدمات متخصصة لتدريب العاملين في القطاع العقاري ،  ويمنح الشهادات المُمكّنة من دخول سوق العمل بكفاءة عالية و الحصول على تراخيص الأنشطة العقارية.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/e3b45b857b944ef48f448e49631c0413}\\\\\\\" title=\\\\\\\"المعهد العقاري السعودي\\\\\\\">منصة المعهد العقاري</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"7afb28ec-77de-4a17-8220-0f7f9d91f6b0\\\",\\\"name\\\":\\\"Item 10\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو المركز السعودي للتحكيم العقاري، و ماذا يقدم ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>أول مركز من نوعه في المملكة ودول الخليج يختص بتسوية او فض النزاعات العقارية، يقدم المركز خدمات التحكيم، والتوفيق، والصلح، وإيجاد الحلول السريعة للنزاعات والخلافات العقارية للمساهمة في تخفيف العبء عن المحاكم القضائية، ويُعد مرجع قانوني وجهة تحكيمية موثوقة للقطاع العقاري، و ينظر المركز في الفترة الحالية إلى القضايا الناشئة عن برنامجي ايجار واتحاد الملاك، تقدم جميع الخدمات بشكل إلكتروني.&nbsp;<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/2328a56286c94f49b7f6da063cb17a73}\\\\\\\" title=\\\\\\\"المركز السعودي للتحكيم العقاري\\\\\\\">منصة مركز التحكيم</a>.&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"5ad3e569-f458-413e-a764-4fed1c5ca1fd\\\",\\\"name\\\":\\\"Item 11\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو برنامج إيجار، و ماذا يقدم ؟ \\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>يقدم البرنامج مجموعة من الحلول الإلكترونية التي تسهم في تطوير قطاع الإيجار العقاري وتنظيمه وتيسير أعماله، بما يحقق التوازن في القطاع وتعزيز الثقة به، ويسهم في تحفيز الاستثمار فيه.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"إيجار\\\\\\\">منصة برنامج إيجار</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"62d54453-1a2f-4efd-a3cc-53deac8a72bb\\\",\\\"name\\\":\\\"Item 12\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"هل الالتزام ببنود عقد الإيجار  الموحد إلزامي أم اختياري؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>يحتوي العقد بنوداً إلزامية يتوجب الأخذ بها ، أما العمل بالعقد الموحد من قبل الوسطاء ، فهو إلزامي بناء على قرار مجلس الوزراء رقم 405 ، وتاريخ 22-9-1437.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"إيجار\\\\\\\">منصة برنامج إيجار</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"6baf8bcc-9d43-44c1-ba79-6cb2a4538d53\\\",\\\"name\\\":\\\"Item 13\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود ببرنامج مُلاَّك ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"pb-2\\\\\\\"><span><u> مُلاَّك</u> برنامج يُمكّن مُلّاك وشاغلي الوحدات العقارية ذات الملكية المشتركة من تأسيس جمعية مُلّاك؛ لتنظيم خدمات إدارة الممتلكات والمرافق، عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يسهم في حفظ الحقوق وحسن الانتفاع، ويعزز ثقافة التعايش المشترك.</span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"pb-2\\\\\\\"><span> للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة<a href=\\\\\\\"/{localLink:umb://document/d4441d6cab89476688eda77dc61d190b}\\\\\\\" title=\\\\\\\"مُلاَّك\\\\\\\"> منصة مُلاَّك</a> </span><span> .</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"937aedb6-e347-4967-aa00-9ba1fa1b1110\\\",\\\"name\\\":\\\"Item 14\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو برنامج فرز الوحدات العقارية، و ماذا يقدم؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>برنامج \\\\\\\"فرز الوحدات\\\\\\\" يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديدحقوق وواجبات كل وحدة في المجمعات العقارية لتعزيز العلاقات بين مُلاك الوحدات وتسهيل الإجراءات والخدمات اللازمة، والمحافظة على الأصول العقارية واستدامة القطاع، وتعزيز بيئة سكنية آمنة. <br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/7591a71f51f749cca16b496b8ea0e73e}\\\\\\\" title=\\\\\\\"فرز الوحدات العقارية\\\\\\\">منصة فرز</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"fe04affb-aee2-4dbf-9127-5434e3d172cb\\\",\\\"name\\\":\\\"Item 15\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو برنامج البيع أو التأجير على الخارطة \\\\\\\"وافي\\\\\\\"؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>\\\\\\\"وافي\\\\\\\" الجهة المخولة نظاماً بإصدار تراخيص مزاولة نشاط بيع الوحدات العقارية على الخارطة في المملكة العربية السعودية، وإصدار شهادات القيد في سجل المطورين العقاريين لشركات التطوير العقاري، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/6218a02f98954aeda87b65580ff81940}\\\\\\\" title=\\\\\\\"البيع أو التأجير على الخارطة &quot;وافي&quot;\\\\\\\">منصة وافي</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"83bedfb5-13c6-46d0-9324-b1b994fb9074\\\",\\\"name\\\":\\\"Item 16\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بلجنة معالجة أخطاء تسجيل الملكية ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>مُلكية\\\\\\\"\\\\\\\" لجنة مستقلة عن الجهات الحكومية تعمل بحيادية لمعالجة تعثرات المستفيدين من تسجيل الملكية العقارية لدى الجهات الحكومية. وتقوم اللجنة بأعمالها لدعم القطاع العقاري، ورفع تصنيف المملكة التنافسي في مؤشر تسجيل الملكية، وتستقبل اللجنة الاعتراضات المتعلقة بالملكية العقارية تجاه الجهات الحكومية والتي لم تقم الجهة الحكومية بعمل اللازم تجاهها بعد التقدم بطلب المعالجة، فيمكنك حينئذ تسجيل طلب اعتراض تبين فيه تفاصيل اعتراضك.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/263a8388873844afb16e71f091cf7f25}\\\\\\\" title=\\\\\\\"لجنة معالجة أخطاء تسجيل الملكية\\\\\\\">منصة ملكية</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"6ae2e973-dd83-407c-810d-c54c091d5eca\\\",\\\"name\\\":\\\"Item 17\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي بوابة العقار الجيومكانية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>بوابة العقار الجيومكانية\\\\\\\" هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الإهتمام (التعليمية، الدينية، الصحية، مرافق الضيافة) ومشاريع البيع على الخارطة (وافي) ومكاتب الوساطة والمكاتب الهندسية المعتمدة في فرز الوحدات العقارية والمناطق العقارية المعلنة للتسجيل العيني للعقار، بالإضافة إلى خدمة البحث والإستعلام عن البيانات المكانية.<br>للمزيد من المعلومات يرجى زيارة<a href=\\\\\\\"/{localLink:umb://document/e034c088303641679f55950534fa4164}\\\\\\\" title=\\\\\\\"بوابة العقار الجيومكانية\\\\\\\"> بوابة العقار الجيومكانية</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"4c4b02bc-dd75-452b-8bdf-c0451a54e6a2\\\",\\\"name\\\":\\\"Item 18\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي منصة المؤشرات العقارية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">صفحة رقمية مخصصة لعرض أرقام ونسب متعلقة بالسوق العقاري السعودي، تتيح للمستخدم تصور شامل للتوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة العربية السعودية، وتُساعد المهتمين على تحليل السوق واتخاذ قرارات أفضل، تسعى الهيئة العامة للعقار من خلال ذلك إلى تعزيز شفافية القطاع وتوفير معلومات دقيقة وفعّالة للمهتمين بالقطاع العقاري.<br>تتضمن المنصة: مؤشرات عقارية رقمية – خرائط تفاعلية<br>المؤشرات العقارية الرقمية: تحوي بيانات حول المبيعات والإيجارات للعقارات على مستوى المملكة والمناطق، والمدن، وعلى مستوى الأحياء (للمدن الرئيسية). تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة العربية السعودية، مع توفير بيانات محدثة حول المبيعات والإيجارات للعقارات، مع إمكانية مقارنة بين فترات زمنية مختلفة وبين مدن مختلفة؛ لاستخلاص تحليلًا متعمقًا حسب الفترة الزمنية المحددة وتشمل أنواعًا متنوعة من العقارات، مما يمكّن المهتمين من اتخاذ قرارات أفضل وأكثر توجيهًا من خلال توفير معلومات دقيقة وفعّالة للمستخدمين، تسهم في تعزيز شفافية السوق العقاري.<br>الخرائط التفاعلية: تقدم مؤشرات و بيانات إحصائية حول السوق العقاري في المملكة العربية السعودية. وتقدم للمستخدم تصور شامل عن التوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة، بالإضافة إلى توفر بيانات محدثة حول العمليات العقارية ( المؤشر البيعي –المؤشر الإيجاري) للعقارات. كما تتيح الصفحة إمكانية تحليل البيانات حسب فترات زمنية لكافة أنواع العقارات ، مما يوفر تصور شامل للسوق ويمكّن المهتمين والمستثمرين من اتخاذ قرارات أفضل. <br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"https://rei.rega.gov.sa/\\\\\\\">منصة المؤشرات العقارية</a></p>\\\\n<p style=\\\\\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"> </p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"3545da36-7acd-4e01-84d2-975fad1be94a\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي الهيئة العامة للعقار؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>تعتبر الهيئة العامة للعقار الجهة المُشرعة للقطاع العقاري والمُشرفة عليه ، والمسؤولة عن &nbsp;تنظيم النشاط العقاري غير الحكومي &nbsp;وتطويره ، وتشجيع الاستثمار إضافة إلى مسؤوليتها عن التسجيل العيني للعقارات في المملكة .&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"2087bd36-ce92-4be4-9acf-ec49e80e208d\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما دور الهيئة في القطاع العقاري؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>تعتبر الهيئة العامة للعقار هي الجهة المُشرعة للقطاع العقاري والمُشرفة عليه ، والمسؤولة عن &nbsp;تنظيم النشاط العقاري غير الحكومي &nbsp;وتطويره ، وتشجيع الاستثمار إضافة إلى مسؤوليتها عن التسجيل العيني للعقارات في المملكة .&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"b16926a9-a2b5-4990-8b40-d432cc5d1566\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام التسجيل العيني للعقار؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم ملكي رقم (م/91) وتاريخ 1443/9/19هـ، تشرف عليه الهيئة العامة للعقار، يجعل النظام العقار محورًا أساسيًا في عملية تسجيل الملكيات والتصرفات العقارية الأخرى المترتبة عليه، يتم بالتعاون مع ملاك العقارات بالمملكة أو من ينوب عنهم عبر المنصة الإلكترونية للسجل العقاري، ويهدف لبناء سجل متكامل للقطاع العقاري كأول خطوة تحولية تهدف لتحسين المشهد العقاري بالمملكة.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/92ba0fb329d549c2b99e522a10db9d05}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a> .</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"b49fdd4a-c340-44e1-98fd-77506ae951ad\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام الوساطة العقارية و ماهي الخدمات العقارية الخاضعة للنظام ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم مرسوم ملكي رقم (م/130) وتاريخ 1443/11/30هـ وتشرف عليه الهيئة العامة للعقار، ويهدف إلى تنظيم الوساطة العقارية والخدمات العقارية، وتسعى الهيئة من خلال النظام إلى تحسين السوق العقاري، وحماية المستفيدين، وضمان نزاهة الممارسين، مع تعزيز الثقة في السوق وتحفيز النشاط العقاري. ويشمل الوساطة العقارية نشاط الوساطة والتسويق والإعلانات العقارية، وتتضمن الخدمات الخاضعة للنظام الاستشارات والتحليلات العقارية والأنشطة المتعلقة بالعقار من إدارته وبيعه وبيع منفعته وتأجيره، ومن ذلك: إدارة الأملاك، وإدارة المرافق، والمزادات العقارية.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/92ba0fb329d549c2b99e522a10db9d05}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a> .</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"9a296cad-55b3-4335-9ee1-adaa860a3982\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي الأنشطة العقارية المتاحة للأفراد؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>وفق نظام الوساطة العقارية يتاح للأفراد ممارسة الأنشطة والخدمات التالية:<br>-الوساطة العقارية.<br>-التسويق العقاري.<br>الإعلان العقاري.<br>الاستشارات والتحليلات العقارية.<br>ويُشترط للترخيص لممارسة الوساطة العقارية أو الخدمات العقارية للأشخاص الطبيعيين (الأفراد) توافر الشروط التالية: <br>1-    بلوغ سن الـ (18) عامًا. <br>2-    أن يكون طالب الترخيص كامل الأهلية، غير محكومٍ عليه في جريمة مُخِلَّة بالشرف أو الأمانة ما لم يكن قد رُد إليه اعتباره.<br>3-    اجتياز البرنامج التأهيلي لكل نشاط.<br>4-    استيفاء المقابل المالي للترخيص باستثناء ترخيص ممارسة التسويق والإعلانات العقارية.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"الوساطة العقارية\\\\\\\">منصة الوساطة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"af6fccbe-d0a4-48f5-b973-901809b6c4d1\\\",\\\"name\\\":\\\"Item 6\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما هي رخصة فال للوساطة العقارية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>رخصة فال وثيقة رسمية  تخوّل الأفراد والمنشآت ممارسة النشاط العقاري المحدّد في الرخصة؛ حيث تخوّل رخصة فال للوساطة والتسويق العقاري الأفراد والمنشآت ممارسة أنشطة التوسّط في إتمام صفقة عقارية بين طرفيها مقابل عمولة،  والتسويق للعقار سواء عن طريق الوسائل الإعلانية أو التسويق المباشر في المكاتب والمعارض وغيرها ، أما رخصة فال لإدارة الأملاك فهي رخصة خاصة بالمُنشآت تخوّل المنشأة تولّي إدارة الشؤون المالية والإدارية للعقار نيابةً عن الغير ، وكذلك رخصة فال لإدارة المرافق فهي  رخصة خاصة بالمُنشآت تخوّل المنشأة تولي إدارة الشؤون الفنية للعقار نيابةً عن الغير ، إضافة إلى أنَّ رخصة فال لإدارة وتنظيم المزادات  تختص بالمُنشآت ، وهي رخصة تخوّل المنشأة تولّي مهام عرض العقارات لبيعها بالمزادات العلنية ، ويشمل المزادات العقارية الإلكترونية ، أما رخصة فال للاستشارات والتحليل العقاري فهي رخصة تخوّل المُنشآت والأفراد من تقديم التحليلات والاستشارات العقارية والرأي المتصل بالقطاع العقاري للعموم عبر أي وسيلة إعلامية أو لجهة مستفيدة من الخدمة. وترخيص فال للإعلان العقاري هو ترخيص لنشر الإعلانات المرئية والمسموعة والمقروءة والإلكترونية لغرض التصرف في العقار، سواء عن طريق التلفزيون أو الإذاعة أو الطرق أو الصحف المطبوعة أو في المنصات الإلكترونية أو في وسائل التواصل الاجتماعي وغيرها من الوسائل.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/919833c56fef41d8a738e5a276acb43e}\\\\\\\" title=\\\\\\\"الوساطة العقارية\\\\\\\">منصة الوساطة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"fb4abf48-a5ea-4403-82d0-d8052ee1e0e2\\\",\\\"name\\\":\\\"Item 7\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام المساهمات العقارية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم ملكي رقم (م/203) وتاريخ 1444/12/28هـ تشرف عليه الهيئة العامة للعقار، يهدف النظام إلى تعزيز ثقة المستثمرين في القطاع العقاري في المملكة من خلال ما تضمنَه من قواعد وأحكام تحفظ الحقوق لكافة الأطراف وسيقضي على ممارسة المساهمات العقارية العشوائية وغير النظامية، وحوكمة أعمال الرقابة والامتثال. كما أنَّ النظام سيتيح خلق فرص استثمارية واعدة للمُنشآت الصغيرة أو المتوسطة في السوق العقاري، ويوفر وعاء استثماري عقاري جديد وموثوق.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/0dc279a2be544b2795534e0e9c483617}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"c97e5331-54af-4ea7-a5a2-83cfc93e390e\\\",\\\"name\\\":\\\"Item 8\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بنظام ملكية الوحدات العقارية وإدارتها وفرزها؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>نظام صادر بمرسوم ملكي رقم (440) بتاريخ 1441\\\\\\\\7\\\\\\\\1هـ ، وتشرف عليه الهيئة العامة للعقار، يعمل النظام على تنظيم علاقة الملاك فيما بينهم في إدارة شؤون العقار المشترك.و يهدف النظام إلى تحسين أداء القطاع العقاري وتنظيمه وحوكمة العلاقة بين جميع أطراف العلاقة في المجمعات السكنية والتجارية ذات الملكية المشتركة.<br>للمزيد من المعلومات يرجى زيارة صفحة <a href=\\\\\\\"/{localLink:umb://document/92ba0fb329d549c2b99e522a10db9d05}\\\\\\\" title=\\\\\\\"الأنظمة واللوائح والأدلة\\\\\\\">الأنظمة واللوائح والأدلة</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"134d1031-3053-415a-a850-7a636fe1a056\\\",\\\"name\\\":\\\"Item 9\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو المعهد العقاري السعودي، و ماذا يقدم؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>المعهد العقاري السعودي أول كيان تعليمي متخصص في مجال العلوم العقارية في المملكة،  يقدم خدمات متخصصة لتدريب العاملين في القطاع العقاري ،  ويمنح الشهادات المُمكّنة من دخول سوق العمل بكفاءة عالية و الحصول على تراخيص الأنشطة العقارية.<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/e3b45b857b944ef48f448e49631c0413}\\\\\\\" title=\\\\\\\"المعهد العقاري السعودي\\\\\\\">منصة المعهد العقاري</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"7afb28ec-77de-4a17-8220-0f7f9d91f6b0\\\",\\\"name\\\":\\\"Item 10\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو المركز السعودي للتحكيم العقاري، و ماذا يقدم ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>أول مركز من نوعه في المملكة ودول الخليج يختص بتسوية او فض النزاعات العقارية، يقدم المركز خدمات التحكيم، والتوفيق، والصلح، وإيجاد الحلول السريعة للنزاعات والخلافات العقارية للمساهمة في تخفيف العبء عن المحاكم القضائية، ويُعد مرجع قانوني وجهة تحكيمية موثوقة للقطاع العقاري، و ينظر المركز في الفترة الحالية إلى القضايا الناشئة عن برنامجي ايجار واتحاد الملاك، تقدم جميع الخدمات بشكل إلكتروني.&nbsp;<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"/{localLink:umb://document/2328a56286c94f49b7f6da063cb17a73}\\\\\\\" title=\\\\\\\"المركز السعودي للتحكيم العقاري\\\\\\\">منصة مركز التحكيم</a>.&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"5ad3e569-f458-413e-a764-4fed1c5ca1fd\\\",\\\"name\\\":\\\"Item 11\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو برنامج إيجار، و ماذا يقدم ؟ \\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>يقدم البرنامج مجموعة من الحلول الإلكترونية التي تسهم في تطوير قطاع الإيجار العقاري وتنظيمه وتيسير أعماله، بما يحقق التوازن في القطاع وتعزيز الثقة به، ويسهم في تحفيز الاستثمار فيه.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"إيجار\\\\\\\">منصة برنامج إيجار</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"62d54453-1a2f-4efd-a3cc-53deac8a72bb\\\",\\\"name\\\":\\\"Item 12\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"هل الالتزام ببنود عقد الإيجار  الموحد إلزامي أم اختياري؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>يحتوي العقد بنوداً إلزامية يتوجب الأخذ بها ، أما العمل بالعقد الموحد من قبل الوسطاء ، فهو إلزامي بناء على قرار مجلس الوزراء رقم 405 ، وتاريخ 22-9-1437.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/59071c624f3a4e53978468963286266a}\\\\\\\" title=\\\\\\\"إيجار\\\\\\\">منصة برنامج إيجار</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"6baf8bcc-9d43-44c1-ba79-6cb2a4538d53\\\",\\\"name\\\":\\\"Item 13\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود ببرنامج مُلاَّك ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"pb-2\\\\\\\"><span><u> مُلاَّك</u> برنامج يُمكّن مُلّاك وشاغلي الوحدات العقارية ذات الملكية المشتركة من تأسيس جمعية مُلّاك؛ لتنظيم خدمات إدارة الممتلكات والمرافق، عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يسهم في حفظ الحقوق وحسن الانتفاع، ويعزز ثقافة التعايش المشترك.</span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"pb-2\\\\\\\"><span> للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة<a href=\\\\\\\"/{localLink:umb://document/d4441d6cab89476688eda77dc61d190b}\\\\\\\" title=\\\\\\\"مُلاَّك\\\\\\\"> منصة مُلاَّك</a> </span><span> .</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"937aedb6-e347-4967-aa00-9ba1fa1b1110\\\",\\\"name\\\":\\\"Item 14\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو برنامج فرز الوحدات العقارية، و ماذا يقدم؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>برنامج \\\\\\\"فرز الوحدات\\\\\\\" يُنظم آلية فرز الوحدات العقارية بشكل تقني وقانوني عبر (نظام ملكية الوحدات العقارية وفرزها وإدارتها) بما يُساهم في تحديدحقوق وواجبات كل وحدة في المجمعات العقارية لتعزيز العلاقات بين مُلاك الوحدات وتسهيل الإجراءات والخدمات اللازمة، والمحافظة على الأصول العقارية واستدامة القطاع، وتعزيز بيئة سكنية آمنة. <br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/7591a71f51f749cca16b496b8ea0e73e}\\\\\\\" title=\\\\\\\"فرز الوحدات العقارية\\\\\\\">منصة فرز</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"fe04affb-aee2-4dbf-9127-5434e3d172cb\\\",\\\"name\\\":\\\"Item 15\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهو برنامج البيع أو التأجير على الخارطة \\\\\\\"وافي\\\\\\\"؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>\\\\\\\"وافي\\\\\\\" الجهة المخولة نظاماً بإصدار تراخيص مزاولة نشاط بيع الوحدات العقارية على الخارطة في المملكة العربية السعودية، وإصدار شهادات القيد في سجل المطورين العقاريين لشركات التطوير العقاري، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/6218a02f98954aeda87b65580ff81940}\\\\\\\" title=\\\\\\\"البيع أو التأجير على الخارطة &quot;وافي&quot;\\\\\\\">منصة وافي</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"83bedfb5-13c6-46d0-9324-b1b994fb9074\\\",\\\"name\\\":\\\"Item 16\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ما المقصود بلجنة معالجة أخطاء تسجيل الملكية ؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>مُلكية\\\\\\\"\\\\\\\" لجنة مستقلة عن الجهات الحكومية تعمل بحيادية لمعالجة تعثرات المستفيدين من تسجيل الملكية العقارية لدى الجهات الحكومية. وتقوم اللجنة بأعمالها لدعم القطاع العقاري، ورفع تصنيف المملكة التنافسي في مؤشر تسجيل الملكية، وتستقبل اللجنة الاعتراضات المتعلقة بالملكية العقارية تجاه الجهات الحكومية والتي لم تقم الجهة الحكومية بعمل اللازم تجاهها بعد التقدم بطلب المعالجة، فيمكنك حينئذ تسجيل طلب اعتراض تبين فيه تفاصيل اعتراضك.<br>للمزيد من المعلومات يمكن الاتصال على 199002 أو زيارة <a href=\\\\\\\"/{localLink:umb://document/263a8388873844afb16e71f091cf7f25}\\\\\\\" title=\\\\\\\"لجنة معالجة أخطاء تسجيل الملكية\\\\\\\">منصة ملكية</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"6ae2e973-dd83-407c-810d-c54c091d5eca\\\",\\\"name\\\":\\\"Item 17\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي بوابة العقار الجيومكانية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p>بوابة العقار الجيومكانية\\\\\\\" هي بوابة الكترونية لعرض البيانات المكانية والوصفية التي تهم القطاع العقاري عبر مجموعة من الخرائط التفاعلية وتشمل بيانات المناطق والمدن والأحياء وقطع الأراضي ونقاط الإهتمام (التعليمية، الدينية، الصحية، مرافق الضيافة) ومشاريع البيع على الخارطة (وافي) ومكاتب الوساطة والمكاتب الهندسية المعتمدة في فرز الوحدات العقارية والمناطق العقارية المعلنة للتسجيل العيني للعقار، بالإضافة إلى خدمة البحث والإستعلام عن البيانات المكانية.<br>للمزيد من المعلومات يرجى زيارة<a href=\\\\\\\"/{localLink:umb://document/e034c088303641679f55950534fa4164}\\\\\\\" title=\\\\\\\"بوابة العقار الجيومكانية\\\\\\\"> بوابة العقار الجيومكانية</a>.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}},{\\\"key\\\":\\\"4c4b02bc-dd75-452b-8bdf-c0451a54e6a2\\\",\\\"name\\\":\\\"Item 18\\\",\\\"ncContentTypeAlias\\\":\\\"fAQ\\\",\\\"PropType\\\":null,\\\"question\\\":\\\"ماهي منصة المؤشرات العقارية؟\\\",\\\"answer\\\":{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">صفحة رقمية مخصصة لعرض أرقام ونسب متعلقة بالسوق العقاري السعودي، تتيح للمستخدم تصور شامل للتوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة العربية السعودية، وتُساعد المهتمين على تحليل السوق واتخاذ قرارات أفضل، تسعى الهيئة العامة للعقار من خلال ذلك إلى تعزيز شفافية القطاع وتوفير معلومات دقيقة وفعّالة للمهتمين بالقطاع العقاري.<br>تتضمن المنصة: مؤشرات عقارية رقمية – خرائط تفاعلية<br>المؤشرات العقارية الرقمية: تحوي بيانات حول المبيعات والإيجارات للعقارات على مستوى المملكة والمناطق، والمدن، وعلى مستوى الأحياء (للمدن الرئيسية). تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة العربية السعودية، مع توفير بيانات محدثة حول المبيعات والإيجارات للعقارات، مع إمكانية مقارنة بين فترات زمنية مختلفة وبين مدن مختلفة؛ لاستخلاص تحليلًا متعمقًا حسب الفترة الزمنية المحددة وتشمل أنواعًا متنوعة من العقارات، مما يمكّن المهتمين من اتخاذ قرارات أفضل وأكثر توجيهًا من خلال توفير معلومات دقيقة وفعّالة للمستخدمين، تسهم في تعزيز شفافية السوق العقاري.<br>الخرائط التفاعلية: تقدم مؤشرات و بيانات إحصائية حول السوق العقاري في المملكة العربية السعودية. وتقدم للمستخدم تصور شامل عن التوزيع الجغرافي للعقارات والأحياء في جميع أنحاء المملكة، بالإضافة إلى توفر بيانات محدثة حول العمليات العقارية ( المؤشر البيعي –المؤشر الإيجاري) للعقارات. كما تتيح الصفحة إمكانية تحليل البيانات حسب فترات زمنية لكافة أنواع العقارات ، مما يوفر تصور شامل للسوق ويمكّن المهتمين والمستثمرين من اتخاذ قرارات أفضل.&nbsp;<br>للمزيد من المعلومات يرجى زيارة <a href=\\\\\\\"https://rei.rega.gov.sa/\\\\\\\">منصة المؤشرات العقارية</a></p>\\\\n<p style=\\\\\\\"text-align: right; line-height: 200%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"الأسئلة الشائعة\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"Frequently Asked Questions\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"4","newValue":"2","change":"Update"}],"key":"b9cde657-cb4e-453c-99d1-8052b1dfa53c"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/440be0a5-06d1-45bf-b017-3a61d897131b.config","name":"المؤشرات العقارية","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1248","change":"Update"},{"success":true,"name":"buttonText","path":"Property/buttonText","oldValue":"\"الانتقال الى الخدمة\"","newValue":"\"بدء الخدمة\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"تقدم صفحة المؤشرات العقارية الرقمية بيانات حول المبيعات والإيجارات على مستوى المملكة، والمدن، وعلى مستوى المدن والأحياء (للمدن الرئيسية)، كما تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات في أنحاء المملكة،\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"The digital Real Estate Indicators page gives you data on sales and leases at different levels, like the whole Kingdom, cities, and even neighborhoods in major cities\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"المؤشرات العقارية\\\",\\n  \\\"المؤشرات\\\",\\n  \\\"العقارية\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"الخدمات الالكترونية\\\",\\n  \\\"Rega\\\",\\n  \\\"المبيعات\\\",\\n  \\\"الايجارات\\\",\\n  \\\"ايجار\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"\"Real estate indicators\"","newValue":"\"المؤشرات العقارية\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"Real Estate Indicators\"","change":"Update"},{"success":true,"name":"serviceFeature","path":"Property/serviceFeature","oldValue":"\"[{\\\"key\\\":\\\"179ad027-8f75-46e7-b85b-a3584e3d2d31\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"عن الخدمة\\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>تقدم صفحة المؤشرات العقارية الرقمية بيانات حول المبيعات والإيجارات على مستوى المملكة، والمدن، وعلى مستوى المدن والأحياء (للمدن الرئيسية)، كما تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات في أنحاء المملكة، مع توفير بيانات محدثة حول المبيعات والإيجارات للعقارات، مع إمكانية إجراء مقارنة بين فترات زمنية مختلفة وبين مدن مختلفة؛ لاستخلاص تحليل متعمق حسب الفترة الزمنية المحددة وتشمل أنواع متنوعة من العقارات، مما يمكّن المهتمين باتخاذ قرارات أفضل وأكثر توجيهًا من خلال توفير معلومات دقيقة وفعّالة للمستخدمين، تسهم في تعزيز شفافية السوق العقاري.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"179ad027-8f75-46e7-b85b-a3584e3d2d31\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"عن الخدمة\\\",\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>تقدم صفحة المؤشرات العقارية الرقمية بيانات حول المبيعات والإيجارات على مستوى المملكة، والمدن، وعلى مستوى المدن والأحياء (للمدن الرئيسية)، كما تتيح للمستخدم تصورًا شاملاً للتوزيع الجغرافي للعقارات في أنحاء المملكة، مع توفير بيانات محدثة حول المبيعات والإيجارات للعقارات، مع إمكانية إجراء مقارنة بين فترات زمنية مختلفة وبين مدن مختلفة؛ لاستخلاص تحليل متعمق حسب الفترة الزمنية المحددة وتشمل أنواع متنوعة من العقارات، مما يمكّن المهتمين باتخاذ قرارات أفضل وأكثر توجيهًا من خلال توفير معلومات دقيقة وفعّالة للمستخدمين، تسهم في تعزيز شفافية السوق العقاري.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"serviceFeature","path":"Property/serviceFeature","oldValue":"\"[{\\\"key\\\":\\\"4d531159-1ccc-4820-8db8-c8eae202dfc2\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"About the Service \\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>The digital Real Estate Indicators page gives you data on sales and leases at different levels, like the whole Kingdom, cities, and even neighborhoods in major cities. You can also see a visual representation of how real estate is distributed across the Kingdom. It provides up-to-date information on sales and leases, allowing you to compare different periods and cities for a detailed analysis. This helps you make informed decisions based on accurate and reliable information, promoting transparency in the real estate market.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"4d531159-1ccc-4820-8db8-c8eae202dfc2\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"About the Service \\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>The digital Real Estate Indicators page gives you data on sales and leases at different levels, like the whole Kingdom, cities, and even neighborhoods in major cities. You can also see a visual representation of how real estate is distributed across the Kingdom. It provides up-to-date information on sales and leases, allowing you to compare different periods and cities for a detailed analysis. This helps you make informed decisions based on accurate and reliable information, promoting transparency in the real estate market.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"support","path":"Property/support","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/fe271edc160e463f8cf3f604328fd8d8\\\"},{\\\"contentUdi\\\":\\\"umb://element/dd1dd85bf9e44283a38c7dc960ffb8fc\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\\\",\\\"udi\\\":\\\"umb://element/dd1dd85bf9e44283a38c7dc960ffb8fc\\\",\\\"title\\\":null,\\\"items\\\":\\\"{\\\\\\\"layout\\\\\\\":{\\\\\\\"Umbraco.BlockList\\\\\\\":[{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/3d868ea35f1443108dc0eb57fc4203a4\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/c40da6a7af6a4e72ab4cdab437bd4ae1\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/5f15b41d0cd447e6bb9cf8cb577228c8\\\\\\\"}]},\\\\\\\"contentData\\\\\\\":[{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/c40da6a7af6a4e72ab4cdab437bd4ae1\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Email\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":null,\\\\\\\"text\\\\\\\":null,\\\\\\\"icon\\\\\\\":null,\\\\\\\"link\\\\\\\":null,\\\\\\\"items\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":\\\\\\\"1\\\\\\\"},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/5f15b41d0cd447e6bb9cf8cb577228c8\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Phone\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":null,\\\\\\\"text\\\\\\\":null,\\\\\\\"icon\\\\\\\":null,\\\\\\\"link\\\\\\\":null,\\\\\\\"items\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":\\\\\\\"1\\\\\\\"},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/3d868ea35f1443108dc0eb57fc4203a4\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Website\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Frequently Asked Questions\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"FAQ's page\\\\\\\",\\\\\\\"link\\\\\\\":\\\\\\\"https://dev-rega.rega.gov.sa/المكتبة/الأسئلة-الشائعة/\\\\\\\",\\\\\\\"icon\\\\\\\":null,\\\\\\\"items\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":\\\\\\\"1\\\\\\\"}],\\\\\\\"settingsData\\\\\\\":[]}\\\"},{\\\"contentTypeKey\\\":\\\"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\\\",\\\"udi\\\":\\\"umb://element/fe271edc160e463f8cf3f604328fd8d8\\\",\\\"title\\\":null,\\\"items\\\":\\\"{\\\\\\\"layout\\\\\\\":{\\\\\\\"Umbraco.BlockList\\\\\\\":[{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/e66018c7758445999108990da92a5e9d\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/147e144908f140da97b26b8788f9b8d4\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/1b91c2aef08443b68c9d1b864665ccc5\\\\\\\"}]},\\\\\\\"contentData\\\\\\\":[{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/e66018c7758445999108990da92a5e9d\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Other\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Target Audience\\\\\\\",\\\\\\\"text\\\\\\\":null,\\\\\\\"icon\\\\\\\":\\\\\\\"umb://media/feb8701eeb0f48eb85d8501d4c57976a\\\\\\\",\\\\\\\"items\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Individuals\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Property Owner\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Public\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"Real Estate Beneficiary\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"link\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/147e144908f140da97b26b8788f9b8d4\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Other\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Service Type\\\\\\\",\\\\\\\"text\\\\\\\":null,\\\\\\\"icon\\\\\\\":\\\\\\\"umb://media/a5c812c6c448431aab14c0fc6699a6b5\\\\\\\",\\\\\\\"items\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Inquiry services\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"link\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/1b91c2aef08443b68c9d1b864665ccc5\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Other\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Beneficiary service\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"Service channels\\\\\\\",\\\\\\\"link\\\\\\\":null,\\\\\\\"icon\\\\\\\":\\\\\\\"umb://media/ca2c1ae6f86049dab9448ce572f3663c\\\\\\\",\\\\\\\"items\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":\\\\\\\"0\\\\\\\"}],\\\\\\\"settingsData\\\\\\\":[]}\\\"}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"المؤشرات العقارية\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"Real Estate Indicators\"","change":"Update"}],"key":"440be0a5-06d1-45bf-b017-3a61d897131b"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/cf93d97c-c408-4830-a4b8-c0d0d1a1cdcc.config","name":"الشروط والأحكام و سياسة الإستخدام","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"bottomSectionBoxes","path":"Property/bottomSectionBoxes","oldValue":"\"[{\\\"key\\\":\\\"de966731-3a2d-4e18-b884-92d1b7e1842b\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"تقوم الهيئة بجمع ومعالجة البيانات الشخصية التالية:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>الاسم.</li>\\\\n<li>معلومات التواصل كرقم الهاتف والبريد الإلكتروني ونحوها.</li>\\\\n<li>البيانات التقنية مثل (عنوان بروتوكولات الإنترنت IP وملفات تعريف الارتباط أو بيانات تقنية مرتبطة بخدمةٍ أو نظام معين).</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"eee7972e-7dbe-411e-a162-421829ec387e\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"استخدام البيانات الشخصية\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>عند استخدامنا لملفات تعريف الارتباط في موقعنا الإلكتروني نحتفظ أحياناً على حاسوبك أو أجهزتك الأخرى ببعض الملفات الصغيرة التي تُعرف بملفات تعريف الارتباط، فنجمع إحصائيات الإنترنت حول زيارتك لموقعنا بناءً على عنوان برتوكولات الإنترنت IP في جهازك. ونستخدم هذه البيانات لتحسين تجربتك في استخدام موقعنا الإلكتروني.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"6d950ea1-e350-4f2f-b30f-a0cb472a0a84\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"مشاركة البيانات الشخصية\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>يتم مشاركة البيانات الشخصية بعد موافقة صاحب البيانات لأغراض مشروعة أو كانت مطلوبة لأغراض أمنية أو لتنفيذ نظام آخر أو لاستيفاء مُتطلبات قضائية، كما تبذل الهيئة جهدها لحماية المعلومات التي يقدمها المستخدم وفق أفضل الممارسات، وتعمل على تشفير المعلومات والبيانات الحساسة التي يتعين الحفاظ على سريتها بالتوافق مع المتطلبات النظامية وفق الأنظمة السارية في المملكة.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"58bfae50-ca1e-4aca-bc89-692eb36ff0d0\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"يتم الاستفادة من جمع المعلومات الشخصية للعديد من الأغراض منها: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>تمكين وتقديم خدمات الهيئة واستيفاء متطلباتها.</li>\\\\n<li>الاستجابة لاستفسارات المستفيدين من خدمات الهيئة مع تطوير وتحسين تجربة المستفيد وضمان استمرارية تقديم الخدمات بالجودة المطلوبة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"ee43b4dd-522c-4161-849f-e4cac8c71d4f\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"الأساس النظامي لجمع ومعالجة البيانات الشخصية وفقاً لسياسة حماية البيانات الشخصية الصادرة من مكتب إدارة البيانات الوطنية، لذا فإن الأساس النظامي الذي نعتمد عليه لمعالجة هذه البيانات هو:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>موافقتك الصريحة او الضمنية، ويمكنك التراجع عن الموافقة في أي وقت ما عدا بعض الاستثناءات الموضحة أعلاه وللقيام بذلك يمكنك التواصل معنا عبر البريد الإلكتروني الموضح في بيانات التواصل.</li>\\\\n<li>تحقيق المصلحة العامة: من خلال تسهيل وتحسين الإجراءات.</li>\\\\n<li>يتم تخزين بياناتك الشخصية بشكل آمن وذلك في الهيئة العامة للعقار أو من خلال حلول آمنة في خدمات الحوسبة السحابية الالتزام بمتطلبات الهيئة الوطنية للأمن السيبراني في ذلك.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"0f99a2c7-97d7-4766-a627-9799cfe0fdd2\\\",\\\"name\\\":\\\"Item 6\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"حقوقك فيما يتعلق بمعالجة البيانات الشخصية:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>الحق في الوصول إلى بياناتك الشخصية: وذلك بطلب نسخة من بياناتك الشخصية عبر البريد الإلكتروني الموضح في بيانات التواصل.</li>\\\\n<li>الحق في تصحيح بياناتك الشخصية: وذلك بطلب تصحيح بياناتك الشخصية التي ترى أنها غير دقيقة أو غير صحيحة أو غير مكتملة وذلك عبر البريد الإلكتروني الموضح في بيانات التواصل ادناه، وسيتم مراجعتها وتحديثها واشعارك بذلك عن طريق [معلومات التواصل الخاصة بك].</li>\\\\n<li>الحق في إتلاف بياناتك الشخصية: وذلك بطلب مسح بياناتك الشخصية في ظروف معينة بما لا يتعارض مع الأسس النظامية والمصالح المشروعة.</li>\\\\n<li>الحق في تقييد المعالجة: وذلك بطلب تقييد معالجة بياناتك الشخصية في ظروف معينة ولفترة زمنية محددة.</li>\\\\n<li>الحق في الاعتراض على المعالجة: وذلك بالاعتراض على معالجة بياناتك الشخصية.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]}]\"","newValue":"\"[{\\\"key\\\":\\\"de966731-3a2d-4e18-b884-92d1b7e1842b\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"تقوم الهيئة بجمع ومعالجة البيانات الشخصية التالية:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>الاسم.</li>\\\\n<li>معلومات التواصل كرقم الهاتف والبريد الإلكتروني ونحوها.</li>\\\\n<li>البيانات التقنية مثل (عنوان بروتوكولات الإنترنت IP وملفات تعريف الارتباط أو بيانات تقنية مرتبطة بخدمةٍ أو نظام معين).</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"76a9e88c-2cba-44f0-908b-184fd1a0ac8e\\\",\\\"mediaKey\\\":\\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"}]},{\\\"key\\\":\\\"eee7972e-7dbe-411e-a162-421829ec387e\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"استخدام البيانات الشخصية\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>عند استخدامنا لملفات تعريف الارتباط في موقعنا الإلكتروني نحتفظ أحياناً على حاسوبك أو أجهزتك الأخرى ببعض الملفات الصغيرة التي تُعرف بملفات تعريف الارتباط، فنجمع إحصائيات الإنترنت حول زيارتك لموقعنا بناءً على عنوان برتوكولات الإنترنت IP في جهازك. ونستخدم هذه البيانات لتحسين تجربتك في استخدام موقعنا الإلكتروني.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"97d3a45f-f2d1-40bc-be8d-5ba871983128\\\",\\\"mediaKey\\\":\\\"4f94001c-b0ef-4439-9310-38c6f1a8c5fe\\\"}]},{\\\"key\\\":\\\"6d950ea1-e350-4f2f-b30f-a0cb472a0a84\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"مشاركة البيانات الشخصية\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>يتم مشاركة البيانات الشخصية بعد موافقة صاحب البيانات لأغراض مشروعة أو كانت مطلوبة لأغراض أمنية أو لتنفيذ نظام آخر أو لاستيفاء مُتطلبات قضائية، كما تبذل الهيئة جهدها لحماية المعلومات التي يقدمها المستخدم وفق أفضل الممارسات، وتعمل على تشفير المعلومات والبيانات الحساسة التي يتعين الحفاظ على سريتها بالتوافق مع المتطلبات النظامية وفق الأنظمة السارية في المملكة.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"b5accd36-af51-4e8e-9793-9ec3bf012bde\\\",\\\"mediaKey\\\":\\\"338b15b4-287a-4c9b-a995-b310048b4c6f\\\"}]},{\\\"key\\\":\\\"58bfae50-ca1e-4aca-bc89-692eb36ff0d0\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"يتم الاستفادة من جمع المعلومات الشخصية للعديد من الأغراض منها: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>تمكين وتقديم خدمات الهيئة واستيفاء متطلباتها.</li>\\\\n<li>الاستجابة لاستفسارات المستفيدين من خدمات الهيئة مع تطوير وتحسين تجربة المستفيد وضمان استمرارية تقديم الخدمات بالجودة المطلوبة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"05e98703-6676-48ef-8f85-6d45f508242a\\\",\\\"mediaKey\\\":\\\"41177547-ecef-406a-b9db-c339416da5e2\\\"}]},{\\\"key\\\":\\\"ee43b4dd-522c-4161-849f-e4cac8c71d4f\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"الأساس النظامي لجمع ومعالجة البيانات الشخصية وفقاً لسياسة حماية البيانات الشخصية الصادرة من مكتب إدارة البيانات الوطنية، لذا فإن الأساس النظامي الذي نعتمد عليه لمعالجة هذه البيانات هو:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>موافقتك الصريحة او الضمنية، ويمكنك التراجع عن الموافقة في أي وقت ما عدا بعض الاستثناءات الموضحة أعلاه وللقيام بذلك يمكنك التواصل معنا عبر البريد الإلكتروني الموضح في بيانات التواصل.</li>\\\\n<li>تحقيق المصلحة العامة: من خلال تسهيل وتحسين الإجراءات.</li>\\\\n<li>يتم تخزين بياناتك الشخصية بشكل آمن وذلك في الهيئة العامة للعقار أو من خلال حلول آمنة في خدمات الحوسبة السحابية الالتزام بمتطلبات الهيئة الوطنية للأمن السيبراني في ذلك.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"8927abbe-444e-4173-b5b7-c4781fd1ebe3\\\",\\\"mediaKey\\\":\\\"41177547-ecef-406a-b9db-c339416da5e2\\\"}]},{\\\"key\\\":\\\"0f99a2c7-97d7-4766-a627-9799cfe0fdd2\\\",\\\"name\\\":\\\"Item 6\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"حقوقك فيما يتعلق بمعالجة البيانات الشخصية:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>الحق في الوصول إلى بياناتك الشخصية: وذلك بطلب نسخة من بياناتك الشخصية عبر البريد الإلكتروني الموضح في بيانات التواصل.</li>\\\\n<li>الحق في تصحيح بياناتك الشخصية: وذلك بطلب تصحيح بياناتك الشخصية التي ترى أنها غير دقيقة أو غير صحيحة أو غير مكتملة وذلك عبر البريد الإلكتروني الموضح في بيانات التواصل ادناه، وسيتم مراجعتها وتحديثها واشعارك بذلك عن طريق [معلومات التواصل الخاصة بك].</li>\\\\n<li>الحق في إتلاف بياناتك الشخصية: وذلك بطلب مسح بياناتك الشخصية في ظروف معينة بما لا يتعارض مع الأسس النظامية والمصالح المشروعة.</li>\\\\n<li>الحق في تقييد المعالجة: وذلك بطلب تقييد معالجة بياناتك الشخصية في ظروف معينة ولفترة زمنية محددة.</li>\\\\n<li>الحق في الاعتراض على المعالجة: وذلك بالاعتراض على معالجة بياناتك الشخصية.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"441ad508-e30c-428c-a024-fa5d51dc1098\\\",\\\"mediaKey\\\":\\\"7ea21755-898e-413f-b788-9f3fe717d3d4\\\"}]}]\"","change":"Update"},{"success":true,"name":"bottomSectionBoxes","path":"Property/bottomSectionBoxes","oldValue":"\"[{\\\"key\\\":\\\"ae8c6b94-3745-4891-bed0-1d1268acdb91\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The Authority collects and processes the following personal data:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Name</li>\\\\n<li>Contact Information (phone number and email) </li>\\\\n<li>Technical Data (IP address, cookies, and other technical data related to a specific service or system) </li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"e6ff1e5d-736e-4c85-b5e4-6a964658d4e5\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"Use of Personal Data:  \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>When cookies are used on the Site, small files on your device or other devices known as “cookies” are saved. Internal statistics, regarding your visit to the Site based on your device’s IP address, are collected. This data helps improve your experience when navigating the Site. &nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"209b5067-4f91-460f-b7e7-3e8fdf2a7c51\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"Sharing Personal Data: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>Personal data is shared after the approval of the data owner and for legitimate, security, and judicial purposes, or to implement another system. The Authority makes every effort to protect the information provided by the user based on best practices. The Authority works to encrypt information and sensitive data that should be kept confidential following regulatory requirements that comply with the Kingdom’s current regulations.&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"47953dbe-d38e-44f7-85cc-2fbdef8ab978\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The collection of Personal Data benefits many purposes, which include: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Empower and develop the Authority’s services and fulfill its requirements. </li>\\\\n<li>Respond to beneficiaries’ questions on the Authority’s services, in addition to developing and improving the user experience and maintaining continuity in providing quality services.  </li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"2358e475-7fc9-4225-ad0a-68a8e4923ddb\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The fundamental system to collect and process Personal Data follows the Personal Data Protection Policy issued by the National Data Management Office. The fundamental system the Authority complies with to process this data is:  \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Your explicit or implicit approval. You can withdraw your approval anytime except in the abovementioned exceptions. To withdraw your approval, you can contact the Authority via the email listed in the contact information. </li>\\\\n<li>Achieving public interest: Through facilitating and improving procedures.</li>\\\\n<li>Your Personal Data is safely stored at the Real Estate General Authority or through secure solutions in cloud computing services; following the National Cybersecurity Authority’s regulations.  </li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]},{\\\"key\\\":\\\"b91b0d9f-eef0-4e4c-a93d-2b5726c78570\\\",\\\"name\\\":\\\"Item 6\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The user’s rights to Personal Data processing: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access your Personal Data: By requesting a copy of your Personal Data via the email address listed in the contact information.&nbsp;</li>\\\\n<li>The right to correct your Personal Data: By requesting the correction of your Personal Data whether it is inaccurate, incorrect, or incomplete via the email address listed in the contact information. Your request will be reviewed and you will be contacted and notified via your contact information.&nbsp;</li>\\\\n<li>The right to destroy your Personal Data: By requesting to erase your Personal Data in certain circumstances that do not clash with fundamental systems or legitimate interests.&nbsp;</li>\\\\n<li>The right to restrict the processing: By requesting to restrict the processing of your Personal Data in certain circumstances and for a specific period.&nbsp;</li>\\\\n<li>The right to object to the processing: By objecting to the processing of your Personal Data.&nbsp;</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[]}]\"","newValue":"\"[{\\\"key\\\":\\\"ae8c6b94-3745-4891-bed0-1d1268acdb91\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The Authority collects and processes the following personal data:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Name</li>\\\\n<li>Contact Information (phone number and email) </li>\\\\n<li>Technical Data (IP address, cookies, and other technical data related to a specific service or system) </li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"70c245e0-232a-41a8-8ec0-5f1d06b9f181\\\",\\\"mediaKey\\\":\\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"}]},{\\\"key\\\":\\\"e6ff1e5d-736e-4c85-b5e4-6a964658d4e5\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"Use of Personal Data:  \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>When cookies are used on the Site, small files on your device or other devices known as “cookies” are saved. Internal statistics, regarding your visit to the Site based on your device’s IP address, are collected. This data helps improve your experience when navigating the Site. &nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"0a0bf03f-3f5a-4ce8-8628-2736c56e1ebf\\\",\\\"mediaKey\\\":\\\"4f94001c-b0ef-4439-9310-38c6f1a8c5fe\\\"}]},{\\\"key\\\":\\\"209b5067-4f91-460f-b7e7-3e8fdf2a7c51\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"Sharing Personal Data: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<p>Personal data is shared after the approval of the data owner and for legitimate, security, and judicial purposes, or to implement another system. The Authority makes every effort to protect the information provided by the user based on best practices. The Authority works to encrypt information and sensitive data that should be kept confidential following regulatory requirements that comply with the Kingdom’s current regulations.&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"a6e6a60a-bc6b-4b99-bcb8-4f25676ed6f9\\\",\\\"mediaKey\\\":\\\"338b15b4-287a-4c9b-a995-b310048b4c6f\\\"}]},{\\\"key\\\":\\\"47953dbe-d38e-44f7-85cc-2fbdef8ab978\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The collection of Personal Data benefits many purposes, which include: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Empower and develop the Authority’s services and fulfill its requirements. </li>\\\\n<li>Respond to beneficiaries’ questions on the Authority’s services, in addition to developing and improving the user experience and maintaining continuity in providing quality services.  </li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"787ed130-6ae5-4039-b0c2-54f9b0e3b34e\\\",\\\"mediaKey\\\":\\\"41177547-ecef-406a-b9db-c339416da5e2\\\"}]},{\\\"key\\\":\\\"2358e475-7fc9-4225-ad0a-68a8e4923ddb\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The fundamental system to collect and process Personal Data follows the Personal Data Protection Policy issued by the National Data Management Office. The fundamental system the Authority complies with to process this data is:  \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Your explicit or implicit approval. You can withdraw your approval anytime except in the abovementioned exceptions. To withdraw your approval, you can contact the Authority via the email listed in the contact information. </li>\\\\n<li>Achieving public interest: Through facilitating and improving procedures.</li>\\\\n<li>Your Personal Data is safely stored at the Real Estate General Authority or through secure solutions in cloud computing services; following the National Cybersecurity Authority’s regulations.  </li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"23870c22-9886-495d-90b4-01e0da85b17c\\\",\\\"mediaKey\\\":\\\"41177547-ecef-406a-b9db-c339416da5e2\\\"}]},{\\\"key\\\":\\\"b91b0d9f-eef0-4e4c-a93d-2b5726c78570\\\",\\\"name\\\":\\\"Item 6\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"The user’s rights to Personal Data processing: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>The right to access your Personal Data: By requesting a copy of your Personal Data via the email address listed in the contact information.&nbsp;</li>\\\\n<li>The right to correct your Personal Data: By requesting the correction of your Personal Data whether it is inaccurate, incorrect, or incomplete via the email address listed in the contact information. Your request will be reviewed and you will be contacted and notified via your contact information.&nbsp;</li>\\\\n<li>The right to destroy your Personal Data: By requesting to erase your Personal Data in certain circumstances that do not clash with fundamental systems or legitimate interests.&nbsp;</li>\\\\n<li>The right to restrict the processing: By requesting to restrict the processing of your Personal Data in certain circumstances and for a specific period.&nbsp;</li>\\\\n<li>The right to object to the processing: By objecting to the processing of your Personal Data.&nbsp;</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"674452ad-4b04-4091-b2c8-0b5749b2b949\\\",\\\"mediaKey\\\":\\\"7ea21755-898e-413f-b788-9f3fe717d3d4\\\"}]}]\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"الشروط والأحكام و سياسة الإستخدام\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"Terms, Conditions, and Usage Policy\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"شروط\\\",\\n  \\\"احكام\\\",\\n  \\\"الشروط والاحكام\\\",\\n  \\\"الهيئة\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"terms\\\",\\n  \\\"condations\\\",\\n  \\\"policy\\\",\\n  \\\"Rega\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"الشروط والأحكام و سياسة الإستخدام\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"Terms, Conditions, and Usage Policy\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"الشروط والأحكام و سياسة الإستخدام\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"Terms, Conditions, and Usage Policy\"","change":"Update"},{"success":true,"name":"usagePolicyBoxes","path":"Property/usagePolicyBoxes","oldValue":"\"[{\\\"key\\\":\\\"5981bcf0-76de-439e-a3fe-ca451d3369c5\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"القيود على الاستخدام\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul>\\\\n<li>إن حساب المستخدم يجب أن يستخدم من قبل صاحب الحساب فقط.</li>\\\\n<li>يحكم استخدامك للموقع أنظمة ولوائح الهيئة والأنظمة واللوائح الأخرى المعمول بها في المملكة العربية السعودية.</li>\\\\n<li>يجب المحافظة على سرية هوية المستخدم وكلمة السر ويعتبر المستخدم مسؤولا مسؤولية كاملة عن أي نتائج تؤدي إلى كشفها لأي طرف آخر والآثار المترتبة عليه.</li>\\\\n<li>يجب على المستخدم إخطار الهيئة فوراً إذا تبين له أن كلمه السر للحساب قد أصبحت معلومة للآخرين، أو إذا تبين له أي اختراق أمني أو نشاط غير اعتيادي للحساب.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"2f09cdb0-05b6-4c50-ba44-b6476ea1d339\\\",\\\"mediaKey\\\":\\\"25422b96-1459-4f5d-bb2b-d55c1cbaa819\\\"}]},{\\\"key\\\":\\\"8da72f51-75a5-4aa7-a3eb-d617b27e195c\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"باستخدامك لبوابة الهيئة العامة للعقار، تقر بالامتناع عن الآتي:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>رفع أو تحميل ملفات تحتوي على برمجيات أو مواد أو بيانات أو معلومات أخرى ليست مملوكة لك أو لا تملك ترخيصاً بشأنها.</li>\\\\n<li>رفع أو تحميل ملفات على هذه البوابة تحتوي على فيروسات أو بيانات تالفة أو أي برمجيات خبيثة، أو القيام بكل ما من شأنه التأثير على سلامة المعلومات في البوابة أو موثوقيتها أو استمرار توفرها.</li>\\\\n<li>نشر أو إعلان أو توزيع أو تعميم مواد أو معلومات تحتوي تشويهاً للسمعة أو انتهاكاً للقوانين أو مواد إباحية أو بذيئة أو مخالفة للتعاليم الإسلامية أو للآداب العامة أو أي مواد أو معلومات غير قانونية من خلال بوابة الهيئة.</li>\\\\n<li>الإعلان -على بوابة الهيئة -عن أي منتج أو خدمة تجعل الهيئة في وضع انتهاك لأي نظام مطبق في أي مجال.</li>\\\\n<li>استخدام أية وسيلة أو برنامج أو إجراء لاعتراض أو محاولة اعتراض التشغيل الصحيح لبوابة الهيئة.</li>\\\\n<li>القيام بأي إجراء يفرض حملاً غير معقول أو كبير أو بصورة غير مناسبة على البنية التحتية لبوابة الهيئة.</li>\\\\n<li>كل ما يعد مخالفة لنظام مكافحة الجرائم المعلوماتية أو أي نظام آخر ذو علاقة في المملكة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"faacd733-52bf-4676-bd0f-0bfc95fcef95\\\",\\\"mediaKey\\\":\\\"c1984ebb-fcff-4735-b394-7de9802ec616\\\"}]}]\"","newValue":"\"[{\\\"key\\\":\\\"5981bcf0-76de-439e-a3fe-ca451d3369c5\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"القيود على الاستخدام\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul>\\\\n<li>إن حساب المستخدم يجب أن يستخدم من قبل صاحب الحساب فقط.</li>\\\\n<li>يحكم استخدامك للموقع أنظمة ولوائح الهيئة والأنظمة واللوائح الأخرى المعمول بها في المملكة العربية السعودية.</li>\\\\n<li>يجب المحافظة على سرية هوية المستخدم وكلمة السر ويعتبر المستخدم مسؤولا مسؤولية كاملة عن أي نتائج تؤدي إلى كشفها لأي طرف آخر والآثار المترتبة عليه.</li>\\\\n<li>يجب على المستخدم إخطار الهيئة فوراً إذا تبين له أن كلمه السر للحساب قد أصبحت معلومة للآخرين، أو إذا تبين له أي اختراق أمني أو نشاط غير اعتيادي للحساب.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"5b797933-4cb0-44eb-a450-34cf3a64ef7e\\\",\\\"mediaKey\\\":\\\"60746ace-c345-4501-b216-231fa3d99bb6\\\"}]},{\\\"key\\\":\\\"8da72f51-75a5-4aa7-a3eb-d617b27e195c\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"باستخدامك لبوابة الهيئة العامة للعقار، تقر بالامتناع عن الآتي:\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>رفع أو تحميل ملفات تحتوي على برمجيات أو مواد أو بيانات أو معلومات أخرى ليست مملوكة لك أو لا تملك ترخيصاً بشأنها.</li>\\\\n<li>رفع أو تحميل ملفات على هذه البوابة تحتوي على فيروسات أو بيانات تالفة أو أي برمجيات خبيثة، أو القيام بكل ما من شأنه التأثير على سلامة المعلومات في البوابة أو موثوقيتها أو استمرار توفرها.</li>\\\\n<li>نشر أو إعلان أو توزيع أو تعميم مواد أو معلومات تحتوي تشويهاً للسمعة أو انتهاكاً للقوانين أو مواد إباحية أو بذيئة أو مخالفة للتعاليم الإسلامية أو للآداب العامة أو أي مواد أو معلومات غير قانونية من خلال بوابة الهيئة.</li>\\\\n<li>الإعلان -على بوابة الهيئة -عن أي منتج أو خدمة تجعل الهيئة في وضع انتهاك لأي نظام مطبق في أي مجال.</li>\\\\n<li>استخدام أية وسيلة أو برنامج أو إجراء لاعتراض أو محاولة اعتراض التشغيل الصحيح لبوابة الهيئة.</li>\\\\n<li>القيام بأي إجراء يفرض حملاً غير معقول أو كبير أو بصورة غير مناسبة على البنية التحتية لبوابة الهيئة.</li>\\\\n<li>كل ما يعد مخالفة لنظام مكافحة الجرائم المعلوماتية أو أي نظام آخر ذو علاقة في المملكة.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"bc9459b3-6556-4f67-84e9-586b775b12fe\\\",\\\"mediaKey\\\":\\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"}]}]\"","change":"Update"},{"success":true,"name":"usagePolicyBoxes","path":"Property/usagePolicyBoxes","oldValue":"\"[{\\\"key\\\":\\\"3f62df80-3e81-4213-b5ae-ff47f9305ac4\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"Usage Restrictions\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul>\\\\n<li>The user account should be used only by the account owner.</li>\\\\n<li>Your use of the Site is governed by the Authority’s rules and regulations, and other rules and regulations enforced in the Kingdom of Saudi Arabia.</li>\\\\n<li>The user’s identity and password should remain confidential, and the user is fully responsible for any consequences resulting from the disclosure of this data to any other party. &nbsp;</li>\\\\n<li>The user should directly inform the Authority in the matter that the password has been disclosed to other parties or if there has been a security breach or unusual activity in the account.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"2f09cdb0-05b6-4c50-ba44-b6476ea1d339\\\",\\\"mediaKey\\\":\\\"25422b96-1459-4f5d-bb2b-d55c1cbaa819\\\"}]},{\\\"key\\\":\\\"57c54904-fb59-4992-93f6-8816948ef1f3\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"By using the Real Estate General Authority’s portal, you agree to abstain from the following: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Upload or download files containing software, material, data, or other information not owned by you or licensed to you. &nbsp;&nbsp;</li>\\\\n<li>Upload or download files onto this portal that contain viruses, corrupt data, or unsolicited software, or conduct any action that may affect the safety, reliability, or continued availability of the information on the portal. &nbsp;</li>\\\\n<li>Publish, post, distribute, or circulate material and information that are defamatory, unlawful, infringing, obscene, or violate Islamic teachings or public morals, or any illegal material or information through the Authority’s portal.&nbsp;</li>\\\\n<li>Advertise – on the Authority’s portal – any product or service that would cause the Authority to violate any system applied in any field.&nbsp;</li>\\\\n<li>Use any device, program, or procedure to interfere or attempt to interfere with the proper functions of the Authority’s portal.&nbsp;</li>\\\\n<li>Take any action that inflicts an unreasonable or disproportionately large load on the infrastructure of the Authority’s portal.&nbsp;</li>\\\\n<li>Everything that is considered a violation of the Anti-Cyber Crime System or any other relevant system in the Kingdom.&nbsp;</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"faacd733-52bf-4676-bd0f-0bfc95fcef95\\\",\\\"mediaKey\\\":\\\"c1984ebb-fcff-4735-b394-7de9802ec616\\\"}]}]\"","newValue":"\"[{\\\"key\\\":\\\"3f62df80-3e81-4213-b5ae-ff47f9305ac4\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"Usage Restrictions\\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul>\\\\n<li>The user account should be used only by the account owner.</li>\\\\n<li>Your use of the Site is governed by the Authority’s rules and regulations, and other rules and regulations enforced in the Kingdom of Saudi Arabia.</li>\\\\n<li>The user’s identity and password should remain confidential, and the user is fully responsible for any consequences resulting from the disclosure of this data to any other party. &nbsp;</li>\\\\n<li>The user should directly inform the Authority in the matter that the password has been disclosed to other parties or if there has been a security breach or unusual activity in the account.</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"3fd3b80b-3641-495b-8c74-02782f05730c\\\",\\\"mediaKey\\\":\\\"60746ace-c345-4501-b216-231fa3d99bb6\\\"}]},{\\\"key\\\":\\\"57c54904-fb59-4992-93f6-8816948ef1f3\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"usagePolicyItem\\\",\\\"PropType\\\":null,\\\"title\\\":\\\"By using the Real Estate General Authority’s portal, you agree to abstain from the following: \\\",\\\"itemBreif\\\":{\\\"markup\\\":\\\"<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>Upload or download files containing software, material, data, or other information not owned by you or licensed to you. &nbsp;&nbsp;</li>\\\\n<li>Upload or download files onto this portal that contain viruses, corrupt data, or unsolicited software, or conduct any action that may affect the safety, reliability, or continued availability of the information on the portal. &nbsp;</li>\\\\n<li>Publish, post, distribute, or circulate material and information that are defamatory, unlawful, infringing, obscene, or violate Islamic teachings or public morals, or any illegal material or information through the Authority’s portal.&nbsp;</li>\\\\n<li>Advertise – on the Authority’s portal – any product or service that would cause the Authority to violate any system applied in any field.&nbsp;</li>\\\\n<li>Use any device, program, or procedure to interfere or attempt to interfere with the proper functions of the Authority’s portal.&nbsp;</li>\\\\n<li>Take any action that inflicts an unreasonable or disproportionately large load on the infrastructure of the Authority’s portal.&nbsp;</li>\\\\n<li>Everything that is considered a violation of the Anti-Cyber Crime System or any other relevant system in the Kingdom.&nbsp;</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"itemImage\\\":[{\\\"key\\\":\\\"e68db64e-68f1-438a-b3ec-f77e804a3db8\\\",\\\"mediaKey\\\":\\\"b83ff781-2391-42e1-9728-fd6df904e711\\\"}]}]\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"1","newValue":"3","change":"Update"}],"key":"cf93d97c-c408-4830-a4b8-c0d0d1a1cdcc"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/b1fc40d6-1fc0-45bc-adae-c399ee932318.config","name":"طلب بيانات مفتوحة","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"طلب بيانات مفتوحة\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"Request Open Data\"","change":"Update"},{"success":true,"name":"formDescription","path":"Property/formDescription","oldValue":"null","newValue":"\"قم بملئ البيانات أدناه للتقدم بطلب للحصول على البيانات المفتوحة.\"","change":"Update"},{"success":true,"name":"formDescription","path":"Property/formDescription","oldValue":"null","newValue":"\"Fill in the information below to apply for open data.\"","change":"Update"},{"success":true,"name":"formIcon","path":"Property/formIcon","oldValue":"null","newValue":"\"[]\"","change":"Update"},{"success":true,"name":"formRef","path":"Property/formRef","oldValue":"null","newValue":"\"22cfb8de-c8e0-47f5-b153-f92fca702c32\"","change":"Update"},{"success":true,"name":"formTitle","path":"Property/formTitle","oldValue":"null","newValue":"\"طلب بيانات مفتوحة\"","change":"Update"},{"success":true,"name":"formTitle","path":"Property/formTitle","oldValue":"null","newValue":"\"Request Open Data\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"open\\\",\\n  \\\"data\\\",\\n  \\\"open data\\\",\\n  \\\"Rega\\\",\\n  \\\"البيانات\\\",\\n  \\\"البيانات المفتوحة\\\",\\n  \\\"المفتوحة\\\",\\n  \\\"الهيئة\\\",\\n  \\\"الهيئة العامة للعقار\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageDescription","path":"Property/pageDescription","oldValue":"\"{\\\"markup\\\":\\\"<p>الخطوات الرئيسة للوصول الى المعلومات أو الحصول عليها</p>\\\\n<ul>\\\\n<li>يجب أن يكون الطلب لأغراض الوصول إلى المعلومات العامة أو الحصول عليها.<br>الخطوات الرئيسة لطلب الاطلاع أو الحصول على المعلومات العامة:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>أولاً</strong>: يتم تقديم الطلبات عن طريق ملء نموذج إلكتروني وتقديمه للهيئة.</li>\\\\n<li><strong>ثانياً</strong>: تقوم الهيئة، باستلام طلب الاطلاع أو الحصول على المعلومات العامة واتخاذ أحد القرارات التالية:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li><strong>الموافقة</strong>: في حال تمت موافقة الهيئة على طلب الوصول إلى المعلومات أو الحصول عليها.</li>\\\\n<li><strong>الرفض</strong>: في حال تم رفض طلب الوصول إلى المعلومات أو الحصول عليها، فيجب أن يكون الرفض خطياً أو إلكترونياً على أن يتضمن المعلومات التالية:\\\\n<ul style=\\\\\\\"list-style-type: disc;\\\\\\\">\\\\n<li>تحديد ما إذا كان رفض الطلب كلياً أو جزئياً.</li>\\\\n<li>أسباب الرفض، إن أمكن.</li>\\\\n<li>الإشعار: في حال كانت المعلومات المطلوبة متاحه على موقع الهيئة، أو ليست من اختصاصها فيجب إشعار الفرد بذلك خطياً أو إلكترونياً.</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\\n</li>\\\\n<li><strong>ثالثاً</strong>: في حالة رغبة الفرد في التظلّم على رفض الطلب من قبل الهيئة، فيمكنه تقديم إشعار خطي أو إلكتروني بالتظلم إلى مكتب إدارة البيانات في الهيئة خلال فترة زمنية لا تتجاوز (5) أيام عمل من استلامه لقرار الهيئة، ويقوم مكتب إدارة البيانات في الهيئة بمراجعة الطلب واتخاذ القرار المناسب.</li>\\\\n</ul>\\\\n</li>\\\\n</ul>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","newValue":"null","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"\"Open Data Request\"","newValue":"\"طلب بيانات مفتوحة\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"Request Open Data\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"}],"key":"b1fc40d6-1fc0-45bc-adae-c399ee932318"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/59071c62-4f3a-4e53-9784-68963286266a.config","name":"إيجار","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1248","change":"Update"},{"success":true,"name":"buttonText","path":"Property/buttonText","oldValue":"\"الانتقال الى الخدمة\"","newValue":"\"بدء الخدمة\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"إيجار شبكة إلكترونية متكاملة تهدف إلى تنظيم قطاع الإيجار العقاري في المملكة العربية السعودية وحفظ حقوق أطراف العملية الإيجارية ( المستأجر، المؤجر، الوسيط العقاري )،\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"EJAR is a complete electronic network that aims to organize the real estate leasing sector in the Kingdom of Saudi Arabia. It's designed to protect the rights of tenants, landlords, and real estate brokers involved in leasing activities.\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"ايجار\\\",\\n  \\\"ejar\\\",\\n  \\\"Rega\\\",\\n  \\\"الخدمات الالكترونية\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"العقار\\\",\\n  \\\"مستأجر\\\",\\n  \\\"موجر\\\",\\n  \\\"وسيط\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"\"Ejar\"","newValue":"\"إيجار\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"EJAR\"","change":"Update"},{"success":true,"name":"serviceBrief","path":"Property/serviceBrief","oldValue":"\"{\\\"markup\\\":\\\"<p>\\\\\\\"إيجار\\\\\\\" شبكة إلكترونية متكاملة تهدف إلى تنظيم قطاع الإيجار العقاري في المملكة العربية السعودية وحفظ حقوق أطراف العملية الإيجارية ( المستأجر، المؤجر، الوسيط العقاري )، تقدم مجموعة من الحلول الإلكترونية التي تسهم في تطوير قطاع الإيجار العقاري وتنظيمه وتيسير أعماله، بما يحقق التوازن في القطاع وتعزيز الثقة به، ويسهم في تحفيز الاستثمار فيه.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","newValue":"\"{\\\"markup\\\":\\\"<p>إيجار شبكة إلكترونية متكاملة تهدف إلى تنظيم قطاع الإيجار العقاري في المملكة العربية السعودية وحفظ حقوق أطراف العملية الإيجارية ( المستأجر، المؤجر، الوسيط العقاري )،</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"serviceFeature","path":"Property/serviceFeature","oldValue":"\"[{\\\"key\\\":\\\"89e74439-32d7-4704-af88-8a5390a0be58\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"عن الخدمة\\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>\\\\\\\"إيجار\\\\\\\" شبكة إلكترونية متكاملة تهدف إلى تنظيم قطاع الإيجار العقاري في المملكة العربية السعودية وحفظ حقوق أطراف العملية الإيجارية ( المستأجر، المؤجر، الوسيط العقاري )، تقدم مجموعة من الحلول الإلكترونية التي تسهم في تطوير قطاع الإيجار العقاري وتنظيمه وتيسير أعماله، بما يحقق التوازن في القطاع وتعزيز الثقة به، ويسهم في تحفيز الاستثمار فيه.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\