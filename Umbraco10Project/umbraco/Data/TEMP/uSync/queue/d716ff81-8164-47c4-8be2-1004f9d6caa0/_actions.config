ast-font-family: 'Times New Roman'; mso-bidi-font-family: 'Times New Roman';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">&nbsp;شركة مأوى الحلول للخدمات العقارية شركة شخص واحد &nbsp;&nbsp;</span></p>\\\\n</td>\\\\n<td width=\\\\\\\"30%\\\\\\\" style=\\\\\\\"width: 30.2%; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; padding: 0cm 5.4pt 0cm 5.4pt;\\\\\\\">\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: center; tab-stops: 88.5pt;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"center\\\\\\\">&nbsp;</p>\\\\n</td>\\\\n<td width=\\\\\\\"18%\\\\\\\" style=\\\\\\\"width: 18.82%; border-top: none; border-left: solid windowtext 1.0pt; border-bottom: solid windowtext 1.0pt; border-right: none; padding: 0cm 0cm 0cm 5.4pt;\\\\\\\">\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: center; tab-stops: 88.5pt;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"center\\\\\\\">&nbsp;</p>\\\\n</td>\\\\n</tr>\\\\n</tbody>\\\\n</table>\\\\n</div>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: left;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\" align=\\\\\\\"right\\\\\\\"><span>&nbsp;</span></p>\\\\n<p style=\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"5e775807-d0f3-4a41-a4f6-312ad678d615\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/30178f7a0f334c98b8b53c2addb8ebd6\\\",\\\"featureTabTitle\\\":\\\"آلية تجديد رخصة فال\\\",\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p><img style=\\\\\\\"display: block; margin-left: auto; margin-right: auto;\\\\\\\" src=\\\\\\\"?rmode=max&amp;width=753&amp;height=424\\\\\\\" alt=\\\\\\\"\\\\\\\" width=\\\\\\\"753\\\\\\\" height=\\\\\\\"424\\\\\\\" data-udi=\\\\\\\"umb://media/d734deff115149b2b3d95a22922bf54b\\\\\\\"></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"serviceFeature","path":"Property/serviceFeature","oldValue":"\"[{\\\"key\\\":\\\"f92b2ffc-0793-4c2c-90d8-613fd863fdca\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"About the Service\\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>The Electronic Services page for Real Estate Brokerage offers individuals and real estate establishments the \\\\\\\"FAL\\\\\\\" license to engage in real estate activities. It also provides innovative services to enhance and organize the services offered in the real estate market. These services aim to protect the rights of beneficiaries, boost market confidence, and facilitate real estate activities.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"f92b2ffc-0793-4c2c-90d8-613fd863fdca\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"About the Service\\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>The Electronic Services page for Real Estate Brokerage offers individuals and real estate establishments the \\\\\\\"FAL\\\\\\\" license to engage in real estate activities. It also provides innovative services to enhance and organize the services offered in the real estate market. These services aim to protect the rights of beneficiaries, boost market confidence, and facilitate real estate activities.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"support","path":"Property/support","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/0971a1b6c42b491e811c4515c8a2c061\\\"},{\\\"contentUdi\\\":\\\"umb://element/07c50ec279dc4369a087d0303818c264\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"4612c786-ff7a-4b37-9bba-428c0b4bdfe9\\\",\\\"udi\\\":\\\"umb://element/07c50ec279dc4369a087d0303818c264\\\",\\\"title\\\":null,\\\"items\\\":\\\"{\\\\\\\"layout\\\\\\\":{\\\\\\\"Umbraco.BlockList\\\\\\\":[{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/9463fe9df588425088653bf98a2250c3\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/263d064dc38b4b1fac63ab5faa5953e2\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/c7e1edc9a3a4444685bb7df6b84a22ba\\\\\\\"}]},\\\\\\\"contentData\\\\\\\":[{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/263d064dc38b4b1fac63ab5faa5953e2\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"[\\\\\\\\\\\\\\\"Email\\\\\\\\\\\\\\\"]\\\\\\\",\\\\\\\"title\\\\\\\":null,\\\\\\\"text\\\\\\\":null,\\\\\\\"icon\\\\\\\":null,\\\\\\\"items\\\\\\\":null,\\\\\\\"link\\\\\\\":null,\\\\\\\"titleFirst\\\\\\\":\\\\\\\"1\\\\\\\"},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"c64478ba-9cc3-419b-b7d9-12dfc5e8ef94\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://ele