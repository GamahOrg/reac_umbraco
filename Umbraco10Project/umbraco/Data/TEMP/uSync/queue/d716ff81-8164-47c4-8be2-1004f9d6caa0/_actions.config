/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/1d910e48-371e-4392-8b05-a77b3939da64.config","name":"مجلس الإدارة","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"يرأس الهيئة العامة للعقار مجلس إدارة متميز. ويشتهر أعضاء مجلس الإدارة بخدماتهم المستمرة وتفانيهم في رعاية مستقبل مزدهر للقطاع العقاري والمملكة العربية السعودية.\\n\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"The Real Estate General Authority is guided by an exceptional Board of Directors. These board members are widely recognized for their unwavering commitment and tireless efforts in fostering a thriving future for both the real estate sector and the Kingdom of Saudi Arabia.\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"مجلس الإدارة\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"Board of Directors\"","change":"Update"},{"success":true,"name":"shortBrief","path":"Property/shortBrief","oldValue":"\"<p>يرأس الهيئة العامة للعقار مجلس إدارة متميز. ويشتهر أعضاء مجلس الإدارة بخدماتهم المستمرة وتفانيهم في رعاية مستقبل مزدهر للقطاع العقاري والمملكة العربية السعودية.</p>\"","newValue":"\"{\\\"markup\\\":\\\"<p>يرأس الهيئة العامة للعقار مجلس إدارة متميز. ويشتهر أعضاء مجلس الإدارة بخدماتهم المستمرة وتفانيهم في رعاية مستقبل مزدهر للقطاع العقاري والمملكة العربية السعودية.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"مجلس الإدارة\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"Board of Directors\"","change":"Update"}],"key":"1d910e48-371e-4392-8b05-a77b3939da64"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/6218a02f-9895-4aed-a87b-65580ff81940.config","name":"بيع وتأجير مشروعات عقارية على الخارطة","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1248","change":"Update"},{"success":true,"name":"buttonText","path":"Property/buttonText","oldValue":"\"الانتقال الى الخدمة\"","newValue":"\"بدء الخدمة\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"Wafi is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"بيع\\\",\\n  \\\"تأجير\\\",\\n  \\\"تراخيص\\\",\\n  \\\"ترخصي\\\",\\n  \\\"الخدمات الالكترونية\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"Rega\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"\"wafi\"","newValue":"\"بيع وتأجير مشروعات عقارية على الخارطة\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"Wafi – Off-Plan Sales & Lease\"","change":"Update"},{"success":true,"name":"serviceFeature","path":"Property/serviceFeature","oldValue":"\"[{\\\"key\\\":\\\"3ba4a362-5015-41be-b87c-f57c199f1265\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"عن الخدمة\\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه، تهدف إلى أتمتة خدمات قطاع التطوير العقاري، تحت إشراف الهيئة العامة للعقار، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم (196) وتاريخ 1445/03/04هـ.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"cec460cf-9431-4812-9a76-7739d64a4ef3\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/2d60419ed1954a2d90581e33b729900d\\\",\\\"featureTabTitle\\\":\\\"التأهيل\\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\">تتيح هذه الخدمة طلب التأهيل للراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة والمهن المتربطة بها، باعتباره متطلب أساسي للحصول على الترخيص، وفقاً للنظام واللائحة التنفيذية لبيع وتأجير مشروعات عقارية على الخارطة.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"/{localLink:umb://media/05dc2f225bef4b16a41894d4369a41ba}\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"المطور العقاري (شخص اعتباري/ منشأة)\\\\\\\\\\\\\\\">المطور العقاري (شخص اعتباري/ منشأة)</a></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"/{localLink:umb://media/62663e1acf024536a87ca36d360f276f}\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"المطور العقاري (شخص طبيعي/فرد)\\\\\\\\\\\\\\\">المطور العقاري (شخص طبيعي/فرد)</a></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"/{localLink:umb://media/1e66c8906f48454a9937f23aadc06fde}\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"الاستشاري الهندسي\\\\\\\\\\\\\\\">الاستشاري الهندسي</a></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"/{localLink:umb://media/70b22a18e7ce43eeb16e93af8d6aefbe}\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"المحاسب القانوني\\\\\\\\\\\\\\\">المحاسب القانوني</a></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\">للتقدم بطلب التأهيل:</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"منصة الخدمة\\\\\\\\\\\\\\\">منصة الخدمة</a></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"a26f40f8-7f62-4f0b-9bd4-4cdc0f8530f3\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a2fab649a0c74f1c8c1ca6eb11260385\\\",\\\"featureTabTitle\\\":\\\"الترخيص \\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p><strong>متطلبات رخصة بيع وتأجير مشروعات عقارية على الخارطة :</strong></p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n<ol>\\\\\\\\n<li>نسخة من السجل التجاري ساري المفعول، الذي يسمح له بمزاولة التطوير العقاري.</li>\\\\\\\\n<li>شهادة عضوية الغرفة التجارية.</li>\\\\\\\\n<li>نسخة من السجل الائتماني من شركة مرخص لها كم الجهة المختصة بالخدمات الائتمانية. من تاتا.</li>\\\\\\\\n<li>نسخة من الاتفاقية المبرمة بينه وبين مالك الارض أو مالك منفعتها بما يتفق مع أحكام النظام واللائحة.</li>\\\\\\\\n<li>نسخة من الاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي - إن وجد- بما يتفق مع أحكام النظام واللائحة.</li>\\\\\\\\n<li>التصاميم المعمارية والمخططات الهندسية التي اعتمدتها الجهات المختصة.</li>\\\\\\\\n<li>نسخة من العقد المبرم بينه وبين المكتب الاستشاري، بما يتفق مع أحكام النظام واللائحة</li>\\\\\\\\n<li>&nbsp;نسخة من العقد المبرم بينه وبين المحاسب القانوني، بما يتفق مع أحكام النظام واللائحة.</li>\\\\\\\\n<li>دراسة الجدوى الاقتصادية للمشروع العقاري من مكتب استشاري تتضمن: تكاليف المشروع العقاري التقديرية، وأوجه الصرف اللازمة عليه، والتدقيق النقدي له، والمدة المتوقعة لتنفيذه.</li>\\\\\\\\n<li>تعهد منه ببدء الأعمال الإنشائية للمشروع العقاري خلال (سته) أشهر من تاريخ حصوله على الترخيص .</li>\\\\\\\\n<li>نموذج عقد بيع بينه وبين المشتري ومواعيد تسليم البيع محددة باليوم بما يتفق مع أحكام النظام واللائحة وغير متعارضة مع أجكام الشريعة الإسلامية.</li>\\\\\\\\n<li>اتفاقية فتح حساب ضمان بينه وبين بنك مرخص له في المملكة، بما يتفق مع أحكام النظام واللائحة.</li>\\\\\\\\n<li>إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقًا لنظام ملكية الوحدات العقارية وفرزها وإدارتها.</li>\\\\\\\\n<li>يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري إلا إذا كانت مسجلة عينيًا.</li>\\\\\\\\n</ol>\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n<p><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"للتقديم على الرخصة\\\\\\\\\\\\\\\">للتقديم على الرخصة</a></p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n<p><strong>متطلبات رخصة تسويق مشروعات عقارية على الخارطة</strong></p>\\\\\\\\n<ol style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">\\\\\\\\n<li><em><span style=\\\\\\\\\\\\\\\"font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\\\\\\\\\">&nbsp; &nbsp; </span></em>رقم صك تسجيل ملكية العقار.</li>\\\\\\\\n<li><span style=\\\\\\\\\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\\\\\\\\\">&nbsp; &nbsp;</span><!--[endif]-->رقم عقد التسويق بين الوسيط العقاري والمطور-إن وجد-.</li>\\\\\\\\n<li><span style=\\\\\\\\\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\\\\\\\\\">&nbsp; &nbsp; </span><!--[endif]-->نسخة عقد التطوير بين المطور ومالك الأرض-إن وجد-.</li>\\\\\\\\n<li><span style=\\\\\\\\\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\\\\\\\\\">.</span><span style=\\\\\\\\\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\\\\\\\\\">&nbsp; </span><!--[endif]-->التصاميم المعمارية والمخططات الهندسية</li>\\\\\\\\n</ol>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">وفي حال رغبة المطور استلام مبلغ حجز وحدات عقارية من المشتري أو المستأجر خلال مدة ( ترخيص تسويق المشروع العقاري ) الالتزام بالتالي :</p>\\\\\\\\n<ul>\\\\\\\\n<li style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">- الإفصاح عن حالة المشروع والمخططات المستقبلية&nbsp;</li>\\\\\\\\n<li style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">- عدم استلام أكثر من (5%) من قيمة الوحدة العقارية.</li>\\\\\\\\n<li style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">- إيداع جميع مبالغ الحجز المستلمة في حساب الضمان المخصص لذلك.&nbsp;</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\"><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"للتقديم على الرخصة\\\\\\\\\\\\\\\">للتقديم على الرخصة</a></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"165d0496-a0a2-47d3-ae7a-fa3b7057cc75\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/8c9e8204df264a3f86aa60047aa52ab9\\\",\\\"featureTabTitle\\\":\\\"الدعم والتمكين\\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>الدعم والاستفسارات:</p>\\\\\\\\n<p> </p>\\\\\\\\n<p> البريد الإلكتروني:  <a href=\\\\\\\\\\\\\\\"mailto:wafi@rega.gov.sa\\\\\\\\\\\\\\\">wafi@rega.gov.sa </a></p>\\\\\\\\n<p>الرقم الموحد 199011</p>\\\\\\\\n<p><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"/%D8%A7%D9%84%D9%85%D8%B1%D9%83%D8%B2-%D8%A7%D9%84%D8%A7%D8%B9%D9%84%D8%A7%D9%85%D9%8A/%D8%A8%D9%88%D8%A7%D8%A8%D8%A9-%D9%86%D9%81%D8%A7%D8%B0/\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" title=\\\\\\\\\\\\\\\"البلاغات\\\\\\\\\\\\\\\">البلاغات</a></p>\\\\\\\\n<p> </p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"8a7777f9-d3f7-4103-95d3-34ab62a595ef\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/15ed04d585fb4fb0983a4abead7a229c\\\",\\\"featureTabTitle\\\":\\\"المشاريع المرخصة\\\",\\\"featureTitle\\\":\\\"المشاريع المرخصة\\\",\\\"featureBrief\\\":null,\\\"customPage\\\":\\\"[\\\\\\\"Wafi Projects\\\\\\\"]\\\",\\\"linkedToPage\\\":\\\"umb://document/c750cd59703d4f54ae24cc40fbcb9f54\\\"},{\\\"key\\\":\\\"4b277b10-b562-4078-9458-99d1204118a8\\\",\\\"name\\\":\\\"Item 6\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/e3a68052de4c4d5faaa99c213a1f36b0\\\",\\\"featureTabTitle\\\":\\\"الشركات المؤهلة\\\",\\\"featureTitle\\\":\\\"الشركات المؤهلة\\\",\\\"featureBrief\\\":null,\\\"customPage\\\":\\\"[\\\\\\\"Wafi Developers\\\\\\\"]\\\",\\\"linkedToPage\\\":null}]\"","newValue":"\"[{\\\"key\\\":\\\"3ba4a362-5015-41be-b87c-f57c199f1265\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"عن الخدمة\\\",\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>تمكن هذه الخدمة الراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة من طلب التأهيل وإصدار التراخيص للازمة والاستفادة من خدمات ما بعد ترخيص المشروع العقاري أيا كان نوعه، تهدف إلى أتمتة خدمات قطاع التطوير العقاري، تحت إشراف الهيئة العامة للعقار، وفق نظام بيع وتأجير مشروعات عقارية على الخارطة الصادر بقرار مجلس الوزراء رقم (196) وتاريخ 1445/03/04هـ.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"cec460cf-9431-4812-9a76-7739d64a4ef3\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/2d60419ed1954a2d90581e33b729900d\\\",\\\"featureTabTitle\\\":\\\"التأهيل\\\",\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">تتيح هذه الخدمة طلب التأهيل للراغبين بمزاولة نشاط بيع وتأجير مشروعات عقارية على الخارطة والمهن المتربطة بها، باعتباره متطلب أساسي للحصول على الترخيص، وفقاً للنظام واللائحة التنفيذية لبيع وتأجير مشروعات عقارية على الخارطة.</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/05dc2f225bef4b16a41894d4369a41ba}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص اعتباري/ منشأة)\\\\\\\">المطور العقاري (شخص اعتباري/ منشأة)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/62663e1acf024536a87ca36d360f276f}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المطور العقاري (شخص طبيعي/فرد)\\\\\\\">المطور العقاري (شخص طبيعي/فرد)</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/1e66c8906f48454a9937f23aadc06fde}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"الاستشاري الهندسي\\\\\\\">الاستشاري الهندسي</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"/{localLink:umb://media/70b22a18e7ce43eeb16e93af8d6aefbe}\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"المحاسب القانوني\\\\\\\">المحاسب القانوني</a></p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">للتقدم بطلب التأهيل:</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin-right: 36.0pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"منصة الخدمة\\\\\\\">منصة الخدمة</a></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"a26f40f8-7f62-4f0b-9bd4-4cdc0f8530f3\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a2fab649a0c74f1c8c1ca6eb11260385\\\",\\\"featureTabTitle\\\":\\\"الترخيص \\\",\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p><strong>متطلبات رخصة بيع وتأجير مشروعات عقارية على الخارطة :</strong></p>\\\\n<p>&nbsp;</p>\\\\n<ol>\\\\n<li>نسخة من السجل التجاري ساري المفعول، الذي يسمح له بمزاولة التطوير العقاري.</li>\\\\n<li>شهادة عضوية الغرفة التجارية.</li>\\\\n<li>نسخة من السجل الائتماني من شركة مرخص لها كم الجهة المختصة بالخدمات الائتمانية. من تاتا.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بينه وبين مالك الارض أو مالك منفعتها بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>نسخة من الاتفاقية المبرمة بين المطور الرئيس والمطور الفرعي - إن وجد- بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>التصاميم المعمارية والمخططات الهندسية التي اعتمدتها الجهات المختصة.</li>\\\\n<li>نسخة من العقد المبرم بينه وبين المكتب الاستشاري، بما يتفق مع أحكام النظام واللائحة</li>\\\\n<li>&nbsp;نسخة من العقد المبرم بينه وبين المحاسب القانوني، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>دراسة الجدوى الاقتصادية للمشروع العقاري من مكتب استشاري تتضمن: تكاليف المشروع العقاري التقديرية، وأوجه الصرف اللازمة عليه، والتدقيق النقدي له، والمدة المتوقعة لتنفيذه.</li>\\\\n<li>تعهد منه ببدء الأعمال الإنشائية للمشروع العقاري خلال (سته) أشهر من تاريخ حصوله على الترخيص .</li>\\\\n<li>نموذج عقد بيع بينه وبين المشتري ومواعيد تسليم البيع محددة باليوم بما يتفق مع أحكام النظام واللائحة وغير متعارضة مع أجكام الشريعة الإسلامية.</li>\\\\n<li>اتفاقية فتح حساب ضمان بينه وبين بنك مرخص له في المملكة، بما يتفق مع أحكام النظام واللائحة.</li>\\\\n<li>إذا كان المشروع يحتوي على وحدات عقارية مفرزة، فيجب إرفاق محضر فرز الوحدات المعتمد وفقًا لنظام ملكية الوحدات العقارية وفرزها وإدارتها.</li>\\\\n<li>يجب إرفاق خطاب من مالك العقار بالموافقة على التأشير على صك تسجيل الملكية للعقار المراد تطويره بعدم التصرف في ملكيته إلى أن تستكمل أعمال التطوير العقاري إلا إذا كانت مسجلة عينيًا.</li>\\\\n</ol>\\\\n<p>&nbsp;</p>\\\\n<p><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\\n<p>&nbsp;</p>\\\\n<p>&nbsp;</p>\\\\n<p><strong>متطلبات رخصة تسويق مشروعات عقارية على الخارطة</strong></p>\\\\n<ol style=\\\\\\\"text-align: right;\\\\\\\">\\\\n<li><em><span style=\\\\\\\"font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span></em>رقم صك تسجيل ملكية العقار.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp;</span><!--[endif]-->رقم عقد التسويق بين الوسيط العقاري والمطور-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; &nbsp; </span><!--[endif]-->نسخة عقد التطوير بين المطور ومالك الأرض-إن وجد-.</li>\\\\n<li><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">.</span><span style=\\\\\\\"font-style: normal; font-variant: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';\\\\\\\">&nbsp; </span><!--[endif]-->التصاميم المعمارية والمخططات الهندسية</li>\\\\n</ol>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">وفي حال رغبة المطور استلام مبلغ حجز وحدات عقارية من المشتري أو المستأجر خلال مدة ( ترخيص تسويق المشروع العقاري ) الالتزام بالتالي :</p>\\\\n<ul>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- الإفصاح عن حالة المشروع والمخططات المستقبلية&nbsp;</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- عدم استلام أكثر من (5%) من قيمة الوحدة العقارية.</li>\\\\n<li style=\\\\\\\"text-align: right;\\\\\\\">- إيداع جميع مبالغ الحجز المستلمة في حساب الضمان المخصص لذلك.&nbsp;</li>\\\\n</ul>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: right;\\\\\\\"><a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://wafiservices.rega.gov.sa/auth/login\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"للتقديم على الرخصة\\\\\\\">للتقديم على الرخصة</a></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"2ef88132-6afd-4796-813f-4479f679af37\\\",\\\"name\\\":\\\"Item 4\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":null,\\\"featureTabTitle\\\":\\\"المشاريع المرخصة\\\",\\\"featureBrief\\\":null,\\\"customPage\\\":[\\\"Wafi Projects\\\"],\\\"linkedToPage\\\":\\\"umb://document/b97ea291532645a587fa2257586e22f6\\\"},{\\\"key\\\":\\\"9c34889b-7541-4c15-ae27-27e5b636b6c6\\\",\\\"name\\\":\\\"Item 5\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":null,\\\"featureTabTitle\\\":\\\"المطورين المعتمدين\\\",\\\"featureBrief\\\":null,\\\"customPage\\\":[\\\"Wafi Developers\\\"],\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"serviceFeature","path":"Property/serviceFeature","oldValue":"\"[{\\\"key\\\":\\\"a8f183c3-591c-48e6-b530-82da38973af2\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"About the Service \\\",\\\"featureTitle\\\":null,\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>\\\\\\\"Wafi\\\\\\\" is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}}]\"","newValue":"\"[{\\\"key\\\":\\\"a8f183c3-591c-48e6-b530-82da38973af2\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"About the Service \\\",\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p>\\\\\\\"Wafi\\\\\\\" is the official organization in charge of granting licenses for selling off-plan real estate units in Saudi Arabia. They also issue registration certificates to real estate development companies in the Real Estate Developer registry, following the Off-Plan Sales and Lease system.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null},{\\\"key\\\":\\\"e881996e-1050-400d-b141-9a9f6cf81866\\\",\\\"name\\\":\\\"Item 2\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":null,\\\"featureTabTitle\\\":\\\"Projects\\\",\\\"featureBrief\\\":null,\\\"customPage\\\":[\\\"Wafi Projects\\\"],\\\"linkedToPage\\\":\\\"umb://document/b97ea291532645a587fa2257586e22f6\\\"},{\\\"key\\\":\\\"ca6706f6-fd9f-4bd5-b4e4-04eb9adc2af0\\\",\\\"name\\\":\\\"Item 3\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":null,\\\"featureTabTitle\\\":\\\"Certified Facilities\\\",\\\"featureBrief\\\":null,\\\"customPage\\\":[\\\"Wafi Developers\\\"],\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"support","path":"Property/support","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/42cefd9b69a84136975415681a475611\\\"},{\\\"contentUdi\\\":\\\"umb://element/b2c2b1db22dd48828955fd32b996