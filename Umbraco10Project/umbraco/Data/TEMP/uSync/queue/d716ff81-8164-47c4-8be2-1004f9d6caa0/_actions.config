essage":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/9ba9c31f-1a20-4991-b82f-366f6757f12f.config","name":"مركز بروتيك السعودية","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"content","path":"Property/content","oldValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/e655cbe2900b4a21ac1e767a5d412d10\\\"},{\\\"contentUdi\\\":\\\"umb://element/6a1ef2008d65472896a98219ca4382b2\\\"},{\\\"contentUdi\\\":\\\"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\\\"},{\\\"contentUdi\\\":\\\"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/e655cbe2900b4a21ac1e767a5d412d10\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p><img style=\\\\\\\\\\\\\\\"display: block; margin-left: auto; margin-right: auto;\\\\\\\\\\\\\\\" src=\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\" alt=\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\" width=\\\\\\\\\\\\\\\"279\\\\\\\\\\\\\\\" height=\\\\\\\\\\\\\\\"128\\\\\\\\\\\\\\\" data-udi=\\\\\\\\\\\\\\\"umb://media/803b9f26f2de429893517e77b49fcb89\\\\\\\\\\\\\\\"></p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n<p>إسهاماً من الهيئة العامة للعقار وإيمانًا منها بدور التقنية في القطاع العقاري وما تمثله من آفاق مستقبلية تسهم في تحقيق مستهدفات رؤية السعودية<span>&nbsp; ٢٠٣٠ التي دعت إلى ضرورة التحول الرقمي ومواصلة توسيع نطاق الخدمات الرقمية، ولما تحظى به التقنيات العقارية \\\\\\\\\\\\\\\"</span>البروبتك\\\\\\\\\\\\\\\" من تمكين كونها تمثل جزءً لا يتجزأ من الحراك التقني والتحول الرقمي الذي<span>&nbsp; تشهده مختلف القطاع الحيوية والاقتصادية بالسعودية </span>، فقد سعت الهيئة لخلق بيئة حاضنة للتقنية العقارية ومجتمع يضم التقنيين العقاريين من خلال إنشاء مركز متكامل لخدمة المهتمين والمتخصصين بالمجال ، مما يسهم في بناء فرص للتواصل مع الجهات المحلية والعالمية، وربط الشركات التقنية ورواد الأعمال بالمستثمرين وأصحاب رؤوس الأموال ، إضافةً إلى تبادل المعرفة وتعزيز الابتكار وتطوير التقنيات العقارية للوصول إلى مستهدفات الاستراتيجية الشاملة للقطاع العقاري .</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":\\\"\\\",\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/6a1ef2008d65472896a98219ca4382b2\\\",\\\"title\\\":\\\"التعريف بالمركز :\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>مركز بروتيك السعودية مجتمع متكامل لخدمة المهتمين والمتخصصين بالتقنية العقارية محليًا وعالميًا ، ويقدم العديد من الخدمات التي تسهم في تمكين أصحاب العلاقة بما يسهم في تطوير<span>&nbsp; القطاع وتعزيز </span>نموه ورفع كفاءته.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/3a33a481ff2d4c75b0f78e74d19c6ed7\\\",\\\"title\\\":\\\"المستفيدون :\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<ul>\\\\\\\\n<li>\\\\\\\\n<p>رواد الأعمال <span>&nbsp;وأصحاب </span>المنشآت الناشئة</p>\\\\\\\\n</li>\\\\\\\\n<li>الشركات المحلية</li>\\\\\\\\n<li>الشركات العالمية</li>\\\\\\\\n</ul>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/cbb89a35f3fd4b5cb7b473f77f9cf215\\\",\\\"title\\\":\\\"المبادرات التابعة للمركز\\\",\\\"content\\\":null,\\\"listOfSubcontent\\\":\\\"{\\\\\\\"layout\\\\\\\":{\\\\\\\"Umbraco.BlockList\\\\\\\":[{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/19e5b30a0ac94e6a928590206a37294a\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/d625b07075144966b8a697edc2f4d21e\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/cc73c50281194e0784500396a04e51e3\\\\\\\"},{\\\\\\\"contentUdi\\\\\\\":\\\\\\\"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\\\\\\\"}]},\\\\\\\"contentData\\\\\\\":[{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/b7b7bbd6743042a390a38f6a1232ccc4\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"القمة العالمية للتقنية العقارية\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>تعزيز مكانة المملكة العربية السعودية في مجال التقنية العقارية وجذب الشركات والخبراء البارزين في هذا المجال.</p>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"listOfSubcontent\\\\\\\":null,\\\\\\\"button\\\\\\\":null,\\\\\\\"linkToPage\\\\\\\":\\\\\\\"umb://document/c3395462683542fd8c1378dd0fd2a0db\\\\\\\",\\\\\\\"form\\\\\\\":null,\\\\\\\"buttonToURL\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/cc73c50281194e0784500396a04e51e3\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"مجلس بروبتيك\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>جلسات حوارية تجمع الخبراء العاملين في قطاع التقنية العقارية لتبادل المعرفة والخبرات</p>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"listOfSubcontent\\\\\\\":null,\\\\\\\"button\\\\\\\":null,\\\\\\\"linkToPage\\\\\\\":\\\\\\\"umb://document/6bb3663f174746c0b49bc57485392f66\\\\\\\",\\\\\\\"form\\\\\\\":null,\\\\\\\"buttonToURL\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/19e5b30a0ac94e6a928590206a37294a\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"البيئة التنظيمية التجريبية\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>إجراء التجارب للتقنيات والمنتجات والخدمات واختبار توافقها مع الأنظمة والتشريعات الحالية أو اقتراح تعديلات عليها ، ويكون ذلك عبر بيئة واقعية<span>&nbsp; </span>و مرنة تختبر فاعلية التقنيات ونماذج الأعمال المبتكرة التي لها صلة بالتقنية العقارية</p>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"listOfSubcontent\\\\\\\":null,\\\\\\\"button\\\\\\\":null,\\\\\\\"linkToPage\\\\\\\":\\\\\\\"umb://document/36652cc6eff74f20be3816b554f1146c\\\\\\\",\\\\\\\"form\\\\\\\":null,\\\\\\\"buttonToURL\\\\\\\":null},{\\\\\\\"contentTypeKey\\\\\\\":\\\\\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\\\\\",\\\\\\\"udi\\\\\\\":\\\\\\\"umb://element/d625b07075144966b8a697edc2f4d21e\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"مسرعة الاعمال\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"{\\\\\\\\\\\\\\\"markup\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"<p>برنامج متقدم يركز على تسريع نمو وتوسع الشركات الريادية والناشئة في مجال التقنية العقارية</p>\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"blocks\\\\\\\\\\\\\\\":{\\\\\\\\\\\\\\\"contentData\\\\\\\\\\\\\\\":[],\\\\\\\\\\\\\\\"settingsData\\\\\\\\\\\\\\\":[]}}\\\\\\\",\\\\\\\"listOfSubcontent\\\\\\\":null,\\\\\\\"button\\\\\\\":null,\\\\\\\"linkToPage\\\\\\\":\\\\\\\"umb://document/a7565298ce4b4bba924efc1dfb9d1411\\\\\\\",\\\\\\\"form\\\\\\\":null,\\\\\\\"buttonToURL\\\\\\\":null}],\\\\\\\"settingsData\\\\\\\":[]}\\\",\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null}],\\\"settingsData\\\":[]}\"","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":