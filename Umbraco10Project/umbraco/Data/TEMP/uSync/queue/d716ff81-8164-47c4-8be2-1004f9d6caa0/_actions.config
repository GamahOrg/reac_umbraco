e85909ce4e5faefee78e8cc05eb8\\\"},{\\\"contentUdi\\\":\\\"umb://element/f7a5508aab11429fb547f8534fbba896\\\"},{\\\"contentUdi\\\":\\\"umb://element/31e11ad366984ce5ac5a900f7a54eec9\\\"},{\\\"contentUdi\\\":\\\"umb://element/740b50bfe26f42e9b0d6e976ad22a72a\\\"},{\\\"contentUdi\\\":\\\"umb://element/6a8ca639b080441a8d687f531c5bf30f\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c05cac4c65834858b70131a5e1470e98\\\",\\\"title\\\":\\\"المادة الأولى\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">1-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><!--[endif]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">يكون للألفاظ والمصطلحات الواردة في هذه اللائحة المعاني المُبينة أمام كل منها في المادة (الأولى) من نظام الوساطة العقارية الصادر بالمرسوم الملكي رقم: (م/130) في 30/11/1443هـ، ولائحته التنفيذية ما لم يقتض السياق خلاف ذلك.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.25in; line-height: 170%; mso-list: l0 level1 lfo1; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpLast\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">2-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span><!--[endif]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">يُقصد بالألفاظ والمصطلحات التالية -أينما وردت- في هذه اللائحة المعاني المُبينة أمام كل منها، ما لم يقتض السياق خلاف ذلك: </span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><strong>المزاد العقاري: </strong><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">المزايدة العلنية على عقار من أجل بيعه أو بيع منفعته أو تأجيره؛ للوصول بثمنه إلى أعلى قدر ويشمل ذلك المزادات الإلكترونية</span><span>.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><strong>المالك: </strong><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">شخص طبيعي أو اعتباري مالك للأصل أو المنفعة أو من يمثلهما نظاماً، المتعاقد مع الوسيط العقاري لإقامة المزاد العقاري.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><strong>المُقٍيم المعتمد: </strong><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">الشخص المرخص له بمزاولة مهنة التقييم العقاري وفق نظام المقيمين المعتمدين.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed; margin: 0in .25in 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><strong>المرخص له:</strong><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\"> شخص اعتباري مرخص له بممارسة خدمة المزادات العقارية. </span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-right: .25in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">مدير المزاد العقاري: </span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">شخص طبيعي مؤهل وتابع للمنشأة المرخصة مخول بالقيام بإدارة كافة أعمال المزاد العقاري لصالح المرخص له.</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/79e3a0c9cacb49daabd0ed32c54f5a5b\\\",\\\"title\\\":\\\"المادة الثانية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">يشترط للترخيص لممارسة خدمة المزادات العقارية - إضافة للاشتراطات الواردة في اللائحة التنفيذية لنظام الوساطة العقارية - للمنشآت التي تقدمها من خلال الوسائل الإلكترونية الآتي:</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">1- </span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">ربط منصة المزاد العقاري الإلكتروني الخاصة بالمرخص له، بالمنصة الإلكترونية للهيئة.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">2-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">التعهد بضمان سلامة العمليات التي تتم في منصة المرخص له، وإيقاف أو إعادة المزاد العقاري في الصفقات التي يشوبها أخطاء تقنية أو مخالفات، بما يضمن حماية تنافسية العرض والطلب. </span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">3-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">التعهد بنشر كافة بيانات المزادات العقارية المقامة على منصة المرخص له في المنصة الإلكترونية للهيئة. </span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">4-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">الحصول على كافة التراخيص النظامية اللازمة لممارسة النشاط، من الجهات ذات العلاقة.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">5-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">ربط المنصة الإلكترونية مع منصة النفاذ الوطني، ودخول المستفيدين للوسيلة الإلكترونية عن طريقه.</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/852a7f732dc6481ab3ed9572dc9c496e\\\",\\\"title\\\":\\\"المادة الثالثة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">يجب على المرخص له بممارسة المزادات العقارية، الالتزام بما يأتي:&nbsp;</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">1-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">التحلي بالنزاهة والإخلاص، والتعامل بحياد وعدل، وعدم التأثير على المنافسة العادلة بأي شكل.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">2-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">بذل العناية المهنية بحرص وإخلاص لتحقيق أفضل الأسعار.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">3-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">حفظ جميع نشرات المزادات العقارية وسجلاتها، </span>وتسجيل وقائع المزادات المرئية،<span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\"> والمستندات والبيانات لجميع تعاملاته لمدة (خمس) سنوات من تاريخ انتهاء المزاد العقاري.<strong><u>&nbsp;</u></strong></span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">4-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">إقامة المزاد العقاري خلال مدة سريان عقد الوساطة.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">5-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">الحصول على الموافقات اللازمة من الجهات ذات الاختصاص في إقامة المزاد العقاري.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">6- </span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">ممارسة الخدمة من قبل الأفراد المؤهلين التابعين للمرخص له والمسجلين لدى الهيئة.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">7- </span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">الالتزام بما تقضي به الأنظمة والتعليمات من الجهات ذات الاختصاص في ممارسة المزادات العقارية.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">8- </span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">الإعلان عن نشرة المزاد العقاري قبل (خمسة) أيام -بحد أدنى- من تاريخ إقامته.</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/ec2d3d4785ac416c91777b8a1bb241a8\\\",\\\"title\\\":\\\"المادة الرابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">على المرخص له تضمين عقد الوساطة لتقديم خدمة المزادات العقارية - إضافةً للأحكام الواردة لعقد الوساطة المنصوص عليها في النظام واللائحة التنفيذية - المعلومات التالية: </span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">1-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">طريقة إقامة المزاد العقاري</span>.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">2-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">تاريخ إقامة المزاد العقاري ومدته –إن وجد-.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">3-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">  </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">نوع التصرف بالعقار محل المزاد العقاري.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">4-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">  </span></span></span><!--[endif]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">الحد الأدنى لقيمة الترسية المقبولة للتصرف في العقار بعد المزايدة.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">5-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">الحد الأدنى لقيمة بدء المزاد العقاري.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">6-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">مبلغ الدخول في المزايدة - إن وجد –</span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">، </span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">على ألا يتجاوز المبلغ نسبة (5%) من القيمة التقديرية للعقار بناء على تقييم من مقيم معتمد.</span>، و<span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">تحديد نوع المبلغ (عربون – مقدم ثمن – تأمين مسترد).</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">7-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">  </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">المدة الزمنية المحددة للترسية على السعر الأعلى بعد المزايدة وإمكانية تمديدها لمدة مماثلة مرة واحدة. </span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">8-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">  </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">آليات ومدد تسلُّم وتسليم الثمن بعد الترسية.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">9- </span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\">الأحكام المتعلقة بالتصرف في العقار كحق الشفعة، وخيار المجلس، وخيار الشرط، وبيع العربون، وغير ذلك.</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b6e9fa213c2b47a3bce8ce4c654b2142\\\",\\\"title\\\":\\\"المادة الخامسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">تنشأ في المنصة الإلكترونية بالهيئة سجل المزادات العقارية، يقيد فيها الآتي:&nbsp;</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">&nbsp;</span>‌أ- </span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">سجل بيانات المرخص لهم.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">ب-</span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">بيانات كافة المزادات العقارية المنظَّمة من المرخص لهم، سواءً كانت إلكترونية أو غير إلكترونية.&nbsp;<br></span><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">ج-</span></span>نشر كافة المؤشرات الإحصائية للمزادات بشكل دوري.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a1a8f4a3aa4b4898b49eed440a1ceebd\\\",\\\"title\\\":\\\"المادة السادسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">يتقدم المرخص له للهيئة بطلب إقامة المزاد العقاري في المنصة الإلكترونية للهيئة، وتعبئة النموذج المعتمد -قبل إقامته- بخمسة عشر يوماً -بحدٍ أدنى-، مرفقاً به البيانات والمتطلبات التالية: </span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">1-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">  </span></span></span><!--[endif]-->تحديد مكان وطريقة<span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\"> إقامة المزاد العقاري.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">2-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">  </span></span></span><!--[endif]-->تاريخ<span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\"> إقامة المزاد العقاري ومدته.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">3-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\">  </span></span></span><!--[endif]-->تحديد مدير المزاد العقاري التابع له.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">4-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span>نوع التصرف بالعقار محل المزاد العقاري.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">5-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">آليات حفظ أموال المتنافسين في المزاد العقاري.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">6-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt';\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">آليات المزايدة والترسية الواردة في الفقرات (5-9) من المادة الرابعة من اللائحة.</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"margin-bottom: 0in; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 170%; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\">7-<span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span></span></span><!--[endif]-->تسجيل بيانات<span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\"> العقار محل المزاد العقاري، بما يشمل الآتي:</span></p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpMiddle\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span>‌أ-   </span></span><!--[endif]-->بيانات مالك العقار أو مالك المنفعة.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpMiddle\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: '29LT Bukra Lt'; mso-fareast-font-family: '29LT Bukra Lt'; mso-bidi-language: AR-EG;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-EG\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"mso-list: Ignore;\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font: 7.0pt 'Times New Roman';\\\\\\\\\\\\\\\"> </span>‌ب- </span></span>البيانات المساحية والموقع، ومواصفات العقار، وحالته.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: right; text-indent: -63.0pt; mso-text-indent-alt: -4.5pt; line-height: 170%; mso-list: l1 level1 lfo1; tab-stops: 63.0pt; direction: rtl; unicode-bidi: embed; margin: 0in 63.0pt 0in 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpMiddle\\\\\\\\\\\\\\\"><!-- [if !supportLists]--><span style=\\\\