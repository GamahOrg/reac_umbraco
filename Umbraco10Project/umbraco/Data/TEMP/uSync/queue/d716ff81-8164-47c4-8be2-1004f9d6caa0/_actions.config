element/e74a587eaf754f2d88fc2620a5531af5\\\"},{\\\"contentUdi\\\":\\\"umb://element/6fd6d89056954026a99b1a1c884226ac\\\"},{\\\"contentUdi\\\":\\\"umb://element/0a6278b33648411eb7b02d115f67e040\\\"},{\\\"contentUdi\\\":\\\"umb://element/342fba226d1941d095e68538643ed3de\\\"},{\\\"contentUdi\\\":\\\"umb://element/b931d7fa4c084b83b59da67c466b257b\\\"},{\\\"contentUdi\\\":\\\"umb://element/d6c032e25ef44373874c00965e284330\\\"},{\\\"contentUdi\\\":\\\"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\\\"},{\\\"contentUdi\\\":\\\"umb://element/674a2b32805941c2b0373e34362dbb7d\\\"},{\\\"contentUdi\\\":\\\"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\\\"},{\\\"contentUdi\\\":\\\"umb://element/40406dc0b63b4099949a586a0c82a6c6\\\"},{\\\"contentUdi\\\":\\\"umb://element/cc1c02eb03f647548b12b005d8f43746\\\"},{\\\"contentUdi\\\":\\\"umb://element/e1c348807837435489a5eb1211f5ba61\\\"},{\\\"contentUdi\\\":\\\"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\\\"},{\\\"contentUdi\\\":\\\"umb://element/d612cfe14bf14cb7ab652defcbebdb38\\\"},{\\\"contentUdi\\\":\\\"umb://element/d55057c1b63e4368ba259bd73b71e28b\\\"},{\\\"contentUdi\\\":\\\"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\\\"},{\\\"contentUdi\\\":\\\"umb://element/5335c4abccd1432085427142b20f971a\\\"},{\\\"contentUdi\\\":\\\"umb://element/b371a42c33134857bcc242df90c35a88\\\"},{\\\"contentUdi\\\":\\\"umb://element/147331097a0e43858e1a75cdc7f7121e\\\"},{\\\"contentUdi\\\":\\\"umb://element/1366bc6855484252aa606d86d6420e02\\\"},{\\\"contentUdi\\\":\\\"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\\\"},{\\\"contentUdi\\\":\\\"umb://element/b774c422073c4e5a8dc8b615a83522ce\\\"},{\\\"contentUdi\\\":\\\"umb://element/ca216527e91f48169265efcb0d9c370e\\\"},{\\\"contentUdi\\\":\\\"umb://element/84752c5033a24474bd325242a0bfa204\\\"},{\\\"contentUdi\\\":\\\"umb://element/9883a7f483ce46358a9fa6663cdd1c55\\\"},{\\\"contentUdi\\\":\\\"umb://element/8b6bd1715d84484fb92035e624052563\\\"},{\\\"contentUdi\\\":\\\"umb://element/21acca51fd7f4c8da3c05137408e4b5e\\\"},{\\\"contentUdi\\\":\\\"umb://element/4e1d9e14705b424aa9d41dd63b21f843\\\"},{\\\"contentUdi\\\":\\\"umb://element/13404ff744484e4bb1effaac223f115f\\\"},{\\\"contentUdi\\\":\\\"umb://element/a2111fc87afb4e9a83e417a7a38826bc\\\"},{\\\"contentUdi\\\":\\\"umb://element/7d03602ad865430c99c9918bd6fbdc56\\\"},{\\\"contentUdi\\\":\\\"umb://element/916f04b4c1e6429cbd0a0883f719fc08\\\"},{\\\"contentUdi\\\":\\\"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\\\"},{\\\"contentUdi\\\":\\\"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\\\"},{\\\"contentUdi\\\":\\\"umb://element/dd04e28aeea94a41a276d4ea396a07fe\\\"},{\\\"contentUdi\\\":\\\"umb://element/50f928cc58d44dca9ec37f82ac5ea034\\\"},{\\\"contentUdi\\\":\\\"umb://element/7569c1f0c6144484944ee6521cfdfa22\\\"},{\\\"contentUdi\\\":\\\"umb://element/0405884f68a7490bbb84d74f3b042946\\\"},{\\\"contentUdi\\\":\\\"umb://element/4ed52ae5a0a241739d21eed54d35f741\\\"},{\\\"contentUdi\\\":\\\"umb://element/1a25d4098f9447b7892ee35140689550\\\"},{\\\"contentUdi\\\":\\\"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\\\"},{\\\"contentUdi\\\":\\\"umb://element/b2e332fab7644d97a4838a65e92697b9\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\\\",\\\"title\\\":\\\"المادة الأولى\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يقصد بالكلمات والعبارات الآتية -أينما وردت في هذا النظام- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\\\\\\\n<p><strong>النظام:</strong> نظام التسجيل العيني للعقار.</p>\\\\\\\\n<p><strong>الجهة المختصة:</strong> الجهة التي يصدر بتحديدها قرار من مجلس الوزراء.</p>\\\\\\\\n<p><strong>المسؤول الأول: </strong>المسؤول الأول، أو مجلس الإدارة، في الجهة المختصة؛ بحسب الأحوال.</p>\\\\\\\\n<p><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.</p>\\\\\\\\n<p><strong>العقار: </strong>قطعة من الأرض وما تحتها وما فوقها -ويستثنى من ذلك الثروات الطبيعية، والعلو غير المأذون بعمارته واستغلاله- وما عليها من بناء أو ملحقات ثابتة أو مزروعات أو مصانع أو منشآت أخرى كالموانئ والمطارات وخطوط الكهرباء والأنابيب وغيرها.</p>\\\\\\\\n<p><strong>الحق العقاري:</strong> سلطة مباشرة مقرة نظاماً لشخص -ذي صفة طبيعية أو اعتبارية- أو أكثر على عقار معين تخوله التصرف فيه أو الاستئثار بمنافعه أو ببعضها.&nbsp;</p>\\\\\\\\n<p><strong>السجل العقاري: </strong>مجموعة وثائق تبين أوصاف العقار وموقعه وحالته المادية والنظامية، وما يتبعه من حقوق والتزامات، والتعديلات التي تطرأ على ذلك، في ضوء الوثائق المعتبرة نظاماً.</p>\\\\\\\\n<p><strong>التسجيل العيني:</strong> جعل العقار محل الحق العقاري أساساً لقيد الحق.&nbsp;</p>\\\\\\\\n<p><strong>التسجيل العيني الأول:</strong> تسجيل العقار باسم مالكه لأول مرة في السجل العقاري، وفقاً للإجراءات الواردة في النظام واللائحة.</p>\\\\\\\\n<p><strong>المسجِّل العقاري:</strong> من يقوم بتوثيق التسجيل العيني الأول، وما يرد على العقار من تصرفات أو تغييرات في وصفه، وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p><strong>المنطقة العقارية:</strong> موقع أرض يحدده قرار صادر من الجهة المختصة، يكون خاضعاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p><strong>صك تسجيل الملكية:</strong> وثيقة صادرة عن السجل العقاري لإثبات بيانات عقار مطابقة للسجل، وفقاً للنموذج الذي تحدده اللائحة، تتضمن: موقع العقار، وحدوده، ووصفه، واستعماله، وما يتبعه من حقوق والتزامات، وبيانات مالكه، وأي بيانات أخرى تحددها اللائحة.</p>\\\\\\\\n<p><strong>الخارطة:</strong> رسم هندسي مساحي مبني على نظام إحداثيات وطني، يبين: موقع العقار، وحدوده، ومعالمه، وأرقامه، ومساحته، وأي بيانات رقمية وتصويرية أخرى.</p>\\\\\\\\n<p><strong>المالك:</strong> شخص ذو صفة طبيعية أو اعتبارية يثبت السجل العقاري حق ملكية عقار له.</p>\\\\\\\\n<p><strong>المقابل المالي: </strong>مبلغ مستحق مقابل خدمات التسجيل العيني وفقا للنظام واللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/11bf4e8d99214b5785ae09cb55f733ab\\\",\\\"title\\\":\\\"المادة الثانية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يسري النظام على جميع العقارات الواقعة في إقليم المملكة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b353f481cedf4159b317178e95c565b2\\\",\\\"title\\\":\\\"المادة الثالثة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تختص الجهة المختصة بالتسجيل العيني، ولها الاستعانة بالجهات الحكومية أو الإسناد إلى الجهات الخاصة لأداء ما تراه من اختصاصاتها المتعلقة بذلك؛ وفقاً للشروط والضوابط التي تضعها.<br>2- تنشئ الجهة المختصة السجل العقاري وتشرف على كل ما يخصه، وتقوم بجميع الإجراءات المتعلقة به.<br>3- تضمن الجهة المختصة صحة معلومات وبيانات العقار ودقّتها، وما يتبعه من حقوق والتزامات، الواردة في السجل العقاري وما ينشأ عنه من صكوك ووثائق.<br>4-تقوم الجهة المختصة بأعمال المساحة المتعلقة بإجراءات التسجيل العيني، وفقاً للائحة والمعايير الجيومكانية الوطنية المعتمدة من جهة الاختصاص، ويمكن -دون إخلال بالأنظمة والتنظيمات ذات العلاقة- استخدام وسائل المساحة الحديثة -بما فيها التصوير الجوي والفضائي وغيرها من التقنيات- عند تنفيذ تلك الأعمال. وتحدد اللائحة إجراءات ذلك.<br>5-تملك الجهة المختصة حصرياً السجل العقاري وبياناته، ولها استثمار بيانات السجل بأنواع الاستغلال التجاري، وإتاحتها للمستفيدين بأسعار عادلة تدعم التنمية، على النحو الذي تحدده اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/dbbd47dec7a643b686723e3a5ae76b66\\\",\\\"title\\\":\\\"المادة الرابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يكون للسجل العقاري الحجية المطلقة في الإثبات وفقاً لأحكام النظام، ويعمل بمضمونه أمام القضاء والجهات كافة بلا بينة إضافية، ولا يجوز الطعن فيه إلا إذا كان الطعن بسبب خطأ كتابي أو تزوير.<br>2-يجب أن يحتوي السجل العقاري على أوصاف العقار، وجميع الحقوق العينية التي ترد عليه والالتزامات التي تتبعه، وأي تعديلات تطرأ على ذلك.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/fd189eec716d497ebef259ade307e988\\\",\\\"title\\\":\\\"المادة الخامسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- لا تعدل بيانات السجل العقاري ولا يجرى أي تغيير عليه، إلا وفقاً لأحكام النظام واللائحة.<br>2-تصحح الجهة المختصة الأخطاء الكتابية والمادية البحتة بناءً على طلب من أي ذي مصلحة أو من تلقاء نفسها، مع إشعار ذوي الشأن بذلك بالوسيلة التي تحددها اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e74a587eaf754f2d88fc2620a5531af5\\\",\\\"title\\\":\\\"المادة السادسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون الاطلاع على بيانات السجل العقاري متاحاً للكافة، وذلك وفقا لما يحدده النظام واللائحة، ويستثنى من ذلك العقارات التي تحدد الجهات المعنية أنها سرية.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0a6278b33648411eb7b02d115f67e040\\\",\\\"title\\\":\\\"المادة السابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تحدد المنطقة العقارية بقرار يصدر عن الجهة المختصة، على أن يتضمن القرار تحديداً دقيقاً وبمعالم واضحة للمنطقة والمدة المحددة لاستقبال طلبات التسجيل العيني الأول، ويعلن عنها بأي وسيلة مناسبة يحددها القرار.<br>2-تختص الجهة المختصة بالتسجيل العيني الأول لكل عقار واقع في المنطقة العقارية وتسجيل أي تصرفات لاحقة ترد عليه.&nbsp;<br>3-توثق التصرفات العقارية التي تقع على العقار الواقع في المنطقة العقارية، والتي تجري خلال فترة إجراءات التسجيل العيني الأول، وفقاً للإجراءات التي تحددها اللائحة.&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/342fba226d1941d095e68538643ed3de\\\",\\\"title\\\":\\\"المادة الثامنة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يشترط للتسجيل العيني الأول الآتي:<br>أ- أن يكون للعقار -ما عدا العقارات المملوكة للدولة- صك ملكية مستوفٍ للمتطلبات النظامية.</p>\\\\\\\\n<p>ب- أن يكون العقار مكتمل البيانات الجيومكانية.</p>\\\\\\\\n<p>وتحدد اللائحة إجراءات التسجيل العيني الأول.</p>\\\\\\\\n<p>2-على كل من تطلب منه الجهة المختصة، الإفصاح عن أي مستندات أو بيانات لازمة لصحة وسلامة التسجيل العيني الأول.<br>3تجري الجهة المختصة الأعمال المساحية اللازمة للتسجيل العيني الأول، ولها -دون أن تجري تلك الأعمال- استخدام البيانات المتعلقة بالأعمال المساحية المعتمدة من جهة الاختصاص في حال توفرها وفق ما تحدده اللائحة.<br>4-يصدر صك تسجيل الملكية للعقار بعد استكمال الإجراءات اللازمة، وفقاً لأحكام النظام واللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b931d7fa4c084b83b59da67c466b257b\\\",\\\"title\\\":\\\"المادة التاسعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تعد الجهة المختصة قوائم للملاك بناء على صكوك تسجيل الملكية الصادرة بناء على أحكام النظام، على أن تشمل تلك القوائم بيانات الصكوك التي تحددها اللائحة.<br>2-تنشر الجهة المختصة قوائم الملاك -المشار إليها في الفقرة (1) من هذه المادة- بالوسائل المناسبة التي تحددها اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d6c032e25ef44373874c00965e284330\\\",\\\"title\\\":\\\"المادة العاشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لكل ذي مصلحة الاعتراض على التسجيل العيني الأول أمام المحكمة المختصة ما لم يكتسب التسجيل الحجية المطلقة وفقاً لأحكام النظام.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\\\",\\\"title\\\":\\\"المادة الحادية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-في حال قيد دعوى قضائية تتعلق بالتسجيل العيني الأول وفق ما أشير إليه في المادة (العاشرة) من النظام، فيتم التأشير بها في السجل العقاري وقوائم الملاك، ويضمن في السجل مضمون الحكم النهائي الصادر في شأن الدعوى.<br>وتحدد اللائحة إجراءات وأحكام التأشير في السجل العقاري، وفي قوائم الملاك.</p>\\\\\\\\n<p>2-يكتسب التسجيل العيني الأول الحجية المطلقة بعد انقضاء سنة من تاريخ نشر قوائم الملاك، وللمتضرر من التسجيل العيني الأول بعد اكتسابه الحجية المطلقة حق اللجوء إلى المحكمة المختصة وطلب التعويض من المتسبب دون الحق في طلب إلغاء التسجيل العيني الأول أو تعديل بياناته أو الحقوق الواردة فيه.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/674a2b32805941c2b0373e34362dbb7d\\\",\\\"title\\\":\\\"المادة الثانية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; mso-outline-level: 3; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">لملاك العقارات طلب تسجيل عقاراتهم -الواقعة خارج نطاق المنطقة العقارية- في السجل العقاري وفقاً للشروط والضوابط التي تحددها اللائحة.</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/40406dc0b63b4099949a586a0c82a6c6\\\",\\\"title\\\":\\\"المادة الثالثة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تسجل في السجل العقاري جميع التصرفات اللاحقة للتسجيل العيني الأول للعقار، والتي من شأنها إنشاء أي من الحقوق العينية الأصلية أو التبعية أو نقله أو تغييره أو زواله، أو تعديل بيانات العقار، وكذلك الأحكام النهائية المثبتة لشيء من ذلك، ولا تكون تلك الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل. ويدخل في تلك التصرفات القسمة العقارية والوصية والوقف والإرث والرهن والمنح ونحوها.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/cc1c02eb03f647548b12b005d8f43746\\\",\\\"title\\\":\\\"المادة الرابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب التأشير بجميع عقود الإيجار والالتزامات الموثقة نظاماً التي ترد على منفعة العقار إذا كانت مدتها (عشر) سنوات فأكثر، والأحكام النهائية المثبتة لشيء من ذلك، في السجل العقاري، ولا تكون هذه الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التأشير.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e1c348807837435489a5eb1211f5ba61\\\",\\\"title\\\":\\\"المادة الخامسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تقوم الجهات المعنية -وفق آلية تتفق عليها الجهة المختصة مع كل منها- بتزويد السجل العقاري بوقائع وفاة ملاك العقارات وصكوك حصر ورثتهم.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\\\",\\\"title\\\":\\\"المادة السادسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب التأشير بالدعاوى المتعلقة بحق عيني عقاري أو بتصرف من التصرفات الواجب تسجيلها، في السجل العقاري، متى تضمنت هذه الدعاوى إجراء تغيير في بيانات السجل، ولا تُسمع الدعوى إلا بعد تقديم ما يثبت حصول التأشير بمضمون الدعوى في السجل.</p>\\\\\\\\n<p>ولكل ذي مصلحة أن يقدم طلباً إلى المحكمة المختصة بصفة مستعجلة لمحو التأشير المشار إليه أعلاه، وتأمر المحكمة بمحوه متى تبين لها أن الدعوى التي تم التأشير بها كيدية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d612cfe14bf14cb7ab652defcbebdb38\\\",\\\"title\\\":\\\"المادة السابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يترتب على التأشير بالدعاوى -المشار إليها في المادة (السادسة عشرة) من النظام- أن يكون أي حق تقرر بحكم نهائي في هذه الدعاوى حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d55057c1b63e4368ba259bd73b71e28b\\\",\\\"title\\\":\\\"المادة الثامنة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب التأشير بإعلان الرغبة في الأخذ بالشفعة في السجل العقاري، ويترتب على ذلك أن يكون حق الشفيع إذا تقرر بحكم نهائي حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\\\",\\\"title\\\":\\\"المادة التاسعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تحدد اللائحة آليات تسجيل الأحكام المشار إليها في المادتين (السابعة عشرة) و(الثامنة عشرة) من النظام في السجل العقاري.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5335c4abccd1432085427142b20f971a\\\",\\\"title\\\":\\\"المادة العشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يقدم ذو الشأن طلب التسجيل أو التأشير في السجل العقاري إلى الجهة المختصة، ويرفق بالطلب المستندات المؤيدة له التي تحددها اللائحة، وعلى الجهة المختصة تدوين الطلب وفقًا لتاريخ تقديمه وساعته على النحو الذي تحدده اللائحة، ويعد طلب التسجيل كأن لم يكن إذا لم يقدم ذو الشأن تلك المستندات خلال (ثلاثين) يوماً من تاريخ تقديم الطلب، ولا يجوز إجراء أي تسجيل إذا تضمن السجل العقاري قيوداً تمنع التصرف في العقار.<br>2-مع مراعاة ما ورد في الفقرة (1) من هذه المادة، إذا قدم إلى الجهة المختصة أكثر من طلب لتسجيل التصرفات أو التأشير بها في شأن العقار ذاته؛ وجب بحثها وفقًا لأسبقية تسجيل الطلب، وذلك على النحو الذي تحدده اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b371a42c33134857bcc242df90c35a88\\\",\\\"title\\\":\\\"المادة الحادية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لمن أُبلغ برفض طلبه بالتسجيل أو التأشير في السجل العقاري، أو بسقوط أسبقيته، أو بوقف الإجراءات؛ أن يتظلم أمام الجهة المختصة خلال (ثلاثين) يوماً من تاريخ الإبلاغ، وعليها البت في التظلم خلال (ثلاثين) يوماً من تقديمه، فإذا قبلت تظلمه أمرت بالتسجيل أو التأشير. أما إن رفضته أو لم تتخذ قرارًا في شأنه خلال تلك المدة، فلمقدمه التظلم أمام المحكمة المختصة خلال (ثلاثين) يوماً من تاريخ إبلاغه برفض تظلمه أمام الجهة المختصة أو من تاريخ انتهاء المدة المحددة لاتخاذ القرار بشأن التظلم دون اتخاذه، أيهما أسبق، ويوقف النظر في الطلبات اللاحقة إلى حين الفصل في التظلم.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/147331097a0e43858e1a75cdc7f7121e\\\",\\\"title\\\":\\\"المادة الثانية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>مع مراعاة ما تضمنته المادة (العشرون) من النظام، يسجل مضمون المحررات الموثقة نظاماً الواردة من الجهات المعنية في السجل العقاري طبقاً لترتيب ورودها إلى الجهة المختصة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/1366bc6855484252aa606d86d6420e02\\\",\\\"title\\\":\\\"المادة الثالثة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على الجهات المعنية بإصدار رخص متعلقة بالعقارات واستعمالاتها إشعار الجهة المختصة بالرخص التي تصدرها أو تلغيها للعقارات الواقعة في المنطقة العقارية؛ للتأشير بها في السجل العقاري.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\\\",\\\"title\\\":\\\"المادة الرابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب على مالك العقار إبلاغ الجهة المختصة بأي تغيير يطرأ على وصف العقار بسبب إنشاء مبانٍ أو إضافتها أو تعديلها أو إزالتها، خلال (تسعين) يومًا من تاريخ حدوث التغيير، وتتخذ الجهة المختصة الإجراءات اللازمة لتحديث بيانات السجل العقاري بما يتوافق مع ذلك على النحو الذي تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b774c422073c4e5a8dc8b615a83522ce\\\",\\\"title\\\":\\\"المادة الخامسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للجهة المختصة -من تلقاء نفسها- أن تتخذ الإجراءات اللازمة لتحديث بيانات السجل العقاري بإضافة أي تغيير مرخص به على عقار قائم على الطبيعة غير مثبت في السجل. وتقوم الجهة المختصة بإشعار ذوي الشأن بهذا التحديث.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/ca216527e91f48169265efcb0d9c370e\\\",\\\"title\\\":\\\"المادة السادسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للمتضرر من تسجيل التصرفات العقارية حق التقدم للمحكمة المختصة بطلب التعويض من المتسبب فيه.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/84752c5033a24474bd325242a0bfa204\\\",\\\"title\\\":\\\"المادة السابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لصاحب حق الانتفاع على العقار تسجيل التصرف فيه في السجل العقاري دون إذن مالك العقار، ما لم يُتفق على غير ذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9883a7f483ce46358a9fa6663cdd1c55\\\",\\\"title\\\":\\\"المادة الثامنة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يكون لكل وحدة عقارية مفرزة واقعة في عقار مشترك، صك تسجيل ملكية خاص بها.<br>2-يجب تسجيل وثائق الملكية المشتركة التي تحددها اللائحة في السجل العقاري.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/21acca51fd7f4c8da3c05137408e4b5e\\\",\\\"title\\\":\\\"المادة التاسعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنشئ الجهة المختصة سجلاً للعقارات الموصوفة على الخارطة مرتبطاً بالسجل العقاري، وتحدد اللائحة إجراءات ذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4e1d9e14705b424aa9d41dd63b21f843\\\",\\\"title\\\":\\\"المادة الثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تُسجل جميع التصرفات التي ترد على العقارات الموصوفة على الخارطة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام، وتحدد اللائحة إجراءات التسجيل، ويُصدر السجل شهادة بذلك، ولا تكون هذه التصرفات نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/13404ff744484e4bb1effaac223f115f\\\",\\\"title\\\":\\\"المادة الحادية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-على مالك العقار خلال (ثلاثين) يوماً من اكتمال إنجاز العقار الموصوف على الخارطة تقديم طلب لتحويل بياناته الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.<br>2-يجوز -بناء على قرار صادر من الجهة المعنية بإصدار ترخيص التصرف في العقار الموصوف على الخارطة- اتخاذ الإجراءات اللازمة لتحويل بيانات العقار الموصوف على الخارطة الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7d03602ad865430c99c9918bd6fbdc56\\\",\\\"title\\\":\\\"المادة الثانية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط فيمن يمارس الأعمال المساحية المتعلقة بالتسجيل العيني أن يكون مرخصاً من الجهة ذات الاختصاص، ومقيداً في سجل تعده الجهة المختصة لهذا الغرض. وتحدد اللائحة الإجراءات والشروط اللازمة للقيد في هذا السجل.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/916f04b4c1e6429cbd0a0883f719fc08\\\",\\\"title\\\":\\\"المادة الثالثة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يكون فرز العقار أو دمجه في السجل العقاري بعد موافقة الجهة المعنية بالفرز أو الدمج، ووفقاً للإجراءات التي تحددها اللائحة.<br>2-إذا تم فرز العقار المحمل بحق عقاري إلى عقارين أو أكثر، يعد كل عقار جديد محملاً بذلك الحق كاملاً، ما لم يتفق ذوو الشأن على غير ذلك.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\\\",\\\"title\\\":\\\"المادة الرابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بمجانية إجراءات التسجيل العيني الأول، وما تضمنته الفقرة (5) من المادة (الثالثة) من النظام، يُحصل مقابل مالي لخدمات التسجيل العيني وفقاً لجدول تعده الجهة المختصة لهذا الغرض يعتمد بقرار من مجلس الوزراء.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/50f928cc58d44dca9ec37f82ac5ea034\\\",\\\"title\\\":\\\"المادة الخامسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بأي عقوبة أشد ينص عليها أي نظام آخر، يعاقب بغرامة لا تتجاوز مائة ألف ريال كل من:</p>\\\\\\\\n<p>1-امتنع عن الإفصاح -المشار إليه في الفقرة (2) من المادة (الثامنة)- عن أي مستندات أو بيانات لازمة لصحة وسلامة إجراءات التسجيل العيني الأول.<br>2-عاق عمل الجهة المختصة المتعلق بإجراءات التسجيل العيني.<br>3-تخلف عن الإبلاغ المشار إليه في المادة (الرابعة والعشرين) من النظام.<br>4-تخلف عن تقديم الطلب المشار إليه في الفقرة (1) من المادة (الحادية والثلاثين) من النظام خلال المدة المحددة في الفقرة.<br>5-تخلف عن تقديم طلب التسجيل العيني الأول لعقاره خلال المدة المحددة لتقديم الطلبات المشار إليها في الفقرة (1) من المادة (السابعة) من النظام.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7569c1f0c6144484944ee6521cfdfa22\\\",\\\"title\\\":\\\"المادة السادسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تُشكّل بقرار من المسؤول الأول لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة، يكون أحدهم حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-تختص اللجنة بالنظر في المخالفات وإيقاع العقوبة المنصوص عليها في المادة (الخامسة والثلاثين) من النظام.<br>3-تحدد قواعد وإجراءات عمل اللجنة ومكافآت أعضائها بقرار من المسؤول الأول.<br>4-يجوز الاعتراض على قرارات اللجنة أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ العلم بها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4ed52ae5a0a241739d21eed54d35f741\\\",\\\"title\\\":\\\"المادة السابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في المسجل العقاري الآتي:</p>\\\\\\\\n<p>1-أن يكون حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-ألا يكون سبق أن حُكم عليه بجريمة مخلة بالشرف والأمانة ولو رد إليه اعتباره.<br>3-أن يجتاز دورة تأهيلية في نظام التسجيل العيني للعقار على النحو الذي تحدده اللائحة.<br>4-أي شرط آخر تحدده اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/1a25d4098f9447b7892ee35140689550\\\",\\\"title\\\":\\\"المادة الثامنة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تصدر الجهة المختصة اللائحة –بالاتفاق مع وزارة العدل- خلال (تسعين) يوماً من تاريخ نشر النظام في الجريدة الرسمية، ويعمل بها مع نفاذه.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\\\",\\\"title\\\":\\\"المادة التاسعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحل النظام محل نظام التسجيل العيني للعقار الصادر بالمرسوم الملكي رقم ( م / 6 ) وتاريخ 11/ 2 / 1423هـ، ويُلغى كل ما يتعارض معه من أحكام.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b2e332fab7644d97a4838a65e92697b9\\\",\\\"title\\\":\\\"المادة الأربعون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يعمل بالنظام بعد (تسعين) يوماً من تاريخ نشره في الجريدة الرسمية</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\\\",\\\"title\\\":\\\"الفصل الثامن: رسوم التسجيل والمقابل المالي للخدمات المضافة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/dd04e28aeea94a41a276d4ea396a07fe\\\",\\\"title\\\":\\\"الفصل التاسع: العقوبات\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0405884f68a7490bbb84d74f3b042946\\\",\\\"title\\\":\\\"الفصل العاشر: الأحكام الختامية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/41afd6cd459449b5a157d8c164d0decc\\\",\\\"title\\\":\\\"الفصل الأول: الأحكام العامة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5b704638459e4a72b3d96c3d1fb20439\\\",\\\"title\\\":\\\"الفصل الثاني: اختصاص الجهة المختصة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\\\",\\\"title\\\":\\\"الفصل الثالث: السجل العقاري\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6fd6d89056954026a99b1a1c884226ac\\\",\\\"title\\\":\\\"الفصل الرابع: التسجيل العيني الأول\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\\\",\\\"title\\\":\\\"الفصل الخامس: تسجيل التصرفات العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/8b6bd1715d84484fb92035e624052563\\\",\\\"title\\\":\\\"الفصل السادس: سجل التصرف في العقار الموصوف على الخارطة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a2111fc87afb4e9a83e417a7a38826bc\\\",\\\"title\\\":\\\"الفصل السابع: أعمال المساحة والفرز\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null}],\\\"settingsData\\\":[]}\"","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/41afd6cd459449b5a157d8c164d0decc\\\"},{\\\"contentUdi\\\":\\\"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\\\"},{\\\"contentUdi\\\":\\\"umb://element/11bf4e8d99214b5785ae09cb55f733ab\\\"},{\\\"contentUdi\\\":\\\"umb://element/5b704638459e4a72b3d96c3d1fb20439\\\"},{\\\"contentUdi\\\":\\\"umb://element/b353f481cedf4159b317178e95c565b2\\\"},{\\\"contentUdi\\\":\\\"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\\\"},{\\\"contentUdi\\\":\\\"umb://element/dbbd47dec7a643b686723e3a5ae76b66\\\"},{\\\"contentUdi\\\":\\\"umb://element/fd189eec716d497ebef259ade307e988\\\"},{\\\"contentUdi\\\":\\\"umb://element/e74a587eaf754f2d88fc2620a5531af5\\\"},{\\\"contentUdi\\\":\\\"umb://element/6fd6d89056954026a99b1a1c884226ac\\\"},{\\\"contentUdi\\\":\\\"umb://element/0a6278b33648411eb7b02d115f67e040\\\"},{\\\"contentUdi\\\":\\\"umb://element/342fba226d1941d095e68538643ed3de\\\"},{\\\"contentUdi\\\":\\\"umb://element/b931d7fa4c084b83b59da67c466b257b\\\"},{\\\"contentUdi\\\":\\\"umb://element/d6c032e25ef44373874c00965e284330\\\"},{\\\"contentUdi\\\":\\\"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\\\"},{\\\"contentUdi\\\":\\\"umb://element/674a2b32805941c2b0373e34362dbb7d\\\"},{\\\"contentUdi\\\":\\\"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\\\"},{\\\"contentUdi\\\":\\\"umb://element/40406dc0b63b4099949a586a0c82a6c6\\\"},{\\\"contentUdi\\\":\\\"umb://element/cc1c02eb03f647548b12b005d8f43746\\\"},{\\\"contentUdi\\\":\\\"umb://element/e1c348807837435489a5eb1211f5ba61\\\"},{\\\"contentUdi\\\":\\\"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\\\"},{\\\"contentUdi\\\":\\\"umb://element/d612cfe14bf14cb7ab652defcbebdb38\\\"},{\\\"contentUdi\\\":\\\"umb://element/d55057c1b63e4368ba259bd73b71e28b\\\"},{\\\"contentUdi\\\":\\\"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\\\"},{\\\"contentUdi\\\":\\\"umb://element/5335c4abccd1432085427142b20f971a\\\"},{\\\"contentUdi\\\":\\\"umb://element/b371a42c33134857bcc242df90c35a88\\\"},{\\\"contentUdi\\\":\\\"umb://element/147331097a0e43858e1a75cdc7f7121e\\\"},{\\\"contentUdi\\\":\\\"umb://element/1366bc6855484252aa606d86d6420e02\\\"},{\\\"contentUdi\\\":\\\"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\\\"},{\\\"contentUdi\\\":\\\"umb://element/b774c422073c4e5a8dc8b615a83522ce\\\"},{\\\"contentUdi\\\":\\\"umb://element/ca216527e91f48169265efcb0d9c370e\\\"},{\\\"contentUdi\\\":\\\"umb://element/84752c5033a24474bd325242a0bfa204\\\"},{\\\"contentUdi\\\":\\\"umb://element/9883a7f483ce46358a9fa6663cdd1c55\\\"},{\\\"contentUdi\\\":\\\"umb://element/8b6bd1715d84484fb92035e624052563\\\"},{\\\"contentUdi\\\":\\\"umb://element/21acca51fd7f4c8da3c05137408e4b5e\\\"},{\\\"contentUdi\\\":\\\"umb://element/4e1d9e14705b424aa9d41dd63b21f843\\\"},{\\\"contentUdi\\\":\\\"umb://element/13404ff744484e4bb1effaac223f115f\\\"},{\\\"contentUdi\\\":\\\"umb://element/a2111fc87afb4e9a83e417a7a38826bc\\\"},{\\\"contentUdi\\\":\\\"umb://element/7d03602ad865430c99c9918bd6fbdc56\\\"},{\\\"contentUdi\\\":\\\"umb://element/916f04b4c1e6429cbd0a0883f719fc08\\\"},{\\\"contentUdi\\\":\\\"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\\\"},{\\\"contentUdi\\\":\\\"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\\\"},{\\\"contentUdi\\\":\\\"umb://element/dd04e28aeea94a41a276d4ea396a07fe\\\"},{\\\"contentUdi\\\":\\\"umb://element/50f928cc58d44dca9ec37f82ac5ea034\\\"},{\\\"contentUdi\\\":\\\"umb://element/7569c1f0c6144484944ee6521cfdfa22\\\"},{\\\"contentUdi\\\":\\\"umb://element/0405884f68a7490bbb84d74f3b042946\\\"},{\\\"contentUdi\\\":\\\"umb://element/4ed52ae5a0a241739d21eed54d35f741\\\"},{\\\"contentUdi\\\":\\\"umb://element/1a25d4098f9447b7892ee35140689550\\\"},{\\\"contentUdi\\\":\\\"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\\\"},{\\\"contentUdi\\\":\\\"umb://element/b2e332fab7644d97a4838a65e92697b9\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/70e5c00a217c495b9cad9e4e0ee71fee\\\",\\\"title\\\":\\\"المادة الأولى\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يقصد بالكلمات والعبارات الآتية -أينما وردت في هذا النظام- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:</p>\\\\\\\\n<p><strong>النظام:</strong> نظام التسجيل العيني للعقار.</p>\\\\\\\\n<p><strong>الجهة المختصة:</strong> الجهة التي يصدر بتحديدها قرار من مجلس الوزراء.</p>\\\\\\\\n<p><strong>المسؤول الأول: </strong>المسؤول الأول، أو مجلس الإدارة، في الجهة المختصة؛ بحسب الأحوال.</p>\\\\\\\\n<p><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.</p>\\\\\\\\n<p><strong>العقار: </strong>قطعة من الأرض وما تحتها وما فوقها -ويستثنى من ذلك الثروات الطبيعية، والعلو غير المأذون بعمارته واستغلاله- وما عليها من بناء أو ملحقات ثابتة أو مزروعات أو مصانع أو منشآت أخرى كالموانئ والمطارات وخطوط الكهرباء والأنابيب وغيرها.</p>\\\\\\\\n<p><strong>الحق العقاري:</strong> سلطة مباشرة مقرة نظاماً لشخص -ذي صفة طبيعية أو اعتبارية- أو أكثر على عقار معين تخوله التصرف فيه أو الاستئثار بمنافعه أو ببعضها.&nbsp;</p>\\\\\\\\n<p><strong>السجل العقاري: </strong>مجموعة وثائق تبين أوصاف العقار وموقعه وحالته المادية والنظامية، وما يتبعه من حقوق والتزامات، والتعديلات التي تطرأ على ذلك، في ضوء الوثائق المعتبرة نظاماً.</p>\\\\\\\\n<p><strong>التسجيل العيني:</strong> جعل العقار محل الحق العقاري أساساً لقيد الحق.&nbsp;</p>\\\\\\\\n<p><strong>التسجيل العيني الأول:</strong> تسجيل العقار باسم مالكه لأول مرة في السجل العقاري، وفقاً للإجراءات الواردة في النظام واللائحة.</p>\\\\\\\\n<p><strong>المسجِّل العقاري:</strong> من يقوم بتوثيق التسجيل العيني الأول، وما يرد على العقار من تصرفات أو تغييرات في وصفه، وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p><strong>المنطقة العقارية:</strong> موقع أرض يحدده قرار صادر من الجهة المختصة، يكون خاضعاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p><strong>صك تسجيل الملكية:</strong> وثيقة صادرة عن السجل العقاري لإثبات بيانات عقار مطابقة للسجل، وفقاً للنموذج الذي تحدده اللائحة، تتضمن: موقع العقار، وحدوده، ووصفه، واستعماله، وما يتبعه من حقوق والتزامات، وبيانات مالكه، وأي بيانات أخرى تحددها اللائحة.</p>\\\\\\\\n<p><strong>الخارطة:</strong> رسم هندسي مساحي مبني على نظام إحداثيات وطني، يبين: موقع العقار، وحدوده، ومعالمه، وأرقامه، ومساحته، وأي بيانات رقمية وتصويرية أخرى.</p>\\\\\\\\n<p><strong>المالك:</strong> شخص ذو صفة طبيعية أو اعتبارية يثبت السجل العقاري حق ملكية عقار له.</p>\\\\\\\\n<p><strong>المقابل المالي: </strong>مبلغ مستحق مقابل خدمات التسجيل العيني وفقا للنظام واللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/11bf4e8d99214b5785ae09cb55f733ab\\\",\\\"title\\\":\\\"المادة الثانية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يسري النظام على جميع العقارات الواقعة في إقليم المملكة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b353f481cedf4159b317178e95c565b2\\\",\\\"title\\\":\\\"المادة الثالثة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تختص الجهة المختصة بالتسجيل العيني، ولها الاستعانة بالجهات الحكومية أو الإسناد إلى الجهات الخاصة لأداء ما تراه من اختصاصاتها المتعلقة بذلك؛ وفقاً للشروط والضوابط التي تضعها.<br>2- تنشئ الجهة المختصة السجل العقاري وتشرف على كل ما يخصه، وتقوم بجميع الإجراءات المتعلقة به.<br>3- تضمن الجهة المختصة صحة معلومات وبيانات العقار ودقّتها، وما يتبعه من حقوق والتزامات، الواردة في السجل العقاري وما ينشأ عنه من صكوك ووثائق.<br>4-تقوم الجهة المختصة بأعمال المساحة المتعلقة بإجراءات التسجيل العيني، وفقاً للائحة والمعايير الجيومكانية الوطنية المعتمدة من جهة الاختصاص، ويمكن -دون إخلال بالأنظمة والتنظيمات ذات العلاقة- استخدام وسائل المساحة الحديثة -بما فيها التصوير الجوي والفضائي وغيرها من التقنيات- عند تنفيذ تلك الأعمال. وتحدد اللائحة إجراءات ذلك.<br>5-تملك الجهة المختصة حصرياً السجل العقاري وبياناته، ولها استثمار بيانات السجل بأنواع الاستغلال التجاري، وإتاحتها للمستفيدين بأسعار عادلة تدعم التنمية، على النحو الذي تحدده اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/dbbd47dec7a643b686723e3a5ae76b66\\\",\\\"title\\\":\\\"المادة الرابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يكون للسجل العقاري الحجية المطلقة في الإثبات وفقاً لأحكام النظام، ويعمل بمضمونه أمام القضاء والجهات كافة بلا بينة إضافية، ولا يجوز الطعن فيه إلا إذا كان الطعن بسبب خطأ كتابي أو تزوير.<br>2-يجب أن يحتوي السجل العقاري على أوصاف العقار، وجميع الحقوق العينية التي ترد عليه والالتزامات التي تتبعه، وأي تعديلات تطرأ على ذلك.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/fd189eec716d497ebef259ade307e988\\\",\\\"title\\\":\\\"المادة الخامسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- لا تعدل بيانات السجل العقاري ولا يجرى أي تغيير عليه، إلا وفقاً لأحكام النظام واللائحة.<br>2-تصحح الجهة المختصة الأخطاء الكتابية والمادية البحتة بناءً على طلب من أي ذي مصلحة أو من تلقاء نفسها، مع إشعار ذوي الشأن بذلك بالوسيلة التي تحددها اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e74a587eaf754f2d88fc2620a5531af5\\\",\\\"title\\\":\\\"المادة السادسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون الاطلاع على بيانات السجل العقاري متاحاً للكافة، وذلك وفقا لما يحدده النظام واللائحة، ويستثنى من ذلك العقارات التي تحدد الجهات المعنية أنها سرية.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0a6278b33648411eb7b02d115f67e040\\\",\\\"title\\\":\\\"المادة السابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تحدد المنطقة العقارية بقرار يصدر عن الجهة المختصة، على أن يتضمن القرار تحديداً دقيقاً وبمعالم واضحة للمنطقة والمدة المحددة لاستقبال طلبات التسجيل العيني الأول، ويعلن عنها بأي وسيلة مناسبة يحددها القرار.<br>2-تختص الجهة المختصة بالتسجيل العيني الأول لكل عقار واقع في المنطقة العقارية وتسجيل أي تصرفات لاحقة ترد عليه.&nbsp;<br>3-توثق التصرفات العقارية التي تقع على العقار الواقع في المنطقة العقارية، والتي تجري خلال فترة إجراءات التسجيل العيني الأول، وفقاً للإجراءات التي تحددها اللائحة.&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/342fba226d1941d095e68538643ed3de\\\",\\\"title\\\":\\\"المادة الثامنة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يشترط للتسجيل العيني الأول الآتي:<br>أ- أن يكون للعقار -ما عدا العقارات المملوكة للدولة- صك ملكية مستوفٍ للمتطلبات النظامية.</p>\\\\\\\\n<p>ب- أن يكون العقار مكتمل البيانات الجيومكانية.</p>\\\\\\\\n<p>وتحدد اللائحة إجراءات التسجيل العيني الأول.</p>\\\\\\\\n<p>2-على كل من تطلب منه الجهة المختصة، الإفصاح عن أي مستندات أو بيانات لازمة لصحة وسلامة التسجيل العيني الأول.<br>3تجري الجهة المختصة الأعمال المساحية اللازمة للتسجيل العيني الأول، ولها -دون أن تجري تلك الأعمال- استخدام البيانات المتعلقة بالأعمال المساحية المعتمدة من جهة الاختصاص في حال توفرها وفق ما تحدده اللائحة.<br>4-يصدر صك تسجيل الملكية للعقار بعد استكمال الإجراءات اللازمة، وفقاً لأحكام النظام واللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b931d7fa4c084b83b59da67c466b257b\\\",\\\"title\\\":\\\"المادة التاسعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تعد الجهة المختصة قوائم للملاك بناء على صكوك تسجيل الملكية الصادرة بناء على أحكام النظام، على أن تشمل تلك القوائم بيانات الصكوك التي تحددها اللائحة.<br>2-تنشر الجهة المختصة قوائم الملاك -المشار إليها في الفقرة (1) من هذه المادة- بالوسائل المناسبة التي تحددها اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d6c032e25ef44373874c00965e284330\\\",\\\"title\\\":\\\"المادة العاشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لكل ذي مصلحة الاعتراض على التسجيل العيني الأول أمام المحكمة المختصة ما لم يكتسب التسجيل الحجية المطلقة وفقاً لأحكام النظام.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4c8ec5af25d443d9b63923bc01c11aa9\\\",\\\"title\\\":\\\"المادة الحادية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-في حال قيد دعوى قضائية تتعلق بالتسجيل العيني الأول وفق ما أشير إليه في المادة (العاشرة) من النظام، فيتم التأشير بها في السجل العقاري وقوائم الملاك، ويضمن في السجل مضمون الحكم النهائي الصادر في شأن الدعوى.<br>وتحدد اللائحة إجراءات وأحكام التأشير في السجل العقاري، وفي قوائم الملاك.</p>\\\\\\\\n<p>2-يكتسب التسجيل العيني الأول الحجية المطلقة بعد انقضاء سنة من تاريخ نشر قوائم الملاك، وللمتضرر من التسجيل العيني الأول بعد اكتسابه الحجية المطلقة حق اللجوء إلى المحكمة المختصة وطلب التعويض من المتسبب دون الحق في طلب إلغاء التسجيل العيني الأول أو تعديل بياناته أو الحقوق الواردة فيه.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/674a2b32805941c2b0373e34362dbb7d\\\",\\\"title\\\":\\\"المادة الثانية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal; mso-outline-level: 3; direction: rtl; unicode-bidi: embed;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoNormal\\\\\\\\\\\\\\\"><span style=\\\\\\\\\\\\\\\"font-family: 'Arial',sans-serif; mso-ascii-font-family: Calibri; mso-ascii-theme-font: minor-latin; mso-hansi-font-family: Calibri; mso-hansi-theme-font: minor-latin;\\\\\\\\\\\\\\\" lang=\\\\\\\\\\\\\\\"AR-SA\\\\\\\\\\\\\\\">لملاك العقارات طلب تسجيل عقاراتهم -الواقعة خارج نطاق المنطقة العقارية- في السجل العقاري وفقاً للشروط والضوابط التي تحددها اللائحة.</span></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/40406dc0b63b4099949a586a0c82a6c6\\\",\\\"title\\\":\\\"المادة الثالثة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تسجل في السجل العقاري جميع التصرفات اللاحقة للتسجيل العيني الأول للعقار، والتي من شأنها إنشاء أي من الحقوق العينية الأصلية أو التبعية أو نقله أو تغييره أو زواله، أو تعديل بيانات العقار، وكذلك الأحكام النهائية المثبتة لشيء من ذلك، ولا تكون تلك الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل. ويدخل في تلك التصرفات القسمة العقارية والوصية والوقف والإرث والرهن والمنح ونحوها.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/cc1c02eb03f647548b12b005d8f43746\\\",\\\"title\\\":\\\"المادة الرابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب التأشير بجميع عقود الإيجار والالتزامات الموثقة نظاماً التي ترد على منفعة العقار إذا كانت مدتها (عشر) سنوات فأكثر، والأحكام النهائية المثبتة لشيء من ذلك، في السجل العقاري، ولا تكون هذه الحقوق نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التأشير.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e1c348807837435489a5eb1211f5ba61\\\",\\\"title\\\":\\\"المادة الخامسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تقوم الجهات المعنية -وفق آلية تتفق عليها الجهة المختصة مع كل منها- بتزويد السجل العقاري بوقائع وفاة ملاك العقارات وصكوك حصر ورثتهم.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2f84ef9f285c48aaa6babc9d05a3777c\\\",\\\"title\\\":\\\"المادة السادسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب التأشير بالدعاوى المتعلقة بحق عيني عقاري أو بتصرف من التصرفات الواجب تسجيلها، في السجل العقاري، متى تضمنت هذه الدعاوى إجراء تغيير في بيانات السجل، ولا تُسمع الدعوى إلا بعد تقديم ما يثبت حصول التأشير بمضمون الدعوى في السجل.</p>\\\\\\\\n<p>ولكل ذي مصلحة أن يقدم طلباً إلى المحكمة المختصة بصفة مستعجلة لمحو التأشير المشار إليه أعلاه، وتأمر المحكمة بمحوه متى تبين لها أن الدعوى التي تم التأشير بها كيدية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d612cfe14bf14cb7ab652defcbebdb38\\\",\\\"title\\\":\\\"المادة السابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يترتب على التأشير بالدعاوى -المشار إليها في المادة (السادسة عشرة) من النظام- أن يكون أي حق تقرر بحكم نهائي في هذه الدعاوى حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d55057c1b63e4368ba259bd73b71e28b\\\",\\\"title\\\":\\\"المادة الثامنة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب التأشير بإعلان الرغبة في الأخذ بالشفعة في السجل العقاري، ويترتب على ذلك أن يكون حق الشفيع إذا تقرر بحكم نهائي حجة على من ترتبت لهم حقوق أو أثبت لمصلحتهم بيانات في السجل العقاري بعد إجراء التأشير المذكور، وذلك متى ما سُجِّل الحكم خلال (تسعين) يوماً من التاريخ الذي أصبح فيه الحكم نهائياً.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f4fbae9118d84e0e9d0ea61c4fb8e427\\\",\\\"title\\\":\\\"المادة التاسعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تحدد اللائحة آليات تسجيل الأحكام المشار إليها في المادتين (السابعة عشرة) و(الثامنة عشرة) من النظام في السجل العقاري.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5335c4abccd1432085427142b20f971a\\\",\\\"title\\\":\\\"المادة العشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يقدم ذو الشأن طلب التسجيل أو التأشير في السجل العقاري إلى الجهة المختصة، ويرفق بالطلب المستندات المؤيدة له التي تحددها اللائحة، وعلى الجهة المختصة تدوين الطلب وفقًا لتاريخ تقديمه وساعته على النحو الذي تحدده اللائحة، ويعد طلب التسجيل كأن لم يكن إذا لم يقدم ذو الشأن تلك المستندات خلال (ثلاثين) يوماً من تاريخ تقديم الطلب، ولا يجوز إجراء أي تسجيل إذا تضمن السجل العقاري قيوداً تمنع التصرف في العقار.<br>2-مع مراعاة ما ورد في الفقرة (1) من هذه المادة، إذا قدم إلى الجهة المختصة أكثر من طلب لتسجيل التصرفات أو التأشير بها في شأن العقار ذاته؛ وجب بحثها وفقًا لأسبقية تسجيل الطلب، وذلك على النحو الذي تحدده اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b371a42c33134857bcc242df90c35a88\\\",\\\"title\\\":\\\"المادة الحادية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لمن أُبلغ برفض طلبه بالتسجيل أو التأشير في السجل العقاري، أو بسقوط أسبقيته، أو بوقف الإجراءات؛ أن يتظلم أمام الجهة المختصة خلال (ثلاثين) يوماً من تاريخ الإبلاغ، وعليها البت في التظلم خلال (ثلاثين) يوماً من تقديمه، فإذا قبلت تظلمه أمرت بالتسجيل أو التأشير. أما إن رفضته أو لم تتخذ قرارًا في شأنه خلال تلك المدة، فلمقدمه التظلم أمام المحكمة المختصة خلال (ثلاثين) يوماً من تاريخ إبلاغه برفض تظلمه أمام الجهة المختصة أو من تاريخ انتهاء المدة المحددة لاتخاذ القرار بشأن التظلم دون اتخاذه، أيهما أسبق، ويوقف النظر في الطلبات اللاحقة إلى حين الفصل في التظلم.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/147331097a0e43858e1a75cdc7f7121e\\\",\\\"title\\\":\\\"المادة الثانية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>مع مراعاة ما تضمنته المادة (العشرون) من النظام، يسجل مضمون المحررات الموثقة نظاماً الواردة من الجهات المعنية في السجل العقاري طبقاً لترتيب ورودها إلى الجهة المختصة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/1366bc6855484252aa606d86d6420e02\\\",\\\"title\\\":\\\"المادة الثالثة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على الجهات المعنية بإصدار رخص متعلقة بالعقارات واستعمالاتها إشعار الجهة المختصة بالرخص التي تصدرها أو تلغيها للعقارات الواقعة في المنطقة العقارية؛ للتأشير بها في السجل العقاري.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b70b8ecd3f894d2db6d0c60e117eb832\\\",\\\"title\\\":\\\"المادة الرابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب على مالك العقار إبلاغ الجهة المختصة بأي تغيير يطرأ على وصف العقار بسبب إنشاء مبانٍ أو إضافتها أو تعديلها أو إزالتها، خلال (تسعين) يومًا من تاريخ حدوث التغيير، وتتخذ الجهة المختصة الإجراءات اللازمة لتحديث بيانات السجل العقاري بما يتوافق مع ذلك على النحو الذي تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b774c422073c4e5a8dc8b615a83522ce\\\",\\\"title\\\":\\\"المادة الخامسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للجهة المختصة -من تلقاء نفسها- أن تتخذ الإجراءات اللازمة لتحديث بيانات السجل العقاري بإضافة أي تغيير مرخص به على عقار قائم على الطبيعة غير مثبت في السجل. وتقوم الجهة المختصة بإشعار ذوي الشأن بهذا التحديث.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/ca216527e91f48169265efcb0d9c370e\\\",\\\"title\\\":\\\"المادة السادسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للمتضرر من تسجيل التصرفات العقارية حق التقدم للمحكمة المختصة بطلب التعويض من المتسبب فيه.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/84752c5033a24474bd325242a0bfa204\\\",\\\"title\\\":\\\"المادة السابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لصاحب حق الانتفاع على العقار تسجيل التصرف فيه في السجل العقاري دون إذن مالك العقار، ما لم يُتفق على غير ذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9883a7f483ce46358a9fa6663cdd1c55\\\",\\\"title\\\":\\\"المادة الثامنة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يكون لكل وحدة عقارية مفرزة واقعة في عقار مشترك، صك تسجيل ملكية خاص بها.<br>2-يجب تسجيل وثائق الملكية المشتركة التي تحددها اللائحة في السجل العقاري.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/21acca51fd7f4c8da3c05137408e4b5e\\\",\\\"title\\\":\\\"المادة التاسعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنشئ الجهة المختصة سجلاً للعقارات الموصوفة على الخارطة مرتبطاً بالسجل العقاري، وتحدد اللائحة إجراءات ذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4e1d9e14705b424aa9d41dd63b21f843\\\",\\\"title\\\":\\\"المادة الثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تُسجل جميع التصرفات التي ترد على العقارات الموصوفة على الخارطة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام، وتحدد اللائحة إجراءات التسجيل، ويُصدر السجل شهادة بذلك، ولا تكون هذه التصرفات نافذة ومنتجة لآثارها القضائية والإدارية إلا بهذا التسجيل.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/13404ff744484e4bb1effaac223f115f\\\",\\\"title\\\":\\\"المادة الحادية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-على مالك العقار خلال (ثلاثين) يوماً من اكتمال إنجاز العقار الموصوف على الخارطة تقديم طلب لتحويل بياناته الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.<br>2-يجوز -بناء على قرار صادر من الجهة المعنية بإصدار ترخيص التصرف في العقار الموصوف على الخارطة- اتخاذ الإجراءات اللازمة لتحويل بيانات العقار الموصوف على الخارطة الواردة في السجل المشار إليه في المادة (التاسعة والعشرين) من النظام إلى السجل العقاري، وإصدار صك تسجيل الملكية له، وفقاً للإجراءات المحددة في النظام واللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7d03602ad865430c99c9918bd6fbdc56\\\",\\\"title\\\":\\\"المادة الثانية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط فيمن يمارس الأعمال المساحية المتعلقة بالتسجيل العيني أن يكون مرخصاً من الجهة ذات الاختصاص، ومقيداً في سجل تعده الجهة المختصة لهذا الغرض. وتحدد اللائحة الإجراءات والشروط اللازمة للقيد في هذا السجل.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/916f04b4c1e6429cbd0a0883f719fc08\\\",\\\"title\\\":\\\"المادة الثالثة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-يكون فرز العقار أو دمجه في السجل العقاري بعد موافقة الجهة المعنية بالفرز أو الدمج، ووفقاً للإجراءات التي تحددها اللائحة.<br>2-إذا تم فرز العقار المحمل بحق عقاري إلى عقارين أو أكثر، يعد كل عقار جديد محملاً بذلك الحق كاملاً، ما لم يتفق ذوو الشأن على غير ذلك.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/43756c69d46a48a2b2eb5596d0b14d9a\\\",\\\"title\\\":\\\"المادة الرابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بمجانية إجراءات التسجيل العيني الأول، وما تضمنته الفقرة (5) من المادة (الثالثة) من النظام، يُحصل مقابل مالي لخدمات التسجيل العيني وفقاً لجدول تعده الجهة المختصة لهذا الغرض يعتمد بقرار من مجلس الوزراء.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/50f928cc58d44dca9ec37f82ac5ea034\\\",\\\"title\\\":\\\"المادة الخامسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بأي عقوبة أشد ينص عليها أي نظام آخر، يعاقب بغرامة لا تتجاوز مائة ألف ريال كل من:</p>\\\\\\\\n<p>1-امتنع عن الإفصاح -المشار إليه في الفقرة (2) من المادة (الثامنة)- عن أي مستندات أو بيانات لازمة لصحة وسلامة إجراءات التسجيل العيني الأول.<br>2-عاق عمل الجهة المختصة المتعلق بإجراءات التسجيل العيني.<br>3-تخلف عن الإبلاغ المشار إليه في المادة (الرابعة والعشرين) من النظام.<br>4-تخلف عن تقديم الطلب المشار إليه في الفقرة (1) من المادة (الحادية والثلاثين) من النظام خلال المدة المحددة في الفقرة.<br>5-تخلف عن تقديم طلب التسجيل العيني الأول لعقاره خلال المدة المحددة لتقديم الطلبات المشار إليها في الفقرة (1) من المادة (السابعة) من النظام.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7569c1f0c6144484944ee6521cfdfa22\\\",\\\"title\\\":\\\"المادة السادسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1-تُشكّل بقرار من المسؤول الأول لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة، يكون أحدهم حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-تختص اللجنة بالنظر في المخالفات وإيقاع العقوبة المنصوص عليها في المادة (الخامسة والثلاثين) من النظام.<br>3-تحدد قواعد وإجراءات عمل اللجنة ومكافآت أعضائها بقرار من المسؤول الأول.<br>4-يجوز الاعتراض على قرارات اللجنة أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ العلم بها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4ed52ae5a0a241739d21eed54d35f741\\\",\\\"title\\\":\\\"المادة السابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في المسجل العقاري الآتي:</p>\\\\\\\\n<p>1-أن يكون حاصلاً -على الأقل- على شهادة جامعية في العلوم الشرعية أو النظامية.<br>2-ألا يكون سبق أن حُكم عليه بجريمة مخلة بالشرف والأمانة ولو رد إليه اعتباره.<br>3-أن يجتاز دورة تأهيلية في نظام التسجيل العيني للعقار على النحو الذي تحدده اللائحة.<br>4-أي شرط آخر تحدده اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/1a25d4098f9447b7892ee35140689550\\\",\\\"title\\\":\\\"المادة الثامنة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تصدر الجهة المختصة اللائحة –بالاتفاق مع وزارة العدل- خلال (تسعين) يوماً من تاريخ نشر النظام في الجريدة الرسمية، ويعمل بها مع نفاذه.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/af5bcf49572f4c748ee6b8ffcd4869a2\\\",\\\"title\\\":\\\"المادة التاسعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحل النظام محل نظام التسجيل العيني للعقار الصادر بالمرسوم الملكي رقم ( م / 6 ) وتاريخ 11/ 2 / 1423هـ، ويُلغى كل ما يتعارض معه من أحكام.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b2e332fab7644d97a4838a65e92697b9\\\",\\\"title\\\":\\\"المادة الأربعون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يعمل بالنظام بعد (تسعين) يوماً من تاريخ نشره في الجريدة الرسمية</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f3ebe45b49a643ada314fc3b7cdfdbbf\\\",\\\"title\\\":\\\"الفصل الثامن: رسوم التسجيل والمقابل المالي للخدمات المضافة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/dd04e28aeea94a41a276d4ea396a07fe\\\",\\\"title\\\":\\\"الفصل التاسع: العقوبات\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0405884f68a7490bbb84d74f3b042946\\\",\\\"title\\\":\\\"الفصل العاشر: الأحكام الختامية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/41afd6cd459449b5a157d8c164d0decc\\\",\\\"title\\\":\\\"الفصل الأول: الأحكام العامة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5b704638459e4a72b3d96c3d1fb20439\\\",\\\"title\\\":\\\"الفصل الثاني: اختصاص الجهة المختصة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c8fea9b6cedc4a108233d0082ade7dc7\\\",\\\"title\\\":\\\"الفصل الثالث: السجل العقاري\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6fd6d89056954026a99b1a1c884226ac\\\",\\\"title\\\":\\\"الفصل الرابع: التسجيل العيني الأول\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/cf4ffd8725ef4bfbb1ae02ae8e04eaba\\\",\\\"title\\\":\\\"الفصل الخامس: تسجيل التصرفات العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/8b6bd1715d84484fb92035e624052563\\\",\\\"title\\\":\\\"الفصل السادس: سجل التصرف في العقار الموصوف على الخارطة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a2111fc87afb4e9a83e417a7a38826bc\\\",\\\"title\\\":\\\"الفصل السابع: أعمال المساحة والفرز\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"نظام التسجيل العيني للعقار\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"نظام التسجيل العيني للعقار\\\",\\n  \\\"التسجيل العيني\\\",\\n  \\\"للعقار\\\",\\n  \\\"الهيئة\\\",\\n  \\\"الهيئة العامة للعقار\\\",\\n  \\\"الانظمة\\\",\\n  \\\"نظام\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"نظام التسجيل العيني للعقار\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"subContent","path":"Property/subContent","oldValue":"\"جعل العقار محل الحق العقاري أساساً لقيد الحق\"","newValue":"null","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"نظام التسجيل العيني للعقار\"","change":"Update"}],"key":"6169d0a4-cb3a-4b45-89e6-48464b02c7d7"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/5afa2097-16b3-4705-ac6c-a74821fa53dc.config","name":"اللائحة التنفيذية لنظام المساهمات العقارية","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"contentItems","path":"Property/contentItems","oldValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/2a955894f526414f8ff2b44360f8fa56\\\"},{\\\"contentUdi\\\":\\\"umb://element/584815b7178c4757a721596c4b81bf91\\\"},{\\\"contentUdi\\\":\\\"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\\\"},{\\\"contentUdi\\\":\\\"umb://element/81fd88a41ccc4f22a35dd17975651756\\\"},{\\\"contentUdi\\\":\\\"umb://element/aea4801aab33450a9c85f9fafd0e5abf\\\"},{\\\"contentUdi\\\":\\\"umb://element/8ee0e734748542ca959cc362bb265511\\\"},{\\\"contentUdi\\\":\\\"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\\\"},{\\\"contentUdi\\\":\\\"umb://element/2f52bb5b1336483589c712fe2d16a455\\\"},{\\\"contentUdi\\\":\\\"umb://element/99440ad5396e43ceb17276eb477067bb\\\"},{\\\"contentUdi\\\":\\\"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\\\"},{\\\"contentUdi\\\":\\\"umb://element/d5c97f7415b84597ba1c9703d381ab1e\\\"},{\\\"contentUdi\\\":\\\"umb://element/6c1b3f691dbd4461838724587ee88c23\\\"},{\\\"contentUdi\\\":\\\"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\\\"},{\\\"contentUdi\\\":\\\"umb://element/03d6e5355c774f8c89fbbb72b793de3f\\\"},{\\\"contentUdi\\\":\\\"umb://element/9f3827dd753f45ab83e29f9cff379c72\\\"},{\\\"contentUdi\\\":\\\"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\\\"},{\\\"contentUdi\\\":\\\"umb://element/bccc4814637241c0b80f4c3935c12df0\\\"},{\\\"contentUdi\\\":\\\"umb://element/b7aadf2e0b674736a0fb64e580f70adb\\\"},{\\\"contentUdi\\\":\\\"umb://element/a5139383e19a415baed15739b7798ae0\\\"},{\\\"contentUdi\\\":\\\"umb://element/f390cd7ac2d049ad923d19753d61a41f\\\"},{\\\"contentUdi\\\":\\\"umb://element/88b4081d4b044448871679abfd101bdf\\\"},{\\\"contentUdi\\\":\\\"umb://element/f9e9737107d94adfa0f27df275544b3b\\\"},{\\\"contentUdi\\\":\\\"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\\\"},{\\\"contentUdi\\\":\\\"umb://element/2f05091b7ed446fa97e1b16e7dba7885\\\"},{\\\"contentUdi\\\":\\\"umb://element/3b3f07435f31480d8a2182d2e576c4e6\\\"},{\\\"contentUdi\\\":\\\"umb://element/e366bd869b6444e78e18abb746f94b95\\\"},{\\\"contentUdi\\\":\\\"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\\\"},{\\\"contentUdi\\\":\\\"umb://element/89fb47adaae6494b9ad9789d93ec24ac\\\"},{\\\"contentUdi\\\":\\\"umb://element/222af533409c404f8c484caab1a44ff3\\\"},{\\\"contentUdi\\\":\\\"umb://element/51896ee0a6654e408445aced5b9a7483\\\"},{\\\"contentUdi\\\":\\\"umb://element/353af6e717a045148f8176e5e5e7eb0d\\\"},{\\\"contentUdi\\\":\\\"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\\\"},{\\\"contentUdi\\\":\\\"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\\\"},{\\\"contentUdi\\\":\\\"umb://element/5c928964c4974d8a9435f5b54642aa48\\\"},{\\\"contentUdi\\\":\\\"umb://element/ac1d9fef0896413a928384f679a04556\\\"},{\\\"contentUdi\\\":\\\"umb://element/d2caee046ae240a880eefce919a1dca1\\\"},{\\\"contentUdi\\\":\\\"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\\\"},{\\\"contentUdi\\\":\\\"umb://element/be5ee7bc8267405fb0e827895294c97c\\\"},{\\\"contentUdi\\\":\\\"umb://element/9a547251dbc94a448b0b8d28f8c99112\\\"},{\\\"contentUdi\\\":\\\"umb://element/74e1c64f17984584866f3a47653d9529\\\"},{\\\"contentUdi\\\":\\\"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\\\"},{\\\"contentUdi\\\":\\\"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\\\"},{\\\"contentUdi\\\":\\\"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\\\"},{\\\"contentUdi\\\":\\\"umb://element/b7ed236ea16e4232838d9119affa6117\\\"},{\\\"contentUdi\\\":\\\"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\\\"},{\\\"contentUdi\\\":\\\"umb://element/1775e6f489ab4ac99f9f698b176435e9\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2a955894f526414f8ff2b44360f8fa56\\\",\\\"title\\\":\\\"المادة الأولى\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنطبق معاني الألفاظ والعبارات المنصوص عليها في المادة (الأولى) من النظام على اللائحة، يُقصد بالعبارات الاتية – أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها، مالم يقتض السياق غير ذلك:</p>\\\\\\\\n<p><strong>طالب الترخيص:</strong> المطور العقاري المتقدم بطلب ترخيص المساهمة العقارية.</p>\\\\\\\\n<p><strong>رأس مال المساهمة العقارية:</strong> الحصص النقدية والعينية المقدمة للمساهمة العقارية والمقسمة الى قيم متساوية.</p>\\\\\\\\n<p><strong>اتفاقية المساهمة: </strong>وثيقة بين المرخص له والمساهمين لأغراض المساهمة العقارية.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/584815b7178c4757a721596c4b81bf91\\\",\\\"title\\\":\\\"المادة الثانية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون مشروع التطوير العقاري -والمشار إليه في المادة (الأولى) من النظام- خاضعاً للترخيص في حال اشترك فيه خمسة أشخاص فأكثر.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\\\",\\\"title\\\":\\\"المادة الثالثة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تصنف المساهمات العقارية حسب الحجم وفق الآتي:</p>\\\\\\\\n<p>أ‌- مساهمة صغيرة يقل رأس مالها عن خمسين مليون ريال.<br>ب‌- مساهمة متوسطة لا يقل رأس مالها عن خمسين مليون ريال ولا يزيد عن ثلاث مئة مليون ريال.<br>ت‌- مساهمة كبيرة يتجاوز رأس مالها ثلاث مئة مليون ريال.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/81fd88a41ccc4f22a35dd17975651756\\\",\\\"title\\\":\\\"المادة الرابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لا يجوز الترخيص لعدة مساهمات عقارية على ذات العقار خلال فترة واحدة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/aea4801aab33450a9c85f9fafd0e5abf\\\",\\\"title\\\":\\\"المادة الخامسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; يجب أن يتخذ العقار محل المساهمة العقارية إحدى الصورتين الآتيتين:</p>\\\\\\\\n<p>&nbsp;1- أن يكون حصة عينية مسجلة في المساهمة العقارية.<br>&nbsp;2- أن يكون مشترى لمصلحة المساهمة العقارية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/8ee0e734748542ca959cc362bb265511\\\",\\\"title\\\":\\\"المادة السادسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">&nbsp;1- إذا كان العقار سيُشترى لمصلحة المساهمة العقارية، فيشترط إبرام اتفاقية مع مالك العقار متضمنة التزامه بنقل ملكية العقار للمساهمة العقارية بعد صدور الترخيص.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">&nbsp;2-يجب على مالك العقار نقل ملكية العقار محل المساهمة العقارية إلى المساهمة العقارية بعد صدور الترخيص وقبل الطرح وجمع الأموال، وينص في ضبط المبايعة على أن البيع معلق على شرط سداد المبلغ في الوقت المحدد.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">3- يجوز الاشتراك في المساهمة العقارية بحصة عينية، بعقار يكون محلاًّ لها، ويشترط في الحصة العينية الآتي:<br>&nbsp; &nbsp; &nbsp;‌أ- أن تكون مملوكة للمساهم وقت تقديمها.<br>&nbsp; &nbsp; ‌ب- أن تُضمّن في اتفاقية المساهمة.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">4-&nbsp; يجب على المساهم نقل ملكية العقار إلى المساهمة العقارية بعد حصولها على الترخيص، خلال مدة لا تتجاوز (خمسة) أيام عملل</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">5- في حال عدم اكتمال طرح المساهمة وجمع الأموال فتعاد ملكية العقار إلى مالكه الأساس وفق خطاب من الهيئة.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">6- يجب أن يحتفظ المساهم بالحصة العينية في السنة الأولى بكامل حصصه، ويجوز أن يتصرف في السنة الثانية -وحتى انقضاء المساهمة العقارية- بما لا يزيد على (50%) من حصته في المساهمة العقارية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\\\",\\\"title\\\":\\\"المادة السابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تُنظَّم أحكام جمع الأموال للمساهمات العقارية، وإصدار شهاداتها، وتنظيم سجل المساهمين الخاص بها، وفقًا لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/99440ad5396e43ceb17276eb477067bb\\\",\\\"title\\\":\\\"المادة الثامنة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يُقدَّم طلب الترخيص إلى الهيئة وفقًا للنموذج الذي تعده الهيئة لهذا الغرض، مرفقًا به الآتي:</p>\\\\\\\\n<p>1-شهادة من جهة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب الترخيص، على ألاّ يتجاوز تاريخ إصدار الشهادة (ثلاثة أشهر) من تاريخ تقديم الطلب.<br>2- رقم السجل العقاري أو وثيقة تملك العقار محل المساهمة العقارية سارية المفعول ثابتة سلامتها، قابلة للتصرف بناء على إفادة من الجهة التي أصدرتها.<br>3- الموافقات النظامية -بحسب الأحوال- من وزارة الشؤون البلدية والقروية والإسكان أو وزارة الطاقة أو الهيئة، أو غيرها من الجهات المختصة وفق أنظمتها.<br>4- دراسة جدوى اقتصادية للمساهمة العقارية باللغة العربية معتمدة من مكتب مرخص في المملكة، متضمنة البيانات المالية والإنشائية والتسويقية المقدرة، والمصاريف المالية والإدارية المتوقعة لجميع تكاليف التطوير لمشروع المساهمة، والمدة المتوقعة لإتمامه، ومراحل التنفيذ، ومصادر التمويل المتوقعة، وحالات إضافة المبلغ الاحتياطي.<br>5- وصف محل المساهمة العقارية.<br>6- تحديد رأس مال المساهمة العقارية.<br>7- تعبئة نموذج اتفاقية المساهمة.<br>8- الاتفاقية مع الاستشاري الهندسي على أن تشمل الالتزامات والمهام المناطة به.<br>9- الاتفاقية مع المحاسب القانوني على أن تشمل الالتزامات والمهام المناطة به.<br>10- الاتفاقية مع مدير المساهمة العقارية.<br>11- الاتفاقية المبرمة مع مالك العقار وفق المادة (السادسة) من اللائحة، إن وجدت.<br>12- تقييم العقار محل المساهمة العقارية من ثلاثة مقيمين معتمدين.<br>13- تعيين مؤسسة سوق مالية وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\\\",\\\"title\\\":\\\"المادة التاسعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- تدرس الهيئة طلب الترخيص خلال مدة لا تتجاوز (عشرة) أيام عمل ولها عند الحاجة لأي بيانات أو مستندات إضافية ترى ضرورتها، إشعار طالب الترخيص، وعليه استكمال ما يلزم خلال مدة لا تتجاوز (ستين) يوما من تاريخ إبلاغه بذلك، وللهيئة تمديدها لمدة (ثلاثين) يوماً إضافية، وإلا عدّ الطلب مرفوضا.<br>2- تصدر الهيئة موافقة مشروطة على طلب الترخيص باستكمال إجراءات الترخيص، أو ترفض الطلب مع ذكر مسببات الرفض.<br>3- يستكمل طالب الترخيص – بعد الحصول على الموافقة المشروطة على طلب الترخيص - إجراءات طرح شهادات المساهمة العقارية وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة من هيئة السوق المالية.<br>4- تصدر الهيئة الترخيص -بعد استكمال ما ورد في الفقرتين (2) و(3) من هذه المادة-متضمنًا البيانات التالية:<br>‌أ- رقم الترخيص.<br>‌ب- اسم المرخص له.<br>‌ج- مدة الترخيص.<br>‌د- اسم المساهمة العقارية والبيانات المالية والتخطيطية للعقار.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d5c97f7415b84597ba1c9703d381ab1e\\\",\\\"title\\\":\\\"المادة العاشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تضع الهيئة نموذجاً لاتفاقية المساهمة، على أن يتضمن -بحد أدنى- البيانات الآتية:</p>\\\\\\\\n<p>1- بيانات أطراف الاتفاقية.<br>2- اسم المساهمة العقارية، ومقرها، وعنوان التواصل.<br>3- وصف محل المساهمة العقارية.<br>4- مدة المساهمة العقارية وآلية تمديدها.<br>5- مقدار رأس مال المساهمة العقارية.<br>6- المصاريف المالية للمساهمة العقارية.<br>7- اقتراح المبلغ الاحتياطي لرأس مال المساهمة العقارية، إن وجد.<br>8- مقدار الحصص النقدية والعينية.<br>9- آليات تصرف المساهمين بحصصهم.<br>10- الأحكام المنظّمة للاقتراض بضمان أموال المساهمة العقارية وأصولها.<br>11- عمولة المرخص له نظير أتعابه.<br>12- إعداد القوائم المالية والإفصاحات الدورية للمساهمين بشكل نصف سنوي، ومراجعتها بشكل سنوي.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6c1b3f691dbd4461838724587ee88c23\\\",\\\"title\\\":\\\"المادة الحادية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز -بناءً على طلب المرخص له قبل طرح المساهمة العقارية- تعديل الترخيص باتّباع الإجراءات المنصوص عليها في النظام واللائحة وتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية، أو إلغاء الترخيص نهائياً؛ دون إخلال بالحقوق المترتبة قبل الإلغاء.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/03d6e5355c774f8c89fbbb72b793de3f\\\",\\\"title\\\":\\\"المادة الثانية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>في حال اشترطت الهيئة إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية -وفقًا لما قضت به المادة (السابعة) من النظام-؛ فيكون التصرف بذلك المبلغ وفقًا للشروط الآتية:</p>\\\\\\\\n<p>1- أن يكون بموافقة الجمعية.<br>2- أن يكون الغرض من التصرف هو التعامل مع مصاريف غير متوقعة وقت تحديد رأس مال المساهمة العقارية.<br>3- إبلاغ الهيئة بالتصرف، ومقداره، خلال مدة لا تتجاوز (5) أيام عمل من تاريخ موافقة الجمعية على التصرف.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9f3827dd753f45ab83e29f9cff379c72\\\",\\\"title\\\":\\\"المادة الثالثة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- في حال عدم التصرف في المبلغ الاحتياطي المشار إليه في المادة (السابعة) من النظام، أو تم التصرف بجزء منه، فتكون إعادته إلى المساهمين -بعد انقضاء المساهمة العقارية- وفقًا لحصة كل منهم في المبلغ الاحتياطي.<br>2- على المرخص له -قبل التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية لمواجهة أي مصاريف إضافية غير متوقعة- عرض ذلك على الجمعية للتصويت في شأنها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\\\",\\\"title\\\":\\\"المادة الرابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للمساهم التصرف بحصته في المساهمة العقارية وفق الشروط الآتية:</p>\\\\\\\\n<p>1- أن تضمن اتفاقية المساهمة آلية التصرف.<br>2- أن يقيّد التصرف وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bccc4814637241c0b80f4c3935c12df0\\\",\\\"title\\\":\\\"المادة الخامسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز للمرخص له الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق الشروط الآتية:</p>\\\\\\\\n<p>1- أن تتضمن اتفاقية المساهمة إمكان الاقتراض بضمان أموال المساهمة العقارية أو أصولها.<br>2- موافقة الجمعية على الاقتراض.</p>\\\\\\\\n<p>3- ألا يتجاوز مبلغ الاقتراض نصف رأس مال المساهمة العقارية.<br>4- أن تخصّص الأموال المقترضة؛ لأغراض المساهمة العقارية.<br>5- أن تحوَّل الأموال المقترضة إلى حساب الضمان مباشرة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b7aadf2e0b674736a0fb64e580f70adb\\\",\\\"title\\\":\\\"المادة السادسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن (5%) منها، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f390cd7ac2d049ad923d19753d61a41f\\\",\\\"title\\\":\\\"المادة السابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>ممارسو نشاط المساهمات العقارية هم الآتي:</p>\\\\\\\\n<p>1- المرخص له.<br>2- مدير المساهمة العقارية.<br>3- الاستشاري الهندسي.<br>4- المحاسب القانوني<br>5- المقيم المعتمد.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/88b4081d4b044448871679abfd101bdf\\\",\\\"title\\\":\\\"المادة الثامنة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تصدر الهيئة -بقرار من المجلس- الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f9e9737107d94adfa0f27df275544b3b\\\",\\\"title\\\":\\\"المادة التاسعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في مدير المساهمة العقارية الآتي:</p>\\\\\\\\n<p>1- أن يتمتع بالخبرة اللازمة لإدارة المساهمة العقارية.<br>2- ألا يكون قد سبق أن أدين بجريمة مخلة بالشرف أو الأمانة.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\\\",\\\"title\\\":\\\"المادة العشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في الاستشاري الهندسي الممارس لنشاط المساهمات العقارية الآتي:</p>\\\\\\\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمهندسين. &nbsp;<br>2- أن يكون لديه خبرة في مجال البناء والتشييد وإدارة المشاريع لا تقل مدتها عن (ثلاث) سنوات.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2f05091b7ed446fa97e1b16e7dba7885\\\",\\\"title\\\":\\\"المادة الحادية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في المحاسب القانوني الممارس لنشاط المساهمات العقارية الآتي:</p>\\\\\\\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمراجعين والمحاسبين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.<br>3- أن يكون مسجلا لدى هيئة السوق المالية في حال طرح شهادات المساهمات العقارية طرحاً عاماً.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/3b3f07435f31480d8a2182d2e576c4e6\\\",\\\"title\\\":\\\"المادة الثانية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في المقيم المعتمد الممارس لنشاط المساهمات العقارية الآتي:</p>\\\\\\\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمقيمين المعتمدين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e366bd869b6444e78e18abb746f94b95\\\",\\\"title\\\":\\\"المادة الثالثة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- &nbsp; &nbsp; &nbsp;تعتمد الهيئة متوسط القيمة بين تقارير تقييم العقار المعدة من المقيمين المعتمدين.<br>2- &nbsp; &nbsp; &nbsp;يستبدل التقييم الذي يتجاوز فيه الاختلاف عن التقريرين الآخرين ما نسبته (10%) زيادةً أو نقصاً.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\\\",\\\"title\\\":\\\"المادة الرابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يختص المرخص له بالآتي:</p>\\\\\\\\n<p>1- تجهيز كل ما يلزم من متطلبات وموافقات لإصدار الترخيص وفق اشتراطات النظام واللائحة.<br>2- تعيين مدير المساهمة العقارية، والإشراف على أعماله، وتمكينه من القيام بواجباته.<br>3- تعيين محاسب قانوني واستشاري هندسي للمساهمة العقارية.<br>4- فتح حساب ضمان باسم المساهمة العقارية في أحد البنوك المرخص لها.<br>5- تنفيذ الصرف من حساب الضمان وإدارته؛ بناءً على إجراءات الصرف.<br>6- إبرام العقود اللازمة لمصلحة المساهمة العقارية.<br>7- الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق أحكام النظام واللائحة.<br>8- بيع أصول المساهمة العقارية وفق أحكام النظام واللائحة.<br>9- ترؤّس الجمعية أو تعيين من يمثله في رئاستها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/89fb47adaae6494b9ad9789d93ec24ac\\\",\\\"title\\\":\\\"المادة الخامسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يلتزم المرخص له بالآتي:</p>\\\\\\\\n<p>1- تعيين مؤسسة سوق مالية مرخص لها؛ وذلك وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.<br>2- الإفصاح للمساهمين دون تأخير عن أي تطورات جوهرية في عمليات المساهمة العقارية، أو وضعها المالي، أو كيانها التنظيمي، أو ملكيتها.<br>3-&nbsp; عدم تلقي أي مبلغ ذي صلة بالمساهمة العقارية سواءً بشكل نقدي أو بإيداع في حساب مصرفي خاص. وأن تكون جميع الإيداعات في حساب الضمان فقط.<br>4- تقديم تقارير دورية للمساهمين والهيئة، بما في ذلك التقارير الفنية والمالية وأي تقارير إضافية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/222af533409c404f8c484caab1a44ff3\\\",\\\"title\\\":\\\"المادة السادسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على الاستشاري الهندسي أن يؤدي عمله في الإشراف على المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\\\\\\\n<p>1- الإشراف والمتابعة لأعمال المساهمة العقارية وفقًا للمواصفات والمعايير الهندسية والمتطلبات النظامية والتصاميم الهندسية، ووفق ما نص عليه العقد المبرم معه.<br>2- التدقيق والمصادقة على وثيقة الصرف.<br>3- إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/51896ee0a6654e408445aced5b9a7483\\\",\\\"title\\\":\\\"المادة السابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على المحاسب القانوني أن يؤدي عمله في المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\\\\\\\n<p>1- مراجعة المستندات المالية اللازمة لعمليات الصرف على المساهمة العقارية، وتدقيقها.<br>2- التحقق من البيانات المالية الخاصة بالمساهمة العقارية، والتأكّد من أن جميع أموال المساهمة العقارية أودعت في حساب الضمان.<br>3- التدقيق والمصادقة على وثيقة الصرف.<br>4- أي مهمة أخرى تتصل باختصاصاته وفقًا لما تصدره الهيئة من تعليمات.<br>5-إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/353af6e717a045148f8176e5e5e7eb0d\\\",\\\"title\\\":\\\"المادة الثامنة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>اختصاصات مدير المساهمة العقارية ومسؤولياته هي:</p>\\\\\\\\n<p>1- التحقق من إيداع جميع العوائد في حساب الضمان.<br>2- توزيع أرباح المساهمة العقارية وفق أحكام النظام واللائحة.<br>3- إبلاغ المرخص له والهيئة عن أي حدث أو تطور جوهري قد يؤثر على المساهمة العقارية.<br>4- مراجعة التقارير عن أعمال المقاول والاستشاري الهندسي والمحاسب القانوني في المساهمة العقارية، وأرشفتها.<br>5- الدعوة لعقد اجتماعات الجمعية.<br>6- تنفيذ عمليات بيع أصول المساهمة العقارية بناء على تفويض المرخص له وبحسب الإجراءات المنصوص عليها في اللائحة.<br>7- رفع التقارير الدورية لكل الأطراف المعنية، إلى كل من (الهيئة، والجمعية، والمرخص له).<br>8- مخاطبة الجهات فيما يتعلق بالمساهمة العقارية.<br>9- أي مهمة أخرى يكلفه بها المرخص له في حدود أعمال المساهمة العقارية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\\\",\\\"title\\\":\\\"المادة التاسعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">1- يجوز للمرخص له أو الجمعية عزل مدير المساهمة العقارية إن أساء استخدام صلاحياته أو أخلّ بتنفيذ التزاماته؛ وفق الإجراءات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; أ‌- رفع طلب عزله إلى الهيئة مرفقاً به الأسباب الداعية إلى ذلك<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ب‌- تبت الهيئة في الطلب خلال مدة لا تتجاوز (خمسة) أيام عمل<br>2- يجوز للهيئة أن تعزل مدير المساهمة العقارية إن ثبتت مخالفته لأحكام النظام أو اللائحة، وتبلغ المرخص له بذلك.<br>3- على المرخص له تعيين مدير للمساهمة خلال (خمسة) أيام عمل من تاريخ تبليغه بقرار الهيئة بالموافقة على عزل مدير المساهمة السابق.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\\\",\\\"title\\\":\\\"المادة الثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- يجب على كل ممارسي نشاط المساهمات العقارية، الإفصاح للجمعية عن أي مصلحة مباشرة أو غير مباشرة، أو التي تنطوي على تعارض مصالح قائم أو محتمل لهم أو لأي من أقاربهم حتى الدرجة الرابعة في أي مشروع أو اتفاق يعقد مع المساهمة العقارية، ويكون باطلاً أي تصرف مخالف لأحكام هذه المادة.<br>2- لا يجوز للمرخص له ومدير المساهمة العقارية الاشتراك في التصويت على قرارات الجمعية، التي لأي منهما فيها مصلحة مباشرة أو غير مباشرة أو التي تنطوي على تعارض مصالح قائم أو محتمل.<br>3- يجوز لكل ممارسي نشاط المساهمات العقارية -بعد الحصول على موافقة الجمعية- إكمال الإجراءات التي تنطوي على مصلحة أو تعارض مصالح.<br>4- يكون كلّ ممارس نشاط المساهمات العقارية -بحسب الأحوال - مسؤولاً عن الآثار المترتبة على التعارض بين مصالحه الخاصة ومصالح المساهمة العقارية؛ إذا لم يفصح للجمعية عنه، ولا يخلّ ذلك بأي عقوبة أشد يقضي بها نظام آخر.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/ac1d9fef0896413a928384f679a04556\\\",\\\"title\\\":\\\"المادة الحادية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تختص الجمعية بالآتي:</p>\\\\\\\\n<p>1- الموافقة على إلغاء الترخيص وتصفية المساهمة العقارية أو بيعها.<br>2- الموافقة على تعديل اتفاقية المساهمة.<br>3- اعتماد القوائم المالية للمساهمة العقارية.<br>4- التصويت على عزل مدير المساهمة العقارية.<br>5- الموافقة على التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية.<br>6- الموافقة على الاقتراض بضمان أموال المساهمة العقارية أو أصولها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d2caee046ae240a880eefce919a1dca1\\\",\\\"title\\\":\\\"المادة الثانية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>وسائل التقنية الحديثة لحضور اجتماعات هي كل وسيلة اتصال معتمدة وفق (نظام التعاملات الإلكترونية) الصادر بالمرسوم الملكي رقم م/18 وتاريخ 08/03/1428هـ وتعديلاته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\\\",\\\"title\\\":\\\"المادة الثالثة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب -عند الدعوة إلى عقد اجتماع الجمعية- وضع الإجراءات اللازمة للتحقق من هوية المساهم الذي يصوت من خلال وسائل التقنية الحديثة والمساهم الحاضر في اجتماع الجمعية، وعن أحقيته في التصويت على أيٍّ من بنود الاجتماع، ومن ذلك الدخول من خلال منصة النفاذ الوطني.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9a547251dbc94a448b0b8d28f8c99112\\\",\\\"title\\\":\\\"المادة الرابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">1-تتكون الأرباح القابلة للتوزيع من صافي دخل المساهمة مخصوماً منه جميع المبالغ التي يتم تجنيبها إلى الاحتياطي المخصص لأغراض محددة في اتفاقية المساهمة - إن وجد -.<br>2-يجوز للمساهمة العقارية توزيع أرباح مرحلية ناتجة عن متحصلات البيع على مساهميها بشكل نصف سنوي أو ربع سنوي -إذا نصت اتفاقية المساهمة على جواز ذلك- بعد استيفاء المتطلبات الآتية:<br>                                 ‌أ- موافقة جمعية المساهمين<br>                          ‌ب- أن تكون المساهمة ذات ربحية جيدة ومنتظمة<br>                            ‌ج- أن يتوافر لديها سيولة معقولة، وتستطيع أن تتوقع بدرجة معقولة مستوى أرباحها<br>                               ‌د- أن يتوفر لدى المساهمة أرباح قابلة للتوزيع وفقاً لآخر قوائم مالية مراجعة، كافية لتغطية الأرباح المقترح توزيعها.<br>3-يجب على مدير المساهمة أن يفصح للهيئة والمساهمين فوراً ومن دون تأخير عند اتخاذ قرار توزيع الأرباح.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/74e1c64f17984584866f3a47653d9529\\\",\\\"title\\\":\\\"المادة الخامسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>في تنفيذ أحكام المادة (السابعة والعشرون) من النظام، تسري الأحكام الآتية:</p>\\\\\\\\n<p>1- يجب تقييم أصول المساهمة العقارية من ثلاثة مقيمين مستقلين عن المرخص له، ومعتمدين وفقاً لنظام المقيمين المعتمدين.<br>2- يجب عرض التقييم على الجمعية، للحصول على موافقتها. وللجمعية طلب إعادة التقييم بما لا يتجاوز مرتين.<br>3- ألا تتجاوز المدة بين تقرير التقييم وتاريخ البيع؛ (ثلاثة) أشهر.<br>4- تكون إجراءات البيع من خلال المرخص له أو مدير المساهمة العقارية، بحسب ما تنص عليه اتفاقية المساهمة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\\\",\\\"title\\\":\\\"المادة السادسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لمسؤول الضبط -في سبيل القيام بأعمال التفتيش- اتخاذ أي من الإجراءات الآتية:</p>\\\\\\\\n<p>1- فحص مقر المرخص له والوثائق والمشاريع المتعلقة بالأنشطة المشمولة بالنظام، وأيٍّ من المستندات والوثائق والبيانات والسجلات والمرافق المتعلقة بالمساهمة العقارية.<br>2- الحصول على نُسَخ من أي ترخيص أو تصريح أو شهادة أو سجل أو وثيقة أو غيرها.<br>3- التحفظ على الوثائق والسجلات ونحوها.<br>4- التصوير بأي من الوسائل المتاحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\\\",\\\"title\\\":\\\"المادة السابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على مسؤول الضبط -عند ضبط مخالفة- إعداد محضر متضمّنًا ما يأتي:</p>\\\\\\\\n<p>1- المعلومات والبيانات بما يشمل بيانات مسؤول الضبط وتاريخ التفتيش ووقته ومكانه.<br>2- بيانات المرخص له.<br>3- الوقائع بما يشمل ملخص ما قام به مسؤول الضبط.<br>4- رصد وقائع المخالفات ووصفها.<br>5- قائمة بما تم ضبطه أو التحفظ عليه من أصول أو مستندات أو معلومات وغيرها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b7ed236ea16e4232838d9119affa6117\\\",\\\"title\\\":\\\"المادة الثامنة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحيل مسؤول الضبط محضر ضبط المخالفة إلى لجنة النظر في مخالفات أحكام النظام المنصوص عليها في المادة (الثالثة والثلاثين) من النظام.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\\\",\\\"title\\\":\\\"المادة التاسعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يصرف لمسؤول الضبط مكافأة قدرها ثلاثة رواتب أساسية مرتبطة بتقييم الأداء.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/1775e6f489ab4ac99f9f698b176435e9\\\",\\\"title\\\":\\\"المادة الأربعون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنشر اللائحة في الجريدة الرسمية، ويعمل بها من تاريخ نشرها</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2f52bb5b1336483589c712fe2d16a455\\\",\\\"title\\\":\\\"إجراءات الترخيص\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\\\",\\\"title\\\":\\\"أحكام رأس مال المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a5139383e19a415baed15739b7798ae0\\\",\\\"title\\\":\\\"ممارسو نشاط المساهمات العقارية واختصاصتهم\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5c928964c4974d8a9435f5b54642aa48\\\",\\\"title\\\":\\\"جمعية المساهمين\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/be5ee7bc8267405fb0e827895294c97c\\\",\\\"title\\\":\\\"توزيع الأرباح وتصفية المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\\\",\\\"title\\\":\\\"الرقابة والتفتيش والضبط\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null}],\\\"settingsData\\\":[]}\"","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/2a955894f526414f8ff2b44360f8fa56\\\"},{\\\"contentUdi\\\":\\\"umb://element/584815b7178c4757a721596c4b81bf91\\\"},{\\\"contentUdi\\\":\\\"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\\\"},{\\\"contentUdi\\\":\\\"umb://element/81fd88a41ccc4f22a35dd17975651756\\\"},{\\\"contentUdi\\\":\\\"umb://element/aea4801aab33450a9c85f9fafd0e5abf\\\"},{\\\"contentUdi\\\":\\\"umb://element/8ee0e734748542ca959cc362bb265511\\\"},{\\\"contentUdi\\\":\\\"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\\\"},{\\\"contentUdi\\\":\\\"umb://element/2f52bb5b1336483589c712fe2d16a455\\\"},{\\\"contentUdi\\\":\\\"umb://element/99440ad5396e43ceb17276eb477067bb\\\"},{\\\"contentUdi\\\":\\\"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\\\"},{\\\"contentUdi\\\":\\\"umb://element/d5c97f7415b84597ba1c9703d381ab1e\\\"},{\\\"contentUdi\\\":\\\"umb://element/6c1b3f691dbd4461838724587ee88c23\\\"},{\\\"contentUdi\\\":\\\"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\\\"},{\\\"contentUdi\\\":\\\"umb://element/03d6e5355c774f8c89fbbb72b793de3f\\\"},{\\\"contentUdi\\\":\\\"umb://element/9f3827dd753f45ab83e29f9cff379c72\\\"},{\\\"contentUdi\\\":\\\"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\\\"},{\\\"contentUdi\\\":\\\"umb://element/bccc4814637241c0b80f4c3935c12df0\\\"},{\\\"contentUdi\\\":\\\"umb://element/b7aadf2e0b674736a0fb64e580f70adb\\\"},{\\\"contentUdi\\\":\\\"umb://element/a5139383e19a415baed15739b7798ae0\\\"},{\\\"contentUdi\\\":\\\"umb://element/f390cd7ac2d049ad923d19753d61a41f\\\"},{\\\"contentUdi\\\":\\\"umb://element/88b4081d4b044448871679abfd101bdf\\\"},{\\\"contentUdi\\\":\\\"umb://element/f9e9737107d94adfa0f27df275544b3b\\\"},{\\\"contentUdi\\\":\\\"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\\\"},{\\\"contentUdi\\\":\\\"umb://element/2f05091b7ed446fa97e1b16e7dba7885\\\"},{\\\"contentUdi\\\":\\\"umb://element/3b3f07435f31480d8a2182d2e576c4e6\\\"},{\\\"contentUdi\\\":\\\"umb://element/e366bd869b6444e78e18abb746f94b95\\\"},{\\\"contentUdi\\\":\\\"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\\\"},{\\\"contentUdi\\\":\\\"umb://element/89fb47adaae6494b9ad9789d93ec24ac\\\"},{\\\"contentUdi\\\":\\\"umb://element/222af533409c404f8c484caab1a44ff3\\\"},{\\\"contentUdi\\\":\\\"umb://element/51896ee0a6654e408445aced5b9a7483\\\"},{\\\"contentUdi\\\":\\\"umb://element/353af6e717a045148f8176e5e5e7eb0d\\\"},{\\\"contentUdi\\\":\\\"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\\\"},{\\\"contentUdi\\\":\\\"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\\\"},{\\\"contentUdi\\\":\\\"umb://element/5c928964c4974d8a9435f5b54642aa48\\\"},{\\\"contentUdi\\\":\\\"umb://element/ac1d9fef0896413a928384f679a04556\\\"},{\\\"contentUdi\\\":\\\"umb://element/d2caee046ae240a880eefce919a1dca1\\\"},{\\\"contentUdi\\\":\\\"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\\\"},{\\\"contentUdi\\\":\\\"umb://element/be5ee7bc8267405fb0e827895294c97c\\\"},{\\\"contentUdi\\\":\\\"umb://element/9a547251dbc94a448b0b8d28f8c99112\\\"},{\\\"contentUdi\\\":\\\"umb://element/74e1c64f17984584866f3a47653d9529\\\"},{\\\"contentUdi\\\":\\\"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\\\"},{\\\"contentUdi\\\":\\\"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\\\"},{\\\"contentUdi\\\":\\\"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\\\"},{\\\"contentUdi\\\":\\\"umb://element/b7ed236ea16e4232838d9119affa6117\\\"},{\\\"contentUdi\\\":\\\"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\\\"},{\\\"contentUdi\\\":\\\"umb://element/1775e6f489ab4ac99f9f698b176435e9\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2a955894f526414f8ff2b44360f8fa56\\\",\\\"title\\\":\\\"المادة الأولى\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنطبق معاني الألفاظ والعبارات المنصوص عليها في المادة (الأولى) من النظام على اللائحة، يُقصد بالعبارات الاتية – أينما وردت في هذه اللائحة- المعاني المبينة أمام كل منها، مالم يقتض السياق غير ذلك:</p>\\\\\\\\n<p><strong>طالب الترخيص:</strong> المطور العقاري المتقدم بطلب ترخيص المساهمة العقارية.</p>\\\\\\\\n<p><strong>رأس مال المساهمة العقارية:</strong> الحصص النقدية والعينية المقدمة للمساهمة العقارية والمقسمة الى قيم متساوية.</p>\\\\\\\\n<p><strong>اتفاقية المساهمة: </strong>وثيقة بين المرخص له والمساهمين لأغراض المساهمة العقارية.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/584815b7178c4757a721596c4b81bf91\\\",\\\"title\\\":\\\"المادة الثانية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون مشروع التطوير العقاري -والمشار إليه في المادة (الأولى) من النظام- خاضعاً للترخيص في حال اشترك فيه خمسة أشخاص فأكثر.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a1b8d9e33eab4ba1b40d11b03c2a041d\\\",\\\"title\\\":\\\"المادة الثالثة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تصنف المساهمات العقارية حسب الحجم وفق الآتي:</p>\\\\\\\\n<p>أ‌- مساهمة صغيرة يقل رأس مالها عن خمسين مليون ريال.<br>ب‌- مساهمة متوسطة لا يقل رأس مالها عن خمسين مليون ريال ولا يزيد عن ثلاث مئة مليون ريال.<br>ت‌- مساهمة كبيرة يتجاوز رأس مالها ثلاث مئة مليون ريال.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/81fd88a41ccc4f22a35dd17975651756\\\",\\\"title\\\":\\\"المادة الرابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لا يجوز الترخيص لعدة مساهمات عقارية على ذات العقار خلال فترة واحدة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/aea4801aab33450a9c85f9fafd0e5abf\\\",\\\"title\\\":\\\"المادة الخامسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; يجب أن يتخذ العقار محل المساهمة العقارية إحدى الصورتين الآتيتين:</p>\\\\\\\\n<p>&nbsp;1- أن يكون حصة عينية مسجلة في المساهمة العقارية.<br>&nbsp;2- أن يكون مشترى لمصلحة المساهمة العقارية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/8ee0e734748542ca959cc362bb265511\\\",\\\"title\\\":\\\"المادة السادسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">&nbsp;1- إذا كان العقار سيُشترى لمصلحة المساهمة العقارية، فيشترط إبرام اتفاقية مع مالك العقار متضمنة التزامه بنقل ملكية العقار للمساهمة العقارية بعد صدور الترخيص.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">&nbsp;2-يجب على مالك العقار نقل ملكية العقار محل المساهمة العقارية إلى المساهمة العقارية بعد صدور الترخيص وقبل الطرح وجمع الأموال، وينص في ضبط المبايعة على أن البيع معلق على شرط سداد المبلغ في الوقت المحدد.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">3- يجوز الاشتراك في المساهمة العقارية بحصة عينية، بعقار يكون محلاًّ لها، ويشترط في الحصة العينية الآتي:<br>&nbsp; &nbsp; &nbsp;‌أ- أن تكون مملوكة للمساهم وقت تقديمها.<br>&nbsp; &nbsp; ‌ب- أن تُضمّن في اتفاقية المساهمة.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">4-&nbsp; يجب على المساهم نقل ملكية العقار إلى المساهمة العقارية بعد حصولها على الترخيص، خلال مدة لا تتجاوز (خمسة) أيام عملل</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">5- في حال عدم اكتمال طرح المساهمة وجمع الأموال فتعاد ملكية العقار إلى مالكه الأساس وفق خطاب من الهيئة.</p>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"mso-add-space: auto; text-align: justify; text-justify: kashida; text-kashida: 0%; text-indent: -.5in; mso-text-indent-alt: -9.0pt; mso-list: l0 level1 lfo2; tab-stops: right 9.0pt 13.5pt; direction: rtl; unicode-bidi: embed; margin: 0in .5in .0001pt 0in;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"RTL\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"MsoListParagraphCxSpFirst\\\\\\\\\\\\\\\">6- يجب أن يحتفظ المساهم بالحصة العينية في السنة الأولى بكامل حصصه، ويجوز أن يتصرف في السنة الثانية -وحتى انقضاء المساهمة العقارية- بما لا يزيد على (50%) من حصته في المساهمة العقارية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6ae7c51a5b9a46c5abc2edf7f7473e3d\\\",\\\"title\\\":\\\"المادة السابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تُنظَّم أحكام جمع الأموال للمساهمات العقارية، وإصدار شهاداتها، وتنظيم سجل المساهمين الخاص بها، وفقًا لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/99440ad5396e43ceb17276eb477067bb\\\",\\\"title\\\":\\\"المادة الثامنة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يُقدَّم طلب الترخيص إلى الهيئة وفقًا للنموذج الذي تعده الهيئة لهذا الغرض، مرفقًا به الآتي:</p>\\\\\\\\n<p>1-شهادة من جهة مرخص لها بتقديم الخدمات الائتمانية تتضمن سلامة السجل الائتماني لطالب الترخيص، على ألاّ يتجاوز تاريخ إصدار الشهادة (ثلاثة أشهر) من تاريخ تقديم الطلب.<br>2- رقم السجل العقاري أو وثيقة تملك العقار محل المساهمة العقارية سارية المفعول ثابتة سلامتها، قابلة للتصرف بناء على إفادة من الجهة التي أصدرتها.<br>3- الموافقات النظامية -بحسب الأحوال- من وزارة الشؤون البلدية والقروية والإسكان أو وزارة الطاقة أو الهيئة، أو غيرها من الجهات المختصة وفق أنظمتها.<br>4- دراسة جدوى اقتصادية للمساهمة العقارية باللغة العربية معتمدة من مكتب مرخص في المملكة، متضمنة البيانات المالية والإنشائية والتسويقية المقدرة، والمصاريف المالية والإدارية المتوقعة لجميع تكاليف التطوير لمشروع المساهمة، والمدة المتوقعة لإتمامه، ومراحل التنفيذ، ومصادر التمويل المتوقعة، وحالات إضافة المبلغ الاحتياطي.<br>5- وصف محل المساهمة العقارية.<br>6- تحديد رأس مال المساهمة العقارية.<br>7- تعبئة نموذج اتفاقية المساهمة.<br>8- الاتفاقية مع الاستشاري الهندسي على أن تشمل الالتزامات والمهام المناطة به.<br>9- الاتفاقية مع المحاسب القانوني على أن تشمل الالتزامات والمهام المناطة به.<br>10- الاتفاقية مع مدير المساهمة العقارية.<br>11- الاتفاقية المبرمة مع مالك العقار وفق المادة (السادسة) من اللائحة، إن وجدت.<br>12- تقييم العقار محل المساهمة العقارية من ثلاثة مقيمين معتمدين.<br>13- تعيين مؤسسة سوق مالية وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/88e0d1bd74bb49c8bb985b3808a28b0f\\\",\\\"title\\\":\\\"المادة التاسعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- تدرس الهيئة طلب الترخيص خلال مدة لا تتجاوز (عشرة) أيام عمل ولها عند الحاجة لأي بيانات أو مستندات إضافية ترى ضرورتها، إشعار طالب الترخيص، وعليه استكمال ما يلزم خلال مدة لا تتجاوز (ستين) يوما من تاريخ إبلاغه بذلك، وللهيئة تمديدها لمدة (ثلاثين) يوماً إضافية، وإلا عدّ الطلب مرفوضا.<br>2- تصدر الهيئة موافقة مشروطة على طلب الترخيص باستكمال إجراءات الترخيص، أو ترفض الطلب مع ذكر مسببات الرفض.<br>3- يستكمل طالب الترخيص – بعد الحصول على الموافقة المشروطة على طلب الترخيص - إجراءات طرح شهادات المساهمة العقارية وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة من هيئة السوق المالية.<br>4- تصدر الهيئة الترخيص -بعد استكمال ما ورد في الفقرتين (2) و(3) من هذه المادة-متضمنًا البيانات التالية:<br>‌أ- رقم الترخيص.<br>‌ب- اسم المرخص له.<br>‌ج- مدة الترخيص.<br>‌د- اسم المساهمة العقارية والبيانات المالية والتخطيطية للعقار.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d5c97f7415b84597ba1c9703d381ab1e\\\",\\\"title\\\":\\\"المادة العاشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تضع الهيئة نموذجاً لاتفاقية المساهمة، على أن يتضمن -بحد أدنى- البيانات الآتية:</p>\\\\\\\\n<p>1- بيانات أطراف الاتفاقية.<br>2- اسم المساهمة العقارية، ومقرها، وعنوان التواصل.<br>3- وصف محل المساهمة العقارية.<br>4- مدة المساهمة العقارية وآلية تمديدها.<br>5- مقدار رأس مال المساهمة العقارية.<br>6- المصاريف المالية للمساهمة العقارية.<br>7- اقتراح المبلغ الاحتياطي لرأس مال المساهمة العقارية، إن وجد.<br>8- مقدار الحصص النقدية والعينية.<br>9- آليات تصرف المساهمين بحصصهم.<br>10- الأحكام المنظّمة للاقتراض بضمان أموال المساهمة العقارية وأصولها.<br>11- عمولة المرخص له نظير أتعابه.<br>12- إعداد القوائم المالية والإفصاحات الدورية للمساهمين بشكل نصف سنوي، ومراجعتها بشكل سنوي.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6c1b3f691dbd4461838724587ee88c23\\\",\\\"title\\\":\\\"المادة الحادية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز -بناءً على طلب المرخص له قبل طرح المساهمة العقارية- تعديل الترخيص باتّباع الإجراءات المنصوص عليها في النظام واللائحة وتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية، أو إلغاء الترخيص نهائياً؛ دون إخلال بالحقوق المترتبة قبل الإلغاء.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/03d6e5355c774f8c89fbbb72b793de3f\\\",\\\"title\\\":\\\"المادة الثانية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>في حال اشترطت الهيئة إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية -وفقًا لما قضت به المادة (السابعة) من النظام-؛ فيكون التصرف بذلك المبلغ وفقًا للشروط الآتية:</p>\\\\\\\\n<p>1- أن يكون بموافقة الجمعية.<br>2- أن يكون الغرض من التصرف هو التعامل مع مصاريف غير متوقعة وقت تحديد رأس مال المساهمة العقارية.<br>3- إبلاغ الهيئة بالتصرف، ومقداره، خلال مدة لا تتجاوز (5) أيام عمل من تاريخ موافقة الجمعية على التصرف.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9f3827dd753f45ab83e29f9cff379c72\\\",\\\"title\\\":\\\"المادة الثالثة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- في حال عدم التصرف في المبلغ الاحتياطي المشار إليه في المادة (السابعة) من النظام، أو تم التصرف بجزء منه، فتكون إعادته إلى المساهمين -بعد انقضاء المساهمة العقارية- وفقًا لحصة كل منهم في المبلغ الاحتياطي.<br>2- على المرخص له -قبل التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية لمواجهة أي مصاريف إضافية غير متوقعة- عرض ذلك على الجمعية للتصويت في شأنها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d55e3241f7e94a53a9f57755d1f24e5c\\\",\\\"title\\\":\\\"المادة الرابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للمساهم التصرف بحصته في المساهمة العقارية وفق الشروط الآتية:</p>\\\\\\\\n<p>1- أن تضمن اتفاقية المساهمة آلية التصرف.<br>2- أن يقيّد التصرف وفق تعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bccc4814637241c0b80f4c3935c12df0\\\",\\\"title\\\":\\\"المادة الخامسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز للمرخص له الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق الشروط الآتية:</p>\\\\\\\\n<p>1- أن تتضمن اتفاقية المساهمة إمكان الاقتراض بضمان أموال المساهمة العقارية أو أصولها.<br>2- موافقة الجمعية على الاقتراض.</p>\\\\\\\\n<p>3- ألا يتجاوز مبلغ الاقتراض نصف رأس مال المساهمة العقارية.<br>4- أن تخصّص الأموال المقترضة؛ لأغراض المساهمة العقارية.<br>5- أن تحوَّل الأموال المقترضة إلى حساب الضمان مباشرة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b7aadf2e0b674736a0fb64e580f70adb\\\",\\\"title\\\":\\\"المادة السادسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن (5%) منها، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f390cd7ac2d049ad923d19753d61a41f\\\",\\\"title\\\":\\\"المادة السابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>ممارسو نشاط المساهمات العقارية هم الآتي:</p>\\\\\\\\n<p>1- المرخص له.<br>2- مدير المساهمة العقارية.<br>3- الاستشاري الهندسي.<br>4- المحاسب القانوني<br>5- المقيم المعتمد.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/88b4081d4b044448871679abfd101bdf\\\",\\\"title\\\":\\\"المادة الثامنة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تصدر الهيئة -بقرار من المجلس- الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f9e9737107d94adfa0f27df275544b3b\\\",\\\"title\\\":\\\"المادة التاسعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في مدير المساهمة العقارية الآتي:</p>\\\\\\\\n<p>1- أن يتمتع بالخبرة اللازمة لإدارة المساهمة العقارية.<br>2- ألا يكون قد سبق أن أدين بجريمة مخلة بالشرف أو الأمانة.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c94db1b448f84e21a6191c65b4c5c7b3\\\",\\\"title\\\":\\\"المادة العشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في الاستشاري الهندسي الممارس لنشاط المساهمات العقارية الآتي:</p>\\\\\\\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمهندسين. &nbsp;<br>2- أن يكون لديه خبرة في مجال البناء والتشييد وإدارة المشاريع لا تقل مدتها عن (ثلاث) سنوات.<br>3- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2f05091b7ed446fa97e1b16e7dba7885\\\",\\\"title\\\":\\\"المادة الحادية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في المحاسب القانوني الممارس لنشاط المساهمات العقارية الآتي:</p>\\\\\\\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمراجعين والمحاسبين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.<br>3- أن يكون مسجلا لدى هيئة السوق المالية في حال طرح شهادات المساهمات العقارية طرحاً عاماً.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/3b3f07435f31480d8a2182d2e576c4e6\\\",\\\"title\\\":\\\"المادة الثانية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يشترط في المقيم المعتمد الممارس لنشاط المساهمات العقارية الآتي:</p>\\\\\\\\n<p>1- أن يكون معتمدًا من الهيئة السعودية للمقيمين المعتمدين.<br>2- أن يجتاز برنامج ممارسة نشاط المساهمات العقارية الذي أقرته الهيئة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e366bd869b6444e78e18abb746f94b95\\\",\\\"title\\\":\\\"المادة الثالثة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- &nbsp; &nbsp; &nbsp;تعتمد الهيئة متوسط القيمة بين تقارير تقييم العقار المعدة من المقيمين المعتمدين.<br>2- &nbsp; &nbsp; &nbsp;يستبدل التقييم الذي يتجاوز فيه الاختلاف عن التقريرين الآخرين ما نسبته (10%) زيادةً أو نقصاً.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4c418e98f25442ec9b29f7e5d07b91e6\\\",\\\"title\\\":\\\"المادة الرابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يختص المرخص له بالآتي:</p>\\\\\\\\n<p>1- تجهيز كل ما يلزم من متطلبات وموافقات لإصدار الترخيص وفق اشتراطات النظام واللائحة.<br>2- تعيين مدير المساهمة العقارية، والإشراف على أعماله، وتمكينه من القيام بواجباته.<br>3- تعيين محاسب قانوني واستشاري هندسي للمساهمة العقارية.<br>4- فتح حساب ضمان باسم المساهمة العقارية في أحد البنوك المرخص لها.<br>5- تنفيذ الصرف من حساب الضمان وإدارته؛ بناءً على إجراءات الصرف.<br>6- إبرام العقود اللازمة لمصلحة المساهمة العقارية.<br>7- الاقتراض بضمان أموال المساهمة العقارية أو أصولها وفق أحكام النظام واللائحة.<br>8- بيع أصول المساهمة العقارية وفق أحكام النظام واللائحة.<br>9- ترؤّس الجمعية أو تعيين من يمثله في رئاستها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/89fb47adaae6494b9ad9789d93ec24ac\\\",\\\"title\\\":\\\"المادة الخامسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يلتزم المرخص له بالآتي:</p>\\\\\\\\n<p>1- تعيين مؤسسة سوق مالية مرخص لها؛ وذلك وفقاً لتعليمات طرح شهادات المساهمات العقارية الصادرة عن هيئة السوق المالية.<br>2- الإفصاح للمساهمين دون تأخير عن أي تطورات جوهرية في عمليات المساهمة العقارية، أو وضعها المالي، أو كيانها التنظيمي، أو ملكيتها.<br>3-&nbsp; عدم تلقي أي مبلغ ذي صلة بالمساهمة العقارية سواءً بشكل نقدي أو بإيداع في حساب مصرفي خاص. وأن تكون جميع الإيداعات في حساب الضمان فقط.<br>4- تقديم تقارير دورية للمساهمين والهيئة، بما في ذلك التقارير الفنية والمالية وأي تقارير إضافية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/222af533409c404f8c484caab1a44ff3\\\",\\\"title\\\":\\\"المادة السادسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على الاستشاري الهندسي أن يؤدي عمله في الإشراف على المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\\\\\\\n<p>1- الإشراف والمتابعة لأعمال المساهمة العقارية وفقًا للمواصفات والمعايير الهندسية والمتطلبات النظامية والتصاميم الهندسية، ووفق ما نص عليه العقد المبرم معه.<br>2- التدقيق والمصادقة على وثيقة الصرف.<br>3- إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/51896ee0a6654e408445aced5b9a7483\\\",\\\"title\\\":\\\"المادة السابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على المحاسب القانوني أن يؤدي عمله في المشاريع وفقًا لقواعد المهنة، وتكون مهماته وفق الآتي:</p>\\\\\\\\n<p>1- مراجعة المستندات المالية اللازمة لعمليات الصرف على المساهمة العقارية، وتدقيقها.<br>2- التحقق من البيانات المالية الخاصة بالمساهمة العقارية، والتأكّد من أن جميع أموال المساهمة العقارية أودعت في حساب الضمان.<br>3- التدقيق والمصادقة على وثيقة الصرف.<br>4- أي مهمة أخرى تتصل باختصاصاته وفقًا لما تصدره الهيئة من تعليمات.<br>5-إبلاغ الهيئة عن أي مخالفات لأحكام النظام أو اللائحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/353af6e717a045148f8176e5e5e7eb0d\\\",\\\"title\\\":\\\"المادة الثامنة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>اختصاصات مدير المساهمة العقارية ومسؤولياته هي:</p>\\\\\\\\n<p>1- التحقق من إيداع جميع العوائد في حساب الضمان.<br>2- توزيع أرباح المساهمة العقارية وفق أحكام النظام واللائحة.<br>3- إبلاغ المرخص له والهيئة عن أي حدث أو تطور جوهري قد يؤثر على المساهمة العقارية.<br>4- مراجعة التقارير عن أعمال المقاول والاستشاري الهندسي والمحاسب القانوني في المساهمة العقارية، وأرشفتها.<br>5- الدعوة لعقد اجتماعات الجمعية.<br>6- تنفيذ عمليات بيع أصول المساهمة العقارية بناء على تفويض المرخص له وبحسب الإجراءات المنصوص عليها في اللائحة.<br>7- رفع التقارير الدورية لكل الأطراف المعنية، إلى كل من (الهيئة، والجمعية، والمرخص له).<br>8- مخاطبة الجهات فيما يتعلق بالمساهمة العقارية.<br>9- أي مهمة أخرى يكلفه بها المرخص له في حدود أعمال المساهمة العقارية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/34c2de4ec42a4da1886cbed6fb63c2e7\\\",\\\"title\\\":\\\"المادة التاسعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">1- يجوز للمرخص له أو الجمعية عزل مدير المساهمة العقارية إن أساء استخدام صلاحياته أو أخلّ بتنفيذ التزاماته؛ وفق الإجراءات الآتية:<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; أ‌- رفع طلب عزله إلى الهيئة مرفقاً به الأسباب الداعية إلى ذلك<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ب‌- تبت الهيئة في الطلب خلال مدة لا تتجاوز (خمسة) أيام عمل<br>2- يجوز للهيئة أن تعزل مدير المساهمة العقارية إن ثبتت مخالفته لأحكام النظام أو اللائحة، وتبلغ المرخص له بذلك.<br>3- على المرخص له تعيين مدير للمساهمة خلال (خمسة) أيام عمل من تاريخ تبليغه بقرار الهيئة بالموافقة على عزل مدير المساهمة السابق.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/55eb90cbeba34e1ea1b72f549c8462aa\\\",\\\"title\\\":\\\"المادة الثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1- يجب على كل ممارسي نشاط المساهمات العقارية، الإفصاح للجمعية عن أي مصلحة مباشرة أو غير مباشرة، أو التي تنطوي على تعارض مصالح قائم أو محتمل لهم أو لأي من أقاربهم حتى الدرجة الرابعة في أي مشروع أو اتفاق يعقد مع المساهمة العقارية، ويكون باطلاً أي تصرف مخالف لأحكام هذه المادة.<br>2- لا يجوز للمرخص له ومدير المساهمة العقارية الاشتراك في التصويت على قرارات الجمعية، التي لأي منهما فيها مصلحة مباشرة أو غير مباشرة أو التي تنطوي على تعارض مصالح قائم أو محتمل.<br>3- يجوز لكل ممارسي نشاط المساهمات العقارية -بعد الحصول على موافقة الجمعية- إكمال الإجراءات التي تنطوي على مصلحة أو تعارض مصالح.<br>4- يكون كلّ ممارس نشاط المساهمات العقارية -بحسب الأحوال - مسؤولاً عن الآثار المترتبة على التعارض بين مصالحه الخاصة ومصالح المساهمة العقارية؛ إذا لم يفصح للجمعية عنه، ولا يخلّ ذلك بأي عقوبة أشد يقضي بها نظام آخر.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/ac1d9fef0896413a928384f679a04556\\\",\\\"title\\\":\\\"المادة الحادية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تختص الجمعية بالآتي:</p>\\\\\\\\n<p>1- الموافقة على إلغاء الترخيص وتصفية المساهمة العقارية أو بيعها.<br>2- الموافقة على تعديل اتفاقية المساهمة.<br>3- اعتماد القوائم المالية للمساهمة العقارية.<br>4- التصويت على عزل مدير المساهمة العقارية.<br>5- الموافقة على التصرف بالمبلغ الاحتياطي لرأس مال المساهمة العقارية.<br>6- الموافقة على الاقتراض بضمان أموال المساهمة العقارية أو أصولها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d2caee046ae240a880eefce919a1dca1\\\",\\\"title\\\":\\\"المادة الثانية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>وسائل التقنية الحديثة لحضور اجتماعات هي كل وسيلة اتصال معتمدة وفق (نظام التعاملات الإلكترونية) الصادر بالمرسوم الملكي رقم م/18 وتاريخ 08/03/1428هـ وتعديلاته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/888c8cf4065041ef9f7ef6c7211cebc8\\\",\\\"title\\\":\\\"المادة الثالثة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب -عند الدعوة إلى عقد اجتماع الجمعية- وضع الإجراءات اللازمة للتحقق من هوية المساهم الذي يصوت من خلال وسائل التقنية الحديثة والمساهم الحاضر في اجتماع الجمعية، وعن أحقيته في التصويت على أيٍّ من بنود الاجتماع، ومن ذلك الدخول من خلال منصة النفاذ الوطني.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9a547251dbc94a448b0b8d28f8c99112\\\",\\\"title\\\":\\\"المادة الرابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p style=\\\\\\\\\\\\\\\"text-align: right;\\\\\\\\\\\\\\\">1-تتكون الأرباح القابلة للتوزيع من صافي دخل المساهمة مخصوماً منه جميع المبالغ التي يتم تجنيبها إلى الاحتياطي المخصص لأغراض محددة في اتفاقية المساهمة - إن وجد -.<br>2-يجوز للمساهمة العقارية توزيع أرباح مرحلية ناتجة عن متحصلات البيع على مساهميها بشكل نصف سنوي أو ربع سنوي -إذا نصت اتفاقية المساهمة على جواز ذلك- بعد استيفاء المتطلبات الآتية:<br>                                 ‌أ- موافقة جمعية المساهمين<br>                          ‌ب- أن تكون المساهمة ذات ربحية جيدة ومنتظمة<br>                            ‌ج- أن يتوافر لديها سيولة معقولة، وتستطيع أن تتوقع بدرجة معقولة مستوى أرباحها<br>                               ‌د- أن يتوفر لدى المساهمة أرباح قابلة للتوزيع وفقاً لآخر قوائم مالية مراجعة، كافية لتغطية الأرباح المقترح توزيعها.<br>3-يجب على مدير المساهمة أن يفصح للهيئة والمساهمين فوراً ومن دون تأخير عند اتخاذ قرار توزيع الأرباح.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/74e1c64f17984584866f3a47653d9529\\\",\\\"title\\\":\\\"المادة الخامسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>في تنفيذ أحكام المادة (السابعة والعشرون) من النظام، تسري الأحكام الآتية:</p>\\\\\\\\n<p>1- يجب تقييم أصول المساهمة العقارية من ثلاثة مقيمين مستقلين عن المرخص له، ومعتمدين وفقاً لنظام المقيمين المعتمدين.<br>2- يجب عرض التقييم على الجمعية، للحصول على موافقتها. وللجمعية طلب إعادة التقييم بما لا يتجاوز مرتين.<br>3- ألا تتجاوز المدة بين تقرير التقييم وتاريخ البيع؛ (ثلاثة) أشهر.<br>4- تكون إجراءات البيع من خلال المرخص له أو مدير المساهمة العقارية، بحسب ما تنص عليه اتفاقية المساهمة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7fd26a369cc049bdaf6d4bd11696e35e\\\",\\\"title\\\":\\\"المادة السادسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لمسؤول الضبط -في سبيل القيام بأعمال التفتيش- اتخاذ أي من الإجراءات الآتية:</p>\\\\\\\\n<p>1- فحص مقر المرخص له والوثائق والمشاريع المتعلقة بالأنشطة المشمولة بالنظام، وأيٍّ من المستندات والوثائق والبيانات والسجلات والمرافق المتعلقة بالمساهمة العقارية.<br>2- الحصول على نُسَخ من أي ترخيص أو تصريح أو شهادة أو سجل أو وثيقة أو غيرها.<br>3- التحفظ على الوثائق والسجلات ونحوها.<br>4- التصوير بأي من الوسائل المتاحة.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/36904fb9b6c94f49ae6a1b27dc79b384\\\",\\\"title\\\":\\\"المادة السابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>على مسؤول الضبط -عند ضبط مخالفة- إعداد محضر متضمّنًا ما يأتي:</p>\\\\\\\\n<p>1- المعلومات والبيانات بما يشمل بيانات مسؤول الضبط وتاريخ التفتيش ووقته ومكانه.<br>2- بيانات المرخص له.<br>3- الوقائع بما يشمل ملخص ما قام به مسؤول الضبط.<br>4- رصد وقائع المخالفات ووصفها.<br>5- قائمة بما تم ضبطه أو التحفظ عليه من أصول أو مستندات أو معلومات وغيرها.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b7ed236ea16e4232838d9119affa6117\\\",\\\"title\\\":\\\"المادة الثامنة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحيل مسؤول الضبط محضر ضبط المخالفة إلى لجنة النظر في مخالفات أحكام النظام المنصوص عليها في المادة (الثالثة والثلاثين) من النظام.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/87c2ccd1d00246ac8b412374ccdd2eed\\\",\\\"title\\\":\\\"المادة التاسعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يصرف لمسؤول الضبط مكافأة قدرها ثلاثة رواتب أساسية مرتبطة بتقييم الأداء.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/1775e6f489ab4ac99f9f698b176435e9\\\",\\\"title\\\":\\\"المادة الأربعون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنشر اللائحة في الجريدة الرسمية، ويعمل بها من تاريخ نشرها</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2f52bb5b1336483589c712fe2d16a455\\\",\\\"title\\\":\\\"إجراءات الترخيص\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7a281044d1eb4e6ca1bb6cc5a1d91f8b\\\",\\\"title\\\":\\\"أحكام رأس مال المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a5139383e19a415baed15739b7798ae0\\\",\\\"title\\\":\\\"ممارسو نشاط المساهمات العقارية واختصاصتهم\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5c928964c4974d8a9435f5b54642aa48\\\",\\\"title\\\":\\\"جمعية المساهمين\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/be5ee7bc8267405fb0e827895294c97c\\\",\\\"title\\\":\\\"توزيع الأرباح وتصفية المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/b552c4e4fc4b4df7835c84bf4a04d500\\\",\\\"title\\\":\\\"الرقابة والتفتيش والضبط\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"اللائحة التنفيذية لنظام المساهمات العقارية\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"اللائحة التنفيذية لنظام المساهمات العقارية\\\",\\n  \\\"المساهمات\\\",\\n  \\\"المساهمات العقارية\\\",\\n  \\\"نظام المساهمات العقارية\\\",\\n  \\\"الانظمة واللوائح والادلة\\\",\\n  \\\"لوائح\\\",\\n  \\\"الهيئة العامة للعقار\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"اللائحة التنفيذية لنظام المساهمات العقارية\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"title","path":"Property/title","oldValue":"null","newValue":"\"اللائحة التنفيذية لنظام المساهمات العقارية\"","change":"Update"}],"key":"5afa2097-16b3-4705-ac6c-a74821fa53dc"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/7a3f9cb7-04ad-4097-9eb3-f2a3ab9a1887.config","name":"نظام المساهمات العقارية","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"contentItems","path":"Property/contentItems","oldValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\\\"},{\\\"contentUdi\\\":\\\"umb://element/55e0fd24d41945b0b9a5c119eadab387\\\"},{\\\"contentUdi\\\":\\\"umb://element/c671b0d4696e40b2847abfcabf3b0f70\\\"},{\\\"contentUdi\\\":\\\"umb://element/74b2e03476784f1099788370cb1f3819\\\"},{\\\"contentUdi\\\":\\\"umb://element/0634a93087934125849f2c1562659acd\\\"},{\\\"contentUdi\\\":\\\"umb://element/a4765edf58f94b149dc6823b994db0ec\\\"},{\\\"contentUdi\\\":\\\"umb://element/cf03dadf375a415194ac546207572432\\\"},{\\\"contentUdi\\\":\\\"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\\\"},{\\\"contentUdi\\\":\\\"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\\\"},{\\\"contentUdi\\\":\\\"umb://element/f1444ea00c1a4bc9b50257a28d85744a\\\"},{\\\"contentUdi\\\":\\\"umb://element/aff6bb9b068a41d4b076a8025bf584d7\\\"},{\\\"contentUdi\\\":\\\"umb://element/19c16ae7c831488aa0d478accbf7c206\\\"},{\\\"contentUdi\\\":\\\"umb://element/e406eb0ab60b43c1a21015db6158bf6b\\\"},{\\\"contentUdi\\\":\\\"umb://element/73a6312ad353471497af7e65011352c2\\\"},{\\\"contentUdi\\\":\\\"umb://element/f0c60f03f2f046389ced0ad80ae03515\\\"},{\\\"contentUdi\\\":\\\"umb://element/7085830f68494aa8b1741e1179df92a6\\\"},{\\\"contentUdi\\\":\\\"umb://element/9507d21d02b24b3b8c640fa248d37171\\\"},{\\\"contentUdi\\\":\\\"umb://element/eeb906fad1e3419194edfe984372ee60\\\"},{\\\"contentUdi\\\":\\\"umb://element/2724d265a2704eaf90b248fa69977d00\\\"},{\\\"contentUdi\\\":\\\"umb://element/fa8b050afc8c4649b501c4090fdd23db\\\"},{\\\"contentUdi\\\":\\\"umb://element/d5927ffb482a4be398fac3cab6aa33b8\\\"},{\\\"contentUdi\\\":\\\"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\\\"},{\\\"contentUdi\\\":\\\"umb://element/02043207856849d88a17fb9cac04ee19\\\"},{\\\"contentUdi\\\":\\\"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\\\"},{\\\"contentUdi\\\":\\\"umb://element/5b47943a0da243708f9a63813597b7bd\\\"},{\\\"contentUdi\\\":\\\"umb://element/bfbdab9611094c9896d29c6f2374cd89\\\"},{\\\"contentUdi\\\":\\\"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\\\"},{\\\"contentUdi\\\":\\\"umb://element/f77ddd2526bc494cbcc71d525b49ae56\\\"},{\\\"contentUdi\\\":\\\"umb://element/f805d1db2913488e9976b144d12d7913\\\"},{\\\"contentUdi\\\":\\\"umb://element/3d3e88078540401c85b1e001455a1bef\\\"},{\\\"contentUdi\\\":\\\"umb://element/843bb38e3e6242d787db8defeb8e1b53\\\"},{\\\"contentUdi\\\":\\\"umb://element/a898e814eaea4e80a258195c552fb70b\\\"},{\\\"contentUdi\\\":\\\"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\\\"},{\\\"contentUdi\\\":\\\"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\\\"},{\\\"contentUdi\\\":\\\"umb://element/c405c6afde7845949307128e5e606799\\\"},{\\\"contentUdi\\\":\\\"umb://element/461d601e6ba9465fba581a92214b17ff\\\"},{\\\"contentUdi\\\":\\\"umb://element/9332cee318c7428db9321e6a2c6f6e09\\\"},{\\\"contentUdi\\\":\\\"umb://element/31ee9c8b6dde44149082ef7899105498\\\"},{\\\"contentUdi\\\":\\\"umb://element/5a5abd23215c493c9012794253fc4cca\\\"},{\\\"contentUdi\\\":\\\"umb://element/ccce849536754853bd86c23ce8fd1ad6\\\"},{\\\"contentUdi\\\":\\\"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\\\"},{\\\"contentUdi\\\":\\\"umb://element/4560312fc1c340179a9a421185571bf3\\\"},{\\\"contentUdi\\\":\\\"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\\\"},{\\\"contentUdi\\\":\\\"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\\\"},{\\\"contentUdi\\\":\\\"umb://element/bcc8ff0ae01e4220a1730b4f97160416\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/55e0fd24d41945b0b9a5c119eadab387\\\",\\\"title\\\":\\\"المادة الأولى\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p> لغرض تطبيق هذا النظام، يقصد بالعبارات والألفاظ الآتية -أينما وردت فيه- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br><strong>النظام:</strong> نظام المساهمات العقارية.<br><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المجلس:</strong> مجلس إدارة الهيئة.<br><strong>الرئيس:</strong> الرئيس التنفيذي للهيئة.<br><strong>المساهمة العقارية:</strong> مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقارية.<br><strong>المساهم:</strong> الشخص الذي يملك حصة مشاعة في المساهمة العقارية.<br><strong>الترخيص:</strong> ترخيص مساهمة عقارية يصدر من الهيئة.<br><strong>المرخص له:</strong> الشخص الحاصل على الترخيص.<br><strong>مدير المساهمة العقارية:</strong> الشخص المعين لإدارة المساهمة العقارية.<br><strong>حساب الضمان:</strong> الحساب المصرفي الخاص بالمساهمة العقارية.<br><strong>سجل المساهمين:</strong> سجل تقيد فيه أسماء المساهمين وحصصهم وأي تغيير يحدث في ملكية حصصهم.<br><strong>الجمعية: </strong>جمعية المساهمين.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c671b0d4696e40b2847abfcabf3b0f70\\\",\\\"title\\\":\\\"المادة الثانية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يهدف النظام إلى تنظيم نشاط المساهمات العقارية، وإلى رفع مستوى الشفافية والإفصاح فيه، وإلى حماية حقوق جميع أطراف المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/74b2e03476784f1099788370cb1f3819\\\",\\\"title\\\":\\\"المادة الثالثة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;دون إخلال باختصاصات الجهات الحكومية الأخرى، تتولى الهيئة تنظيم نشاط المساهمات العقارية وفقاً لما يحدده النظام واللائحة، ولها على وجه خاص ما يأتي:</p>\\\\\\\\n<p>1. إصدار الترخيص وتعديله وإلغاؤه. وتحدد اللائحة الشروط والمتطلبات والإجراءات اللازمة لذلك.</p>\\\\\\\\n<p>2. تصنيف المساهمات العقارية بحسب الحجم أو النوع أو الموقع، ووضع الشروط والمتطلبات الملائمة والمدد الزمنية للمساهمة العقارية بحسب تصنيفها.</p>\\\\\\\\n<p>3. وضع شروط تأهيل وتصنيف المطورين العقاريين لغرض طرح المساهمات العقارية.</p>\\\\\\\\n<p>4. وضع شروط تأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\\\\\\\n<p>5. وضع أسس تحدد استحقاقات المرخص له نظير أتعابه، وما يتقاضاه من عمولات.</p>\\\\\\\\n<p>6. الرقابة والإشراف على المساهمات العقارية.<br>وللهيئة الاستعانة بأي جهة حكومية أخرى أو بالقطاع الخاص؛ للقيام بأي مهمة مسندة إليها بموجب النظام أو اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0634a93087934125849f2c1562659acd\\\",\\\"title\\\":\\\"المادة الرابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;لا يجوز طرح المساهمة العقارية ولا الإعلان عنها ولا تسويقها ولا جمع الأموال لها إلا بعد موافقة هيئة السوق المالية والحصول على ترخيص من الهيئة -وفقاً لأحكام النظام واللائحة- وذلك بعد التحقق مما يأتي:</p>\\\\\\\\n<p>1. أن يكون العقار محل المساهمة العقارية مملوكاً بموجب صك ملكية ساري المفعول، ثابتة سلامته، بناءً على إفادة من الجهة التي أصدرته.</p>\\\\\\\\n<p>2. أن يكون العقار محل المساهمة العقارية حاصلاً على الموافقات اللازمة لتطويره من الجهات المختصة وذلك وفقاً لما تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/cf03dadf375a415194ac546207572432\\\",\\\"title\\\":\\\"المادة الخامسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب أن يكون المرخص له مؤهلاً ومصنفاً من الهيئة لممارسة نشاط المساهمات العقارية وفقاً لما تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\\\",\\\"title\\\":\\\"المادة السادسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحدد رأس مال المساهمة العقارية، الذي على أساسه يُحتسب عدد الحصص ومقدارها من خلال التكلفة التقديرية من قبل جهة تقييمية مرخصة، بعد موافقة الهيئة وهيئة السوق المالية وفقاً لما تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\\\",\\\"title\\\":\\\"المادة السابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للهيئة اشتراط إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية بما لا يتجاوز (15%) من تكلفتها التقديرية، وذلك لمقابلة أي مصاريف إضافية غير متوقعة. ويكون التصرف بالمبلغ الاحتياطي بموافقة الجمعية. وتحدد اللائحة الشروط اللازمة لذلك، وكيفية إعادته للمساهمين في حال عدم التصرف به.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f1444ea00c1a4bc9b50257a28d85744a\\\",\\\"title\\\":\\\"المادة الثامنة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحق للمساهم الاشتراك في المساهمة العقارية، بحصة عينية أو نقدية. وتحدد اللائحة نوع الحصة العينية والشروط الواجب توافرها فيها.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/aff6bb9b068a41d4b076a8025bf584d7\\\",\\\"title\\\":\\\"المادة التاسعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1. يقسم رأس مال المساهمة العقارية إلى حصص متساوية القيمة والحقوق، وتكون مسؤولية المساهمين في حدود ما يملكون من حصص في المساهمة العقارية.</p>\\\\\\\\n<p>2. تقوم هيئة السوق المالية بتنظيم سجل المساهمين الخاص بالمساهمة العقارية</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/19c16ae7c831488aa0d478accbf7c206\\\",\\\"title\\\":\\\"المادة العاشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لا يجوز الإقراض من رأس مال المساهمة العقارية، ويجوز الاقتراض بضمان أموال أو أصول المساهمة العقارية على أن يتم تضمين اتفاقية المساهمة ذلك، وتحدد اللائحة الاشتراطات المنظمة لذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e406eb0ab60b43c1a21015db6158bf6b\\\",\\\"title\\\":\\\"المادة الحادية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون صافي أصول المساهمة العقارية من أصول ثابتة نقدية وعينية أو حقوق لدى الغير؛ مملوكة للمساهمة العقارية. وليس لدائني المساهمين أو المرخص له أو مدير المساهمة العقارية أي حق في أموال المساهمة العقارية أو أصولها عدا ما يملكونه من الحصص في المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/73a6312ad353471497af7e65011352c2\\\",\\\"title\\\":\\\"المادة الثانية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1.يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن النسبة التي تحددها اللائحة، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\\\\\\\n<p>2.يجوز لبقية المساهمين في المساهمة العقارية التصرف بحصصهم وفق الشروط التي تحددها اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7085830f68494aa8b1741e1179df92a6\\\",\\\"title\\\":\\\"المادة الثالثة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;</p>\\\\\\\\n<p>يكون المرخص له هو المسؤول عن جميع ما يتعلق بالمساهمة العقارية تجاه المساهم والهيئة وهيئة السوق المالية وأي من الجهات الحكومية ذات العلاقة والغير. وتحدد اللائحة اختصاصات المرخص له، وحدود مسؤولياته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9507d21d02b24b3b8c640fa248d37171\\\",\\\"title\\\":\\\"المادة الرابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>مع مراعاة ما نصت عليه المادة (التاسعة عشرة) من النظام، على المرخص له الالتزام بالإشراف على أعمال مدير المساهمة العقارية، وتمكينه من القيام بواجباته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/eeb906fad1e3419194edfe984372ee60\\\",\\\"title\\\":\\\"المادة الخامسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يفتح المرخص له حساب ضمان في أحد البنوك المرخص لها باسم المساهمة العقارية. وتضع الهيئة بالتنسيق مع البنك المركزي السعودي الضوابط اللازمة لحساب الضمان.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2724d265a2704eaf90b248fa69977d00\\\",\\\"title\\\":\\\"المادة السادسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تقوم هيئة السوق المالية بتنظيم إصدار شهادة المساهمة العقارية التي تثبت تملك المساهم حصة في المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/fa8b050afc8c4649b501c4090fdd23db\\\",\\\"title\\\":\\\"المادة السابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تكتسب المساهمة العقارية الشخصية الاعتبارية بصدور الترخيص من قبل الهيئة، وتكون خاضعة لأحكام النظام واللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d5927ffb482a4be398fac3cab6aa33b8\\\",\\\"title\\\":\\\"المادة الثامنة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب على المرخص له تعيين محاسب قانوني واستشاري هندسي لكل مساهمة عقارية. وتحدد اللائحة شروط ومتطلبات ومسؤوليات ومهمات وآلية عمل كل منهما وما يترتب عليه، فيما يتعلق بالمساهمات العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\\\",\\\"title\\\":\\\"المادة التاسعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يدير المساهمة العقارية مدير المساهمة العقارية الذي يُعيّنه المرخص له. وتحدد اللائحة اشتراطات ومتطلبات مدير المساهمة العقارية وصلاحياته ومهماته ومسؤولياته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/02043207856849d88a17fb9cac04ee19\\\",\\\"title\\\":\\\"المادة العشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحق للمرخص له وللهيئة وللجمعية عزل مدير المساهمة العقارية وفق ما تحدده اللائحة في حال إساءته استخدام صلاحياته أو إخلاله بتنفيذ التزاماته، ولا يخل ذلك بأي عقوبة قد تفرض عليه جراء ذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\\\",\\\"title\\\":\\\"المادة الحادية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بما نصت عليه المادة (الرابعة عشرة) من النظام، لا يجوز للمرخص له ولا لمدير المساهمة العقارية اتخاذ أي قرار أو إجراء إذا كان هناك تعارض مصالح قائم أو محتمل في هذا القرار أو الإجراء. وتحدد اللائحة طريقة التعامل مع حالات تعارض المصالح.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bfbdab9611094c9896d29c6f2374cd89\\\",\\\"title\\\":\\\"المادة الثانية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون للمساهمة العقارية جمعية تتشكل من جميع المساهمين المسجلين في سجل المساهمة العقارية. وتحدد اللائحة اختصاصات الجمعية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\\\",\\\"title\\\":\\\"المادة الثالثة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنعقد اجتماعات الجمعية بدعوة من المرخص له أو مدير المساهمة العقارية أو مساهمين يمثلون (10%) من رأس مال المساهمة العقارية أو بطلب من الهيئة، ويحدد في الدعوة للاجتماع مكان انعقاده.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f77ddd2526bc494cbcc71d525b49ae56\\\",\\\"title\\\":\\\"المادة الرابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يرأس المرخص له -أو من يمثله- الجمعية، ويحق لجميع المساهمين حضور اجتماعات الجمعية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/3d3e88078540401c85b1e001455a1bef\\\",\\\"title\\\":\\\"المادة الخامسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;لا يكون اجتماع الجمعية (الأول) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (ثلثي) رأس مال المساهمة العقارية، وإذا لم يتوافر النصاب اللازم لعقد اجتماع الجمعية (الأول)، وجهت الدعوة إلى اجتماع (ثانٍ) يعقد خلال الأيام الـــ(خمسة عشر) التالية للاجتماع (الأول)، ولا يكون الاجتماع (الثاني) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (نصف) رأس مال المساهمة العقارية. وتصدر قرارات الجمعية في الاجتماعين (الأول) و(الثاني) بأغلبية الحصص الممثلة في الاجتماع، وفي حال تساوي الأصوات يعاد التصويت مرة أخرى. وإذا لم يتوافر النصاب اللازم في الاجتماع (الثاني)، وجهت الدعوة إلى اجتماع (ثالث) يعقد خلال الأيام الـــــ(سبعة) التالية للاجتماع (الثاني)، ويكون الاجتماع صحيحا أيًّا كانت نسبة الحصص الممثلة فيه بشرط ألا يقل عدد الحضور عن (ثلاثة) أشخاص، وتصدر قرارات الجمعية بأغلبية حصص الممثلين في الاجتماع.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/843bb38e3e6242d787db8defeb8e1b53\\\",\\\"title\\\":\\\"المادة السادسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز عقد اجتماعات الجمعية والتصويت على قراراتها؛ بواسطة وسائل التقنية الحديثة التي تحددها اللائحة.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a898e814eaea4e80a258195c552fb70b\\\",\\\"title\\\":\\\"المادة السابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لا يجوز بيع أصول المساهمة العقارية إلا بعد تقييم الأصول من مقيمين معتمدين وفقاً لنظام المقيمين المعتمدين، ووفقاً لما تحدده اللائحة من إجراءات. ويعد باطلاً أي تصرف ينطوي على إخلال بما نصت عليه هذه المادة</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\\\",\\\"title\\\":\\\"المادة الثامنة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون بيع أصول المساهمة العقارية بإحدى الطرق الآتية:&nbsp;</p>\\\\\\\\n<p>1. البيع بمزاد علني.&nbsp;</p>\\\\\\\\n<p>2. البيع المباشر لكامل أو لجزء من المساهمة العقارية.&nbsp;</p>\\\\\\\\n<p>3. أي طريقة أخرى تحددها اللائحة. &nbsp;&nbsp;</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\\\",\\\"title\\\":\\\"المادة التاسعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بما نصت عليه المادة (السابعة عشرة) من النظام، تحتفظ المساهمة العقارية بالشخصية الاعتبارية بالقدر اللازم لتصفيتها، وتنقضي بإحدى الحالات الآتية:</p>\\\\\\\\n<p>1. بيعها وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p>2. انقضاء المدة المحددة لها ما لم تمدد وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p>3. استحالة تحقق الغرض الذي أسست من أجله.</p>\\\\\\\\n<p>4. إلغاؤها وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p>5. صدور حكم قضائي نهائي بتصفيتها.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c405c6afde7845949307128e5e606799\\\",\\\"title\\\":\\\"المادة الثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب أن تودع جميع العوائد المالية المتعلقة بالمساهمة العقارية مباشرة في حساب الضمان.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9332cee318c7428db9321e6a2c6f6e09\\\",\\\"title\\\":\\\"المادة الحادية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يتولى ضبط ما يقع من مخالفات لأحكام النظام أو اللائحة موظفون من الهيئة ومن أي جهة أخرى ترى الهيئة الاستعانة بموظفيها، يصدر بتعيينهم قرار من الرئيس بعد موافقة جهاتهم. ولمسؤولي الضبط دخول المواقع والمشاريع المتعلقة بالأنشطة المشمولة بالنظام بما فيها مقر المرخص له، وعليهم ضبط المخالفات والتحفظ على المستندات والوثائق والأدلة المتعلقة بها وفقاً لإجراءات الضبط الصادرة عن الهيئة ويكونون تحت إشراف الهيئة، ولهم الاستعانة بالجهات الأمنية عند الحاجة. وتحدد اللائحة طريقة عملهم، وصلاحياتهم، ومكافآتهم.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/31ee9c8b6dde44149082ef7899105498\\\",\\\"title\\\":\\\"المادة الثانية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بما نصت عليه المادة (الخامسة والثلاثون) من النظام، يعاقب كل من يخالف أيًّا من أحكام النظام أو اللائحة بواحدة أو أكثر من العقوبات الآتية:</p>\\\\\\\\n<p>1. الإنذار.</p>\\\\\\\\n<p>2. إيقاف الترخيص مدة لا تزيد على (سنة).</p>\\\\\\\\n<p>3. إلغاء الترخيص.&nbsp;</p>\\\\\\\\n<p>4. غرامة لا تزيد على (10,000,000) عشرة ملايين ريال.</p>\\\\\\\\n<p>5. منع المرخص له أو مدير المساهمة العقارية من القيام -مستقبلاً- بأي عمل مرتبط بالمساهمات العقارية لمدة لا تتجاوز (10) عشر سنوات.<br>ويصدر المجلس جدولاً يتضمن تصنيفاً للمخالفات والعقوبات المقررة لها بناءً على ما نصت عليه هذه المادة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5a5abd23215c493c9012794253fc4cca\\\",\\\"title\\\":\\\"المادة الثالثة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تُكوّن بقرار من رئيس الهيئة لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة ويسمى أحدهم رئيساً، ويكون من بينهم مستشار شرعي أو نظامي؛ تتولى النظر في المخالفات وإيقاع العقوبات المنصوص عليها في المادة (الثانية والثلاثين) من النظام، وذلك بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها، ويعتمد قرار اللجنة من رئيس الهيئة أو من يفوضه بذلك. ويصدر الرئيس قواعد عمل اللجنة وتحديد مكافآت أعضائها.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/ccce849536754853bd86c23ce8fd1ad6\\\",\\\"title\\\":\\\"المادة الرابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز التظلم من قرار اللجنة المنصوص عليها في المادة (الثالثة والثلاثين) من النظام أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ الإبلاغ بالقرار.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\\\",\\\"title\\\":\\\"المادة الخامسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بأي عقوبة منصوص عليها في أي نظام آخر، يعاقب بالسجن مدة لا تزيد على (ثلاث) سنوات، كل من يخالف أيًّا من أحكام المواد الآتية: (الرابعة)، و(الحادية والعشرون)، و(السابعة والعشرون)، و(الثلاثون)، من النظام، وتحال إلى النيابة العامة؛ للتحقيق فيها، والادعاء فيها أمام المحكمة المختصة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\\\",\\\"title\\\":\\\"المادة السادسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال باختصاصات الهيئة، تنظم هيئة السوق المالية بالاتفاق مع الهيئة ما يتعلق بجمع الأموال لغرض طرح المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\\\",\\\"title\\\":\\\"المادة السابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يصدر المجلس اللائحة بالاتفاق مع هيئة السوق المالية، وذلك خلال (مائة وعشرين) يوماً من تاريخ صدور النظام، ويعمل بها من تاريخ العمل به.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bcc8ff0ae01e4220a1730b4f97160416\\\",\\\"title\\\":\\\"المادة الثامنة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>ينشر النظام في الجريدة الرسمية، ويعمل به بعد (مائة وعشرين) يوماً من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4560312fc1c340179a9a421185571bf3\\\",\\\"title\\\":\\\"الفصل السابع: أحكام ختامية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/461d601e6ba9465fba581a92214b17ff\\\",\\\"title\\\":\\\"الفصل السادس: المخالفات والعقوبات\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f805d1db2913488e9976b144d12d7913\\\",\\\"title\\\":\\\"الفصل الخامس: انقضاء المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5b47943a0da243708f9a63813597b7bd\\\",\\\"title\\\":\\\"الفصل الرابع: جمعية المساهمين\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f0c60f03f2f046389ced0ad80ae03515\\\",\\\"title\\\":\\\"الفصل الثالث: إدارة المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a4765edf58f94b149dc6823b994db0ec\\\",\\\"title\\\":\\\"الفصل الثاني: الترخيص والإشتراكات\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\\\",\\\"title\\\":\\\"الفصل الأول: تعريفات وأحكام عامة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null}],\\\"settingsData\\\":[]}\"","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\\\"},{\\\"contentUdi\\\":\\\"umb://element/55e0fd24d41945b0b9a5c119eadab387\\\"},{\\\"contentUdi\\\":\\\"umb://element/c671b0d4696e40b2847abfcabf3b0f70\\\"},{\\\"contentUdi\\\":\\\"umb://element/74b2e03476784f1099788370cb1f3819\\\"},{\\\"contentUdi\\\":\\\"umb://element/0634a93087934125849f2c1562659acd\\\"},{\\\"contentUdi\\\":\\\"umb://element/a4765edf58f94b149dc6823b994db0ec\\\"},{\\\"contentUdi\\\":\\\"umb://element/cf03dadf375a415194ac546207572432\\\"},{\\\"contentUdi\\\":\\\"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\\\"},{\\\"contentUdi\\\":\\\"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\\\"},{\\\"contentUdi\\\":\\\"umb://element/f1444ea00c1a4bc9b50257a28d85744a\\\"},{\\\"contentUdi\\\":\\\"umb://element/aff6bb9b068a41d4b076a8025bf584d7\\\"},{\\\"contentUdi\\\":\\\"umb://element/19c16ae7c831488aa0d478accbf7c206\\\"},{\\\"contentUdi\\\":\\\"umb://element/e406eb0ab60b43c1a21015db6158bf6b\\\"},{\\\"contentUdi\\\":\\\"umb://element/73a6312ad353471497af7e65011352c2\\\"},{\\\"contentUdi\\\":\\\"umb://element/f0c60f03f2f046389ced0ad80ae03515\\\"},{\\\"contentUdi\\\":\\\"umb://element/7085830f68494aa8b1741e1179df92a6\\\"},{\\\"contentUdi\\\":\\\"umb://element/9507d21d02b24b3b8c640fa248d37171\\\"},{\\\"contentUdi\\\":\\\"umb://element/eeb906fad1e3419194edfe984372ee60\\\"},{\\\"contentUdi\\\":\\\"umb://element/2724d265a2704eaf90b248fa69977d00\\\"},{\\\"contentUdi\\\":\\\"umb://element/fa8b050afc8c4649b501c4090fdd23db\\\"},{\\\"contentUdi\\\":\\\"umb://element/d5927ffb482a4be398fac3cab6aa33b8\\\"},{\\\"contentUdi\\\":\\\"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\\\"},{\\\"contentUdi\\\":\\\"umb://element/02043207856849d88a17fb9cac04ee19\\\"},{\\\"contentUdi\\\":\\\"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\\\"},{\\\"contentUdi\\\":\\\"umb://element/5b47943a0da243708f9a63813597b7bd\\\"},{\\\"contentUdi\\\":\\\"umb://element/bfbdab9611094c9896d29c6f2374cd89\\\"},{\\\"contentUdi\\\":\\\"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\\\"},{\\\"contentUdi\\\":\\\"umb://element/f77ddd2526bc494cbcc71d525b49ae56\\\"},{\\\"contentUdi\\\":\\\"umb://element/f805d1db2913488e9976b144d12d7913\\\"},{\\\"contentUdi\\\":\\\"umb://element/3d3e88078540401c85b1e001455a1bef\\\"},{\\\"contentUdi\\\":\\\"umb://element/843bb38e3e6242d787db8defeb8e1b53\\\"},{\\\"contentUdi\\\":\\\"umb://element/a898e814eaea4e80a258195c552fb70b\\\"},{\\\"contentUdi\\\":\\\"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\\\"},{\\\"contentUdi\\\":\\\"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\\\"},{\\\"contentUdi\\\":\\\"umb://element/c405c6afde7845949307128e5e606799\\\"},{\\\"contentUdi\\\":\\\"umb://element/461d601e6ba9465fba581a92214b17ff\\\"},{\\\"contentUdi\\\":\\\"umb://element/9332cee318c7428db9321e6a2c6f6e09\\\"},{\\\"contentUdi\\\":\\\"umb://element/31ee9c8b6dde44149082ef7899105498\\\"},{\\\"contentUdi\\\":\\\"umb://element/5a5abd23215c493c9012794253fc4cca\\\"},{\\\"contentUdi\\\":\\\"umb://element/ccce849536754853bd86c23ce8fd1ad6\\\"},{\\\"contentUdi\\\":\\\"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\\\"},{\\\"contentUdi\\\":\\\"umb://element/4560312fc1c340179a9a421185571bf3\\\"},{\\\"contentUdi\\\":\\\"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\\\"},{\\\"contentUdi\\\":\\\"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\\\"},{\\\"contentUdi\\\":\\\"umb://element/bcc8ff0ae01e4220a1730b4f97160416\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/55e0fd24d41945b0b9a5c119eadab387\\\",\\\"title\\\":\\\"المادة الأولى\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p> لغرض تطبيق هذا النظام، يقصد بالعبارات والألفاظ الآتية -أينما وردت فيه- المعاني المبينة أمام كل منها، ما لم يقتض السياق غير ذلك:<br><strong>النظام:</strong> نظام المساهمات العقارية.<br><strong>اللائحة:</strong> اللائحة التنفيذية للنظام.<br><strong>الهيئة:</strong> الهيئة العامة للعقار.<br><strong>المجلس:</strong> مجلس إدارة الهيئة.<br><strong>الرئيس:</strong> الرئيس التنفيذي للهيئة.<br><strong>المساهمة العقارية:</strong> مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقارية.<br><strong>المساهم:</strong> الشخص الذي يملك حصة مشاعة في المساهمة العقارية.<br><strong>الترخيص:</strong> ترخيص مساهمة عقارية يصدر من الهيئة.<br><strong>المرخص له:</strong> الشخص الحاصل على الترخيص.<br><strong>مدير المساهمة العقارية:</strong> الشخص المعين لإدارة المساهمة العقارية.<br><strong>حساب الضمان:</strong> الحساب المصرفي الخاص بالمساهمة العقارية.<br><strong>سجل المساهمين:</strong> سجل تقيد فيه أسماء المساهمين وحصصهم وأي تغيير يحدث في ملكية حصصهم.<br><strong>الجمعية: </strong>جمعية المساهمين.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c671b0d4696e40b2847abfcabf3b0f70\\\",\\\"title\\\":\\\"المادة الثانية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يهدف النظام إلى تنظيم نشاط المساهمات العقارية، وإلى رفع مستوى الشفافية والإفصاح فيه، وإلى حماية حقوق جميع أطراف المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/74b2e03476784f1099788370cb1f3819\\\",\\\"title\\\":\\\"المادة الثالثة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;دون إخلال باختصاصات الجهات الحكومية الأخرى، تتولى الهيئة تنظيم نشاط المساهمات العقارية وفقاً لما يحدده النظام واللائحة، ولها على وجه خاص ما يأتي:</p>\\\\\\\\n<p>1. إصدار الترخيص وتعديله وإلغاؤه. وتحدد اللائحة الشروط والمتطلبات والإجراءات اللازمة لذلك.</p>\\\\\\\\n<p>2. تصنيف المساهمات العقارية بحسب الحجم أو النوع أو الموقع، ووضع الشروط والمتطلبات الملائمة والمدد الزمنية للمساهمة العقارية بحسب تصنيفها.</p>\\\\\\\\n<p>3. وضع شروط تأهيل وتصنيف المطورين العقاريين لغرض طرح المساهمات العقارية.</p>\\\\\\\\n<p>4. وضع شروط تأهيل وتصنيف ممارسي نشاط المساهمات العقارية.</p>\\\\\\\\n<p>5. وضع أسس تحدد استحقاقات المرخص له نظير أتعابه، وما يتقاضاه من عمولات.</p>\\\\\\\\n<p>6. الرقابة والإشراف على المساهمات العقارية.<br>وللهيئة الاستعانة بأي جهة حكومية أخرى أو بالقطاع الخاص؛ للقيام بأي مهمة مسندة إليها بموجب النظام أو اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0634a93087934125849f2c1562659acd\\\",\\\"title\\\":\\\"المادة الرابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;لا يجوز طرح المساهمة العقارية ولا الإعلان عنها ولا تسويقها ولا جمع الأموال لها إلا بعد موافقة هيئة السوق المالية والحصول على ترخيص من الهيئة -وفقاً لأحكام النظام واللائحة- وذلك بعد التحقق مما يأتي:</p>\\\\\\\\n<p>1. أن يكون العقار محل المساهمة العقارية مملوكاً بموجب صك ملكية ساري المفعول، ثابتة سلامته، بناءً على إفادة من الجهة التي أصدرته.</p>\\\\\\\\n<p>2. أن يكون العقار محل المساهمة العقارية حاصلاً على الموافقات اللازمة لتطويره من الجهات المختصة وذلك وفقاً لما تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/cf03dadf375a415194ac546207572432\\\",\\\"title\\\":\\\"المادة الخامسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب أن يكون المرخص له مؤهلاً ومصنفاً من الهيئة لممارسة نشاط المساهمات العقارية وفقاً لما تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/6e5a82742efa41f5b2f9c10f2856ad49\\\",\\\"title\\\":\\\"المادة السادسة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحدد رأس مال المساهمة العقارية، الذي على أساسه يُحتسب عدد الحصص ومقدارها من خلال التكلفة التقديرية من قبل جهة تقييمية مرخصة، بعد موافقة الهيئة وهيئة السوق المالية وفقاً لما تحدده اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bb8bc6b7bfdb4096b2755f5933578cdd\\\",\\\"title\\\":\\\"المادة السابعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>للهيئة اشتراط إضافة مبلغ احتياطي إلى رأس مال المساهمة العقارية بما لا يتجاوز (15%) من تكلفتها التقديرية، وذلك لمقابلة أي مصاريف إضافية غير متوقعة. ويكون التصرف بالمبلغ الاحتياطي بموافقة الجمعية. وتحدد اللائحة الشروط اللازمة لذلك، وكيفية إعادته للمساهمين في حال عدم التصرف به.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f1444ea00c1a4bc9b50257a28d85744a\\\",\\\"title\\\":\\\"المادة الثامنة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحق للمساهم الاشتراك في المساهمة العقارية، بحصة عينية أو نقدية. وتحدد اللائحة نوع الحصة العينية والشروط الواجب توافرها فيها.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/aff6bb9b068a41d4b076a8025bf584d7\\\",\\\"title\\\":\\\"المادة التاسعة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1. يقسم رأس مال المساهمة العقارية إلى حصص متساوية القيمة والحقوق، وتكون مسؤولية المساهمين في حدود ما يملكون من حصص في المساهمة العقارية.</p>\\\\\\\\n<p>2. تقوم هيئة السوق المالية بتنظيم سجل المساهمين الخاص بالمساهمة العقارية</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/19c16ae7c831488aa0d478accbf7c206\\\",\\\"title\\\":\\\"المادة العاشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لا يجوز الإقراض من رأس مال المساهمة العقارية، ويجوز الاقتراض بضمان أموال أو أصول المساهمة العقارية على أن يتم تضمين اتفاقية المساهمة ذلك، وتحدد اللائحة الاشتراطات المنظمة لذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/e406eb0ab60b43c1a21015db6158bf6b\\\",\\\"title\\\":\\\"المادة الحادية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون صافي أصول المساهمة العقارية من أصول ثابتة نقدية وعينية أو حقوق لدى الغير؛ مملوكة للمساهمة العقارية. وليس لدائني المساهمين أو المرخص له أو مدير المساهمة العقارية أي حق في أموال المساهمة العقارية أو أصولها عدا ما يملكونه من الحصص في المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/73a6312ad353471497af7e65011352c2\\\",\\\"title\\\":\\\"المادة الثانية عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>1.يجب ألا تقل نسبة المرخص له في المساهمة العقارية عن النسبة التي تحددها اللائحة، وأن يحتفظ لنفسه بملكية هذه النسبة حتى انقضاء المساهمة العقارية.</p>\\\\\\\\n<p>2.يجوز لبقية المساهمين في المساهمة العقارية التصرف بحصصهم وفق الشروط التي تحددها اللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7085830f68494aa8b1741e1179df92a6\\\",\\\"title\\\":\\\"المادة الثالثة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp;</p>\\\\\\\\n<p>يكون المرخص له هو المسؤول عن جميع ما يتعلق بالمساهمة العقارية تجاه المساهم والهيئة وهيئة السوق المالية وأي من الجهات الحكومية ذات العلاقة والغير. وتحدد اللائحة اختصاصات المرخص له، وحدود مسؤولياته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9507d21d02b24b3b8c640fa248d37171\\\",\\\"title\\\":\\\"المادة الرابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>مع مراعاة ما نصت عليه المادة (التاسعة عشرة) من النظام، على المرخص له الالتزام بالإشراف على أعمال مدير المساهمة العقارية، وتمكينه من القيام بواجباته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/eeb906fad1e3419194edfe984372ee60\\\",\\\"title\\\":\\\"المادة الخامسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يفتح المرخص له حساب ضمان في أحد البنوك المرخص لها باسم المساهمة العقارية. وتضع الهيئة بالتنسيق مع البنك المركزي السعودي الضوابط اللازمة لحساب الضمان.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/2724d265a2704eaf90b248fa69977d00\\\",\\\"title\\\":\\\"المادة السادسة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تقوم هيئة السوق المالية بتنظيم إصدار شهادة المساهمة العقارية التي تثبت تملك المساهم حصة في المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/fa8b050afc8c4649b501c4090fdd23db\\\",\\\"title\\\":\\\"المادة السابعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تكتسب المساهمة العقارية الشخصية الاعتبارية بصدور الترخيص من قبل الهيئة، وتكون خاضعة لأحكام النظام واللائحة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/d5927ffb482a4be398fac3cab6aa33b8\\\",\\\"title\\\":\\\"المادة الثامنة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب على المرخص له تعيين محاسب قانوني واستشاري هندسي لكل مساهمة عقارية. وتحدد اللائحة شروط ومتطلبات ومسؤوليات ومهمات وآلية عمل كل منهما وما يترتب عليه، فيما يتعلق بالمساهمات العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a8a12585c3ce4e8096aa665e9e8e453c\\\",\\\"title\\\":\\\"المادة التاسعة عشرة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يدير المساهمة العقارية مدير المساهمة العقارية الذي يُعيّنه المرخص له. وتحدد اللائحة اشتراطات ومتطلبات مدير المساهمة العقارية وصلاحياته ومهماته ومسؤولياته.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/02043207856849d88a17fb9cac04ee19\\\",\\\"title\\\":\\\"المادة العشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يحق للمرخص له وللهيئة وللجمعية عزل مدير المساهمة العقارية وفق ما تحدده اللائحة في حال إساءته استخدام صلاحياته أو إخلاله بتنفيذ التزاماته، ولا يخل ذلك بأي عقوبة قد تفرض عليه جراء ذلك.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5581a7af40ef45aa9f7220bd6954ae8f\\\",\\\"title\\\":\\\"المادة الحادية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بما نصت عليه المادة (الرابعة عشرة) من النظام، لا يجوز للمرخص له ولا لمدير المساهمة العقارية اتخاذ أي قرار أو إجراء إذا كان هناك تعارض مصالح قائم أو محتمل في هذا القرار أو الإجراء. وتحدد اللائحة طريقة التعامل مع حالات تعارض المصالح.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bfbdab9611094c9896d29c6f2374cd89\\\",\\\"title\\\":\\\"المادة الثانية والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون للمساهمة العقارية جمعية تتشكل من جميع المساهمين المسجلين في سجل المساهمة العقارية. وتحدد اللائحة اختصاصات الجمعية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9fa470535a3b4ccfb4a470a38d1aebc8\\\",\\\"title\\\":\\\"المادة الثالثة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تنعقد اجتماعات الجمعية بدعوة من المرخص له أو مدير المساهمة العقارية أو مساهمين يمثلون (10%) من رأس مال المساهمة العقارية أو بطلب من الهيئة، ويحدد في الدعوة للاجتماع مكان انعقاده.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f77ddd2526bc494cbcc71d525b49ae56\\\",\\\"title\\\":\\\"المادة الرابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يرأس المرخص له -أو من يمثله- الجمعية، ويحق لجميع المساهمين حضور اجتماعات الجمعية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/3d3e88078540401c85b1e001455a1bef\\\",\\\"title\\\":\\\"المادة الخامسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;لا يكون اجتماع الجمعية (الأول) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (ثلثي) رأس مال المساهمة العقارية، وإذا لم يتوافر النصاب اللازم لعقد اجتماع الجمعية (الأول)، وجهت الدعوة إلى اجتماع (ثانٍ) يعقد خلال الأيام الـــ(خمسة عشر) التالية للاجتماع (الأول)، ولا يكون الاجتماع (الثاني) صحيحاً إلا إذا حضره مساهمون يمثلون ما لا يقل عن (نصف) رأس مال المساهمة العقارية. وتصدر قرارات الجمعية في الاجتماعين (الأول) و(الثاني) بأغلبية الحصص الممثلة في الاجتماع، وفي حال تساوي الأصوات يعاد التصويت مرة أخرى. وإذا لم يتوافر النصاب اللازم في الاجتماع (الثاني)، وجهت الدعوة إلى اجتماع (ثالث) يعقد خلال الأيام الـــــ(سبعة) التالية للاجتماع (الثاني)، ويكون الاجتماع صحيحا أيًّا كانت نسبة الحصص الممثلة فيه بشرط ألا يقل عدد الحضور عن (ثلاثة) أشخاص، وتصدر قرارات الجمعية بأغلبية حصص الممثلين في الاجتماع.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/843bb38e3e6242d787db8defeb8e1b53\\\",\\\"title\\\":\\\"المادة السادسة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز عقد اجتماعات الجمعية والتصويت على قراراتها؛ بواسطة وسائل التقنية الحديثة التي تحددها اللائحة.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a898e814eaea4e80a258195c552fb70b\\\",\\\"title\\\":\\\"المادة السابعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>لا يجوز بيع أصول المساهمة العقارية إلا بعد تقييم الأصول من مقيمين معتمدين وفقاً لنظام المقيمين المعتمدين، ووفقاً لما تحدده اللائحة من إجراءات. ويعد باطلاً أي تصرف ينطوي على إخلال بما نصت عليه هذه المادة</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/92a3b54ff3d74e58b8a9ad966b2c9c28\\\",\\\"title\\\":\\\"المادة الثامنة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يكون بيع أصول المساهمة العقارية بإحدى الطرق الآتية:&nbsp;</p>\\\\\\\\n<p>1. البيع بمزاد علني.&nbsp;</p>\\\\\\\\n<p>2. البيع المباشر لكامل أو لجزء من المساهمة العقارية.&nbsp;</p>\\\\\\\\n<p>3. أي طريقة أخرى تحددها اللائحة. &nbsp;&nbsp;</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bfbf85e05ac146ffba6ae1bbdc3d6848\\\",\\\"title\\\":\\\"المادة التاسعة والعشرون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بما نصت عليه المادة (السابعة عشرة) من النظام، تحتفظ المساهمة العقارية بالشخصية الاعتبارية بالقدر اللازم لتصفيتها، وتنقضي بإحدى الحالات الآتية:</p>\\\\\\\\n<p>1. بيعها وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p>2. انقضاء المدة المحددة لها ما لم تمدد وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p>3. استحالة تحقق الغرض الذي أسست من أجله.</p>\\\\\\\\n<p>4. إلغاؤها وفقاً لأحكام النظام واللائحة.</p>\\\\\\\\n<p>5. صدور حكم قضائي نهائي بتصفيتها.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c405c6afde7845949307128e5e606799\\\",\\\"title\\\":\\\"المادة الثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجب أن تودع جميع العوائد المالية المتعلقة بالمساهمة العقارية مباشرة في حساب الضمان.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/9332cee318c7428db9321e6a2c6f6e09\\\",\\\"title\\\":\\\"المادة الحادية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يتولى ضبط ما يقع من مخالفات لأحكام النظام أو اللائحة موظفون من الهيئة ومن أي جهة أخرى ترى الهيئة الاستعانة بموظفيها، يصدر بتعيينهم قرار من الرئيس بعد موافقة جهاتهم. ولمسؤولي الضبط دخول المواقع والمشاريع المتعلقة بالأنشطة المشمولة بالنظام بما فيها مقر المرخص له، وعليهم ضبط المخالفات والتحفظ على المستندات والوثائق والأدلة المتعلقة بها وفقاً لإجراءات الضبط الصادرة عن الهيئة ويكونون تحت إشراف الهيئة، ولهم الاستعانة بالجهات الأمنية عند الحاجة. وتحدد اللائحة طريقة عملهم، وصلاحياتهم، ومكافآتهم.</p>\\\\\\\\n<p> </p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/31ee9c8b6dde44149082ef7899105498\\\",\\\"title\\\":\\\"المادة الثانية والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بما نصت عليه المادة (الخامسة والثلاثون) من النظام، يعاقب كل من يخالف أيًّا من أحكام النظام أو اللائحة بواحدة أو أكثر من العقوبات الآتية:</p>\\\\\\\\n<p>1. الإنذار.</p>\\\\\\\\n<p>2. إيقاف الترخيص مدة لا تزيد على (سنة).</p>\\\\\\\\n<p>3. إلغاء الترخيص.&nbsp;</p>\\\\\\\\n<p>4. غرامة لا تزيد على (10,000,000) عشرة ملايين ريال.</p>\\\\\\\\n<p>5. منع المرخص له أو مدير المساهمة العقارية من القيام -مستقبلاً- بأي عمل مرتبط بالمساهمات العقارية لمدة لا تتجاوز (10) عشر سنوات.<br>ويصدر المجلس جدولاً يتضمن تصنيفاً للمخالفات والعقوبات المقررة لها بناءً على ما نصت عليه هذه المادة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5a5abd23215c493c9012794253fc4cca\\\",\\\"title\\\":\\\"المادة الثالثة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تُكوّن بقرار من رئيس الهيئة لجنة أو أكثر لا يقل عدد أعضائها عن ثلاثة ويسمى أحدهم رئيساً، ويكون من بينهم مستشار شرعي أو نظامي؛ تتولى النظر في المخالفات وإيقاع العقوبات المنصوص عليها في المادة (الثانية والثلاثين) من النظام، وذلك بحسب نوع المخالفة المرتكبة وجسامتها ومدى تأثيرها، ويعتمد قرار اللجنة من رئيس الهيئة أو من يفوضه بذلك. ويصدر الرئيس قواعد عمل اللجنة وتحديد مكافآت أعضائها.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/ccce849536754853bd86c23ce8fd1ad6\\\",\\\"title\\\":\\\"المادة الرابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يجوز التظلم من قرار اللجنة المنصوص عليها في المادة (الثالثة والثلاثين) من النظام أمام المحكمة الإدارية خلال (ستين) يوماً من تاريخ الإبلاغ بالقرار.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f114fcd45c08499f9f5b49e1c0c1075c\\\",\\\"title\\\":\\\"المادة الخامسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال بأي عقوبة منصوص عليها في أي نظام آخر، يعاقب بالسجن مدة لا تزيد على (ثلاث) سنوات، كل من يخالف أيًّا من أحكام المواد الآتية: (الرابعة)، و(الحادية والعشرون)، و(السابعة والعشرون)، و(الثلاثون)، من النظام، وتحال إلى النيابة العامة؛ للتحقيق فيها، والادعاء فيها أمام المحكمة المختصة.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/7dfe5a82dbfc4d669b7b3b3500357800\\\",\\\"title\\\":\\\"المادة السادسة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>دون إخلال باختصاصات الهيئة، تنظم هيئة السوق المالية بالاتفاق مع الهيئة ما يتعلق بجمع الأموال لغرض طرح المساهمة العقارية.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/0e5ee6f26da146a4a0397b92e82e8d0e\\\",\\\"title\\\":\\\"المادة السابعة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>يصدر المجلس اللائحة بالاتفاق مع هيئة السوق المالية، وذلك خلال (مائة وعشرين) يوماً من تاريخ صدور النظام، ويعمل بها من تاريخ العمل به.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/bcc8ff0ae01e4220a1730b4f97160416\\\",\\\"title\\\":\\\"المادة الثامنة والثلاثون\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>ينشر النظام في الجريدة الرسمية، ويعمل به بعد (مائة وعشرين) يوماً من تاريخ نشره، ويلغي كل ما يتعارض معه من أحكام.</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\\n<p>&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":null},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/4560312fc1c340179a9a421185571bf3\\\",\\\"title\\\":\\\"الفصل السابع: أحكام ختامية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/461d601e6ba9465fba581a92214b17ff\\\",\\\"title\\\":\\\"الفصل السادس: المخالفات والعقوبات\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f805d1db2913488e9976b144d12d7913\\\",\\\"title\\\":\\\"الفصل الخامس: انقضاء المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/5b47943a0da243708f9a63813597b7bd\\\",\\\"title\\\":\\\"الفصل الرابع: جمعية المساهمين\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/f0c60f03f2f046389ced0ad80ae03515\\\",\\\"title\\\":\\\"الفصل الثالث: إدارة المساهمة العقارية\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/a4765edf58f94b149dc6823b994db0ec\\\",\\\"title\\\":\\\"الفصل الثاني: الترخيص والإشتراكات\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"},{\\\"contentTypeKey\\\":\\\"2acf2487-14ef-411a-a9b2-bb4c58ec9392\\\",\\\"udi\\\":\\\"umb://element/c0cd9dcf0d8542b2859782695a03d6a4\\\",\\\"title\\\":\\\"الفصل الأول: تعريفات وأحكام عامة\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>&nbsp; &nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"header\\\":\\\"1\\\"}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"مشروع تطوير عقاري يشترك فيه مجموعة من الأشخاص لأجل تحقيق منفعة، ويكون ذلك بتملك عقار وتطويره إلى سكني أو تجاري أو صناعي أو زراعي وغير ذلك، ثم بيع وإنهاء المساهمة، ولا يشمل ذلك الصناديق الاستثمارية العقاري\"","change":"Update"},{"success":true,"name":"keywords","path":"Property/keywords","oldValue":"null","newValue":"\"[\\n  \\\"نظام المساهمات العقارية\\\",\\n  \\\"المساهمات العقارية\\\",\\n  \\\"نظام\\\",\\n  \\\"الانظمة\\\",\\n  \\\"الانظمة واللوائح والادلة\\\",\\n  \\\"الهيئة العامة للعقار\\\"\\n]\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"نظام المساهمات العقارية\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{