pe: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل يتطلب التسجيل للحضور الى القمة؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"><span>نعم&nbsp;</span></div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"><span></span></div>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li><span>هل هناك رسوم للمشاركة ؟</span></li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\">اذا<span>&nbsp; زائر لا يوجد رسوم ,&nbsp; الرسوم على العارضين </span>و الرعاة</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل يوجد جدول للمتحدثين ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\">نعم</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل يوجد جدول لورش العمل ؟&nbsp;</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\">نعم</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>هل يوجد رسوم لحضور ورش العمل ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\">لا</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>ماهي الجهات المشاركة؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\">يمكن مراجعة الموقع الخاص بالحدث <br><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"https://globalproptechsummit.com\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\">https://globalproptechsummit.com</a></div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"></div>\\\\\\\\n<div>\\\\\\\\n<ul style=\\\\\\\\\\\\\\\"list-style-type: square;\\\\\\\\\\\\\\\">\\\\\\\\n<li>كيف أحصل على اجندة القمة؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\">من خلال الرابط الإلكتروني التالي :</div>\\\\\\\\n<div style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\"><a rel=\\\\\\\\\\\\\\\"noopener\\\\\\\\\\\\\\\" href=\\\\\\\\\\\\\\\"https://globalproptechsummit.com\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\">https://globalproptechsummit.com</a><br><br></div>\\\\\\\\n<div></div>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null}],\\\"settingsData\\\":[]}\"","change":"Update"},{"success":true,"name":"formIcon","path":"Property/formIcon","oldValue":"null","newValue":"\"[]\"","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"0","newValue":"\"1\"","change":"Update"}],"key":"c3395462-6835-42fd-8c13-78dd0fd2a0db"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Done","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content/3be850ea-467f-4ea1-bf3f-5d6a2657243d.config","name":"ضوابط","path":"/d716ff81-8164-47c4-8be2-1004f9d6caa0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"description","path":"Property/description","oldValue":"null","newValue":"\"ضوابط\"","change