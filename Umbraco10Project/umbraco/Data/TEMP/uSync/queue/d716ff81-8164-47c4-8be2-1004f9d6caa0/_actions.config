ssing":true,"detailMessage":null,"details":[{"success":true,"name":"CreateDate","path":"","oldValue":"8/29/2024 1:53:30 PM","newValue":"8/29/2024 1:53:30 PM","change":"Update"},{"success":true,"name":"content","path":"Property/content","oldValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\\\"},{\\\"contentUdi\\\":\\\"umb://element/e64f2e78e0c4443c8ba82f92e2827955\\\"},{\\\"contentUdi\\\":\\\"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\\\"},{\\\"contentUdi\\\":\\\"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\\\"},{\\\"contentUdi\\\":\\\"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة عن طريق توفير مجموعة شاملة من الخدمات تشمل مساحات العمل المشتركة، والخدمات المتخصصة لتطوير الأعمال، و تتضمن الاستشارات والتوجيه والتدريب، بالإضافة لتيسير الوصول إلى المستثمرين من أجل تسريع تطوّر ونمو الشركات الناشئة والريادية وتوسعها,<span>&nbsp; والعمل على تأسيسها بشكل سليم لتكون داعمة&nbsp; للقطاع العقاري </span>و رفع مساهمته في الناتج المحلي للمملكة العربية السعودية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/e64f2e78e0c4443c8ba82f92e2827955\\\",\\\"title\\\":\\\"اهداف المبادرة:\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<ol>\\\\\\\\n<li>خلق شركات ناشئة<span>&nbsp; على أسس سليمة داعمة للقطاع العقاري </span></li>\\\\\\\\n<li>رفع مساهمة<span>&nbsp; الشركات الناشئة في القطاع العقاري للاقتصاد الوطني </span></li>\\\\\\\\n<li>توسع الشركات في التقنية العقارية محليًا<span>&nbsp; ودوليًا </span></li>\\\\\\\\n</ol>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\\\",\\\"title\\\":\\\"النسخة الأولى من برنامج مسرعة التقنية العقارية \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تأتي مسرعة التقنية العقارية بنسختها الأولى بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات<span>&nbsp; </span>و نسعد بإعلان فتح<span>&nbsp; التسجيل&nbsp; لبرنامج المسرعة </span>عن طريق مسرعة الأعمال العالمية startup wise guys</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":\\\"https://startupwiseguys.com/all-programs/proptech-accelerator-program/\\\"},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\\\",\\\"title\\\":\\\"الأسئلة الشائعة \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">برامج مكثفة لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة ، و يوفر مجموعة شاملة من الخدمات والموارد، بما في ذلك توفير مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\\\\\\\n<div>\\\\\\\\n<ul>\\\\\\\\n<li>ماذا تقدم المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">الدعم المعرفي للشركات الناشئة من خلال عدة برامج من ضمنها<span>&nbsp; التدريب&nbsp; </span>و الارشاد و التوجيه بهدف تأسيس شركات على أسس سليمة</p>\\\\\\\\n<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<ul>\\\\\\\\n<li style=\\\\\\\\\\\\\\\"list-style-type: none;\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">ورش عمل<span>&nbsp; متخصصة في التقنية العقارية&nbsp; .</span></li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">قصص نجاح من أبرز رواد الاعمال و المؤثرين .</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">جلسات استشارية و ارشادية</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">الربط مع الجهات التمويلية .</li>\\\\\\\\n</ul>\\\\\\\\n</li>\\\\\\\\n</ul>\\\\\\\\n<div><span></span></div>\\\\\\\\n<div>\\\\\\\\n<ul>\\\\\\\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; مدة البرنامج 6 شهور </span></p>\\\\\\\\n<ul>\\\\\\\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; لا يوجد رسوم</span></p>\\\\\\\\n<p dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":\\\"\\\",\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null}],\\\"settingsData\\\":[]}\"","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\\\"},{\\\"contentUdi\\\":\\\"umb://element/e64f2e78e0c4443c8ba82f92e2827955\\\"},{\\\"contentUdi\\\":\\\"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\\\"},{\\\"contentUdi\\\":\\\"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\\\"},{\\\"contentUdi\\\":\\\"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\\\"}]},\\\"contentData\\\":[{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/d474b21d2ec54e5eb73cb4ff6afffb09\\\",\\\"title\\\":null,\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>برنامج مكثف لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة عن طريق توفير مجموعة شاملة من الخدمات تشمل مساحات العمل المشتركة، والخدمات المتخصصة لتطوير الأعمال، و تتضمن الاستشارات والتوجيه والتدريب، بالإضافة لتيسير الوصول إلى المستثمرين من أجل تسريع تطوّر ونمو الشركات الناشئة والريادية وتوسعها,<span>&nbsp; والعمل على تأسيسها بشكل سليم لتكون داعمة&nbsp; للقطاع العقاري </span>و رفع مساهمته في الناتج المحلي للمملكة العربية السعودية.</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/e64f2e78e0c4443c8ba82f92e2827955\\\",\\\"title\\\":\\\"اهداف المبادرة:\\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<ol>\\\\\\\\n<li>خلق شركات ناشئة<span>&nbsp; على أسس سليمة داعمة للقطاع العقاري </span></li>\\\\\\\\n<li>رفع مساهمة<span>&nbsp; الشركات الناشئة في القطاع العقاري للاقتصاد الوطني </span></li>\\\\\\\\n<li>توسع الشركات في التقنية العقارية محليًا<span>&nbsp; ودوليًا </span></li>\\\\\\\\n</ol>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/89feb792f4ac4ba6bbee2e23d5b12404\\\",\\\"title\\\":\\\"النسخة الأولى من برنامج مسرعة التقنية العقارية \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<p>تأتي مسرعة التقنية العقارية بنسختها الأولى بالتعاون مع البرنامج الوطني لتنمية تقنية المعلومات<span>&nbsp; </span>و نسعد بإعلان فتح<span>&nbsp; التسجيل&nbsp; لبرنامج المسرعة </span>عن طريق مسرعة الأعمال العالمية startup wise guys</p>\\\\\\\\n<p><strong>أخر موعد للتقديم: 15/12/2024</strong></p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/7aa3c1bba0224bc5ab1ea019b2e90ccf\\\",\\\"title\\\":null,\\\"content\\\":null,\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":\\\"https://startupwiseguys.com/all-programs/proptech-accelerator-program/\\\"},{\\\"contentTypeKey\\\":\\\"0ec714a9-23ee-4f17-a692-ea7f9735ff70\\\",\\\"udi\\\":\\\"umb://element/489ddb3d986d4f3baf7045e97cfc2aa0\\\",\\\"title\\\":\\\"الأسئلة الشائعة \\\",\\\"content\\\":\\\"{\\\\\\\"markup\\\\\\\":\\\\\\\"<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li>ماهي مسرعة التقنية العقارية ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">برامج مكثفة لتعزيز نمو وتوسع الشركات الريادية والناشئة خلال فترة زمنية محددة ، و يوفر مجموعة شاملة من الخدمات والموارد، بما في ذلك توفير مساحات عمل ومكاتب مشتركة،، بالإضافة لتيسير الوصول إلى المستثمرين بالتعاون مع برنامج تنمية تقنية المعلومات و مسرعة الاعمال العالمية STARTUP WISE GUYS</p>\\\\\\\\n<div>\\\\\\\\n<ul>\\\\\\\\n<li>ماذا تقدم المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">الدعم المعرفي للشركات الناشئة من خلال عدة برامج من ضمنها<span>&nbsp; التدريب&nbsp; </span>و الارشاد و التوجيه بهدف تأسيس شركات على أسس سليمة</p>\\\\\\\\n<div class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li>ما ذا يحتوى برنامج المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<ul>\\\\\\\\n<li style=\\\\\\\\\\\\\\\"list-style-type: none;\\\\\\\\\\\\\\\">\\\\\\\\n<ul>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">ورش عمل<span>&nbsp; متخصصة في التقنية العقارية&nbsp; .</span></li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">قصص نجاح من أبرز رواد الاعمال و المؤثرين .</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">جلسات استشارية و ارشادية</li>\\\\\\\\n<li class=\\\\\\\\\\\\\\\"O0\\\\\\\\\\\\\\\">الربط مع الجهات التمويلية .</li>\\\\\\\\n</ul>\\\\\\\\n</li>\\\\\\\\n</ul>\\\\\\\\n<div><span></span></div>\\\\\\\\n<div>\\\\\\\\n<ul>\\\\\\\\n<li>ما هي مدة<span>&nbsp; البرنامج ؟</span></li>\\\\\\\\n</ul>\\\\\\\\n</div>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; مدة البرنامج 6 شهور </span></p>\\\\\\\\n<ul>\\\\\\\\n<li>هل يوجد رسوم للمشاركة في المسرعة ؟</li>\\\\\\\\n</ul>\\\\\\\\n<p style=\\\\\\\\\\\\\\\"padding-right: 40px;\\\\\\\\\\\\\\\" dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\"><span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; لا يوجد رسوم</span></p>\\\\\\\\n<p dir=\\\\\\\\\\\\\\\"rtl\\\\\\\\\\\\\\\">&nbsp;</p>\\\\\\\",\\\\\\\"blocks\\\\\\\":{\\\\\\\"contentData\\\\\\\":[],\\\\\\\"settingsData\\\\\\\":[]}}\\\",\\\"listOfSubcontent\\\":null,\\\"button\\\":null,\\\"linkToPage\\\":null,\\\"form\\\":null,\\\"buttonToURL\\\":null}],\\\"settingsData\\\":[]}\"","