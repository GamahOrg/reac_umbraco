edia/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\" data-anchor=\\\\\\\"#https://rega.gov.sa/media/syff0nfp/الضوابط-المنظمة-لتأهيل-وتصنيف-ممارسي-نشاط-المساهمات-العقارية.pdf\\\\\\\">الضوابط المنظمة لتأهيل وتصنيف ممارسي نشاط المساهمات العقارية</a></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"serviceFeature","path":"Property/serviceFeature","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"03e13ec8-3ab0-43fb-aaa7-d6348a181249\\\",\\\"name\\\":\\\"Item 1\\\",\\\"ncContentTypeAlias\\\":\\\"servicesFeatures\\\",\\\"PropType\\\":null,\\\"icon\\\":\\\"umb://media/a0df66c37ac6423084eb3fe30c460542\\\",\\\"featureTabTitle\\\":\\\"About the Service\\\",\\\"featureBrief\\\":{\\\"markup\\\":\\\"<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically.</p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><a href=\\\\\\\"/{localLink:umb://media/d1a990f293224fb893216d0576c151e9}\\\\\\\" title=\\\\\\\"Mosahamat\\\\\\\">Real Estate Contributions Regulations</a><br><a href=\\\\\\\"/{localLink:umb://media/18e069691e154040a9941f4395c47d47}\\\\\\\" title=\\\\\\\"تعليمات طرح شهادات المساهمات العقارية\\\\\\\">Executive Regulations of the Real Estate Contributions System</a><br><a href=\\\\\\\"/{localLink:umb://media/18615bbd6b53432a873add1f1f10eb2c}\\\\\\\" title=\\\\\\\"ضوابط حساب الضمان للمساهمات العقارية\\\\\\\">Guidelines for the Real Estate Contributors' Guarantee Account</a><br><a href=\\\\\\\"/{localLink:umb://media/85d9e3d439b74a84864e2f0c8dcfae31}\\\\\\\" title=\\\\\\\"Instructions On The Offering Of Real Estate Contrbutions Certificates\\\\\\\">Instructions for Issuing Real Estate Contribution Certificates</a></p>\\\\n<p style=\\\\\\\"unicode-bidi: embed; text-align: left;\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}},\\\"customPage\\\":null,\\\"linkedToPage\\\":null}]\"","change":"Update"},{"success":true,"name":"serviceIcon","path":"Property/serviceIcon","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"092af7af-2754-40aa-92a6-b9f817500543\\\",\\\"mediaKey\\\":\\\"e8b422d4-a68e-492f-a0f3-56b419b04c92\\\"}]\"","change":"Update"},{"success":true,"name":"shortBrief","path":"Property/shortBrief","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p>The Real Estate Contributions Platform is the official electronic platform designated for the submission of applications to issue, amend, and cancel licenses required for real estate contribution activities. It also facilitates the acceptance of applications for the qualification and classification of real estate developers, and ensures the completion of all licensing and qualification processes electronically.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"socialMediaImage","path":"Property/socialMediaImage","oldValue":"null","newValue":"\"umb://media/ba6d866b399d4d158df62ecef4617b90\"","change":"Update"},{"success":true,"name":"support","path":"Property/support","oldValue":"null","newValue":"\"{\\\"layout\\\":{\\\"Umbraco.BlockList\\\":[{\\\"contentUdi\\\":\\\"umb://element/413e84227656477899757fa9fd9ed3c9\\\"},{\\\"contentUdi\\\":\\\"umb://element/ea4390a2a49442c0a9aed4e3e9349b29\\\"}]},\\\"