":"1/1/0001 12:00:00 AM","newValue":"11/7/2024 5:44:55 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-11-07T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"a03167e3-23b6-488c-a9a7-8b5c24b9e0c0\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s8\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">كشف الرئيس التنفيذي للهيئة العامة للعقار المشرف العام على معرض سيتي سكيب العالمي 2024 المهندس</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">عبد الله</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">بن سعود الحماد</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">خلال اللقاء التعريفي \\\\\\\"بسيتي سكيب\\\\\\\"</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">أنَ المعرض</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الذي يعد</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الحدث العقاري الأكبر والأضخم عالميًا،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">وتستضيفه</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">السعودية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">للعام الثاني، برعاية وزارة والبلديات والإسكان وبالشراكة بين الهيئة العامة للعقار، وبرنامج الإسكان أحد برامج رؤية</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">2030.</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">سيقام بنسخته الثانية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">خلال الفترة من 11 إلى 14 نوفمبر المقبل في</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مركز الرياض للمعارض والمؤتمرات</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">\\\\\\\"ملهم\\\\\\\" بالعاصمة</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الرياض تحت شعار</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">\\\\\\\"مستقبل الحياة\\\\\\\" ،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">وسيشهد تجمع</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">أكثر من</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">400</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">جهة عارضة من أهم وأكبر الشركات العالمية والوطنية في مجال الاستثمار والتطوير العقاري، وأكثر من</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">100</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">من مستثمر مؤسسي، وأكثر من 500 من قادة القطاع الدوليين والمحليين.</span></p>\\\\n<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s8\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\">وأضاف</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الرئيس التنفيذي \\\\\\\"لهيئة العقار \\\\\\\"</span><span class=\\\\\\\"bumpedfont15\\\\\\\">&nbsp;أن استضافة المملكة</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">العربية السعودية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">لهذا المعرض تعكس النهضة العقارية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الكبرى</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">التي</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">تعيشها في ظل رؤية السعودية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">2030، مما يعزز دور</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">القطاع العقاري باعتباره</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">محركًا</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">رئيسيًا للاقتصاد الوطني،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">وأنّ \\\\\\\"</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">معرض سيتي سكيب العالمي</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">2024</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">\\\\\\\" سيساهم في تحقيق أهداف القطاع العقاري من خلال توفير منصات متعددة وتجارب متميزة لعرض الابتكارات، وتبادل التجارب، والتقنيات العقارية ، بما يسهم في زيادة</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">الفرص الاستثمارية المتنوعة في السوق العقاري السعودي، وجذب المزيد من الاستثمارات الأجنبية، لتنويع الاقتصاد، وتعزيز التنمية المستدامة، حيث حققت النسخة الماضية من \\\\\\\"المعرض \\\\\\\" نجاح في</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">حجم والمعاملات والمشاريع الاستثمارية والاتفاقيات</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الاستراتيجية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">بأكثر من</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">110</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مليار ريال، والاستثمارات الخارجية بأكثر من</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">19</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مليار دولار، وفي هذه النسخة نطمح لنحقق ارتفاع بنسبة تتجاوز</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">50%.</span></p>\\\\n<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s8\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأشار \\\\\\\"الحماد \\\\\\\" إلى أنّ النجاحات السابقة</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">زادت الفرص هذا العام ومنها توفير أكثر من</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">100</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">ألف وحدة سكنية بعروض حصرية وحلول تمويلية تسهل رحلة التملك</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">للمساكن،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">إضافة إلى</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">استعراض للمشاريع الفريدة والفرص المتنوعة</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">التي</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">يقدمها الشركاء، مثل</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الشركة الوطنية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">للإسكان</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">نيوم،و</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">روشن،والمربع</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الجديد و</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مركز الملك عبدالله المالي (كافد)، والدرعية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">، كما ستتيح هذه النسخة من \\\\\\\"المعرض \\\\\\\" العديد من الفرص الاستثمارية العقارية من خلال أكبر مزاد عقاري</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مباشر في الشرق الأوسط بالتعاون مع</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مركز الإسناد والتصفية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">(إنفاذ)، تتجاوز قيمته التقديرية مليار ريال</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">وما</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">نشهده اليوم من نهضة في القطاع العقاري يأتي نتاج البنية التحتية القانونية التي أوجدتها التشريعات العقارية مما يعزز من متانة السوق العقاري السعودي والموثوقية به ويجعله جاذب للاستثمارات والمستثمرين .</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span></p>\\\\n<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s8\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يذكر أن \\\\\\\"</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">معرض سيتي سكيب العالمي 2024</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">\\\\\\\"</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">سيتيح</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">للمستثمرين الشباب وأصحاب الشركات الناشئة،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">فرص</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">التواصل</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">المباشر مع المستثمرين والمطورين العقاريين</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">المحليين والدوليين، وعرض مشاريعهم وأفكارهم، مع فرصة الفوز بجوائز تصل إلى</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">1.5</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مليون ريال في مسابقة \\\\\\\"روشن</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">هاكثون2024\\\\\\\" التي تهدف</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">إلى تشجيع الابتكار والإبداع في إيجاد حلول تكنولوجية مبتكرة لمعالجة التحديات الكبرى في القطاع العقاري باستخدام مختلف التقنيات الحديثة.</span></span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"الرئيس التنفيذي لهيئة العقار : معرض سيتي سكيب 2024 سيسهم في تحقيق أهداف القطاع العقاري وجذب المزيد من الاستثمارات المحلية والدولية\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"317","change":"Update"}],"key":"dfc59385-4c49-400f-8052-70740667b27e"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/7142342f-e6b4-4223-9cd7-a3b41407778e.config","name":"هيئة العقار تختتم مشاركتها في المنتدى الحضري العالمي «WUF12» وتؤكد أن الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"63d3758d-a231-44bc-a50c-73802e53532c","newValue":"7142342f-e6b4-4223-9cd7-a3b41407778e","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"11/10/2024 8:46:17 AM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-11-10T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"e707fd3c-8153-4913-85ac-f666350e8be6\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">اختتمت الهيئة العامة للعقار ضمن وفد المملكة العربية السعودية مشاركتها في المنتدى الحضري العالمي \\\\\\\"</span>WUF12<span>\\\\\\\" الذي أُقيم بالعاصمة المصرية خلال الفترة من 4 إلى 8 نوفمبر 2024، استعرضت فيها أهم التشريعات العقارية بالمملكة، والتي تُعد من أهم الممكنات لتحقيق أهداف التنمية الحضرية وبناء مدن ومجتمعات عصرية ومستدامة، تسهم في تحقيق جودة الحياة وتدعم الحراك الاقتصادي وترفع جاذبية الاستثمارات العقارية بالمملكة. <br>واستعرضت الهيئة خلال مشاركتها في الاجتماعات وورش العمل المقامة ضمن فعاليات المنتدى، أهم التجارب في التنظيمات العقارية، ورفع الوعي لدى المستثمرين بتشريعات القطاع العقاري، ودور الأنظمة واللوائح في تطويره ورفع موثوقيته وجاذبيته الاستثمارية</span><span>.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأشار المتحدث الرسمي مدير عام الاتصال الاستراتيجي للهيئة العامة للعقار أ. تيسير بن محمد المفرج خلال كلمة ألقاها ضمن أعمال المنتدى، أن القطاع العقاري في السعودية، يخطو خطوات واثقة وسط تشريعات تنظيمية تتسم بالحيوية والمرونة بعد نقلته النوعية التي كانت نتاج التوجهات الاستراتيجية التي غيرت وجه السوق العقاري السعودي تمامًا وانطلقت به إلى آفاق مستقبلية تتسم بالحيوية والمرونة والتكييف مع متطلبات التنمية الحضرية وبناء مدن المستقبل المستدامة.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">كما أكد المتحدث الرسمي للهيئة أنّ الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل والطريق ممهد لكافة أراد المستثمرين من حول العالم، إما بشكل مباشر أو حتى من خلال تكوين رأس المال، وأن التشريعات العقارية كنظام المساهمات العقارية ونظام بيع وتأجير مشروعات عقارية على الخارطة من ممكنات الاستثمارات العقارية، وتعتبر قنوات تمويلية مرنة بالتوازي مع الصناديق&nbsp;الاستثمارية&nbsp;العقارية، مما يعزز&nbsp;حماية&nbsp;المستثمرين واستثماراتهم في القطاع العقاري السعودي ، مما يمثل فرصًا فريدة ، سيما في البنية التحتية والمرافق العقارية، لما تشهده المملكة من طفرة في تطوير الملاعب، والفنادق، والمنشآت التجارية، والمرافق الترفيهية التي ستظل ذات قيمة طويلة الأجل خاصة في ظل المشاريع الكبرى التي تستعد المملكة لاستضافتها .</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">واستعرض فريق \\\\\\\"الهيئة\\\\\\\" خلال الجلسات الحوارية وورش العمل في \\\\\\\"المنتدى الحضري \\\\\\\" رحلة التحول الرقمي والتقني في القطاع العقاري واسهامها في تقديم خدمات نوعية متقدمة، ودور \\\\\\\"هيئة العقار \\\\\\\" في تبني التقنيات العقارية وتوفير بيئة محفزة تدعم الابتكار ورواد الأعمال من خلال المركز السعودي للبروبتك الذي أطلقته مؤخرًا ليكون مركزًا يخدم جميع المهتمين بالتقنية العقارية من داخل المملكة وخارجها ، بالإضافة إلى التعريف بأهمية نظام بيع وتأجير مشروعات عقارية على الخارطة ومدى اسهامه في تعزيز التنافسية في نشاط التطوير العقاري&nbsp; وتشجيع الاستثمار فيه لزيادة المعروض من الوحدات العقارية.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يذكر أنّ المنتدى الحضري العالمي </span><span>«WUF12»</span><span> يعد المؤتمر الرئيسي&nbsp;للأمم المتحدة</span><span>&nbsp;</span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">كأكبر حدث عالمي، لمناقشة تحديات التنمية الحضرية المستدامة، وتشارك فيه الهيئة العامة للعقار ضمن دورها لتعزيز التعاون بين قادة الصناعة العقارية وصانعي السياسات والخبراء من جميع أنحاء العالم، ولإبراز دور المملكة الريادي في تحقيق المستهدفات العالمية للتنمية الحضرية المستدامة ومشاركتها في صياغة المشهد الحضري الإقليمي والعالمي.</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"هيئة العقار تختتم مشاركتها في المنتدى الحضري العالمي «WUF12» وتؤكد أن الاستثمار في العقارات السعودية يعني الاستثمار في المستقبل \"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"318","change":"Update"}],"key":"7142342f-e6b4-4223-9cd7-a3b41407778e"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/1d8fac21-fd1e-4db1-b008-e7e826a067f0.config","name":"الهيئة العامة للعقار\" تُشارك في المعرض العقاري الأكبر \"سيتي سكيب العالمي\" 2024م بنسخته الثانية","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"0ba1a150-acf0-421a-a671-b16d1580f482","newValue":"1d8fac21-fd1e-4db1-b008-e7e826a067f0","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"11/11/2024 6:30:18 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-11-11T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"047e927d-8c5b-4dcf-97d9-8cb532d0f236\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s6\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">تشارك الهيئة</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">العامة للعقار في معرض سيتي</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">سكيب العالمي 2024م بنسخته الثانية،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">خلال الفترة</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">من 11-</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">14 نوفمبر في مركز الرياض للمعارض والمؤتمرات \\\\\\\"ملهم\\\\\\\" بالعاصمة الرياض تحت شعار \\\\\\\"مستقبل الحياة\\\\\\\"</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الذي يأتي كمنصة تجمع الخبراء</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">والمختصين</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">من أكثر من 50 دولة من حول العالم</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">لتبادل آخر التطورات</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">والممارسات العالمية في قطاع الإسكان والعقار</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">كما يمثل</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">ساحة للاستثمارات</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الواعدة في المشاريع</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">العقارية الكبرى</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">من خلال التواصل</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">المباشر بين المستثمرين</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الدوليين</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">والمطورين المحليين</span></p>\\\\n<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s6\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأكد المتحدث الرسمي للهيئة العامة للعقار</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">أ.تيسير</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">بن محمد المفرج &nbsp;أنّ</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">مشاركة \\\\\\\"هيئة العقار\\\\\\\" في معرض سيتي سكيب العالمي 2024م،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">تأتي</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">بهدف تسليط الضوء على التطورات الأخيرة في السوق العقاري السعودي، بما في ذلك الإصلاحات التنظيمية والتشريعية التي تسهل الاستثمار الأجنبي، بما يعزز الثقة في السوق المحلي ويحفز النمو في القطاع، ويفتح آفاقًا جديدة للتعاون والشراكات الاستراتيجية بين الشركات العقارية السعودية ونظيراتها العالمية وهذه الفرصة تعد ذات أهمية لتبادل الخبرات والتقنيات العقارية المُتقدمة في مجال البناء وتأسيس البنية التحتية للمشاريع العقارية من أجل صناعة مجتمعات حيوية ومستدامة تلبي متطلبات المرحلة المستقبلية</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">مبيناً أنّ المعرض سيسهم في تحقيق أهداف القطاع العقاري من خلال توفير منصات متعددة وتجارب متميزة لعرض الابتكارات، وتبادل التجارب، والتقنيات العقارية ، بما يسهم في زيادة الفرص الاستثمارية المتنوعة في السوق العقاري السعودي، وجذب المزيد من الاستثمارات الأجنبية، لتنويع الاقتصاد، وتعزيز التنمية المستدامة،</span></span></p>\\\\n<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: justify; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s6\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\">كما</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">دشن الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد،</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">بوابة</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">المطورين العقاريين</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">ضمن منصة السجل العقاري</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">كوجهة متكاملة</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">تهدف إلى تسهيل أعمال المطورين العقاريين، وحفظ حقوق ملاك العقارات في مشاريع البيع على الخارطة، وتمّكن المنصة</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">المطوريين</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">العقاريين في التسجيل وإصدار رخص البيع على الخارطة وعرض شهادات البيع وتسجيلها باسم ملاك العقارات بكل مرونة وفعالية</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">، بالإضافة إلى أنها تأتي</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ضمن جهود الهيئة في تنظيم وتطوير قطاع العقار واستمراراً للإصلاحات والتشريعات التي شهدها القطاع العقاري خلال الفترة الماضية، حيث ستساهم البوابة في تنظيم مشاريع البيع على الخارطة</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ورقمنةإجراءاتها بالكامل، بالإضافة إلى تحفيز المطورين العقاريين من خلال توفير وجهة رقمية متكاملة تصحبهم في رحلة التطوير بداية من تسجيل الترخيص في البوابة وحتى إتمام البناء وإصدار صكوك تسجيل ملكية للمستفيدين من السجل العقاري مباشرة.</span></span></p>\\\\n<p style=\\\\\\\"margin: 0in; margin-bottom: .0001pt; text-align: right; line-height: 16.2pt; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"s4\\\\\\\"><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يُذكر أنّ</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">معرض سيتي سكيب العالمي 2024م</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">في انطلاق نسخته</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">الثانية</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\">،</span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">شهد &nbsp;توقيع اتفاقيات وشراكات بلغت قيمتها أكثر من 180 مليار ريال سعودي ، بالإضافة إلى تجمع أكثر من 400 جهة عارضة من أهم وأكبر الشركات العالمية والوطنية في</span></span><span class=\\\\\\\"apple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"bumpedfont15\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">مجال الاستثمار والتطوير العقاري، وأكثر من 100 من مستثمر مؤسسي، وأكثر من 500 من قادة القطاع الدوليين والمحليين</span></span><span class=\\\\\\\"s7\\\\\\\">.</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"الهيئة العامة للعقار\\\" تُشارك في المعرض العقاري الأكبر \\\"سيتي سكيب\\\" العالمي 2024م بنسخته الثانية\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"319","change":"Update"}],"key":"1d8fac21-fd1e-4db1-b008-e7e826a067f0"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/822996d6-6863-463a-be7c-05aefb2615d1.config","name":"الرئيس التنفيذي للهيئة العامة للعقار يلتقي بوزير الإسكان المصري والوفد المرافق له","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"973cc755-18b2-4cc3-b91b-7d75b4aed992","newValue":"822996d6-6863-463a-be7c-05aefb2615d1","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"11/11/2024 6:45:46 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-11-11T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"f99ce68c-7d59-4816-a04d-ed4c1c892d75\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">التقى الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد على هامش فعاليات معرض سيتي سكيب العالمي 2024م بنسخته الثانية، معالي وزير الإسكان والمرافق والمجتمعات العمرانية بجمهورية العربية المصرية المهندس شريف الشريبني والوفد المرافق له.</span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأكّد الرئيس التنفيذي لهيئة العقار على قوة العلاقات السعودية المصرية التي تستند إلى أسس أخوية تاريخية، تعزز المصالح المشتركة بالمنطقة ومن أهمها الشراكة الاقتصادية المتبادلة، وهذه العلاقات تمتد لعقود من التعاون الوثيق، إذ تؤدي التجارة والاستثمارات المتبادلة خصوصًا بالقطاع العقاري دورًا محوريًا في تنمية هذه العلاقات وتعزز دورها على المستويين الإقليمي والدولي.</span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأشار \\\\\\\" الحماد\\\\\\\"إلى &nbsp;أنّ ما يعزز هذه الشراكة الاستثمارية العقارية بين البلدين هو التوجه الحكومي نحو الإصلاح الاقتصادي، حيث تبنت الحكومتان في المملكة ومصر سياسات اقتصادية مرنة تستهدف تحفيز الاستثمار الأجنبي، وتحسين بيئة الأعمال، وتقديم التسهيلات للمستثمرين وحماية الاستثمارات المتبادلة بين السعودية ومصر . </span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وبين \\\\\\\" الرئيس التنفيذي لهيئة العقار\\\\\\\" أنَ الحراك العمراني الحضري في السعودية &nbsp;لا يهدأ لتطوير مدنٍ ذكية ومستدامة، ترتكز على الحلول المبتكرة للتحديات الحضرية من خلال المشروعات الكبرى، وأنّ الطريق ممهدٌ اليوم أمام كل من أراد الاستثمار في القطاع العقاري بشكل مباشر ، أو حتى من خلال تكوين رأس المال فنظام المساهمات العقارية ونظام بيع وتأجير مشروعات عقارية على الخارطة &nbsp;يمثلان خطوة مهمة في الاستثمار العقاري، و قنوات تمويلية واستثمارية مرنة &nbsp;بالتوازي مع الصناديق الاستثمارية العقارية، مما يعزز حماية المستثمرين واستثماراتهم في القطاع العقاري السعودي.</span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"mso-fareast-font-family: 'Times New Roman'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يذكر أن &nbsp;معرض سيتي سكيب العالمي 2024 يسعى لفتح آفاقًا جديدة للتعاون والشراكات الاستراتيجية بين الشركات العقارية السعودية ونظيراتها العالمية وهذه الفرصة تعد ذات أهمية لتبادل الخبرات والتقنيات الحديثة في مجال التطوير العقاري ويمثل المعرض ساحة للاستثمارات الواعدة في المشاريع العقارية الكبرى من خلال التواصل المباشر بين المستثمرين الدوليين والمطورين المحليين، آملين في أن يبني المعرض تصورًا واضحًا لرحلة المستثمرين في القطاع العقاري السعودي.</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"الرئيس التنفيذي للهيئة العامة للعقار يلتقي بوزير الإسكان المصري والوفد المرافق له \"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"320","change":"Update"}],"key":"822996d6-6863-463a-be7c-05aefb2615d1"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/9c267483-0334-44c6-840f-c2e669682825.config","name":"20 تشريع عقاري أسهمت بتصنيف السوق العقاري السعودي كأكثر الأسواق تحسنًا عالميًا","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"cc47b98f-1fe7-4c69-9658-102d3078c165","newValue":"9c267483-0334-44c6-840f-c2e669682825","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"11/14/2024 2:42:39 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-11-14T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"ffec16f5-21bc-47a9-8dea-99761544193f\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"aCxSpFirst\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">شهد القطاع العقاري في المملكة خلال السنوات القليلة الماضية، إصدار أكثر من 20 تشريعًا عقاريًا أساسيًا أعلنتها الهيئة العامة للعقار بهدف تنظيم القطاع العقاري بالمملكة العربية السعودية وتعزيز جاذبيته وحيويته ورفع نسبة الموثوقية والشفافية به، حيث أسهمت التشريعات في تصنيف السوق العقاري السعودي كأحد الأسواق الأكثر تحسنًا عالميًا، وفقاً لتقريرِ مؤشرِ الشفافيةِ العقاريةِ العالمي 2024.</span></p>\\\\n<p style=\\\\\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"aCxSpMiddle\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وتمثل التشريعات العقارية التي يشهدها السوق العقاري السعودي أنظمة وقواعد ولوائح تنفيذية و تنظيمية تعكس الاهتمام الحكومي بهذا القطاع ، حيث يأتي على رأسها تنظيم الهيئة العامة للعقار لتكون الجهة الحكومية الرسمية التي تعمل من أجل تنظيم النشاط العقاري وتطويره ورفع كفايته وتشجيع الاستثمار فيه بما يتفق مع أهداف التنمية الاقتصادية والاجتماعية ، وقد انطلقت رحلة التشريعات العقارية ليأتي نظام ملكية الوحدات العقارية وفرزها وإدارتها ،لينظم أحكام الملكية العقارية للعقارات المشتركة، وأحكام فرز الوحدات العقارية، وإدارة جمعيات الملاك ،متبوعًا&nbsp; بلائحته التنفيذية لتتضمن الأحكام التنفيذية للنظام</span>، &nbsp;ثم نظام التسجيل العيني للعقار لتبدأ عمليات <span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">تسجيل العقارات عينيا وتنظيم أحكام اكتساب الحقوق العينية على العقار وقد أسهم النظام في تصحيح أكثر من مليون وثلاثمئة ألف خريطة عقارية وتسجيل أكثر من 350 ألف صك ملكية&nbsp; ويستهدف تسجيل 8 ملايين عقار خلال الفترة المقبلة ،وقد جاءت اللائحة التنفيذية لنظام التسجيل العيني للعقار لتبين أحكامه التنفيذية .</span></p>\\\\n<p style=\\\\\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"aCxSpMiddle\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وقد أسهم نظام الوساطة العقارية ولائحته التنفيذية في رفع الموثوقية بالسوق العقاري كون أنه يمثل إطار قانوني واضح يضمن حقوق جميع الأطراف، ويسهم في تعزيز الثقة بين المستثمرين وملاك العقارات والوسطاء العقاريين ومقدمي الخدمات العقارية والعملاء ، حيث يزاول النشاط حوالي 60 ألف وسيط عقاري مرخص ، وقد انبثق من نظام الوساطة العقارية عدد من اللوائح التنفيذية والتنظيمية شملت أحكام التوسط لإتمام الصفقات العقارية والخدمات العقارية المقدمة للمستفيدين من قبل المرخصين ، و أحكام ممارسة خدمة الاستشارات والتحليلات العقارية، وأحكام ممارسة خدمة المزادات العقارية، من الترخيص وإجراء المزاد إلى إغلاق المزادات وغيرها من الأحكام ، إضافة إلى جدول تصنيف المخالفات والعقوبات المقررة حال مخالفة نظام الوساطة العقارية ، وقد وضعت معايير لترخيص المنصات العقارية الإلكترونية وتصنيفها و ضوابط وشروط تنظم عملية الإعلانات العقارية وما تحتويه من بيانات بهدف حفظ الحقوق وزيادة الشفافية والموثوقية بالسوق العقاري .</span></p>\\\\n<p style=\\\\\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"aCxSpMiddle\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">&nbsp; فيما يأتي نظام المساهمات العقارية ولائحته التنفيذية والضوابط المنضمة لتأهيل وتصنيف ممارسي النشاط وضوابط حساب الضمان للمساهمات وجدول تصنيف المخالفات والعقوبات لمخالفي النظام بهدف تعزيز ثقة المستثمرين في القطاع العقاري السعودي والقضاء على ممارسة المساهمات العقارية العشوائية غير النظامية ، بما يسهم في خلق فرص استثمارية واعدة ، ويأتي النظام جنبًا إلى جنب مع نظام بيع وتأجير مشروعات عقارية على الخارطة&nbsp; ولائحته التنفيذية وجدول تصنيف المخالفات والعقوبات ليكون منظمًا لأحكام تطوير المشاريع على الخارطة من إجراءات الترخيص وحتى إنهاء المشروع العقاري وقد أسهم في تحقيق نمواً ملحوظاً، حيث تم إصدار أكثر من 130 رخصة لمشاريع تجاوزت قيمتها 200 مليار ريال خلال العامين الماضيين.</span></p>\\\\n<p style=\\\\\\\"mso-add-space: auto; text-align: justify; direction: rtl; unicode-bidi: embed; margin: 0in 18.5pt .0001pt 0in;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"aCxSpLast\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وتأتي هذه التشريعات العقارية لما يشكله القطاع العقاري في المملكة العربية السعودية من أهمية ، كونه واحدًا من أهم الركائز الأساسية للاقتصاد الوطني الذي رسمت خارطته رؤية السعودية 2030، وتشهد المنظومة العقارية ككل نمواً ملحوظاً ومرونة هي نتاج التشريعات المنظمة للتعاملات العقارية بكافة أشكالها بما يعزز استدامة القطاع وتطوره من خلال صناعة خارطة جديدة مستقبلية للقطاع العقاري مبنية على أسس قانونية مرنة قابلة للتكيف مع المتغيرات العالمية . </span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"20 تشريع عقاري أسهمت بتصنيف السوق العقاري السعودي كأكثر الأسواق تحسنًا عالميًا\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"321","change":"Update"}],"key":"9c267483-0334-44c6-840f-c2e669682825"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/f29bd6ab-fafc-46e6-90bf-de5f6108665d.config","name":"هيئة العقار تختتم مشاركتها في \"معرض سيتي سكيب العالمي 2024 \"","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"bb39c5da-811c-4023-a647-792b3a2d4a69","newValue":"f29bd6ab-fafc-46e6-90bf-de5f6108665d","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"11/14/2024 6:51:28 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-11-14T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"29490533-0e03-413b-a05c-198bff7d43ad\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">اختتمت الهيئة العامة للعقار مشاركتها في معرض سيتي سكيب العالمي 2024 بنسخته الثانية، الذي أقيم&nbsp;خلال الفترة&nbsp;11- 14</span><span> </span><span style=\\\\\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">نوفمبر في مركز الرياض للمعارض والمؤتمرات \\\\\\\"ملهم\\\\\\\" بالعاصمة الرياض برعاية وزارة والبلديات والإسكان وبالشراكة بين الهيئة العامة للعقار، وبرنامج الإسكان أحد برامج رؤية </span><span>2030</span><span> تحت شعار \\\\\\\"مستقبل الحياة\\\\\\\" بمشاركة أكثر من </span><span>400</span><span> جهة عارضة من أهم وأكبر الشركات العالمية والوطنية في مجال الاستثمار والتطوير العقاري، وأكثر من </span><span>100</span><span> من مستثمر مؤسسي، وأكثر من 500 من قادة القطاع الدوليين والمحليين.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وتأتي مشاركة \\\\\\\"الهيئة\\\\\\\" في معرض سيتي سكيب العالمي 2024م، بهدف تسليط الضوء على التطورات الأخيرة في السوق العقاري السعودي، بما في ذلك الإصلاحات التنظيمية والتشريعية التي تسهل الاستثمار الأجنبي، بما يعزز الثقة في السوق المحلي ويحفز النمو في القطاع، ويفتح آفاقًا جديدة للتعاون والشراكات الاستراتيجية بين الشركات العقارية السعودية ونظيراتها العالمية وهذه الفرصة تعد ذات أهمية لتبادل الخبرات والتقنيات العقارية المُتقدمة في مجال البناء وتأسيس البنية التحتية للمشاريع العقارية من أجل صناعة مجتمعات حيوية ومستدامة تلبي متطلبات المرحلة المستقبلية ، مبيناً أنّ المعرض سيسهم في تحقيق أهداف القطاع العقاري من خلال توفير منصات متعددة وتجارب متميزة لعرض الابتكارات، وتبادل التجارب، والتقنيات العقارية ، بما يسهم في زيادة الفرص الاستثمارية المتنوعة في السوق العقاري السعودي، وجذب المزيد من الاستثمارات الأجنبية، لتنويع الاقتصاد، وتعزيز التنمية المستدامة.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأشارت \\\\\\\"هيئة العقار \\\\\\\" إلى أن \\\\\\\"سيتي سكيب 2024 \\\\\\\" شهد لقاءً جمع الرئيس التنفيذي للهيئة العامة للعقار المشرف العام على \\\\\\\"معرض سيتي سكيب العالمي 2024\\\\\\\" المهندس عبد الله بن سعود الحماد و معالي وزير الإسكان والمرافق والمجتمعات العمرانية بجمهورية العربية المصرية المهندس شريف الشريبني والوفد المرافق له لمناقشة أوجه التعاون الاستثماري العقاري بين البلدين ، كما شهد توقيع عدد الاتفاقيات والشراكات بين الهيئة وعدد من القطاعات الداعمة تضمنت تدشين بوابة المطورين العقاريين ضمن منصة السجل العقاري كوجهة متكاملة تهدف إلى تسهيل أعمال المطورين العقاريين، وحفظ حقوق ملاك العقارات في مشاريع البيع على الخارطة، وتمّكن المنصة المطورين العقاريين في التسجيل وإصدار رخص البيع على الخارطة وعرض شهادات البيع وتسجيلها باسم ملاك العقارات بكل مرونة وفعالية ، بالإضافة إلى توقيع مذكرة تفاهم لتنظيم نشاط المساهمات العقارية ، ورفع مستوى الشفافية والإفصاح، وحماية حقوق جميع أطراف المساهمة العقارية، وحوكمة المساهمات العقارية وتنظيمها وأتمتها، باعتبارها أحد قنوات التمويل الاستثمارية للمطورين العقاريين، والهادفة لتعزيز ثقة المستثمرين في القطاع العقاري في المملكة.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">كما استعرضت \\\\\\\"الهيئة\\\\\\\" من خلال الجلسات الحوارية وورش العمل وجناحها الخص بالمعرض رحلة التحول الرقمي والتقني في القطاع العقاري واسهامها في تقديم خدمات نوعية متقدمة، بالإضافة إلى التأكيد على دور \\\\\\\"هيئة العقار \\\\\\\" في تبني التقنيات العقارية وتوفير بيئة محفزة تدعم الابتكار ورواد الأعمال من خلال المركز السعودي للبروبتك الذي أطلقته مؤخرًا ليكون مركزًا يخدم جميع المهتمين بالتقنية العقارية من داخل المملكة وخارجها ، بالإضافة إلى التعريف بأهمية نظام بيع وتأجير مشروعات عقارية على الخارطة ومدى اسهامه في تعزيز التنافسية في نشاط التطوير العقاري&nbsp; وتشجيع الاستثمار فيه لزيادة المعروض من الوحدات العقارية</span><span>.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يُذكر أنّ معرض سيتي سكيب العالمي 2024م ، شهد&nbsp; توقيع اتفاقيات وشراكات بلغت قيمتها أكثر من 180 مليار ريال سعودي ، وإقامة أكبر مزاد عقاري مباشر في الشرق الأوسط بالتعاون مع مركز الإسناد والتصفية (إنفاذ)، تجاوزت قيمته المليار ريال ،بالإضافة إلى توفير أكثر من </span><span>100 </span><span style=\\\\\\\"font-size: 12.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ألف وحدة سكنية بعروض حصرية وحلول تمويلية تسهل رحلة التملك للمساكن ، وأتاح للمستثمرين الشباب وأصحاب الشركات الناشئة، فرص التواصل المباشر مع المستثمرين والمطورين العقاريين المحليين والدوليين، وعرض مشاريعهم وأفكارهم</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"هيئة العقار تختتم مشاركتها في \\\"معرض سيتي سكيب العالمي 2024 \\\"\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"322","change":"Update"}],"key":"f29bd6ab-fafc-46e6-90bf-de5f6108665d"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/3f01c208-b349-436f-90c4-bb96d3db20db.config","name":"الهيئة العامة للعقار\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بالمدينة المنورة\"","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"cfd09ba1-0c10-41f6-bfc0-816bddaad8dd","newValue":"3f01c208-b349-436f-90c4-bb96d3db20db","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"11/27/2024 7:18:22 AM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-11-25T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"c7cc0c7c-d72a-43ef-a50f-29bff84f94bd\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"margin: 0cm; margin-bottom: .0001pt; text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"xs4\\\\\\\"><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">أعلنتْ الهيئة العامة للعقار عن بدء أعمال التسجيل العيني للعقار لـ (370)&nbsp;قطعة عقارية&nbsp;في (4)&nbsp;أحياء&nbsp;بالمدينة المنورة&nbsp;ابتداءً&nbsp;من&nbsp;26&nbsp;ديسمبر&nbsp;2024م، الموافق&nbsp;25</span></span><span class=\\\\\\\"xapple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">جمادى&nbsp;الثاني&nbsp;1446هـ، وحتى نهاية يوم&nbsp;31&nbsp;مارس&nbsp;2025م الموافق&nbsp;2&nbsp;شوال&nbsp;1446هـ..&nbsp;</span></span></p>\\\\n<p style=\\\\\\\"text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px; margin: 3.75pt 0cm 3.75pt 0cm;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"xs7\\\\\\\"><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأوضحت الهيئة أنّ&nbsp;الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل الأحياء التالية&nbsp;بالمدينة المنورة:</span></span><span class=\\\\\\\"xapple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">(المسجد النبوي الشريف،</span></span><span class=\\\\\\\"xapple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">جزء من حي بضاعة،</span></span><span class=\\\\\\\"xapple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">جزء من حي النقا</span></span><span class=\\\\\\\"xs6\\\\\\\"><em>،</em></span><span class=\\\\\\\"xapple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"xs5\\\\\\\">حي المناخة</span><em><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">،</span></em><span class=\\\\\\\"xapple-converted-space\\\\\\\">&nbsp;</span><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">مُبينةً بأنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.</span></span></p>\\\\n<p style=\\\\\\\"text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px; margin: 3.75pt 0cm 3.75pt 0cm;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"xs7\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px; margin: 3.75pt 0cm 3.75pt 0cm;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"xs7\\\\\\\"><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأشارت&nbsp;”هيئة العقار\\\\\\\" أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء&nbsp;سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية&nbsp;</span></span><span style=\\\\\\\"font-size: 13.5pt;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\"><a href=\\\\\\\"https://rer.sa/\\\\\\\"><span class=\\\\\\\"xs8\\\\\\\">https://rer.sa</span><span class=\\\\\\\"xs9\\\\\\\"><span>/</span></span></a></span><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">&nbsp;أو عن طريق مراكز&nbsp;الخدمة،&nbsp;مشيرةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل. ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.&nbsp;</span></span></p>\\\\n<p style=\\\\\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"xs4\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin: 0cm; margin-bottom: .0001pt; text-align: start; direction: rtl; unicode-bidi: embed; font-variant-caps: normal; word-spacing: 0px;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"xs4\\\\\\\"><span class=\\\\\\\"xs5\\\\\\\"><span style=\\\\\\\"font-size: 13.5pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\\\\\"رقم عقار\\\\\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات&nbsp;الجيومكانية&nbsp;الدقيقة بما يُسهم في&nbsp;تعزيز البنية&nbsp;التحتية واستدامة القطاع العقاري، حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</span></span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"الهيئة العامة للعقار\\\" تُعلن عن بدء أعمال السجل العقاري لـ (4) أحياء بالمدينة المنورة\\\"\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"323","change":"Update"}],"key":"3f01c208-b349-436f-90c4-bb96d3db20db"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/a274b024-ccd3-41a4-a223-96b79b47db8a.config","name":"الهيئة العامة للعقار\" تُنفذ 12 جولة رقابية مشتركة خلال شهر نوفمبر لضمان الامتثال في السوق العقاري\"","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"da4ba795-8df2-4f51-8014-922b1c4175ce","newValue":"a274b024-ccd3-41a4-a223-96b79b47db8a","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/1/2024 8:24:41 AM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-01T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"70d4008d-5c85-4659-bfcb-6cfa786a14d7\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">نفذت الهيئة العامة للعقار بمشاركة وزارة الموارد البشرية والتنمية الاجتماعية خلال شهر نوفمبر 12 جولة رقابية مشتركة شملتْ زيارة 148 منشأة عقارية في كل من منطقة الرياض والمنطقة الشرقية ومنطقة مكة المكرمة، وتأتي هذه الجولات بهدف ضمان الامتثال للتشريعات العقارية بشكل عام ونظام الوساطة العقارية على وجه الخصوص، إضافة إلى ما يتعلق باختصاص الجهات الحكومية المشاركة فيما يتعلق بالتوطين.</span></p>\\\\n<p style=\\\\\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأوضحتْ الهيئة أنّ العمل الميداني هو أحد المسارات التي تعمل عليه&nbsp;لتنظيم السوق&nbsp;العقاري، حيث&nbsp;قامت فرقها الرقابية خلال الفترة&nbsp;ذاتها&nbsp;بتنفيذ 13،255&nbsp;عملية رقابية ميدانية،&nbsp;نتج عنها رصد 9،457<strong> </strong>إعلاناً عقارياً مخالفاً بالأماكن العامة، كما تلقت الهيئة&nbsp;213 بلاغاً عقارياً عبر قنواتها المختلفة تم التعامل معها ومعاجلتها،&nbsp;فيما&nbsp;بلغ عدد عمليات المسح الإلكتروني أكثر من&nbsp;14،559عملية، حيث&nbsp;تنتهج&nbsp;الهيئة&nbsp;الرقابة الإلكترونية&nbsp;التي&nbsp;تستهدف&nbsp;القنوات&nbsp;الرقمية&nbsp;والمنصات العقارية للتحقق من نظامية الإعلانات وممارسات الوساطة&nbsp;العقارية&nbsp;الرقمية&nbsp;وفق الأنظمة واللوائح.&nbsp;</span></p>\\\\n<p style=\\\\\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"margin: 0cm; margin-bottom: .0001pt; text-align: justify; text-justify: kashida; text-kashida: 0%; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\"><span style=\\\\\\\"font-size: 16.0pt; line-height: 115%; font-family: 'Sakkal Majalla'; color: black;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ودعتْ الهيئة العامة للعقار الوسطاء ومقدمي الخدمات العقارية كافة إلى الامتثال لقواعد الأنظمة العقارية، والاطلاع على المخالفات تجنبًا للعقوبات والتي تشمل الإنذارات وتعليق الترخيص أو إلغاءه أو الغرامات المالية،&nbsp; وقد حددت اللائحة التنفيذية للنظام تصنيف المخالفات والعقوبات المقررة لها، كما دعت الهيئة المواطنين والمقيمين إلى تقديم بلاغاتهم في حال الاشتباه بالمخالفات العقارية أو الاحتيال العقاري عبر مسار الاستجابة للبلاغات من خلال منصة الهيئة الرسمية أو الاتصال على الرقم&nbsp;( 199011 ) للاستفسارات العقارية.</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"الهيئة العامة للعقار\\\" تُنفذ 12 جولة رقابية مشتركة خلال شهر نوفمبر لضمان الامتثال في السوق العقاري\\\"\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"324","change":"Update"}],"key":"a274b024-ccd3-41a4-a223-96b79b47db8a"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/1ccec545-dd3b-46dd-8494-c310e9d43c16.config","name":"هيئة العقار\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ (11) حياً بمدينة الرياض\"","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"acf58296-37a2-4299-ad45-6acbe34b05eb","newValue":"1ccec545-dd3b-46dd-8494-c310e9d43c16","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/3/2024 7:33:44 AM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-03T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"b8749217-1d9c-4a1b-8231-4fe6d4fa7b5c\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">أعلنت الهيئة العامة للعقار عن قرب انتهاء المهلة المحددة للتسجيل العيني الأول للعقار لـ(11) حيا بمدينة الرياض، وذلك&nbsp;نهاية يوم الخميس 5 ديسمبر 2024م الموافق 4 جمادى الآخرة 1446هـ. </span></p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span class=\\\\\\\"s7\\\\\\\"><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ودعت الهيئة ملاك العقارات الواقعة ضمن نطاق الأحياء التالية</span></span><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">: (المعذر الشمالي، حي المربع، حي الملز، حي العليا، حي النموذجية، حي الزهراء، حي الناصرية، حي المؤتمرات، حي الضباط، حي طيبة، ضاحية نمار)</span> <span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">إلى سرعة المبادرة بتسجيل عقاراتهم من خلال منصة السجل العقاري الإلكترونية </span><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\">&nbsp;</span><span style=\\\\\\\"font-size: 10.0pt; line-height: 115%; font-family: 'Sakkal Majalla';\\\\\\\"><a href=\\\\\\\"http://rer.sa\\\\\\\">rer.sa</a></span><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">قبل انتهاء مدة التسجيل للاستفادة من خدمات تنفيذ التصرفات العقارية وتوثيق جميع التغييرات التي تطرأ على العقار</span><span>.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأوضحت </span><span>\\\\\\\" </span><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">الهيئة \\\\\\\" أنّ التسجيل العيني للعقار يتيح إصدار \\\\\\\"رقم عقار\\\\\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، ويتضمن صك تسجيل الملكية الجديد الموقع الجغرافي الدقيق للعقار وبيانات مالكه وأوصافه وحالته وما يتبعه من حقوق والتزامات وجميع التصرفات العقارية التي تطرأ عليه، ليكون أساسًا في توثيق الملكية والحقوق العقارية المترتبة عليها، بما يُسهم في استدامة وتعزيز نمو القطاع العقاري والممكنات الرئيسة له</span><span>.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأكدت الهيئة أنّ عدم تسجيل العقارات خلال المدة المحددة في قرار الإعلان يعرض ملاكها للغرامات المالية الواردة في نظام التسجيل العيني للعقار والتي تحددها لجنة مختصة بالنظر في المخالفات، وأنَ طلبات التسجيل العيني للعقار مستمرة في جميع المناطق المعلنة حتى بعد انتهاء مدة التسجيل المحددة في قرار الإعلان.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\">&nbsp;</p>\\\\n<p style=\\\\\\\"text-align: justify; line-height: 115%; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يذكر أن الشركة الوطنية لخدمات التسجيل العيني للعقار (السجل العقاري) تتولى مهمة تنفيذ أعمال إنشاء وإدارة السجل العقاري في المملكة باستخدام التقنيات الحديثة والبيانات الجيومكانية عبر منصة رقمية متكاملة تُسهم في تعزيز الشفافية والثقة بخدمات وبيانات العقارات.</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"هيئة العقار\\\": الخميس تنتهي مدة تسجيل العقارات في السجل العقاري لـ (11) حياً بمدينة الرياض\\\"\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"325","change":"Update"}],"key":"1ccec545-dd3b-46dd-8494-c310e9d43c16"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/9e50c536-bb29-41ba-910c-32363f681674.config","name":"\"هيئة العقار\" تقيم ملتقى التدريب العقاري الأسبوع القادم","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"af9d993f-24bf-4e2c-8b44-598cad2c376c","newValue":"9e50c536-bb29-41ba-910c-32363f681674","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/22/2024 2:47:05 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-22T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"87f6e285-c82c-49ee-81dd-9adda85d4be8\\\",\\\"mediaKey\\\":\\\"fdfc9835-3986-45dd-a6b1-dc0f8ee38ffb\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">تُقيم الهيئة العامة للعقار \\\\\\\"ملتقى التدريب العقاري\\\\\\\" الإثنين القادم 30 ديسمبر 2024 الموافق 29 جمادى الثاني 1446 هـ في مركز الرياض الدولي للمؤتمرات والمعارض - قاعة كبار الشخصيات، بهدف مناقشة أهمية التدريب كعملية تطويرية لمهارات وقدرات الأفراد والمنشآت في مختلف الأنشطة العقارية بما يعزز التنافسية محليًا ودوليًا.&nbsp;</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وذكرت الهيئة العامة للعقار أنّ \\\\\\\" ملتقى التدريب العقاري\\\\\\\" يأتي في إطار الجهود المستمرة للمعهد العقاري السعودي لتعزيز كفاءة العاملين بالأنشطة العقارية، وبناء قطاع متين متقدم يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات الاستراتيجية الشاملة للقطاع العقاري، حيث سيتضمن \\\\\\\"الملتقى\\\\\\\" جلسات حوارية يشارك بها عدد من الخبراء والمتخصصين في مجالات الأنشطة العقارية و التدريب والتنمية، ويستعرضون من خلالها دور التدريب المتخصص في القطاع العقاري وأبرز التحديات والحلول المبتكرة، و أهمية دعم وتنمية القدرات البشرية وأثرها في تعزيز تنافسية المواطن عالميًا .</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأوضحت \\\\\\\"الهيئة \\\\\\\" أن \\\\\\\"الملتقى \\\\\\\" سيناقش واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، بما يساهم في رفع المعايير المهنية في القطاع العقاري، إضافةً إلى استعراض الاتجاهات والمسارات الحديثة في التدريب العقاري وماله من تأثير على احترافية التعاملات العقارية، والتأكيد على ضرورة الموائمة بين مخرجات التعليم ومتطلبات سوق العمل، التي تسهم في مواجهة التحديات وابتكار الحلول التطويرية، وتوفير معارف نوعية للمتميزين في المجالات الاقتصادية ذات الأولوية.&nbsp;</span></p>\\\\n<p style=\\\\\\\"text-align: right; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ودعت الهيئة العامة للعقار العموم والمهتمين وأصحاب الاختصاص بالمجال العقاري ومزاولي الأنشطة العقارية ، إلى الاستفادة من موضوعات الجلسات الحوارية التي سيناقشها الملتقى ، من خلال تسجيل الحضور للملتقى عبر الرابط الإلكتروني التالي: </span><span style=\\\\\\\"font-family: 'Arial',sans-serif;\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\"><a href=\\\\\\\"https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e\\\\\\\">https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e</a></span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"\\\"هيئة العقار\\\" تقيم ملتقى التدريب العقاري الأسبوع القادم\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"326","change":"Update"}],"key":"9e50c536-bb29-41ba-910c-32363f681674"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/f0968b53-f39f-4322-aae3-bb34d4110d4d.config","name":"\"هيئة العقار\" تطلق غدًا ملتقى التدريب العقاري","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"0e6c8166-34bf-4f88-b73b-bf418494b044","newValue":"f0968b53-f39f-4322-aae3-bb34d4110d4d","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/29/2024 1:07:31 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-29T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"e554a8af-55b9-427c-8c72-5a6859428e91\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يطلق الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد غدًا الإثنين 30 ديسمبر 2024 ملتقى التدريب العقاري الذي تنظمه الهيئة في مركز &nbsp;الرياض الدولي للمؤتمرات والمعارض – قاعة كبار الشخصيات، ويناقش الملتقى بمشاركة عدد من الخبراء والمتخصصين في مجالات الأنشطة العقارية والتدريب والتنمية، أهمية التدريب كعملية تطويرية لمهارات وقدرات الأفراد والمنشآت في مختلف الأنشطة العقارية بما يعزز التنافسية محليًا ودوليًا. </span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأوضحت الهيئة العامة للعقار بأن الهدف الرئيسي من تنظيم \\\\\\\" ملتقى التدريب العقاري \\\\\\\" هو التأكيد على دور المعهد العقاري السعودي و أهمية التدريب كأداة استراتيجية لدعم التنافسية، وتحقيق تنمية القدرات البشرية وتعزيز كفاءة العاملين بالأنشطة العقارية، وبناء قطاع متين متقدم يسهم في دعم النمو الاقتصادي والوصول لمستهدفات الاستراتيجية الشاملة للقطاع العقاري ، إضافة ً إلى تعزيز التواصل بين المهنيين ، ومواكبة التطورات وتحفيز الابتكارات وتطوير القدرات من خلال إعداد ممارسين عقاريين مؤهلين يحملون شهادات مهنية معتمدة وتراخيص لمزاولة الأنشطة العقارية المختلفة، مما يعزز ثقة المستثمرين المحليين والدوليين والمتعاملين في السوق العقاري</span><span>.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وذكرت \\\\\\\" الهيئة \\\\\\\" أن \\\\\\\" الملتقى \\\\\\\"سيناقش واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، بما يساهم في رفع المعايير المهنية في القطاع العقاري، إضافةً إلى استعراض الاتجاهات والمسارات الحديثة في التدريب العقاري وماله من تأثير على احترافية التعاملات العقارية، والتأكيد على ضرورة الموائمة بين مخرجات التعليم ومتطلبات سوق العمل، التي تسهم في مواجهة التحديات وابتكار الحلول التطويرية، وتوفير معارف نوعية للمتميزين في المجالات الاقتصادية ذات الأولوية.&nbsp;</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ودعت الهيئة العامة للعقار العموم والمهتمين وأصحاب الاختصاص بالمجال العقاري ومزاولي الأنشطة العقارية ، إلى الاستفادة من موضوعات الجلسات الحوارية التي سيناقشها الملتقى ، من خلال تسجيل الحضور للملتقى عبر الرابط الإلكتروني التالي</span><span>:&nbsp;<a href=\\\\\\\"https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e\\\\\\\">https://survey.rega.gov.sa/s/cm4zewufl007faz708c7rka1e</a></span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"\\\"هيئة العقار\\\" تطلق غدًا ملتقى التدريب العقاري \"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"327","change":"Update"}],"key":"f0968b53-f39f-4322-aae3-bb34d4110d4d"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/6d1dfbbd-78fc-4282-83f0-eea3df3b9376.config","name":"هيئة العقار\" تُعلن بدء أعمال السجل العقاري لـ (28) حيًا بمنطقة مكة المكرمة\"","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"24c323b9-1015-4560-93ae-9d8caae62450","newValue":"6d1dfbbd-78fc-4282-83f0-eea3df3b9376","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/30/2024 9:55:31 AM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-30T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"7131d61a-b102-48fe-9866-bbf9d1a7a514\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p dir=\\\\\\\"rtl\\\\\\\">أعلنتْ الهيئة العامة للعقار بدء أعمال التسجيل العيني للعقار لـ (19.239) قطعة عقارية في (28) حيًا بمنطقة مكة المكرمة ابتداءً من 19 يناير 2025م، وحتى نهاية يوم 24 أبريل 2025م.<br>وأوضحت الهيئة أنّ الأحياء المستفيدة من السجل العقاري في هذه المرحلة تشمل أجزاءً من الأحياء التالية بمكة المكرمة: (حي الصفوة، حي دار السلام، حي النسيم، حي الشميسي، حي التروية، حي الراشدية، حي الكوثر، حي طيبة، حي عين شمس، حي الحطيم، حي العوالي، حي العمرة، حي الشهداء، حي الكعكية، حي جبل النور، حي العمرة، حي الجامعة، حي الضيافة، حي أحد، حي الراشدية، حي الحمراء، حي الفرقان، حي العسلية، حي وادي جليل، حي جعرانة، حي الصفا، حي الغزيات، حي المقام).<br>وبينت أنَّ اختيار الأحياء تم وفق معايير محددة، وسيتم الإعلان تباعًا عن بقية المناطق والمحافظات والأحياء التي ستخضع لأعمال التسجيل العيني للعقار في مختلف مناطق المملكة خلال الفترات القادمة.<br>وأشارت الهيئة العامة العقار أنَّ التسجيل الأول للعقارات في هذه المناطق والأحياء سيكون مُتاحًا عن طريق منصة السجل العقاري الإلكترونية <a rel=\\\\\\\"noopener\\\\\\\" href=\\\\\\\"https://rer.sa/\\\\\\\" target=\\\\\\\"_blank\\\\\\\" title=\\\\\\\"\\\\\\\">https://rer.sa</a> أو عن طريق مراكز الخدمة، منوهةً أنّ التسجيل العيني يشترط وجود صك ملكية مستوفِ للمتطلبات النظامية لإتمام عملية التسجيل، ودعت الهيئة ملاَّك العقارات في المناطق والأحياء الخاضعة للتسجيل العيني إلى التحقق من صك ملكية العقار وتوفر الاشتراطات اللازمة استعدادًا لبدء التسجيل، ويمكن الاستفسار عن خطوات التسجيل من خلال المنصات الرسمية للهيئة أو عن طريق الاتصال على مركز خدمة العملاء 199002.<br>وابتداءً من الموعد الـمُحدد لبدء التسجيل سيصدر \\\\\\\"رقم عقار\\\\\\\" وصك تسجيل ملكية لكل وحدة عقارية يتم تسجيلها، وسيتضمن صك تسجيل الملكية بيانات العقار وأوصافه وحالته وما يتبعه من حقوق والتزامات مرتبطة بالمعلومات الجيومكانية الدقيقة بما يُسهم في تعزيز البنية التحتية للقطاع العقاري؛ حيث يهدف نظام التسجيل العيني للعقار إلى رفع الموثوقية العقارية وتعزيز الشفافية في القطاع العقاري.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"هيئة العقار\\\" تُعلن بدء أعمال السجل العقاري لـ (28) حيًا بمنطقة مكة المكرمة\\\"\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"328","change":"Update"}],"key":"6d1dfbbd-78fc-4282-83f0-eea3df3b9376"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/f607d0ad-67dd-4910-be33-7ab44dfbd028.config","name":"\"هيئة العقار \" تُعلنْ بدء استقبال طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"38accae1-9970-4dcc-9023-a384e06c4384","newValue":"f607d0ad-67dd-4910-be33-7ab44dfbd028","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/30/2024 9:26:10 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-31T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"049cf77a-3a4d-4af1-a954-1139f8b8f45a\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">أعلنتْ الهيئةُ العامة للعقار اليوم، عن بدء استقبال المعهد العقاري السعودي طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي للحصول على رخصة فال للاستشارات العقارية، ورخصة فال للتحليلات العقارية، حيث يستمر استقبال طلبات الترشيح في البرنامج لمدة خمسة أيام عن طريق الموقع الرسمي للمعهد، ويُعدّ اجتياز البرنامج التدريبي شرطًا لممارسة نشاط الاستشارات أو التحليلات العقارية.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأوضحتْ الهيئةُ أنَّ كلا النشاطين الاستشارات والتحليلات العقارية يُعدَّان من الخدمات العقارية التي شملهما نظام الوساطة العقارية والذي بدأ تطبيق العمل به في يوليو من العام 2023م، حيث شمل النظام تنظيم ممارسة نشاط التوسط في إتمام الصفقات العقارية بين أطرافها، إضافة إلى أنشطة الخدمات العقارية والتي تشمل: التسويق العقاري، وإدارة الأملاك، وإدارة المرافق، والمزادات العقارية، والإعلانات العقارية، والاستشارات والتحليلات العقارية والتي تُمارس حصراً عن طريق مقدمي الخدمات المُرخصين والمؤهلين من المـُنشآت والأفراد</span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\">.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ووضحت الهيئة أنَّ الفرق بين الاستشارات والتحليلات هو وسيلة تقديمها، حيث عرَّفت اللائحة التنظيمية الاستشارات والتحليلات العقارية بأنها التوصية أو الرأي أو المشورة المتصلة بالقطاع العقاري، غير أنَّ الاستشارات العقارية هي التي يتم تقديمها للمستفيد كتابةً ويلزم مقدمها إبرام عقد بينه وبين المستفيد، بينما يتم تقديم التحليلات العقارية منشورةً عبر وسائل الإعلام أو منصات التواصل الاجتماعي أو نحوها كأنشطة الاتصال الجماهيري.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\"></span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأشارت \\\\\\\"الهيئة\\\\\\\" إلى أنّ البرنامج التدريبي الذي يبدأ استقبال طلبات الترشيح اليوم وينتهي يوم الجمعة&nbsp;</span><span>3</span><span> <span lang=\\\\\\\"AR-SA\\\\\\\">يناير 2025م، الموافق 3 رجب 1446هـ ، تم إعداده في المعهد العقاري السعودي&nbsp; بالتعاون مع كبرى دور التدريب المحلي والدولي المتخصصة في برامج الاستشارات والتحليلات العقارية، ويُغطي الجوانب القانونية والاتصالية والفنية في مجال تقديم الاستشارات والتحليلات العقارية عبر كفاءات تدريبية عالية المستوى في هذا المجال، على مدى شهرين (ثمانية أسابيع)، مما يعكس الاهتمام في أهمية المخرجات لضمان دقة الاستشارات والمعلومات التي تقدّم للمستفيدين</span></span><span>.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\"></span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ويقدّم البرنامج التدريبي في هذين المسارين حضوريًا في كل من الرياض وجدة والدمام كل ربع سنة نظرًا لأهمية تطبيق المهارات والعلوم والمعارف في محتوى هذه البرامج لضمان التأهيل اللازم لممارسة النشاط في القطاع العقاري ويتضمن كل مسار 14 دورة تدريبية، ويشترط للتقدم في طلب الترشيح لمسار الاستشارات العقارية أن يكون المتقدم حاصلًا على شهادة جامعية، وخبرة لا تقل عن (3) سنوات في ممارسة أي من الأنشطة العقارية أما بالنسبة للتحليلات العقارية فيشترط خبرة لا تقل عن (10) سنوات في ممارسة أي من الأنشطة العقارية بالإضافة الى شهادة جامعية.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\"></span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">ويُمكن التقديم على البرنامج التدريبي عبر بوابة المعهد العقاري السعودي لتسجيل الرغبات في مسار الاستشارات العقارية&nbsp;</span><span lang=\\\\\\\"AR-SA\\\\\\\"><a href=\\\\\\\"https://srei.sa/FormData/RealEstateConsulting\\\\\\\">https://srei.sa/FormData/RealEstateConsulting</a></span><span> أو عبر الرابط التالي لتسجيل الرغبات في مسار التحليلات العقارية</span><span> </span><span><a href=\\\\\\\"https://srei.sa/FormData/RealEstateAnalytics\\\\\\\">https://srei.sa/FormData/RealEstateAnalytics</a></span><span>، ومن ثم تقوم الهيئة بدراسة الطلبات والتحقق من الاشتراطات، ويتم إشعار المتقدمين بنتائج الترشيح كمرحلة أولى ثم إشعار المقبولين بأوقات الدورات ومكان انعقادها، وبعد اجتياز البرنامج التدريبي يقوم المعهد بإصدار شهادة الاجتياز، ويكمل المتقدم إجراءات استخراج الرخصة عن طريق منصة الخدمات الإلكترونية للهيئة العامة للعقار، ليتم بعد ذلك إصدار الرخصة بعد اجتياز البرنامج التدريبي بخمسة أيام عمل</span><span>.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\"></span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">يُذكر بأنَّ رخصة فال العقارية هي الوثيقة الرسمية التي تخوّل الأفراد والمنشآت من ممارسة أنشطة الوساطة والخدمات العقارية المشمولة في نظام الوساطة العقارية، حيث يهدف النظام إلى تنظيم نشاط الوساطة العقارية، وتقديم خدمات عقارية مبتكرة ونوعية للمستفيدين، كما يرفع نظام الوساطة العقارية جودة التعاملات العقارية، ويخدم الوسطاء العقاريين والمستفيدين، ويسهم في استدامة الأصول العقارية، ويحد من النزاعات العقارية، ويحفظ حقوق المتعاملين، ويرفع شفافية السوق العقاري</span><span>.</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\" \\\"هيئة العقار \\\" تُعلنْ بدء استقبال طلبات تسجيل الدفعة الثالثة في البرنامج التدريبي لمساري الاستشارات والتحليلات العقارية\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"329","change":"Update"}],"key":"f607d0ad-67dd-4910-be33-7ab44dfbd028"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/999245f8-b0fc-4223-98a5-9036eb09eb45.config","name":"رئيس هيئة العقار: 300 ألف مستفيد من المسارات التدريبة للمعهد العقاري السعودي","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"d6eb7d2f-f583-4511-a92f-d4c3dabd929b","newValue":"999245f8-b0fc-4223-98a5-9036eb09eb45","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/30/2024 9:32:06 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-30T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"c1168707-ad6f-402a-aea4-bbe553d9e59b\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">أكد الرئيس التنفيذي للهيئة العامة للعقار المهندس عبد الله بن سعود الحماد، على الدور الريادي للمعهد العقاري السعودي الذراع الأكاديمي \\\\\\\"للهيئة\\\\\\\"، وما يبذله من جهود تسهم في تنمية القدرات البشرية ورفع كفاء العاملين بالقطاع العقاري، وأنّ ما حققه المعهد من مؤشرات إيجابية، هي نتاج الدعم غير المحدود الذي أولته القيادة الرشيدة - أيدها الله- للقطاع العقاري من خلال منظومة التشريعات التي مكنته وجعلت منه قطاعًا حيويًا يتسم بالنمو والتطور.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وذكر المهندس عبدالله الحماد في كلمته خلال افتتاح \\\\\\\"ملتقى التدريب العقاري\\\\\\\" أنّ </span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\\\\\" lang=\\\\\\\"AR-MA\\\\\\\">التدريب العقاري يساهم في رفع معايير الممارسات المهنية داخل القطاع ويُمكّن المواطن من اكتساب مهارات استثنائية، تجعله مؤهلاً ليس فقط لتلبية متطلبات السوق المحلي، بل للمنافسة على أعلى المستويات العالمية، ويسهم بشكل مباشر في </span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">تحقيق أهداف الاستراتيجية الشاملة للقطاع العقاري ويحفز </span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\\\\\" lang=\\\\\\\"AR-MA\\\\\\\">النمو الاقتصادي، من خلال إعداد ممارسين مؤهلين يحملون شهادات مهنية معتمدة وتراخيص لمزاولة الأنشطة العقارية المختلفة، وقد نجح المعهد العقاري السعودي </span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">منذ تأسيسه في تدريب أكثر من 300,000 ألف مستفيد، من خلال تقديم أكثر من 4500 برنامجًا تدريبيًا عبر 5 مسارات رئيسية تتضمن </span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\\\\\" lang=\\\\\\\"AR-MA\\\\\\\">الاستشارات العقارية، التحليلات العقارية، الوساطة والتسويق العقاري، المساهمات العقارية، التسجيل العيني</span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">، إضافة إلى أنّ المعهد يعمل على تقديم مسارات تدريبية حديثة تتضمن التقنيات العقارية التي تسهم&nbsp; في&nbsp; تقديم حلول عقارية مبتكرة تدعم بناء مدن مستقبلية مستدامة.</span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\"></span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وأشار إلى أنّ \\\\\\\"الهيئة\\\\\\\" ومن خلال المعهد العقاري السعودي، تعمل على تأهيل قادة يسهمون في تحويل القطاع العقاري السعودي إلى نموذج عالمي يُحتذى به في الابتكار والاحترافية، إضافةً إلى رسم خارطة واضحة لرحلة المتعاملين في القطاع العقاري، بدءًا من التمكين وصولًا إلى تحقيق الاستدامة، وأنه ومن خلال التدريب المتخصص يمكن تطوير الكوادر العقارية بما يعزز من قدرتها على التكيف مع التطورات التقنية والتنظيمية الحالية والمستقبلية في القطاع.</span></p>\\\\n<p style=\\\\\\\"text-align: justify; direction: rtl; unicode-bidi: embed;\\\\\\\" dir=\\\\\\\"RTL\\\\\\\" class=\\\\\\\"MsoNormal\\\\\\\"><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla';\\\\\\\" lang=\\\\\\\"AR-SA\\\\\\\">وذكر \\\\\\\"الحماد\\\\\\\" أن هذه النسخة من ملتقى التدريب العقاري </span><span style=\\\\\\\"font-size: 14.0pt; font-family: 'Sakkal Majalla'; mso-bidi-language: AR-MA;\\\\\\\" lang=\\\\\\\"AR-MA\\\\\\\">تمثل منصة معرفية تعليمية تطويرية، تناقش واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، إضافةً إلى استعراض الاتجاهات والمسارات الحديثة في التدريب العقاري وماله من أثر ايجابي على احترافية التعاملات العقارية، التي ستسهم في مواجهة التحديات وابتكار الحلول التطويرية، وتوفير معارف نوعية لدى المهتمين.</span></p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"رئيس هيئة العقار: 300 ألف مستفيد من المسارات التدريبة للمعهد العقاري السعودي\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"330","change":"Update"}],"key":"999245f8-b0fc-4223-98a5-9036eb09eb45"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"Published","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content/dfd9ec1e-252e-4196-8a9a-16ed963ddbe2.config","name":"هيئة العقار\" تختتم أعمال ملتقى التدريب العقاري\"","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Content","requiresPostProcessing":true,"detailMessage":null,"details":[{"success":true,"name":"Path","path":"","oldValue":"(Blank)","newValue":"-1,1058,1272,1273,0","change":"Update"},{"success":true,"name":"Level","path":"","oldValue":"0","newValue":"4","change":"Update"},{"success":true,"name":"Key","path":"","oldValue":"d772dafd-dae8-4481-b715-e5ae77fb4a81","newValue":"dfd9ec1e-252e-4196-8a9a-16ed963ddbe2","change":"Update"},{"success":true,"name":"CreateDate","path":"","oldValue":"1/1/0001 12:00:00 AM","newValue":"12/31/2024 12:15:10 PM","change":"Update"},{"success":true,"name":"Template","path":"Template","oldValue":"(Blank)","newValue":"1254","change":"Update"},{"success":true,"name":"hidePageFromNavigation","path":"Property/hidePageFromNavigation","oldValue":"null","newValue":"\"0\"","change":"Update"},{"success":true,"name":"newsDate","path":"Property/newsDate","oldValue":"null","newValue":"\"2024-12-31T00:00:00\"","change":"Update"},{"success":true,"name":"newsImages","path":"Property/newsImages","oldValue":"null","newValue":"\"[{\\\"key\\\":\\\"31ed5e85-9d82-4452-818b-7b41c1830370\\\",\\\"mediaKey\\\":\\\"7fd1a6e9-8758-4d5e-8b56-136e82aa296f\\\"}]\"","change":"Update"},{"success":true,"name":"newsText","path":"Property/newsText","oldValue":"null","newValue":"\"{\\\"markup\\\":\\\"<p dir=\\\\\\\"rtl\\\\\\\">اختتمت الهيئة العامة للعقار أمس, أعمال \\\\\\\"ملتقى التدريب العقاري\\\\\\\" الذي نظمته بمركز الرياض للمؤتمرات والمعارض, بحضور الرئيس التنفيذي للهيئة المهندس عبدالله بن سعود الحمّاد.<br>وناقش الملتقى واقع التدريب العقاري ودوره في توفير احتياجات السوق العقاري ودعم ثقافة الابتكار وريادة الأعمال، بما يسهم في رفع المعايير المهنية في القطاع العقاري، إضافةً إلى تسليط الضوء على الاتجاهات والمسارات الحديثة في التدريب العقاري وأثرها على احترافية التعاملات العقارية.<br>واستعرض المتحدثون بالجلسة الحوارية الأولى التي جمعت نخبة من الشخصيات المتخصصة في تنمية القدرات البشرية، وتطوير القطاع العقاري، أهمية تعزيز تنافسية المواطن محليًا وعالميًا، وأفادوا بأن ما تقدمه الهيئة العامة للعقار من خلال المعهد العقاري السعودي يؤكد على أهمية التدريب بصفتها أداة استراتيجية لدعم التنافسية وتحقيق تنمية القدرات البشرية، وأنه في ظل رؤية المملكة 2030 وبرامجها الطموحة أصبحت الحاجة ملحة لوجود جامعة سعودية عقارية، توفر تعليم متخصص في علوم العقار.<br>وأشاروا إلى أنّ المملكة نجحت في إعداد مواطن سعودي يُنافس مهاريًا في مختلف القطاعات، وأنّ التجربة السعودية في رحلة التعلّم باستخدام الذكاء الاصطناعي تعد إنجازًا وطنيًا؛ لنجاحها على المستوى العالمي وأنّ المواطن السعودي أصبح أكثر وعيًا واهتمامًا بتطوير مهاراته ليصبح منافسًا عالميًا في مختلف القطاعات.<br>كما تطرق المتحدثون بالجلسة الحوارية الثانية على أهمية التدريب العقاري في ابتكار الحلول ومواجهة التحديات وأن البرامج الأكاديمية التي بدأت بتبنيها الجامعات السعودية تسهم في سد الفجوة بين التعليم الأكاديمي ومتطلبات السوق العقاري، وأن الاعتماد على التقنيات العقارية يمثل مستقبل التعاملات العقارية وتحسين تجربة المستفيدين، وعلى الممارس في القطاع العقاري أن يتبنى التقنيات الحديثة ويلمّ بكيفية مواءمتها في أعماله اليومية لتحسين الكفاءة وتعزيز الإنتاجية.<br>ودعا المتحدثون إلى ضرورة تبني برامج أكاديمية وزمالات متخصصة في نشاط التطوير العقاري لتدريب وتأهيل الشباب السعودي لمساعدتهم في بناء قدراتهم المهنية وتزويدهم بأهم المعارف والمهارات اللازمة لممارسة العمل العقاري، كما أشاروا إلى أنّ الاطلاع على التجارب العالمية يبعث الفخر بما وصلت إليه التجربة السعودية في قطاع العقار خصوصًا شبكة إيجار ونظام الوساطة العقارية.<br>يذكر أن ملتقى التدريب العقاري يأتي في إطار الجهود المستمرة للهيئة العامة للعقار لتعزيز كفاءة العاملين بالأنشطة العقارية، وبناء قطاع متين متقدم يسهم في تعزيز النمو الاقتصادي وتحقيق تطلعات الاستراتيجية الشاملة للقطاع العقاري، بما يحقق الاستدامة في تقديم خدمات عقارية نوعية من أجل مستقبل عقاري أكثر تطورًا.</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"","change":"Update"},{"success":true,"name":"newsTitle","path":"Property/newsTitle","oldValue":"null","newValue":"\"هيئة العقار\\\" تختتم أعمال ملتقى التدريب العقاري\\\"\"","change":"Update"},{"success":true,"name":"pageName","path":"Property/pageName","oldValue":"null","newValue":"\"هيئة العقار\\\" تختتم أعمال ملتقى التدريب العقاري\\\"\"","change":"Update"},{"success":true,"name":"SortOrder","path":"SortOrder","oldValue":"0","newValue":"331","change":"Update"}],"key":"dfd9ec1e-252e-4196-8a9a-16ed963ddbe2"},{"handlerAlias":"DomainHandler","success":true,"itemType":"IDomain","message":"","exception":null,"change":"NoChange","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Domains/17f54eb1-7fd5-4812-a139-f175cf66330c.config","name":"/ar/المركز-الاعلامي/الفعاليات/","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Domains","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"e0b6bce4-0000-0000-0000-000000000000"},{"handlerAlias":"formsHandler","success":true,"itemType":"Form","message":"","exception":null,"change":"NoChange","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms/59d386cd-d93c-4a55-ab41-9019a3e03238.config","name":"Booking Appointment","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"59d386cd-d93c-4a55-ab41-9019a3e03238"},{"handlerAlias":"formsHandler","success":true,"itemType":"Form","message":"","exception":null,"change":"NoChange","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms/54bc52d6-8ce6-4bf5-8b97-2b1182786a09.config","name":"Complaint","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"54bc52d6-8ce6-4bf5-8b97-2b1182786a09"},{"handlerAlias":"formsHandler","success":true,"itemType":"Form","message":"","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms/5e5fe3f9-14e2-41f3-a335-681f5791c193.config","name":"Ask the spokesperson","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"5e5fe3f9-14e2-41f3-a335-681f5791c193"},{"handlerAlias":"formsHandler","success":true,"itemType":"Form","message":"","exception":null,"change":"Import","fileName":"umbraco/Data/TEMP/uSync/receive/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms/27715327-fbad-4d76-9af9-6e415bd85d04.config","name":"Suggestions and Inquiries","path":"/5195f602-e42f-426a-89fb-0eccd863eca0/uSync/Forms","requiresPostProcessing":false,"detailMessage":null,"details":null,"key":"27715327-fbad-4d76-9af9-6e415bd85d04"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"","exception":null,"change":"Delete","fileName":"","name":"ملف الوسائط","path":null,"requiresPostProcessing":true,"detailMessage":null,"details":null,"key":"6ea8b66c-a722-4d29-a974-890e3b312a64"},{"handlerAlias":"PublishedContentHandler","success":true,"itemType":"IContent","message":"","exception":null,"change":"Delete","fileName":"","name":"مؤشرات الأداء","path":null,"requiresPostProcessing":true,"detailMessage":null,"details":null,"key":"3e51732f-f8ee-4451-bf80-64aa73c59b34"}]