          "oldValue": "\"{\\\"markup\\\":\\\"<p>جميع الحقوق محفوظة للهيئة العامة للعقار</p>\\\",\\\"blocks\\\":{\\\"contentData\\\":[],\\\"settingsData\\\":[]}}\"",
