{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "baseUrl": "https://localhost:44318",
  "variabels": {
    "isServer": "true",
    "ApiKey": "ApiKey XXXX",
    "SendMessagesApi": "https://intggw.rega.gov.sa:232/api/API/SendMessages",
    "TokenCode": "Bearer XXXX",
    "isGoogleAnalyticsEnabled": "false",
    "RegaApiEndpoint": "https://api.rega.gov.sa",
    "RegaClientId": "XX",
    "RegaClientSecret": "XX",
    "RegaInternalApiEndpoint": "https://api-dev.rega.gov.sa",
    "RegaInternalClientId": "XX",
    "RegaInternalClientSecret": "XX",
    "NewsLetterMailingListKey": "4566913e-294b-4765-9fd9-5ee727092b35",
    "Environment": "prod"
  },
  "googleReCaptcha:SiteKey": "XX",
  "googleReCaptcha:SecretKey": "XX",
  "Umbraco": {
    "WebRouting": {
      "UrlProviderMode": "Relative"
    },
    "CMS": {
      "WebRouting": {
        "TryMatchingEndpointsForAllPages": false,
        "TrySkipIisCustomErrors": false,
        "InternalRedirectPreservesTemplate": false,
        "DisableAlternativeTemplates": false,
        "ValidateAlternativeTemplates": false,
        "DisableFindContentByIdPath": false,
        "DisableRedirectUrlTracking": false,
        "UrlProviderMode": "Auto",
        "UmbracoApplicationUrl": "https://rega.gov.sa/"
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeManual"
      },
      "Global": {
        "UseHttps": true,
        "Smtp": {
          "From": "noreply@rega.gov.sa",
          "Host": "mail.rega.gov.sa",
          "Port": 465,
          "Username": "REGA/noreply",
          "Password": "R$g@2023!2024",
          "SecureSocketOptions": "None"
        },
        "Id": "XXXX",
        "SanitizeTinyMce": true
      },
      "Content": {
        "LoginBackgroundImage": "/images/rega_background.webp",
        "LoginLogoImage": "/images/logos/REGA_LOGO.svg",
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        },
        "Error404Collection": [
          {
            "Culture": "default",
            "ContentId": "1198"
          }
        ],
        "Notifications": {
          "Email": "noreply@rega.gov.sa"
        }
      }
    },
    "Forms": {
      "FieldTypes": {
        "Recaptcha3": {
          "SiteKey": "XXXX",
          "PrivateKey": "XXXX"
        },
        "Recaptcha2": {
          "PublicKey": "XXXX",
          "PrivateKey": "XXXX"
        }
      }
    }
  },
  "AppEnvironment": "Development",
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=XXXX;Database=XXXX;User ID=XXXX;Password=XXXX;Trusted_Connection=False;Encrypt=False;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "showError": true,
  "showSwagger": true,
  "uSync": {
    "Publisher": {
      "Settings": {
        "IncomingEnabled": true,
        "AppId": "XXXX",
        "AppKey": "XXXX"
      }
    },
    "Sets": {
      "Default": {
        "DisabledHandlers": [
          "DomainsHandler"
        ],
        "Handlers": {
          "DictionaryHandler": {
            "Group": "Settings"
          },
          "ContentHandler": {
            "Settings": {
              "ImportTrashed": false,
              "ExportTrashed": false,
              "RulesOnExport": true,
              "ExcludeContentTypes": "nafathLogin,eventDetails,thankYou,newsDetails,applyForAJob,department,servicesFilter,servicesFilterItem,servicesFilterSubItem,jobOpenings"
            }
          }
        }
      }
    },
    "Settings": {
      "UIEnabledGroups": "Settings,Forms",
      "ExportOnSave": "Settings,Forms"
    }
  },
  "SeoToolkit": {
    "Global": {
      "AutomaticSitemapsInRobotsTxt": false,
      "EnableSeoSettingsByDefault": true
    },
    "ScriptManager": {
      "DisabledModules": [],
      "Definitions": {
        "googleAnalytics": {
          "Enabled": true
        }
      }
    }
  },
  "NewsletterStudio": {
    "Debug": {
      "LogCampaignLinks": true
    },
    "Workspaces": [
      {
        "Key": "XXXX",
        "BaseUrl": "https://dev-rega.rega.gov.sa"
      }
    ]
  }
}