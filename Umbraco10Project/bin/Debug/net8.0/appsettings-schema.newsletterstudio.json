{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "NewsletterStudio": {
      "type": "object",
      "description": "Newsletter Studio settings",
      "required": [ ],
      "properties": {
        "CampaignContentTypes": {
          "type": "string",
          "description": "Comma separated list of Content Type-aliases that should be possible to send as campaigns"
        },
        "Debug" : {
          "type": "object",
          "properties": {
            "LogCampaignLinks" : {
              "type": "boolean",
              "description": "Activate logging of campaign links"
            },
            "DebugFilesPath" : {
              "type": "string",
              "description": "Folder path where to log debug information."
            }
          }
        },
        "Workspaces": {
          "type": "array",
          "description": "Override settings for Workspaces",
          "items": {
            "type": "object",
            "required": [ ],
            "properties": {
              "Key": {
                "type": "string",
                "description": "The Guid key for specific Workspace (found in Backoffice->Email->Administration or in the nsWorkspace-table in the database. Leave this out to apply settings to all Workspaces."
              },
              "BaseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Set the base url for the workspace."
              },
              "EmailServiceProvider": {
                "type": "object",
                "required": [ ],
                "properties": {
                  "Alias": {
                    "type": "string",
                    "description" : "Alias of Email Service Provider. E.g. smtp or smtpPickup"
                  },
                  "Settings": {
                    "type": "object",
                    "description": "Key value-pair of settings for Email Service Provider. These will vary depending on the settings used but the selected provider.",
                    "properties": {
                      "host": {"type": "string", "description": "Host for smtp-server (e.g. smtp.myprovider.com)" },
                      "username" : { "type": "string", "description": "Username for SMTP-server" },
                      "password" : { "type": "string", "description": "Password for SMTP-server" },
                      "useSsl" : { "type": "boolean", "description": "Use a secure connection for SMTP-server" },
                      "port" : { "type": "number", "description": "Forces a certain port, leave this empty to use defaults: 25 (or 587 for SSL)" },
                      
                      "rateLimitActive" : { "type": "boolean", "description": "Use this to throttle the pace of sending." },
                      "rateLimitItems" : { "type": "number", "description": "Maximum items to send within timeframe" },
                      "rateLimitSeconds" : { "type": "number", "description": "Timeframe in seconds" },
                      
                      "bounceActive" : { "type": "boolean", "description": "Activate bounce handler (POP3)." },
                      "bounceHost" : { "type": "string", "description": "Host for POP3-server" },
                      "bounceUsername" : { "type": "string", "description": "POP3-server username" },
                      "bouncePassword" : { "type": "string", "description": "POP3-server username" },
                      "bounceUseSsl" : { "type": "boolean", "description": "Use a secure connection for POP3-server" },
                      "bouncePort" : { "type": "number", "description": "Forces a certain port, leave this empty to use defaults: 110 (or 995 for SSL)" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}