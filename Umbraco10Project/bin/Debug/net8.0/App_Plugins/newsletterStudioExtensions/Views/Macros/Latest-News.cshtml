@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Web
@using Umbraco.Extensions
@inject IUmbracoContextFactory UmbracoContextFactory
@{
    IEnumerable<IPublishedContent> GetLatestNewsDetails(int count = 5)
    {
        using (var contextReference = UmbracoContextFactory.EnsureUmbracoContext())
        {
// Get all root content
            var rootItems = contextReference.UmbracoContext.Content.GetAtRoot();

// Create a list to hold the results
            List<IPublishedContent> newsDetailsItems = new List<IPublishedContent>();

// Traverse the tree manually
            foreach (var rootItem in rootItems)
            {
                newsDetailsItems.AddRange(GetNewsDetailsRecursive(rootItem));
            }

// Order by CreateDate and take the latest 'count' items
            return newsDetailsItems
                .OrderByDescending(x => x.CreateDate)
                .Take(count);
        }
    }

    IEnumerable<IPublishedContent> GetNewsDetailsRecursive(IPublishedContent contentItem)
    {
// If the content item is of type 'newsDetails', return it
        if (contentItem.ContentType.Alias == "newsDetails")
        {
            yield return contentItem;
        }


        foreach (var child in contentItem.Children)
        {
            foreach (var descendent in GetNewsDetailsRecursive(child))
            {
                yield return descendent;
            }
        }
    }
}

<div style="margin: 0 auto; padding: 20px; text-align: right">
    @{
        foreach (var newsDetailsItem in GetLatestNewsDetails(5).ToList())
        {
            <div
                style="border: 1px solid #002f56; border-radius: 5px; margin-bottom: 20px; padding: 20px; pointer-events: none;">
                <a href="@newsDetailsItem.Url(mode: UrlMode.Absolute)" style="text-decoration:none">
                    <h2 style="font-size: 18px; margin: 0; color: #555555;">@newsDetailsItem.Name</h2>
                </a>
                <p style="margin: 5px 0; color: #777777;">@newsDetailsItem.CreateDate.ToShortDateString()</p>
            </div>
        }
    }

    <div style="width: 100%; text-align: center">
        <a href="/news"
           style="background-color: #002f56;text-decoration:none;font-size: 13px;padding: 10px;color: white;min-width: 160px;display: inline-flex;justify-content: center;border-radius: 20px;">
            <p style="color: white;">عرض جميع الاخبار</p>
        </a>
    </div>

</div>